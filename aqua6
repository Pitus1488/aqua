end


FALLEN_VFX_SCAN_SHARED =
    FALLEN_VFX_SCAN_SHARED
    or {
        time = 0,
        snapshot = nil,
        queue = {},
        queue_used = 0,
        generation = 0,
        mode = nil,
    }

function FALLEN_BT_VFX_SCAN(
    min_interval,
    need_holes
)
    local now = tick()
    local shared = FALLEN_VFX_SCAN_SHARED

    min_interval =
        clamp(
            tonumber(min_interval)
            or 0.040,
            0.015,
            0.50
        )

    local wanted_mode =
        need_holes == false
        and "blood"
        or "full"

    -- A "full" snapshot is also valid for BloodPart-only consumers.
    local cached_mode_ok =
        shared.mode == "full"
        or shared.mode == wanted_mode

    if type(shared.snapshot) == "table"
        and cached_mode_ok
        and now - (tonumber(shared.time) or 0) < min_interval
    then
        return
            shared.snapshot,
            tonumber(shared.generation) or 0,
            false
    end

    local root =
        FALLEN_BT_VFX_ROOT()

    if not root then
        shared.snapshot = {}
        shared.time = now
        shared.mode = wanted_mode
        shared.generation =
            (tonumber(shared.generation) or 0)
            + 1

        return
            shared.snapshot,
            shared.generation,
            true
    end

    local out = {}
    local queue = shared.queue

    -- Reuse the traversal array instead of allocating a new queue.
    for i = 1, tonumber(shared.queue_used) or 0 do
        queue[i] = nil
    end

    local qi = 1
    local qn = 1
    queue[1] = root

    while qi <= qn do
        local inst = queue[qi]
        queue[qi] = nil
        qi = qi + 1

        if inst then
            local name = nil

            pcall(function()
                name = inst:get_name()
            end)

            name =
                string.lower(
                    tostring(name or "")
                )

            local relevant =
                name == "bloodpart"
                or (
                    wanted_mode == "full"
                    and (
                        name == "hole"
                        or name == "metalhole"
                    )
                )

            if relevant then
                local addr = inst.addr

                if addr
                    and addr ~= 0
                then
                    out[tostring(addr)] = inst
                end

                -- Relevant VFX nodes are already the objects we need.
                -- Their internal children are only used later by POSITION()
                -- when necessary, so do not recursively scan inside them.
            else
                local children = nil

                pcall(function()
                    children = inst:get_children()
                end)

                if type(children) == "table" then
                    -- Newer children tend to be at the end; enqueue them first.
                    for i = #children, 1, -1 do
                        local child = children[i]

                        if child then
                            qn = qn + 1
                            queue[qn] = child
                        end
                    end
                end
            end
        end
    end

    shared.queue_used = qn
    shared.snapshot = out
    shared.time = now
    shared.mode = wanted_mode
    shared.generation =
        (tonumber(shared.generation) or 0)
        + 1

    return
        out,
        shared.generation,
        true
end

function FALLEN_BT_VFX_IS_IMPACT_NAME(
    inst
)
    if not FALLEN_BT_VFX_INSTANCE_VALID(
        inst
    )
    then
        return false
    end

    local name = nil

    pcall(function()
        name =
            inst:get_name()
    end)

    name =
        string.lower(
            tostring(
                name or ""
            )
        )

    return
        name == "hole"
        or name == "metalhole"
        or name == "bloodpart"
        or name == "casinglarge"
        or name == "casingsmall"
end


function FALLEN_BT_VFX_POSITION(
    inst
)
    if not FALLEN_BT_VFX_IS_IMPACT_NAME(
        inst
    )
    then
        return nil
    end

    local impact_name = nil

    pcall(function()
        impact_name =
            string.lower(
                tostring(
                    inst:get_name()
                    or ""
                )
            )
    end)

    -- CasingLarge / CasingSmall are only container Models.
    -- Their actual positional MeshPart is:
    -- CasingLarge -> Main
    -- CasingSmall -> Main
    if impact_name == "casinglarge"
        or impact_name == "casingsmall"
    then
        local main = nil

        pcall(function()
            main =
                inst:find_first_child(
                    "Main"
                )
        end)

        if main
            and FALLEN_BT_VFX_INSTANCE_VALID(
                main
            )
        then
            local class_name = nil

            pcall(function()
                class_name =
                    main:get_class()
            end)

            if class_name == "MeshPart"
                or class_name == "Part"
                or class_name == "UnionOperation"
                or class_name == "BasePart"
            then
                local main_pos = nil

                pcall(function()
                    main_pos =
                        main:get_position()
                end)

                if main_pos
                    and main_pos.X ~= nil
                    and main_pos.Y ~= nil
                    and main_pos.Z ~= nil
                then
                    return {
                        X = main_pos.X,
                        Y = main_pos.Y,
                        Z = main_pos.Z,
                    }
                end
            end
        end

        -- Do not fall back to the Model or some unrelated child.
        return nil
    end

    -- Hole / MetalHole / BloodPart:
    -- first use the object itself if it has a world position.
    local pos = nil

    pcall(function()
        pos =
            inst:get_position()
    end)

    if pos
        and pos.X ~= nil
        and pos.Y ~= nil
        and pos.Z ~= nil
    then
        return {
            X = pos.X,
            Y = pos.Y,
            Z = pos.Z,
        }
    end

    -- If one of those is a Model/Folder, keep the old direct-child fallback.
    local children = nil

    pcall(function()
        children =
            inst:get_children()
    end)

    if type(children) == "table" then
        for _, child in ipairs(children) do
            if FALLEN_BT_VFX_INSTANCE_VALID(
                child
            )
            then
                local class_name = nil

                pcall(function()
                    class_name =
                        child:get_class()
                end)

                if class_name == "MeshPart"
                    or class_name == "Part"
                    or class_name == "UnionOperation"
                    or class_name == "BasePart"
                then
                    local child_pos = nil

                    pcall(function()
                        child_pos =
                            child:get_position()
                    end)

                    if child_pos
                        and child_pos.X ~= nil
                        and child_pos.Y ~= nil
                        and child_pos.Z ~= nil
                    then
                        return {
                            X = child_pos.X,
                            Y = child_pos.Y,
                            Z = child_pos.Z,
                        }
                    end
                end
            end
        end
    end

    return nil
end


function FALLEN_BT_ORIGIN()
    -- Start from the player's face/head, not camera.
    local head = nil

    pcall(function()
        if rbx
            and type(rbx.local_head) == "function"
        then
            head =
                rbx.local_head()
        end
    end)

    if head then
        local valid =
            true

        pcall(function()
            if type(head.is_valid) == "function" then
                valid =
                    head:is_valid()
                    == true
            end
        end)

        if valid then
            local p = nil

            pcall(function()
                p =
                    head:get_position()
            end)

            if p
                and p.X ~= nil
                and p.Y ~= nil
                and p.Z ~= nil
            then
                return {
                    X = p.X,
                    Y = p.Y,
                    Z = p.Z,
                }
            end
        end
    end

    -- Camera only as fallback if Head is temporarily unavailable.
    local cam = nil

    pcall(function()
        if aim
            and type(aim.get_camera_position) == "function"
        then
            cam =
                aim.get_camera_position()
        end
    end)

    if cam
        and cam.X ~= nil
        and cam.Y ~= nil
        and cam.Z ~= nil
    then
        return {
            X = cam.X,
            Y = cam.Y,
            Z = cam.Z,
        }
    end

    return nil
end


function FALLEN_BT_FOV_RADIUS()
    if key_down(0x02) == true then
        return 20
    end

    return 40
end


function FALLEN_BT_FOV_CENTER()
    local cx, cy = nil, nil

    if type(crosshair_pos) == "function" then
        pcall(function()
            local c = crosshair_pos()

            if c then
                cx = tonumber(c.X or c.x or c[1])
                cy = tonumber(c.Y or c.y or c[2])
            end
        end)
    end

    if (cx == nil or cy == nil)
        and type(FALLEN_CUSTOM_FOV_CENTER) == "function"
    then
        pcall(function()
            cx, cy = FALLEN_CUSTOM_FOV_CENTER()
        end)
    end

    return tonumber(cx), tonumber(cy)
end


-- Capture the exact view used for the hidden Bullet Tracer FOV check.
-- We keep camera basis + viewport + crosshair position from the shot moment,
-- then project future Hole/BloodPart positions through this SAVED view.
function FALLEN_BT_CAPTURE_SHOT_VIEW(force)
    local now = tick()

    if force ~= true
        and now - (tonumber(FALLEN_BT.vfx_shot_view_last) or 0) < 0.040
    then
        return
    end

    FALLEN_BT.vfx_shot_view_last = now

    if not rbx
        or type(rbx.camera) ~= "function"
    then
        return
    end

    local cam = nil
    local cam_pos = nil
    local rot = nil
    local fov = nil

    pcall(function()
        cam = rbx.camera()
        if cam then
            cam_pos = cam:camera_pos()
            rot = cam:camera_rotation()
            fov = cam:camera_fov()
        end
    end)

    if not cam_pos
        or type(rot) ~= "table"
        or #rot < 9
    then
        return
    end

    local dims = nil

    if type(ScreenSize) == "function" then
        pcall(function()
            dims = ScreenSize()
        end)
    end

    if type(dims) ~= "table" then
        return
    end

    local vw = tonumber(dims.Width or dims.width or dims.X or dims.x)
    local vh = tonumber(dims.Height or dims.height or dims.Y or dims.y)

    if not vw or not vh or vw <= 0 or vh <= 0 then
        return
    end

    local cx, cy = FALLEN_BT_FOV_CENTER()

    if not cx or not cy then
        cx = vw * 0.5
        cy = vh * 0.5
    end

    fov = tonumber(fov) or math.rad(70)

    -- Custom camera API exposes FOV in radians. Keep a defensive degrees
    -- fallback for older builds that may return a degree value.
    if fov > math.pi * 1.25 then
        fov = math.rad(fov)
    end

    fov = clamp(fov, math.rad(20), math.rad(150))

    local snapshot = {
        time = now,
        px = tonumber(cam_pos.X),
        py = tonumber(cam_pos.Y),
        pz = tonumber(cam_pos.Z),

        -- Rotation matrix columns are the camera world-space local axes.
        -- Local -Z is camera forward.
        rx = tonumber(rot[1]),
        ry = tonumber(rot[4]),
        rz = tonumber(rot[7]),

        ux = tonumber(rot[2]),
        uy = tonumber(rot[5]),
        uz = tonumber(rot[8]),

        fx = -tonumber(rot[3]),
        fy = -tonumber(rot[6]),
        fz = -tonumber(rot[9]),

        vw = vw,
        vh = vh,
        cx = tonumber(cx),
        cy = tonumber(cy),
        fov = fov,
        radius = FALLEN_BT_FOV_RADIUS(),
    }

    for _, key in ipairs({
        "px", "py", "pz",
        "rx", "ry", "rz",
        "ux", "uy", "uz",
        "fx", "fy", "fz",
        "vw", "vh", "cx", "cy", "fov", "radius",
    }) do
        if snapshot[key] == nil then
            return
        end
    end

    local list = FALLEN_BT.vfx_shot_views
    list[#list + 1] = snapshot

    -- One second is the longest accepted BloodPart impact window.
    for i = #list, 1, -1 do
        if now - (tonumber(list[i].time) or 0) > 1.05 then
            table.remove(list, i)
        end
    end

    while #list > 32 do
        table.remove(list, 1)
    end
end


function FALLEN_BT_FOV_CHECK_SNAPSHOT(pos, snapshot)
    if not pos or type(snapshot) ~= "table" then
        return false, nil
    end

    local dx = tonumber(pos.X) - tonumber(snapshot.px)
    local dy = tonumber(pos.Y) - tonumber(snapshot.py)
    local dz = tonumber(pos.Z) - tonumber(snapshot.pz)

    if not dx or not dy or not dz then
        return false, nil
    end

    local local_x =
        dx * snapshot.rx
        + dy * snapshot.ry
        + dz * snapshot.rz

    local local_y =
        dx * snapshot.ux
        + dy * snapshot.uy
        + dz * snapshot.uz

    local local_z =
        dx * snapshot.fx
        + dy * snapshot.fy
        + dz * snapshot.fz

    -- Behind the saved camera view cannot be inside its FOV.
    if local_z <= 0.001 then
        return false, nil
    end

    local focal =
        snapshot.vh
        / (2 * math.tan(snapshot.fov * 0.5))

    if focal <= 0 then
        return false, nil
    end

    local sx =
        snapshot.vw * 0.5
        + (local_x / local_z) * focal

    local sy =
        snapshot.vh * 0.5
        - (local_y / local_z) * focal

    local ddx = sx - snapshot.cx
    local ddy = sy - snapshot.cy
    local dist_sq = ddx * ddx + ddy * ddy
    local radius = tonumber(snapshot.radius) or 40

    return dist_sq <= radius * radius, dist_sq
end


function FALLEN_BT_FOV_CHECK_SHOT_VIEWS(pos, max_age)
    local list = FALLEN_BT.vfx_shot_views

    if type(list) ~= "table" or #list == 0 then
        return false, nil
    end

    local now = tick()
    local age_limit = tonumber(max_age) or 1.00
    local best_dist_sq = nil

    for i = #list, 1, -1 do
        local snapshot = list[i]
        local age = now - (tonumber(snapshot.time) or 0)

        if age <= age_limit then
            local ok, dist_sq =
                FALLEN_BT_FOV_CHECK_SNAPSHOT(
                    pos,
                    snapshot
                )

            if ok then
                return true, dist_sq
            end

            if dist_sq ~= nil
                and (
                    best_dist_sq == nil
                    or dist_sq < best_dist_sq
                )
            then
                best_dist_sq = dist_sq
            end
        end
    end

    return false, best_dist_sq
end


function FALLEN_BT_VFX_KIND(inst)
    if not inst
        or not FALLEN_BT_VFX_INSTANCE_VALID(inst)
    then
        return nil
    end

    local name = nil

    pcall(function()
        name = inst:get_name()
    end)

    name = string.lower(tostring(name or ""))

    if name == "hole"
        or name == "metalhole"
    then
        return "hole"
    end

    if name == "bloodpart" then
        return "bloodpart"
    end

    if name == "casinglarge"
        or name == "casingsmall"
    then
        return "casing"
    end

    return nil
end


function FALLEN_BT_VFX_FIND_NEW_IMPACT(
    previous,
    current,
    origin,
    shot_age
)
    if type(current) ~= "table"
        or not origin
    then
        return nil
    end

    previous =
        type(previous) == "table"
        and previous
        or {}

    shot_age = tonumber(shot_age) or 999

    local best_pos = nil
    local best_world_dist_sq = nil
    local best_fov_dist_sq = nil
    local best_priority = -1

    -- Keep the hidden FOV validation, but validate each new impact against
    -- camera/crosshair snapshots SAVED during the shot. Recoil may move the
    -- live camera immediately afterwards; it no longer moves this check.
    for key, inst in pairs(current) do
        if previous[key] == nil then
            local kind =
                FALLEN_BT_VFX_KIND(inst)

            local allowed = false
            local priority = 0
            local max_fov_age = 0

            if kind == "bloodpart" then
                allowed = shot_age <= 1.00
                priority = 2
                max_fov_age = 1.00

            elseif kind == "hole" then
                allowed = shot_age <= 0.70
                priority = 1
                max_fov_age = 0.70
            end

            -- Casings stay excluded: they are not bullet impact endpoints.
            if allowed then
                local pos =
                    FALLEN_BT_VFX_POSITION(inst)

                if pos then
                    local in_shot_fov, fov_dist_sq =
                        FALLEN_BT_FOV_CHECK_SHOT_VIEWS(
                            pos,
                            max_fov_age
                        )

                    if in_shot_fov then
                        local dx = tonumber(pos.X) - tonumber(origin.X)
                        local dy = tonumber(pos.Y) - tonumber(origin.Y)
                        local dz = tonumber(pos.Z) - tonumber(origin.Z)
                        local world_dist_sq =
                            dx * dx + dy * dy + dz * dz

                        if world_dist_sq >= 4 then
                            local better = false

                            if priority > best_priority then
                                better = true
                            elseif priority == best_priority then
                                if best_fov_dist_sq == nil
                                    or (
                                        fov_dist_sq ~= nil
                                        and fov_dist_sq < best_fov_dist_sq
                                    )
                                then
                                    better = true
                                elseif fov_dist_sq == best_fov_dist_sq
                                    and (
                                        best_world_dist_sq == nil
                                        or world_dist_sq < best_world_dist_sq
                                    )
                                then
                                    better = true
                                end
                            end

                            if better then
                                best_priority = priority
                                best_fov_dist_sq = fov_dist_sq
                                best_world_dist_sq = world_dist_sq

                                best_pos = {
                                    X = pos.X,
                                    Y = pos.Y,
                                    Z = pos.Z,

                                    auto_prediction = false,
                                    prediction_time = 0,
                                    gravity = 0,
                                    bullet_speed = 0,
                                    source = "vfx_impact_saved_shot_fov",
                                }
                            end
                        end
                    end
                end
            end
        end
    end

    return best_pos
end


function FALLEN_BT_ADD(origin, target)
    if not origin or not target then
        return
    end

    FALLEN_BT.items[#FALLEN_BT.items + 1] = {
        ox = origin.X,
        oy = origin.Y,
        oz = origin.Z,

        tx = target.X,
        ty = target.Y,
        tz = target.Z,

        auto_prediction =
            target.auto_prediction == true,

        prediction_time =
            tonumber(target.prediction_time)
            or 0,

        gravity =
            tonumber(target.gravity)
            or 0,

        bullet_speed =
            tonumber(target.bullet_speed)
            or 0,

        created = tick(),
        owner = FALLEN_BT_LOCAL_NAME(),

        seed =
            (#FALLEN_BT.items + 1) * 19
            + math.floor(tick() * 1000),

        hue =
            (
                (tonumber(S.bullet_tracer_h) or 0.58)
                + (#FALLEN_BT.items + 1) * 0.173
            ) % 1,
    }

    while #FALLEN_BT.items > 40 do
        table.remove(FALLEN_BT.items, 1)
    end
end

function FALLEN_BT_PROJECT(pos)
    if not aim
        or type(aim.world_to_screen) ~= "function"
        or not pos
    then
        return nil
    end

    local s = nil

    pcall(function()
        s = aim.world_to_screen(pos)
    end)

    if s and s.visible then
        return s
    end

    return nil
end


function FALLEN_BT_SHOT_TICK()
    local enabled =
        S.bullet_tracer_enabled == true
        and FALLEN_BT_WEAPON_READY()

    if not enabled then
        if FALLEN_BT.vfx_runtime_active == true then
            FALLEN_BT.vfx_seen = {}
            FALLEN_BT.vfx_prev_lmb = false
            FALLEN_BT.vfx_watch_until = 0
            FALLEN_BT.vfx_shot_time = nil
            FALLEN_BT.vfx_shot_views = {}
            FALLEN_BT.vfx_shot_view_last = 0
            FALLEN_BT.vfx_idle_scan_last = 0
            FALLEN_BT.vfx_scan_generation = nil
        end

        FALLEN_BT.vfx_runtime_active = false
        return
    end

    FALLEN_BT.vfx_runtime_active = true

    local now = tick()
    local lmb =
        key_down(VK_LBUTTON)
        == true

    local watch_until =
        tonumber(
            FALLEN_BT.vfx_watch_until
        )
        or 0

    if not lmb
        and now >= watch_until
    then
        if now
            - (
                tonumber(
                    FALLEN_BT.vfx_idle_scan_last
                )
                or 0
            )
            >= 0.25
        then
            local current, generation =
                FALLEN_BT_VFX_SCAN(
                    0.25,
                    true
                )

            FALLEN_BT.vfx_seen =
                current

            FALLEN_BT.vfx_scan_generation =
                generation

            FALLEN_BT.vfx_idle_scan_last =
                now
        end

        FALLEN_BT.vfx_prev_lmb = false
        FALLEN_BT.vfx_shot_time = nil

        if #FALLEN_BT.vfx_shot_views > 0 then
            FALLEN_BT.vfx_shot_views = {}
        end

        FALLEN_BT.vfx_shot_view_last = 0
        return
    end

    if lmb
        and FALLEN_BT.vfx_prev_lmb ~= true
    then
        FALLEN_BT.vfx_shot_time = now
        FALLEN_BT.vfx_watch_until = now + 1.00
        FALLEN_BT_CAPTURE_SHOT_VIEW(true)

    elseif lmb then
        FALLEN_BT.vfx_shot_time = now
        FALLEN_BT.vfx_watch_until = now + 1.00
        FALLEN_BT_CAPTURE_SHOT_VIEW(false)
    end

    FALLEN_BT.vfx_prev_lmb = lmb

    -- Heavy Workspace/VFX traversal is capped at 25 Hz during fire.
    -- The shared generation lets Tracer + HitFX consume the same scan once.
    local current, generation =
        FALLEN_BT_VFX_SCAN(
            0.040,
            true
        )

    if generation ~= nil
        and generation
            == FALLEN_BT.vfx_scan_generation
    then
        return
    end

    local previous =
        FALLEN_BT.vfx_seen
        or {}

    FALLEN_BT.vfx_scan_generation =
        generation

    FALLEN_BT.vfx_seen =
        current

    local origin =
        FALLEN_BT_ORIGIN()

    if not origin then
        return
    end

    local shot_age =
        now
        - (
            tonumber(
                FALLEN_BT.vfx_shot_time
            )
            or now
        )

    local impact =
        FALLEN_BT_VFX_FIND_NEW_IMPACT(
            previous,
            current,
            origin,
            shot_age
        )

    if impact then
        FALLEN_BT_ADD(
            origin,
            impact
        )
    end
end

function FALLEN_BT_REVEALED_POINTS(points, reveal, out)
    out = out or {}
    local old_count = #out
    local count = 0

    if type(points) ~= "table" or #points == 0 then
        for i = 1, old_count do out[i] = nil end
        return out
    end

    local max_u = clamp(tonumber(reveal) or 0, 0, 1)
    local first = points[1]

    if not first then
        for i = 1, old_count do out[i] = nil end
        return out
    end

    count = 1
    local dst = out[1] or {}
    out[1] = dst
    dst.x = first.x
    dst.y = first.y
    dst.u = tonumber(first.u) or 0
    dst.wx = first.wx
    dst.wy = first.wy
    dst.wz = first.wz

    if max_u > dst.u then
        local prev = first
        for i = 2, #points do
            local cur = points[i]
            if cur and prev and cur.x and cur.y and prev.x and prev.y then
                local pu = tonumber(prev.u) or 0
                local cu = tonumber(cur.u) or pu

                if cu <= max_u + 0.000001 then
                    count = count + 1
                    local o = out[count] or {}
                    out[count] = o
                    o.x, o.y, o.u = cur.x, cur.y, cu
                    o.wx, o.wy, o.wz = cur.wx, cur.wy, cur.wz
                    prev = cur
                else
                    local span = cu - pu
                    if span > 0.000001 and max_u > pu then
                        local t = clamp((max_u - pu) / span, 0, 1)
                        count = count + 1
                        local o = out[count] or {}
                        out[count] = o
                        o.x = prev.x + (cur.x - prev.x) * t
                        o.y = prev.y + (cur.y - prev.y) * t
                        o.u = max_u

                        if prev.wx ~= nil and prev.wy ~= nil and prev.wz ~= nil and cur.wx ~= nil and cur.wy ~= nil and cur.wz ~= nil then
                            o.wx = prev.wx + (cur.wx - prev.wx) * t
                            o.wy = prev.wy + (cur.wy - prev.wy) * t
                            o.wz = prev.wz + (cur.wz - prev.wz) * t
                        else
                            o.wx, o.wy, o.wz = nil, nil, nil
                        end
                    end
                    break
                end
            end
        end
    end

    for i = count + 1, old_count do out[i] = nil end
    return out
end

function FALLEN_BT_DRAW_WATER(
    tr,
    points,
    reveal,
    alpha,
    thick
)
    if type(points) ~= "table"
        or #points < 2
    then
        return
    end

    local max_u =
        clamp(
            tonumber(reveal) or 0,
            0,
            1
        )

    if max_u <= 0.001 then
        return
    end

    tr._revealed_points = tr._revealed_points or {}

    local visible_points =
        FALLEN_BT_REVEALED_POINTS(
            points,
            max_u,
            tr._revealed_points
        )

    if #visible_points < 2 then
        return
    end

    local col = FALLEN_BT_COLOR()

    -- Our Drawing API cannot rotate/wrap DrawImage along a tracer like a
    -- Roblox Beam texture, so Water is rendered as a continuous layered line.
    local core_thick =
        clamp(
            1.0 + (tonumber(thick) or 2) * 0.38,
            1.25,
            3.4
        )

    local previous = nil

    for i = 1, #visible_points do
        local point = visible_points[i]

        if point
            and point.x
            and point.y
            and point.u
        then
            if previous
                and type(DrawLine) == "function"
            then
                local normalized =
                    clamp(
                        (
                            (previous.u + point.u)
                            * 0.5
                        )
                        / math.max(max_u, 0.0001),
                        0,
                        1
                    )

                -- Fallen Ultimate Water uses Color -> white -> Color.
                local white_mix =
                    clamp(
                        1
                        - math.abs(
                            (normalized - 0.5) * 2
                        ),
                        0,
                        1
                    )

                local rr =
                    col[1]
                    + (1 - col[1]) * white_mix

                local gg =
                    col[2]
                    + (1 - col[2]) * white_mix

                local bb =
                    col[3]
                    + (1 - col[3]) * white_mix

                -- Wide soft water glow.
                DrawLine(
                    previous.x,
                    previous.y,
                    point.x,
                    point.y,
                    col[1],
                    col[2],
                    col[3],
                    alpha * 0.10,
                    core_thick + 6.0
                )

                -- Secondary translucent body.
                DrawLine(
                    previous.x,
                    previous.y,
                    point.x,
                    point.y,
                    rr,
                    gg,
                    bb,
                    alpha * 0.30,
                    core_thick + 2.3
                )

                -- Main continuous beam.
                DrawLine(
                    previous.x,
                    previous.y,
                    point.x,
                    point.y,
                    rr,
                    gg,
                    bb,
                    alpha * 0.92,
                    core_thick
                )

                -- Thin bright center to imitate wet/refraction highlight.
                DrawLine(
                    previous.x,
                    previous.y,
                    point.x,
                    point.y,
                    1,
                    1,
                    1,
                    alpha
                    * (
                        0.12
                        + 0.30 * white_mix
                    ),
                    math.max(
                        0.75,
                        core_thick * 0.34
                    )
                )
            end

            previous = point
        end
    end
end


function FALLEN_BT_DRAW_LAVA(
    tr,
    points,
    reveal,
    alpha,
    thick
)
    if type(points) ~= "table"
        or #points < 2
        or type(DrawLine) ~= "function"
    then
        return
    end

    local max_u =
        clamp(
            tonumber(reveal) or 0,
            0,
            1
        )

    if max_u <= 0.001 then
        return
    end

    tr._revealed_points =
        tr._revealed_points
        or {}

    local visible_points =
        FALLEN_BT_REVEALED_POINTS(
            points,
            max_u,
            tr._revealed_points
        )

    if #visible_points < 2 then
        return
    end

    local core_thick =
        clamp(
            0.95
            + (tonumber(thick) or 2) * 0.34,
            1.15,
            3.15
        )

    local prev_x = nil
    local prev_y = nil
    local prev_u = nil

    for i = 1, #visible_points do
        local point = visible_points[i]

        if point
            and point.x
            and point.y
            and point.u
        then
            local cur_x = point.x
            local cur_y = point.y
            local cur_u = point.u

            if prev_x ~= nil then
                local normalized =
                    clamp(
                        (
                            (prev_u + cur_u)
                            * 0.5
                        )
                        / math.max(max_u, 0.0001),
                        0,
                        1
                    )

                local center_mix =
                    clamp(
                        1
                        - math.abs(
                            (normalized - 0.5) * 2
                        ),
                        0,
                        1
                    )

                -- yellow -> orange -> yellow
                local rr = 1.0
                local gg =
                    0.90
                    + (0.30 - 0.90) * center_mix

                local bb =
                    0.06
                    + (0.015 - 0.06) * center_mix

                for g = 35, 1, -1 do
                    local gt = g / 35

                    local glow_width =
                        core_thick
                        + 0.55
                        + g * 0.18

                    local glow_alpha =
                        alpha
                        * (
                            0.020
                            + (1 - gt) * 0.018
                        )

                    DrawLine(
                        prev_x,
                        prev_y,
                        cur_x,
                        cur_y,
                        rr,
                        gg,
                        bb,
                        glow_alpha,
                        glow_width
                    )
                end

                DrawLine(
                    prev_x,
                    prev_y,
                    cur_x,
                    cur_y,
                    rr,
                    gg,
                    bb,
                    alpha * 0.10,
                    core_thick + 8.5
                )

                DrawLine(
                    prev_x,
                    prev_y,
                    cur_x,
                    cur_y,
                    rr,
                    gg,
                    bb,
                    alpha * 0.16,
                    core_thick + 5.2
                )

                DrawLine(
                    prev_x,
                    prev_y,
                    cur_x,
                    cur_y,
                    rr,
                    gg,
                    bb,
                    alpha * 0.98,
                    core_thick
                )

                local hg =
                    0.96
                    - 0.30 * center_mix

                local hb =
                    0.34
                    - 0.23 * center_mix

                DrawLine(
                    prev_x,
                    prev_y,
                    cur_x,
                    cur_y,
                    1.0,
                    hg,
                    hb,
                    alpha * 0.72,
                    math.max(
                        0.75,
                        core_thick * 0.40
                    )
                )
            end

            prev_x = cur_x
            prev_y = cur_y
            prev_u = cur_u
        end
    end
end

function FALLEN_BT_ANIMATION_NAME()
    local name = tostring(S.bullet_tracer_animation or "None")

    if name ~= "None" and name ~= "Sway" and name ~= "Wave" then
        name = "None"
        S.bullet_tracer_animation = name
    end

    A.bt_animation_cache_name = name
    return name
end


function FALLEN_BT_APPLY_ANIMATION(tr, points)
    if type(points) ~= "table" or #points < 2 then
        return points
    end

    local mode = FALLEN_BT_ANIMATION_NAME()
    if mode == "None" then
        return points
    end

    local now = tick()
    local seed = tonumber(tr and tr.seed) or 1
    tr._anim_points = tr._anim_points or {}
    local out = tr._anim_points
    local old_count = #out
    local count = 0
    local total = #points

    for i = 1, total do
        local point = points[i]
        if point and point.x and point.y and point.u then
            local px, py = point.x, point.y
            local p0 = points[i > 1 and i - 1 or 1]
            local p1 = points[i < total and i + 1 or total]

            if p0 and p1 and p0.x and p0.y and p1.x and p1.y then
                local dx = p1.x - p0.x
                local dy = p1.y - p0.y
                local len = math.sqrt(dx * dx + dy * dy)

                if len > 0.01 then
                    local u = clamp(tonumber(point.u) or 0, 0, 1)
                    local edge = math.sin(u * math.pi)
                    local offset

                    if mode == "Sway" then
                        offset = math.sin(now * 1.95 + seed * 0.011 + u * 5.0) * 1.55 * edge
                    else
                        offset = math.sin(now * 3.00 + seed * 0.013 + u * 12.0) * 2.15 * edge
                    end

                    px = px + (-dy / len) * offset
                    py = py + (dx / len) * offset
                end
            end

            count = count + 1
            local o = out[count] or {}
            out[count] = o
            o.x, o.y, o.u = px, py, point.u
            o.wx, o.wy, o.wz = point.wx, point.wy, point.wz
        end
    end

    for i = count + 1, old_count do out[i] = nil end
    return count >= 2 and out or points
end

function FALLEN_BT_DRAW_PATH(
    tr,
    points,
    reveal,
    alpha,
    thick
)
    if type(points) ~= "table"
        or #points < 2
        or type(DrawLine) ~= "function"
    then
        return
    end

    local style =
        FALLEN_BT_STYLE_INDEX()

    if style == 3 then
        FALLEN_BT_DRAW_WATER(
            tr,
            points,
            reveal,
            alpha,
            thick
        )
        return

    elseif style == 4 then
        FALLEN_BT_DRAW_LAVA(
            tr,
            points,
            reveal,
            alpha,
            thick
        )
        return
    end

    local max_u =
        clamp(
            reveal,
            0,
            1
        )

    tr._revealed_points =
        tr._revealed_points
        or {}

    local visible_points =
        FALLEN_BT_REVEALED_POINTS(
            points,
            max_u,
            tr._revealed_points
        )

    if #visible_points < 2 then
        return
    end

    local now = tick()
    local seed = tr.seed or 1
    local col =
        style ~= 2
        and FALLEN_BT_COLOR()
        or nil

    local prev_x = nil
    local prev_y = nil
    local prev_u = nil

    for i = 1, #visible_points do
        local point =
            visible_points[i]

        if point
            and point.x
            and point.y
            and point.u
        then
            local px = point.x
            local py = point.y
            local pu = point.u

            if style == 1 then
                local nx_from_x =
                    prev_x
                    or px

                local nx_from_y =
                    prev_y
                    or py

                local dx =
                    px - nx_from_x

                local dy =
                    py - nx_from_y

                local len =
                    math.sqrt(
                        dx * dx
                        + dy * dy
                    )

                if len > 0.01 then
                    local nx =
                        -dy / len

                    local ny =
                        dx / len

                    local offset =
                        math.sin(
                            pu * 54
                            + seed * 0.017
                            + now * 4
                        )
                        * 2.25

                    px =
                        px
                        + nx * offset

                    py =
                        py
                        + ny * offset
                end
            end

            if prev_x ~= nil then
                if style == 2 then
                    local hue =
                        (
                            now * 0.20
                            + pu * 0.92
                            + (seed % 97) / 97
                        )
                        % 1

                    local rr, gg, bb =
                        hsv_to_rgb(
                            hue,
                            0.88,
                            1
                        )

                    DrawLine(prev_x, prev_y, px, py,
                        rr, gg, bb, alpha * 0.12, thick + 14)
                    DrawLine(prev_x, prev_y, px, py,
                        rr, gg, bb, alpha * 0.32, thick + 7)
                    DrawLine(prev_x, prev_y, px, py,
                        rr, gg, bb, alpha * 0.96, thick + 1.5)
                    DrawLine(prev_x, prev_y, px, py,
                        1, 1, 1, alpha * 0.24, 1)

                elseif style == 1 then
                    DrawLine(prev_x, prev_y, px, py,
                        col[1], col[2], col[3], alpha * 0.15, thick + 5)
                    DrawLine(prev_x, prev_y, px, py,
                        col[1], col[2], col[3], alpha * 0.36, thick + 2)
                    DrawLine(prev_x, prev_y, px, py,
                        col[1], col[2], col[3], alpha * 0.92, thick)
                    DrawLine(prev_x, prev_y, px, py,
                        1, 1, 1, alpha * 0.44, 1)

                else
                    DrawLine(prev_x, prev_y, px, py,
                        col[1], col[2], col[3], alpha * 0.10, thick + 12)
                    DrawLine(prev_x, prev_y, px, py,
                        col[1], col[2], col[3], alpha * 0.20, thick + 8)
                    DrawLine(prev_x, prev_y, px, py,
                        col[1], col[2], col[3], alpha * 0.38, thick + 5)
                    DrawLine(prev_x, prev_y, px, py,
                        col[1], col[2], col[3], alpha * 0.78, thick + 2)
                    DrawLine(prev_x, prev_y, px, py,
                        1, 1, 1, alpha * 0.62, math.max(1, thick - 0.35))
                end
            end

            prev_x = px
            prev_y = py
            prev_u = pu
        end
    end
end

function FALLEN_BT_WORLD_PATH(tr)
    if type(tr) ~= "table" then return {} end
    if type(tr._world_points) == "table" then return tr._world_points end

    local out = {}

    if tr.auto_prediction == true and (tonumber(tr.prediction_time) or 0) > 0.0001 then
        local total_time = clamp(tonumber(tr.prediction_time) or 0, 0, 3)
        local gravity = tonumber(tr.gravity) or 0
        local drop = 0.5 * gravity * total_time * total_time
        local impact_x = tr.tx
        local impact_y = tr.ty - drop
        local impact_z = tr.tz
        local vx = (impact_x - tr.ox) / total_time
        local vy = (impact_y - tr.oy) / total_time + 0.5 * gravity * total_time
        local vz = (impact_z - tr.oz) / total_time
        local steps = 48

        for i = 0, steps do
            local u = i / steps
            local t = total_time * u
            out[#out + 1] = {
                X = tr.ox + vx * t,
                Y = tr.oy + vy * t - 0.5 * gravity * t * t,
                Z = tr.oz + vz * t,
                u = u,
            }
        end
    else
        local steps = 32
        for i = 0, steps do
            local u = i / steps
            out[#out + 1] = {
                X = tr.ox + (tr.tx - tr.ox) * u,
                Y = tr.oy + (tr.ty - tr.oy) * u,
                Z = tr.oz + (tr.tz - tr.oz) * u,
                u = u,
            }
        end
    end

    tr._world_points = out
    return out
end

function FALLEN_BT_PROJECT_CACHED_PATH(tr)
    local world_points = FALLEN_BT_WORLD_PATH(tr)
    tr._screen_points = tr._screen_points or {}
    local out = tr._screen_points
    local old_count = #out
    local count = 0

    for i = 1, #world_points do
        local world = world_points[i]
        local screen = FALLEN_BT_PROJECT(world)
        if screen then
            count = count + 1
            local o = out[count] or {}
            out[count] = o
            o.x, o.y, o.u = screen.X, screen.Y, world.u
            o.wx, o.wy, o.wz = world.X, world.Y, world.Z
        end
    end

    for i = count + 1, old_count do out[i] = nil end
    return out
end

function FALLEN_BT_DRAW_ONE(tr, age, life)
    local reveal_time =
        clamp(
            tonumber(S.bullet_tracer_reveal) or 0.22,
            0.03,
            1.50
        )

    local reveal_raw =
        clamp(
            age / reveal_time,
            0,
            1
        )

    -- Smooth continuous reveal. Exact endpoint interpolation above prevents
    -- the tracer tip from advancing sample-by-sample.
    local reveal =
        reveal_raw
        * reveal_raw
        * (3 - 2 * reveal_raw)

    local fade =
        clamp(
            1 - age / life,
            0,
            1
        )

    local col = FALLEN_BT_COLOR()
    local alpha = fade * (col[4] or 1)

    local thick =
        clamp(
            tonumber(S.bullet_tracer_thickness) or 2,
            1,
            6
        )

    if alpha <= 0.002 then
        return
    end

    local points =
        FALLEN_BT_PROJECT_CACHED_PATH(
            tr
        )

    points =
        FALLEN_BT_APPLY_ANIMATION(
            tr,
            points
        )

    FALLEN_BT_DRAW_PATH(
        tr,
        points,
        reveal,
        alpha,
        thick
    )
end
function FALLEN_BT_DRAW()
    if type(FALLEN_BT.items) ~= "table" then
        FALLEN_BT.items = {}
    end

    local now = tick()

    local life =
        clamp(
            tonumber(S.bullet_tracer_life) or 1.2,
            0.10,
            8.0
        )

    for i = #FALLEN_BT.items, 1, -1 do
        local tr = FALLEN_BT.items[i]
        local age = now - (tr.created or now)

        if age > life
            or S.bullet_tracer_enabled ~= true
        then
            if tr then
                tr._world_points = nil
                tr._screen_points = nil
                tr._revealed_points = nil
                tr._anim_points = nil
            end

            table.remove(FALLEN_BT.items, i)
        else
            FALLEN_BT_DRAW_ONE(
                tr,
                age,
                life
            )
        end
    end
end

function FALLEN_BT_TICK()
    if _G.FallenMenuReady ~= true then
