function FALLEN_HITFX_VFX_KIND(
    inst
)
    if not inst
        or not FALLEN_BT_VFX_INSTANCE_VALID(
            inst
        )
    then
        return nil
    end

    local name = nil

    pcall(function()
        name =
            inst:get_name()
    end)

    name =
        string.lower(
            tostring(
                name or ""
            )
        )

    -- Hit Effects are STRICTLY BloodPart-only.
    if name == "bloodpart" then
        return "bloodpart"
    end

    return nil
end


