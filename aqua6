local function fallen_search_edge(vk)
    local held = key_down(vk)
    local prev = A.search_prev_keys[vk] == true
    A.search_prev_keys[vk] = held
    return held and not prev
end

local function fallen_search_poll()
    if not A.search_open then return end
    if fallen_search_edge(0x1B) then
        fallen_search_close()
        return
    end
    if fallen_search_edge(0x08) then
        A.search_query = string.sub(A.search_query, 1, math.max(0, #A.search_query - 1))
        return
    end
    local ctrl = key_down(0x11) or key_down(0xA2) or key_down(0xA3)
    if ctrl and fallen_search_edge(0x56) then
        if type(get_clipboard) == "function" then
            local ok, value = pcall(get_clipboard)
            if ok and type(value) == "string" then
                local plain = value:gsub("[^%w%s]", "")
                A.search_query = (A.search_query .. plain):sub(1, 27)
            end
        end
        return
    end
    if ctrl then return end
    -- Only physical keys documented by this API; edge detection avoids repeats.
    if #(A.search_query or "") >= 27 then return end
    for vk = 0x41, 0x5A do
        if fallen_search_edge(vk) then
            A.search_query = A.search_query .. string.lower(string.char(vk))
            return
        end
    end
    for number = 0, 9 do
        if fallen_search_edge(0x30 + number) or fallen_search_edge(0x60 + number) then
            A.search_query = A.search_query .. tostring(number)
            return
        end
    end
    if fallen_search_edge(0x20) then
        A.search_query = A.search_query .. " "
    end
end

local function fallen_search_normalize(q)
    return tostring(q or ""):lower():gsub("[^%w]", "")
end

local function fallen_search_draw_icon(x, y)
    local icon = FALLEN_SEARCH_ICON_GET()
    if icon and type(DrawImage) == "function" then
        pcall(DrawImage, icon,
