function FALLEN_SECRET_CROSSHAIR_COLOR()
    local r, g, b =
        hsv_to_rgb(
            tonumber(S.secret_crosshair_h) or 0,
            tonumber(S.secret_crosshair_s) or 0,
            tonumber(S.secret_crosshair_v) or 1
        )

    return {
        r,
        g,
        b,
        clamp(
            (tonumber(S.secret_crosshair_alpha) or 100) / 100,
            0,
            1
        ),
    }
end

function FALLEN_SECRET_CROSSHAIR_STYLE_STEP()
    local now = tick()

    if A.secret_crosshair_style_last_t == nil then
        A.secret_crosshair_style_last_t = now
    end

    local dt =
        clamp(
            now - A.secret_crosshair_style_last_t,
            0,
            0.05
        )

    A.secret_crosshair_style_last_t = now

    local target =
        A.secret_crosshair_style_open
        and 1
        or 0

    local speed =
        target > (A.secret_crosshair_style_anim or 0)
        and 16
        or 12

    A.secret_crosshair_style_anim =
        exp_chase(
            A.secret_crosshair_style_anim or 0,
            target,
            speed,
            dt
        )

    if math.abs(
        (A.secret_crosshair_style_anim or 0)
        - target
    ) < 0.0015
    then
        A.secret_crosshair_style_anim = target
    end

    return
        clamp(
            A.secret_crosshair_style_anim or 0,
            0,
            1
        )
end

function FALLEN_DRAW_SECRET_CROSSHAIR_STYLE_DROPDOWN(
    mx,
    my,
    clicked,
    x,
    y,
    w
)
    local anim =
        FALLEN_SECRET_CROSSHAIR_STYLE_STEP()

    if anim <= 0.004
        and not A.secret_crosshair_style_open
    then
        return false
    end

    local options = {
        "Sharp",
        "Rounded",
    }

    local item_h = 27
    local full_h = #options * item_h
    local visible_h = full_h * ease_out_cubic(anim)
    local panel_h = math.max(2, visible_h)

    FALLEN_POPUP_GLOW(
        x,
        y,
        w,
        panel_h,
        7,
        0.9
    )

    rounded_fill(
        x,
        y,
        w,
        panel_h,
        7,
        { 0.070, 0.074, 0.087, 1 }
    )

    local panel_hot =
        hover(
            mx,
            my,
            x,
            y,
            w,
            panel_h
        )

    for i, option in ipairs(options) do
        local iy = y + (i - 1) * item_h

        local reveal =
            clamp(
                (visible_h - (i - 1) * item_h) / item_h,
                0,
                1
            )

        if reveal > 0.12 then
            local item_hot =
                reveal > 0.92
                and hover(
                    mx,
                    my,
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4
                )

            if item_hot then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4,
                    5,
                    { 0.105, 0.111, 0.132, 1 }
                )
            end

            local selected =
                tostring(
                    S.secret_crosshair_style
                        or "Sharp"
                ) == option

            if selected then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    3,
                    item_h - 4,
                    1,
                    C.accent
                )
            end

            text(
                x + 12,
                iy + 8,
                option,
                FALLEN_HOVER_TEXT(
                    "secret_crosshair_style:" .. tostring(option),
                    item_hot,
                    selected
                        and C.text
                        or C.text_dim
                )
            )

            if clicked
                and item_hot
                and A.secret_crosshair_style_open
            then
                S.secret_crosshair_style = option
                A.secret_crosshair_style_open = false
                return true
            end
        end
    end

    return panel_hot
end

hooks.on_render(function()
    if S.secret_crosshair ~= true then
        return
    end

    local dims = nil
    pcall(function()
        dims = ScreenSize()
    end)

    local sw =
        dims
        and tonumber(dims.Width or dims.X)
        or 1920

    local sh =
        dims
        and tonumber(dims.Height or dims.Y)
        or 1080

    local cx = math.floor(sw * 0.5)
    local cy = math.floor(sh * 0.5)

    local size =
        clamp(
            math.floor(
                tonumber(S.secret_crosshair_size) or 16
            ),
            8,
            40
        )

    local style =
        tostring(
            S.secret_crosshair_style
                or "Sharp"
        )

    local col =
        FALLEN_SECRET_CROSSHAIR_COLOR()

    local now = tick()
    if A.secret_crosshair_render_last_t == nil then
        A.secret_crosshair_render_last_t = now
    end

    local dt =
        clamp(
            now - A.secret_crosshair_render_last_t,
            0,
            0.05
        )

    A.secret_crosshair_render_last_t = now

    local ang =
        tonumber(A.secret_crosshair_angle) or 0

    local rot_speed = math.rad(95)

    if S.secret_crosshair_rotate == true then
        ang = ang + rot_speed * dt
        if ang > math.pi * 2 then
            ang = ang - math.pi * 2
        end
    else
        while ang > math.pi do
            ang = ang - math.pi * 2
        end
        while ang < -math.pi do
            ang = ang + math.pi * 2
        end

        ang =
            exp_chase(
                ang,
                0,
                12,
                dt
            )

        if math.abs(ang) < 0.0008 then
            ang = 0
        end
    end

    A.secret_crosshair_angle = ang

    local extent = size
    local thick = 3
    local cap_r = 2

    local ca = math.cos(ang)
    local sa = math.sin(ang)

    local function rot(x, y)
        return
            cx + x * ca - y * sa,
            cy + x * sa + y * ca
    end

    local function draw_seg(x1, y1, x2, y2)
        local ax, ay = rot(x1, y1)
        local bx, by = rot(x2, y2)

        DrawLine(
            ax,
            ay,
            bx,
            by,
            col[1],
            col[2],
            col[3],
            col[4] or 1,
            thick
        )
    end

    local function draw_cap(x, y)
        local px, py = rot(x, y)

        if type(DrawCircleFilled) == "function" then
            DrawCircleFilled(
                px,
                py,
                cap_r,
                col[1],
                col[2],
                col[3],
                col[4] or 1
            )
        else
            DrawBoxFilled(
                px - cap_r,
                py - cap_r,
                px + cap_r,
                py + cap_r,
                col[1],
                col[2],
                col[3],
                col[4] or 1
            )
        end
    end

    -- Shared homunculus geometry.
    -- top horizontal:    (-extent,-extent) -> (0,-extent)
    -- center vertical:   (0,-extent)       -> (0, extent)
    -- middle horizontal: (-extent,0)       -> (extent,0)
    -- left vertical:     (-extent,0)       -> (-extent, extent)
    -- right vertical:    (extent,-extent)  -> (extent,0)
    -- bottom horizontal: (0, extent)       -> (extent, extent)
    draw_seg(-extent, -extent, 0, -extent)
    draw_seg(0, -extent, 0, extent)
    draw_seg(-extent, 0, extent, 0)
    draw_seg(-extent, 0, -extent, extent)
    draw_seg(extent, -extent, extent, 0)
    draw_seg(0, extent, extent, extent)

    if style == "Rounded" then
        -- Only exposed outer terminals get rounded caps.
        draw_cap(-extent, -extent) -- top-left
        draw_cap(0, -extent)       -- top-center
        draw_cap(extent, -extent)  -- top-right
        draw_cap(-extent, extent)  -- bottom-left
        draw_cap(0, extent)        -- bottom-center
        draw_cap(extent, extent)   -- bottom-right
    end
end)

-- =========================================================
-- 3D World Rain
-- =========================================================
-- World-space rain with real geometry collision + visibility occlusion.
-- The API has no Workspace:Raycast, so we build a lightweight cache of
-- collidable BaseParts and perform our own ray-vs-oriented-box tests.
-- This fixes both old issues:
--   * rain no longer renders through walls;
--   * impact splashes land on the actual surface below each drop instead of
--     on a flat plane derived from the local HumanoidRootPart.
function FALLEN_WORLD_RAIN_CENTER()
    if not rbx
        or type(rbx.local_hrp) ~= "function"
    then
        return nil, nil
    end

    local hrp = nil
    local pos = nil

    pcall(function()
        hrp = rbx.local_hrp()
        if hrp then
            pos = hrp:get_position()
        end
    end)

    return pos, hrp
end

function FALLEN_WORLD_RAIN_CAMERA_POS()
    local pos = nil

    pcall(function()
        if rbx and type(rbx.camera) == "function" then
            local cam = rbx.camera()
            if cam and type(cam.camera_pos) == "function" then
                pos = cam:camera_pos()
            end
        end
    end)

    if not pos then
        pcall(function()
            if aim and type(aim.get_camera_position) == "function" then
                pos = aim.get_camera_position()
            end
        end)
    end

    if not pos then
        pcall(function()
            if type(get_camera) == "function" then
                local cam = get_camera()
                if type(cam) == "table" then
                    pos = cam.position or cam.Position
                end
            end
        end)
    end

    return pos
end

-- Keep world weather visually behind the custom menu. The menu can be
-- translucent (Glass), so normal draw order alone is not enough: projected
-- weather strokes are clipped against the live menu rectangle.
function FALLEN_WORLD_RAIN_W2S(pos)
    if not pos then return nil end

    local s = nil

    pcall(function()
        if rbx and type(rbx.world_to_screen) == "function" then
            s = rbx.world_to_screen(pos)
        elseif aim and type(aim.world_to_screen) == "function" then
            s = aim.world_to_screen(pos)
        end
    end)

    if not s then return nil end
    if s.visible == false then return nil end

    local x = tonumber(s.X or s.x or s[1])
    local y = tonumber(s.Y or s.y or s[2])
    if not x or not y then return nil end

    return { X = x, Y = y }
end

function FALLEN_WORLD_RAIN_LINE_HITS_MENU(p1, p2)
    local rect = FALLEN_WEATHER_MENU_RECT

    if type(rect) ~= "table"
        or (tonumber(rect.open_alpha) or 0) <= 0.02
    then
        return false
    end

    local a = FALLEN_WORLD_RAIN_W2S(p1)
    local b = FALLEN_WORLD_RAIN_W2S(p2)
    if not a or not b then return false end

    local pad = 4
    local x1 = (tonumber(rect.x) or 0) - pad
    local y1 = (tonumber(rect.y) or 0) - pad
    local x2 = x1 + (tonumber(rect.w) or 0) + pad * 2
    local y2 = y1 + (tonumber(rect.h) or 0) + pad * 2

    local function inside(pt)
        return pt.X >= x1 and pt.X <= x2
            and pt.Y >= y1 and pt.Y <= y2
    end

    if inside(a) or inside(b) then
        return true
    end

    local dx = b.X - a.X
    local dy = b.Y - a.Y
    local t0, t1 = 0, 1

    local function clip(pv, qv)
        if math.abs(pv) < 0.000001 then
            return qv >= 0
        end

        local rr = qv / pv
        if pv < 0 then
            if rr > t1 then return false end
            if rr > t0 then t0 = rr end
        else
            if rr < t0 then return false end
            if rr < t1 then t1 = rr end
        end
        return true
    end

    if not clip(-dx, a.X - x1) then return false end
    if not clip( dx, x2 - a.X) then return false end
    if not clip(-dy, a.Y - y1) then return false end
    if not clip( dy, y2 - a.Y) then return false end

    return t0 <= t1
end

function FALLEN_WORLD_RAIN_GRID_KEY(ix, iz)
    return tostring(ix) .. ":" .. tostring(iz)
end

-- Exact segment/ray hit against a rotated BasePart box. The rotation matrix
-- returned by :get_rotation() is row-major; transpose transforms world-space
-- ray data into the part's local box space.
function FALLEN_WORLD_RAIN_RAY_OBB(ox, oy, oz, dx, dy, dz, max_dist, p)
    if not p then return nil end

    local rx = ox - p.x
    local ry = oy - p.y
    local rz = oz - p.z

    local lox = p.m1 * rx + p.m4 * ry + p.m7 * rz
    local loy = p.m2 * rx + p.m5 * ry + p.m8 * rz
    local loz = p.m3 * rx + p.m6 * ry + p.m9 * rz

    local ldx = p.m1 * dx + p.m4 * dy + p.m7 * dz
    local ldy = p.m2 * dx + p.m5 * dy + p.m8 * dz
    local ldz = p.m3 * dx + p.m6 * dy + p.m9 * dz

    local tmin = 0
    local tmax = max_dist
    local eps = 0.000001

    if math.abs(ldx) < eps then
        if lox < -p.hx or lox > p.hx then return nil end
    else
        local t1 = (-p.hx - lox) / ldx
        local t2 = ( p.hx - lox) / ldx
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tmin then tmin = t1 end
        if t2 < tmax then tmax = t2 end
        if tmin > tmax then return nil end
    end

    if math.abs(ldy) < eps then
        if loy < -p.hy or loy > p.hy then return nil end
    else
        local t1 = (-p.hy - loy) / ldy
        local t2 = ( p.hy - loy) / ldy
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tmin then tmin = t1 end
        if t2 < tmax then tmax = t2 end
        if tmin > tmax then return nil end
    end

    if math.abs(ldz) < eps then
        if loz < -p.hz or loz > p.hz then return nil end
    else
        local t1 = (-p.hz - loz) / ldz
        local t2 = ( p.hz - loz) / ldz
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tmin then tmin = t1 end
        if t2 < tmax then tmax = t2 end
        if tmin > tmax then return nil end
    end

    if tmax < 0 or tmin > max_dist then
        return nil
    end

    if tmin < 0 then
        return 0
    end

    return tmin
end

function FALLEN_WORLD_RAIN_PART_IS_LOCAL_CHARACTER(part, char_addr)
    if not part or not char_addr or char_addr == 0 then
        return false
    end

    local cur = part

    for _ = 1, 8 do
        if not cur then break end

        local addr = tonumber(cur.addr) or 0
        if addr == char_addr then
            return true
        end

        local parent = nil
        pcall(function()
            parent = cur:parent()
        end)
        cur = parent
    end

    return false
end

function FALLEN_WORLD_RAIN_UPDATE_GEOMETRY(center, radius)
    if not center or not rbx or type(rbx.workspace) ~= "function" then
        return
    end

    radius = clamp(tonumber(radius) or 28, 8, 300)

    local now_t = tick()

    -- One-time occlusion build only.
    -- No timer, movement threshold, or radius-triggered Workspace rescan.
    if A.world_rain_geo ~= nil then
        return
    end

    local ws = nil
    pcall(function()
        ws = rbx.workspace()
    end)
    if not ws then return end

    local char_addr = 0
    pcall(function()
        if type(rbx.local_character) == "function" then
            local ch = rbx.local_character()
            char_addr = ch and (tonumber(ch.addr) or 0) or 0
        end
    end)

    local source = {}
    local seen_addr = {}

    local function add_list(list)
        if type(list) ~= "table" then return end
        for _, inst in ipairs(list) do
            local addr = inst and (tonumber(inst.addr) or 0) or 0
            if inst and (addr == 0 or not seen_addr[addr]) then
                if addr ~= 0 then seen_addr[addr] = true end
                source[#source + 1] = inst
            end
        end
    end

    -- Some builds accept BasePart as an IsA query. If not, fall back to the
    -- concrete part classes most commonly used by Roblox maps.
    pcall(function()
        add_list(ws:find_descendants_of_class("BasePart"))
    end)

    if #source == 0 then
        local classes = {
            "Part",
            "MeshPart",
            "UnionOperation",
            "TrussPart",
            "WedgePart",
            "CornerWedgePart"
        }

        for _, class_name in ipairs(classes) do
            pcall(function()
                add_list(ws:find_descendants_of_class(class_name))
            end)
        end
    end

    local cell = 36
    local pad = math.max(radius + 110, 520)
    local scan_x1 = center.X - pad
    local scan_x2 = center.X + pad
    local scan_z1 = center.Z - pad
    local scan_z2 = center.Z + pad

    local geo = {
        time = now_t,
        cx = center.X,
        cz = center.Z,
        radius = radius,
        cell = cell,
        parts = {},
        grid = {},
        ray_serial = 0,
    }

    for _, part in ipairs(source) do
        if #geo.parts >= 6500 then
            break
        end

        if not FALLEN_WORLD_RAIN_PART_IS_LOCAL_CHARACTER(part, char_addr) then
            local can_collide = true
            pcall(function()
                if type(part.get_can_collide) == "function" then
                    can_collide = part:get_can_collide() == true
                end
            end)

            if can_collide then
                local pos, size, rot = nil, nil, nil

                pcall(function() pos = part:get_position() end)
                pcall(function() size = part:get_size() end)
                pcall(function() rot = part:get_rotation() end)

                if pos and size then
                    rot = type(rot) == "table" and rot or {1,0,0, 0,1,0, 0,0,1}

                    local px = tonumber(pos.X or pos[1])
                    local py = tonumber(pos.Y or pos[2])
                    local pz = tonumber(pos.Z or pos[3])
                    local sx = math.abs(tonumber(size.X or size[1]) or 0)
                    local sy = math.abs(tonumber(size.Y or size[2]) or 0)
                    local sz = math.abs(tonumber(size.Z or size[3]) or 0)

                    if px and py and pz
                        and sx > 0.04 and sy > 0.04 and sz > 0.04
                    then
                        local hx, hy, hz = sx * 0.5, sy * 0.5, sz * 0.5
                        local m1 = tonumber(rot[1]) or 1
                        local m2 = tonumber(rot[2]) or 0
                        local m3 = tonumber(rot[3]) or 0
                        local m4 = tonumber(rot[4]) or 0
                        local m5 = tonumber(rot[5]) or 1
                        local m6 = tonumber(rot[6]) or 0
                        local m7 = tonumber(rot[7]) or 0
                        local m8 = tonumber(rot[8]) or 0
                        local m9 = tonumber(rot[9]) or 1

                        local ex = math.abs(m1) * hx + math.abs(m2) * hy + math.abs(m3) * hz
                        local ez = math.abs(m7) * hx + math.abs(m8) * hy + math.abs(m9) * hz

                        if px + ex >= scan_x1 and px - ex <= scan_x2
                            and pz + ez >= scan_z1 and pz - ez <= scan_z2
                            and math.abs(py - center.Y) <= 520 + hy
                        then
                            local rec = {
                                x = px, y = py, z = pz,
                                hx = hx, hy = hy, hz = hz,
                                m1 = m1, m2 = m2, m3 = m3,
                                m4 = m4, m5 = m5, m6 = m6,
                                m7 = m7, m8 = m8, m9 = m9,
                                mark = 0,
                            }

                            geo.parts[#geo.parts + 1] = rec
                            local index = #geo.parts

                            local minx = math.max(px - ex, scan_x1)
                            local maxx = math.min(px + ex, scan_x2)
                            local minz = math.max(pz - ez, scan_z1)
                            local maxz = math.min(pz + ez, scan_z2)

                            local gx1 = math.floor(minx / cell)
                            local gx2 = math.floor(maxx / cell)
                            local gz1 = math.floor(minz / cell)
                            local gz2 = math.floor(maxz / cell)

                            for gx = gx1, gx2 do
                                for gz = gz1, gz2 do
                                    local key = FALLEN_WORLD_RAIN_GRID_KEY(gx, gz)
                                    local bucket = geo.grid[key]
                                    if not bucket then
                                        bucket = {}
                                        geo.grid[key] = bucket
                                    end
                                    bucket[#bucket + 1] = index
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    A.world_rain_geo = geo
end

-- Raycast through the cached part grid. Direction must be normalized.
function FALLEN_WORLD_RAIN_RAYCAST_GRID(ox, oy, oz, dx, dy, dz, max_dist)
    local geo = A.world_rain_geo
    if type(geo) ~= "table" or type(geo.grid) ~= "table" then
        return nil, nil
    end

    max_dist = tonumber(max_dist) or 0
    if max_dist <= 0 then return nil, nil end

    local cell = tonumber(geo.cell) or 36
    local cx = math.floor(ox / cell)
    local cz = math.floor(oz / cell)
    local ex = ox + dx * max_dist
    local ez = oz + dz * max_dist
    local end_cx = math.floor(ex / cell)
    local end_cz = math.floor(ez / cell)

    local step_x = dx > 0 and 1 or (dx < 0 and -1 or 0)
    local step_z = dz > 0 and 1 or (dz < 0 and -1 or 0)

    local inf = 1e30
    local t_delta_x = step_x ~= 0 and (cell / math.abs(dx)) or inf
    local t_delta_z = step_z ~= 0 and (cell / math.abs(dz)) or inf

    local next_x = step_x > 0 and ((cx + 1) * cell) or (cx * cell)
    local next_z = step_z > 0 and ((cz + 1) * cell) or (cz * cell)

    local t_max_x = step_x ~= 0 and ((next_x - ox) / dx) or inf
    local t_max_z = step_z ~= 0 and ((next_z - oz) / dz) or inf

    if t_max_x < 0 then t_max_x = 0 end
    if t_max_z < 0 then t_max_z = 0 end

    geo.ray_serial = (tonumber(geo.ray_serial) or 0) + 1
    if geo.ray_serial > 2000000000 then geo.ray_serial = 1 end
    local mark = geo.ray_serial

    local best_t = nil
    local best_part = nil
    local guard = 0

    while guard < 1024 do
        guard = guard + 1

        local bucket = geo.grid[FALLEN_WORLD_RAIN_GRID_KEY(cx, cz)]
        if type(bucket) == "table" then
            for _, index in ipairs(bucket) do
                local p = geo.parts[index]
                if p and p.mark ~= mark then
                    p.mark = mark
                    local hit = FALLEN_WORLD_RAIN_RAY_OBB(
                        ox, oy, oz,
                        dx, dy, dz,
                        best_t or max_dist,
                        p
                    )

                    if hit and hit >= 0
                        and hit <= max_dist
                        and (best_t == nil or hit < best_t)
                    then
                        best_t = hit
                        best_part = p
                    end
                end
            end
        end

        if best_t then
            local next_boundary = math.min(t_max_x, t_max_z)
            if best_t <= next_boundary + 0.001 then
                break
            end
        end

        if cx == end_cx and cz == end_cz then
            break
        end

        if t_max_x < t_max_z then
            if t_max_x > max_dist then break end
            cx = cx + step_x
            t_max_x = t_max_x + t_delta_x
        else
            if t_max_z > max_dist then break end
            cz = cz + step_z
            t_max_z = t_max_z + t_delta_z
        end
    end

    return best_t, best_part
end

function FALLEN_WORLD_RAIN_GROUND_Y(x, z, from_y, max_down)
    local geo = A.world_rain_geo
    if type(geo) ~= "table" then return nil end

    local hit = FALLEN_WORLD_RAIN_RAYCAST_GRID(
        x,
        from_y,
        z,
        0,
        -1,
        0,
        max_down or 420
    )

    if not hit then return nil end
    return from_y - hit + 0.035
end

function FALLEN_WORLD_RAIN_SEGMENT_VISIBLE(p1, p2)
    if not p1 or not p2 then return false end

    local cam = FALLEN_WORLD_RAIN_CAMERA_POS()
    if not cam then return true end

    local tx = (p1.X + p2.X) * 0.5
    local ty = (p1.Y + p2.Y) * 0.5
    local tz = (p1.Z + p2.Z) * 0.5

    local dx = tx - cam.X
    local dy = ty - cam.Y
    local dz = tz - cam.Z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)

    if dist < 0.35 then return true end

    dx, dy, dz = dx / dist, dy / dist, dz / dist

    -- Leave a small tolerance at the target so the surface the splash sits on
    -- does not hide the splash itself.
    local hit = FALLEN_WORLD_RAIN_RAYCAST_GRID(
        cam.X,
        cam.Y,
        cam.Z,
        dx,
        dy,
        dz,
        math.max(0, dist - 0.42)
    )

    return hit == nil
end

function FALLEN_WORLD_RAIN_LINE3D(p1, p2, r, g, b, a, thickness, visibility_checked)
    if not p1 or not p2 then
        return
    end

    if FALLEN_WORLD_RAIN_LINE_HITS_MENU(p1, p2) then
        return
    end

    if visibility_checked ~= true
        and not FALLEN_WORLD_RAIN_SEGMENT_VISIBLE(p1, p2)
    then
        return
    end

    if Drawing
        and type(Drawing.DrawLine3D) == "function"
    then
        pcall(
            Drawing.DrawLine3D,
            p1,
            p2,
            r,
            g,
            b,
            a,
            thickness
        )
    end
end

function FALLEN_WORLD_RAIN_WIND_RIGHT()
    local rx = 1
    local rz = 0

    if aim and type(aim.get_camera_rotation) == "function" then
        pcall(function()
            local m = aim.get_camera_rotation()
            if type(m) == "table" then
                local x = tonumber(m[1])
                local z = tonumber(m[3])

                if x and z then
                    local mag = math.sqrt(x * x + z * z)
                    if mag > 0.0001 then
                        rx = x / mag
                        rz = z / mag
                    end
                end
            end
        end)
    end

    return rx, rz
end

function FALLEN_WORLD_RAIN_NEW_DROP(center, bottom_y, top_y, radius, fill_height, fade_start_y)
    if not center then
        return nil
    end

    local angle = FALLEN_WEATHER_RAND(0, math.pi * 2)
    local dist = math.sqrt(FALLEN_WEATHER_RAND(0, 1)) * radius

    -- Initial fill never starts inside the fade zone.
    local lowest_spawn_y =
        tonumber(fade_start_y)
        or (center.Y - 100)

    local y = fill_height
        and FALLEN_WEATHER_RAND(lowest_spawn_y + 4, top_y + 3.5)
        or FALLEN_WEATHER_RAND(top_y, top_y + 5.0)

    return {
        x = center.X + math.cos(angle) * dist,
        y = y,
        z = center.Z + math.sin(angle) * dist,
        bottom_y = bottom_y,
        fade_start_y = lowest_spawn_y,
        drift = FALLEN_WEATHER_RAND(-0.075, 0.075),
        drift_side = FALLEN_WEATHER_RAND(-1, 1),
        speed_mul = FALLEN_WEATHER_RAND(0.82, 1.22),
        len = FALLEN_WEATHER_RAND(1.75, 3.15),
        a = FALLEN_WEATHER_RAND(0.38, 0.72),
        wind_dx = 0,
        wind_dz = 0,
        fade = 1,
    }
end

function FALLEN_WORLD_RAIN_SPLASH(x, y, z, alpha_value)
    if S.world_rain_splash ~= true then
        return
    end

    if type(A.world_rain_splashes) ~= "table" then
        A.world_rain_splashes = {}
    end

    local amount = math.random(4, 7)

    for _ = 1, amount do
        if #A.world_rain_splashes >= 110 then
            break
        end

        local ang = FALLEN_WEATHER_RAND(0, math.pi * 2)
        local hspeed = FALLEN_WEATHER_RAND(4.0, 10.5)
        local life = FALLEN_WEATHER_RAND(0.18, 0.34)

        A.world_rain_splashes[#A.world_rain_splashes + 1] = {
            x = x + FALLEN_WEATHER_RAND(-0.10, 0.10),
            y = y + 0.08,
            z = z + FALLEN_WEATHER_RAND(-0.10, 0.10),
            vx = math.cos(ang) * hspeed,
            vy = FALLEN_WEATHER_RAND(4.0, 8.5),
            vz = math.sin(ang) * hspeed,
            life = life,
            max_life = life,
            a = FALLEN_WEATHER_RAND(0.45, 0.85) * (tonumber(alpha_value) or 1),
        }
    end
end

function FALLEN_WORLD_RAIN_DRAW_DROP(p, alpha_value)
    local head = Vector3(p.x, p.y, p.z)
    local tail = Vector3(
        p.x - (p.wind_dx or 0) * (p.len or 2),
        p.y + p.len,
        p.z - (p.wind_dz or 0) * (p.len or 2)
    )

    if not FALLEN_WORLD_RAIN_SEGMENT_VISIBLE(tail, head) then
        return
    end

    local a = clamp((p.a or 0.5) * (alpha_value or 1) * (p.fade or 1), 0, 1)

    FALLEN_WORLD_RAIN_LINE3D(tail, head, 0.34, 0.58, 0.94, a * 0.10, 4.4, true)
    FALLEN_WORLD_RAIN_LINE3D(tail, head, 0.50, 0.70, 0.98, a * 0.34, 2.0, true)
    FALLEN_WORLD_RAIN_LINE3D(tail, head, 0.82, 0.91, 1.00, a, 0.82, true)
end

function FALLEN_WORLD_RAIN_DRAW_SPLASH(p, life_a, alpha_value)
    local head = Vector3(p.x, p.y, p.z)
    local tail = Vector3(
        p.x - p.vx * 0.027,
        p.y - p.vy * 0.027,
        p.z - p.vz * 0.027
    )

    if not FALLEN_WORLD_RAIN_SEGMENT_VISIBLE(tail, head) then
        return
    end

    local a = clamp(
        (p.a or 0.6) * (life_a or 1) * (alpha_value or 1),
        0,
        1
    )

    FALLEN_WORLD_RAIN_LINE3D(tail, head, 0.44, 0.68, 1.00, a * 0.16, 3.8, true)
    FALLEN_WORLD_RAIN_LINE3D(tail, head, 0.74, 0.88, 1.00, a, 0.72, true)
end

function FALLEN_WORLD_RAIN_TICK()
    if type(A.world_rain_particles) ~= "table" then
        A.world_rain_particles = {}
    end

    -- Impacts are intentionally disabled in this version.
    A.world_rain_splashes = {}

    local now_t = tick()

    if A.world_rain_last_t == nil then
        A.world_rain_last_t = now_t
    end

    local dt = clamp(now_t - A.world_rain_last_t, 0, 0.05)
    A.world_rain_last_t = now_t

    local wanted = S.world_rain_enabled == true and 1 or 0

    A.world_rain_alpha = exp_chase(
        tonumber(A.world_rain_alpha) or 0,
        wanted,
        wanted > 0 and 10 or 13,
        dt
    )

    local center = FALLEN_WORLD_RAIN_CENTER()

    if not center then
        if A.world_rain_alpha < 0.01 then
            A.world_rain_particles = {}
        end
        return
    end

    local radius = clamp(tonumber(S.world_rain_radius) or 28, 8, 300)
    local speed_setting = clamp(tonumber(S.world_rain_speed) or 1, 0.03, 2.50)
    local target_amount = math.floor(clamp(tonumber(S.world_rain_amount) or 34, 12, 64) + 0.5)

    -- Geometry cache is used ONLY for wall occlusion now, never for ground hits.
    -- It builds once and never automatically rescans Workspace.
    if S.world_rain_enabled == true or S.world_thunder_enabled == true then
        local thunder_radius = clamp(tonumber(S.world_thunder_radius) or 90, 8, 300)
        FALLEN_WORLD_RAIN_UPDATE_GEOMETRY(
            center,
            math.max(radius, thunder_radius)
        )
    end

    local top_y = center.Y + clamp(38 + radius * 0.10, 38, 70)

    -- Rain stays fully visible all the way to 100 studs BELOW the player.
    -- Only after that point does it enter a short disappearance zone.
    local fade_start_y = center.Y - 100
    local bottom_y = center.Y - 118

    if S.world_rain_enabled == true then
        while #A.world_rain_particles < target_amount do
            A.world_rain_particles[#A.world_rain_particles + 1] =
                FALLEN_WORLD_RAIN_NEW_DROP(
                    center,
                    bottom_y,
                    top_y,
                    radius,
                    true,
                    fade_start_y
                )
        end
    end

    while #A.world_rain_particles > target_amount do
        table.remove(A.world_rain_particles)
    end

    local right_x, right_z = FALLEN_WORLD_RAIN_WIND_RIGHT()
    local wind_deg = clamp(tonumber(S.world_rain_wind_angle) or 0, -65, 65)
    local wind_ratio = math.tan(math.rad(wind_deg))

    for i = #A.world_rain_particles, 1, -1 do
        local p = A.world_rain_particles[i]

        if not p then
            table.remove(A.world_rain_particles, i)
        else
            local fall_speed = (1.6 + speed_setting * 39.5) * (p.speed_mul or 1)

            -- Wind is camera-relative: negative = visually left, positive = right.
            local side_noise = (p.drift or 0) * (p.drift_side or 1)
            p.wind_dx = right_x * wind_ratio + right_z * side_noise
            p.wind_dz = right_z * wind_ratio - right_x * side_noise

            p.x = p.x + (p.wind_dx or 0) * fall_speed * dt
            p.z = p.z + (p.wind_dz or 0) * fall_speed * dt
            p.y = p.y - fall_speed * dt

            -- Full opacity until 100 studs below the player's current level.
            -- Then fade only during the final ~18 studs before respawn.
            local drop_fade_start =
                tonumber(p.fade_start_y)
                or fade_start_y

            local drop_bottom =
                tonumber(p.bottom_y)
                or bottom_y

            if p.y >= drop_fade_start then
                p.fade = 1
            else
                p.fade = clamp(
                    (p.y - drop_bottom)
                    / math.max(1, drop_fade_start - drop_bottom),
                    0,
                    1
                )
            end

            if p.y <= (p.bottom_y or bottom_y) then
                if S.world_rain_enabled == true then
                    A.world_rain_particles[i] =
                        FALLEN_WORLD_RAIN_NEW_DROP(
                            center,
                            bottom_y,
                            top_y,
                            radius,
                            false,
                            fade_start_y
                        )
                else
                    table.remove(A.world_rain_particles, i)
                end
            elseif A.world_rain_alpha > 0.008 then
                FALLEN_WORLD_RAIN_DRAW_DROP(p, A.world_rain_alpha)
            end
        end
    end

    if S.world_rain_enabled ~= true
        and A.world_rain_alpha < 0.012
    then
        A.world_rain_particles = {}
    end
end


-- =========================================================
-- 3D World Thunderstorm
-- =========================================================
-- Visual-only thunder built on top of the World Rain projection/masking layer.
-- Strikes are generated as jagged world-space paths with short branches and a
-- cool-white screen flash.  Everything is clipped behind the open custom menu.
function FALLEN_WORLD_THUNDER_INTERVAL()
    local rate = clamp(
        tonumber(S.world_thunder_rate) or 1,
        0.15,
        4.00
    )

    return clamp(
        FALLEN_WEATHER_RAND(3.2, 7.0) / rate,
        0.45,
        32.0
    )
end

function FALLEN_WORLD_THUNDER_NEW_POINT(x, y, z)
    return Vector3(x, y, z)
end

function FALLEN_WORLD_THUNDER_SPAWN(center, radius)
    if not center then
        return
    end

    radius = clamp(
        tonumber(radius) or 90,
        8,
        300
    )

    local angle = FALLEN_WEATHER_RAND(0, math.pi * 2)
    local dist = math.sqrt(FALLEN_WEATHER_RAND(0, 1)) * radius * 0.92

    local hit_x = center.X + math.cos(angle) * dist
    local hit_z = center.Z + math.sin(angle) * dist
    local hit_y = center.Y - 3.1

    local top_h = clamp(
        tonumber(S.world_thunder_height) or 82,
        30,
        180
    )

    local top_x = hit_x + FALLEN_WEATHER_RAND(-18, 18)
    local top_z = hit_z + FALLEN_WEATHER_RAND(-18, 18)

    local segments = math.floor(clamp(10 + top_h * 0.07, 12, 22) + 0.5)
    local points = {}

    for i = 0, segments do
        local t = i / segments
        local inv = 1 - t
        local jitter = 1.2 + inv * 5.8

        local x = top_x + (hit_x - top_x) * t
        local z = top_z + (hit_z - top_z) * t
        local y = hit_y + top_h * inv

        if i > 0 and i < segments then
            x = x + FALLEN_WEATHER_RAND(-jitter, jitter)
            z = z + FALLEN_WEATHER_RAND(-jitter, jitter)
            y = y + FALLEN_WEATHER_RAND(-1.8, 1.8)
        end

        points[#points + 1] =
            FALLEN_WORLD_THUNDER_NEW_POINT(x, y, z)
    end

    local branches = {}
    local branch_count = math.floor(clamp(
        tonumber(S.world_thunder_branches) or 3,
        0,
        8
    ) + 0.5)

    for b = 1, branch_count do
        local start_index = math.random(3, math.max(3, segments - 3))
        local start = points[start_index]

        if start then
            local branch = { start }
            local branch_angle = FALLEN_WEATHER_RAND(0, math.pi * 2)
            local branch_len = math.random(3, 6)
            local step = FALLEN_WEATHER_RAND(3.2, 6.2)

            local bx = start.X
            local by = start.Y
            local bz = start.Z

            for j = 1, branch_len do
                bx = bx
                    + math.cos(branch_angle) * step
                    + FALLEN_WEATHER_RAND(-1.7, 1.7)

                bz = bz
                    + math.sin(branch_angle) * step
                    + FALLEN_WEATHER_RAND(-1.7, 1.7)

                by = by - FALLEN_WEATHER_RAND(1.2, 3.6)

                branch[#branch + 1] =
                    FALLEN_WORLD_THUNDER_NEW_POINT(bx, by, bz)
            end

            branches[#branches + 1] = branch
        end
    end

    A.world_thunder_points = points
    A.world_thunder_branches = branches

    local bolt_speed = clamp(
        tonumber(S.world_thunder_speed) or 1,
        0.25,
        3.00
    )

    local life = FALLEN_WEATHER_RAND(0.20, 0.42) / bolt_speed

    A.world_thunder_life = life
    A.world_thunder_max_life = life
    A.world_thunder_flash = 1
end

function FALLEN_WORLD_THUNDER_DRAW_PATH(points, alpha_value, branch_scale)
    if type(points) ~= "table" then
        return
    end

    local brightness = clamp(
        tonumber(S.world_thunder_brightness) or 1,
        0.20,
        2.00
    )

    local thickness = clamp(
        tonumber(S.world_thunder_thickness) or 1,
        0.50,
        3.00
    )

    local a = clamp((tonumber(alpha_value) or 0) * brightness, 0, 1)
    local scale = (tonumber(branch_scale) or 1) * thickness

    for i = 1, #points - 1 do
        local p1 = points[i]
        local p2 = points[i + 1]

        if FALLEN_WORLD_RAIN_SEGMENT_VISIBLE(p1, p2) then
            FALLEN_WORLD_RAIN_LINE3D(
                p1, p2,
                0.28, 0.48, 1.00,
                a * 0.08,
                9.0 * scale,
                true
            )

            FALLEN_WORLD_RAIN_LINE3D(
                p1, p2,
                0.48, 0.70, 1.00,
                a * 0.30,
                4.2 * scale,
                true
            )

            FALLEN_WORLD_RAIN_LINE3D(
                p1, p2,
                0.92, 0.97, 1.00,
                a,
                1.25 * scale,
                true
            )
        end
    end
end

function FALLEN_WORLD_THUNDER_FILL(x, y, w, h, r, g, b, a)
    if w <= 0 or h <= 0 then
        return
    end

    if type(DrawBoxFilled) == "function" then
        pcall(
            DrawBoxFilled,
            x, y, x + w, y + h,
            r, g, b, a
        )
    end
end

function FALLEN_WORLD_THUNDER_FLASH(alpha_value)
    local brightness = clamp(
        tonumber(S.world_thunder_brightness) or 1,
        0.20,
        2.00
    )

    local a = clamp((tonumber(alpha_value) or 0) * brightness, 0, 1)
    if a <= 0.002 then
        return
    end

    local sw, sh = screen_size()
    local c_a = 0.105 * a
    local rect = FALLEN_WEATHER_MENU_RECT

    if type(rect) ~= "table"
        or (tonumber(rect.open_alpha) or 0) <= 0.02
    then
        FALLEN_WORLD_THUNDER_FILL(
            0, 0, sw, sh,
            0.72, 0.82, 1.00,
            c_a
        )
        return
    end

    local x = clamp(tonumber(rect.x) or 0, 0, sw)
    local y = clamp(tonumber(rect.y) or 0, 0, sh)
    local w = clamp(tonumber(rect.w) or 0, 0, sw)
    local h = clamp(tonumber(rect.h) or 0, 0, sh)
    local x2 = clamp(x + w, 0, sw)
    local y2 = clamp(y + h, 0, sh)

    FALLEN_WORLD_THUNDER_FILL(0, 0, sw, y, 0.72, 0.82, 1.00, c_a)
    FALLEN_WORLD_THUNDER_FILL(0, y2, sw, sh - y2, 0.72, 0.82, 1.00, c_a)
    FALLEN_WORLD_THUNDER_FILL(0, y, x, math.max(0, y2 - y), 0.72, 0.82, 1.00, c_a)
    FALLEN_WORLD_THUNDER_FILL(x2, y, sw - x2, math.max(0, y2 - y), 0.72, 0.82, 1.00, c_a)
end

function FALLEN_WORLD_THUNDER_TICK()
    local now_t = tick()

    if A.world_thunder_last_t == nil then
        A.world_thunder_last_t = now_t
    end

    local dt = clamp(now_t - A.world_thunder_last_t, 0, 0.05)
    A.world_thunder_last_t = now_t

    local wanted = S.world_thunder_enabled == true and 1 or 0

    A.world_thunder_alpha = exp_chase(
        tonumber(A.world_thunder_alpha) or 0,
        wanted,
        wanted > 0 and 9 or 13,
        dt
    )

    local center = FALLEN_WORLD_RAIN_CENTER()
    if not center then
        return
    end

    local radius = clamp(
        tonumber(S.world_thunder_radius) or 90,
        8,
        300
    )

    if S.world_thunder_enabled == true then
        if A.world_thunder_timer == nil then
            A.world_thunder_timer = FALLEN_WEATHER_RAND(0.35, 1.20)
        end

        A.world_thunder_timer = A.world_thunder_timer - dt

        if A.world_thunder_timer <= 0 then
            FALLEN_WORLD_THUNDER_SPAWN(center, radius)
            A.world_thunder_timer = FALLEN_WORLD_THUNDER_INTERVAL()
        end
    elseif (A.world_thunder_alpha or 0) < 0.02 then
        A.world_thunder_timer = nil
    end

    local bolt_speed = clamp(
        tonumber(S.world_thunder_speed) or 1,
        0.25,
        3.00
    )

    if (A.world_thunder_flash or 0) > 0 then
        A.world_thunder_flash = math.max(
            0,
            (A.world_thunder_flash or 0)
                - dt * (3.0 + bolt_speed * 3.0)
        )

        FALLEN_WORLD_THUNDER_FLASH(
            (A.world_thunder_flash or 0)
                * (A.world_thunder_alpha or 0)
        )
    end

    if (A.world_thunder_life or 0) > 0
        and type(A.world_thunder_points) == "table"
    then
        A.world_thunder_life = math.max(
            0,
            (A.world_thunder_life or 0) - dt
        )

        local life_t = clamp(
            (A.world_thunder_life or 0)
                / math.max(0.001, tonumber(A.world_thunder_max_life) or 1),
            0,
            1
        )

        local a = smooth01(life_t) * (A.world_thunder_alpha or 0)

        FALLEN_WORLD_THUNDER_DRAW_PATH(
            A.world_thunder_points,
            a,
            1
        )

        if type(A.world_thunder_branches) == "table" then
            for _, branch in ipairs(A.world_thunder_branches) do
                FALLEN_WORLD_THUNDER_DRAW_PATH(
                    branch,
                    a * 0.72,
                    0.72
                )
            end
        end
    end

    if S.world_thunder_enabled ~= true
        and (A.world_thunder_alpha or 0) < 0.012
        and (A.world_thunder_life or 0) <= 0
    then
        A.world_thunder_points = nil
        A.world_thunder_branches = {}
        A.world_thunder_flash = 0
    end
end

-- World Weather removed.
S.world_rain_enabled = false
S.world_thunder_enabled = false

-- =========================================================
-- Custom Anti Aim runtime
-- Spin/Jitter behavior from the supplied reference, implemented only with
-- the documented custom rbx instance API.
-- Backwards faces exactly 180 degrees opposite the camera. No pitch is sent
-- and the HumanoidRootPart stays physically upright in this Anti Aim mode.
-- =========================================================

local function FALLEN_ANTIAIM_ATAN2(y, x)
    y = tonumber(y) or 0
    x = tonumber(x) or 0

    if math.atan2 then
        return math.atan2(y, x)
    end

    if x > 0 then
        return math.atan(y / x)
    elseif x < 0 and y >= 0 then
        return math.atan(y / x) + math.pi
    elseif x < 0 and y < 0 then
        return math.atan(y / x) - math.pi
    elseif x == 0 and y > 0 then
        return math.pi * 0.5
    elseif x == 0 and y < 0 then
        return -math.pi * 0.5
    end

    return 0
end

local function FALLEN_ANTIAIM_YAW_FROM_MATRIX(m)
    if type(m) ~= "table" then
        return 0
    end

    local x =
        tonumber(m[1])
        or 1

    local y =
        tonumber(m[7])
        or 0

    return
        math.deg(
            FALLEN_ANTIAIM_ATAN2(
                y,
                x
            )
        )
end

local function FALLEN_ANTIAIM_YAW_MATRIX(deg)
    local r =
        math.rad(
            tonumber(deg)
            or 0
        )

    local c = math.cos(r)
    local s = math.sin(r)

    return {
        c, 0, -s,
        0, 1, 0,
        s, 0, c,
    }
end

local function FALLEN_ANTIAIM_CAMERA_YAW()
    if not rbx
        or type(rbx.camera) ~= "function"
    then
        return nil
    end

    local cam = nil

    local ok_cam, out =
        pcall(
            rbx.camera
        )

    if ok_cam then
        cam = out
    end

    if not cam then
        return nil
    end

    local rot = nil

    pcall(function()
        rot =
            cam:camera_rotation()
    end)

    if type(rot) ~= "table" then
        return nil
    end

    return
        FALLEN_ANTIAIM_YAW_FROM_MATRIX(
            rot
        )
end

function FALLEN_ANTIAIM_TICK()
    if _G.FallenMenuReady ~= true then
        return
    end

    local enabled =
        S.misc_antiaim_enabled == true

    -- Manipulation owns the root while Mouse1 is held so its 90-degree spoof
    -- is not immediately flattened by Spin/Jitter/Backwards.
    if S.misc_manipulation_enabled == true
        and (
            A.misc_manipulation_press_active == true
            or A.misc_manipulation_spoofed == true
        )
    then
        return
    end

    local hrp = nil

    if rbx
        and type(rbx.local_hrp) == "function"
    then
        local ok, out =
            pcall(
                rbx.local_hrp
            )

        if ok then
            hrp = out
        end
    end

    if not hrp then
        A.misc_antiaim_was_enabled = false
        A.misc_antiaim_saved_rotation = nil
        A.misc_antiaim_hrp_addr = nil
        return
    end

    local hrp_addr = nil
    pcall(function()
        hrp_addr = hrp.addr
    end)

    if A.misc_antiaim_hrp_addr ~= nil
        and hrp_addr ~= nil
        and A.misc_antiaim_hrp_addr ~= hrp_addr
    then
        A.misc_antiaim_was_enabled = false
        A.misc_antiaim_saved_rotation = nil
        A.misc_antiaim_last_update = -100
    end

    A.misc_antiaim_hrp_addr = hrp_addr

    if not enabled then
        if A.misc_antiaim_was_enabled
            and type(A.misc_antiaim_saved_rotation) == "table"
        then
            pcall(function()
                hrp:set_rotation(
                    A.misc_antiaim_saved_rotation
                )
            end)
        end

        A.misc_antiaim_was_enabled = false
        A.misc_antiaim_saved_rotation = nil
        A.misc_antiaim_hrp_addr = nil
        A.misc_antiaim_last_update = -100
        return
    end

    if not A.misc_antiaim_was_enabled then
        local current = nil

        pcall(function()
            current =
                hrp:get_rotation()
        end)

        if type(current) == "table" then
            A.misc_antiaim_saved_rotation = current

            local yaw =
                FALLEN_ANTIAIM_YAW_FROM_MATRIX(
                    current
                )

            A.misc_antiaim_spin_yaw = yaw
            A.misc_antiaim_target_yaw = yaw
        else
            A.misc_antiaim_saved_rotation = nil
            A.misc_antiaim_spin_yaw = 0
            A.misc_antiaim_target_yaw = 0
        end

        A.misc_antiaim_last_update = -100
        A.misc_antiaim_was_enabled = true
    end

    local mode =
        tostring(
            S.misc_antiaim_mode
            or "Spin"
        )

    -- Static backwards pose: 180 degrees opposite the current camera yaw.
    if mode == "Backwards" then
        local camera_yaw =
            FALLEN_ANTIAIM_CAMERA_YAW()

        local base_yaw =
            camera_yaw

        if base_yaw == nil then
            base_yaw =
                FALLEN_ANTIAIM_YAW_FROM_MATRIX(
                    A.misc_antiaim_saved_rotation
                )
        end

        local backwards_yaw =
            (tonumber(base_yaw) or 0)
            + 180

        if backwards_yaw > 180 then
            backwards_yaw =
                backwards_yaw - 360
        end

        pcall(function()
            hrp:set_rotation(
                FALLEN_ANTIAIM_YAW_MATRIX(
                    backwards_yaw
                )
            )
        end)

        return
    end

    local speed =
        clamp(
            tonumber(S.misc_antiaim_speed)
            or 100,
            0,
            100
        )

    -- Same timing model as the supplied script:
    -- 0 = update once per second, 100 = update every render frame.
    local interval =
        1 - (speed / 100)

    local now = tick()

    if interval <= 0
        or now - (A.misc_antiaim_last_update or -100) >= interval
    then
        if mode == "Jitter" then
            local yaw_min =
                clamp(
                    tonumber(S.misc_antiaim_yaw_min)
                    or -90,
                    -180,
                    180
                )

            local yaw_max =
                clamp(
                    tonumber(S.misc_antiaim_yaw_max)
                    or 90,
                    -180,
                    180
                )

            if math.random(1, 2) == 1 then
                A.misc_antiaim_target_yaw = yaw_min
            else
                A.misc_antiaim_target_yaw = yaw_max
            end
        else
            A.misc_antiaim_spin_yaw =
                (tonumber(A.misc_antiaim_spin_yaw) or 0)
                + 1

            if A.misc_antiaim_spin_yaw > 180 then
                A.misc_antiaim_spin_yaw =
                    A.misc_antiaim_spin_yaw - 360
            end

            A.misc_antiaim_target_yaw =
                A.misc_antiaim_spin_yaw
        end

        A.misc_antiaim_last_update = now
    end

    -- Pin the selected yaw every frame so Roblox character auto-rotation does
    -- not immediately overwrite the anti-aim between timed updates.
    pcall(function()
        hrp:set_rotation(
            FALLEN_ANTIAIM_YAW_MATRIX(
                A.misc_antiaim_target_yaw
            )
        )
    end)
end

hooks.on_render(function()
    local ok, err =
        pcall(
            FALLEN_ANTIAIM_TICK
        )

    if not ok then
        A.misc_antiaim_last_error =
            A.misc_antiaim_last_error
            or 0

        if tick() - A.misc_antiaim_last_error > 2 then
            A.misc_antiaim_last_error = tick()

            if type(warn) == "function" then
                warn(
                    SYS
                    .. "Anti Aim: "
                    .. tostring(err)
                )
            end
        end
    end
end)

-- =========================================================
-- Custom Manipulation runtime
-- The spoof origin is frozen at the exact HRP/head position from the frame
-- Mouse1 was FIRST pressed. Every following render returns the root to that
-- base state before applying one temporary spoof, so the offset can never
-- accumulate upward/sideways frame after frame.
--
-- Direction is intentionally limited to three high-angle offsets:
-- UP, UP-RIGHT and UP-LEFT. There is NO DIRECT/original-position visibility
-- bypass: while armed Mouse1 Manipulation chooses only among these three spoof
-- positions. If none can hit the target, it stays BLOCKED and does not move.
-- The local camera position stays anchored to the press-start camera position.
-- =========================================================

local FALLEN_MANIPULATION_FLIP_DEG = 90.0

local function FALLEN_MANIPULATION_MATRIX_MUL(a, b)
    if type(a) ~= "table" or type(b) ~= "table" then
        return nil
    end

    return {
        (a[1] or 0)*(b[1] or 0) + (a[2] or 0)*(b[4] or 0) + (a[3] or 0)*(b[7] or 0),
        (a[1] or 0)*(b[2] or 0) + (a[2] or 0)*(b[5] or 0) + (a[3] or 0)*(b[8] or 0),
        (a[1] or 0)*(b[3] or 0) + (a[2] or 0)*(b[6] or 0) + (a[3] or 0)*(b[9] or 0),
        (a[4] or 0)*(b[1] or 0) + (a[5] or 0)*(b[4] or 0) + (a[6] or 0)*(b[7] or 0),
        (a[4] or 0)*(b[2] or 0) + (a[5] or 0)*(b[5] or 0) + (a[6] or 0)*(b[8] or 0),
        (a[4] or 0)*(b[3] or 0) + (a[5] or 0)*(b[6] or 0) + (a[6] or 0)*(b[9] or 0),
        (a[7] or 0)*(b[1] or 0) + (a[8] or 0)*(b[4] or 0) + (a[9] or 0)*(b[7] or 0),
        (a[7] or 0)*(b[2] or 0) + (a[8] or 0)*(b[5] or 0) + (a[9] or 0)*(b[8] or 0),
        (a[7] or 0)*(b[3] or 0) + (a[8] or 0)*(b[6] or 0) + (a[9] or 0)*(b[9] or 0),
    }
end

local function FALLEN_MANIPULATION_PITCH_MATRIX(deg)
    local r = math.rad(tonumber(deg) or 0)
    local c = math.cos(r)
    local s = math.sin(r)

    return {
        1, 0, 0,
        0, c, -s,
        0, s, c,
    }
end

local function FALLEN_MANIPULATION_UPRIGHT_MATRIX(m)
    if type(m) ~= "table" then
        return {
            1, 0, 0,
            0, 1, 0,
            0, 0, 1,
        }
    end

    -- Keep only yaw from the saved root rotation. Pitch/roll are discarded so
    -- releasing Mouse1 always puts the character physically upright again.
    local x = tonumber(m[1]) or 1
    local z = tonumber(m[7]) or 0
    local yaw = FALLEN_ANTIAIM_ATAN2(z, x)
    local c = math.cos(yaw)
    local s = math.sin(yaw)

    return {
        c, 0, -s,
        0, 1, 0,
        s, 0, c,
    }
end

