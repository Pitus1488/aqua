function FALLEN_DMGNUM_TARGET_HEAD_SCREEN(
    head_pos,
    fallback_pos
)
    local world =
        head_pos
        or fallback_pos

    -- Backwards-compatible Aimbot fallback.
    if not world
        and FAP.current_target_pos
    then
        world =
            FAP.current_target_pos
    end

    if not world
        or world.X == nil
        or world.Y == nil
        or world.Z == nil
    then
        return nil
    end

    local screen =
        FALLEN_BT_PROJECT({
            X = world.X,
            Y = world.Y,
            Z = world.Z,
        })

    if not screen then
        return nil
    end

    return {
        X = screen.X,
        Y = screen.Y,
    }
end


function FALLEN_DMGNUM_ADD(
    damage,
    head_pos,
    fallback_pos
)
    damage =
        tonumber(damage)

    if not damage
        or damage <= 0
    then
        return
    end

    local screen =
        FALLEN_DMGNUM_TARGET_HEAD_SCREEN(
            head_pos,
            fallback_pos
        )

    if not screen then
        return
    end

    -- Freeze the SCREEN coordinate at the exact hit moment.
    -- No target address/world position is retained, so this number cannot
    -- follow the opponent after spawning.
    FALLEN_DMGNUM.items[#FALLEN_DMGNUM.items + 1] = {
        x = screen.X,
        y = screen.Y - 7,
        damage =
            math.max(
                1,
                math.floor(
                    damage + 0.5
                )
            ),
        created = tick(),
    }

    while #FALLEN_DMGNUM.items > 32 do
        table.remove(
            FALLEN_DMGNUM.items,
            1
        )
    end
end


