function FALLEN_DRAW_ROUNDED_GLOW_FRAME(
    x,
    y,
    w,
    h,
    radius,
    color,
    thickness
)
    -- Do not construct the glow from lines/arcs.
    -- A line-based perimeter can rasterize different joins on different
    -- sides and leave single-pixel holes.
    --
    -- Instead every glow level is one COMPLETE rounded surface.
    -- The caller expands every level equally:
    --   x - i, y - i, w + i*2, h + i*2, radius + i
    -- so spacing is exactly symmetric on left/right/top/bottom and corners.
    --
    -- The actual menu/panel is drawn afterwards, covering the interior.
    -- Therefore only the outside part of these complete surfaces is visible.
    rounded_fill(
        x,
        y,
        w,
        h,
        radius,
        color
    )
end


function FALLEN_DRAW_FOV_STYLE_ROUNDED_GLOW(
    x,
    y,
    w,
    h,
    radius,
    color,
    strength,
    spread
)
    color =
        color
        or { 0, 0, 0, 1 }

    strength =
        clamp(
            tonumber(strength) or 1,
            0,
            2
        )

    spread =
        clamp(
            tonumber(spread) or 6,
            1,
            12
        )

    if strength <= 0.001
        or (color[4] or 0) <= 0.001
    then
        return
    end

    -- Exact Aimbot FOV glow sampling.
    local total_spread =
        spread * 3.0

    local layers =
        28

    -- Full rounded surfaces overlap. Convert the FOV target opacity at each
    -- distance into the incremental alpha needed for this surface so the
    -- FINAL visible falloff equals the FOV curve instead of over-darkening.
    --
    -- target_i = 0.20 * colorAlpha * strength * (1 - t)^2
    -- target_i = 1 - (1 - layerAlpha_i) * (1 - target_{i+1})
    local next_target =
        0

    for layer = layers - 1, 0, -1 do
        local t =
            layer / (layers - 1)

        local falloff =
            1 - t

        local offset =
            t * total_spread

        local target_alpha =
            clamp(
                (color[4] or 1)
                * strength
                * falloff
                * falloff
                * 0.20,
                0,
                0.95
            )

        local layer_alpha =
            0

        if target_alpha > next_target then
            layer_alpha =
                1
                - (
                    (1 - target_alpha)
                    / math.max(
                        0.0001,
                        1 - next_target
                    )
                )
        end

        layer_alpha =
            clamp(
                layer_alpha,
                0,
                0.95
            )

        if layer_alpha > 0.0001 then
            rounded_fill(
                x - offset,
                y - offset,
                w + offset * 2,
                h + offset * 2,
                radius + offset,
                {
                    color[1],
                    color[2],
                    color[3],
                    layer_alpha
                }
            )
        end

        next_target =
            target_alpha
    end
end


function FALLEN_GEAR_HOVER_STEP(hot)
    local now = tick()

    if A.gear_hover_last_t == nil then
        A.gear_hover_last_t = now
    end

    local dt =
        clamp(
            now - A.gear_hover_last_t,
            0,
            0.05
        )

    A.gear_hover_last_t = now

    local p =
        clamp(
            tonumber(A.gear_hover_anim) or 0,
            0,
            1
        )

    if hot then
        -- Full white / full scale after roughly one second.
        p =
            math.min(
                1,
                p + dt / 1.0
            )
    else
        -- Return a little faster so the control stays responsive.
        p =
            math.max(
                0,
                p - dt / 0.35
            )
    end

    A.gear_hover_anim = p
    return smooth01(p)
end

function FALLEN_DRAW_GEAR(cx, cy, hot, hover_anim)
    local p =
        clamp(
            tonumber(hover_anim) or 0,
            0,
            1
        )

    local scale =
        1
        + 0.14 * p

    local base =
        C.text_dim

    local col = {
        lerp(base[1] or 0.5, 1.0, p),
        lerp(base[2] or 0.5, 1.0, p),
        lerp(base[3] or 0.5, 1.0, p),
        1.0,
    }

    local hole_base =
        C.sidebar

    local hole_col = {
        lerp(hole_base[1] or 0.08, 0.10, p),
        lerp(hole_base[2] or 0.08, 0.105, p),
        lerp(hole_base[3] or 0.09, 0.125, p),
        1.0,
    }

    -- Outer gear body.
    circle_fill(
        cx,
        cy,
        4.9 * scale,
        col
    )

    -- Eight smooth teeth around the body.
    for i = 0, 7 do
        local a =
            (i / 8)
            * math.pi
            * 2

        circle_fill(
            cx
                + math.cos(a)
                * 6.1
                * scale,
            cy
                + math.sin(a)
                * 6.1
                * scale,
            2.15 * scale,
            col
        )
    end

    -- Clean center hole.
    circle_fill(
        cx,
        cy,
        2.35 * scale,
        hole_col
    )

    circle(
        cx,
        cy,
        2.85 * scale,
        alpha(col, 0.22),
        1
    )
end

