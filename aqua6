    _G.FALLEN_IMAGE_PRELOAD_TOTAL =
        #_G.FALLEN_IMAGE_PRELOAD_SPECIALS
        + #_G.FALLEN_IMAGE_PRELOAD_QUEUE

    _G.FALLEN_IMAGE_PRELOAD_STATE = {
        stage = "special",
        special_index = 1,
        special_started = 0,
        special_next_try = 0,
        url_index = 1,
        next_url_start = 0,
        inflight = {},
        max_inflight = 12,
        start_interval = 0.0,
        image_timeout = 5.0,
        special_timeout = 2.2,
        last_tick = tick(),
