_G.FALLEN_LOADER_HEADER_LOGO_IMAGE_URL =
    _G.FALLEN_LOADER_HEADER_LOGO_PAGE_URL

function FALLEN_LOADER_RESOLVE_IMAGE_URL(url)
    if type(url) ~= "string"
        or url == ""
    then
        return nil
    end

    if not Http
        or type(Http.get) ~= "function"
    then
        return url
    end

    local resolved = url

    pcall(function()
        local http_ok, status, body =
            Http.get(
                url,
                { timeout_ms = 2200 }
            )

        if not http_ok
            or status ~= 200
            or type(body) ~= "string"
            or body == ""
        then
            return
        end

        local direct =
            body:match(
                '<meta[^>]-property%s*=%s*["\']og:image["\'][^>]-content%s*=%s*["\']([^"\']+)'
            )
            or body:match(
                '<meta[^>]-content%s*=%s*["\']([^"\']+)["\'][^>]-property%s*=%s*["\']og:image["\']'
            )
            or body:match(
                '<meta[^>]-name%s*=%s*["\']twitter:image["\'][^>]-content%s*=%s*["\']([^"\']+)'
            )
            or body:match(
                '<meta[^>]-content%s*=%s*["\']([^"\']+)["\'][^>]-name%s*=%s*["\']twitter:image["\']'
            )

        if type(direct) == "string"
            and direct ~= ""
        then
            direct =
                direct:gsub("&amp;", "&")

            if direct:sub(1, 2) == "//" then
                direct =
                    "https:"
                    .. direct
            elseif direct:sub(1, 1) == "/" then
                direct =
                    "https://fotovssylku.ru"
                    .. direct
            end

            resolved = direct
        end
    end)

    return resolved
end

-- =========================================================
-- Startup image preloader (sequential / low-stutter)
-- Every image is requested during Lua startup, but NOT all at once.
-- One logical image is started, we wait for ready/fail (or a timeout),
-- then move to the next one. This prevents a huge LoadImage burst.
-- =========================================================

_G.FALLEN_IMAGE_PRELOAD_HANDLES =
    _G.FALLEN_IMAGE_PRELOAD_HANDLES
    or {}

_G.FALLEN_IMAGE_PRELOAD_QUEUE = {}
_G.FALLEN_IMAGE_PRELOAD_QUEUED = {}
_G.FALLEN_IMAGE_PRELOAD_STARTED = false
_G.FALLEN_IMAGE_PRELOAD_DONE = false
_G.FALLEN_IMAGE_PRELOAD_INDEX = 0
_G.FALLEN_IMAGE_PRELOAD_TOTAL = 0
_G.FALLEN_IMAGE_PRELOAD_SPECIAL_TOTAL = 0

function FALLEN_PRELOAD_QUEUE_URL(url)
    if type(url) ~= "string"
        or url == ""
    then
        return
    end

    if _G.FALLEN_IMAGE_PRELOAD_QUEUED[url] then
        return
    end

    _G.FALLEN_IMAGE_PRELOAD_QUEUED[url] = true

    table.insert(
        _G.FALLEN_IMAGE_PRELOAD_QUEUE,
        url
    )
end

-- URL tables in this script usually store fallback URLs as an array.
-- Only queue the FIRST URL from each fallback array. If it later fails,
-- the normal runtime resolver can still advance to the next fallback.
function FALLEN_PRELOAD_QUEUE_PRIMARY(value, seen)
    if type(value) == "string" then
        FALLEN_PRELOAD_QUEUE_URL(value)
        return
    end

    if type(value) ~= "table" then
        return
    end

    seen = seen or {}

    if seen[value] then
        return
    end

    seen[value] = true

    local n =
        #value

    if n > 0 then
        for i = 1, n do
            if type(value[i]) == "string"
                and value[i] ~= ""
            then
                FALLEN_PRELOAD_QUEUE_URL(
                    value[i]
                )
                return
            end
        end
    end

    for _, child in pairs(value) do
        if type(child) == "string" then
            FALLEN_PRELOAD_QUEUE_URL(child)
        elseif type(child) == "table" then
            FALLEN_PRELOAD_QUEUE_PRIMARY(
                child,
                seen
            )
        end
    end
end

function FALLEN_BUILD_IMAGE_PRELOAD_QUEUE()
    _G.FALLEN_IMAGE_PRELOAD_QUEUE = {}
    _G.FALLEN_IMAGE_PRELOAD_QUEUED = {}

    FALLEN_PRELOAD_QUEUE_PRIMARY(
        FALLEN_GRENADE_ICON_URLS
    )

    FALLEN_PRELOAD_QUEUE_PRIMARY(
        FALLEN_ARMOR_ICON_URLS
    )

    FALLEN_PRELOAD_QUEUE_PRIMARY(
        FALLEN_WEAPON_ICON_URLS
    )

    FALLEN_PRELOAD_QUEUE_PRIMARY(
        FALLEN_WEAPON_DIRECT_ICON_URLS
    )

    FALLEN_PRELOAD_QUEUE_PRIMARY(
        FALLEN_KEYCARD_ICON_URLS
    )

    if type(WORLD_UI_ITEMS) == "table" then
        for _, cfg in ipairs(WORLD_UI_ITEMS) do
            if cfg
                and type(cfg.direct_urls) == "table"
            then
                FALLEN_PRELOAD_QUEUE_PRIMARY(
                    cfg.direct_urls
                )
            end
        end
    end
end

function FALLEN_PRELOAD_FINISH_ONE()
