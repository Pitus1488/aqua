function FALLEN_HOTKEYS_ITEM_STEP(
    id,
    target
)
    id =
        tostring(
            id or "item"
        )

    local now =
        tick()

    if type(A.keybinds_item_last_t) ~= "table" then
        A.keybinds_item_last_t =
            {}
    end

    local last =
        tonumber(
            A.keybinds_item_last_t[id]
        )

    if not last then
        last =
            now
    end

    local dt =
        clamp(
            now - last,
            0,
            0.05
        )

    -- IMPORTANT: one timestamp per hotkey row.
    -- Aimbot can no longer consume Silent's dt in the same render frame.
    A.keybinds_item_last_t[id] =
        now

    local current =
        tonumber(
            A.keybinds_item_anim[id]
        )
        or 0

    current =
        exp_chase(
            current,
            target and 1 or 0,
            target and 17 or 12,
            dt
        )

    A.keybinds_item_anim[id] =
        current

    return
        clamp(
            current,
            0,
            1
        )
end


function FALLEN_DRAW_HOTKEYS_SWITCH(
    x,
    y,
    w,
    h,
    t,
    rounding
)
    t =
        clamp(
            tonumber(t) or 0,
            0,
            1
        )

    local track =
        mix_color(
            { 0.080, 0.084, 0.095, 0.95 },
            { 0.180, 0.185, 0.205, 0.98 },
            t
        )

    local knob =
        mix_color(
            { 0.52, 0.54, 0.60, 1.00 },
            { 0.96, 0.96, 0.99, 1.00 },
            t
        )

    local track_rounding =
        clamp(
            tonumber(rounding)
            or 8,
            0,
            h * 0.5
        )

    FALLEN_HOTKEYS_ROUNDED_FILL(
        x,
        y,
        w,
        h,
        track_rounding,
        track
    )

    local pad =
        1.5

    local knob_d =
        h - pad * 2

    local knob_x =
        lerp(
            x + pad,
            x + w - pad - knob_d,
            t
        )

    circle_fill(
        knob_x + knob_d * 0.5,
        y + h * 0.5,
        knob_d * 0.5,
        knob
    )
end


