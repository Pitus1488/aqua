function FALLEN_HOTKEYS_ROUNDED_FILL(
    x,
    y,
    w,
    h,
    radius,
    color
)
    -- Pixel-lock the whole shape first.
    x =
        math.floor(
            tonumber(x) or 0
            + 0.5
        )

    y =
        math.floor(
            tonumber(y) or 0
            + 0.5
        )

    w =
        math.max(
            1,
            math.floor(
                tonumber(w) or 1
                + 0.5
            )
        )

    h =
        math.max(
            1,
            math.floor(
                tonumber(h) or 1
                + 0.5
            )
        )

    radius =
        math.floor(
            clamp(
                tonumber(radius) or 0,
                0,
                math.min(w, h) * 0.5
            )
            + 0.5
        )

    if radius <= 0 then
        fill(
            x,
            y,
            w,
            h,
            color
        )

        return
    end

    local x2 =
        x + w

    local y2 =
        y + h

    local rr =
        radius * radius

    -- Top and bottom corner rows are each ONE continuous horizontal strip.
    -- That guarantees perfect left/right symmetry at this small 120x35 size.
    for yy = 0, radius - 1 do
        local dy =
            radius
            - yy
            - 0.5

        local dx =
            math.floor(
                math.sqrt(
                    math.max(
                        0,
                        rr - dy * dy
                    )
                )
                + 0.5
            )

        local left =
            x
            + radius
            - dx

        local right =
            x2
            - radius
            + dx

        local strip_w =
            math.max(
                0,
                right - left
            )

        if strip_w > 0 then
            fill(
                left,
                y + yy,
                strip_w,
                1,
                color
            )

            fill(
                left,
                y2 - yy - 1,
                strip_w,
                1,
                color
            )
        end
    end

    local middle_h =
        h
        - radius * 2

    if middle_h > 0 then
        fill(
            x,
            y + radius,
            w,
            middle_h,
            color
        )
    end
end


function FALLEN_DRAW_HOTKEYS_FOV_GLOW(
    x,
    y,
    w,
    h,
    radius
)
    -- Final tuned values:
    -- Strength 158, Spread 5, Alpha 100.
    local strength =
        1.58

    local spread =
        5

    local total_spread =
        spread * 3.0

    local layers =
        28

    local next_target =
        0

    for layer = layers - 1, 0, -1 do
        local t =
            layer / (layers - 1)

        local falloff =
            1 - t

        local offset =
            t * total_spread

        local target_alpha =
            clamp(
                1.0
                * strength
                * falloff
                * falloff
                * 0.20,
                0,
                0.95
            )

        local layer_alpha =
            0

        if target_alpha > next_target then
            layer_alpha =
                1
                - (
                    (1 - target_alpha)
                    / math.max(
                        0.0001,
                        1 - next_target
                    )
                )
        end

        layer_alpha =
            clamp(
                layer_alpha,
                0,
                0.95
            )

        if layer_alpha > 0.0001 then
            FALLEN_HOTKEYS_ROUNDED_FILL(
                x - offset,
                y - offset,
                w + offset * 2,
                h + offset * 2,
                radius + offset,
                {
                    0,
                    0,
                    0,
                    layer_alpha
                }
            )
        end

        next_target =
            target_alpha
    end
end


function FALLEN_HOTKEYS_ITEM_ROWS()
    local rows = {}

    if S.aim_enabled == true then
        rows[#rows + 1] = {
            id = "aimbot",
            label = "Aimbot",
            icon = "aimbot",
            active =
                (
                    tonumber(S.aim_hold_key)
                    or 0
                ) > 0
                and fap_hold_down() == true
                or false,
        }
    end

    if S.silent_enabled == true then
        local silent_vk =
            math.floor(
                tonumber(S.silent_key)
                or 0
            )

        rows[#rows + 1] = {
            id = "silent",
            label = "Silent",
            icon = "silent",
            active =
                silent_vk > 0
                and key_down(
                    silent_vk
                ) == true
                or false,
        }
    end

    return rows
end


function FALLEN_HOTKEYS_ITEM_STEP(
    id,
    target
)
    id =
        tostring(
            id or "item"
        )

    local now =
        tick()

    if type(A.keybinds_item_last_t) ~= "table" then
        A.keybinds_item_last_t =
            {}
    end

    local last =
        tonumber(
            A.keybinds_item_last_t[id]
        )

    if not last then
        last =
            now
    end

    local dt =
        clamp(
            now - last,
            0,
            0.05
        )

    -- IMPORTANT: one timestamp per hotkey row.
    -- Aimbot can no longer consume Silent's dt in the same render frame.
    A.keybinds_item_last_t[id] =
        now

    local current =
        tonumber(
            A.keybinds_item_anim[id]
        )
        or 0

    current =
        exp_chase(
            current,
            target and 1 or 0,
            target and 17 or 12,
            dt
        )

    A.keybinds_item_anim[id] =
        current

    return
        clamp(
            current,
            0,
            1
        )
end


function FALLEN_DRAW_HOTKEYS_SWITCH(
    x,
    y,
    w,
    h,
    t,
    rounding
)
    t =
        clamp(
            tonumber(t) or 0,
            0,
            1
        )

    local track =
        mix_color(
            { 0.080, 0.084, 0.095, 0.95 },
            { 0.180, 0.185, 0.205, 0.98 },
            t
        )

    local knob =
        mix_color(
            { 0.52, 0.54, 0.60, 1.00 },
            { 0.96, 0.96, 0.99, 1.00 },
            t
        )

    local track_rounding =
        clamp(
            tonumber(rounding)
            or 8,
            0,
            h * 0.5
        )

    FALLEN_HOTKEYS_ROUNDED_FILL(
        x, y, w, h, track_rounding,
        { 0.16, 0.19, 0.27, 0.94 }
    )
    FALLEN_HOTKEYS_ROUNDED_FILL(
        x + 1, y + 1, w - 2, h - 2,
        math.max(0, track_rounding - 1), track
    )

    local pad =
        1.5

    local knob_d =
        h - pad * 2

    local knob_x =
        lerp(
            x + pad,
            x + w - pad - knob_d,
            t
        )

    circle_fill(
        knob_x + knob_d * 0.5,
        y + h * 0.5,
        knob_d * 0.5,
        knob
    )
end


