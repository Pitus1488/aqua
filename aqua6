function FALLEN_FOV_BOOL_FIELD_IS_CANDIDATE(
    section,
    raw_key
)
    local raw =
        tostring(
            raw_key
            or ""
        )

    local kn =
        FALLEN_SILENT_NORMALIZE_KEY(
            raw
        )

    if string.find(
        kn,
        "fov",
        1,
        true
    ) == nil
    then
        return false
    end

    -- Do not touch presentation/detail booleans that are not the master FOV switch.
    local reject_words = {
        "color",
        "glow",
        "filled",
        "fill",
        "rainbow",
        "gradient",
        "style",
        "alpha",
    }

    for _, word in ipairs(reject_words) do
        if string.find(
            kn,
            word,
            1,
            true
        ) ~= nil
        then
            return false
        end
    end

    local field_type = nil

    if section
        and type(section._type) == "function"
    then
        local ok_type, t =
            pcall(function()
                return section:_type(
                    raw
                )
            end)

        if ok_type then
            field_type =
                tostring(
                    t
                    or ""
                ):lower()
        end
    end

    if field_type ~= nil
        and field_type ~= ""
        and field_type ~= "bool"
    then
        return false
    end

    -- If _type is unavailable, verify the live value is actually boolean.
    if field_type == nil
        or field_type == ""
    then
        local ok_value, current =
            pcall(function()
                return section[raw]
            end)

        if ok_value
            and current ~= nil
            and type(current) ~= "boolean"
        then
            return false
        end
    end

    local toggle_words = {
        "show",
        "enable",
        "enabled",
        "use",
        "check",
        "draw",
        "visible",
        "limit",
        "only",
        "active",
    }

    for _, word in ipairs(toggle_words) do
        if string.find(
            kn,
            word,
            1,
            true
        ) ~= nil
        then
            return true
        end
    end

    -- Some builds may simply expose a boolean named "aimbot_fov".
    return
        kn == "aimbotfov"
        or kn == "silentfov"
        or kn == "fov"
end


function FALLEN_FOV_WRITE_ALL_BOOL_FIELDS(
    section,
    value,
    section_name
)
    if not section then
        return {}
    end

    local changed = {}

    local keys = nil

    if type(section._keys) == "function" then
        local ok_keys, out =
            pcall(function()
                return section:_keys()
            end)

        if ok_keys
            and type(out) == "table"
        then
            keys = out
        end
    end

    if type(keys) == "table" then
        for _, raw_key in ipairs(keys) do
            local raw =
                tostring(raw_key)

            if FALLEN_FOV_BOOL_FIELD_IS_CANDIDATE(
                section,
                raw
            )
            then
                local ok_write =
                    pcall(function()
                        section[raw] =
                            value
                    end)

                if ok_write then
                    changed[
                        #changed + 1
                    ] =
                        tostring(
                            section_name
                            or "section"
                        )
                        .. "."
                        .. raw
                end
            end
        end
    end

    return changed
end


