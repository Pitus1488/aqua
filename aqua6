function FALLEN_AVATAR_EDITOR_OPEN_FOLDER()
    local path =
        FALLEN_AVATAR_EDITOR_FOLDER()

    local opened = false

    -- Probe common host APIs without depending on one specific Blueberry build.
    if Windows then
        if not opened
            and type(Windows.OpenFolder) == "function"
        then
            local ok =
                pcall(
                    Windows.OpenFolder,
                    Windows,
                    path
                )

            if not ok then
                ok =
                    pcall(
                        Windows.OpenFolder,
                        path
                    )
            end

            opened = ok == true
        end

        if not opened
            and type(Windows.OpenPath) == "function"
        then
            local ok =
                pcall(
                    Windows.OpenPath,
                    Windows,
                    path
                )

            if not ok then
                ok =
                    pcall(
                        Windows.OpenPath,
                        path
                    )
            end

            opened = ok == true
        end

        if not opened
            and type(Windows.ShellExecute) == "function"
        then
            local ok =
                pcall(
                    Windows.ShellExecute,
                    Windows,
                    "open",
                    path
                )

            if not ok then
                ok =
                    pcall(
                        Windows.ShellExecute,
                        Windows,
                        path
                    )
            end

            if not ok then
                ok =
                    pcall(
                        Windows.ShellExecute,
                        path
                    )
            end

            opened = ok == true
        end
    end

    if not opened
        and type(open_folder) == "function"
    then
        opened =
            pcall(
                open_folder,
                path
            )
    end

    if not opened
        and type(open_path) == "function"
    then
        opened =
            pcall(
                open_path,
                path
            )
    end

    if not opened
        and type(shell_execute) == "function"
    then
        local ok =
            pcall(
                shell_execute,
                "open",
                path
            )

        if not ok then
            ok =
                pcall(
                    shell_execute,
                    path
                )
        end

        opened = ok == true
    end

    if not opened
        and os
        and type(os.execute) == "function"
    then
        local command =
            'explorer.exe "'
            .. path
            .. '"'

        local ok =
            pcall(
                os.execute,
                command
            )

        opened = ok == true
    end

    if opened then
        A.avatar_editor_status =
            "Avatar folder opened"

        return true
    end

    -- Last fallback: make the exact folder path easy to use.
    FALLEN_AVATAR_EDITOR_COPY_FOLDER_PATH()

    return false
end

function FALLEN_AVATAR_DRAW_CROP_VIEW(
    handle,
    x,
    y,
    size,
    zoom,
    pan_x,
    pan_y,
    mask_color,
    circle_clip
)
    if not handle
        or type(DrawImage) ~= "function"
    then
        return false
    end

    local ready = true

    if type(IsImageReady) == "function" then
        local ok_ready, is_ready =
            pcall(
                IsImageReady,
                handle
            )

        ready =
            ok_ready
            and is_ready == true
    end

    if not ready then
        return false
    end

    zoom =
        clamp(
            tonumber(zoom) or 1,
            1,
            5.0
        )

    pan_x =
        clamp(
            tonumber(pan_x) or 0,
            -1,
            1
        )

    pan_y =
        clamp(
            tonumber(pan_y) or 0,
            -1,
            1
        )

    -- DrawImage supports an optional UV rectangle after the rounding value:
    -- handle,x,y,w,h,r,g,b,a,rounding,u0,v0,u1,v1
    --
    -- Crop the texture itself instead of drawing a giant moving image.
    -- Because destination x/y/w/h NEVER change, pixels physically cannot
    -- escape the preview/avatar rectangle.
    local span =
        1.0 / zoom

    local travel =
        1.0 - span

    -- Positive pan means the image itself was dragged right/down,
    -- so the source window moves left/up.
    local u0 =
        travel * 0.5
        - pan_x * travel * 0.5

    local v0 =
        travel * 0.5
        - pan_y * travel * 0.5

    u0 =
        clamp(
            u0,
            0,
            1 - span
        )

    v0 =
        clamp(
            v0,
            0,
            1 - span
        )

    local u1 =
        u0 + span

    local v1 =
        v0 + span

    local rounding =
        circle_clip
        and FALLEN_UI_LEN(size * 0.5)
        or 0

    local ok_draw =
        pcall(
            DrawImage,
            handle,
            FALLEN_UI_X(x),
            FALLEN_UI_Y(y),
            FALLEN_UI_LEN(size),
            FALLEN_UI_LEN(size),
            1,
            1,
            1,
            MENU_RENDER_ALPHA,
            rounding,
            u0,
            v0,
            u1,
            v1
        )

    if ok_draw then
        return true
    end

    -- Compatibility fallback for an older DrawImage build.
    -- It stays safely inside the viewport; zoom requires UV support.
    return
        pcall(
            DrawImage,
            handle,
            FALLEN_UI_X(x),
            FALLEN_UI_Y(y),
            FALLEN_UI_LEN(size),
            FALLEN_UI_LEN(size),
            1,
            1,
            1,
            MENU_RENDER_ALPHA,
            rounding
        ) == true
end

function FALLEN_AVATAR_EDITOR_SOURCE_PATH()
    if A.avatar_editor_candidate_path
        and not string.find(
            string.lower(A.avatar_editor_candidate_path),
            "avatar_saved_circle.png",
            1,
            true
        )
    then
        return A.avatar_editor_candidate_path
    end

    local base =
        FALLEN_AVATAR_EDITOR_FOLDER()

    if type(read_file) == "function" then
        local ok, raw =
            pcall(
                read_file,
                base .. "SELECTED_SOURCE.txt"
            )

        if ok
            and type(raw) == "string"
        then
            local path =
                FALLEN_AVATAR_EDITOR_CLEAN_PATH(
                    raw
                )

            if path
                and FALLEN_AVATAR_EDITOR_PATH_SUPPORTED(path)
            then
                if type(exists_file) ~= "function" then
                    return path
                end

                local ok_exists, exists =
                    pcall(
                        exists_file,
                        path
                    )

                if ok_exists
                    and exists == true
                then
                    return path
                end
            end
        end
    end

    local path =
        FALLEN_AVATAR_EDITOR_FIND_FOLDER_IMAGE()

    return path
end

function FALLEN_AVATAR_EDITOR_LOAD_ORIGINAL_SOURCE()
    local path =
        FALLEN_AVATAR_EDITOR_SOURCE_PATH()

    if not path then
        return false
    end

    return
        FALLEN_AVATAR_EDITOR_LOAD_PATH(
            path
        )
end

function FALLEN_AVATAR_EDITOR_OPEN()
    A.avatar_editor_open = true

    A.avatar_editor_original_zoom =
        tonumber(S.avatar_crop_zoom)
        or 1

    A.avatar_editor_original_pan_x =
        tonumber(S.avatar_crop_pan_x)
        or 0

    A.avatar_editor_original_pan_y =
        tonumber(S.avatar_crop_pan_y)
        or 0

    A.avatar_editor_status =
        "Drag image to position it. Use Zoom below."

    FALLEN_AVATAR_EDITOR_UNLOAD_CANDIDATE()
    FALLEN_AVATAR_EDITOR_LOAD_ORIGINAL_SOURCE()

    A.avatar_editor_dragging = false
    A.active_slider = nil
    numeric_stop(true)
    FALLEN_COLOR_INPUT_STOP(true)

    A.config_open = false
    A.menu_settings_open = false
    A.world_color_picker_open = false
    A.world_color_picker_drag = nil
end

function FALLEN_AVATAR_EDITOR_CANCEL()
    FALLEN_AVATAR_EDITOR_UNLOAD_CANDIDATE()

    S.avatar_crop_zoom =
        A.avatar_editor_original_zoom
        or 1

    S.avatar_crop_pan_x =
        A.avatar_editor_original_pan_x
        or 0

    S.avatar_crop_pan_y =
        A.avatar_editor_original_pan_y
        or 0

    A.avatar_editor_dragging = false
    A.avatar_editor_open = false
    A.avatar_editor_status = ""
    A.active_slider = nil
end

function FALLEN_AVATAR_EDITOR_SAVE()
    local source =
        FALLEN_AVATAR_EDITOR_SOURCE_PATH()

    if not source then
        A.avatar_editor_status =
            "No source image loaded"
        return
    end

    local handle =
        A.avatar_editor_candidate_handle

    if not handle then
        pcall(function()
            if Drawing
                and type(Drawing.LoadImageFromFile) == "function"
            then
                handle =
                    Drawing.LoadImageFromFile(
                        source
                    )
            elseif type(LoadImage) == "function" then
                handle =
                    LoadImage(
                        source
                    )
            end
        end)
    end

    if not handle then
        A.avatar_editor_status =
            "Could not load avatar"
        return
    end

    -- Candidate becomes the live image. Do NOT unload it.
    A.avatar_editor_candidate_handle = nil
    A.avatar_editor_candidate_path = nil

    _G.FALLEN_CUSTOM_AVATAR.handle =
        handle

    _G.FALLEN_CUSTOM_AVATAR.path =
        source

    _G.FALLEN_CUSTOM_AVATAR.tried =
        true

    PROFILE.avatar =
        handle

    PROFILE.avatar_done = true
    PROFILE.avatar_failed = false
    PROFILE.avatar_started = true

    -- Persist the ORIGINAL source. Zoom / pan live in the normal config.
    if type(write_file) == "function" then
        pcall(
            write_file,
            FALLEN_AVATAR_EDITOR_FOLDER()
                .. "SELECTED_SOURCE.txt",
            source
        )

        pcall(
            write_file,
            FALLEN_AVATAR_EDITOR_FOLDER()
                .. "SELECTED_PATH.txt",
            source
        )
    end

    A.avatar_editor_dragging = false
    A.avatar_editor_open = false
    A.avatar_editor_status = ""
    A.active_slider = nil
end

function FALLEN_AVATAR_EDITOR_FOOTER_CLICK(
    mx,
    my,
    clicked,
    x,
    y,
    size
)
    if not clicked
        or A.avatar_editor_open
        or A.world_color_picker_open
    then
