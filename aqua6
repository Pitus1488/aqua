function FALLEN_SILENT_APPLY_MAX_DISTANCE(
    sa,
    value
)
    if not sa then
        return
    end

    local distance =
        clamp(
            tonumber(value)
            or 1200,
            50,
            3000
        )

    -- Use the section's documented introspection instead of assuming
    -- an undocumented field name. Cache the matching live key once found.
    local cached_key =
        A.silent_max_distance_key

    if cached_key then
        pcall(function()
            sa[cached_key] =
                distance
        end)

        return
    end

    if type(sa._keys) ~= "function" then
        return
    end

    local ok, keys =
        pcall(function()
            return sa:_keys()
        end)

    if not ok
        or type(keys) ~= "table"
    then
        return
    end

    for _, key in ipairs(keys) do
        local raw =
            tostring(key)

        local normalized =
            string.lower(raw)

        normalized =
            string.gsub(
                normalized,
                "[^%w]",
                ""
            )

        local looks_like_distance =
            (
                string.find(
                    normalized,
                    "max",
                    1,
                    true
                )
                and string.find(
                    normalized,
                    "dist",
                    1,
                    true
                )
            )
            or (
                string.find(
                    normalized,
                    "max",
                    1,
                    true
                )
                and string.find(
                    normalized,
                    "range",
                    1,
                    true
                )
            )

        if looks_like_distance then
            A.silent_max_distance_key =
                raw

            pcall(function()
                sa[raw] =
                    distance
            end)

            return
        end
    end
end

function FALLEN_SILENT_PRED_CALLBACK(target, pos, cam)
    if not pos then
        return nil
    end

    if S.aim_auto_prediction ~= true then
        return pos
    end

    local use_cam = cam

    if not use_cam
        and aim
        and type(aim.get_camera_position) == "function"
    then
        pcall(function()
            use_cam =
                aim.get_camera_position()
        end)
    end

    local predicted = nil

    pcall(function()
        predicted =
            fap_predict(
                target,
                pos,
                use_cam
            )
    end)

    return predicted or pos
end



function FALLEN_SILENT_TICK()
    local sa =
        FALLEN_SILENT_LIVE_SECTION()

    if not sa then
        return
    end

    -- Fixed Raycast method + real HOLD keybind mode.
    pcall(function()
        sa.method =
            2
    end)

    FALLEN_SILENT_FORCE_HOLD()

    -- HOLD means the stock keybind state must follow the physical key only.
    -- Never leave any stale toggle/active latch behind.
    local bind_vk =
        math.floor(
            tonumber(S.silent_key)
            or 0
        )

    local physically_down =
        false

    if bind_vk > 0 then
        physically_down =
            key_down(bind_vk)
            == true
    end

    if cheat
        and cheat.keybinds
        and type(cheat.keybinds._keys) == "function"
    then
        local ok_keys, bind_keys =
            pcall(function()
                return cheat.keybinds:_keys()
            end)

        if ok_keys
            and type(bind_keys) == "table"
        then
            for _, raw_key in ipairs(bind_keys) do
                local raw =
                    tostring(raw_key)

                local normalized =
                    FALLEN_SILENT_NORMALIZE_KEY(
                        raw
                    )

                if string.find(
                        normalized,
                        "silent",
                        1,
                        true
                    )
                then
                    if string.find(
                            normalized,
                            "toggled",
                            1,
                            true
                        )
                    then
                        pcall(function()
                            cheat.keybinds[raw] =
                                false
                        end)
                    elseif string.find(
                            normalized,
                            "active",
                            1,
                            true
                        )
                    then
                        -- active is documented as live/overwritten each frame;
                        -- write the actual physical HOLD state here as well.
                        pcall(function()
                            cheat.keybinds[raw] =
                                physically_down
                        end)
                    end
                end
            end
        end
    end

    -- While our custom menu is open, our switches are authoritative.
    -- This does NOT change HOLD active-state behavior.
    if S.visible then
        pcall(function()
            sa.enabled =
                S.silent_enabled == true
        end)

        pcall(function()
            sa.magic_bullet =
                S.silent_magic_bullet == true
        end)
    end

    -- Keep the explicit Silent FOV gate pinned.
    FALLEN_SILENT_SET_FOV_ENABLED(
        S.silent_fov_enabled == true
    )

    -- Silent target selection uses the radius from OUR Silent FOV.
    local silent_runtime_fov =
        math.floor(
            clamp(
                tonumber(S.silent_fov)
                or 180,
                10,
                600
            )
            + 0.5
        )

    pcall(function()
        sa.fov =
            silent_runtime_fov
    end)

    -- Make the built-in FOV visual match OUR Silent FOV exactly:
    -- same radius and same color picker value.
    if S.silent_fov_enabled == true then
        FALLEN_SYNC_STOCK_FOV_VISUAL(
            silent_runtime_fov,
            FALLEN_SILENT_FOV_COLOR()
        )
    end

    -- When the menu is closed, keep our UI cache following the stock cheat
    -- instead of overwriting the stock cheat with stale S.* values.
    if not S.visible then
        FALLEN_SILENT_SYNC_UI_FROM_LIVE()
    end
end

function FALLEN_CUSTOM_FOV_CENTER()
    -- Use the SAME mouse_pos() helper that the Fallen menu/weather already uses.
    -- It returns the mouse in the same client-space coordinates as Drawing.
    if type(mouse_pos) == "function" then
        local ok, mx, my =
            pcall(
                mouse_pos
            )

        if ok then
            mx =
                tonumber(mx)

            my =
                tonumber(my)

            if mx and my then
                return mx, my
            end
        end
    end

    -- Fallback: game crosshair position.
    if type(crosshair_pos) == "function" then
        local ok, c =
            pcall(
                crosshair_pos
            )

        if ok and c then
            local x =
                tonumber(
                    c.X
                    or c.x
                    or c[1]
                )

            local y =
                tonumber(
                    c.Y
                    or c.y
                    or c[2]
                )

            if x and y then
                return x, y
            end
        end
    end

    -- Last fallback: screen center.
    local dims = nil

    pcall(function()
        dims =
            ScreenSize()
    end)

    if dims then
        local sw =
            tonumber(
                dims.Width
                or dims.X
            )

        local sh =
            tonumber(
                dims.Height
                or dims.Y
            )

        if sw and sh then
            return
                sw * 0.5,
                sh * 0.5
        end
    end

    return nil, nil
end


function FALLEN_SYNC_STOCK_FOV_VISUAL(
    radius,
    color
)
    -- This ONLY synchronizes the stock FOV VISUAL.
    -- It does not enable cheat.aimbot and does not touch its aim logic.
    radius =
        math.floor(
            clamp(
                tonumber(radius)
                or 180,
                10,
                600
            )
            + 0.5
        )

    color =
        color
        or { 1, 1, 1, 1 }

    -- The stock FOV circle uses the Aimbot FOV size field for drawing.
    if cheat
        and cheat.aimbot
    then
        pcall(function()
            cheat.aimbot.fov =
                radius
        end)
    end

    -- FOV color lives in esp_colors according to the custom API.
    if cheat
        and cheat.esp_colors
    then
        local rgba = {
            clamp(
                tonumber(color[1]) or 1,
                0,
                1
            ),
            clamp(
                tonumber(color[2]) or 1,
                0,
                1
            ),
            clamp(
                tonumber(color[3]) or 1,
                0,
                1
            ),
            clamp(
                tonumber(color[4]) or 1,
                0,
                1
            ),
        }

        pcall(function()
            cheat.esp_colors.fov =
                rgba
        end)

        -- Some builds use the same color for the aim/FOV line.
        pcall(function()
            cheat.esp_colors.aim_line =
                rgba
        end)
    end
end


