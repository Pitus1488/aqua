function FALLEN_DRAW_MENU_SCALE_DROPDOWN(
    mx,
    my,
    clicked,
    x,
    y,
    w
)
    local raw =
        FALLEN_MENU_SCALE_DROPDOWN_STEP()

    if raw <= 0.002
        and not A.menu_scale_dropdown_open
    then
        return false
    end

    local options = {
        "Auto",
        100,
        125,
        150,
        175,
        200,
    }

    local item_h = 27
    local full_h =
        #options
        * item_h

    local visible_h =
        full_h
        * ease_out_cubic(raw)

    local panel_h =
        math.max(
            2,
            visible_h
        )

    FALLEN_POPUP_GLOW(x, y, w, panel_h, 7, 0.95)

    rounded_fill(
        x,
        y,
