    FALLEN_HITFX.vfx_shot_view_last = now

    if not rbx
        or type(rbx.camera) ~= "function"
    then
        return
    end

    local cam = nil
    local cam_pos = nil
    local rot = nil
    local fov = nil

    pcall(function()
        cam = rbx.camera()
        if cam then
            cam_pos = cam:camera_pos()
            rot = cam:camera_rotation()
            fov = cam:camera_fov()
        end
    end)

    if not cam_pos
        or type(rot) ~= "table"
        or #rot < 9
    then
        return
    end

    local dims = nil

    if type(ScreenSize) == "function" then
        pcall(function()
            dims = ScreenSize()
        end)
    end

    if type(dims) ~= "table" then
        return
    end

    local vw = tonumber(dims.Width or dims.width or dims.X or dims.x)
    local vh = tonumber(dims.Height or dims.height or dims.Y or dims.y)

    if not vw or not vh or vw <= 0 or vh <= 0 then
        return
    end

    local cx, cy = FALLEN_HITFX_FOV_CENTER()

    if not cx or not cy then
        cx = vw * 0.5
        cy = vh * 0.5
    end

    fov = tonumber(fov) or math.rad(70)

    if fov > math.pi * 1.25 then
        fov = math.rad(fov)
    end

    fov = clamp(fov, math.rad(20), math.rad(150))

    local snapshot = {
        time = now,
        px = tonumber(cam_pos.X),
        py = tonumber(cam_pos.Y),
        pz = tonumber(cam_pos.Z),
        rx = tonumber(rot[1]),
        ry = tonumber(rot[4]),
        rz = tonumber(rot[7]),
        ux = tonumber(rot[2]),
        uy = tonumber(rot[5]),
        uz = tonumber(rot[8]),
        fx = -tonumber(rot[3]),
        fy = -tonumber(rot[6]),
        fz = -tonumber(rot[9]),
        vw = vw,
        vh = vh,
        cx = tonumber(cx),
        cy = tonumber(cy),
        fov = fov,
        radius = FALLEN_HITFX_FOV_RADIUS(),
    }

    for _, key in ipairs({
        "px", "py", "pz",
        "rx", "ry", "rz",
        "ux", "uy", "uz",
        "fx", "fy", "fz",
        "vw", "vh", "cx", "cy", "fov", "radius",
    }) do
        if snapshot[key] == nil then
            return
        end
    end

    local list = FALLEN_HITFX.vfx_shot_views
    list[#list + 1] = snapshot

    for i = #list, 1, -1 do
        if now - (tonumber(list[i].time) or 0) > 1.05 then
            table.remove(list, i)
        end
    end

    while #list > 32 do
        table.remove(list, 1)
    end
end

function FALLEN_HITFX_FOV_CHECK_SNAPSHOT(pos, snapshot)
    if not pos or type(snapshot) ~= "table" then
        return false, nil
    end

    local dx = tonumber(pos.X) - tonumber(snapshot.px)
    local dy = tonumber(pos.Y) - tonumber(snapshot.py)
    local dz = tonumber(pos.Z) - tonumber(snapshot.pz)

    if not dx or not dy or not dz then
        return false, nil
    end

    local local_x = dx * snapshot.rx + dy * snapshot.ry + dz * snapshot.rz
    local local_y = dx * snapshot.ux + dy * snapshot.uy + dz * snapshot.uz
    local local_z = dx * snapshot.fx + dy * snapshot.fy + dz * snapshot.fz

    if local_z <= 0.001 then
        return false, nil
    end

    local focal = snapshot.vh / (2 * math.tan(snapshot.fov * 0.5))
    if focal <= 0 then
        return false, nil
    end

    local sx = snapshot.vw * 0.5 + (local_x / local_z) * focal
    local sy = snapshot.vh * 0.5 - (local_y / local_z) * focal
    local ddx = sx - snapshot.cx
    local ddy = sy - snapshot.cy
    local dist_sq = ddx * ddx + ddy * ddy
    local radius = tonumber(snapshot.radius) or 40

    return dist_sq <= radius * radius, dist_sq
end

function FALLEN_HITFX_FOV_CHECK_SHOT_VIEWS(pos, max_age)
    local list = FALLEN_HITFX.vfx_shot_views

    if type(list) ~= "table" or #list == 0 then
        return false, nil
    end

    local now = tick()
    local age_limit = tonumber(max_age) or 1.00
    local best_dist_sq = nil

    for i = #list, 1, -1 do
        local snapshot = list[i]
        local age = now - (tonumber(snapshot.time) or 0)

        if age <= age_limit then
            local ok, dist_sq = FALLEN_HITFX_FOV_CHECK_SNAPSHOT(pos, snapshot)

            if ok then
                return true, dist_sq
            end

            if dist_sq ~= nil and (best_dist_sq == nil or dist_sq < best_dist_sq) then
                best_dist_sq = dist_sq
            end
        end
    end

    return false, best_dist_sq
end

function FALLEN_HITFX_FIND_NEW_IMPACT(
    previous,
    current,
    shot_age
)
    if type(current) ~= "table" then
        return nil
    end

    previous =
        type(previous) == "table"
        and previous
        or {}

    shot_age =
        tonumber(shot_age)
        or 999

    local best_pos =
        nil

    local best_screen_dist_sq =
        nil

    for key, inst in pairs(current) do
        if previous[key] == nil then
            local kind =
                FALLEN_HITFX_VFX_KIND(
                    inst
                )

            local allowed =
                kind == "bloodpart"
                and shot_age <= 1.00

            if allowed then
                local pos =
                    FALLEN_BT_VFX_POSITION(
                        inst
                    )

                if pos then
                    local inside, screen_dist_sq =
                        FALLEN_HITFX_FOV_CHECK_SHOT_VIEWS(
                            pos,
                            1.00
                        )

                    if inside
                        and screen_dist_sq ~= nil
                        and (
                            best_screen_dist_sq == nil
                            or screen_dist_sq < best_screen_dist_sq
                        )
                    then
                        best_screen_dist_sq =
                            screen_dist_sq

                        best_pos = {
                            X = pos.X,
                            Y = pos.Y,
                            Z = pos.Z,
                        }
                    end
                end
            end
        end
    end

    return best_pos
end


function FALLEN_HITFX_VFX_TICK()
    local enabled =
        S.hit_effect_enabled == true
        and FALLEN_BT_WEAPON_READY()

    if not enabled then
        if FALLEN_HITFX.vfx_runtime_active == true then
            FALLEN_HITFX.vfx_seen = {}
            FALLEN_HITFX.vfx_prev_lmb = false
            FALLEN_HITFX.vfx_watch_until = 0
            FALLEN_HITFX.vfx_shot_time = nil
            FALLEN_HITFX.vfx_shot_views = {}
            FALLEN_HITFX.vfx_shot_view_last = 0
            FALLEN_HITFX.vfx_idle_scan_last = 0
            FALLEN_HITFX.vfx_scan_generation = nil
        end

        FALLEN_HITFX.vfx_runtime_active = false
        return
    end

    FALLEN_HITFX.vfx_runtime_active = true

    local now = tick()
    local lmb =
        key_down(VK_LBUTTON)
        == true

    local watch_until =
        tonumber(
            FALLEN_HITFX.vfx_watch_until
        )
        or 0

    local tracer_needs_holes =
        S.bullet_tracer_enabled == true

    if not lmb
        and now >= watch_until
    then
        if now
            - (
                tonumber(
                    FALLEN_HITFX.vfx_idle_scan_last
                )
                or 0
            )
            >= 0.25
        then
            local current, generation =
                FALLEN_BT_VFX_SCAN(
                    0.25,
                    tracer_needs_holes
                )

            FALLEN_HITFX.vfx_seen =
                current

            FALLEN_HITFX.vfx_scan_generation =
                generation

            FALLEN_HITFX.vfx_idle_scan_last =
                now
        end

        FALLEN_HITFX.vfx_prev_lmb = false
        FALLEN_HITFX.vfx_shot_time = nil

        if #FALLEN_HITFX.vfx_shot_views > 0 then
            FALLEN_HITFX.vfx_shot_views = {}
        end

        FALLEN_HITFX.vfx_shot_view_last = 0
        return
    end

    if lmb
        and FALLEN_HITFX.vfx_prev_lmb ~= true
    then
        FALLEN_HITFX.vfx_shot_time = now
        FALLEN_HITFX.vfx_watch_until = now + 1.00
        FALLEN_HITFX_CAPTURE_SHOT_VIEW(true)

    elseif lmb then
        FALLEN_HITFX.vfx_shot_time = now
        FALLEN_HITFX.vfx_watch_until = now + 1.00
        FALLEN_HITFX_CAPTURE_SHOT_VIEW(false)
    end

    FALLEN_HITFX.vfx_prev_lmb = lmb

    local current, generation =
        FALLEN_BT_VFX_SCAN(
            0.040,
            tracer_needs_holes
        )

    if generation ~= nil
        and generation
            == FALLEN_HITFX.vfx_scan_generation
    then
        return
    end

    local previous =
        FALLEN_HITFX.vfx_seen
        or {}

    FALLEN_HITFX.vfx_scan_generation =
        generation

    FALLEN_HITFX.vfx_seen =
        current

    local shot_age =
        now
        - (
            tonumber(
                FALLEN_HITFX.vfx_shot_time
            )
            or now
        )

    local impact_pos =
        FALLEN_HITFX_FIND_NEW_IMPACT(
            previous,
            current,
            shot_age
        )

    if impact_pos then
        FALLEN_HITFX_ADD(
            impact_pos
        )
    end
end

function FALLEN_HITFX_WORLD_PIXEL_SIZE(hit, kind)
    if not hit then
        return 48
    end

    local base =
        hit._base
        or {
            X = hit.x,
            Y = hit.y,
            Z = hit.z,
        }

    hit._base = base
    base.X = hit.x
    base.Y = hit.y
    base.Z = hit.z

    local world_size = 4.0

    if kind == 1
        or kind == 4
        or kind == 5
        or kind == 6
        or kind == 7
    then
        world_size = 8.0

    elseif kind == 2 then
        world_size = 4.0

    elseif kind == 3 then
        world_size = 3.0
    end

    local offset =
        hit._offset
        or {
            X = hit.x,
            Y = hit.y + world_size,
            Z = hit.z,
        }

    hit._offset = offset
    offset.X = hit.x
    offset.Y = hit.y + world_size
    offset.Z = hit.z

    local a =
        FALLEN_BT_PROJECT(base)

    local b =
        FALLEN_BT_PROJECT(offset)

    if a and b then
        local dx =
            (b.X or 0)
            - (a.X or 0)

        local dy =
            (b.Y or 0)
            - (a.Y or 0)

        local px =
            math.sqrt(
                dx * dx
                + dy * dy
            )

        if kind == 1
            or kind == 4
            or kind == 5
            or kind == 6
            or kind == 7
        then
            return clamp(px, 34, 220)

        elseif kind == 2 then
            return clamp(px, 28, 170)

        else
            return clamp(px, 24, 145)
        end
    end

    if kind == 1
        or kind == 4
        or kind == 5
        or kind == 6
        or kind == 7
    then
        return 86

    elseif kind == 2 then
        return 64
    end

    return 58
end

function FALLEN_HITFX_DRAW_ONE(hit, age, life, kind)
    local base =
        hit._base
        or {
            X = hit.x,
            Y = hit.y,
            Z = hit.z,
        }

    hit._base = base
    base.X = hit.x
    base.Y = hit.y
    base.Z = hit.z

    local s =
        FALLEN_BT_PROJECT(base)

    if not s then
        return
    end

    local t =
        clamp(
            age / life,
            0,
            1
        )

    local alpha =
        1 - t

    -- Match fallen_ultimate's WORLD-space particle sizing instead of fixed
    -- screen pixels. Near hits render larger; far hits render smaller.
    kind = tonumber(kind) or FALLEN_HITFX_STYLE_INDEX()
    local size = FALLEN_HITFX_WORLD_PIXEL_SIZE(hit, kind)

    -- User scale for every hit effect. Default is intentionally smaller
    -- than the previous build.
    size =
        size
        * clamp(
            tonumber(S.hit_effect_size) or 0.65,
            0.25,
            1.50
        )

    FALLEN_HITFX_DRAW_FALLEN(
        kind,
        s.X,
        s.Y,
        size,
        t,
        alpha,
        { 1, 1, 1, 1 },
        hit.seed
    )
end

function FALLEN_HITFX_DRAW()
    if type(FALLEN_HITFX.items) ~= "table" then
        FALLEN_HITFX.items = {}
    end

    local now = tick()

    local kind = FALLEN_HITFX_STYLE_INDEX()
    local life = 1.0

    if kind == 1 then
        life = 0.55
    elseif kind == 2 then
        life = 1.0
    elseif kind == 3 then
        life = 1.0
    end

    for i = #FALLEN_HITFX.items, 1, -1 do
        local hit =
            FALLEN_HITFX.items[i]

        local age =
            now - (hit.created or now)

        if age > life
            or S.hit_effect_enabled ~= true
        then
            table.remove(
                FALLEN_HITFX.items,
                i
            )
        else
            FALLEN_HITFX_DRAW_ONE(
                hit,
                age,
                life,
                kind
            )
        end
    end
end

function FALLEN_HITFX_TICK()
    if _G.FallenMenuReady ~= true then
        return
    end

    FALLEN_HITFX_VFX_TICK()
    FALLEN_HITFX_DRAW()
end

hooks.on_render(function()
    local ok, err =
        pcall(
            FALLEN_BT_TICK
        )

    pcall(
        FALLEN_HITFX_TICK
    )

    if not ok then
        FALLEN_BT =
            FALLEN_BT
            or {}

        FALLEN_BT.last_error =
            tonumber(
                FALLEN_BT.last_error
            )
            or 0

        if tick() - FALLEN_BT.last_error > 2 then
            FALLEN_BT.last_error = tick()

            if type(warn) == "function" then
                warn(
                    SYS
                    .. "Bullet Tracer: "
                    .. tostring(err)
                )
            end
        end
    end
end)

