        vbox(hX-3,sy+(1-item.h)*sh-1,19,3,COLORS.white,a)
        region(sx,sy,sw,sh,function()
            runtime.drag={kind='sv',item=item,x=sx,y=sy,w=sw,h=sh}
            item.s=clamp((runtime.mx-sx)/sw,0,1)
            item.v=1-clamp((runtime.my-sy)/sh,0,1)
            updateColor(item)
        end)
        region(hX,sy,13,sh,function()
            runtime.drag={kind='hue',item=item,x=hX,y=sy,h=sh}
            item.h=1-clamp((runtime.my-sy)/sh,0,1)
            updateColor(item)
        end)
        vrounded(x+13,y+203,46,25,3,item.Value,a)
        vrounded(x+67,y+203,120,25,3,COLORS.field,a)
        local entering=runtime.focus and runtime.focus.kind=='hex' and runtime.focus.item==item
        vtext(x+77,y+209,'#'..(entering and runtime.focus.Value or hex(item.Value)),UI.Theme.Custom.Text,a)
        region(x+64,y+202,125,27,function()
            runtime.focus={kind='hex',Value=hex(item.Value),item=item}
        end)
    end
end

local function drawNotices(now)
    for i=#runtime.notices,1,-1 do
        local n=runtime.notices[i]
        local age=now-n.birth;local ending=n.duration+.8
        if age>ending then table.remove(runtime.notices,i)
        else
            local p=age<.4 and quad(age/.4) or (age>n.duration+.4 and 1-quad((age-n.duration-.4)/.4) or 1)
            local w=262*p
            local x=(runtime.w-14-w);local y=17+(i-1)*77
            rounded(x,y,w,67,5,COLORS.notify,1)
            if p>.30 then
                rounded(x+9,y+12,43,42,6,COLORS.dark,p)
                text(x+23,y+27,'N',UI.Theme.Custom.Glow,p)
                text(x+61,y+10,n.title,UI.Theme.Custom.Text,p)
                text(x+61,y+37,n.desc:sub(1,30),COLORS.gray,p)
            end
            local rem=clamp(1-math.max(0,age-.4)/n.duration,0,1)
            box(x,y+62,w*rem,5,UI.Theme.Custom.Glow,p)
        end
    end
end

local function processMouse(dt)
    if not runtime.down then runtime.drag=nil end
    local d=runtime.drag
    if d and runtime.down then
        if d.kind=='window' then
            local tx=d.x+runtime.curPixelX-d.startX
            local ty=d.y+runtime.curPixelY-d.startY
            runtime.x=approach(runtime.x,clamp(tx,-190*runtime.s,runtime.w-180*runtime.s),dt,13)
            runtime.y=approach(runtime.y,clamp(ty,0,runtime.h-65*runtime.s),dt,13)
        elseif d.kind=='slider' then
            local it=d.item
            it:Set(clamp(it.min+(runtime.mx-d.x)/d.w*(it.max-it.min),it.min,it.max))
        elseif d.kind=='sv' then
            d.item.s=clamp((runtime.mx-d.x)/d.w,0,1)
            d.item.v=1-clamp((runtime.my-d.y)/d.h,0,1)
            updateColor(d.item)
        elseif d.kind=='hue' then
            d.item.h=1-clamp((runtime.my-d.y)/d.h,0,1)
            updateColor(d.item)
        end
    end
end

local function render()
    local win=runtime.win
    if not win then return end
    local now=tick();local dt=clamp(now-runtime.frameTime,0,.075);runtime.frameTime=now
    local ss=ScreenSize() or {Width=1920,Height=1080}
    runtime.w=ss.Width or 1920;runtime.h=ss.Height or 1080
    runtime.s=math.min(1,(runtime.w-20)/846,(runtime.h-20)/682)
    if not win.positioned then
        runtime.x=(runtime.w-846*runtime.s)/2
        runtime.y=(runtime.h-682*runtime.s)/2
        win.positioned=true
    end
    local mx,my=mousePosition()
    runtime.curPixelX=mx;runtime.curPixelY=my
    runtime.mx=(mx-runtime.x)/runtime.s
    runtime.my=(my-runtime.y)/runtime.s
    runtime.down=Windows.IsKeyPressed(0x01)
    runtime.pressed=runtime.down and not runtime.wasDown
    runtime.released=not runtime.down and runtime.wasDown
    inputUpdate(dt)
    if win.searchObject then win.searchValue=win.searchObject.Value end
    runtime.alpha=approach(runtime.alpha,UI.Visible and 1 or 0,dt,12)
    runtime.regions={}
    if runtime.alpha>.01 then
        if not win.keyAuthorized then
            drawKeySystem(win,dt)
        else
            drawNav(win,dt)
            drawHeader(win,dt)
            -- Top heading is the drag handle; 0.2s-style smoothing.
            region(350,0,405,70,function()
                runtime.drag={kind='window',startX=runtime.curPixelX,startY=runtime.curPixelY,x=runtime.x,y=runtime.y}
            end)
            drawSettings(win,dt)
            drawTools(win)
            drawPopup(dt)
        end
    end
    if runtime.pressed then
        local selected=nil
        for i=#runtime.regions,1,-1 do
            local r=runtime.regions[i]
            if inside(r.x,r.y,r.w,r.h) then selected=r;break end
        end
        if selected then
            local ok,err=pcall(selected.callback)
            if not ok then notify('UI action failed: '..tostring(err),'error') end
        else
            if runtime.popup and runtime.popup.kind~='bindcapture' then runtime.popup=nil end
            runtime.focus=nil
        end
    end
    processMouse(dt)
    runtime.wasDown=runtime.down
    drawNotices(now)
end

hooks.on_render(render)

