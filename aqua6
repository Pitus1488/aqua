function FALLEN_MISC_FPS_STRIPPED_NAME(
    name
)
    name =
        tostring(
            name or ""
        )

    local prefixes = {
        "DFFlag",
        "DFInt",
        "FFlag",
        "FInt",
        "FString",
        "FLog",
    }

    for _, prefix in ipairs(prefixes) do
        if string.sub(
            name,
            1,
            #prefix
        ) == prefix
        then
            return
                string.sub(
                    name,
                    #prefix + 1
                )
        end
    end

    return name
end


function FALLEN_MISC_FPS_RESOLVE_OFFSET(
    flag_name
)
    if not memory
        or type(memory.offsets) ~= "table"
    then
        return nil, nil
    end

    local full =
        tostring(
            flag_name or ""
        )

    local stripped =
        FALLEN_MISC_FPS_STRIPPED_NAME(
            full
        )

    local off =
        memory.offsets[full]

    if off ~= nil then
        return off, full
    end

    off =
        memory.offsets[stripped]

    if off ~= nil then
        return off, stripped
    end

    return nil, nil
end


function FALLEN_MISC_FPS_READ_VALUE(
    addr,
    kind
)
    if not memory
        or not addr
    then
        return nil
    end

    local value = nil

    if kind == "bool"
        and type(memory.read_bool) == "function"
    then
        pcall(function()
            value =
                memory.read_bool(
                    addr
                )
        end)

    elseif kind == "f32"
        and type(memory.read_f32) == "function"
    then
        pcall(function()
            value =
                memory.read_f32(
                    addr
                )
        end)

    elseif kind == "i32"
        and type(memory.read_i32) == "function"
    then
        pcall(function()
            value =
                memory.read_i32(
                    addr
                )
        end)
    end

    return value
end


function FALLEN_MISC_FPS_WRITE_VALUE(
    addr,
    kind,
    value
)
    if not memory
        or not addr
    then
        return false
    end

    local wrote = false

    if kind == "bool"
        and type(memory.write_bool) == "function"
    then
        pcall(function()
            wrote =
                memory.write_bool(
                    addr,
                    value == true
                )
                ~= false
        end)

    elseif kind == "f32"
        and type(memory.write_f32) == "function"
    then
        pcall(function()
            wrote =
                memory.write_f32(
                    addr,
                    tonumber(value) or 0
                )
                ~= false
        end)

    elseif kind == "i32"
        and type(memory.write_i32) == "function"
    then
        pcall(function()
            wrote =
                memory.write_i32(
                    addr,
                    math.floor(
                        tonumber(value) or 0
                    )
                )
                ~= false
        end)
    end

    return wrote
end


function FALLEN_MISC_FPS_ENABLE()
    if not memory
        or type(memory.module_base) ~= "function"
    then
        return false
    end

    local base = nil

    pcall(function()
        base =
            memory.module_base()
    end)

    if not base
        or base == 0
    then
        return false
    end

    A.misc_fps_original =
        A.misc_fps_original
        or {}

    A.misc_fps_applied =
        {}

    local changed =
        0

    for _, spec in ipairs(
        FALLEN_MISC_FPS_FLAG_SPECS()
    ) do
        -- FString globals need a documented string-object layout before they
        -- can be modified safely in-process. Keep them in the bundle but skip.
        if spec.kind ~= "string" then
            local off, resolved_key =
                FALLEN_MISC_FPS_RESOLVE_OFFSET(
                    spec.name
                )

            if off ~= nil then
                local addr =
                    base + off

                local original =
                    FALLEN_MISC_FPS_READ_VALUE(
                        addr,
                        spec.kind
                    )

                if original ~= nil then
                    if A.misc_fps_original[spec.name] == nil then
                        A.misc_fps_original[spec.name] = {
                            addr = addr,
                            kind = spec.kind,
                            value = original,
                            key = resolved_key,
                        }
                    end

                    if FALLEN_MISC_FPS_WRITE_VALUE(
                        addr,
                        spec.kind,
                        spec.value
                    )
                    then
                        A.misc_fps_applied[spec.name] =
                            true

                        changed =
                            changed + 1
                    end
                end
            end
        end
    end

    return
        changed > 0
end


function FALLEN_MISC_FPS_DISABLE()
    local originals =
        A.misc_fps_original

    if type(originals) ~= "table" then
        return false
    end

    local restored =
        0

    for _, info in pairs(originals) do
        if info
            and info.addr
            and info.kind
            and info.value ~= nil
        then
            if FALLEN_MISC_FPS_WRITE_VALUE(
                info.addr,
                info.kind,
                info.value
            )
            then
                restored =
                    restored + 1
            end
        end
    end

    A.misc_fps_original =
        {}

    A.misc_fps_applied =
        {}

    return
        restored > 0
end


function FALLEN_MISC_FPS_TICK()
    local desired =
        S.misc_fps_enabled == true

    if A.misc_fps_last_state == desired then
        return
    end

    A.misc_fps_last_state =
        desired

    if desired then
        FALLEN_MISC_FPS_ENABLE()
    else
        FALLEN_MISC_FPS_DISABLE()
    end
end


hooks.on_render(function()
    if _G.FallenMenuReady ~= true then
        return
    end

    pcall(
        FALLEN_MISC_FPS_TICK
    )
end)


-- =========================================================
-- Secret Desync bridge
-- =========================================================
function FALLEN_SECRET_DESYNC_FIND_MODULE()
    if A.secret_desync_module then
        return
            A.secret_desync_module
    end

    local found = nil

    -- The host exposes Silent Aim as cheat.silent_aim, so try the matching
    -- built-in Desync module names first.
    if cheat then
        local direct = {
            "desync",
            "Desync",
            "desyncer",
            "desync_module",
        }

        for _, key in ipairs(direct) do
            local ok, value =
                pcall(function()
                    return cheat[key]
                end)

            if ok
                and value ~= nil
            then
                found = value
                break
            end
        end

        -- Build-independent fallback: find any cheat field containing
        -- "desync" in its name.
        if not found then
            pcall(function()
                for key, value in pairs(cheat) do
                    local name =
                        string.lower(
                            tostring(key)
                        )

                    if string.find(
                        name,
                        "desync",
                        1,
                        true
                    ) then
                        found = value
                        break
                    end
                end
            end)
        end
    end

    -- A few builds may expose the module globally instead of under cheat.
    if not found then
        local globals = {
            "desync",
            "Desync",
            "DESYNC",
        }

        for _, key in ipairs(globals) do
            local ok, value =
                pcall(function()
                    return _G[key]
                end)

            if ok
                and value ~= nil
            then
                found = value
                break
            end
        end
    end

    if found then
        A.secret_desync_module =
            found
    end

    return found
end

function FALLEN_SECRET_DESYNC_APPLY(
    module,
    enabled
)
    if module == nil then
        return false
    end

    -- Some hosts expose the feature itself as a callback.
    if type(module) == "function" then
        local ok =
            pcall(
                module,
                enabled
            )

        return ok == true
    end

    local applied = false

    -- Most likely layout: cheat.desync.enabled
    pcall(function()
        module.enabled =
            enabled

        applied = true
    end)

    if applied then
        return true
    end

    pcall(function()
        module.Enabled =
            enabled

        applied = true
    end)

    if applied then
        return true
    end

    local setters = {
        "set_enabled",
        "SetEnabled",
        "setEnabled",
        "set_active",
        "SetActive",
    }

    for _, method in ipairs(setters) do
        local worked = false

        pcall(function()
            if type(module[method]) == "function" then
                module[method](
                    module,
                    enabled
                )

                worked = true
            end
        end)

        if worked then
            return true
        end
    end

    return false
end

function FALLEN_SECRET_DESYNC_TICK()
    local desired =
        A.secret_unlocked == true
        and S.secret_enabled == true
        and S.secret_desync_enabled == true

    if A.secret_desync_last_state ~= desired then
        local applied =
            FALLEN_CHEAT_SET_FEATURE(
                "desync",
                desired
            )

        if not applied then
            local module =
                FALLEN_SECRET_DESYNC_FIND_MODULE()

            if module then
                FALLEN_SECRET_DESYNC_APPLY(
                    module,
                    desired
                )
            end
        end
    end

    A.secret_desync_last_state =
        desired
end

hooks.on_render(function()
    pcall(
        FALLEN_SECRET_DESYNC_TICK
    )
end)

