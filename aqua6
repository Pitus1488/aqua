-- =========================================================
-- Hit Effect sprite-sheet loaders.
-- IMPORTANT: exact same PAGE -> resolve -> LoadImage -> IsImageReady
-- path used by the Aimbot tab icon. fotovssylku /i/... links are page
-- URLs, so never feed these three raw page URLs to the generic preloader.
-- =========================================================

_G.FALLEN_HITFX_SHEET_STATE =
    _G.FALLEN_HITFX_SHEET_STATE
    or {}

function FALLEN_HITFX_SHEET_GET(key, page_url)
    if type(key) ~= "string"
        or type(page_url) ~= "string"
        or page_url == ""
    then
        return nil
    end

    local state =
        _G.FALLEN_HITFX_SHEET_STATE[key]

    if type(state) ~= "table" then
        state = {
            source = nil,
            resolved = nil,
            handle = nil,
        }
        _G.FALLEN_HITFX_SHEET_STATE[key] = state
    end

    if state.source ~= page_url then
        state.source = page_url
        state.resolved = nil
        state.handle = nil
    end

    if not state.resolved then
        if type(FALLEN_LOADER_RESOLVE_IMAGE_URL) ~= "function" then
            return nil
        end

        state.resolved =
            FALLEN_LOADER_RESOLVE_IMAGE_URL(page_url)
            or page_url
    end

    if not state.handle
        and type(LoadImage) == "function"
    then
        pcall(function()
            state.handle =
                LoadImage(
                    state.resolved
                )
        end)
    end

    local handle = state.handle
    if not handle then
        return nil
    end

    if type(IsImageFailed) == "function" then
        local ok_failed, failed =
            pcall(
                IsImageFailed,
                handle
            )

        if ok_failed and failed == true then
            return nil
        end
    end

    if type(IsImageReady) == "function" then
        local ok_ready, ready =
            pcall(
                IsImageReady,
                handle
            )

        if not ok_ready
            or ready ~= true
        then
            return nil
        end
    end

    return handle
end

