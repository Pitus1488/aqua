function FALLEN_HITFX_DRAW_IMAGE_UV(
    handle,
    x,
    y,
    w,
    h,
    r,
    g,
    b,
    a,
    u0,
    v0,
    u1,
    v1,
    rounding
)
    if not handle
        or type(DrawImage) ~= "function"
        or a <= 0.002
    then
        return false
    end

    local ok = pcall(
        DrawImage,
        handle,
        x,
        y,
        w,
        h,
        r,
        g,
        b,
        a,
        rounding or math.max(2, math.min(w, h) * 0.08),
        u0,
        v0,
        u1,
        v1
    )

    if ok then
        return true
    end

    return pcall(
        DrawImage,
        handle,
        x,
        y,
        w,
        h,
        r,
        g,
        b,
        a,
        rounding or math.max(2, math.min(w, h) * 0.08)
    ) == true
