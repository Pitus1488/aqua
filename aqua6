function FALLEN_SILENT_FOV_GLOW_COLOR()
    local r, g, b =
        hsv_to_rgb(
            S.silent_fov_glow_h,
            S.silent_fov_glow_s,
            S.silent_fov_glow_v
        )

    return {
        r,
        g,
        b,
        clamp(
