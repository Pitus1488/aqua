function FALLEN_HITFX_DRAW_SHEET_FRAME(
    handle,
    frame,
    cols,
    rows,
    x,
    y,
    w,
    h,
    r,
    g,
    b,
    a,
    rounding
)
    cols = math.max(1, math.floor(cols or 4))
    rows = math.max(1, math.floor(rows or 4))
    local total = cols * rows
    frame = math.floor(clamp(tonumber(frame) or 0, 0, total - 1))
    local cx = frame % cols
    local cy = math.floor(frame / cols)
    local u0 = cx / cols
    local v0 = cy / rows
    local u1 = (cx + 1) / cols
    local v1 = (cy + 1) / rows
    return FALLEN_HITFX_DRAW_IMAGE_UV(handle, x, y, w, h, r, g, b, a, u0, v0, u1, v1, rounding)
end

function FALLEN_HITFX_RAND(seed)
    local x =
        math.sin(
            (seed or 1) * 12.9898
            + 78.233
        ) * 43758.5453

    return x - math.floor(x)
end

function FALLEN_HITFX_DRAW_FALLEN(
    kind,
    sx,
    sy,
    size,
    t,
    alpha,
    col,
    seed
)
    local out =
        1 - (1 - t) * (1 - t)

    local fade =
        math.max(
            0,
            1 - t
        )

    if kind == 1 then
        local handle = FALLEN_HITFX_IMAGE(
            "hitfx_spark_sheet",
            FALLEN_BT_IMAGE.hitfx_spark_sheet_url
        )

        local frame = math.floor(clamp(out * 15, 0, 15))
        local s = size * (1.45 + 0.30 * out)
        FALLEN_HITFX_DRAW_SHEET_FRAME(
            handle,
            frame,
            4,
            4,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            1,
            1,
            1,
            alpha * (1 - t * 0.35),
            s * 0.18
        )

    elseif kind == 2 then
        local handle = FALLEN_HITFX_IMAGE(
            "hitfx_smokering_sheet",
            FALLEN_BT_IMAGE.hitfx_smokering_sheet_url
        )

        local frame = math.floor(clamp(out * 15, 0, 15))
        local s = size * (1.20 + 2.75 * out)
        FALLEN_HITFX_DRAW_SHEET_FRAME(
            handle,
            frame,
            4,
            4,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            col[1],
            col[2],
            col[3],
            alpha * 0.95 * fade,
            s * 0.22
        )

    elseif kind == 3 then
        local handle = FALLEN_HITFX_IMAGE(
            "hitfx_particles_sheet",
            FALLEN_BT_IMAGE.hitfx_particles_sheet_url
        )

        local frame = math.floor(clamp(out * 15, 0, 15))

        for k = 1, 6 do
            local sd = (seed or 1) + k * 19.73
            local ang = (k / 6) * math.pi * 2 + math.sin(sd) * 0.45
            local spread = size * (0.16 + 1.28 * out) * (0.75 + FALLEN_HITFX_RAND(sd + 2) * 0.55)
            local px = sx + math.cos(ang) * spread
            local py = sy + math.sin(ang) * spread
            local ps = size * (0.42 + FALLEN_HITFX_RAND(sd + 4) * 0.28)
            local rr, gg, bb = col[1], col[2], col[3]
            if k % 2 == 1 then
                rr, gg, bb = 1.0, 0.22, 0.86
            end
            FALLEN_HITFX_DRAW_SHEET_FRAME(
                handle,
                frame,
                4,
                4,
                px - ps * 0.5,
                py - ps * 0.5,
                ps,
                ps,
                rr,
                gg,
                bb,
                alpha * 0.92 * fade,
                ps * 0.20
            )
        end

    elseif kind == 4 then
        local handle = FALLEN_HITFX_IMAGE(
            "hitfx_test1_sheet",
            FALLEN_BT_IMAGE.hitfx_test1_sheet_url
        )

        local frame = math.floor(clamp(out * 15, 0, 15))
        local s = size * (1.45 + 0.30 * out)
        FALLEN_HITFX_DRAW_SHEET_FRAME(
            handle,
            frame,
            4,
            4,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            col[1],
            col[2],
