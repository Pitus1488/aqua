function FALLEN_DRAW_ARMOR_PAGE(
    mx,
    my,
    clicked,
    lmb,
    rmb_clicked,
    x,
    y,
    w
)
    local settings_w =
        math.floor(
            w * 0.48
        )

    local popup_open =
        A.armor_settings_open
        or (A.armor_settings_anim or 0) > 0.02

    local base_clicked =
        clicked
        and not popup_open

    local onplayer_anim =
        FALLEN_ARMOR_ONPLAYER_OPTIONS_STEP()

    local onplayer_eased =
        smooth01(
            onplayer_anim
        )

    local extra_h =
        82 * onplayer_eased

    section_title(
        x,
        y,
        "Armor ESP"
    )

    card(
        x,
        y + 25,
        settings_w,
        255 + extra_h,
        11
    )

    local dots_x =
        x + settings_w - 79

    local dots_y =
        y + 40

    local dots_hot =
        hover(
            mx,
            my,
            dots_x,
            dots_y,
            27,
            25
        )

    toggle_row(
        mx,
        my,
        base_clicked and not dots_hot,
        x,
        y + 32,
        settings_w,
        "Armor ESP",
        "armor_esp_enabled",
        true
    )

    local armor_row_hot =
        hover(
            mx,
            my,
            x,
            y + 32,
            settings_w,
            41
        )

    if clicked and dots_hot then
        A.armor_settings_open =
            not A.armor_settings_open

        A.armor_mode_dropdown_open = false
        numeric_stop(true)
    end

    line(
        x + 12,
        y + 72,
        x + settings_w - 12,
        y + 72,
        C.divider,
        1
    )

    local mode_row_y =
        y + 73

    local mode_box_w =
        math.min(
            130,
            settings_w * 0.44
        )

    local mode_box_x =
        x
        + settings_w
        - mode_box_w
        - 12

    local mode_box_y =
        mode_row_y + 8

    local mode_box_hot =
        hover(
            mx,
            my,
            mode_box_x,
            mode_box_y,
            mode_box_w,
            25
        )

    text(
        x + 13,
        mode_row_y + 14,
        "Mode",
        FALLEN_HOVER_TEXT(
            "armor_mode_label",
            row_hover(
                mx,
                my,
                x,
                mode_row_y,
                settings_w,
                41
            ),
            C.text
        )
    )

    rounded_fill(
        mode_box_x,
        mode_box_y,
        mode_box_w,
        25,
        6,
        mode_box_hot
            and { 0.110, 0.115, 0.135, 1 }
            or C.toggle_off
    )

    text(
        mode_box_x + 10,
        mode_box_y + 7,
        tostring(S.armor_esp_mode or "Normal"),
        FALLEN_HOVER_TEXT(
            "armor_mode_value",
            mode_box_hot,
            C.text
        )
    )

    text(
        mode_box_x + mode_box_w - 18,
        mode_box_y + 7,
        A.armor_mode_dropdown_open and "^" or "v",
        C.text_dim
    )

    if FALLEN_DROPDOWN_TRIGGER_ALLOWED(
            clicked,
            "armor_mode_dropdown_open"
        )
        and not popup_open
        and mode_box_hot
    then
        A.armor_mode_dropdown_open =
            not A.armor_mode_dropdown_open

        if A.armor_mode_dropdown_open then
            numeric_stop(true)
        end
    end

    local controls_clicked =
        clicked
        and not popup_open
        and not A.armor_mode_dropdown_open

    line(
        x + 12,
        y + 113,
        x + settings_w - 12,
        y + 113,
        C.divider,
        1
    )

    local old_show_weapon =
        S.armor_show_weapon == true

    toggle_row(
        mx,
        my,
        controls_clicked,
        x,
        y + 114,
        settings_w,
        "Show Weapon",
        "armor_show_weapon",
        false
    )

    if old_show_weapon
        ~= (S.armor_show_weapon == true)
    then
        FALLEN_WEAPON_ICON_CACHE = {}
        A.armor_item_cache = {}
    end

    -- Conditional On Player rows. Both fade/reveal while the lower
    -- sliders are smoothly pushed down.
    line(
        x + 12,
        y + 154,
        x + settings_w - 12,
        y + 154,
        C.divider,
        1
    )

    if onplayer_anim > 0.01 then
        local old_alpha =
            MENU_RENDER_ALPHA

        MENU_RENDER_ALPHA =
            old_alpha
            * onplayer_eased

        local can_click_extra =
            controls_clicked
            and onplayer_anim > 0.92

        local old_background =
            S.armor_onplayer_background == true

        toggle_row(
            mx,
            my,
            can_click_extra,
            x,
            y + 155,
            settings_w,
            "Background",
            "armor_onplayer_background",
            false
        )

        -- Background and Glass are alternative styles.
        if old_background
            ~= (S.armor_onplayer_background == true)
            and S.armor_onplayer_background == true
        then
            S.armor_onplayer_glass = false
        end

        line(
            x + 12,
            y + 195,
            x + settings_w - 12,
            y + 195,
            C.divider,
            1
        )

        local old_glass =
            S.armor_onplayer_glass == true

        toggle_row(
            mx,
            my,
            can_click_extra,
            x,
            y + 196,
            settings_w,
            "Glass",
            "armor_onplayer_glass",
            false
        )

        if old_glass
            ~= (S.armor_onplayer_glass == true)
            and S.armor_onplayer_glass == true
        then
            S.armor_onplayer_background = false
        end

        MENU_RENDER_ALPHA =
            old_alpha
    end

    local size_y =
        y + 155 + extra_h

    local distance_y =
        y + 196 + extra_h

    local smooth_y =
        y + 237 + extra_h

    line(
        x + 12,
        size_y - 1,
        x + settings_w - 12,
        size_y - 1,
        C.divider,
        1
    )

    slider_row(
        mx,
        my,
        controls_clicked,
        lmb,
        x,
        size_y,
        settings_w,
        "Size",
        "armor_esp_size",
        10,
        32,
        "int"
    )

    line(
        x + 12,
        distance_y - 1,
        x + settings_w - 12,
        distance_y - 1,
        C.divider,
        1
    )

    slider_row(
        mx,
        my,
        controls_clicked,
        lmb,
        x,
        distance_y,
        settings_w,
        "Max Distance",
        "armor_esp_range",
        100,
        3000,
        "int"
    )

    line(
        x + 12,
        smooth_y - 1,
        x + settings_w - 12,
        smooth_y - 1,
        C.divider,
        1
    )

    slider_row(
        mx,
        my,
        controls_clicked,
        lmb,
        x,
        smooth_y,
        settings_w,
        "Smooth",
        "armor_esp_smooth",
        0,
        50,
        "int"
    )

    local mode_dropdown_hot =
        FALLEN_DRAW_ARMOR_MODE_DROPDOWN(
            mx,
            my,
            clicked and not popup_open,
            mode_box_x,
            mode_box_y + 30,
            mode_box_w
        )

    if clicked
        and A.armor_mode_dropdown_open
        and not mode_box_hot
        and not mode_dropdown_hot
        and not popup_open
    then
        A.armor_mode_dropdown_open = false
    end

    FALLEN_DRAW_ARMOR_SETTINGS_POPUP(
        mx,
        my,
        clicked,
        lmb,
        dots_x,
        dots_y
    )

end

