        FALLEN_HOVER_TEXT("dropdown:" .. tostring(key), hot, C.text)
    )

    local bx = x + w - 142
    local by = y + 8
    local bw = 130
    rounded_fill(bx, by, bw, 25, 6, C.toggle_off)
    text(
        bx + 10,
        by + 7,
