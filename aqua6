function FALLEN_ARMOR_DRAW_PANEL_GLOW(
    x,
    y,
    w,
    h,
    radius,
    alpha_mul
)
    if S.armor_glow_enabled ~= true then
        return
    end

    local color =
        FALLEN_ARMOR_GLOW_COLOR()

    local strength =
        clamp(
            (tonumber(S.armor_glow_strength) or 100) / 100,
            0,
            2
        )

    local spread =
        clamp(
            tonumber(S.armor_glow_spread) or 14,
            2,
            35
        )

    if strength <= 0.001
        or (color[4] or 0) <= 0.001
    then
        return
    end

    -- Armor ESP is screen-space and must keep glowing when the menu is closed.
    -- UI helpers normally multiply by MENU_RENDER_ALPHA, which becomes 0.
    local old_menu_alpha =
        MENU_RENDER_ALPHA

    local old_transform =
        MENU_UI_TRANSFORM_ACTIVE

    MENU_RENDER_ALPHA = 1
    MENU_UI_TRANSFORM_ACTIVE = false

    -- Exactly 35 glow lines, just like the menu.
    for layer = 0, 34 do
        local t =
            layer / 34

        local falloff =
            1 - t

        local offset =
            t * spread

        local glow_alpha =
            0.175
            * strength
            * falloff
            * falloff
            * (color[4] or 1)
            * (alpha_mul or 1)

        FALLEN_DRAW_ROUNDED_GLOW_FRAME(
            x - offset,
            y - offset,
            w + offset * 2,
            h + offset * 2,
            radius + offset,
            {
                color[1],
                color[2],
                color[3],
                glow_alpha,
            },
            1
        )
    end

    MENU_RENDER_ALPHA = old_menu_alpha
    MENU_UI_TRANSFORM_ACTIVE = old_transform
end

function FALLEN_DRAW_ARMOR_SETTINGS_POPUP(
    mx,
    my,
    clicked,
    lmb,
    dots_x,
    dots_y
)
    local raw =
        FALLEN_ARMOR_SETTINGS_STEP()

    if raw <= 0.001
        and not A.armor_settings_open
    then
        return false
    end

    local parent_alpha =
        MENU_RENDER_ALPHA

    MENU_RENDER_ALPHA =
        parent_alpha
        * ease_out_cubic(raw)

    local anim =
        A.armor_settings_open
        and ease_out_cubic(raw)
        or ease_in_out_cubic(raw)

    local pw = 300
    local nested_glow = fallen_nested_amount(
        "armor:glow", S.armor_glow_enabled == true)
    local ph = 84 + 81 * nested_glow

    local base_px =
        dots_x - pw + 28

    local base_py =
        dots_y + 31

    -- Popup stays anchored and full-sized; only its alpha animates.
    local px = snap(base_px)
    local py = snap(base_py)
    local shell_h = ph

    local picker_active =
        A.world_color_picker_open
        and A.world_color_picker_key == "armor_glow"

    local interactive =
        raw > 0.96
        and A.armor_settings_open

    local ui_clicked =
        clicked
        and interactive
        and not picker_active

    FALLEN_POPUP_GLOW(
        px,
        py,
        pw,
        shell_h,
        11,
        1
    )

    rounded_fill(
        px,
        py,
        pw,
        shell_h,
        11,
        C.group_box_bg
    )

    text(
        px + 13,
        py + 12,
        "Armor ESP settings",
        C.text
    )

    if shell_h > 39 then
        line(
            px + 12,
            py + 34,
            px + pw - 12,
            py + 34,
            C.divider,
            1
        )
    end

    if raw > 0.001 then
        local row_x, row_w = px + 8, pw - 16
        local glow_y = py + 35
        local swatch_x = px + pw - 42
        local swatch_y = glow_y + 11
        local swatch_s = 18
        local swatch_hot = hover(mx, my,
            swatch_x, swatch_y, swatch_s, swatch_s)
        toggle_row(mx, my, ui_clicked and not swatch_hot,
            row_x, glow_y, row_w, "Glow", "armor_glow_enabled", false)
        color_preview(swatch_x, swatch_y, swatch_s,
            swatch_s, FALLEN_ARMOR_GLOW_COLOR())
        if ui_clicked and swatch_hot then
            fallen_open_color_at("armor_glow", swatch_x, swatch_y, swatch_s)
        end
        line(px + 12, glow_y + 40, px + pw - 12,
            glow_y + 40, C.divider, 1)

        local nested_row = 41 * nested_glow
        local old_alpha = MENU_RENDER_ALPHA
        if nested_glow > 0.015 then
            MENU_RENDER_ALPHA = old_alpha * fallen_nested_alpha(nested_glow)
            local can_edit = ui_clicked and nested_glow > 0.96
            slider_row(mx, my, can_edit, lmb and can_edit,
                row_x + 13, py + 76, row_w - 13,
                "Strength", "armor_glow_strength", 0, 200, "int")
            line(px + 12, py + 75 + nested_row,
                px + pw - 12, py + 75 + nested_row, C.divider, 1)
            slider_row(mx, my, can_edit, lmb and can_edit,
                row_x + 13, py + 76 + nested_row, row_w - 13,
                "Spread", "armor_glow_spread", 2, 35, "int")
            MENU_RENDER_ALPHA = old_alpha
        end
        if not S.armor_glow_enabled
            and (A.active_slider == "armor_glow_strength"
                or A.active_slider == "armor_glow_spread") then
            A.active_slider = nil
        end
    end

    local popup_hot =
        hover(
            mx,
            my,
            px,
            py,
            pw,
            shell_h
        )

    local dots_hot =
        hover(
            mx,
            my,
            dots_x,
            dots_y,
            27,
            25
        )

    -- Remains open until LMB on the same three-dots control.

    MENU_RENDER_ALPHA =
        parent_alpha

    return popup_hot
end

