        end
    end

    if Windows and Windows.IsKeyPressed then
        local ok, value =
            pcall(Windows.IsKeyPressed, 0x01)

        if ok then
            return value == true
        end
    end

    return false
end

local function rect(
    x,
    y,
    w,
    h,
    r,
    cr,
    cg,
    cb,
    ca
)
    if w <= 0 or h <= 0 then
        return
    end

    r =
        math.min(
            tonumber(r) or 0,
            w / 2,
            h / 2
        )

    if r <= 0 then
        Drawing.DrawBoxFilled(
            x,
            y,
            x + w,
            y + h,
            cr, cg, cb, ca
        )
        return
    end

    -- Fully opaque shapes can use the cheap overlap method because
    -- alpha does not accumulate into dark seams.
    if (ca or 1) >= 0.999 then
        Drawing.DrawBoxFilled(
            x + r,
            y,
            x + w - r,
            y + h,
            cr, cg, cb, ca
        )

        Drawing.DrawBoxFilled(
            x,
            y + r,
            x + w,
            y + h - r,
            cr, cg, cb, ca
        )

        Drawing.DrawCircleFilled(
            x + r,
            y + r,
            r,
            cr, cg, cb, ca
        )

        Drawing.DrawCircleFilled(
            x + w - r,
            y + r,
            r,
            cr, cg, cb, ca
        )

        Drawing.DrawCircleFilled(
            x + r,
            y + h - r,
            r,
            cr, cg, cb, ca
        )

        Drawing.DrawCircleFilled(
            x + w - r,
            y + h - r,
            r,
            cr, cg, cb, ca
        )

        return
    end

    -- Alpha-safe path.
    --
    -- The original loader made a rounded rectangle from two overlapping
    -- rectangles plus four overlapping circles. On translucent hover/glow
    -- elements those overlaps blended twice and became visible as dark/black
    -- patches where a straight edge turned into a rounded corner.
    --
    -- Here each pixel region is covered only once:
    --   center strip + side strips + four non-overlapping quarter-circle strips.
    local ri =
        math.max(
            1,
            math.floor(r + 0.5)
        )

    ri =
        math.min(
            ri,
            math.floor(w / 2),
            math.floor(h / 2)
        )

    if ri <= 0 then
        Drawing.DrawBoxFilled(
            x,
            y,
            x + w,
            y + h,
            cr, cg, cb, ca
        )
        return
    end

    Drawing.DrawBoxFilled(
        x + ri,
        y,
        x + w - ri,
        y + h,
        cr, cg, cb, ca
    )

    if h - ri * 2 > 0 then
        Drawing.DrawBoxFilled(
            x,
            y + ri,
            x + ri,
            y + h - ri,
            cr, cg, cb, ca
        )

        Drawing.DrawBoxFilled(
            x + w - ri,
            y + ri,
            x + w,
            y + h - ri,
            cr, cg, cb, ca
        )
    end

    local rr = ri * ri

    for row = 0, ri - 1 do
        local top_dy =
            (row + 0.5) - ri

        local top_dx =
            math.sqrt(
                math.max(
                    0,
                    rr - top_dy * top_dy
                )
            )

        local bottom_dy =
            row + 0.5

        local bottom_dx =
            math.sqrt(
                math.max(
                    0,
                    rr - bottom_dy * bottom_dy
                )
            )

        if top_dx > 0 then
            Drawing.DrawBoxFilled(
                x + ri - top_dx,
                y + row,
                x + ri,
                y + row + 1,
                cr, cg, cb, ca
            )

            Drawing.DrawBoxFilled(
                x + w - ri,
                y + row,
                x + w - ri + top_dx,
                y + row + 1,
                cr, cg, cb, ca
            )
        end

        if bottom_dx > 0 then
            local by =
                y + h - ri + row

            Drawing.DrawBoxFilled(
                x + ri - bottom_dx,
                by,
                x + ri,
                by + 1,
                cr, cg, cb, ca
            )

            Drawing.DrawBoxFilled(
                x + w - ri,
                by,
                x + w - ri + bottom_dx,
                by + 1,
                cr, cg, cb, ca
            )
        end
    end
end

local function bordered_rect(
    x,
    y,
    w,
    h,
    r,
    br,
    bg,
    bb,
    ba,
    cr,
    cg,
    cb,
    ca
)
    rect(
        x,
        y,
        w,
        h,
        r,
        br,
        bg,
        bb,
        ba
    )

    rect(
        x + 1,
        y + 1,
        w - 2,
        h - 2,
        math.max(r - 1, 1),
        cr,
        cg,
        cb,
        ca
    )
end

local function draw_image(
    image,
    x,
    y,
    w,
    h,
    alpha,
    rounding
)
    local target = image

    if target
        and Drawing.IsImageFailed
        and Drawing.IsImageFailed(target)
    then
        target = nil
    end

    if target
        and Drawing.IsImageReady(target) then

        Drawing.DrawImage(
            target,
            x,
            y,
            w,
            h,
            1,
            1,
            1,
            alpha,
            rounding or 6
        )
        return true
    end

    return false
end

local function refresh_local_profile()
    if tick() - profile_last_scan < 0.75 then
        return
    end

    profile_last_scan = tick()

    if not rbx or type(rbx.local_player) ~= "function" then
        return
    end

    local ok, player =
        pcall(rbx.local_player)

    if not ok or not player then
        return
    end

    local ok_name, name =
        pcall(function()
            return player:get_name()
        end)

    if ok_name
        and type(name) == "string"
        and name ~= "" then

        profile_name = name
    end

    local ok_id, uid =
        pcall(function()
            return player:user_id()
        end)

    if ok_id then
        uid = tonumber(uid)

        if uid and uid > 0 then
            profile_user_id = uid
        end
    end
end

local function fetch_profile_avatar()
    if profile_avatar
        or profile_avatar_failed
    then
        return
    end

    local custom =
        FALLEN_CUSTOM_AVATAR_LOAD()

    if custom then
        profile_avatar = custom
        return
    end

    if not profile_user_id then
        return
    end

    if not Http
        or type(Http.roblox_avatar_headshot_url) ~= "function"
        or type(Http.get) ~= "function"
        or not Json
        or type(Json.decode) ~= "function"
        or type(Drawing.LoadImage) ~= "function" then

        profile_avatar_failed = true
        return
    end

    local ok, err =
        pcall(function()
            local meta_url =
                Http.roblox_avatar_headshot_url(
                    profile_user_id,
                    "150x150",
                    "Png",
                    false
                )

            local http_ok, status, body =
                Http.get(
                    meta_url,
                    { timeout_ms = 7000 }
                )

            if not http_ok
                or status ~= 200 then

                error(
                    "avatar HTTP "
                    .. tostring(status)
                )
            end

            local decoded, json_err =
                Json.decode(body)

            if not decoded then
                error(
                    json_err
                    or "avatar JSON decode failed"
                )
            end

            local row =
                decoded.data
                and decoded.data[1]

            local image_url =
                row
                and row.imageUrl

            if type(image_url) ~= "string"
                or image_url == "" then

                error(
                    "avatar imageUrl missing"
                )
            end

            profile_avatar =
                Drawing.LoadImage(
                    image_url
                )

            if not profile_avatar then
                error(
                    "avatar LoadImage failed"
                )
            end
        end)

    if not ok then
        profile_avatar_failed = true
        warn(
            "[Fallen loader] "
            .. tostring(err)
        )
    end
end

local function ensure_profile_avatar()
    if profile_avatar
        or profile_avatar_failed
        or profile_avatar_started
    then
        return
    end

    profile_avatar_started = true

    local create =
        thread
        and (
            thread.create
            or thread.Create
        )

    local stop =
        thread
        and (
            thread.stop
            or thread.Stop
        )

    if type(create) ~= "function" then
        -- Old API build fallback. This is a single request only.
        fetch_profile_avatar()
        return
    end

    local worker_id = nil

    local function worker()
        if not profile_avatar
            and not profile_avatar_failed then

            fetch_profile_avatar()
        end

        if (
            profile_avatar
            or profile_avatar_failed
        )
            and worker_id
            and type(stop) == "function"
        then
            pcall(
                stop,
                worker_id
            )
        end
    end

    local ok, id =
        pcall(
            create,
            worker,
            250
        )

    if ok and id then
        worker_id = id
        profile_worker_id = id
    else
        -- Thread startup failed: do the one request directly.
        fetch_profile_avatar()
    end
end

local function update_profile()
    refresh_local_profile()
    ensure_profile_avatar()
end

local function draw_avatar(
    x,
    y,
    size,
    alpha,
    fallback_scale
)
    if profile_avatar
        and Drawing.IsImageReady(
            profile_avatar
        )
    then
        Drawing.DrawImage(
            profile_avatar,
            x,
            y,
            size,
            size,
            1, 1, 1,
            alpha,
            size / 2
        )

        return
    end

    if profile_avatar
        and Drawing.IsImageFailed
        and Drawing.IsImageFailed(
            profile_avatar
        )
    then
        profile_avatar_failed = true
    end

    Drawing.DrawCircleFilled(
        x + size / 2,
        y + size / 2,
        size / 2,
        0.10,
        0.10,
        0.12,
        alpha
    )

    local first =
        string.sub(
            profile_name or "F",
            1,
            1
        )

    if first == "" then
        first = "F"
    end

    Drawing.DrawTextWithOutline(
        x + size / 2,
        y + size * (fallback_scale or 0.28),
        string.upper(first),
        0.84,
        0.84,
        0.87,
        alpha,
        0, 0, 0,
        alpha
    )
end

hooks.on_render(function()
    if hidden then
        return
    end

    local now = tick()
    local dt = now - last_time
    last_time = now

    if dt < 0 then
        dt = 0
    end

    if dt > 0.05 then
        dt = 0.05
    end

    open_anim =
        chase(
            open_anim,
            open_target,
            9,
            dt
        )
    details_transition =
        chase(
            details_transition,
            details and 1 or 0,
            11,
            dt
        )

    profile_anim =
        chase(
            profile_anim,
            profile_open and 1 or 0,
            12,
            dt
        )

    if open_target == 0
        and open_anim < 0.015 then

        hidden = true

        if _G.FallenSurvivalLoaded == true then
            _G.FallenLua_Menu =
                _G.FallenLua_Menu or {}

            _G.FallenLua_Menu.visible = true
            _G.FallenMenuReady = true
        end

        return
    end

    local screen = ScreenSize()

    if not screen then
        return
    end

    local sw = screen.Width
    local sh = screen.Height

    local mx, my = mouse_pos()

    local lmb = lmb_down()

    local click =
        lmb and not last_lmb

    last_lmb = lmb

    local scale =
        0.90 +
        open_anim * 0.10

    local alpha = open_anim

    local w = 520 * scale
    local h = 330 * scale

    if loader_cx == nil then
        loader_cx = sw * 0.5
        loader_cy = sh * 0.5
        loader_target_cx = loader_cx
        loader_target_cy = loader_cy
    end

    local x =
        loader_cx -
        w / 2

    local y =
        loader_cy -
        h / 2

    -- Grab the top edge of the loader and drag it smoothly.
    -- Close button remains clickable because the right-most area is excluded.
    local loader_drag_hot =
        inside(
            mx, my,
            x + 8 * scale,
            y + 2 * scale,
            w - 50 * scale,
            24 * scale
        )

    if click and loader_drag_hot and not loading then
        loader_dragging = true
        loader_drag_off_x = mx - loader_cx
        loader_drag_off_y = my - loader_cy
    end

    if loader_dragging and lmb and not loading then
        loader_target_cx =
            clamp(
                mx - loader_drag_off_x,
                w * 0.5 + 4,
                sw - w * 0.5 - 4
            )

        loader_target_cy =
            clamp(
                my - loader_drag_off_y,
                h * 0.5 + 4,
                sh - h * 0.5 - 4
            )
    end

    if not lmb then
        loader_dragging = false
    end

    loader_cx =
        chase(
            loader_cx,
            loader_target_cx,
            loader_dragging and 18 or 12,
            dt
        )

    loader_cy =
        chase(
            loader_cy,
            loader_target_cy,
            loader_dragging and 18 or 12,
            dt
        )

    x =
        loader_cx -
        w / 2

    y =
        loader_cy -
        h / 2

    -- Snap the loader root to integer pixels so text/button edges are sharper.
    x = snap(x)
    y = snap(y)
    w = snap(w)
    h = snap(h)

    local side_w =
        124 * scale

    for i = 1, 4 do
        local grow =
            i * 3 * scale

        rect(
            x - grow,
            y - grow + 4 * scale,
            w + grow * 2,
            h + grow * 2,
            11 * scale,
            0,
            0,
            0,
            alpha * (0.05 / i)
        )
    end

    bordered_rect(
        x,
        y,
        w,
        h,
        10 * scale,

        0.15,
        0.15,
        0.17,
        alpha,

        0.025,
        0.026,
        0.030,
        alpha
    )

    rect(
        x + 1,
        y + 1,
        side_w,
        h - 2,
        9 * scale,
        0.020,
        0.021,
        0.025,
        alpha
    )

    Drawing.DrawLine(
        x + side_w,
        y + 10 * scale,
        x + side_w,
        y + h - 10 * scale,
        0.11,
        0.11,
        0.13,
        alpha,
        1
    )

    -- Clean loader header: no image here.
