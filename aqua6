function FALLEN_SILENT_NORMALIZE_KEY(
    value
)
    local out =
        string.lower(
            tostring(
                value
                or ""
            )
        )

    return string.gsub(
        out,
        "[^%w]",
        ""
    )
end


function FALLEN_SILENT_LIVE_SECTION()
    if not cheat then
        return nil
    end

    return cheat.silent_aim
end


function FALLEN_SILENT_SECTION_KEYS()
    local sa =
        FALLEN_SILENT_LIVE_SECTION()

    if not sa
        or type(sa._keys) ~= "function"
    then
        return nil
    end

    local ok, keys =
        pcall(function()
            return sa:_keys()
        end)

    if ok
        and type(keys) == "table"
    then
        return keys
    end

    return nil
end


function FALLEN_SILENT_KEY_TYPE(
