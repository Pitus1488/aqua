            4,
            4,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            1,
            1,
            1,
            alpha * 0.96 * fade,
            s * 0.18
        )

    elseif kind == 6 then
        local handle = FALLEN_HITFX_IMAGE(
