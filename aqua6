function FALLEN_WORLD_WEATHER_POPUP_STEP(kind)
    local is_rain = kind == "rain"

    -- Rain and Thunder use fully independent open/animation state.
    local open = false
    local last_t = nil

    if is_rain then
        open = A.world_rain_settings_open == true
        last_t = A.world_rain_settings_last_t
    else
        open = A.world_thunder_settings_open == true
        last_t = A.world_thunder_settings_last_t
    end

    local now_t = tick()

    if last_t == nil then
        last_t = now_t
    end

    local dt = clamp(now_t - last_t, 0, 0.05)

    if is_rain then
        A.world_rain_settings_last_t = now_t
    else
        A.world_thunder_settings_last_t = now_t
    end

    local current = 0

    if is_rain then
        current = tonumber(A.world_rain_settings_anim) or 0
    else
        current = tonumber(A.world_thunder_settings_anim) or 0
    end

    local target = open and 1 or 0
    local speed =
        target > current
        and 15
        or 11

    current =
        exp_chase(
            current,
            target,
            speed,
            dt
        )

    if target == 0 and current < 0.028 then
        current = 0
    elseif target == 1 and current > 0.992 then
        current = 1
    end

    if is_rain then
        A.world_rain_settings_anim = current
    else
        A.world_thunder_settings_anim = current
    end

    return clamp(current, 0, 1)
end


