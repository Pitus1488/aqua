    end

    local ok, value =
        pcall(function()
            return sa:_type(key)
        end)

    if ok then
        return tostring(
            value
            or ""
        )
    end

    return nil
end


function FALLEN_SILENT_FIND_LIVE_KEY(
    purpose
)
    A.silent_live_keys =
        A.silent_live_keys
        or {}

    local cached =
        A.silent_live_keys[purpose]

    if cached then
        return cached
    end

    local keys =
        FALLEN_SILENT_SECTION_KEYS()

    local wanted = nil

    if purpose == "sticky" then
        wanted = {
            "sticky_aim",
            "stickyaim",
            "sticky",
            "sticky_target",
            "stickytarget",
            "target_lock",
            "targetlock",
            "lock_target",
            "locktarget",
        }
    elseif purpose == "max_distance" then
        wanted = {
            "max_distance",
            "maxdistance",
            "max_dist",
            "maxdist",
            "target_distance",
            "targetdistance",
            "distance",
            "max_range",
            "maxrange",
            "range",
        }
    elseif purpose == "team_check" then
        wanted = {
            "team_check",
            "teamcheck",
        }
    elseif purpose == "target_part" then
        wanted = {
            "target_part",
            "targetpart",
            "hit_part",
            "hitpart",
        }
    elseif purpose == "magic_bullet" then
        wanted = {
            "magic_bullet",
            "magicbullet",
        }
    elseif purpose == "enabled" then
        wanted = {
            "enabled",
        }
    elseif purpose == "key" then
        wanted = {
            "key",
            "aim_key",
            "aimkey",
            "silent_key",
            "silentkey",
            "hotkey",
            "bind",
            "keybind",
        }
    elseif purpose == "key_mode" then
        wanted = {
            "key_mode",
            "keymode",
            "bind_mode",
            "bindmode",
        }
    elseif purpose == "fov" then
        wanted = {
            "fov",
            "fov_size",
            "fovsize",
        }
    elseif purpose == "fov_only" then
        wanted = {
            "fov_enabled",
            "fovenabled",
            "enabled_fov",
            "enabledfov",
            "fov_only",
            "fovonly",
            "use_fov",
            "usefov",
            "fov_check",
            "fovcheck",
            "check_fov",
            "checkfov",
            "limit_fov",
            "limitfov",
            "fov_limit",
            "fovlimit",
        }
    end

    if type(wanted) ~= "table" then
        return nil
    end

    -- _keys() is the preferred source of truth. If this build does not
    -- expose it for some reason, fall back to the documented/common field
    -- names and let the protected assignment decide whether the field exists.
    if type(keys) ~= "table" then
        if purpose == "enabled" then
            return "enabled"
        elseif purpose == "team_check" then
            return "team_check"
        elseif purpose == "target_part" then
            return "target_part"
        elseif purpose == "magic_bullet" then
            return "magic_bullet"
        elseif purpose == "sticky" then
            return "sticky_aim"
        elseif purpose == "max_distance" then
            return "max_distance"
        elseif purpose == "key" then
            return "key"
        elseif purpose == "key_mode" then
            return "key_mode"
        elseif purpose == "fov" then
            return "fov"
        elseif purpose == "fov_only" then
            local sa =
                FALLEN_SILENT_LIVE_SECTION()

            if sa then
                local probes = {
                    "fov_enabled",
                    "fov_only",
                    "use_fov",
                    "fov_check",
                    "fov_limit",
                }

                for _, probe in ipairs(probes) do
                    local ok_probe, probe_value =
                        pcall(function()
                            return sa[probe]
                        end)

                    if ok_probe
                        and type(probe_value) == "boolean"
                    then
                        return probe
                    end
                end
            end

            return nil
        end

        return nil
    end

    -- Exact/alias pass first.
    for _, candidate in ipairs(wanted) do
        local cn =
            FALLEN_SILENT_NORMALIZE_KEY(
                candidate
            )

        for _, key in ipairs(keys) do
            local kn =
                FALLEN_SILENT_NORMALIZE_KEY(
                    key
                )

            if kn == cn then
                A.silent_live_keys[purpose] =
                    tostring(key)

                return tostring(key)
            end
        end
    end

    -- Semantic fallback, still constrained to real keys from _keys().
    for _, key in ipairs(keys) do
        local raw =
            tostring(key)

        local kn =
            FALLEN_SILENT_NORMALIZE_KEY(
                raw
            )

        local match = false

        if purpose == "sticky" then
            match =
                string.find(
                    kn,
                    "sticky",
                    1,
                    true
                ) ~= nil
                or (
                    string.find(
                        kn,
                        "target",
                        1,
                        true
                    )
                    and string.find(
                        kn,
                        "lock",
                        1,
                        true
                    )
                )
        elseif purpose == "max_distance" then
            match =
                (
                    string.find(
                        kn,
                        "max",
                        1,
                        true
                    )
                    and (
                        string.find(
                            kn,
                            "dist",
                            1,
                            true
                        )
                        or string.find(
                            kn,
                            "range",
                            1,
                            true
                        )
                    )
                )
                or kn == "distance"
                or kn == "range"
        elseif purpose == "fov_only" then
            local has_fov =
                string.find(
                    kn,
                    "fov",
                    1,
                    true
                ) ~= nil

            local has_toggle_word =
                string.find(
                    kn,
                    "enable",
                    1,
                    true
                ) ~= nil
                or string.find(
                    kn,
                    "only",
                    1,
                    true
                ) ~= nil
                or string.find(
                    kn,
                    "use",
                    1,
                    true
                ) ~= nil
                or string.find(
                    kn,
                    "check",
                    1,
                    true
                ) ~= nil
                or string.find(
                    kn,
                    "limit",
                    1,
                    true
                ) ~= nil

            match =
                has_fov
                and has_toggle_word
        end

        if match then
            local field_type =
                FALLEN_SILENT_KEY_TYPE(
                    raw
                )

            if purpose == "sticky" then
                if field_type == nil
                    or field_type == ""
                    or field_type == "bool"
                then
                    A.silent_live_keys[purpose] =
                        raw

                    return raw
                end
            elseif purpose == "max_distance" then
                if field_type == nil
                    or field_type == ""
                    or field_type == "int"
                    or field_type == "float"
                then
                    A.silent_live_keys[purpose] =
                        raw

                    return raw
                end
            elseif purpose == "fov_only" then
                if field_type == nil
                    or field_type == ""
                    or field_type == "bool"
                then
                    A.silent_live_keys[purpose] =
                        raw

                    return raw
                end
            end
        end
    end

    return nil
end


function FALLEN_SILENT_READ_FIELD(
    purpose
)
    local sa =
        FALLEN_SILENT_LIVE_SECTION()

    if not sa then
        return nil
    end

    local key =
        FALLEN_SILENT_FIND_LIVE_KEY(
            purpose
        )

    if not key then
        return nil
    end

    local ok, value =
        pcall(function()
            return sa[key]
        end)

    if ok then
        return value
    end

    return nil
end


function FALLEN_SILENT_WRITE_FIELD(
    purpose,
    value
)
    local sa =
        FALLEN_SILENT_LIVE_SECTION()

    if not sa then
        return false
    end

    local key =
        FALLEN_SILENT_FIND_LIVE_KEY(
            purpose
        )

    if not key then
        return false
    end

    local ok =
        pcall(function()
            sa[key] =
                value
        end)

    return ok == true
end


function FALLEN_SILENT_CLEAR_TOGGLE_LATCH()
    if not cheat
        or not cheat.keybinds
    then
        return
    end

    local kb =
        cheat.keybinds

    if type(kb._keys) == "function" then
        local ok, keys =
            pcall(function()
                return kb:_keys()
            end)

        if ok
            and type(keys) == "table"
        then
            for _, raw_key in ipairs(keys) do
                local raw =
                    tostring(raw_key)

                local normalized =
                    FALLEN_SILENT_NORMALIZE_KEY(
                        raw
                    )

                local is_silent =
                    string.find(
                        normalized,
                        "silent",
                        1,
                        true
                    ) ~= nil

                local is_latch =
                    string.find(
                        normalized,
                        "toggled",
                        1,
                        true
                    ) ~= nil
                    or string.find(
                        normalized,
                        "active",
                        1,
                        true
                    ) ~= nil

                if is_silent
                    and is_latch
                then
                    pcall(function()
                        kb[raw] =
                            false
                    end)
                end
            end
        end
    end

    -- Common fallbacks in case this build omits _keys().
    pcall(function()
        kb.silent_aim_toggled =
            false
    end)

    pcall(function()
        kb.silent_toggled =
            false
    end)

    pcall(function()
        kb.silent_aim_active =
            false
    end)

    pcall(function()
        kb.silent_active =
            false
    end)
end


function FALLEN_SILENT_FORCE_HOLD()
    -- key_mode 0 = HOLD. Never allow Silent to remain in toggle mode.
    FALLEN_SILENT_WRITE_FIELD(
        "key_mode",
        0
    )

    FALLEN_SILENT_CLEAR_TOGGLE_LATCH()
end


function FALLEN_SILENT_SET_ENABLED(
    value
)
    value =
        value == true

    S.silent_enabled =
        value

    local sa =
        FALLEN_SILENT_SECTION()

    if not sa then
        return
    end

    -- Make sure the selected bind is present before touching the master.
    FALLEN_SILENT_SET_KEY(
        S.silent_key
    )

    FALLEN_SILENT_FORCE_HOLD()

    -- THIS is the real stock feature master.
    if cheat
        and type(cheat.enable) == "function"
    then
        pcall(function()
            cheat.enable(
                "silent_aim",
                value
            )
        end)
    end

    -- cheat.enable can alter keybind state; restore the known-good HOLD setup
    -- immediately after changing the master.
    FALLEN_SILENT_SET_KEY(
        S.silent_key
    )

    FALLEN_SILENT_FORCE_HOLD()

    FALLEN_SILENT_WRITE_FIELD(
        "enabled",
        value
    )

    FALLEN_SILENT_WRITE_FIELD(
        "method",
        2
    )

    FALLEN_SILENT_CLEAR_TOGGLE_LATCH()

    A.silent_api_last_enabled =
        value
end


function FALLEN_SILENT_SET_MAGIC_BULLET(
