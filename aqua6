local function rgb_hex(r, g, b)
    local rr = math.floor(clamp(r, 0, 1) * 255 + 0.5)
    local gg = math.floor(clamp(g, 0, 1) * 255 + 0.5)
    local bb = math.floor(clamp(b, 0, 1) * 255 + 0.5)

    return string.format("#%02X%02X%02X", rr, gg, bb)
end

function FALLEN_RGBA_HEX(r, g, b, a)
    local rr = math.floor(clamp(r, 0, 1) * 255 + 0.5)
    local gg = math.floor(clamp(g, 0, 1) * 255 + 0.5)
    local bb = math.floor(clamp(b, 0, 1) * 255 + 0.5)
    local aa = math.floor(clamp(a or 1, 0, 1) * 255 + 0.5)

    return string.format("#%02X%02X%02X%02X", rr, gg, bb, aa)
end


function FALLEN_RGB_TO_HSV(r, g, b)
    r = clamp(tonumber(r) or 0, 0, 1)
    g = clamp(tonumber(g) or 0, 0, 1)
    b = clamp(tonumber(b) or 0, 0, 1)

    local maxv = math.max(r, g, b)
    local minv = math.min(r, g, b)
    local d = maxv - minv

    local h = 0
    local s =
        maxv <= 0
        and 0
        or (d / maxv)

    if d > 0 then
        if maxv == r then
            h = ((g - b) / d) % 6
        elseif maxv == g then
            h = ((b - r) / d) + 2
        else
            h = ((r - g) / d) + 4
        end

        h = h / 6
    end

    return h % 1, s, maxv
end

function FALLEN_COLOR_INPUT_IS(kind, prefix)
    local ci = A.color_input

    return
        ci.focus == true
        and ci.kind == kind
        and ci.prefix == prefix
end

function FALLEN_COLOR_INPUT_EDGE(vk)
    local ci = A.color_input
    local down = key_down(vk)
    local old = ci.prev[vk] == true
    ci.prev[vk] = down
    return down and not old
end

function FALLEN_COLOR_INPUT_APPLY()
    local ci = A.color_input

    if not ci.focus
        or not ci.prefix
        or not ci.kind
    then
        return
    end

    if ci.kind == "hex" then
        local raw =
            string.upper(
                tostring(ci.buffer or "")
            )

        raw =
            string.gsub(
                raw,
                "[^0-9A-F]",
                ""
            )

        -- New format: RRGGBBAA.
        -- The final AA byte controls transparency.
        if #raw ~= 8 then
            return
        end

        local rr =
            tonumber(
                string.sub(raw, 1, 2),
                16
            )

        local gg =
            tonumber(
                string.sub(raw, 3, 4),
                16
            )

        local bb =
            tonumber(
                string.sub(raw, 5, 6),
                16
            )

        local aa =
            tonumber(
                string.sub(raw, 7, 8),
                16
            )

        if rr == nil
            or gg == nil
            or bb == nil
            or aa == nil
        then
            return
        end

        local h, s, v =
            FALLEN_RGB_TO_HSV(
                rr / 255,
                gg / 255,
                bb / 255
            )

        S[ci.prefix .. "_h"] = h
        S[ci.prefix .. "_s"] = s
        S[ci.prefix .. "_v"] = v

        S[ci.prefix .. "_alpha"] =
            math.floor(
                clamp(
                    (aa / 255) * 100,
                    0,
                    100
                )
                + 0.5
            )
    end
end

function FALLEN_COLOR_INPUT_STOP(accept)
    local ci = A.color_input

    if ci.focus
        and accept == false
        and ci.prefix
    then
        S[ci.prefix .. "_h"] =
            ci.original_h

        S[ci.prefix .. "_s"] =
            ci.original_s

        S[ci.prefix .. "_v"] =
            ci.original_v

        S[ci.prefix .. "_alpha"] =
            ci.original_alpha
    elseif ci.focus
        and accept ~= false
    then
        FALLEN_COLOR_INPUT_APPLY()
    end

    ci.focus = false
    ci.kind = nil
    ci.prefix = nil
    ci.buffer = ""
    ci.replace_on_type = false
    ci.prev = {}
end

function FALLEN_COLOR_INPUT_START(kind, prefix)
    local ci = A.color_input

    FALLEN_COLOR_INPUT_STOP(true)

    ci.focus = true
    ci.kind = kind
    ci.prefix = prefix
    ci.replace_on_type = true
    ci.prev = {}

    ci.original_h =
        tonumber(
            S[prefix .. "_h"]
        )
        or 0

    ci.original_s =
        tonumber(
            S[prefix .. "_s"]
        )
        or 0

    ci.original_v =
        tonumber(
            S[prefix .. "_v"]
        )
        or 1

    ci.original_alpha =
        tonumber(
            S[prefix .. "_alpha"]
        )
        or 100

    local r, g, b =
        hsv_to_rgb(
            ci.original_h,
            ci.original_s,
            ci.original_v
        )

    ci.buffer =
        string.sub(
            FALLEN_RGBA_HEX(
                r,
                g,
                b,
                clamp(
                    ci.original_alpha / 100,
                    0,
                    1
                )
            ),
            2
        )

    numeric_stop(true)

    if A.config_input_focus
        and FALLEN_CONFIGS
        and FALLEN_CONFIGS.input_focus
    then
        FALLEN_CONFIGS.input_focus(false)
    end
end

function FALLEN_COLOR_INPUT_POLL()
    local ci = A.color_input

    if not ci.focus then
        return
    end

    if FALLEN_COLOR_INPUT_EDGE(0x0D) then
        FALLEN_COLOR_INPUT_STOP(true)
        return
    end

    if FALLEN_COLOR_INPUT_EDGE(0x1B) then
        FALLEN_COLOR_INPUT_STOP(false)
        return
    end

    -- Ctrl+V paste for the custom HEX8 field.
    -- This is a Drawing-based input, not a native Windows textbox,
    -- so clipboard paste has to be handled explicitly.
    local ctrl_down =
        key_down(0x11)
        or key_down(0xA2)
        or key_down(0xA3)

    if ci.kind == "hex"
        and ctrl_down
        and FALLEN_COLOR_INPUT_EDGE(0x56)
    then
        local clip = ""

        if type(get_clipboard) == "function" then
            local ok, value =
                pcall(
                    get_clipboard
                )

            if ok and value ~= nil then
                clip =
                    tostring(value)
            end
        end

        local raw =
            string.upper(
                clip
            )

        raw =
            string.gsub(
                raw,
                "[^0-9A-F]",
                ""
            )

        -- Accept both ordinary RGB HEX and the new RGBA HEX8 format.
        -- RGB input gets FF alpha automatically.
        if #raw == 6 then
            raw =
                raw
                .. "FF"
        elseif #raw > 8 then
            raw =
                string.sub(
                    raw,
                    1,
                    8
                )
        end

        if #raw == 8 then
            ci.buffer = raw
            ci.replace_on_type = false
            FALLEN_COLOR_INPUT_APPLY()
        end

        return
    end

    if FALLEN_COLOR_INPUT_EDGE(0x08) then
        ci.replace_on_type = false

        ci.buffer =
            string.sub(
                ci.buffer or "",
                1,
                math.max(
                    0,
                    #(ci.buffer or "") - 1
                )
            )

        FALLEN_COLOR_INPUT_APPLY()
        return
    end

    if ci.kind ~= "hex" then
        return
    end

    for digit = 0, 9 do
        if FALLEN_COLOR_INPUT_EDGE(0x30 + digit)
            or FALLEN_COLOR_INPUT_EDGE(0x60 + digit)
        then
            if ci.replace_on_type then
                ci.buffer = ""
                ci.replace_on_type = false
            end

            if #ci.buffer < 8 then
                ci.buffer =
                    ci.buffer
                    .. tostring(digit)
            end

            FALLEN_COLOR_INPUT_APPLY()
            return
        end
    end

    for vk = 0x41, 0x46 do
        if FALLEN_COLOR_INPUT_EDGE(vk) then
            if ci.replace_on_type then
                ci.buffer = ""
                ci.replace_on_type = false
            end

            if #ci.buffer < 8 then
                ci.buffer =
                    ci.buffer
                    .. string.char(vk)
            end

            FALLEN_COLOR_INPUT_APPLY()
            return
        end
    end
end

local function color_preview(x, y, w, h, override_color)
    local c =
        override_color
        or fov_color()

    local radius =
        math.floor(
            math.min(w, h)
            * 0.28
        )

    -- Dark rounded base so alpha still has a visible background,
    -- but without the hard checker-square look on the tiny swatch.
    rounded_fill(
        x,
        y,
        w,
        h,
        radius,
        { 0.22, 0.23, 0.27, 1 }
    )

    rounded_fill(
        x,
        y,
        w,
        h,
        radius,
        { c[1], c[2], c[3], c[4] }
    )

    rounded_outline(
        x,
        y,
        w,
        h,
        radius,
        C.border,
        1,
        { c[1], c[2], c[3], math.max(c[4], 0.01) }
    )
end


local function checker_strip(x, y, w, h)
    local cell = 7
    local cols = math.ceil(w / cell)
    local rows = math.ceil(h / cell)

    for yy = 0, rows - 1 do
        for xx = 0, cols - 1 do
            local light = ((xx + yy) % 2 == 0)
            local v = light and 0.64 or 0.38

            fill(
                x + xx * cell,
                y + yy * cell,
                math.min(cell, w - xx * cell),
                math.min(cell, h - yy * cell),
                { v, v, v, 1 }
            )
        end
    end
end

local function draw_fov_color_picker(mx, my, clicked, lmb, anchor_x, anchor_y)

    if not A.fov_picker_open then
        A.fov_picker_drag = nil
        return
    end

    local pw = 264
    local ph = 342
    local px = anchor_x - pw + 34
    local py = anchor_y + 27

    FALLEN_POPUP_GLOW(px, py, pw, ph, 12, 1)

    rounded_fill(
        px,
        py,
        pw,
        ph,
        12,
        { 0.070, 0.073, 0.085, 1 }
    )

    text(
        px + 14,
        py + 10,
        "Color",
        C.text_dim
    )

    local pad = 14
    local sv_x = px + pad
    local sv_y = py + pad + 20
    local sv_w = pw - pad * 2
    local sv_h = 188

    local hue =
        tonumber(S.aim_fov_h)
        or 0

    local smooth_w =
        math.max(
            1,
            math.floor(sv_w + 0.5)
        )

    local smooth_h =
        math.max(
            1,
            math.floor(sv_h + 0.5)
        )

    -- Smooth saturation/value field.
    for xx = 0, smooth_w - 1 do
        local sat =
            smooth_w > 1
            and (xx / (smooth_w - 1))
            or 0

        local r, g, b =
            hsv_to_rgb(
                hue,
                sat,
                1
            )

        fill(
            sv_x + xx,
            sv_y,
            1,
            smooth_h,
            { r, g, b, 1 }
        )
    end

    for yy = 0, smooth_h - 1 do
        local black_alpha =
            smooth_h > 1
            and (yy / (smooth_h - 1))
            or 0

        if black_alpha > 0 then
            fill(
                sv_x,
                sv_y + yy,
                smooth_w,
                1,
                { 0, 0, 0, black_alpha }
            )
        end
    end

    local sv_hot =
        hover(
            mx,
            my,
            sv_x,
            sv_y,
            sv_w,
            sv_h
        )

    if clicked and sv_hot then
        FALLEN_COLOR_INPUT_STOP(true)
        A.fov_picker_drag = "sv"
    end

    if A.fov_picker_drag == "sv"
        and lmb
    then
        S.aim_fov_s =
            clamp(
                (mx - FALLEN_UI_X(sv_x)) / FALLEN_UI_LEN(sv_w),
                0,
                1
            )

        S.aim_fov_v =
            1
            - clamp(
                (my - FALLEN_UI_Y(sv_y)) / FALLEN_UI_LEN(sv_h),
                0,
                1
            )
    end

    local cursor_x =
        sv_x
        + clamp(
            tonumber(S.aim_fov_s) or 0,
            0,
            1
        )
        * sv_w

    local cursor_y =
        sv_y
        + (
            1
            - clamp(
                tonumber(S.aim_fov_v) or 1,
                0,
                1
            )
        )
        * sv_h

    circle_fill(
        cursor_x,
        cursor_y,
        7,
        { 0.05, 0.05, 0.06, 1 }
    )

    circle(
        cursor_x,
        cursor_y,
        7,
        { 1, 1, 1, 1 },
        2
    )

    -- Hue bar.
    local hue_y =
        sv_y
        + sv_h
        + 13

    local hue_h = 14

    local hue_width =
        math.max(
            1,
            math.floor(sv_w + 0.5)
        )

    for xx = 0, hue_width - 1 do
        local h0 =
            hue_width > 1
            and (xx / (hue_width - 1))
            or 0

        local r, g, b =
            hsv_to_rgb(
                h0,
                1,
                1
            )

        fill(
            sv_x + xx,
            hue_y,
            1,
            hue_h,
            { r, g, b, 1 }
        )
    end

    local hue_hot =
        hover(
            mx,
            my,
            sv_x,
            hue_y,
            sv_w,
            hue_h
        )

    if clicked and hue_hot then
        FALLEN_COLOR_INPUT_STOP(true)
        A.fov_picker_drag = "hue"
    end

    if A.fov_picker_drag == "hue"
        and lmb
    then
        S.aim_fov_h =
            clamp(
                (mx - FALLEN_UI_X(sv_x)) / FALLEN_UI_LEN(sv_w),
                0,
                1
            )
    end

    local hue_x =
        sv_x
        + clamp(
            tonumber(S.aim_fov_h) or 0,
            0,
            1
        )
        * sv_w

    rounded_fill(
        hue_x - 3,
        hue_y - 3,
        6,
        hue_h + 6,
        3,
        { 1, 1, 1, 1 }
    )

    rounded_fill(
        hue_x - 1,
        hue_y - 1,
        2,
        hue_h + 2,
        1,
        { 0.12, 0.12, 0.14, 1 }
    )

    -- Transparency slider restored.
    -- Alpha is ALSO mirrored in the last two HEX8 chars.
    local alpha_y =
        hue_y + 29

    local alpha_h = 14

    checker_strip(
        sv_x,
        alpha_y,
        sv_w,
        alpha_h
    )

    local c =
        fov_color()

    local alpha_width =
        math.max(
            1,
            math.floor(sv_w + 0.5)
        )

    for xx = 0, alpha_width - 1 do
        local a =
            alpha_width > 1
            and (xx / (alpha_width - 1))
            or 0

        fill(
            sv_x + xx,
            alpha_y,
            1,
            alpha_h,
            {
                c[1],
                c[2],
                c[3],
                a,
            }
        )
    end

    local alpha_hot =
        hover(
            mx,
            my,
            sv_x,
            alpha_y,
            sv_w,
            alpha_h
        )

    if clicked and alpha_hot then
        FALLEN_COLOR_INPUT_STOP(true)
        A.fov_picker_drag = "alpha"
    end

    if A.fov_picker_drag == "alpha"
        and lmb
    then
        S.aim_fov_alpha =
            math.floor(
                clamp(
                    (mx - FALLEN_UI_X(sv_x)) / FALLEN_UI_LEN(sv_w),
                    0,
                    1
                )
                * 100
                + 0.5
            )
    end

    local alpha_x =
        sv_x
        + clamp(
            (tonumber(S.aim_fov_alpha) or 100) / 100,
            0,
            1
        )
        * sv_w

    circle_fill(
        alpha_x,
        alpha_y + alpha_h * 0.5,
        8,
        { 0.06, 0.06, 0.075, 1 }
    )

    circle(
        alpha_x,
        alpha_y + alpha_h * 0.5,
        8,
        { 1, 1, 1, 1 },
        2
    )

    -- No "100%" text next to HEX anymore.
    local field_y =
        alpha_y + 29

    c =
        fov_color()

    local hex =
        FALLEN_RGBA_HEX(
            c[1],
            c[2],
            c[3],
            c[4]
        )

    local prefix =
        "aim_fov"

    local hex_x = sv_x
    local hex_w = sv_w

    local hex_hot =
        hover(
            mx,
            my,
            hex_x,
            field_y,
            hex_w,
            31
        )

    local hex_focus =
        FALLEN_COLOR_INPUT_IS(
            "hex",
            prefix
        )

    rounded_fill(
        hex_x,
        field_y,
        hex_w,
        31,
        7,
        hex_focus
            and { 0.112, 0.118, 0.145, 1 }
            or (
                hex_hot
                and { 0.104, 0.108, 0.128, 1 }
                or { 0.095, 0.098, 0.112, 1 }
            )
    )

    if hex_focus then
        rounded_outline(
            hex_x,
            field_y,
            hex_w,
            31,
            7,
            alpha(C.accent, 0.72),
            1,
            { 0.112, 0.118, 0.145, 1 }
        )
    end

    text(
        hex_x + 10,
        field_y + 9,
        "HEX8",
        C.text_dim
    )

    local shown_hex =
        hex_focus
        and (
            "#"
            .. tostring(
                A.color_input.buffer
                or ""
            )
            .. (
                math.floor(tick() * 2) % 2 == 0
                and "|"
                or ""
            )
        )
        or hex

    text(
        hex_x + 56,
        field_y + 9,
        shown_hex,
        C.text
    )

    if clicked and hex_hot then
        A.fov_picker_drag = nil

        FALLEN_COLOR_INPUT_START(
            "hex",
            prefix
        )
    end

    if not lmb then
        A.fov_picker_drag = nil
    end

    local popup_hot =
        hover(
            mx,
            my,
            px,
            py,
            pw,
            ph
        )

    local swatch_hot =
        hover(
            mx,
            my,
            anchor_x,
            anchor_y,
            36,
            18
        )

    if clicked
        and not popup_hot
        and not swatch_hot
    then
        A.fov_picker_open = false
        A.fov_picker_drag = nil
        FALLEN_COLOR_INPUT_STOP(true)
    end
end

