    local dropdown_hot =
        FALLEN_DRAW_SILENT_PART_DROPDOWN(
            mx,
            my,
            clicked,
            field_x,
            dropdown_y,
            field_w
        )

    -- Click outside closes it, exactly like a normal settings dropdown.
    if clicked
        and A.silent_part_dropdown_open
        and not field_hot
        and not dropdown_hot
    then
        A.silent_part_dropdown_open =
            false
    end

    FALLEN_DRAW_SILENT_FOV_SETTINGS_POPUP(
        mx,
        my,
        clicked,
        lmb,
        silent_fov_dots_x,
        silent_fov_dots_y
    )
end


local function draw_aimbot_page(
    mx, my, clicked, lmb, rmb_clicked, cx, cy, cw
)
    local gap = 16
    local left_w = math.floor(cw * 0.48)
    local right_w = cw - left_w - gap

    local lx = cx
    local rx = cx + left_w + gap

    local overlay_open =
        A.aim_settings_open
        or (A.aim_settings_anim or 0) > 0.02
        or A.fov_settings_open
        or (A.fov_settings_anim or 0) > 0.02
        or A.aim_bind_listening

    local base_clicked =
        clicked and not overlay_open

    -- LEFT: normal Aimbot block.
    section_title(lx, cy, "Aimbot")
    card(lx, cy + 25, left_w, 155, 11)

    local dots_x = lx + left_w - 79
    local dots_y = cy + 40
    local dots_left_hot =
        hover(
            mx,
            my,
            dots_x,
            dots_y,
            27,
            25
        )

    toggle_row(
        mx,
        my,
        base_clicked and not dots_left_hot,
        lx,
        cy + 32,
        left_w,
        "Aimbot",
        "aim_enabled",
        true
    )

    local aimbot_row_hot =
        hover(
            mx,
            my,
            lx,
            cy + 32,
            left_w,
            41
        )

    if clicked and dots_left_hot then
        A.aim_settings_open =
            not A.aim_settings_open

        A.fov_settings_open = false

        if A.aim_settings_open then
            numeric_stop(true)
            A.fov_picker_open = false
            A.fov_picker_drag = nil
        else
            A.aim_part_dropdown_open = false
            aim_bind_cancel()
        end
    end

    line(
        lx + 12,
        cy + 72,
        lx + left_w - 12,
        cy + 72,
        C.divider,
        1
    )

    toggle_row(
        mx,
        my,
        base_clicked,
        lx,
        cy + 73,
        left_w,
        "Auto Prediction",
        "aim_auto_prediction",
        false
    )

    line(
        lx + 12,
        cy + 113,
        lx + left_w - 12,
        cy + 113,
        C.divider,
        1
    )

    toggle_row(
        mx,
        my,
        base_clicked,
        lx,
        cy + 114,
        left_w,
        "Sticky Aim",
        "sticky_aim",
        false
    )

    -- RIGHT: shared Aim FOV.
    section_title(rx, cy, "Aim FOV")
    card(rx, cy + 25, right_w, 98, 11)

    local fov_dots_x = rx + right_w - 79
    local fov_dots_y = cy + 40
    local fov_dots_hot =
        hover(
            mx,
            my,
            fov_dots_x,
            fov_dots_y,
            27,
            25
        )

    local fov_swatch_x = rx + right_w - 111
    local fov_swatch_y = cy + 43
    local fov_swatch_s = 18
    local fov_swatch_hot = hover(mx, my,
        fov_swatch_x, fov_swatch_y, fov_swatch_s, fov_swatch_s)
    toggle_row(
        mx,
        my,
        base_clicked and not fov_dots_hot and not fov_swatch_hot,
        rx,
        cy + 32,
        right_w,
        "Aim FOV",
        "aim_fov_enabled",
        true
    )

    local fov_row_hot =
        hover(
            mx,
            my,
            rx,
            cy + 32,
            right_w,
            41
        )

    if clicked and fov_dots_hot then
        A.fov_settings_open =
            not A.fov_settings_open

        A.aim_settings_open = false

        if not A.fov_settings_open then
            numeric_stop(true)
        end
    end

    line(
        rx + 12,
        cy + 72,
        rx + right_w - 12,
        cy + 72,
        C.divider,
        1
    )

    slider_row(
        mx,
        my,
        base_clicked,
        lmb,
        rx,
        cy + 73,
        right_w,
        "FOV Size",
        "aim_fov_size",
        10,
        600,
        "int"
    )

    -- Color picker is attached to the SAME line as Aim FOV.
    color_preview(fov_swatch_x, fov_swatch_y, fov_swatch_s, fov_swatch_s)

    if base_clicked
        and hover(
            mx,
            my,
            fov_swatch_x,
            fov_swatch_y,
            fov_swatch_s,
            swatch_s
        )
    then
        FALLEN_COLOR_INPUT_STOP(true)

        local prefix =
            "aim_fov"

        if A.world_color_picker_open
            and A.world_color_picker_key == prefix
        then
            A.world_color_picker_open = false
            A.world_color_picker_drag = nil
        else
            A.world_color_picker_key = prefix
            A.world_color_picker_open = true
            A.world_color_picker_drag = nil

            A.world_color_picker_anchor_x =
                FALLEN_UI_X(fov_swatch_x)

            A.world_color_picker_anchor_y =
                FALLEN_UI_Y(fov_swatch_y)

            A.world_color_picker_anchor_w =
                FALLEN_UI_LEN(fov_swatch_s)

            A.world_color_picker_anchor_h =
                FALLEN_UI_LEN(fov_swatch_s)
        end

        A.fov_picker_open = false
        A.fov_picker_drag = nil
        numeric_stop(true)
    end

    draw_aim_settings_popup(
        mx,
        my,
        clicked,
        lmb,
        rmb_clicked,
        dots_x,
        dots_y
    )

    FALLEN_DRAW_FOV_SETTINGS_POPUP(
        mx,
        my,
        clicked,
        lmb,
        fov_dots_x,
        fov_dots_y
    )
end

