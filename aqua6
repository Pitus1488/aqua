local function world_inst_valid(inst)
    if not inst then
        return false
    end

    local valid = true

    pcall(function()
        if inst.is_valid then
            valid = inst:is_valid() == true
        end
    end)

    return valid
end

local function world_inst_name(inst)
    if not inst then
        return nil
    end

    local name = nil

    pcall(function()
        name = inst:get_name()
    end)

    if name == nil then
        pcall(function()
            name = inst.Name
        end)
    end

    return name
        and tostring(name)
        or nil
end

local function world_inst_class(inst)
    if not inst then
        return nil
    end

    local class = nil

    pcall(function()
        class = inst:get_class()
    end)

    if class == nil then
        pcall(function()
            class = inst.ClassName
        end)
    end

    return class
        and tostring(class)
        or nil
end

local function world_children(inst)
    if not inst then
        return {}
    end

    local children = nil

    pcall(function()
        children = inst:get_children()
    end)

    if type(children) == "table" then
        return children
    end

    return {}
end

local function world_find_child(inst, name)
    if not inst then
        return nil
    end

    local child = nil

    pcall(function()
        child =
            inst:find_first_child(
                name
            )
    end)

    return child
end

local function world_part_pos(inst, depth)
    if not inst then
        return nil
    end

    depth =
        tonumber(depth)
        or 0

    local pos = nil

    pcall(function()
        local class =
            world_inst_class(inst)

        if class == "Part"
            or class == "MeshPart"
            or class == "UnionOperation"
            or class == "BasePart"
        then
            pos = inst:get_position()
        end
    end)

    if pos
        and pos.X ~= nil
        and pos.Y ~= nil
        and pos.Z ~= nil
    then
        return pos
    end

    local main =
        world_find_child(
            inst,
            "Main"
        )

    if main
        and main ~= inst
    then
        pcall(function()
            pos = main:get_position()
        end)

        if pos
            and pos.X ~= nil
            and pos.Y ~= nil
            and pos.Z ~= nil
        then
            return pos
        end
    end

    if depth >= 2 then
        return nil
    end

    local children =
        world_children(inst)

    -- Prefer BaseParts on this level.
    for _, child in ipairs(children) do
        local class =
            world_inst_class(child)

        if class == "Part"
            or class == "MeshPart"
            or class == "UnionOperation"
            or class == "BasePart"
        then
            pcall(function()
                pos =
                    child:get_position()
            end)

            if pos
                and pos.X ~= nil
                and pos.Y ~= nil
                and pos.Z ~= nil
            then
                return pos
            end
        end
    end

    -- Then search nested Models one more level.
    for _, child in ipairs(children) do
        if world_inst_class(child) == "Model" then
            pos =
                world_part_pos(
                    child,
                    depth + 1
                )

            if pos then
                return pos
            end
        end
    end

    return nil
end

local function world_name_match(cfg, name)
    if not cfg
        or not name
    then
        return false
    end

    if cfg.names[name] then
        return true
    end

    local function norm(v)
        v =
            string.lower(
                tostring(v or "")
            )

        v =
            string.gsub(
                v,
                "%s+",
                ""
            )

        v =
            string.gsub(
                v,
                "_",
                ""
            )

        v =
            string.gsub(
                v,
                "%-",
                ""
            )

        v =
            string.gsub(
                v,
                "%(%s*clone%s*%)",
                ""
            )

        return v
    end

    local target = norm(name)

    for candidate, _ in pairs(cfg.names) do
        if target == norm(candidate) then
            return true
        end
    end

    return false
end

local function world_local_pos()
    local pos = nil

    pcall(function()
        if rbx
            and type(rbx.local_hrp) == "function"
        then
            local hrp =
                rbx.local_hrp()

            if hrp then
                pos =
                    hrp:get_position()
            end
        end
    end)

    if not pos
        and type(GetMyPosition) == "function"
    then
        pcall(function()
            pos =
                GetMyPosition()
        end)
    end

    return pos
end

local function world_distance_m(a, b)
    if not a or not b then
        return nil
    end

    local dx =
        a.X - b.X

    local dy =
        a.Y - b.Y

    local dz =
        a.Z - b.Z

    return
        math.sqrt(
            dx * dx
            + dy * dy
            + dz * dz
        )
        * 0.28
end

local function world_screen(pos)
    if not pos then
        return nil
    end

    local screen = nil

    pcall(function()
        if rbx
            and type(rbx.world_to_screen) == "function"
        then
            screen =
                rbx.world_to_screen(
                    pos
                )
        elseif aim
            and type(aim.world_to_screen) == "function"
        then
            screen =
                aim.world_to_screen(
                    pos
                )
        end
    end)

    if not screen
        or screen.X == nil
        or screen.Y == nil
        or screen.X == -1
    then
        return nil
    end

    if screen.visible == false then
        return nil
    end

    return screen
end

function FALLEN_WORLD_IS_BODY_BAG_NAME(name)
    local s = string.lower(tostring(name or ""))
    s = string.gsub(s, "%s*%(%s*clone%s*%)%s*$", "")
    s = string.gsub(s, "[%s_%-]", "")

    return
        s == "bodybag"
        or string.find(s, "bodybag", 1, true) ~= nil
end

local function world_refresh_cache(force)
    if S.world_esp_enabled ~= true then
        return
    end

    local now = tick()

    if _G.FALLEN_WORLD_FORCE_RESCAN == true then
        force = true
        _G.FALLEN_WORLD_FORCE_RESCAN = false
    end

    if not force
        and now - WORLD_ESP.last_scan < 1.75
    then
        return
    end

    WORLD_ESP.last_scan = now

    local ws = nil

    pcall(function()
        if rbx
            and type(rbx.workspace) == "function"
        then
            ws =
                rbx.workspace()
        end
    end)

    if not ws then
        return
    end

    for _, folder_name in ipairs({
        "Nodes",
        "Plants",
        "Bases",
        "Drops",
    }) do
        local folder =
            world_find_child(
                ws,
                folder_name
            )

        WORLD_ESP.folders[folder_name] =
            folder
    end

    local entries = {}

    for _, cfg in ipairs(WORLD_RESOURCES) do
        local category_enabled =
            (
                cfg.folder == "Nodes"
                and S.world_node_esp_enabled == true
            )
            or (
                cfg.folder == "Plants"
                and S.world_plant_esp_enabled == true
            )

        local folder =
            WORLD_ESP.folders[
                cfg.folder
            ]

        if category_enabled
            and folder
            and world_inst_valid(folder)
        then
            for _, model in ipairs(
                world_children(folder)
            ) do
                local name =
                    world_inst_name(
                        model
                    )

                if name
                    and world_name_match(
                        cfg,
                        name
                    )
                then
                    entries[#entries + 1] = {
                        cfg = cfg,
                        inst = model,
                    }
                end
            end
        end
    end

    WORLD_ESP.entries = entries

    local base_entries = {}

    if S.world_base_esp_enabled == true
        and world_any_base_enabled()
    then
        local bases =
            WORLD_ESP.folders.Bases

        if bases
            and world_inst_valid(bases)
        then
            for _, base_folder in ipairs(
                world_children(bases)
            ) do
                if #base_entries >= 180 then
                    break
                end

                local base_name =
                    world_inst_name(
                        base_folder
                    )

                if base_name ~= "Loners" then
                    for _, type_folder in ipairs(
                        world_children(base_folder)
                    ) do
                        if #base_entries >= 180 then
                            break
                        end

                        local type_name =
                            world_inst_name(
                                type_folder
                            )

                        if type_name then
                            for _, cfg in ipairs(
                                WORLD_BASE_ITEMS
                            ) do
                                if world_base_enabled(cfg)
                                    and world_name_match(
                                        cfg,
                                        type_name
                                    )
                                then
                                    local found_model = false

                                    for _, model in ipairs(
                                        world_children(type_folder)
                                    ) do
                                        if #base_entries >= 180 then
                                            break
                                        end

                                        if world_inst_class(model) == "Model" then
                                            found_model = true

                                            base_entries[#base_entries + 1] = {
                                                cfg = cfg,
                                                inst = model,
                                            }
                                        end
                                    end

                                    -- Some API/game builds expose the placed object
                                    -- directly as the type folder rather than child Models.
                                    if not found_model
                                        and world_part_pos(type_folder, 0)
                                    then
                                        base_entries[#base_entries + 1] = {
                                            cfg = cfg,
                                            inst = type_folder,
                                        }
                                    end

                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    WORLD_ESP.base_entries =
        base_entries

    -- Dropped items are direct children of Workspace/Drops in the supplied
    -- working ESP. Their instance name is the actual item display name.
    local drop_entries = {}

    if S.world_dropped_esp_enabled == true then
        local drops = WORLD_ESP.folders.Drops

        if drops
            and world_inst_valid(drops)
        then
            for _, model in ipairs(
                world_children(drops)
            ) do
                if #drop_entries >= 260 then
                    break
                end

                local item_name =
                    world_inst_name(model)

                if item_name
                    and item_name ~= ""
                    and not FALLEN_WORLD_IS_BODY_BAG_NAME(item_name)
                then
                    drop_entries[#drop_entries + 1] = {
                        inst = model,
                        name = item_name,
                    }
                end
            end
        end
    end

    WORLD_ESP.drop_entries =
        drop_entries

    -- Body Bags can appear either directly in Workspace/Drops or in the
    -- Bases/Loners loot hierarchy used by the supplied working ESP.
    local body_bag_entries = {}
    local body_bag_seen = {}

    if S.world_body_bag_esp_enabled == true then
        local function add_body_bag(inst, name)
            if not inst
                or not world_inst_valid(inst)
            then
                return
            end

            local key = nil
            pcall(function()
                key = tostring(inst.addr or inst)
            end)
            key = key or tostring(inst)

            if body_bag_seen[key] then
                return
            end

            body_bag_seen[key] = true
            body_bag_entries[#body_bag_entries + 1] = {
                inst = inst,
                name = name or "Body Bag",
            }
        end

        local drops = WORLD_ESP.folders.Drops
        if drops
            and world_inst_valid(drops)
        then
            for _, model in ipairs(world_children(drops)) do
                if #body_bag_entries >= 180 then break end

                local n = world_inst_name(model)
                if FALLEN_WORLD_IS_BODY_BAG_NAME(n) then
                    add_body_bag(model, n)
                end
            end
        end

        local bases = WORLD_ESP.folders.Bases
        local loners = nil

        if bases
            and world_inst_valid(bases)
        then
            loners = world_find_child(bases, "Loners")
        end

        if loners
            and world_inst_valid(loners)
        then
            for _, type_folder in ipairs(world_children(loners)) do
                if #body_bag_entries >= 180 then break end

                local type_name = world_inst_name(type_folder)

                if FALLEN_WORLD_IS_BODY_BAG_NAME(type_name) then
                    local children = world_children(type_folder)
                    local added_child = false

                    for _, model in ipairs(children) do
                        if #body_bag_entries >= 180 then break end

                        if world_part_pos(model, 0) then
                            added_child = true
                            add_body_bag(model, "Body Bag")
                        end
                    end

                    if not added_child
                        and world_part_pos(type_folder, 0)
                    then
                        add_body_bag(type_folder, "Body Bag")
                    end
                end
            end
        end
    end

    WORLD_ESP.body_bag_entries =
        body_bag_entries
end

local function world_load_direct_icon(cfg)
    -- Uses the working M3/M5 behavior:
    -- primary format=original URL + fallback URL chain.
    if not cfg then
        return nil
    end

    local urls = cfg.direct_urls or {}
    if #urls == 0 then
        return nil
    end

    local name = cfg.id
    local st = WORLD_ESP.icons[name]

    if not st then
        st = {
            index = 1,
            handle = nil,
            dead = false,
        }
        WORLD_ESP.icons[name] = st
    end

    if st.dead then
        return nil
    end

    -- M3/M5 behavior: create the current URL handle once, then wait.
    if not st.handle and urls[st.index] then
        local ok, handle = pcall(
            Drawing.LoadImage,
            urls[st.index]
        )

        if ok then
            st.handle = handle
        end
    end

    -- Only return a handle after the image is actually ready.
    if st.handle
        and Drawing.IsImageReady
        and Drawing.IsImageReady(st.handle)
    then
        return st.handle
    end

    -- M5 fallback chain: if the current URL failed, advance to the next.
    if st.handle
        and Drawing.IsImageFailed
        and Drawing.IsImageFailed(st.handle)
    then
        st.index = st.index + 1
        st.handle = nil

        if not urls[st.index] then
            st.dead = true
        end
    end

    return nil
end

local function world_resolve_icon(cfg)
    return world_load_direct_icon(cfg)
end

function FALLEN_WORLD_ICON_GLOW_COLOR()
    return
        world_color_from_prefix(
            "world_icon_glow"
        )
end

function FALLEN_WORLD_DRAW_ICON_GLOW(
    x,
    y,
    radius,
    alpha_mul
)
    if S.world_icon_glow_enabled ~= true
        or type(DrawCircle) ~= "function"
    then
        return
    end

    local c =
        FALLEN_WORLD_ICON_GLOW_COLOR()

    local strength =
        clamp(
            (tonumber(S.world_icon_glow_strength) or 60) / 100,
            0,
            1
        )

    local spread =
        clamp(
            tonumber(S.world_icon_glow_spread) or 6,
            1,
            20
        )

    if strength <= 0.001
        or (c[4] or 0) <= 0.001
    then
        return
    end

    -- Exactly 35 glow lines/layers.
    -- Strongest at the icon edge, smoothly fading outwards.
    for layer = 0, 34 do
        local t =
            layer / 34

        local falloff =
            1 - t

        local glow_radius =
            radius
            + t * spread

        local glow_alpha =
            (c[4] or 1)
            * (alpha_mul or 1)
            * strength
            * falloff
            * falloff
            * 0.42

        local thickness =
            1.05
            + falloff * 0.45

        DrawCircle(
            x,
            y,
            glow_radius,
            c[1],
            c[2],
            c[3],
            glow_alpha,
            thickness
        )
    end
end


local function world_draw_icon(
    cfg,
    x,
    y,
    size,
    a
)
    -- Draw icons only for resources that explicitly have icon URLs.
    if not cfg or not cfg.direct_urls or #cfg.direct_urls == 0 then
        return false
    end

    if type(DrawImage) ~= "function" then
        return false
    end

    local handle =
        world_resolve_icon(
            cfg
        )

    -- Do not draw the old ST fallback/ring while the PNG is loading.
    if not handle then
        return false
    end

    size =
        clamp(
            tonumber(size) or 18,
            10,
            48
        )

    local icon_radius =
        size * 0.5
        + 3

    FALLEN_WORLD_DRAW_ICON_GLOW(
        x,
        y,
        icon_radius,
        a
    )

    -- Keep the existing round background/border from the menu,
    -- but only once the actual PNG is ready.
    if type(DrawCircleFilled) == "function"
        and type(DrawCircle) == "function"
    then
        local radius =
            icon_radius

        DrawCircleFilled(
            x,
            y,
            radius,
            0.02,
            0.02,
            0.03,
            0.90 * a
        )

        local border =
            world_color_from_prefix(
                "world_icon_border"
            )

        DrawCircle(
            x,
            y,
            radius,
            border[1],
            border[2],
            border[3],
            0.95
                * a
                * (border[4] or 1),
            1.4
        )
    end

    DrawImage(
        handle,
        x - size * 0.5,
        y - size * 0.5,
        size,
        size,
        1,
        1,
        1,
        a,
        math.max(
            2,
            size * 0.16
        )
    )

    return true
end

local function world_resource_color(cfg)
    if not cfg or not cfg.id then
        return { 1, 1, 1, 1 }
    end

    local prefix =
        world_color_prefix(
            cfg.id
        )

    return
        world_color_from_prefix(
            prefix
        )
end

function FALLEN_DROPPED_ITEM_CLEAN_NAME(name)
    local s = tostring(name or "")

    s = string.gsub(s, "%s*%(%s*[Cc][Ll][Oo][Nn][Ee]%s*%)%s*$", "")
    s = string.gsub(s, "^%s+", "")
    s = string.gsub(s, "%s+$", "")

    return s
end

