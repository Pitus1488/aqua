        + gap * 4

    local char_gap =
        cell * 0.75

    if #label <= 0 then
        return 0
    end

    return
        #label * glyph_w
        + (#label - 1) * char_gap
end


function FALLEN_DMGNUM_DRAW_SCALED_TEXT(
    center_x,
    y,
    label,
    size,
    color,
    alpha_value
)
    if type(DrawBoxFilled) ~= "function" then
        return
    end

    label =
        tostring(
            label or ""
        )

    size =
        clamp(
            tonumber(size) or 14,
            8,
            30
        )

    color =
        color
        or { 1, 1, 1, 1 }

    local cell =
        size / 7

    local gap =
        cell * 0.16

    local glyph_w =
        cell * 5
        + gap * 4

    local char_gap =
        cell * 0.75

    local total_w =
        FALLEN_DMGNUM_TEXT_WIDTH(
            label,
            size
        )

    local cursor_x =
        center_x
        - total_w * 0.5

    local outline =
        clamp(
            cell * 0.34,
            0.55,
            1.35
        )

    for ci = 1, #label do
        local ch =
            string.sub(
                label,
                ci,
                ci
            )

        local glyph =
            _G.FALLEN_DMGNUM_GLYPHS[ch]

        if glyph then
            for row = 1, 7 do
                local bits =
                    glyph[row]

                for col = 1, 5 do
                    if string.sub(
                        bits,
                        col,
                        col
                    ) == "1"
                    then
                        local px =
                            cursor_x
                            + (col - 1)
                            * (cell + gap)

                        local py =
                            y
                            + (row - 1)
                            * (cell + gap)

                        DrawBoxFilled(
                            px - outline,
                            py - outline,
                            px + cell + outline,
                            py + cell + outline,
                            0,
                            0,
                            0,
                            alpha_value * 0.72
                        )

                        DrawBoxFilled(
                            px,
                            py,
                            px + cell,
                            py + cell,
                            color[1],
                            color[2],
                            color[3],
                            alpha_value
                                * (color[4] or 1)
                        )
                    end
                end
            end
        end

        cursor_x =
            cursor_x
            + glyph_w
            + char_gap
    end
end


function FALLEN_DMGNUM_DRAW()
    if type(FALLEN_DMGNUM.items) ~= "table" then
        FALLEN_DMGNUM.items = {}
    end

    local now =
        tick()

    local speed =
        clamp(
            (tonumber(S.damage_numbers_speed) or 100) / 100,
            0.50,
            2.00
        )

    local life =
        1.05 / speed

    local size =
        clamp(
            tonumber(S.damage_numbers_size) or 14,
            8,
            30
        )

    local col =
        FALLEN_DMGNUM_COLOR()

    for i = #FALLEN_DMGNUM.items, 1, -1 do
        local item =
            FALLEN_DMGNUM.items[i]

        local age =
            now
            - (
                item.created
                or now
            )

        if age >= life
            or S.damage_numbers_enabled ~= true
        then
            table.remove(
                FALLEN_DMGNUM.items,
                i
            )
        else
            local t =
                clamp(
                    age / life,
                    0,
                    1
                )

            -- Same final travel, but Animation Speed changes how quickly
            -- the number reaches it and disappears.
            local rise =
                43
                * (
                    1
                    - (1 - t)
                    * (1 - t)
                    * (1 - t)
                )

            local fade_in =
                clamp(
                    age / (0.09 / speed),
                    0,
                    1
                )

            local fade_out =
                1
                - clamp(
                    (t - 0.28) / 0.72,
                    0,
                    1
                )

            fade_out =
                fade_out
                * fade_out

            local alpha_value =
                fade_in
                * fade_out

            local label =
                "-"
                .. tostring(
                    item.damage
                    or 0
                )

            local draw_y =
                item.y
                - rise

            FALLEN_DMGNUM_DRAW_SCALED_TEXT(
                item.x,
                draw_y,
                label,
                size,
                col,
                alpha_value
            )
        end
    end
end


