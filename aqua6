    end

    if S.world_show_distance == true
        and type(DrawTextWithOutline) == "function"
    then
        local dy = S.world_show_names == true and 14 or 0

        DrawTextWithOutline(
            screen.X,
            text_y + dy,
            string.format("%.0fm", dist),
            col[1], col[2], col[3], fade,
            0, 0, 0, fade
