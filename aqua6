local function clamp(v, a, b)
    if v < a then
        return a
    end

    if v > b then
        return b
    end

    return v
end

local function lerp(a, b, t)
    return a + (b - a) * t
end

local function chase(v, target, speed, dt)
    return v + (target - v) * clamp(dt * speed, 0, 1)
end

local function inside(mx, my, x, y, w, h)
    return
        mx >= x and
        mx <= x + w and
        my >= y and
        my <= y + h
end

local function mouse_pos()
    if utility and utility.get_mouse_pos then
        local ok, mx, my =
            pcall(utility.get_mouse_pos)

        if ok then
            mx = tonumber(mx)
            my = tonumber(my)

            if mx and my then
                return mx, my
            end
        end
    end

    if utility and utility.GetMousePos then
        local ok, mx, my =
            pcall(utility.GetMousePos)

        if ok then
            mx = tonumber(mx)
            my = tonumber(my)

            if mx and my then
                return mx, my
            end
        end
    end

    if input then
        local fn =
            input.get_mouse_position or
            input.get_mouse_pos or
            input.GetMousePosition

        if fn then
            local ok, a, b =
                pcall(fn)

            if ok then
                if tonumber(a) and tonumber(b) then
                    return tonumber(a), tonumber(b)
                end

                if a then
                    local okx, px =
                        pcall(function()
                            return a.X
                        end)

                    local oky, py =
                        pcall(function()
                            return a.Y
                        end)

                    if okx and oky then
                        px = tonumber(px)
                        py = tonumber(py)

                        if px and py then
                            return px, py
                        end
                    end
                end
            end
        end
    end

    if Windows and Windows.GetMousePos then
        local ok, m =
            pcall(Windows.GetMousePos)

        if ok and m then
            return
                tonumber(m.X) or -1,
                tonumber(m.Y) or -1
        end
    end

    return -1, -1
end

local function lmb_down()
    if input then
