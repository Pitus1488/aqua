function FALLEN_DRAW_ONE_CUSTOM_FOV(
    enabled,
    radius,
    color,
    glow_enabled,
    glow_color,
    glow_strength,
    glow_spread,
    filled
)
    if enabled ~= true then
        return
    end

    local cx, cy =
        FALLEN_CUSTOM_FOV_CENTER()

    if not cx
        or not cy
    then
        return
    end

    radius =
        clamp(
            tonumber(radius)
            or 50,
            10,
            600
        )

    color =
        color
        or { 1, 1, 1, 1 }

    glow_color =
        glow_color
        or color

    if filled == true then
        FALLEN_CUSTOM_DRAW_CIRCLE_FILLED(
            cx,
            cy,
            radius,
            {
                color[1],
                color[2],
                color[3],
                (color[4] or 1)
                    * 0.075,
            }
        )
    end

    if glow_enabled == true then
        local strength =
            clamp(
                (tonumber(glow_strength) or 60) / 100,
                0,
                1
            )

        local spread =
            clamp(
                tonumber(glow_spread)
                or 6,
                1,
                12
            )

        local total_spread =
            spread * 3.0

        for layer = 0, 27 do
            local t =
                layer / 27

            local falloff =
                1 - t

            local gr =
                radius
                + t * total_spread

            local ga =
                (glow_color[4] or 1)
                * strength
                * falloff
                * falloff
                * 0.20

            FALLEN_CUSTOM_DRAW_CIRCLE(
                cx,
                cy,
                gr,
                {
                    glow_color[1],
                    glow_color[2],
                    glow_color[3],
                    ga,
                },
                1.15
                    + falloff * 0.55
            )
        end
    end

    FALLEN_CUSTOM_DRAW_CIRCLE(
        cx,
        cy,
        radius,
        color,
        1.25
    )
end


