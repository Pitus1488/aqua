    local interactive =
        raw > 0.96
        and A.misc_antiaim_settings_open

    local ui_clicked =
        clicked
        and interactive

    local dropdown_active =
        A.misc_antiaim_mode_dropdown_open == true
        or (A.misc_antiaim_mode_dropdown_anim or 0) > 0.02

    local controls_clicked =
        ui_clicked
        and not dropdown_active

    FALLEN_POPUP_GLOW(
        px,
        py,
        pw,
        shell_h,
        11,
        1
