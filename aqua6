-- Neverlose-style 1px outline around every pill switch.
-- The border and fill are opaque to avoid layered-alpha seams.
-- v117 track geometry: real circles/filled body instead of individual
-- 1px strips. Keep the same geometry throughout the menu fade.
local function draw_switch_track(x, y, w, h, off_color, on_color, t)
    local progress = clamp(tonumber(t) or 0, 0, 1)
    local rounding = math.floor(h * 0.5)
    local border = { 0.16, 0.16, 0.17, 1.0 }
    local inside = mix_color(off_color, on_color, progress)
    -- Do not suppress the outline while the menu animates in.
    -- Using the v117 smooth opaque-path geometry for both layers also
    -- avoids the jagged outline from the v119 pixel-strip version.
    rounded_fill_opaque(x, y, w, h, rounding, border)
    rounded_fill_opaque(
        x + 1, y + 1, w - 2, h - 2,
        math.max(0, rounding - 1), inside
    )
end

-- Reusable dependency animation for every three-dot settings panel.
-- State and animation never go into configs; only existing settings do.
local FALLEN_NESTED_STATE = {}
local function fallen_nested_amount(key, enabled)
    local now = tick()
    local target = enabled and 1 or 0
    local state = FALLEN_NESTED_STATE[key]
    if not state then
        state = { value = target, last = now }
        FALLEN_NESTED_STATE[key] = state
    end
    local dt = clamp(now - state.last, 0, 0.05)
    state.last = now
    state.value = exp_chase(state.value, target, 14, dt)
    if math.abs(state.value - target) < 0.001 then
        state.value = target
    end
    return clamp(state.value, 0, 1)
end

local function fallen_nested_alpha(v)
    return ease_out_cubic(clamp((v - 0.10) / 0.90, 0, 1))
end


