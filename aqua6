            clamp(
                (
                    visible_h
                    - (i - 1) * item_h
                )
                / item_h,
                0,
                1
            )

        if reveal > 0.12 then
            local item_hot =
                reveal > 0.92
                and hover(
                    mx,
                    my,
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4
