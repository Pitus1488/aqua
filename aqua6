end


function FALLEN_BT_FOV_CHECK(pos)
    if not pos
        or not aim
        or type(aim.world_to_screen) ~= "function"
    then
        return false, nil
    end

    local screen = nil

    pcall(function()
        screen = aim.world_to_screen(pos)
    end)

    if not screen
        or screen.visible ~= true
        or screen.X == nil
        or screen.Y == nil
    then
        return false, nil
    end

    local cx, cy = FALLEN_BT_FOV_CENTER()

    if not cx or not cy then
        return false, nil
    end

    local dx = tonumber(screen.X) - cx
    local dy = tonumber(screen.Y) - cy
    local dist_sq = dx * dx + dy * dy
    local radius = FALLEN_BT_FOV_RADIUS()

    return
        dist_sq <= radius * radius,
        dist_sq
end



-- Capture the exact view used for the hidden Bullet Tracer FOV check.
-- We keep camera basis + viewport + crosshair position from the shot moment,
-- then project future Hole/BloodPart positions through this SAVED view.
function FALLEN_BT_CAPTURE_SHOT_VIEW(force)
    local now = tick()

    if force ~= true
        and now - (tonumber(FALLEN_BT.vfx_shot_view_last) or 0) < 0.035
    then
        return
    end

    FALLEN_BT.vfx_shot_view_last = now

    if not rbx
        or type(rbx.camera) ~= "function"
    then
        return
    end

    local cam = nil
    local cam_pos = nil
    local rot = nil
    local fov = nil

    pcall(function()
        cam = rbx.camera()
        if cam then
            cam_pos = cam:camera_pos()
            rot = cam:camera_rotation()
            fov = cam:camera_fov()
        end
    end)

    if not cam_pos
        or type(rot) ~= "table"
        or #rot < 9
    then
        return
    end

    local dims = nil

    if type(ScreenSize) == "function" then
        pcall(function()
            dims = ScreenSize()
        end)
    end

    if type(dims) ~= "table" then
        return
    end

    local vw = tonumber(dims.Width or dims.width or dims.X or dims.x)
    local vh = tonumber(dims.Height or dims.height or dims.Y or dims.y)

    if not vw or not vh or vw <= 0 or vh <= 0 then
        return
    end

    local cx, cy = FALLEN_BT_FOV_CENTER()

    if not cx or not cy then
        cx = vw * 0.5
        cy = vh * 0.5
    end

    fov = tonumber(fov) or math.rad(70)

    -- Custom camera API exposes FOV in radians. Keep a defensive degrees
    -- fallback for older builds that may return a degree value.
    if fov > math.pi * 1.25 then
        fov = math.rad(fov)
    end

    fov = clamp(fov, math.rad(20), math.rad(150))

    local snapshot = {
        time = now,
        px = tonumber(cam_pos.X),
        py = tonumber(cam_pos.Y),
        pz = tonumber(cam_pos.Z),

        -- Rotation matrix columns are the camera world-space local axes.
        -- Local -Z is camera forward.
        rx = tonumber(rot[1]),
        ry = tonumber(rot[4]),
        rz = tonumber(rot[7]),

        ux = tonumber(rot[2]),
        uy = tonumber(rot[5]),
        uz = tonumber(rot[8]),

        fx = -tonumber(rot[3]),
        fy = -tonumber(rot[6]),
        fz = -tonumber(rot[9]),

        vw = vw,
        vh = vh,
        cx = tonumber(cx),
        cy = tonumber(cy),
        fov = fov,
        radius = FALLEN_BT_FOV_RADIUS(),
    }

    for _, key in ipairs({
        "px", "py", "pz",
        "rx", "ry", "rz",
        "ux", "uy", "uz",
        "fx", "fy", "fz",
        "vw", "vh", "cx", "cy", "fov", "radius",
    }) do
        if snapshot[key] == nil then
            return
        end
    end

    local list = FALLEN_BT.vfx_shot_views
    list[#list + 1] = snapshot

    -- One second is the longest accepted BloodPart impact window.
    for i = #list, 1, -1 do
        if now - (tonumber(list[i].time) or 0) > 1.05 then
            table.remove(list, i)
        end
    end

    while #list > 32 do
        table.remove(list, 1)
    end
end


function FALLEN_BT_FOV_CHECK_SNAPSHOT(pos, snapshot)
    if not pos or type(snapshot) ~= "table" then
        return false, nil
    end

    local dx = tonumber(pos.X) - tonumber(snapshot.px)
    local dy = tonumber(pos.Y) - tonumber(snapshot.py)
    local dz = tonumber(pos.Z) - tonumber(snapshot.pz)

    if not dx or not dy or not dz then
        return false, nil
    end

    local local_x =
        dx * snapshot.rx
        + dy * snapshot.ry
        + dz * snapshot.rz

    local local_y =
        dx * snapshot.ux
        + dy * snapshot.uy
        + dz * snapshot.uz

    local local_z =
        dx * snapshot.fx
        + dy * snapshot.fy
        + dz * snapshot.fz

    -- Behind the saved camera view cannot be inside its FOV.
    if local_z <= 0.001 then
        return false, nil
    end

    local focal =
        snapshot.vh
        / (2 * math.tan(snapshot.fov * 0.5))

    if focal <= 0 then
        return false, nil
    end

    local sx =
        snapshot.vw * 0.5
        + (local_x / local_z) * focal

    local sy =
        snapshot.vh * 0.5
        - (local_y / local_z) * focal

    local ddx = sx - snapshot.cx
    local ddy = sy - snapshot.cy
    local dist_sq = ddx * ddx + ddy * ddy
    local radius = tonumber(snapshot.radius) or 40

    return dist_sq <= radius * radius, dist_sq
end


function FALLEN_BT_FOV_CHECK_SHOT_VIEWS(pos, max_age)
    local list = FALLEN_BT.vfx_shot_views

    if type(list) ~= "table" or #list == 0 then
        return false, nil
    end

    local now = tick()
    local age_limit = tonumber(max_age) or 1.00
    local best_dist_sq = nil

    for i = #list, 1, -1 do
        local snapshot = list[i]
        local age = now - (tonumber(snapshot.time) or 0)

        if age <= age_limit then
            local ok, dist_sq =
                FALLEN_BT_FOV_CHECK_SNAPSHOT(
                    pos,
                    snapshot
                )

            if ok then
                return true, dist_sq
            end

            if dist_sq ~= nil
                and (
                    best_dist_sq == nil
                    or dist_sq < best_dist_sq
                )
            then
                best_dist_sq = dist_sq
            end
        end
    end

    return false, best_dist_sq
end


function FALLEN_BT_VFX_KIND(inst)
    if not inst
        or not FALLEN_BT_VFX_INSTANCE_VALID(inst)
    then
        return nil
    end

    local name = nil

    pcall(function()
        name = inst:get_name()
    end)

    name = string.lower(tostring(name or ""))

    if name == "hole"
        or name == "metalhole"
    then
        return "hole"
    end

    if name == "bloodpart" then
        return "bloodpart"
    end

    if name == "casinglarge"
        or name == "casingsmall"
    then
        return "casing"
    end

    return nil
end


function FALLEN_BT_VFX_FIND_NEW_IMPACT(
    previous,
    current,
    origin,
    shot_age
)
    if type(current) ~= "table"
        or not origin
    then
        return nil
    end

    previous =
        type(previous) == "table"
        and previous
        or {}

    shot_age = tonumber(shot_age) or 999

    local best_pos = nil
    local best_world_dist_sq = nil
    local best_fov_dist_sq = nil
    local best_priority = -1

    -- Keep the hidden FOV validation, but validate each new impact against
    -- camera/crosshair snapshots SAVED during the shot. Recoil may move the
    -- live camera immediately afterwards; it no longer moves this check.
    for key, inst in pairs(current) do
        if previous[key] == nil then
            local kind =
                FALLEN_BT_VFX_KIND(inst)

            local allowed = false
            local priority = 0
            local max_fov_age = 0

            if kind == "bloodpart" then
                allowed = shot_age <= 1.00
                priority = 2
                max_fov_age = 1.00

            elseif kind == "hole" then
                allowed = shot_age <= 0.70
                priority = 1
                max_fov_age = 0.70
            end

            -- Casings stay excluded: they are not bullet impact endpoints.
            if allowed then
                local pos =
                    FALLEN_BT_VFX_POSITION(inst)

                if pos then
                    local in_shot_fov, fov_dist_sq =
                        FALLEN_BT_FOV_CHECK_SHOT_VIEWS(
                            pos,
                            max_fov_age
                        )

                    if in_shot_fov then
                        local dx = tonumber(pos.X) - tonumber(origin.X)
                        local dy = tonumber(pos.Y) - tonumber(origin.Y)
                        local dz = tonumber(pos.Z) - tonumber(origin.Z)
                        local world_dist_sq =
                            dx * dx + dy * dy + dz * dz

                        if world_dist_sq >= 4 then
                            local better = false

                            if priority > best_priority then
                                better = true
                            elseif priority == best_priority then
                                if best_fov_dist_sq == nil
                                    or (
                                        fov_dist_sq ~= nil
                                        and fov_dist_sq < best_fov_dist_sq
                                    )
                                then
                                    better = true
                                elseif fov_dist_sq == best_fov_dist_sq
                                    and (
                                        best_world_dist_sq == nil
                                        or world_dist_sq < best_world_dist_sq
                                    )
                                then
                                    better = true
                                end
                            end

                            if better then
                                best_priority = priority
                                best_fov_dist_sq = fov_dist_sq
                                best_world_dist_sq = world_dist_sq

                                best_pos = {
                                    X = pos.X,
                                    Y = pos.Y,
                                    Z = pos.Z,

                                    auto_prediction = false,
                                    prediction_time = 0,
                                    gravity = 0,
                                    bullet_speed = 0,
                                    source = "vfx_impact_saved_shot_fov",
                                }
                            end
                        end
                    end
                end
            end
        end
    end

    return best_pos
end


function FALLEN_BT_ROBLOX_COLORSEQ()
    local ok, seq = pcall(function()
        local c = FALLEN_BT_COLOR()
        local color = Color3.new(c[1] or 1, c[2] or 1, c[3] or 1)
        return ColorSequence.new(color)
    end)

    if ok then
        return seq
    end

    return nil
end

function FALLEN_BT_SPAWN_ROBLOX_BEAM(origin, target)
    local texture_url =
        tostring(
            _G.FALLEN_GALAXY_IMAGE_URL
            or _G.FALLEN_GALAXY_IMAGE_PAGE_URL
            or "https://fotovssylku.ru/i/roblox-12781800668-420.rg5Xg"
        )

    local ok, err = pcall(function()
        -- IMPORTANT: one Attachment pair + one Beam only.
        -- This mirrors fallen_ultimate Lightning; no DrawImage nodes/clones.
        local parent = nil

        pcall(function()
            if rbx and type(rbx.workspace) == "function" then
                local ws = rbx.workspace()
                if ws then
                    parent = ws:find_first_child("VFX") or ws
                end
            end
        end)

        if not parent then
            error("no beam parent")
        end

        local att0 = Instance.new("Attachment", parent)
        local att1 = Instance.new("Attachment", parent)

        if not att0 or not att1 then
            error("attachment create failed")
        end

        -- Custom Instance.new is the documented CallGate creator. Property
        -- writes below intentionally match fallen_ultimate's Beam logic.
        att0.WorldPosition = Vector3(origin.X, origin.Y, origin.Z)
        att1.WorldPosition = Vector3(target.X, target.Y, target.Z)

        local beam = Instance.new("Beam", parent)
        if not beam then
            error("beam create failed")
        end

        beam.Attachment0 = att0
        beam.Attachment1 = att1
        beam.FaceCamera = true
        beam.Brightness = 10

        -- User URL instead of rbxassetid. Same image-loader URL that already
        -- succeeds in the menu preview.
        beam.Texture = texture_url
        beam.TextureLength = 4
        beam.TextureMode = Enum.TextureMode.Wrap
        beam.TextureSpeed = 10

        local width =
            math.max(
                0.08,
                (tonumber(S.bullet_tracer_thickness) or 2) * 0.25
            )

        beam.Width0 = width
        beam.Width1 = width
        beam.LightEmission = 1
        beam.LightInfluence = 0

        pcall(function()
            local c = FALLEN_BT_COLOR()
            beam.Color = ColorSequence.new(
                Color3.new(c[1] or 1, c[2] or 1, c[3] or 1)
            )
        end)

        local born = tick()
        local life =
            clamp(
                tonumber(S.bullet_tracer_life) or 1.2,
                0.10,
                5.0
            )

        -- Keep exactly the fallen_ultimate idea: texture flows while the beam
        -- exists, then width/brightness collapse. No image stamping.
        local released = false
        hooks.on_render(function()
            if released then
                return
            end

            local age = tick() - born
            if age < life then
                return
            end

            released = true
            pcall(function() beam.Width0 = 0 end)
            pcall(function() beam.Width1 = 0 end)
            pcall(function() beam.TextureSpeed = 0 end)
            pcall(function() beam.Brightness = 0 end)

            pcall(function()
                if type(beam.destroy) == "function" then beam:destroy() end
            end)
            pcall(function()
                if type(att0.destroy) == "function" then att0:destroy() end
            end)
            pcall(function()
                if type(att1.destroy) == "function" then att1:destroy() end
            end)
        end)
    end)

    if not ok then
        A.bt_lightning_v2_last_error = tostring(err)
    else
        A.bt_lightning_v2_last_error = nil
    end

    return ok
end

function FALLEN_BT_ADD(origin, target)
    if not origin or not target then
        return
    end

    FALLEN_BT.items[#FALLEN_BT.items + 1] = {
        ox = origin.X,
        oy = origin.Y,
        oz = origin.Z,

        tx = target.X,
        ty = target.Y,
        tz = target.Z,

        auto_prediction =
            target.auto_prediction == true,

        prediction_time =
            tonumber(target.prediction_time)
            or 0,

        gravity =
            tonumber(target.gravity)
            or 0,

        bullet_speed =
            tonumber(target.bullet_speed)
            or 0,

        created = tick(),
        owner = FALLEN_BT_LOCAL_NAME(),

        seed =
            (#FALLEN_BT.items + 1) * 19
            + math.floor(tick() * 1000),

        hue =
            (
                (tonumber(S.bullet_tracer_h) or 0.58)
                + (#FALLEN_BT.items + 1) * 0.173
            ) % 1,
    }

    while #FALLEN_BT.items > 40 do
        table.remove(FALLEN_BT.items, 1)
    end
end

function FALLEN_BT_PROJECT(pos)
    if not aim
        or type(aim.world_to_screen) ~= "function"
        or not pos
    then
        return nil
    end

    local s = nil

    pcall(function()
        s = aim.world_to_screen(pos)
    end)

    if s and s.visible then
        return s
    end

    return nil
end

function FALLEN_BT_SHOT_TICK()
    if S.bullet_tracer_enabled ~= true then
        FALLEN_BT.vfx_seen = {}
        FALLEN_BT.vfx_prev_lmb = false
        FALLEN_BT.vfx_watch_until = 0
        FALLEN_BT.vfx_shot_time = nil
        FALLEN_BT.vfx_shot_views = {}
        FALLEN_BT.vfx_shot_view_last = 0
        return
    end

    if not FALLEN_BT_WEAPON_READY() then
        FALLEN_BT.vfx_seen = {}
        FALLEN_BT.vfx_prev_lmb = false
        FALLEN_BT.vfx_watch_until = 0
        FALLEN_BT.vfx_shot_time = nil
        FALLEN_BT.vfx_shot_views = {}
        FALLEN_BT.vfx_shot_view_last = 0
        return
    end

    local now = tick()
    local lmb = key_down(0x01) == true

    if not lmb
        and now >= (tonumber(FALLEN_BT.vfx_watch_until) or 0)
    then
        FALLEN_BT.vfx_seen =
            FALLEN_BT_VFX_SCAN()

        FALLEN_BT.vfx_prev_lmb = false
        FALLEN_BT.vfx_shot_time = nil
        FALLEN_BT.vfx_shot_views = {}
        FALLEN_BT.vfx_shot_view_last = 0
        return
    end

    if lmb
        and FALLEN_BT.vfx_prev_lmb ~= true
    then
        FALLEN_BT.vfx_shot_time = now
        FALLEN_BT.vfx_watch_until = now + 1.00

        -- Rising edge: save the exact pre/post-shot view immediately.
        FALLEN_BT_CAPTURE_SHOT_VIEW(true)

    elseif lmb then
        FALLEN_BT.vfx_shot_time = now
        FALLEN_BT.vfx_watch_until = now + 1.00

        -- Automatic weapons can fire multiple rounds while Mouse1 remains
        -- held. Keep a small history of shot-time views, not the later
        -- impact-time camera that recoil has already moved.
        FALLEN_BT_CAPTURE_SHOT_VIEW(false)
    end

    FALLEN_BT.vfx_prev_lmb = lmb

    if not lmb
        and now > (tonumber(FALLEN_BT.vfx_watch_until) or 0)
    then
        return
    end

    local previous =
        FALLEN_BT.vfx_seen
        or {}

    local current =
        FALLEN_BT_VFX_SCAN()

    local origin =
        FALLEN_BT_ORIGIN()

    local shot_age =
        now - (tonumber(FALLEN_BT.vfx_shot_time) or now)

    local impact =
        FALLEN_BT_VFX_FIND_NEW_IMPACT(
            previous,
            current,
            origin,
            shot_age
        )

    FALLEN_BT.vfx_seen = current

    if not origin
        or not impact
    then
        return
    end

    FALLEN_BT_ADD(
        origin,
        impact
    )
end


function FALLEN_BT_GALAXY_POINT(points, progress)
    if type(points) ~= "table"
        or #points == 0
    then
        return nil, nil, nil, nil
    end

    local wanted =
        clamp(
            tonumber(progress) or 0,
            0,
            1
        )

    local prev = points[1]

    if wanted <= (tonumber(prev.u) or 0) then
        local nxt = points[2] or prev
        return prev.x, prev.y, nxt.x - prev.x, nxt.y - prev.y
    end

    for i = 2, #points do
        local cur = points[i]
        local pu = tonumber(prev.u) or 0
        local cu = tonumber(cur.u) or pu

        if wanted <= cu + 0.0001 then
            local span = math.max(0.0001, cu - pu)
            local t = clamp((wanted - pu) / span, 0, 1)
            local x = prev.x + (cur.x - prev.x) * t
            local y = prev.y + (cur.y - prev.y) * t
            return x, y, cur.x - prev.x, cur.y - prev.y
        end

        prev = cur
    end

    local last = points[#points]
    local before = points[math.max(1, #points - 1)]
    return last.x, last.y, last.x - before.x, last.y - before.y
end

function FALLEN_BT_GALAXY_WORLD_POINT(points, progress)
    if type(points) ~= "table"
        or #points == 0
    then
        return nil
    end

    local wanted =
        clamp(
            tonumber(progress) or 0,
            0,
            1
        )

    local prev = points[1]

    if wanted <= (tonumber(prev.u) or 0) then
        if prev.wx and prev.wy and prev.wz then
            return {
                X = prev.wx,
                Y = prev.wy,
                Z = prev.wz,
            }
        end

        return nil
    end

    for i = 2, #points do
        local cur = points[i]
        local pu = tonumber(prev.u) or 0
        local cu = tonumber(cur.u) or pu

        if wanted <= cu + 0.0001 then
            if not (
                prev.wx and prev.wy and prev.wz
                and cur.wx and cur.wy and cur.wz
            ) then
                return nil
            end

            local span = math.max(0.0001, cu - pu)
            local t = clamp((wanted - pu) / span, 0, 1)

            return {
                X = prev.wx + (cur.wx - prev.wx) * t,
                Y = prev.wy + (cur.wy - prev.wy) * t,
                Z = prev.wz + (cur.wz - prev.wz) * t,
            }
        end

        prev = cur
    end

    local last = points[#points]

    if last and last.wx and last.wy and last.wz then
        return {
            X = last.wx,
            Y = last.wy,
            Z = last.wz,
        }
    end

    return nil
end

function FALLEN_BT_GALAXY_SIZE(world, thick)
    local size =
        34
        + clamp(tonumber(thick) or 2, 1, 6) * 2.5

    local cam = nil

    pcall(function()
        if aim and type(aim.get_camera_position) == "function" then
            cam = aim.get_camera_position()
        elseif rbx and type(rbx.camera) == "function" then
            local c = rbx.camera()
            if c and type(c.camera_pos) == "function" then
                cam = c:camera_pos()
            end
        end
    end)

    if cam
        and world
        and cam.X and cam.Y and cam.Z
    then
        local dx = world.X - cam.X
        local dy = world.Y - cam.Y
        local dz = world.Z - cam.Z
        local dist = math.sqrt(dx * dx + dy * dy + dz * dz)

        -- Same idea as Hit Effect: keep the image readable in world-space
        -- without becoming gigantic close to the camera.
        local dist_scale =
            clamp(
                1.12 - dist / 520,
                0.52,
                1.05
            )

        size = size * dist_scale
    end

    return clamp(size, 18, 48)
end

function FALLEN_BT_DRAW_GALAXY_NODE(handle, x, y, size, alpha)
    if not handle
        or not x
        or not y
        or alpha <= 0.002
    then
        return
    end

    -- Use the exact same image drawing path as Hit Effects when available.
    -- FALLEN_HITFX_DRAW_IMAGE is defined later in the script, but globals are
    -- resolved when this function is called (after the full Lua has loaded).
    if type(FALLEN_HITFX_DRAW_IMAGE) == "function" then
        FALLEN_HITFX_DRAW_IMAGE(
            handle,
            x - size * 0.5,
            y - size * 0.5,
            size,
            size,
            1,
            1,
            1,
            alpha
        )
        return
    end

    if type(DrawImage) == "function" then
        DrawImage(
            handle,
            x - size * 0.5,
            y - size * 0.5,
            size,
            size,
            1,
            1,
            1,
            alpha,
            math.max(2, size * 0.08)
        )
    end
end

function FALLEN_BT_DRAW_GALAXY(
    tr,
    points,
    reveal,
    alpha,
    thick
)
    if type(DrawImage) ~= "function"
        or type(points) ~= "table"
        or #points < 2
    then
        return
    end

    local handle = FALLEN_BT_GALAXY_HANDLE()
    if not handle then
        return
    end

    local max_u = clamp(tonumber(reveal) or 0, 0, 1)
    if max_u <= 0.001 then
        return
    end

    local sx, sy = FALLEN_BT_GALAXY_POINT(points, 0)
    local ex, ey = FALLEN_BT_GALAXY_POINT(points, max_u)
    if not sx or not sy or not ex or not ey then
        return
    end

    local dx = ex - sx
    local dy = ey - sy
    local beam_len = math.sqrt(dx * dx + dy * dy)
    if beam_len <= 1.0 then
        return
    end

    local beam_h = clamp(4.0 + (tonumber(thick) or 2) * 1.55, 5, 12)
    local half_h = beam_h * 0.5
    local created = tonumber(tr and tr.created) or tick()
    local flow = ((tick() - created) * 0.78) % 1
    local col = FALLEN_BT_COLOR()

    if type(DrawLine) == "function" then
        DrawLine(sx, sy, ex, ey, col[1], col[2], col[3], alpha * 0.10, beam_h + 5)
        DrawLine(sx, sy, ex, ey, 1, 1, 1, alpha * 0.13, beam_h + 1.5)
    end

    local horizontal = math.abs(dx) >= math.abs(dy)

    if horizontal then
        local left = math.min(sx, ex)
        local right = math.max(sx, ex)
        local mid_y = (sy + ey) * 0.5
        local u0 = -flow
        local u1 = 1 - flow
        if ex < sx then
            u0, u1 = 1 + flow, flow
        end

        local ok = pcall(
            DrawImage,
            handle,
            left,
            mid_y - half_h,
            math.max(1, right - left),
            beam_h,
            1,
            1,
            1,
            alpha * 0.98,
            beam_h * 0.28,
            u0,
            0,
            u1,
            1
        )

        if not ok then
            pcall(
                DrawImage,
                handle,
                left,
                mid_y - half_h,
                math.max(1, right - left),
                beam_h,
                1,
                1,
                1,
                alpha * 0.98,
                beam_h * 0.28
            )
        end
    else
        local top = math.min(sy, ey)
        local bottom = math.max(sy, ey)
        local mid_x = (sx + ex) * 0.5
        local v0 = -flow
        local v1 = 1 - flow
        if ey < sy then
            v0, v1 = 1 + flow, flow
        end

        local ok = pcall(
            DrawImage,
            handle,
            mid_x - half_h,
            top,
            beam_h,
            math.max(1, bottom - top),
            1,
            1,
            1,
            alpha * 0.98,
            beam_h * 0.28,
            0,
            v0,
            1,
            v1
        )

        if not ok then
            pcall(
                DrawImage,
                handle,
                mid_x - half_h,
                top,
                beam_h,
                math.max(1, bottom - top),
                1,
                1,
                1,
                alpha * 0.98,
                beam_h * 0.28
            )
        end
    end
end

function FALLEN_BT_REVEALED_POINTS(points, reveal)
    if type(points) ~= "table"
        or #points == 0
    then
        return {}
    end

    local max_u =
        clamp(
            tonumber(reveal) or 0,
            0,
            1
        )

    local out = {}
    local first = points[1]

    if not first then
        return out
    end

    -- Keep the first point so the tracer always has a stable origin.
    out[#out + 1] = {
        x = first.x,
        y = first.y,
        u = tonumber(first.u) or 0,
        wx = first.wx,
        wy = first.wy,
        wz = first.wz,
    }

    if max_u <= (tonumber(first.u) or 0) then
        return out
    end

    local prev = first

    for i = 2, #points do
        local cur = points[i]

        if cur
            and prev
            and cur.x
            and cur.y
            and prev.x
            and prev.y
        then
            local pu = tonumber(prev.u) or 0
            local cu = tonumber(cur.u) or pu

            if cu <= max_u + 0.000001 then
                out[#out + 1] = {
                    x = cur.x,
                    y = cur.y,
                    u = cu,
                    wx = cur.wx,
                    wy = cur.wy,
                    wz = cur.wz,
                }

                prev = cur
            else
                -- Reveal ends inside this segment: draw a partial segment
                -- instead of waiting until the next whole sampled point.
                local span = cu - pu

                if span > 0.000001
                    and max_u > pu
                then
                    local t =
                        clamp(
                            (max_u - pu) / span,
                            0,
                            1
                        )

                    local p = {
                        x =
                            prev.x
                            + (cur.x - prev.x) * t,

                        y =
                            prev.y
                            + (cur.y - prev.y) * t,

                        u = max_u,
                    }

                    if prev.wx ~= nil
                        and prev.wy ~= nil
                        and prev.wz ~= nil
                        and cur.wx ~= nil
                        and cur.wy ~= nil
                        and cur.wz ~= nil
                    then
                        p.wx =
                            prev.wx
                            + (cur.wx - prev.wx) * t

                        p.wy =
                            prev.wy
                            + (cur.wy - prev.wy) * t

                        p.wz =
                            prev.wz
                            + (cur.wz - prev.wz) * t
                    end

                    out[#out + 1] = p
                end

                break
            end
        end
    end

    return out
end


function FALLEN_BT_DRAW_WATER(
    tr,
    points,
    reveal,
    alpha,
    thick
)
    if type(points) ~= "table"
        or #points < 2
    then
        return
    end

    local max_u =
        clamp(
            tonumber(reveal) or 0,
            0,
            1
        )

    if max_u <= 0.001 then
        return
    end

    local visible_points =
        FALLEN_BT_REVEALED_POINTS(
            points,
            max_u
        )

    if #visible_points < 2 then
        return
    end

    local col = FALLEN_BT_COLOR()

    -- Our Drawing API cannot rotate/wrap DrawImage along a tracer like a
    -- Roblox Beam texture, so Water is rendered as a continuous layered line.
    local core_thick =
        clamp(
            1.0 + (tonumber(thick) or 2) * 0.38,
            1.25,
            3.4
        )

    local previous = nil

    for i = 1, #visible_points do
        local point = visible_points[i]

        if point
            and point.x
            and point.y
            and point.u
        then
            if previous
                and type(DrawLine) == "function"
            then
                local normalized =
                    clamp(
                        (
                            (previous.u + point.u)
                            * 0.5
                        )
                        / math.max(max_u, 0.0001),
                        0,
                        1
                    )

                -- Fallen Ultimate Water uses Color -> white -> Color.
                local white_mix =
                    clamp(
                        1
                        - math.abs(
                            (normalized - 0.5) * 2
                        ),
                        0,
                        1
                    )

                local rr =
                    col[1]
                    + (1 - col[1]) * white_mix

                local gg =
                    col[2]
                    + (1 - col[2]) * white_mix

                local bb =
                    col[3]
                    + (1 - col[3]) * white_mix

                -- Wide soft water glow.
                DrawLine(
                    previous.x,
                    previous.y,
                    point.x,
                    point.y,
                    col[1],
                    col[2],
                    col[3],
                    alpha * 0.10,
                    core_thick + 6.0
                )

                -- Secondary translucent body.
                DrawLine(
                    previous.x,
                    previous.y,
                    point.x,
                    point.y,
                    rr,
                    gg,
                    bb,
                    alpha * 0.30,
                    core_thick + 2.3
                )

                -- Main continuous beam.
                DrawLine(
                    previous.x,
                    previous.y,
                    point.x,
                    point.y,
                    rr,
                    gg,
                    bb,
                    alpha * 0.92,
                    core_thick
                )

                -- Thin bright center to imitate wet/refraction highlight.
                DrawLine(
                    previous.x,
                    previous.y,
                    point.x,
                    point.y,
                    1,
                    1,
                    1,
                    alpha
                    * (
                        0.12
                        + 0.30 * white_mix
                    ),
                    math.max(
                        0.75,
                        core_thick * 0.34
                    )
                )
            end

            previous = point
        end
    end
end


function FALLEN_BT_DRAW_LAVA(
    tr,
    points,
    reveal,
    alpha,
    thick
)
    if type(points) ~= "table"
        or #points < 2
        or type(DrawLine) ~= "function"
    then
        return
    end

    local max_u =
        clamp(
            tonumber(reveal) or 0,
            0,
            1
        )

    if max_u <= 0.001 then
        return
    end

    local visible_points =
        FALLEN_BT_REVEALED_POINTS(
            points,
            max_u
        )

    if #visible_points < 2 then
        return
    end

    local core_thick =
        clamp(
            0.95 + (tonumber(thick) or 2) * 0.34,
            1.15,
            3.15
        )

    local yellow = { 1.00, 0.90, 0.06 }
    local orange = { 1.00, 0.30, 0.015 }

    local previous = nil

    for i = 1, #visible_points do
        local point = visible_points[i]

        if point
            and point.x
            and point.y
            and point.u
        then
            local current = {
                x = point.x,
                y = point.y,
                u = point.u,
            }

            if previous then
                local normalized =
                    clamp(
                        (
                            (previous.u + current.u)
                            * 0.5
                        )
                        / math.max(max_u, 0.0001),
                        0,
                        1
                    )

                local center_mix =
                    clamp(
                        1
                        - math.abs(
                            (normalized - 0.5) * 2
                        ),
                        0,
                        1
                    )

                local rr =
                    yellow[1]
                    + (orange[1] - yellow[1]) * center_mix

                local gg =
                    yellow[2]
                    + (orange[2] - yellow[2]) * center_mix

                local bb =
                    yellow[3]
                    + (orange[3] - yellow[3]) * center_mix

                -- Strong soft glow: 35 close layers.
                for g = 35, 1, -1 do
                    local gt = g / 35

                    local glow_width =
                        core_thick
                        + 0.55
                        + g * 0.18

                    local glow_alpha =
                        alpha
                        * (
                            0.020
                            + (1 - gt) * 0.018
                        )

                    DrawLine(
                        previous.x,
                        previous.y,
                        current.x,
                        current.y,
                        rr,
                        gg,
                        bb,
                        glow_alpha,
                        glow_width
                    )
                end

                DrawLine(
                    previous.x,
                    previous.y,
                    current.x,
                    current.y,
                    rr,
                    gg,
                    bb,
                    alpha * 0.10,
                    core_thick + 8.5
                )

                DrawLine(
                    previous.x,
                    previous.y,
                    current.x,
                    current.y,
                    rr,
                    gg,
                    bb,
                    alpha * 0.16,
                    core_thick + 5.2
                )

                DrawLine(
                    previous.x,
                    previous.y,
                    current.x,
                    current.y,
                    rr,
                    gg,
                    bb,
                    alpha * 0.98,
                    core_thick
                )

                local hg =
                    0.96
                    - 0.30 * center_mix

                local hb =
                    0.34
                    - 0.23 * center_mix

                DrawLine(
                    previous.x,
                    previous.y,
                    current.x,
                    current.y,
                    1.0,
                    hg,
                    hb,
                    alpha * 0.72,
                    math.max(
                        0.75,
                        core_thick * 0.40
                    )
                )
            end

            previous = current
        end
    end
end


function FALLEN_BT_ANIMATION_NAME()
    local name =
        tostring(
            S.bullet_tracer_animation
            or "None"
        )

    if name ~= "None"
        and name ~= "Sway"
        and name ~= "Wave"
    then
        S.bullet_tracer_animation = "None"
        name = "None"
    end

    return name
end


function FALLEN_BT_APPLY_ANIMATION(
    tr,
    points
)
    if type(points) ~= "table"
        or #points < 2
    then
        return points
    end

    local mode =
        FALLEN_BT_ANIMATION_NAME()

    if mode == "None" then
        return points
    end

    local now = tick()
    local seed =
        tonumber(tr and tr.seed)
        or 1

    local out = {}

    for i = 1, #points do
        local point = points[i]

        if point
            and point.x
            and point.y
            and point.u
        then
            local px = point.x
            local py = point.y

            local p0 =
                points[
                    math.max(
                        1,
                        i - 1
                    )
                ]

            local p1 =
                points[
                    math.min(
                        #points,
                        i + 1
                    )
                ]

            if p0
                and p1
                and p0.x
                and p0.y
                and p1.x
                and p1.y
            then
                local dx = p1.x - p0.x
                local dy = p1.y - p0.y

                local len =
                    math.sqrt(
                        dx * dx
                        + dy * dy
                    )

                if len > 0.01 then
                    local nx = -dy / len
                    local ny = dx / len

                    local u =
                        clamp(
                            tonumber(point.u) or 0,
                            0,
                            1
                        )

                    -- Keep muzzle/origin and Hole pinned.
                    local edge =
                        math.sin(
                            u * math.pi
                        )

                    local offset = 0

                    if mode == "Sway" then
                        -- Old Solar/Lava motion: one smooth slow side-to-side bow.
                        offset =
                            math.sin(
                                now * 1.95
                                + seed * 0.011
                                + u * 5.0
                            )
                            * 1.55
                            * edge

                    elseif mode == "Wave" then
                        -- A clear travelling wave through the tracer.
                        offset =
                            math.sin(
                                now * 3.00
                                + seed * 0.013
                                + u * 12.0
                            )
                            * 2.15
                            * edge
                    end

                    px = px + nx * offset
                    py = py + ny * offset
                end
            end

            out[#out + 1] = {
                x = px,
                y = py,
                u = point.u,
                wx = point.wx,
                wy = point.wy,
                wz = point.wz,
            }
        end
    end

    if #out >= 2 then
        return out
    end

    return points
end


function FALLEN_BT_DRAW_PATH(
    tr,
    points,
    reveal,
    alpha,
    thick
)
    if type(points) ~= "table"
        or #points < 2
        or type(DrawLine) ~= "function"
    then
        return
    end

    local style =
        FALLEN_BT_STYLE_INDEX()

    if style == 3 then
        FALLEN_BT_DRAW_WATER(
            tr,
            points,
            reveal,
            alpha,
            thick
        )
        return
    elseif style == 4 then
        FALLEN_BT_DRAW_LAVA(
            tr,
            points,
            reveal,
            alpha,
            thick
        )
        return
    end

    local max_u =
        clamp(
            reveal,
            0,
            1
        )

    local visible_points =
        FALLEN_BT_REVEALED_POINTS(
            points,
            max_u
        )

    if #visible_points < 2 then
        return
    end

    local previous = nil

    for i = 1, #visible_points do
        local point =
            visible_points[i]

        if point
            and point.x
            and point.y
            and point.u
        then
            local px = point.x
            local py = point.y

            if style == 1 then
                -- Lightning keeps the ballistic curve and only waves around it.
                local prev_for_normal =
                    previous
                    or point

                local dx =
                    px - (prev_for_normal.x or px)

                local dy =
                    py - (prev_for_normal.y or py)

                local len =
                    math.sqrt(
                        dx * dx
                        + dy * dy
                    )

                if len > 0.01 then
                    local nx = -dy / len
                    local ny = dx / len

                    local offset =
                        math.sin(
                            point.u * 54
                            + (tr.seed or 1) * 0.017
                            + tick() * 4
                        ) * 2.25

                    px = px + nx * offset
                    py = py + ny * offset
                end
            end

            local current = {
                x = px,
                y = py,
                u = point.u,
            }

            if previous then
                if style == 2 then
                    -- Rainbow.
                    local hue =
                        (
                            tick() * 0.20
                            + point.u * 0.92
                            + ((tr.seed or 1) % 97) / 97
                        ) % 1

                    local rr, gg, bb =
                        hsv_to_rgb(
                            hue,
                            0.88,
                            1
                        )

                    DrawLine(previous.x, previous.y, current.x, current.y,
                        rr, gg, bb, alpha * 0.12, thick + 14)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        rr, gg, bb, alpha * 0.32, thick + 7)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        rr, gg, bb, alpha * 0.96, thick + 1.5)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        1, 1, 1, alpha * 0.24, 1)

                elseif style == 1 then
                    local col = FALLEN_BT_COLOR()

                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.15, thick + 5)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.36, thick + 2)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.92, thick)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        1, 1, 1, alpha * 0.44, 1)

                else
                    -- Neon.
                    local col = FALLEN_BT_COLOR()

                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.10, thick + 12)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.20, thick + 8)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.38, thick + 5)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.78, thick + 2)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        1, 1, 1, alpha * 0.62, math.max(1, thick - 0.35))
                end
            end

            previous = current
        end
    end
end

function FALLEN_BT_PREDICTION_PATH(tr)
    local points = {}

    local total_time =
        clamp(
            tonumber(tr.prediction_time) or 0,
            0,
            3
        )

    local gravity =
        tonumber(tr.gravity)
        or 0

    if tr.auto_prediction ~= true
        or total_time <= 0.0001
    then
        return points
    end

    -- fap_predict() adds +0.5*g*T^2 to the aim point.
    -- Subtract it to recover the future impact position, then rebuild the
    -- actual projectile parabola with the SAME T and gravity.
    local drop =
        0.5
        * gravity
        * total_time
        * total_time

    local impact_x = tr.tx
    local impact_y = tr.ty - drop
    local impact_z = tr.tz

    local vx =
        (impact_x - tr.ox)
        / total_time

    local vy =
        (impact_y - tr.oy)
        / total_time
        + 0.5
        * gravity
        * total_time

    local vz =
        (impact_z - tr.oz)
        / total_time

    local steps = 48

    for i = 0, steps do
        local u = i / steps
        local t = total_time * u

        local world = {
            X = tr.ox + vx * t,
            Y = tr.oy + vy * t - 0.5 * gravity * t * t,
            Z = tr.oz + vz * t,
        }

        local s = FALLEN_BT_PROJECT(world)

        if s then
            points[#points + 1] = {
                x = s.X,
                y = s.Y,
                u = u,
                wx = world.X,
                wy = world.Y,
                wz = world.Z,
            }
        end
    end

    return points
end

function FALLEN_BT_STRAIGHT_PATH(tr)
    local points = {}
    local steps = 32

    for i = 0, steps do
        local u = i / steps

        local world = {
            X = tr.ox + (tr.tx - tr.ox) * u,
            Y = tr.oy + (tr.ty - tr.oy) * u,
            Z = tr.oz + (tr.tz - tr.oz) * u,
        }

        local s = FALLEN_BT_PROJECT(world)

        if s then
            points[#points + 1] = {
                x = s.X,
                y = s.Y,
                u = u,
                wx = world.X,
                wy = world.Y,
                wz = world.Z,
            }
        end
    end

    return points
end

function FALLEN_BT_DRAW_ONE(tr, age, life)
    local reveal_time =
        clamp(
            tonumber(S.bullet_tracer_reveal) or 0.22,
            0.03,
            1.50
        )

    local reveal_raw =
        clamp(
            age / reveal_time,
            0,
            1
        )

    -- Smooth continuous reveal. Exact endpoint interpolation above prevents
    -- the tracer tip from advancing sample-by-sample.
    local reveal =
        reveal_raw
        * reveal_raw
        * (3 - 2 * reveal_raw)

    local fade =
        clamp(
            1 - age / life,
            0,
            1
        )

    local col = FALLEN_BT_COLOR()
    local alpha = fade * (col[4] or 1)

    local thick =
        clamp(
            tonumber(S.bullet_tracer_thickness) or 2,
            1,
            6
        )

    if alpha <= 0.002 then
        return
    end

    local points

    if tr.auto_prediction == true
        and (tonumber(tr.prediction_time) or 0) > 0
    then
        points = FALLEN_BT_PREDICTION_PATH(tr)
    else
        points = FALLEN_BT_STRAIGHT_PATH(tr)
    end

    points =
        FALLEN_BT_APPLY_ANIMATION(
            tr,
            points
        )

    FALLEN_BT_DRAW_PATH(
        tr,
        points,
        reveal,
        alpha,
        thick
    )
end
function FALLEN_BT_DRAW()
    if type(FALLEN_BT.items) ~= "table" then
        FALLEN_BT.items = {}
    end

    local now = tick()

    local life =
        clamp(
            tonumber(S.bullet_tracer_life) or 1.2,
            0.10,
            8.0
        )

    for i = #FALLEN_BT.items, 1, -1 do
        local tr = FALLEN_BT.items[i]
        local age = now - (tr.created or now)

        if age > life
            or S.bullet_tracer_enabled ~= true
        then
            table.remove(FALLEN_BT.items, i)
        else
            FALLEN_BT_DRAW_ONE(
                tr,
                age,
                life
            )
        end
    end
end

function FALLEN_BT_TICK()
    if _G.FallenMenuReady ~= true then
