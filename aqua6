function FALLEN_START_IMAGE_PRELOAD()
    if _G.FALLEN_IMAGE_PRELOAD_STARTED == true then
        return
    end

    _G.FALLEN_IMAGE_PRELOAD_STARTED = true

    local create =
        thread
        and (
            thread.create
            or thread.Create
        )

    local stop =
        thread
        and (
            thread.stop
            or thread.Stop
        )

    if type(create) == "function" then
        local worker_id = nil

        local function worker()
            if _G.FALLEN_IMAGE_PRELOAD_DONE ~= true then
                pcall(
                    FALLEN_PRELOAD_ALL_IMAGES_SEQUENTIAL
                )
            end

            if worker_id
                and type(stop) == "function"
            then
                pcall(
                    stop,
                    worker_id
                )
            end
        end

        local ok, id =
            pcall(
                create,
                worker,
                25
            )

        if ok and id then
            worker_id = id
            _G.FALLEN_IMAGE_PRELOAD_WORKER = id
            return
        end
    end

    -- Fallback: if thread.* does not exist, do not hammer LoadImage with the
    -- entire library. Start only the critical grenade + UI icons immediately.
    pcall(
        FALLEN_GRENADE_ICON_GET
    )

    pcall(
        FALLEN_BRAND_IMAGE_GET
    )

    pcall(
        FALLEN_AIMBOT_TAB_ICON_GET
    )

    -- No thread API: hit-effect sheets still begin loading immediately.
