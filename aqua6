local function world_color_prefix(id)
    return "world_color_" .. tostring(id)
end


local function world_color_from_prefix(prefix)
    local h = tonumber(S[prefix .. "_h"]) or 0
    local s = tonumber(S[prefix .. "_s"]) or 0
    local v = tonumber(S[prefix .. "_v"]) or 1
    local a = clamp((tonumber(S[prefix .. "_alpha"]) or 100) / 100, 0, 1)

    A.world_color_cache = A.world_color_cache or {}
    local cached = A.world_color_cache[prefix]

    if cached
        and cached.h == h
        and cached.s == s
        and cached.v == v
        and cached.a == a
    then
        return cached.color
    end

    local r, g, b = hsv_to_rgb(h, s, v)
    local color = { r, g, b, a }

    A.world_color_cache[prefix] = {
        h = h,
        s = s,
        v = v,
        a = a,
        color = color,
    }

    return color
end

local function world_item_color(item)
    if not item or not item.id then
        return { 1, 1, 1, 1 }
    end

    return
        world_color_from_prefix(
            world_color_prefix(item.id)
        )
end

local function world_square_swatch(x, y, size, c)
    -- Matching 4px rounded-square swatches across the entire interface.
    rounded_outline(x, y, size, size, 4,
        { 0.16, 0.16, 0.17, 1 }, 1,
        { c[1], c[2], c[3], math.max(c[4] or 1, 0.01) })
end

local function resource_toggle_row(
    mx,
    my,
    clicked,
    x,
    y,
    w,
    item
)
    local h = 41
    local hot = row_hover(mx, my, x, y, w, h)
    if hot then
        rounded_fill(x + 5, y + 4, w - 10, h - 8, 5, C.button_hovered)
    end

    local c =
        world_item_color(
            item
        )

    local key = item.key

    if A.toggles[key] == nil then
        A.toggles[key] = S[key] and 1 or 0
    end

    local target = S[key] and 1 or 0
    A.toggles[key] = lerp(A.toggles[key], target, 0.23)
    local check_anim = clamp(A.toggles[key], 0, 1)

    text(
        x + 12 + 17 * check_anim,
        y + 14,
        item.label,
        FALLEN_HOVER_TEXT(
            "resource:" .. tostring(item.id),
            hot,
            mix_color(C.text_dim, C.text, check_anim)
        )
    )

    -- Compact Neverlose-like checklist: check at left, color at far right.
    local swatch_s = 18
    local swatch_x = x + w - swatch_s - 12
    local swatch_y = y + 11
    local swatch_hot = hover(mx, my,
        swatch_x, swatch_y, swatch_s, swatch_s)
    world_square_swatch(swatch_x, swatch_y, swatch_s, c)

    if check_anim > 0.015 then
        local cx, cy = x + 16, y + 20.5
        local tick_color = alpha(C.text, check_anim)
        line(cx - 5, cy, cx - 1, cy + 4, tick_color, 1.4)
        line(cx - 1, cy + 4, cx + 6, cy - 4, tick_color, 1.4)
    end

    if clicked and swatch_hot then
        local prefix =
            world_color_prefix(
                item.id
            )

        FALLEN_COLOR_INPUT_STOP(true)

        if A.world_color_picker_open
            and A.world_color_picker_key == prefix
        then
            A.world_color_picker_open = false
            A.world_color_picker_drag = nil
        else
            A.world_color_picker_key = prefix
            A.world_color_picker_open = true
            A.world_color_picker_drag = nil
            A.fov_picker_open = false
            A.fov_picker_drag = nil
        end

        A.world_color_picker_anchor_x =
            FALLEN_UI_X(swatch_x)

        A.world_color_picker_anchor_y =
            FALLEN_UI_Y(swatch_y)

        A.world_color_picker_anchor_w =
            FALLEN_UI_LEN(swatch_s)

        A.world_color_picker_anchor_h =
            FALLEN_UI_LEN(swatch_s)

        if numeric_stop then
            numeric_stop(true)
        end

        return
    end

    if clicked and hot then
        S[key] = not S[key]

        _G.FALLEN_WORLD_FORCE_RESCAN = true
    end

end


local function world_settings_step_anim()
    local now = tick()

    if A.world_settings_last_t == nil then
        A.world_settings_last_t = now
    end

    local dt =
        clamp(
            now - A.world_settings_last_t,
            0,
            0.05
        )

    A.world_settings_last_t = now

    local target =
        A.world_settings_open
        and 1
        or 0

    -- Slightly slower than Aimbot popup by request.
    local speed = 14

    A.world_settings_anim =
        exp_chase(
            A.world_settings_anim or 0,
            target,
            speed,
            dt
        )

    if target == 0
        and (A.world_settings_anim or 0) < 0.018
    then
        A.world_settings_anim = 0
    elseif target == 1
        and (A.world_settings_anim or 0) > 0.992
    then
        A.world_settings_anim = 1
    end

    return
        clamp(
            A.world_settings_anim or 0,
            0,
            1
        )
end

local function draw_world_color_picker(mx, my, clicked, lmb)

    local now = tick()

    if A.world_color_picker_last_t == nil then
        A.world_color_picker_last_t = now
    end

    local dt =
        clamp(
            now - A.world_color_picker_last_t,
            0,
            0.05
        )

    A.world_color_picker_last_t = now

    local target =
        A.world_color_picker_open
        and 1
        or 0

    local speed =
        target > (A.world_color_picker_anim or 0)
        and 13.0
        or 10.0

    A.world_color_picker_anim =
        exp_chase(
            A.world_color_picker_anim or 0,
            target,
            speed,
            dt
        )

    if target == 0
        and (A.world_color_picker_anim or 0) < 0.012
    then
        A.world_color_picker_anim = 0
        A.world_color_picker_drag = nil
        FALLEN_COLOR_INPUT_STOP(true)
        return
    end

    if not A.world_color_picker_key then
        return
    end

    local anim =
        clamp(
            A.world_color_picker_anim or 0,
            0,
            1
        )

    local ease = smooth01(anim)

    local prefix =
        A.world_color_picker_key

    local anchor_x =
        tonumber(A.world_color_picker_anchor_x)
        or mx
        or 0

    local anchor_y =
        tonumber(A.world_color_picker_anchor_y)
        or my
        or 0

    -- All color previews use the same compact square geometry.
    local anchor_w = 18
    local anchor_h = 18

    local pw = 230
    local ph = 322

    local dims = nil
    pcall(function()
        dims = ScreenSize()
    end)

    local screen_w =
        dims
        and tonumber(dims.Width or dims.X)
        or 1920

    local screen_h =
        dims
        and tonumber(dims.Height or dims.Y)
        or 1080

    local gap = 12

    local left_px =
        anchor_x
        - pw
        - gap

    local right_px =
        anchor_x
        + anchor_w
        + gap

    local px = nil

    if left_px >= 8 then
        px = left_px
    elseif right_px + pw <= screen_w - 8 then
        px = right_px
    else
        px =
            clamp(
                anchor_x - pw * 0.5,
                8,
                math.max(8, screen_w - pw - 8)
            )
    end

    local py =
        clamp(
            anchor_y - 14,
            8,
            math.max(8, screen_h - ph - 8)
        )

    local attach_x =
        px < anchor_x
        and (px + pw)
        or px

    px =
        px
        + (anchor_x - attach_x)
        * (1 - ease)
        * 0.10

    py =
        py
        + (anchor_y - py)
        * (1 - ease)
        * 0.06

    px = snap(px)
    py = snap(py)

    local parent_transform =
        MENU_UI_TRANSFORM_ACTIVE

    local parent_alpha =
        MENU_RENDER_ALPHA

    MENU_UI_TRANSFORM_ACTIVE = false

    MENU_RENDER_ALPHA =
        parent_alpha
        * ease

    FALLEN_POPUP_GLOW(
        px,
        py,
        pw,
        ph,
        12,
        ease
    )

    rounded_fill(
        px,
        py,
        pw,
        ph,
        4,
        C.frame_inactive
    )

    rounded_outline(
        px,
        py,
        pw,
        ph,
        4,
        C.border,
        1,
        C.frame_inactive
    )

    text(
        px + 14,
        py + 10,
        "Color",
        C.text_dim
    )

    local pad = 14
    local sv_x = px + pad
    local sv_y = py + pad + 20
    local sv_w = pw - pad * 2
    local sv_h = 174

    local hue =
        tonumber(
            S[prefix .. "_h"]
        )
        or 0

    local smooth_w =
        math.max(
            1,
            math.floor(sv_w + 0.5)
        )

    local smooth_h =
        math.max(
            1,
            math.floor(sv_h + 0.5)
        )

    for xx = 0, smooth_w - 1 do
        local sat =
            smooth_w > 1
            and (xx / (smooth_w - 1))
            or 0

        local r, g, b =
            hsv_to_rgb(
                hue,
                sat,
                1
            )

        fill(
            sv_x + xx,
            sv_y,
            1,
            smooth_h,
            { r, g, b, 1 }
        )
    end

    for yy = 0, smooth_h - 1 do
        local black_alpha =
            smooth_h > 1
            and (yy / (smooth_h - 1))
            or 0

        if black_alpha > 0 then
            fill(
                sv_x,
                sv_y + yy,
                smooth_w,
                1,
                { 0, 0, 0, black_alpha }
            )
        end
    end

    local sv_hot =
        hover(
            mx,
            my,
            sv_x,
            sv_y,
            sv_w,
            sv_h
        )

    if clicked and sv_hot then
        FALLEN_COLOR_INPUT_STOP(true)
        A.world_color_picker_drag = "sv"
    end

    if A.world_color_picker_drag == "sv"
        and lmb
    then
        S[prefix .. "_s"] =
            clamp(
                (mx - FALLEN_UI_X(sv_x)) / FALLEN_UI_LEN(sv_w),
                0,
                1
            )

        S[prefix .. "_v"] =
            1
            - clamp(
                (my - FALLEN_UI_Y(sv_y)) / FALLEN_UI_LEN(sv_h),
                0,
                1
            )
    end

    local cursor_x =
        sv_x
        + clamp(
            tonumber(S[prefix .. "_s"]) or 0,
            0,
            1
        )
        * sv_w

    local cursor_y =
        sv_y
        + (
            1
            - clamp(
                tonumber(S[prefix .. "_v"]) or 1,
                0,
                1
            )
        )
        * sv_h

    circle(
        cursor_x + 1,
        cursor_y + 1,
        5,
        { 0, 0, 0, 0.25 },
        1
    )

    circle(
        cursor_x,
        cursor_y,
        5,
        C.text,
        2
    )

    local hue_y =
        sv_y
        + sv_h
        + 13

    local hue_h = 14

    local hue_width =
        math.max(
            1,
            math.floor(sv_w + 0.5)
        )

    for xx = 0, hue_width - 1 do
        local h0 =
            hue_width > 1
            and (xx / (hue_width - 1))
            or 0

        local r, g, b =
            hsv_to_rgb(
                h0,
                1,
                1
            )

        fill(
            sv_x + xx,
            hue_y,
            1,
            hue_h,
            { r, g, b, 1 }
        )
    end

    local hue_hot =
        hover(
            mx,
            my,
            sv_x,
            hue_y,
            sv_w,
            hue_h
        )

    if clicked and hue_hot then
        FALLEN_COLOR_INPUT_STOP(true)
        A.world_color_picker_drag = "hue"
    end

    if A.world_color_picker_drag == "hue"
        and lmb
    then
        S[prefix .. "_h"] =
            clamp(
                (mx - FALLEN_UI_X(sv_x)) / FALLEN_UI_LEN(sv_w),
                0,
                1
            )
    end

    local hue_x =
        sv_x
        + clamp(
            tonumber(S[prefix .. "_h"]) or 0,
            0,
            1
        )
        * sv_w

    local hr, hg, hb =
        hsv_to_rgb(
            clamp(
                tonumber(S[prefix .. "_h"]) or 0,
                0,
                1
            ),
            1,
            1
        )

    circle_fill(
        hue_x,
        hue_y + hue_h * 0.5,
        6,
        { hr, hg, hb, 1 }
    )

    -- Transparency slider restored.
    -- Alpha is ALSO mirrored in the last two HEX8 chars.
    local alpha_y =
        hue_y + 29

    local alpha_h = 14

    checker_strip(
        sv_x,
        alpha_y,
        sv_w,
        alpha_h
    )

    local current =
        world_color_from_prefix(
            prefix
        )

    local alpha_width =
        math.max(
            1,
            math.floor(sv_w + 0.5)
        )

    for xx = 0, alpha_width - 1 do
        local a =
            alpha_width > 1
            and (xx / (alpha_width - 1))
            or 0

        fill(
            sv_x + xx,
            alpha_y,
            1,
            alpha_h,
            {
                current[1],
                current[2],
                current[3],
                a,
            }
        )
    end

    local alpha_hot =
        hover(
            mx,
            my,
            sv_x,
            alpha_y,
            sv_w,
            alpha_h
        )

    if clicked and alpha_hot then
        FALLEN_COLOR_INPUT_STOP(true)
        A.world_color_picker_drag = "alpha"
    end

    if A.world_color_picker_drag == "alpha"
        and lmb
    then
        S[prefix .. "_alpha"] =
            math.floor(
                clamp(
                    (mx - FALLEN_UI_X(sv_x)) / FALLEN_UI_LEN(sv_w),
                    0,
                    1
                )
                * 100
                + 0.5
            )
    end

    local alpha_x =
        sv_x
        + clamp(
            (tonumber(S[prefix .. "_alpha"]) or 100) / 100,
            0,
            1
        )
        * sv_w

    circle_fill(
        alpha_x,
        alpha_y + alpha_h * 0.5,
        6,
        current
    )

    circle(
        alpha_x,
        alpha_y + alpha_h * 0.5,
        6,
        C.text,
        1
    )

    -- No percentage text field; only HEX8 below the slider.
    local field_y =
        alpha_y + 29

    current =
        world_color_from_prefix(
            prefix
        )

    local hex =
        FALLEN_RGBA_HEX(
            current[1],
            current[2],
            current[3],
            current[4]
        )

    local hex_x = sv_x
    local hex_w = sv_w

    local hex_hot =
        hover(
            mx,
            my,
            hex_x,
            field_y,
            hex_w,
            31
        )

    local hex_focus =
        FALLEN_COLOR_INPUT_IS(
            "hex",
            prefix
        )

    rounded_fill(
        hex_x,
        field_y,
        hex_w,
        31,
        7,
        hex_focus
            and { 0.112, 0.118, 0.145, 1 }
            or (
                hex_hot
                and { 0.104, 0.108, 0.128, 1 }
                or { 0.095, 0.098, 0.112, 1 }
            )
    )

    if hex_focus then
        rounded_outline(
            hex_x,
            field_y,
            hex_w,
            31,
            7,
            alpha(C.accent, 0.72),
            1,
            { 0.112, 0.118, 0.145, 1 }
        )
    end

    text(
        hex_x + 10,
        field_y + 9,
        "HEX8",
        C.text_dim
    )

    local shown_hex =
        hex_focus
        and (
            "#"
            .. tostring(
                A.color_input.buffer
                or ""
            )
            .. (
                math.floor(tick() * 2) % 2 == 0
                and "|"
                or ""
            )
        )
        or hex

    text(
        hex_x + 56,
        field_y + 9,
        shown_hex,
        C.text
    )

    if clicked and hex_hot then
        A.world_color_picker_drag = nil

        FALLEN_COLOR_INPUT_START(
            "hex",
            prefix
        )
    end

    if not lmb then
        A.world_color_picker_drag = nil
    end

    local popup_hot =
        hover(
            mx,
            my,
            px,
            py,
            pw,
            ph
        )

    local swatch_hot =
        hover(
            mx,
            my,
            anchor_x,
            anchor_y,
            anchor_w,
            anchor_h
        )

    local interactive =
        A.world_color_picker_open
        and anim > 0.80

    if interactive
        and clicked
        and swatch_hot
    then
        A.world_color_picker_open = false
        A.world_color_picker_drag = nil
        FALLEN_COLOR_INPUT_STOP(true)
    elseif interactive
        and clicked
        and not popup_hot
        and not swatch_hot
    then
        A.world_color_picker_open = false
        A.world_color_picker_drag = nil
        FALLEN_COLOR_INPUT_STOP(true)
    end

    MENU_UI_TRANSFORM_ACTIVE =
        parent_transform

    MENU_RENDER_ALPHA =
        parent_alpha
end

-- Progressive nested settings in the World ESP three-dots panel.
-- Uses the existing S keys, so configs and runtime remain untouched.
-- Persist animation fractions independently from the saved config.
local function world_global_nested_progress()
    local now = tick()
    local icon_target = S.world_show_icons == true and 1 or 0
    local glow_target = (S.world_show_icons == true
        and S.world_icon_glow_enabled == true) and 1 or 0

    if A.world_nested_last_t == nil then
        A.world_nested_last_t = now
        A.world_nested_icons = icon_target
        A.world_nested_glow = glow_target
    end

    local dt = clamp(now - A.world_nested_last_t, 0, 0.05)
    A.world_nested_last_t = now
    A.world_nested_icons = exp_chase(
        A.world_nested_icons or 0, icon_target, 14, dt)
    A.world_nested_glow = exp_chase(
        A.world_nested_glow or 0, glow_target, 14, dt)

    if math.abs(A.world_nested_icons - icon_target) < 0.001 then
        A.world_nested_icons = icon_target
    end
    if math.abs(A.world_nested_glow - glow_target) < 0.001 then
        A.world_nested_glow = glow_target
    end

    return clamp(A.world_nested_icons, 0, 1),
        clamp(A.world_nested_glow, 0, 1)
end

local function draw_world_settings_popup(
    mx,
    my,
    clicked,
    lmb,
    dots_x,
    dots_y
)
    local raw =
        world_settings_step_anim()

    if raw <= 0.001
        and not A.world_settings_open
    then
        return
    end

    local group =
        tostring(
            A.world_settings_group
            or "global"
        )

    local is_global =
        group == "global"

    local is_nodes =
        group == "nodes"

    local is_plants =
        group == "plants"

    local is_bases =
        group == "bases"

    local is_drops =
        group == "drops"

    local is_bodybag =
        group == "bodybag"

    local is_grenade =
        group == "grenade"

    local title = "World ESP settings"
    local pw = 328
    local ph = 174
    local nested_icons, nested_glow = 0, 0

    if is_global then
        nested_icons, nested_glow = world_global_nested_progress()
        title = "World ESP settings"
        pw = 306
        -- 4 always-visible rows + 3 Show Icons children + 2 Glow children.
        -- The panel stays anchored, its content grows only when enabled.
        ph = 39 + 4 * 41 + 3 * 41 * nested_icons
            + 2 * 41 * nested_glow + 6
    elseif is_nodes then
        title = "Node ESP settings"
        ph = 43 + 3 * 41 + 8
    elseif is_plants then
        title = "Plant ESP settings"
        ph = 43 + 7 * 41 + 8
    elseif is_bases then
        title = "Base ESP settings"
        pw = 620
        ph = 43 + 11 * 41 + 8
    elseif is_drops then
        title = "Dropped Items settings"
        pw = 306
        ph = 92
    elseif is_bodybag then
        title = "Body Bag ESP settings"
        pw = 306
        ph = 92
    elseif is_grenade then
        title = "Visual Grenade settings"
        pw = 306
        ph = 92
    end

    local parent_alpha =
        MENU_RENDER_ALPHA

    local fade =
        ease_out_cubic(raw)

    MENU_RENDER_ALPHA =
        parent_alpha
        * fade

    local anim =
        A.world_settings_open
        and ease_out_cubic(raw)
        or ease_in_out_cubic(raw)

    local base_px =
        dots_x
        - pw
        + 28

    local base_py =
        dots_y
        + 31

    -- Popup stays anchored and full-sized; only its alpha animates.
    local px = snap(base_px)
    local py = snap(base_py)
    local shell_h = ph

    local interactive =
        raw > 0.96
        and A.world_settings_open

    local ui_clicked =
        clicked
        and interactive
        and not A.world_color_picker_open

    FALLEN_POPUP_GLOW(
        px,
        py,
        pw,
        shell_h,
        11,
        1
    )

    rounded_fill(
        px,
        py,
        pw,
        shell_h,
        11,
        C.group_box_bg
    )

    text(
        px + 13,
        py + 12,
        title,
        C.text
    )

    if shell_h > 39 then
        line(
            px + 12,
            py + 34,
            px + pw - 12,
            py + 34,
            C.divider,
            1
        )
    end

    -- =========================================================
    -- GLOBAL World ESP settings.
    -- Restores the complete old "Enable Resource ESP" settings.
    -- =========================================================
    if is_global then
        -- Top level: only the four basic settings are initially visible.
        -- When Show Icons is checked its children are unfolded below;
        -- Icon Glow has its own nested level.
        local row_x, row_w = px + 8, pw - 16
        local row_h = 41
        local y0 = py + 39

        local function separator(y)
            line(px + 12, y, px + pw - 12, y, C.divider, 1)
        end

        slider_row(mx, my, ui_clicked, lmb,
            row_x, y0, row_w, "Max Distance",
            "world_max_dist", 25, 2000, "int")
        separator(y0 + row_h - 1)

        toggle_row(mx, my, ui_clicked,
            row_x, y0 + row_h, row_w,
            "Show Names", "world_show_names", false)
        separator(y0 + 2 * row_h - 1)

        toggle_row(mx, my, ui_clicked,
            row_x, y0 + 2 * row_h, row_w,
            "Show Distance", "world_show_distance", false)
        separator(y0 + 3 * row_h - 1)

        local icons_y = y0 + 3 * row_h
        local icon_color_x = row_x + row_w - 33
        local icon_color_y = icons_y + 11
        local icon_color_hot = hover(mx, my,
            icon_color_x - 4, icon_color_y - 4, 26, 26)
        toggle_row(mx, my, ui_clicked and not icon_color_hot,
            row_x, icons_y, row_w,
            "Show Icons", "world_show_icons", false)
        world_square_swatch(icon_color_x, icon_color_y, 18,
            world_color_from_prefix("world_icon_border"))
        if ui_clicked and icon_color_hot then
            fallen_open_color_at("world_icon_border",
                icon_color_x, icon_color_y, 18)
        end

        local child_y = y0 + 4 * row_h
        local child_h = row_h * nested_icons
        local child_alpha = ease_out_cubic(
            clamp((nested_icons - 0.22) / 0.78, 0, 1))
        local child_click = ui_clicked and nested_icons > 0.96
        local saved_popup_alpha = MENU_RENDER_ALPHA

        if nested_icons > 0.015 then
            MENU_RENDER_ALPHA = saved_popup_alpha * child_alpha
            -- Extra indent distinguishes the nested settings from the basic ones.
            separator(child_y - 1)
            toggle_row(mx, my, child_click,
                row_x + 13, child_y, row_w - 13,
                "Fade by Distance", "world_fade_distance", false)
            separator(child_y + child_h - 1)

            slider_row(mx, my, child_click,
                lmb and nested_icons > 0.96,
                row_x + 13, child_y + child_h, row_w - 13,
                "Icon Size", "world_icon_size", 10, 48, "int")
            separator(child_y + 2 * child_h - 1)

            local glow_y = child_y + 2 * child_h
            local glow_swatch_s = 18
            local glow_swatch_x = row_x + row_w - glow_swatch_s - 12
            local glow_swatch_y = glow_y + 11
            local glow_color_hot = hover(mx, my,
                glow_swatch_x - 4, glow_swatch_y - 4, 26, 26)
            toggle_row(mx, my, child_click and not glow_color_hot,
                row_x + 13, glow_y, row_w - 13,
                "Icon Glow", "world_icon_glow_enabled", false)
            world_square_swatch(glow_swatch_x, glow_swatch_y,
                glow_swatch_s, world_color_from_prefix("world_icon_glow"))
            if child_click and glow_color_hot then
                fallen_open_color_at("world_icon_glow",
                    glow_swatch_x, glow_swatch_y, glow_swatch_s)
            end
        end
        MENU_RENDER_ALPHA = saved_popup_alpha

        -- Nested level 2: properties only appear when Icon Glow is enabled.
        local glow_base_y = child_y + 3 * child_h
        local glow_row_h = row_h * nested_glow
        local glow_alpha = ease_out_cubic(
            clamp((nested_glow - 0.22) / 0.78, 0, 1))
        local glow_click = child_click and nested_glow > 0.96
        if nested_glow > 0.015 then
            MENU_RENDER_ALPHA = saved_popup_alpha * glow_alpha
            separator(glow_base_y - 1)
            slider_row(mx, my, glow_click,
                lmb and glow_click,
                row_x + 24, glow_base_y, row_w - 24,
                "Glow Strength", "world_icon_glow_strength", 0, 100, "int")
            separator(glow_base_y + glow_row_h - 1)
            slider_row(mx, my, glow_click,
                lmb and glow_click,
                row_x + 24, glow_base_y + glow_row_h, row_w - 24,
                "Glow Spread", "world_icon_glow_spread", 1, 20, "int")
        end
        MENU_RENDER_ALPHA = saved_popup_alpha

        -- A hidden sub-slider must not keep consuming mouse movement.
        if not S.world_show_icons
            and A.active_slider == "world_icon_size"
        then
            A.active_slider = nil
        end
        if not S.world_icon_glow_enabled
            and (A.active_slider == "world_icon_glow_strength"
                or A.active_slider == "world_icon_glow_spread")
        then
            A.active_slider = nil
        end

    -- =========================================================
    -- NODE item settings.
    -- =========================================================
    elseif is_nodes then
        for i = 1, 3 do
            local item =
                WORLD_UI_ITEMS[i]

            local iy =
                py
                + 39
                + (i - 1) * 41

            if item
                and shell_h > (iy - py + 10)
            then
                resource_toggle_row(
                    mx,
                    my,
                    ui_clicked,
                    px + 8,
                    iy,
                    pw - 16,
                    item
                )

                if i < 3 then
                    line(
                        px + 20,
                        iy + 40,
                        px + pw - 20,
                        iy + 40,
                        C.divider,
                        1
                    )
                end
            end
        end

    -- =========================================================
    -- PLANT item settings.
    -- =========================================================
    elseif is_plants then
        for i = 4, 10 do
            local item =
                WORLD_UI_ITEMS[i]

            local row_index =
                i - 4

            local iy =
                py
                + 39
                + row_index * 41

            if item
                and shell_h > (iy - py + 10)
            then
                resource_toggle_row(
                    mx,
                    my,
                    ui_clicked,
                    px + 8,
                    iy,
                    pw - 16,
                    item
                )

                if i < 10 then
                    line(
                        px + 20,
                        iy + 40,
                        px + pw - 20,
                        iy + 40,
                        C.divider,
                        1
                    )
                end
            end
        end

    -- =========================================================
    -- DROPPED ITEMS settings.
    -- Common name/distance/icon/glow controls live in World ESP settings;
    -- this popup keeps only the category color to stay compact.
    -- =========================================================
    elseif is_drops then
        local row_x = px + 8
        local row_y = py + 39
        local row_w = pw - 16

        local color_prefix =
            "world_color_dropped_item"

        local swatch_s = 18
        local swatch_x =
            row_x + row_w - swatch_s - 12
        local swatch_y =
            row_y + 11

        local swatch_hot =
            hover(
                mx, my,
                swatch_x, swatch_y,
                swatch_s, swatch_s
            )

        text(
            row_x + 13,
            row_y + 14,
            "Dropped Color",
            FALLEN_HOVER_TEXT(
                "world_dropped_color",
                swatch_hot,
                C.text
            )
        )

        world_square_swatch(
            swatch_x,
            swatch_y,
            swatch_s,
            world_color_from_prefix(
                color_prefix
            )
        )

        if ui_clicked
            and swatch_hot
        then
            FALLEN_COLOR_INPUT_STOP(true)

            if A.world_color_picker_open
                and A.world_color_picker_key == color_prefix
            then
                A.world_color_picker_open = false
                A.world_color_picker_drag = nil
            else
                A.world_color_picker_key = color_prefix
                A.world_color_picker_open = true
                A.world_color_picker_drag = nil
                A.fov_picker_open = false
                A.fov_picker_drag = nil
            end

            A.world_color_picker_anchor_x =
                FALLEN_UI_X(swatch_x)
            A.world_color_picker_anchor_y =
                FALLEN_UI_Y(swatch_y)
            A.world_color_picker_anchor_w =
                FALLEN_UI_LEN(swatch_s)
            A.world_color_picker_anchor_h =
                FALLEN_UI_LEN(swatch_s)
        end

    -- =========================================================
    -- BODY BAG settings.
    -- Uses the same common name/distance/icon/glow controls as World ESP,
    -- with its own tint here.
    -- =========================================================
    elseif is_bodybag then
        local row_x = px + 8
        local row_y = py + 39
        local row_w = pw - 16

        local color_prefix =
            "world_color_body_bag"

        local swatch_s = 18
        local swatch_x =
            row_x + row_w - swatch_s - 12
        local swatch_y =
            row_y + 11

        local swatch_hot =
            hover(
                mx, my,
                swatch_x - 5, swatch_y - 5,
                swatch_s + 10, swatch_s + 10
            )

        text(
            row_x + 13,
            row_y + 14,
            "Body Bag Color",
            FALLEN_HOVER_TEXT(
                "world_body_bag_color",
                swatch_hot,
                C.text
            )
        )

        world_square_swatch(
            swatch_x,
            swatch_y,
            swatch_s,
            world_color_from_prefix(
                color_prefix
            )
        )

        if ui_clicked
            and swatch_hot
        then
            FALLEN_COLOR_INPUT_STOP(true)

            if A.world_color_picker_open
                and A.world_color_picker_key == color_prefix
            then
                A.world_color_picker_open = false
                A.world_color_picker_drag = nil
            else
                A.world_color_picker_key = color_prefix
                A.world_color_picker_open = true
                A.world_color_picker_drag = nil
                A.fov_picker_open = false
                A.fov_picker_drag = nil
            end

            A.world_color_picker_anchor_x =
                FALLEN_UI_X(swatch_x)
            A.world_color_picker_anchor_y =
                FALLEN_UI_Y(swatch_y)
            A.world_color_picker_anchor_w =
                FALLEN_UI_LEN(swatch_s)
            A.world_color_picker_anchor_h =
                FALLEN_UI_LEN(swatch_s)
        end

    -- =========================================================
    -- VISUAL GRENADE settings.
    -- One shared color controls both the flight trail and the timer outline.
    -- =========================================================
