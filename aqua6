    FALLEN_HITFX.items[#FALLEN_HITFX.items + 1] = {
        x = pos.X,
        y = pos.Y,
        z = pos.Z,
        _base = {
            X = pos.X,
            Y = pos.Y,
            Z = pos.Z,
        },
        _offset = {
            X = pos.X,
            Y = pos.Y,
            Z = pos.Z,
        },
        created = tick(),
        seed =
            (#FALLEN_HITFX.items + 1) * 31
            + math.floor(tick() * 1000),
