            FALLEN_UI_LEN(17), FALLEN_UI_LEN(17),
            1, 1, 1, MENU_RENDER_ALPHA, 0)
    else
        -- Native fallback while a remotely hosted PNG is unavailable.
        circle(x + 7, y + 7, 5, C.text_dim, 1.4)
        line(x + 11, y + 11, x + 16, y + 16, C.text_dim, 1.4)
    end
end

local function fallen_search_draw(wx, wy, mx, my, clicked)
    local anim = clamp(A.search_anim or 0, 0, 1)
    local head_x, head_y, head_w, head_h = wx + WIN_W - 216, wy + 18, 198, 27

    if anim > 0.005 then
        -- Darken only the menu. Match its rounded outer corners instead
        -- of painting a square translucent rectangle over the shell.
        rounded_fill(wx, wy, WIN_W, WIN_H, OUTER_R,
            { 0, 0, 0, 0.74 * anim })

        local w, h = 436, 294
        local px = wx + (WIN_W - w) * 0.5
        local py = wy + (WIN_H - h) * 0.5 + (1 - anim) * 12
        local prev_alpha = MENU_RENDER_ALPHA
        MENU_RENDER_ALPHA = prev_alpha * anim
        -- Black with a little transparency, one alpha-safe pass so the
        -- corners remain smooth without dark overlap artifacts.
        rounded_fill(px, py, w, h, 11,
            { 0.004, 0.004, 0.006, 0.92 })
        text(px + w - 60, py + 17, "ESC", C.text_dim)
        line(px + 16, py + 42, px + w - 16, py + 42, C.divider, 1)

        local query = fallen_search_normalize(A.search_query)
        if query ~= "" then
            local results = {}
            for _, entry in ipairs(FALLEN_SEARCH_ITEMS) do
                if S[entry[2]] ~= nil
                    and (fallen_search_normalize(entry[1]):find(query, 1, true)
                        or fallen_search_normalize(entry[3]):find(query, 1, true))
                then
                    results[#results + 1] = entry
                end
            end

            if query ~= A.search_last_query then
                A.search_results_anim = 0
                A.search_last_query = query
            end
            A.search_results_anim = lerp(A.search_results_anim or 0, 1, 0.17)
            local vis = clamp(A.search_results_anim, 0, 1)

            if #results == 0 then
                text(px + 19, py + 66, "No matching functions", C.text_dim)
            else
                local limit = math.min(#results, 5)
                for i = 1, limit do
                    local entry = results[i]
                    local key = entry[2]
                    local yy = py + 49 + (i - 1) * 44 + (1 - vis) * 8
                    local hot = hover(mx, my, px + 14, yy, w - 28, 42)
                    if hot then
                        rounded_fill(px + 14, yy, w - 28, 40, 5, C.frame_active)
                    end
                    local value = S[key] == true
                    if clicked and A.search_open and anim > 0.75 and hot then
                        value = not value
                        S[key] = value
                        if type(FALLEN_SILENT_UI_VALUE_CHANGED) == "function" then
                            FALLEN_SILENT_UI_VALUE_CHANGED(key, value)
                        end
                    end
                    -- Same 30x17 switch geometry and animated track as original menu.
                    local target = value and 1 or 0
                    local t = A.toggles[key]
                    if t == nil then t = target end
                    t = lerp(t, target, 0.11)
                    A.toggles[key] = t
                    local old_alpha = MENU_RENDER_ALPHA
                    MENU_RENDER_ALPHA = old_alpha * vis
                    text(px + 25, yy + 7, entry[1], value and C.text or C.text_dim)
                    text(px + 25, yy + 23, entry[3], C.text_faint)
                    local tx, ty = px + w - 63, yy + 12
                    draw_switch_track(tx, ty, 30, 17, C.frame_inactive, C.frame_active, t)
                    circle_fill(tx + 8 + 14 * t, ty + 8.5, 7,
                        value and C.accent or C.text_dim)
                    MENU_RENDER_ALPHA = old_alpha
                    if i < limit then
                        line(px + 23, yy + 42, px + w - 23, yy + 42, C.divider, 1)
                    end
                end
                if #results > limit then
                    text(px + 20, py + h - 19, "Keep typing to narrow results", C.text_dim)
                end
            end
        else
            A.search_last_query = ""
            A.search_results_anim = 0
        end
        MENU_RENDER_ALPHA = prev_alpha
    end

    -- Search box stays bright and interactive above the dimmed shell.
    local hot = hover(mx, my, head_x, head_y, head_w, head_h)
    rounded_fill(head_x, head_y, head_w, head_h, 5,
        A.search_open and C.frame_active or (hot and C.button_hovered or C.button))
    rounded_outline(head_x, head_y, head_w, head_h, 5,
        A.search_open and C.accent_dim or C.border, 1,
        A.search_open and C.frame_active or (hot and C.button_hovered or C.button))
    fallen_search_draw_icon(head_x + 9, head_y + 5)
    local q = A.search_query or ""
    if q == "" then
        text(head_x + 35, head_y + 7, "Search functions...", C.text_dim)
    else
        local cursor = A.search_open and (math.floor(tick() * 2) % 2 == 0) and "|" or ""
        text(head_x + 35, head_y + 7, q .. cursor, C.text)
    end
end

