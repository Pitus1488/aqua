local function FALLEN_MANIPULATION_START_GEO_BUILD(center)
    if not center or not rbx or type(rbx.workspace) ~= "function" then
        return false
    end

    local ws = nil
    pcall(function()
        ws = rbx.workspace()
    end)
    if not ws then
        return false
    end

    local roots = nil
    pcall(function()
        roots = ws:get_children()
    end)
    if type(roots) ~= "table" then
        return false
    end

    local skip_chars = {}
    if players and type(players.get_all) == "function" then
        local plist = nil
        pcall(function() plist = players.get_all() end)
        if type(plist) == "table" then
            for _, p in ipairs(plist) do
                local a = p and tonumber(p.character_addr or 0) or 0
                if a ~= 0 then
                    skip_chars[a] = true
                end
            end
        end
    end

    local local_char_addr = 0
    pcall(function()
        if type(rbx.local_character) == "function" then
            local ch = rbx.local_character()
            local_char_addr = ch and (tonumber(ch.addr) or 0) or 0
        end
    end)
    if local_char_addr ~= 0 then
        skip_chars[local_char_addr] = true
    end

    local cell = 36
    local pad = 520

    A.misc_manipulation_geo_queue = roots
    A.misc_manipulation_geo_queue_i = 1
    A.misc_manipulation_geo_skip_chars = skip_chars
    A.misc_manipulation_geo_building = true
    A.misc_manipulation_geo_build = {
        time = tick(),
        cx = center.X,
        cz = center.Z,
        center_y = center.Y,
        radius = 80,
        cell = cell,
        scan_x1 = center.X - pad,
        scan_x2 = center.X + pad,
        scan_z1 = center.Z - pad,
        scan_z2 = center.Z + pad,
        parts = {},
        grid = {},
        ray_serial = 0,
    }

    return true
end

local function FALLEN_MANIPULATION_GEO_STEP(center, budget)
    if not center then
        return
    end

    local live_geo = A.world_rain_geo
    local need_new = type(live_geo) ~= "table"

    if type(live_geo) == "table" then
        local gx = tonumber(live_geo.cx)
        local gz = tonumber(live_geo.cz)
        if gx and gz then
            local dx = center.X - gx
            local dz = center.Z - gz
            -- Only rebuild after a genuinely large move, and do it progressively.
            if (dx * dx + dz * dz) > (320 * 320) then
                need_new = true
            end
        end
    end

    if need_new and A.misc_manipulation_geo_building ~= true then
        FALLEN_MANIPULATION_START_GEO_BUILD(center)
    end

    if A.misc_manipulation_geo_building ~= true then
        return
    end

    local geo = A.misc_manipulation_geo_build
    local queue = A.misc_manipulation_geo_queue
    local qi = tonumber(A.misc_manipulation_geo_queue_i) or 1

    if type(geo) ~= "table" or type(queue) ~= "table" then
        A.misc_manipulation_geo_building = false
        return
    end

    budget = math.max(8, math.floor(tonumber(budget) or 28))
    local processed = 0

    while qi <= #queue and processed < budget do
        local inst = queue[qi]
        qi = qi + 1
        processed = processed + 1

        if inst then
            local addr = tonumber(inst.addr) or 0
            local skip_whole =
                addr ~= 0
                and type(A.misc_manipulation_geo_skip_chars) == "table"
                and A.misc_manipulation_geo_skip_chars[addr] == true

            local name = nil
            local class = nil
            pcall(function() name = inst:get_name() end)
            pcall(function() class = inst:get_class() end)

            if name == "VFX" or class == "Camera" or class == "Terrain" then
                skip_whole = true
            end

            if not skip_whole then
                if FALLEN_MANIPULATION_PART_CLASSES[tostring(class)] == true then
                    local can_collide = true
                    pcall(function()
                        if type(inst.get_can_collide) == "function" then
                            can_collide = inst:get_can_collide() == true
                        end
                    end)

                    if can_collide and #geo.parts < 6500 then
                        local pos, size, rot = nil, nil, nil
                        pcall(function() pos = inst:get_position() end)
                        pcall(function() size = inst:get_size() end)
                        pcall(function() rot = inst:get_rotation() end)

                        if pos and size then
                            rot = type(rot) == "table" and rot or {1,0,0, 0,1,0, 0,0,1}

                            local px = tonumber(pos.X or pos[1])
                            local py = tonumber(pos.Y or pos[2])
                            local pz = tonumber(pos.Z or pos[3])
                            local sx = math.abs(tonumber(size.X or size[1]) or 0)
                            local sy = math.abs(tonumber(size.Y or size[2]) or 0)
                            local sz = math.abs(tonumber(size.Z or size[3]) or 0)

                            if px and py and pz and sx > 0.04 and sy > 0.04 and sz > 0.04 then
                                local hx, hy, hz = sx * 0.5, sy * 0.5, sz * 0.5
                                local m1 = tonumber(rot[1]) or 1
                                local m2 = tonumber(rot[2]) or 0
                                local m3 = tonumber(rot[3]) or 0
                                local m4 = tonumber(rot[4]) or 0
                                local m5 = tonumber(rot[5]) or 1
                                local m6 = tonumber(rot[6]) or 0
                                local m7 = tonumber(rot[7]) or 0
                                local m8 = tonumber(rot[8]) or 0
                                local m9 = tonumber(rot[9]) or 1

                                local ex = math.abs(m1) * hx + math.abs(m2) * hy + math.abs(m3) * hz
                                local ez = math.abs(m7) * hx + math.abs(m8) * hy + math.abs(m9) * hz

                                if px + ex >= geo.scan_x1 and px - ex <= geo.scan_x2
                                    and pz + ez >= geo.scan_z1 and pz - ez <= geo.scan_z2
                                    and math.abs(py - geo.center_y) <= 520 + hy
                                then
                                    local rec = {
                                        x = px, y = py, z = pz,
                                        hx = hx, hy = hy, hz = hz,
                                        m1 = m1, m2 = m2, m3 = m3,
                                        m4 = m4, m5 = m5, m6 = m6,
                                        m7 = m7, m8 = m8, m9 = m9,
                                        mark = 0,
                                    }

                                    geo.parts[#geo.parts + 1] = rec
                                    local index = #geo.parts

                                    local minx = math.max(px - ex, geo.scan_x1)
                                    local maxx = math.min(px + ex, geo.scan_x2)
                                    local minz = math.max(pz - ez, geo.scan_z1)
                                    local maxz = math.min(pz + ez, geo.scan_z2)

                                    local gx1 = math.floor(minx / geo.cell)
                                    local gx2 = math.floor(maxx / geo.cell)
                                    local gz1 = math.floor(minz / geo.cell)
                                    local gz2 = math.floor(maxz / geo.cell)

                                    for gx = gx1, gx2 do
                                        for gz = gz1, gz2 do
                                            local key = FALLEN_WORLD_RAIN_GRID_KEY(gx, gz)
                                            local bucket = geo.grid[key]
                                            if not bucket then
                                                bucket = {}
                                                geo.grid[key] = bucket
                                            end
                                            bucket[#bucket + 1] = index
                                        end
                                    end
                                end
                            end
                        end
                    end
                else
                    local children = nil
                    pcall(function() children = inst:get_children() end)
                    if type(children) == "table" then
                        for _, child in ipairs(children) do
                            queue[#queue + 1] = child
                        end
                    end
                end
            end
        end
    end

    A.misc_manipulation_geo_queue_i = qi

    if qi > #queue or #geo.parts >= 6500 then
        -- Atomically swap only after the progressive build has finished.
        A.world_rain_geo = geo
        A.misc_manipulation_geo_building = false
        A.misc_manipulation_geo_queue = nil
        A.misc_manipulation_geo_queue_i = 1
        A.misc_manipulation_geo_build = nil
        A.misc_manipulation_geo_skip_chars = nil
    end
end

local function FALLEN_MANIPULATION_TARGET()
    if not players or type(players.get_all) ~= "function" then
        return nil, nil
    end

    local cursor = FALLEN_MANIPULATION_CURSOR_POS()
    if not cursor then
        return nil, nil
    end

    local list = nil
    local me = nil

    pcall(function()
        list = players.get_all()
    end)

    pcall(function()
        if type(players.get_local) == "function" then
            me = players.get_local()
        end
    end)

    if type(list) ~= "table" then
        return nil, nil
    end

    local my_team_addr =
        type(me) == "table"
        and tonumber(me.team_addr)
        or 0

    local my_team_name =
        type(me) == "table"
        and tostring(me.team_name or "")
        or ""

    local cx =
        tonumber(cursor.X or cursor.x or cursor[1])
        or 0

    local cy =
        tonumber(cursor.Y or cursor.y or cursor[2])
        or 0

    local best = nil
    local best_pos = nil
    local best_d2 = 600 * 600

    for _, p in ipairs(list) do
        if p and p.is_self ~= true then
            local same_team = p.is_teammate == true

            if not same_team
                and my_team_addr ~= 0
                and tonumber(p.team_addr or 0) ~= 0
                and tonumber(p.team_addr or 0) == my_team_addr
            then
                same_team = true
            end

            if not same_team
                and my_team_name ~= ""
                and tostring(p.team_name or "") ~= ""
                and tostring(p.team_name or "") == my_team_name
            then
                same_team = true
            end

            if not same_team
                and (tonumber(p.health) or 0) > 0
                and p.is_knocked ~= true
            then
                local pos = p.head_pos or p.position

                if pos then
                    local scr = nil

                    pcall(function()
                        if rbx
                            and type(rbx.world_to_screen) == "function"
                        then
                            scr = rbx.world_to_screen(pos)
                        elseif aim
                            and type(aim.world_to_screen) == "function"
                        then
                            scr = aim.world_to_screen(pos)
                        end
                    end)

                    if scr and scr.visible ~= false then
                        local sx = tonumber(scr.X or scr.x or scr[1])
                        local sy = tonumber(scr.Y or scr.y or scr[2])

                        if sx and sy then
                            local dx = sx - cx
                            local dy = sy - cy
                            local d2 = dx * dx + dy * dy

                            if d2 < best_d2 then
                                best_d2 = d2
                                best = p
                                best_pos = pos
                            end
                        end
                    end
                end
            end
        end
    end

    return best, best_pos
end

local function FALLEN_MANIPULATION_CAN_HIT(origin, target_pos, center)
    if not origin or not target_pos then
        return false
    end

    -- Geometry is built progressively by FALLEN_MANIPULATION_GEO_STEP().
    -- Never perform a full Workspace descendant scan from a render/raycast call.
    if type(A.world_rain_geo) ~= "table" then
        return false
    end

    local dx = target_pos.X - origin.X
    local dy = target_pos.Y - origin.Y
    local dz = target_pos.Z - origin.Z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)

    if dist <= 0.25 then
        return true
    end

    dx, dy, dz = dx / dist, dy / dist, dz / dist

    local check_dist = math.max(0, dist - 3.0)
    local hit = nil

    pcall(function()
        hit = FALLEN_WORLD_RAIN_RAYCAST_GRID(
            origin.X,
            origin.Y,
            origin.Z,
            dx,
            dy,
            dz,
            check_dist
        )
    end)

    return hit == nil
end

local function FALLEN_MANIPULATION_NORMALIZE3(x, y, z)
    local len = math.sqrt(x*x + y*y + z*z)
    if len <= 0.0001 then
        return 0, 0, 0
    end
    return x / len, y / len, z / len
end

local function FALLEN_MANIPULATION_BASIS(rot)
    -- Matrix columns are the local axes in world space for this custom API.
    local rx, rz = 1, 0
    local fx, fz = 0, -1

    if type(rot) == "table" then
        rx = tonumber(rot[1]) or rx
        rz = tonumber(rot[7]) or rz
        fx = -(tonumber(rot[3]) or 0)
        fz = -(tonumber(rot[9]) or 1)
    end

    local rl = math.sqrt(rx*rx + rz*rz)
    if rl > 0.0001 then
        rx, rz = rx / rl, rz / rl
    else
        rx, rz = 1, 0
    end

    local fl = math.sqrt(fx*fx + fz*fz)
    if fl > 0.0001 then
        fx, fz = fx / fl, fz / fl
    else
        fx, fz = 0, -1
    end

    return rx, rz, fx, fz
end

local function FALLEN_MANIPULATION_CANDIDATES(rot)
    local rx, rz = FALLEN_MANIPULATION_BASIS(rot)

    -- Only high-angle positions are used. Diagonals are listed first so
    -- equal-quality openings do not always collapse back to plain UP.
    return {
        { name = "UP-RIGHT", x = rx,  y = 1, z = rz },
        { name = "UP-LEFT",  x = -rx, y = 1, z = -rz },
        { name = "UP",       x = 0,   y = 1, z = 0 },
    }
end

local function FALLEN_MANIPULATION_PICK_OFFSET(base_origin, target_pos, base_pos, rot, distance)
    -- No DIRECT bypass: only UP / UP-RIGHT / UP-LEFT are considered.
    -- Pick the angle that has the best small visibility window instead of
    -- returning the first valid ray. This lets LEFT/RIGHT win when they
    -- actually open more of the target around cover.
    local candidates = FALLEN_MANIPULATION_CANDIDATES(rot)

    if not target_pos then
        return Vector3(0, 0, 0), "-", false
    end

    local rx, rz, fx, fz =
        FALLEN_MANIPULATION_BASIS(rot)

    local best_offset = nil
    local best_name = nil
    local best_score = -1e9
    local preferred =
        tostring(
            A.misc_manipulation_direction
            or ""
        )

    for _, c in ipairs(candidates) do
        local failed =
            type(A.misc_manipulation_failed_directions) == "table"
            and A.misc_manipulation_failed_directions[c.name] == true

        if not failed then
            local nx, ny, nz =
                FALLEN_MANIPULATION_NORMALIZE3(
                    c.x,
                    c.y,
                    c.z
                )

        local ox, oy, oz =
            nx * distance,
            ny * distance,
            nz * distance

        local origin =
            Vector3(
                base_origin.X + ox,
                base_origin.Y + oy,
                base_origin.Z + oz
            )

        -- The center ray is mandatory.
        if FALLEN_MANIPULATION_CAN_HIT(
            origin,
            target_pos,
            base_pos
        )
        then
            local score = 10

            -- Probe a small window around the target. A diagonal that sees
            -- more of this window gets preferred over plain UP.
            local probes = {
                Vector3(
                    target_pos.X,
                    target_pos.Y + 0.48,
                    target_pos.Z
                ),
                Vector3(
                    target_pos.X + rx * 0.52,
                    target_pos.Y,
                    target_pos.Z + rz * 0.52
                ),
                Vector3(
                    target_pos.X - rx * 0.52,
                    target_pos.Y,
                    target_pos.Z - rz * 0.52
                ),
                Vector3(
                    target_pos.X + fx * 0.32,
                    target_pos.Y,
                    target_pos.Z + fz * 0.32
                ),
            }

            for _, probe in ipairs(probes) do
                if FALLEN_MANIPULATION_CAN_HIT(
                    origin,
                    probe,
                    base_pos
                )
                then
                    score = score + 1
                end
            end

            -- Small diagonal bonus only breaks near-ties. UP still wins when
            -- it has a meaningfully cleaner window.
            if c.name == "UP-RIGHT"
                or c.name == "UP-LEFT"
            then
                score = score + 0.35
            end

            -- Tiny stability bonus if a direction was already being tested
            -- before the physical spoof became locked.
            if c.name == preferred then
                score = score + 0.15
            end

            if score > best_score then
                best_score = score
                best_name = c.name
                best_offset =
                    Vector3(
                        ox,
                        oy,
                        oz
                    )
            end
        end
        end
    end

    if best_offset then
        return best_offset, best_name, true
    end

    return Vector3(0, 0, 0), "-", false
end

local function FALLEN_MANIPULATION_DRAW_INDICATOR()
    -- Preview indicator only:
    -- show BEFORE Mouse1 is pressed when one of the virtual Manipulation
    -- positions can hit. Hide it while the actual spoof is being used.
    if S.misc_manipulation_enabled ~= true
        or key_down(VK_LBUTTON) == true
        or A.misc_manipulation_can_hit ~= true
    then
        return
    end

    local center = FALLEN_MANIPULATION_CURSOR_POS()
    if not center then
        return
    end

    local label = "Manipulated"
    local cx =
        tonumber(
            center.X
            or center.x
            or center[1]
        )
        or 0

    local cy =
        tonumber(
            center.Y
            or center.y
            or center[2]
        )
        or 0

    local tx =
        cx - (#label * 3.35)

    -- Slightly below center.
    local ty = cy + 42

    if type(DrawTextWithOutline) == "function" then
        DrawTextWithOutline(
            tx,
            ty,
            label,
            0.45,
            1.00,
            0.55,
            1,
            0,
            0,
            0,
            1
        )
    elseif type(DrawText) == "function" then
        DrawText(
            tx,
            ty,
            label,
            0.45,
            1.00,
            0.55,
            1
        )
    end
end

function FALLEN_MANIPULATION_TICK()
    if _G.FallenMenuReady ~= true then
        return
    end

    local hrp = nil
    local head = nil
    local cam = nil

    if rbx then
        if type(rbx.local_hrp) == "function" then
            pcall(function() hrp = rbx.local_hrp() end)
        end
        if type(rbx.local_head) == "function" then
            pcall(function() head = rbx.local_head() end)
        end
        if type(rbx.camera) == "function" then
            pcall(function() cam = rbx.camera() end)
        end
    end

    local enabled = S.misc_manipulation_enabled == true
    local raw_lmb = key_down(VK_LBUTTON) == true

    if not enabled or not hrp then
        if A.misc_manipulation_press_active == true then
            FALLEN_MANIPULATION_RESTORE_RELEASE(hrp)
        end

        A.misc_manipulation_can_hit = false
        A.misc_manipulation_target_name = nil
        A.misc_manipulation_target_addr = nil
        A.misc_manipulation_target_pos = nil
        A.misc_manipulation_failed_directions = {}
        A.misc_manipulation_direction = nil
        A.misc_manipulation_cached_offset = nil
        return
    end

    -- Teleport/spoof is allowed only with a real weapon in hand.
    -- This reuses the exact detector used by Auto Prediction.
    local weapon_ready = false
    if raw_lmb then
        weapon_ready = FALLEN_MANIPULATION_HAS_WEAPON(
            A.misc_manipulation_press_active ~= true
        )
    end

    local lmb = raw_lmb and weapon_ready

    local hrp_pos = nil
    local hrp_rot = nil
    local hrp_vel = nil
    local head_pos = nil

    pcall(function() hrp_pos = hrp:get_position() end)
    pcall(function() hrp_rot = hrp:get_rotation() end)
    pcall(function() hrp_vel = hrp:get_velocity() end)
    if head then
        pcall(function() head_pos = head:get_position() end)
    end

    if not hrp_pos then
        return
    end

    -- Mouse released OR weapon disappeared while Mouse1 is still held:
    -- immediately restore the original press point/upright rotation.
    if not lmb and A.misc_manipulation_press_active == true then
        FALLEN_MANIPULATION_RESTORE_RELEASE(hrp)

        pcall(function() hrp_pos = hrp:get_position() end)
        pcall(function() hrp_rot = hrp:get_rotation() end)
        pcall(function() hrp_vel = hrp:get_velocity() end)
        if head then
            pcall(function() head_pos = head:get_position() end)
        end
    end

    local manip_distance =
        clamp(
            tonumber(S.misc_manipulation_distance)
            or 5,
            5,
            10
        )

    -- Freeze base state exactly once on a valid Mouse1 + weapon rising edge.
    if lmb and A.misc_manipulation_press_active ~= true then
        A.misc_manipulation_press_active = true
        A.misc_manipulation_press_pos = hrp_pos
        A.misc_manipulation_press_rot = hrp_rot
        A.misc_manipulation_press_upright_rot =
            FALLEN_MANIPULATION_UPRIGHT_MATRIX(hrp_rot)
        A.misc_manipulation_press_vel = hrp_vel

        if head_pos then
            A.misc_manipulation_press_head_offset = Vector3(
                head_pos.X - hrp_pos.X,
                head_pos.Y - hrp_pos.Y,
                head_pos.Z - hrp_pos.Z
            )
        else
            A.misc_manipulation_press_head_offset = Vector3(0, 2, 0)
        end

        if cam then
            pcall(function()
                A.misc_manipulation_camera_anchor = cam:camera_pos()
            end)
        end

        -- Force one target/direction refresh for the new shot press.
        A.misc_manipulation_last_eval = 0
        A.misc_manipulation_failed_directions = {}
        A.misc_manipulation_target_pos = nil
    end

    local base_pos =
        (A.misc_manipulation_press_active == true
            and A.misc_manipulation_press_pos)
        or hrp_pos

    local base_rot =
        (A.misc_manipulation_press_active == true
            and A.misc_manipulation_press_upright_rot)
        or FALLEN_MANIPULATION_UPRIGHT_MATRIX(hrp_rot)

    local base_head_offset =
        (A.misc_manipulation_press_active == true
            and A.misc_manipulation_press_head_offset)
        or (head_pos and Vector3(
            head_pos.X - hrp_pos.X,
            head_pos.Y - hrp_pos.Y,
            head_pos.Z - hrp_pos.Z
        ))
        or Vector3(0, 2, 0)

    local base_origin = Vector3(
        base_pos.X + base_head_offset.X,
        base_pos.Y + base_head_offset.Y,
        base_pos.Z + base_head_offset.Z
    )

    -- Build collision geometry in tiny chunks instead of one giant Workspace scan.
    -- This is what removes the long freeze when Manipulation is first enabled.
    FALLEN_MANIPULATION_GEO_STEP(base_pos, 28)

    -- Target/direction selection is throttled. Manipulation only evaluates
    -- UP / UP-RIGHT / UP-LEFT; the real position is never used as DIRECT.
    local now = tick()

    -- Once this press has a valid physical spoof, lock that exact offset until
    -- Mouse1 is released. Do not recalculate and teleport between positions.
    local spoof_locked =
        lmb
        and A.misc_manipulation_spoofed == true
        and A.misc_manipulation_cached_offset ~= nil
        and A.misc_manipulation_can_hit == true

    local need_eval =
        not spoof_locked
        and (
            (now - (A.misc_manipulation_last_eval or 0)) >= 0.10
            or A.misc_manipulation_cached_offset == nil
        )

    if need_eval then
        A.misc_manipulation_last_eval = now

        local target, target_pos = FALLEN_MANIPULATION_TARGET()

        A.misc_manipulation_target_name =
            target
            and tostring(target.name or target.display_name or "target")
            or nil

        A.misc_manipulation_target_addr =
            target
            and tonumber(target.address or target.player_addr or 0)
            or nil

        A.misc_manipulation_target_pos = target_pos

        local offset, direction, can_hit =
            FALLEN_MANIPULATION_PICK_OFFSET(
                base_origin,
                target_pos,
                base_pos,
                base_rot,
                manip_distance
            )

        A.misc_manipulation_cached_offset = offset
        A.misc_manipulation_direction = direction
        A.misc_manipulation_can_hit = target_pos ~= nil and can_hit or false
    end

    -- Preview calculations remain active without Mouse1 so the indicator
    -- can tell us in advance whether Manipulation has a valid angle.
    -- Physical spoofing still starts only on Mouse1 + a valid weapon.
    if not lmb then
        A.misc_manipulation_spoofed = false
        A.misc_manipulation_camera_anchor = nil
        return
    end

    local direction = tostring(A.misc_manipulation_direction or "-")
    local can_hit = A.misc_manipulation_can_hit == true

    -- Before a spoof is locked, stay at the original click point until one
    -- of UP / UP-RIGHT / UP-LEFT finds a valid opening.
    if not can_hit then
        pcall(function()
            hrp:set_anchored(false)
        end)

        pcall(function()
            hrp:set_position(base_pos)
        end)

        if type(base_rot) == "table" then
            pcall(function()
                hrp:set_rotation(base_rot)
            end)
        end

        if A.misc_manipulation_press_vel then
            pcall(function()
                hrp:set_velocity(A.misc_manipulation_press_vel)
            end)
        end

        A.misc_manipulation_hold_until = nil
        A.misc_manipulation_hold_active = false
        A.misc_manipulation_spoofed = false
        A.misc_manipulation_can_hit = false
        return
    end

    local offset =
        A.misc_manipulation_cached_offset
        or Vector3(0, 0, 0)

    -- Hold the exact selected spoof position for the entire Mouse1 press.
    -- Never visit base_pos between frames; release restores it once.
    local held_pos =
        Vector3(
            base_pos.X + offset.X,
            base_pos.Y + offset.Y,
            base_pos.Z + offset.Z
        )

    pcall(function()
        hrp:set_anchored(true)
    end)

    pcall(function()
        hrp:set_velocity(
            Vector3(0, 0, 0)
        )
    end)

    pcall(function()
        hrp:set_position(held_pos)
    end)

    A.misc_manipulation_hold_until = nil
    A.misc_manipulation_hold_active = true

    -- Sideways body spoof exists only while a valid armed LMB is held.
    if type(base_rot) == "table" then
        local flipped = FALLEN_MANIPULATION_MATRIX_MUL(
            base_rot,
            FALLEN_MANIPULATION_PITCH_MATRIX(
                FALLEN_MANIPULATION_FLIP_DEG
            )
        )

        if flipped then
            pcall(function()
                hrp:set_rotation(flipped)
            end)
        end
    end

    -- Final real-position validation.
    -- Candidate scoring above is only predictive. After the character is
    -- physically moved/flipped, verify the ray again from the actual head.
    local final_target =
        A.misc_manipulation_target_pos

    local actual_origin = nil

    if head then
        pcall(function()
            actual_origin = head:get_position()
        end)
    end

    if not actual_origin then
        actual_origin =
            Vector3(
                held_pos.X + base_head_offset.X,
                held_pos.Y + base_head_offset.Y,
                held_pos.Z + base_head_offset.Z
            )
    end

    local final_ok =
        final_target ~= nil
        and FALLEN_MANIPULATION_CAN_HIT(
            actual_origin,
            final_target,
            base_pos
        )

    if not final_ok then
        local failed_name =
            tostring(
                A.misc_manipulation_direction
                or ""
            )

        if failed_name ~= "" then
            if type(A.misc_manipulation_failed_directions) ~= "table" then
                A.misc_manipulation_failed_directions = {}
            end

            A.misc_manipulation_failed_directions[failed_name] = true
        end

        A.misc_manipulation_can_hit = false
        A.misc_manipulation_spoofed = false
        A.misc_manipulation_cached_offset = nil
        A.misc_manipulation_direction = nil
        A.misc_manipulation_last_eval = 0
        A.misc_manipulation_hold_active = false

        pcall(function()
            hrp:set_anchored(false)
        end)

        pcall(function()
            hrp:set_position(base_pos)
        end)

        if type(base_rot) == "table" then
            pcall(function()
                hrp:set_rotation(base_rot)
            end)
        end

        if A.misc_manipulation_press_vel then
            pcall(function()
                hrp:set_velocity(
                    A.misc_manipulation_press_vel
                )
            end)
        end

        return
    end

    A.misc_manipulation_can_hit = true

    -- Lock only camera translation; look rotation remains controllable.
    if cam and A.misc_manipulation_camera_anchor then
        pcall(function()
            cam:set_camera_pos(A.misc_manipulation_camera_anchor)
        end)
    end

    A.misc_manipulation_spoofed = true
end

hooks.on_render(function()
    local ok, err = pcall(FALLEN_MANIPULATION_TICK)

    if not ok then
        local now = tick()
        if now - (A.misc_manipulation_last_error or 0) > 2 then
            A.misc_manipulation_last_error = now
            if type(warn) == "function" then
                warn(SYS .. "Manipulation: " .. tostring(err))
            end
        end
    end

    pcall(FALLEN_MANIPULATION_DRAW_INDICATOR)
end)

