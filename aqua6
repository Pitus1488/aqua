local function sidebar_tab(mx, my, clicked, x, y, index)
    local w, h = 152, 35
    local active = S.tab == index
    local hot = hover(mx, my, x, y, w, h)

    A.sidebar_tab_anim[index] =
        A.sidebar_tab_anim[index]
        or (
            active
            and 1
            or 0
        )

    local target =
        active
        and 1
        or 0

    A.sidebar_tab_anim[index] =
        lerp(
            A.sidebar_tab_anim[index],
            target,
            0.18
        )

    local a =
        clamp(
            A.sidebar_tab_anim[index],
            0,
            1
        )

    -- Active background is rendered separately as one moving pill.
    -- Only hover tint remains local to the row.
    if hot and not active then
        rounded_fill(
            x,
            y,
            w,
            h,
            7,
            alpha(
                C.card_hover,
                0.55
                    * (1 - a)
            )
        )
    end

    local col =
        mix_color(
            C.text_dim,
            C.text,
            a
        )

    col =
        FALLEN_HOVER_TEXT(
            "sidebar:" .. tostring(index),
            hot,
            col
        )

    -- Sidebar icons:
    -- inactive = gray, selected = menu accent blue.
    local ic =
        mix_color(
            C.text_dim,
            C.accent,
            a
        )

    -- Sidebar icons should stay crisp even when the Gradient shell itself is
    -- 50% transparent. Their own alpha remains 1; only menu open/close alpha
    -- is applied by the primitive wrappers.
    ic[4] = 1

    local icon = ICONS[index]

    -- Raster sidebar icons use the same behavior:
    -- gray normally, accent blue on the selected tab.
    if (index == 1 or index == 2 or index == 3 or index == 5)
        and type(DrawImage) == "function"
    then
        ic =
            mix_color(
                C.text_dim,
                C.accent,
                a
            )

        -- Tab icons stay static on hover: no whitening and no growth.
        local icon_hover = 0
        ic[4] = 1

        local image_handle = nil

        if index == 1 then
            image_handle =
                FALLEN_AIMBOT_TAB_ICON_GET()
        elseif index == 2 then
            image_handle =
                FALLEN_VISUALS_TAB_ICON_GET()
        elseif index == 3 then
            image_handle =
                FALLEN_MISC_TAB_ICON_GET()
        elseif index == 5 then
            image_handle =
                FALLEN_SILENT_TAB_ICON_GET()
        end

        if image_handle then
            -- Image icons are drawn in physical pixels, centered in the
            -- already-scaled row. Use the selected menu size as an extra
            -- image-size hint so 125%+ visibly grows raster icons too.
            local requested_percent =
                tonumber(S.menu_scale_percent)
                or 100

            local requested_icon_scale =
                math.sqrt(
                    clamp(
                        requested_percent / 100,
                        1,
                        2
                    )
                )

            local transform_scale =
                MENU_UI_TRANSFORM_ACTIVE
                and (MENU_UI_SCALE or 1)
                or 1

            local icon_px =
                math.floor(
                    20
                    * transform_scale
                    * requested_icon_scale
                    * 1
                    + 0.5
                )

            local icon_cx =
                FALLEN_UI_X(
                    x + 20
                )

            local icon_cy =
                FALLEN_UI_Y(
                    y + 17.5
                )

            pcall(
                DrawImage,
                image_handle,
                icon_cx - icon_px * 0.5,
                icon_cy - icon_px * 0.5,
                icon_px,
                icon_px,
                ic[1],
                ic[2],
                ic[3],
                MENU_RENDER_ALPHA,
                0
            )
        end
    elseif icon then
        icon(
            x + 12,
            y + 10,
            ic
        )
    end

    text(
        x + 37,
        y + 10,
        TABS[index].label,
        col
    )

    if clicked
        and hot
        and S.tab ~= index
    then
        S.tab = index
        S.anim = 0

        A.aim_settings_open = false
        A.aim_part_dropdown_open = false
        A.silent_part_dropdown_open = false
        A.fov_settings_open = false
        A.silent_fov_settings_open = false
        A.damage_numbers_settings_open = false
        A.fov_picker_open = false
        A.world_settings_open = false
        A.misc_antiaim_settings_open = false
        A.misc_antiaim_mode_dropdown_open = false
        A.world_color_picker_open = false
        A.world_color_picker_drag = nil
        FALLEN_COLOR_INPUT_STOP(true)

        if aim_bind_cancel then
            aim_bind_cancel()
            FALLEN_SILENT_BIND_CANCEL()
        end

        if numeric_stop then
            numeric_stop(true)
        end
    end
end

