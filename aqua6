function FALLEN_DRAW_ARMOR_MODE_DROPDOWN(
    mx,
    my,
    clicked,
    x,
    y,
    w
)
    local anim =
        FALLEN_ARMOR_MODE_DROPDOWN_STEP()

    if anim <= 0.004
        and not A.armor_mode_dropdown_open
    then
        return false
    end

    local options = {
        "Normal",
        "On Player",
    }

    local item_h = 27
    local full_h =
        #options * item_h

    -- Same real downward unfolding as Aimbot -> Body Part.
    local eased =
        ease_out_cubic(anim)

    local visible_h =
        full_h * eased

    local panel_y = y
    local panel_h =
        math.max(
            2,
            visible_h
        )

    FALLEN_POPUP_GLOW(
        x,
        panel_y,
        w,
        panel_h,
        7,
        0.9
    )

    rounded_fill(
        x,
        panel_y,
        w,
        panel_h,
        7,
        { 0.070, 0.074, 0.087, 1 }
    )

    local panel_hot =
        hover(
            mx,
            my,
            x,
            panel_y,
            w,
            panel_h
        )

    for i, option in ipairs(options) do
        local iy =
            panel_y
            + (i - 1) * item_h

        local item_reveal =
            clamp(
                (
                    visible_h
                    - (i - 1) * item_h
                )
                / item_h,
                0,
                1
            )

        if item_reveal > 0.12 then
            local item_hot =
                item_reveal > 0.92
                and hover(
                    mx,
                    my,
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4
                )

            if item_hot then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4,
                    5,
                    { 0.105, 0.111, 0.132, 1 }
                )
            end

            local selected =
                tostring(S.armor_esp_mode or "Normal")
                == option

            if selected then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    3,
                    item_h - 4,
                    1,
                    C.accent
                )
            end

            text(
                x + 12,
                iy + 8,
                option,
                FALLEN_HOVER_TEXT(
                    "armor_mode_option:" .. tostring(option),
                    item_hot,
                    selected and C.text or C.text_dim
                )
            )

            if clicked
                and item_hot
                and A.armor_mode_dropdown_open
            then
                S.armor_esp_mode = option
                A.armor_mode_dropdown_open = false
                return true
            end
        end
    end

    return panel_hot
end

