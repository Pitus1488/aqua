function FALLEN_DMGNUM_SETTINGS_STEP_ANIM()
    local now =
        tick()

    if A.damage_numbers_settings_last_t == nil then
        A.damage_numbers_settings_last_t =
            now
    end

    local dt =
        clamp(
            now - A.damage_numbers_settings_last_t,
            0,
            0.05
        )

    A.damage_numbers_settings_last_t =
        now

    local target =
        A.damage_numbers_settings_open
        and 1
        or 0

    local speed =
        target > (A.damage_numbers_settings_anim or 0)
        and 13
        or 10

    A.damage_numbers_settings_anim =
        exp_chase(
            A.damage_numbers_settings_anim or 0,
            target,
            speed,
            dt
        )

    if target == 0
        and (A.damage_numbers_settings_anim or 0) < 0.02
    then
        A.damage_numbers_settings_anim =
            0
    elseif target == 1
        and (A.damage_numbers_settings_anim or 0) > 0.992
    then
        A.damage_numbers_settings_anim =
            1
    end

    return
        clamp(
            A.damage_numbers_settings_anim or 0,
            0,
            1
        )
end


