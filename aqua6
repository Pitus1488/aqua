                    5,
                    C.frame_active
                )
            end

            local selected =
                (
                    value == "Auto"
                    and tostring(S.menu_scale_percent) == "Auto"
                )
                or (
                    type(value) == "number"
                    and tonumber(S.menu_scale_percent) == value
                )

            if selected then
                rounded_fill(
                    x + 4,
                    iy + 3,
                    3,
                    item_h - 6,
