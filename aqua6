-- =========================================================
-- Base / House 3D tuning helpers
-- Deliberately global: the host Lua has a 200-local main-chunk limit.
-- =========================================================

function world_base_color_prefix(id)
    return "world_base_color_" .. tostring(id)
end

function world_base_rgb_to_hsv(r, g, b)
    r = clamp(tonumber(r) or 1, 0, 1)
    g = clamp(tonumber(g) or 1, 0, 1)
    b = clamp(tonumber(b) or 1, 0, 1)

    local mx = math.max(r, g, b)
    local mn = math.min(r, g, b)
    local d = mx - mn

    local h = 0
    if d > 0.000001 then
        if mx == r then
            h = ((g - b) / d) % 6
        elseif mx == g then
            h = ((b - r) / d) + 2
        else
            h = ((r - g) / d) + 4
        end
        h = h / 6
    end

    local s = mx <= 0 and 0 or (d / mx)
    return h, s, mx
end

function world_base_state_key(cfg, suffix)
    if not cfg or not cfg.id then
        return nil
    end
    return "world_base_" .. tostring(cfg.id) .. (suffix or "")
end

function world_base_ensure_state(cfg)
    if not cfg or not cfg.id then
        return
    end

    local p = "world_base_" .. tostring(cfg.id)

    if S[p] == nil then S[p] = false end
    if S[p .. "_sx"] == nil then S[p .. "_sx"] = cfg.sx or 4 end
    if S[p .. "_sy"] == nil then S[p .. "_sy"] = cfg.sy or 4 end
    if S[p .. "_sz"] == nil then S[p .. "_sz"] = cfg.sz or 4 end

    if S[p .. "_ox"] == nil then S[p .. "_ox"] = 0 end
    if S[p .. "_oy"] == nil then S[p .. "_oy"] = 0 end
    if S[p .. "_oz"] == nil then S[p .. "_oz"] = 0 end

    if S[p .. "_thick"] == nil then S[p .. "_thick"] = 1.4 end

    local cp = world_base_color_prefix(cfg.id)

    if S[cp .. "_h"] == nil
        or S[cp .. "_s"] == nil
        or S[cp .. "_v"] == nil
        or S[cp .. "_alpha"] == nil
    then
        local c = cfg.color or {1, 1, 1, 1}
        local h, s, v =
            world_base_rgb_to_hsv(
                c[1] or 1,
                c[2] or 1,
                c[3] or 1
            )

        if S[cp .. "_h"] == nil then S[cp .. "_h"] = h end
        if S[cp .. "_s"] == nil then S[cp .. "_s"] = s end
        if S[cp .. "_v"] == nil then S[cp .. "_v"] = v end
        if S[cp .. "_alpha"] == nil then
            S[cp .. "_alpha"] =
                math.floor(
                    clamp(c[4] or 1, 0, 1) * 100 + 0.5
                )
        end
    end
end

function world_base_enabled(cfg)
    if not cfg then
        return false
    end
    world_base_ensure_state(cfg)
    return S["world_base_" .. tostring(cfg.id)] == true
end

function world_any_base_enabled()
    for i = 1, #WORLD_BASE_ITEMS do
        if world_base_enabled(WORLD_BASE_ITEMS[i]) then
            return true
        end
    end
    return false
end

function world_base_cfg_by_id(id)
    for i = 1, #WORLD_BASE_ITEMS do
        local cfg = WORLD_BASE_ITEMS[i]
        if cfg and cfg.id == id then
            return cfg
        end
    end
    return nil
end

-- Fallback edge list: a cuboid has exactly 12 edges.
WORLD_BASE_BOX_EDGES = {
    {1,2}, {2,3}, {3,4}, {4,1},
    {5,6}, {6,7}, {7,8}, {8,5},
    {1,5}, {2,6}, {3,7}, {4,8},
}

function world_draw_tunable_box3d(pos, cfg, col, alpha)
    if not pos or not cfg then
        return false
    end

    world_base_ensure_state(cfg)

    local p = "world_base_" .. tostring(cfg.id)
    local sx = clamp(tonumber(S[p .. "_sx"]) or cfg.sx or 4, 0.25, 30)
    local sy = clamp(tonumber(S[p .. "_sy"]) or cfg.sy or 4, 0.25, 30)
    local sz = clamp(tonumber(S[p .. "_sz"]) or cfg.sz or 4, 0.25, 30)

    local ox = clamp(tonumber(S[p .. "_ox"]) or 0, -15, 15)
    local oy = clamp(tonumber(S[p .. "_oy"]) or 0, -15, 15)
    local oz = clamp(tonumber(S[p .. "_oz"]) or 0, -15, 15)

    local thick = clamp(tonumber(S[p .. "_thick"]) or 1.4, 0.5, 5.0)

    local center = nil
    local ok_center, vcenter = pcall(function()
        return Vector3(
            (pos.X or 0) + ox,
            (pos.Y or 0) + oy,
            (pos.Z or 0) + oz
        )
    end)

    if ok_center then
        center = vcenter
    end

    if not center then
        return false
    end

    local r = col[1] or 1
    local g = col[2] or 1
    local b = col[3] or 1

    -- Preferred path: native 12-edge world-space box.
    if Drawing and type(Drawing.DrawBox3D) == "function" then
        local ok = pcall(
            Drawing.DrawBox3D,
            center,
            sx,
            sy,
            sz,
            r,
            g,
            b,
            alpha,
            thick
        )
        if ok then
            return true
        end
    end

    -- Fallback: explicitly draw the same 12 edges.
    local hx = sx * 0.5
    local hy = sy * 0.5
    local hz = sz * 0.5

    local corners = {
        Vector3(center.X - hx, center.Y - hy, center.Z - hz),
        Vector3(center.X + hx, center.Y - hy, center.Z - hz),
        Vector3(center.X + hx, center.Y + hy, center.Z - hz),
        Vector3(center.X - hx, center.Y + hy, center.Z - hz),

        Vector3(center.X - hx, center.Y - hy, center.Z + hz),
        Vector3(center.X + hx, center.Y - hy, center.Z + hz),
        Vector3(center.X + hx, center.Y + hy, center.Z + hz),
        Vector3(center.X - hx, center.Y + hy, center.Z + hz),
    }

    if Drawing and type(Drawing.DrawLine3D) == "function" then
        for i = 1, #WORLD_BASE_BOX_EDGES do
            local e = WORLD_BASE_BOX_EDGES[i]
            pcall(
                Drawing.DrawLine3D,
                corners[e[1]],
                corners[e[2]],
                r, g, b, alpha, thick
            )
        end
        return true
    end

    if Drawing
        and type(Drawing.WorldToScreen) == "function"
        and type(Drawing.DrawLine) == "function"
    then
        local screens = {}
        for i = 1, 8 do
            local ok, s = pcall(Drawing.WorldToScreen, corners[i])
            if ok and s and s.X and s.Y and s.X ~= -1 and s.Y ~= -1 then
                screens[i] = s
            end
        end

        for i = 1, #WORLD_BASE_BOX_EDGES do
            local e = WORLD_BASE_BOX_EDGES[i]
            local a = screens[e[1]]
            local z = screens[e[2]]
            if a and z then
                pcall(
                    Drawing.DrawLine,
                    a.X, a.Y,
                    z.X, z.Y,
                    r, g, b, alpha, thick
                )
            end
        end
        return true
    end

    return false
end

function world_base_row_clip_alpha(
    row_y,
    card_y,
    card_h
)
    local center =
        row_y + 20.5

    local top_full =
        card_y + 25

    local top_zero =
        card_y + 7

    local bottom_full =
        card_y + card_h - 25

    local bottom_zero =
        card_y + card_h - 7

    local top_a =
        clamp(
            (center - top_zero)
            / math.max(
                1,
                top_full - top_zero
            ),
            0,
            1
        )

    local bottom_a =
        clamp(
            (bottom_zero - center)
            / math.max(
                1,
                bottom_zero - bottom_full
            ),
            0,
            1
        )

    return
        smooth01(
            math.min(
                top_a,
                bottom_a
            )
        )
end

function world_base_compact_row(mx, my, clicked, x, y, w, cfg)
    if not cfg then return end
    world_base_ensure_state(cfg)

    local h = 41
    local hot = row_hover(mx, my, x, y, w, h)
    local key = "world_base_" .. tostring(cfg.id)
    local enabled = S[key] == true
    local prefix = world_base_color_prefix(cfg.id)
    local col = world_color_from_prefix(prefix)

    text(
        x + 29,
        y + 14,
        cfg.label,
        FALLEN_HOVER_TEXT(
            "house:" .. tostring(cfg.id),
            hot,
            C.text
        )
    )

    if A.toggles[key] == nil then
        A.toggles[key] = enabled and 1 or 0
    end

    local target = enabled and 1 or 0
    A.toggles[key] = lerp(A.toggles[key], target, 0.23)

    if math.abs(A.toggles[key] - target) < 0.002 then
        A.toggles[key] = target
    end

    local tw, th = 35, 19
    local tx = x + w - tw - 12
    local ty = y + 11

    -- Same placement as Ore / Plants.
    local swatch_s = 18
    local swatch_x = tx - swatch_s - 12
    local swatch_y = y + 11

    world_square_swatch(
        swatch_x,
        swatch_y,
        swatch_s,
        col
    )

    local swatch_hot =
        hover(
            mx,
            my,
            swatch_x,
            swatch_y,
            swatch_s,
            swatch_s
        )

    rounded_fill(
        tx,
        ty,
        tw,
        th,
        th * 0.5,
        mix_color(
            C.toggle_off,
            C.accent_dim,
            A.toggles[key]
        )
    )

    local knob_x =
        lerp(
            tx + 9.5,
            tx + tw - 9.5,
            A.toggles[key]
        )

    circle_fill(
        knob_x,
        ty + th * 0.5,
        7,
        mix_color(
            C.toggle_knob,
            C.white,
            A.toggles[key]
        )
    )

    if clicked and swatch_hot then
        FALLEN_COLOR_INPUT_STOP(true)

        if A.world_color_picker_open
            and A.world_color_picker_key == prefix
        then
            A.world_color_picker_open = false
            A.world_color_picker_drag = nil
        else
            A.world_color_picker_key = prefix
            A.world_color_picker_open = true
            A.world_color_picker_drag = nil
            A.fov_picker_open = false
            A.fov_picker_drag = nil
        end

        A.world_color_picker_anchor_x = FALLEN_UI_X(swatch_x)
        A.world_color_picker_anchor_y = FALLEN_UI_Y(swatch_y)
        A.world_color_picker_anchor_w = FALLEN_UI_LEN(swatch_s)
        A.world_color_picker_anchor_h = FALLEN_UI_LEN(swatch_s)

        if numeric_stop then
            numeric_stop(true)
        end

        return
    end

    local toggle_hot =
        hover(
            mx,
            my,
            tx,
            ty,
            tw,
            th
        )

    if clicked and toggle_hot then
        S[key] = not enabled
        WORLD_ESP.last_scan = -100
        return
    end

    if clicked and hot and not swatch_hot then
        S[key] = not enabled
        WORLD_ESP.last_scan = -100
    end

end

function world_base_settings_step_anim()
    local now = tick()

    if A.base_box_settings_last_t == nil then
        A.base_box_settings_last_t = now
    end

    local dt = clamp(
        now - A.base_box_settings_last_t,
        0,
        0.05
    )

    A.base_box_settings_last_t = now

    local target = A.base_box_settings_open and 1 or 0
    local speed = target > (A.base_box_settings_anim or 0) and 10.0 or 8.0

    A.base_box_settings_anim = exp_chase(
        A.base_box_settings_anim or 0,
        target,
        speed,
        dt
    )

    if target == 0 and (A.base_box_settings_anim or 0) < 0.018 then
        A.base_box_settings_anim = 0
        A.base_box_settings_id = nil
    elseif target == 1 and (A.base_box_settings_anim or 0) > 0.992 then
        A.base_box_settings_anim = 1
    end

    return clamp(A.base_box_settings_anim or 0, 0, 1)
end

function world_base_read_wheel()
    local candidates = {
        "GetMouseWheelDelta",
        "GetWheelDelta",
        "MouseWheelDelta",
        "GetMouseWheel",
        "MouseWheel",
        "WheelDelta",
        "wheel_delta",
        "mouse_wheel_delta",
        "get_mouse_wheel_delta",
        "get_wheel_delta",
    }

    local function probe(t)
        if type(t) ~= "table" then
            return 0
        end

        for i = 1, #candidates do
            local v = t[candidates[i]]

            if type(v) == "function" then
                local ok, result = pcall(v)
                if ok and type(result) == "number" and result ~= 0 then
                    return result
                end
            elseif type(v) == "number" and v ~= 0 then
                return v
            end
        end

        for k, v in pairs(t) do
            if type(k) == "string"
                and string.find(
                    string.lower(k),
                    "wheel",
                    1,
                    true
                )
            then
                if type(v) == "function" then
                    local ok, result = pcall(v)
                    if ok and type(result) == "number" and result ~= 0 then
                        return result
                    end
                elseif type(v) == "number" and v ~= 0 then
                    return v
                end
            end
        end

        return 0
    end

    local value = probe(Windows)
    if value ~= 0 then return value end

    value = probe(_G)
    if value ~= 0 then return value end

    value = probe(_G.Input)
    if value ~= 0 then return value end

    value = probe(_G.input)
    if value ~= 0 then return value end

    value = probe(_G.Mouse)
    if value ~= 0 then return value end

    value = probe(_G.mouse)
    if value ~= 0 then return value end

    return 0
end

function world_base_column_scroll_step(
    side,
    mx,
    my,
    clicked,
    lmb,
    x,
    y,
    w,
    h,
    visible_rows,
    total_rows
)
    local p = "base_" .. tostring(side) .. "_scroll"
    local target_key = p .. "_target"
    local visual_key = p .. "_visual"
    local drag_key = p .. "_dragging"
    local drag_off_key = p .. "_drag_offset"
    local last_t_key = p .. "_last_t"
    local wheel_key = p .. "_wheel_raw"

    local max_scroll =
        math.max(
            0,
            (tonumber(total_rows) or 0)
            - (tonumber(visible_rows) or 0)
        )

    if A[target_key] == nil then A[target_key] = 0 end
    if A[visual_key] == nil then A[visual_key] = A[target_key] end

    A[target_key] =
        clamp(
            tonumber(A[target_key]) or 0,
            0,
            max_scroll
        )

    local hot = hover(mx, my, x, y, w, h)

    if hot then
        local raw = world_base_read_wheel()

        if raw == 0 then
            A[wheel_key] = 0
        elseif raw ~= (A[wheel_key] or 0) then
            A[wheel_key] = raw

            if raw > 0 then
                A[target_key] = A[target_key] - 1
            else
                A[target_key] = A[target_key] + 1
            end
        end

        -- This API build does not document a mouse-wheel delta event.
        -- Up/Down/PageUp/PageDown affect only the column under the cursor.
        local up, down, pgup, pgdn = false, false, false, false

        pcall(function()
            up = Windows.IsKeyPressed(VK.UP) == true
            down = Windows.IsKeyPressed(VK.DOWN) == true
            pgup = Windows.IsKeyPressed(0x21) == true
            pgdn = Windows.IsKeyPressed(0x22) == true
        end)

        local nav = p .. "_nav_"

        if up and not A[nav .. "up"] then
            A[target_key] = A[target_key] - 1
        end

        if down and not A[nav .. "down"] then
            A[target_key] = A[target_key] + 1
        end

        if pgup and not A[nav .. "pgup"] then
            A[target_key] = A[target_key] - visible_rows
        end

        if pgdn and not A[nav .. "pgdn"] then
            A[target_key] = A[target_key] + visible_rows
        end

        A[nav .. "up"] = up
        A[nav .. "down"] = down
        A[nav .. "pgup"] = pgup
        A[nav .. "pgdn"] = pgdn

        -- Mouse fallback for this API build:
        -- hold the middle mouse button over a column and drag vertically.
        -- One row of mouse movement equals roughly one list row.
        local middle = false

        pcall(function()
            middle =
                Windows.IsKeyPressed(0x04)
                == true
        end)

        local pan_key =
            p .. "_middle_pan"

        local pan_y_key =
            p .. "_middle_pan_y"

        if middle then
            if not A[pan_key] then
                A[pan_key] = true
                A[pan_y_key] = my
            else
                local old_y =
                    tonumber(A[pan_y_key])
                    or my

                local dy =
                    my - old_y

                if math.abs(dy) > 0.01 then
                    A[target_key] =
                        A[target_key]
                        - (dy / 41)

                    A[pan_y_key] = my
                end
            end
        else
            A[pan_key] = false
            A[pan_y_key] = nil
        end
    else
        A[wheel_key] = 0

        local nav = p .. "_nav_"
        A[nav .. "up"] = false
        A[nav .. "down"] = false
        A[nav .. "pgup"] = false
        A[nav .. "pgdn"] = false

        A[p .. "_middle_pan"] = false
        A[p .. "_middle_pan_y"] = nil
    end

    A[target_key] =
        clamp(
            A[target_key],
            0,
            max_scroll
        )

    local now = tick()
    local last_t = A[last_t_key] or now
    local dt = clamp(now - last_t, 0, 0.05)
    A[last_t_key] = now

    A[visual_key] =
        exp_chase(
            tonumber(A[visual_key]) or A[target_key],
            A[target_key],
            A[drag_key] and 18.0 or 11.0,
            dt
        )

    if math.abs(A[visual_key] - A[target_key]) < 0.002 then
        A[visual_key] = A[target_key]
    end

    -- Keep the scrollbar away from the toggle/swatch controls.
    -- The rail sits on the outer card edge instead of inside the row.
    local track_x = x + w + 1
    local track_y = y + 6
    local track_h = h - 12

    local ratio =
        total_rows > 0
        and clamp(visible_rows / total_rows, 0, 1)
        or 1

    local knob_h =
        max_scroll > 0
        and math.max(32, track_h * ratio)
        or track_h

    local travel =
        math.max(
            0,
            track_h - knob_h
        )

    local frac =
        max_scroll > 0
        and clamp(A[visual_key] / max_scroll, 0, 1)
        or 0

    local knob_y =
        track_y
        + travel * frac

    rounded_fill(
        track_x,
        track_y,
        1.5,
        track_h,
        1,
        alpha(C.toggle_off, 0.48)
    )

    rounded_fill(
        track_x - 1,
        knob_y,
        3,
        knob_h,
        2,
        A[drag_key]
            and C.accent
            or alpha(C.accent_dim, 0.82)
    )

    local knob_hot =
        hover(
            mx,
            my,
            track_x - 3,
            knob_y - 2,
            8,
            knob_h + 4
        )

    local track_hot =
        hover(
            mx,
            my,
            track_x - 3,
            track_y,
            8,
            track_h
        )

    if clicked
        and max_scroll > 0
        and (knob_hot or track_hot)
    then
        A[drag_key] = true

        A[drag_off_key] =
            knob_hot
            and (my - knob_y)
            or (knob_h * 0.5)
    end

    if A[drag_key]
        and lmb
        and max_scroll > 0
    then
        local wanted_y =
            my
            - (A[drag_off_key] or knob_h * 0.5)

        local t =
            travel > 0
            and clamp(
                (wanted_y - track_y) / travel,
                0,
                1
            )
            or 0

        A[target_key] =
            t * max_scroll
    elseif A[drag_key]
        and not lmb
    then
        A[drag_key] = false
    end

    return
        clamp(
            tonumber(A[visual_key]) or 0,
            0,
            max_scroll
        )
end

