function FALLEN_BT_IMAGE_GET(key, url)
    if type(LoadImage) ~= "function"
        or not key
        or not url
    then
        return nil
    end

    local handle =
        FALLEN_BT_IMAGE[key]

    -- Reuse the sequential startup preload exactly like the other URL images.
    -- This avoids a second LoadImage request the first time Galaxy is drawn.
    if not handle
        and type(_G.FALLEN_IMAGE_PRELOAD_HANDLES) == "table"
    then
        local preloaded =
            _G.FALLEN_IMAGE_PRELOAD_HANDLES[url]

        if preloaded then
            FALLEN_BT_IMAGE[key] = preloaded
            handle = preloaded
        end
    end

    if not handle then
        local ok, loaded =
            pcall(
                LoadImage,
                url
            )

        if ok and loaded then
            FALLEN_BT_IMAGE[key] = loaded
            handle = loaded
        end
    end

    if not handle then
        return nil
    end

    if type(IsImageFailed) == "function" then
        local ok, failed =
            pcall(
                IsImageFailed,
                handle
            )

        if ok and failed == true then
            FALLEN_BT_IMAGE[key] = nil
            return nil
        end
    end

    if type(IsImageReady) == "function" then
        local ok, ready =
            pcall(
                IsImageReady,
                handle
            )

        if ok and ready == true then
            return handle
        end

        return nil
    end

    return handle
end

-- Galaxy URL fallback for hosts where Drawing.LoadImage cannot consume the
-- fotovssylku page/redirect directly.  We fetch it once in the startup worker,
-- extract the actual image URL when needed, save the binary body locally, then
-- let stb_image load the local file.  Never call this from on_render.
function FALLEN_BT_GALAXY_HTML_DECODE(value)
    if type(value) ~= "string" then
        return nil
    end

    value = value:gsub("\\/", "/")
    value = value:gsub("&amp;", "&")
    value = value:gsub("&#38;", "&")
    value = value:gsub("&#x26;", "&")
    value = value:gsub("&#47;", "/")
    value = value:gsub("&#x2F;", "/")
    value = value:gsub("&quot;", '"')

    return value
end

function FALLEN_BT_GALAXY_NORMALIZE_URL(value, page_url)
    value = FALLEN_BT_GALAXY_HTML_DECODE(value)
    if type(value) ~= "string" or value == "" then
        return nil
    end

    if value:sub(1, 2) == "//" then
        return "https:" .. value
    end

    if value:sub(1, 1) == "/" then
        local origin = tostring(page_url or ""):match("^(https?://[^/]+)")
        if origin then
            return origin .. value
        end
    end

    if value:match("^https?://") then
        return value
    end

    local base = tostring(page_url or ""):match("^(https?://.*/)")
    if base then
        return base .. value
    end

    return value
end

function FALLEN_BT_GALAXY_IMAGE_KIND(body)
    if type(body) ~= "string" or #body < 4 then
        return nil
    end

    if body:sub(1, 8) == "\137PNG\r\n\26\n" then
        return "png"
    end

    if body:byte(1) == 0xFF
        and body:byte(2) == 0xD8
        and body:byte(3) == 0xFF
    then
        return "jpg"
    end

    local sig6 = body:sub(1, 6)
    if sig6 == "GIF87a" or sig6 == "GIF89a" then
        return "gif"
    end

    if body:sub(1, 2) == "BM" then
        return "bmp"
    end

    return nil
end

function FALLEN_BT_GALAXY_ADD_CANDIDATE(list, seen, value, page_url)
    local url = FALLEN_BT_GALAXY_NORMALIZE_URL(value, page_url)
    if type(url) ~= "string"
        or url == ""
        or seen[url]
    then
        return
    end

    seen[url] = true
    table.insert(list, url)
end

function FALLEN_BT_GALAXY_CANDIDATES(body, page_url)
    local list = {}
    local seen = {}

    if type(body) ~= "string" then
        return list
    end

    local patterns = {
        '<meta[^>]-property%s*=%s*["\']og:image["\'][^>]-content%s*=%s*["\']([^"\']+)',
        '<meta[^>]-content%s*=%s*["\']([^"\']+)["\'][^>]-property%s*=%s*["\']og:image["\']',
        '<meta[^>]-name%s*=%s*["\']twitter:image["\'][^>]-content%s*=%s*["\']([^"\']+)',
        '<meta[^>]-content%s*=%s*["\']([^"\']+)["\'][^>]-name%s*=%s*["\']twitter:image["\']',
        '<img[^>]-src%s*=%s*["\']([^"\']+)',
        '<img[^>]-data%-src%s*=%s*["\']([^"\']+)',
        '<img[^>]-data%-original%s*=%s*["\']([^"\']+)',
        '"contentUrl"%s*:%s*"([^"]+)"',
        '"imageUrl"%s*:%s*"([^"]+)"',
        '"image"%s*:%s*"([^"]+)"',
    }

    for _, pattern in ipairs(patterns) do
        local start = 1
        while #list < 20 do
            local a, b, cap = body:find(pattern, start)
            if not a then break end
            FALLEN_BT_GALAXY_ADD_CANDIDATE(list, seen, cap, page_url)
            start = b + 1
        end
    end

    -- Last-resort scan for absolute URLs that visibly point to common image
    -- formats. This catches simple upload pages without OG metadata.
    local start = 1
    while #list < 24 do
        local a, b, cap = body:find('(https?://[^%s"\'<>]+%.[Pp][Nn][Gg][^%s"\'<>]*)', start)
        if not a then break end
        FALLEN_BT_GALAXY_ADD_CANDIDATE(list, seen, cap, page_url)
        start = b + 1
    end

    start = 1
    while #list < 24 do
        local a, b, cap = body:find('(https?://[^%s"\'<>]+%.[Jj][Pp][Ee]?[Gg][^%s"\'<>]*)', start)
        if not a then break end
        FALLEN_BT_GALAXY_ADD_CANDIDATE(list, seen, cap, page_url)
        start = b + 1
    end

    return list
end

function FALLEN_BT_GALAXY_HTTP_GET(url, referer)
    if not Http or type(Http.get) ~= "function" then
        return false, 0, nil, "Http.get unavailable"
    end

    local headers = {
        Accept = "image/png,image/jpeg,image/gif,image/bmp,text/html,*/*;q=0.5",
    }

    if type(referer) == "string" and referer ~= "" then
        headers.Referer = referer
    end

    return Http.get(
        url,
        {
            timeout_ms = 12000,
            headers = headers,
        }
    )
end

