local function fap_vec3_valid(v)
    return
        v
        and v.X ~= nil
        and v.Y ~= nil
        and v.Z ~= nil
end

local function fap_read_velocity_addr(addr)
    local out = nil

    -- Same raw AssemblyLinearVelocity path as the pasted Aimbot.
    pcall(function()
        if addr
            and addr ~= 0
            and memory
            and memory.read_ptr
            and memory.read_vec3
            and memory.offsets
        then
            local inst =
                rbx
                and rbx.instance
                and rbx.instance(addr)
                or nil

            local iaddr =
                (inst and inst.addr)
                or addr

            local prim =
                memory.read_ptr(
                    iaddr
                    + memory.offsets.Primitive
                )

            if prim
                and prim ~= 0
            then
                out =
                    memory.read_vec3(
                        prim
                        + memory.offsets.AssemblyLinearVelocity
                    )
            end
        end
    end)

    if fap_vec3_valid(out) then
        return {
            X = out.X,
            Y = out.Y,
            Z = out.Z,
        }
    end

    return nil
end

local function fap_target_velocity(p)
    local vel = nil

    if p
        and p.hrp_addr
        and p.hrp_addr ~= 0
    then
        vel =
            fap_read_velocity_addr(
                p.hrp_addr
            )

        if fap_vec3_valid(vel) then
            return vel
        end

        pcall(function()
            local hrp =
                rbx.instance(
                    p.hrp_addr
                )

            if hrp
                and hrp.get_velocity
            then
                vel =
                    hrp:get_velocity()
            end
        end)

        if fap_vec3_valid(vel) then
            return {
                X = vel.X,
                Y = vel.Y,
                Z = vel.Z,
            }
        end
    end

    if p
        and p.head_addr
        and p.head_addr ~= 0
    then
        vel =
            fap_read_velocity_addr(
                p.head_addr
            )

        if fap_vec3_valid(vel) then
            return vel
        end

        pcall(function()
            local head =
                rbx.instance(
                    p.head_addr
                )

            if head
                and head.get_velocity
            then
                vel =
                    head:get_velocity()
            end
        end)

        if fap_vec3_valid(vel) then
            return {
                X = vel.X,
                Y = vel.Y,
                Z = vel.Z,
            }
        end
    end

    return {
        X = 0,
        Y = 0,
        Z = 0,
    }
end

local function fap_predict(p, pos, cam)
    if not pos then
        return nil
    end

    if S.aim_auto_prediction ~= true then
        return {
            X = pos.X,
            Y = pos.Y,
            Z = pos.Z,
        }
    end

    local px = pos.X
    local py = pos.Y
    local pz = pos.Z

    local bullet_speed =
        tonumber(FAP.bullet_speed)
        or 1000

    local gravity =
        tonumber(FAP.gravity)
        or 35

    if bullet_speed < 1 then
        bullet_speed = 1000
    end

    local dist = 0
    local horizontal_dist = 0

    if cam
        and cam.X ~= nil
        and cam.Y ~= nil
        and cam.Z ~= nil
    then
        local dx = px - cam.X
        local dy = py - cam.Y
        local dz = pz - cam.Z

        local horizontal_sq =
            dx * dx
            + dz * dz

        horizontal_dist =
            math.sqrt(
                horizontal_sq
            )

        dist =
            math.sqrt(
                horizontal_sq
                + dy * dy
            )
    elseif p then
        dist =
            tonumber(p.distance)
            or 0

        horizontal_dist = dist
    end

    -- Full 3D travel time stays in use for movement lead.
    local time_to_hit =
        clamp(
            dist / bullet_speed,
            0,
            3
        )

    local vel =
        fap_target_velocity(p)

    local vx = vel.X or 0
    local vy = vel.Y or 0
    local vz = vel.Z or 0

    local hspeed =
        math.sqrt(
            vx * vx
            + vz * vz
        )

    local pred_scale = 1.0

    local weapon_name =
        string.lower(
            tostring(
                FAP.weapon
                or ""
            )
        )

    local is_bow =
        string.find(
            weapon_name,
            "bow",
            1,
            true
        ) ~= nil
        or string.find(
            weapon_name,
            "crossbow",
            1,
            true
        ) ~= nil

    if is_bow then
        if hspeed > 95 then
            pred_scale = 0.85
        elseif hspeed > 34 then
            pred_scale = 0.95
        else
            pred_scale = 1.00
        end
    else
        if hspeed > 34 then
            pred_scale = 0.14
        elseif hspeed > 24 then
            pred_scale = 0.20
        elseif hspeed > 16 then
            pred_scale = 0.32
        elseif hspeed > 8 then
            pred_scale = 0.48
        else
            pred_scale = 0.62
        end
    end

    local max_hspeed =
        is_bow
        and 130
        or 95

    if hspeed > max_hspeed
        and hspeed > 0
    then
        local mul =
            max_hspeed
            / hspeed

        vx = vx * mul
        vz = vz * mul
    end

    local y_scale =
        is_bow
        and 0.20
        or 0.04

    if math.abs(vy) < 3 then
        y_scale = 0
    end

    local aim_x =
        px
        + vx
        * time_to_hit
        * pred_scale

    local aim_y =
        py
        + vy
        * time_to_hit
        * y_scale

    local aim_z =
        pz
        + vz
        * time_to_hit
        * pred_scale

    -- Height-aware gravity:
    -- flat ground stays the same, but large elevation differences no longer
    -- inflate the vertical compensation just because the 3D distance is longer.
    local gravity_time =
        clamp(
            horizontal_dist
            / bullet_speed,
            0,
            3
        )

    local drop =
        0.5
        * gravity
        * gravity_time
        * gravity_time

    aim_y =
        aim_y
        + drop

    return {
        X = aim_x,
        Y = aim_y,
        Z = aim_z,
        time = time_to_hit,
    }
end

local function fap_find_bone_pos(p, names)
    if not p
        or type(p.bones) ~= "table"
    then
        return nil
    end

    local wanted = {}

    for _, name in ipairs(names) do
        wanted[string.lower(name)] = true
    end

    for _, bone in ipairs(p.bones) do
        local name =
            bone
            and (
                bone.name
                or bone.Name
            )

        local pos =
            bone
            and (
                bone.position
                or bone.Position
                or bone.pos
            )

        if name
            and pos
            and pos.X ~= nil
            and pos.Y ~= nil
            and pos.Z ~= nil
            and wanted[string.lower(tostring(name))]
        then
            return {
                X = pos.X,
                Y = pos.Y,
                Z = pos.Z,
            }
        end
    end

    return nil
end

local function fap_target_pos(p)
    if not p then
        return nil
    end

    local part =
        tostring(
            S.aim_target_part
            or "Head"
        )

    if part == "Head" then
        if p.head_pos
            and p.head_pos.X
            and p.head_pos.Y
            and p.head_pos.Z
        then
            return p.head_pos
        end

        local head =
            fap_find_bone_pos(
                p,
                { "Head" }
            )

        if head then
            return head
        end
    end

    if part == "UpperTorso" then
        local upper =
            fap_find_bone_pos(
                p,
                {
                    "UpperTorso",
                    "Torso",
                }
            )

        if upper then
            return upper
        end
    end

    if part == "LowerTorso" then
        local lower =
            fap_find_bone_pos(
                p,
                {
                    "LowerTorso",
                    "Torso",
                }
            )

        if lower then
            return lower
        end
    end

    if part == "Torso" then
        local torso =
            fap_find_bone_pos(
                p,
                {
                    "UpperTorso",
                    "Torso",
                    "LowerTorso",
                }
            )

        if torso then
            return torso
        end
    end

    if part == "HumanoidRootPart" then
        local root =
            fap_find_bone_pos(
                p,
                {
                    "HumanoidRootPart",
                    "RootPart",
                }
            )

        if root then
            return root
        end

        if p.position
            and p.position.X
            and p.position.Y
            and p.position.Z
        then
            return {
                X = p.position.X,
                Y = p.position.Y,
                Z = p.position.Z,
            }
        end
    end

    -- Cache-position fallbacks for rigs where bone data is unavailable.
    if p.position
        and p.position.X
        and p.position.Y
        and p.position.Z
    then
        local add_y = 2.0

        if part == "Torso"
            or part == "UpperTorso"
        then
            add_y = 1.45
        elseif part == "LowerTorso" then
            add_y = 0.75
        elseif part == "HumanoidRootPart" then
            add_y = 0
        end

        return {
            X = p.position.X,
            Y = p.position.Y + add_y,
            Z = p.position.Z,
        }
    end

    return nil
end

local function fap_valid_target(p)
    if not p
        or p.is_self
        or p.is_knocked
        or p.is_dead
    then
        return false
    end

    if p.health ~= nil
        and (
            tonumber(p.health)
            or 0
        ) <= 1
    then
        return false
    end

    if p.address ~= nil
        and p.address == 0
    then
        return false
    end

    local pos =
        fap_target_pos(p)

    if not pos then
        return false
    end

    if pos.X == 0
        and pos.Y == 0
        and pos.Z == 0
    then
        return false
    end

    local max_dist =
        tonumber(S.aim_max_dist)
        or 1200

    if p.distance
        and (
            p.distance <= 1
            or p.distance > max_dist
        )
    then
        return false
    end

    return true
end

local function fap_hold_down()
    return
        key_down(
            tonumber(S.aim_hold_key)
            or 0x06
        )
end

local function fap_clear_lock()
    FAP.locked_target_addr = nil

    FAP.current_target_addr = nil
    FAP.current_target_name = nil
    FAP.current_target_pos = nil
    FAP.current_target_health = nil
    FAP.current_prediction_time = 0
    FAP.current_prediction_gravity = 0
    FAP.current_prediction_speed = 0
    FAP.current_auto_prediction = false
    FAP.current_target_seen = 0
end

local function fap_find_target(cross, cam)
    if not players
        or type(players.get_all) ~= "function"
    then
        return nil
    end

    local ok, all =
        pcall(
            players.get_all
        )

    if not ok
        or type(all) ~= "table"
    then
        return nil
    end

    local fov =
        clamp(
            tonumber(S.aim_fov_size)
            or 50,
            10,
            600
        )

    local use_fov =
        S.aim_fov_enabled == true

    local best = nil
    local best_sd = math.huge

    -- Sticky Aim: keep the same valid target while the aim key is held.
    if S.sticky_aim == true
        and FAP.locked_target_addr
    then
        for _, p in ipairs(all) do
            if p.address
                == FAP.locked_target_addr
            then
                if fap_valid_target(p) then
                    return p
                end

                FAP.locked_target_addr = nil
                break
            end
        end
    end

    for _, p in ipairs(all) do
        if fap_valid_target(p) then
            local pos =
                fap_target_pos(p)

            local predicted =
                fap_predict(
                    p,
                    pos,
                    cam
                )
                or pos

            local s = nil

            pcall(function()
                s =
                    aim.world_to_screen(
                        predicted
                    )
            end)

            if s
                and s.visible
            then
                local dx =
                    (s.X or 0)
                    - (cross.X or 0)

                local dy =
                    (s.Y or 0)
                    - (cross.Y or 0)

                local sd =
                    math.sqrt(
                        dx * dx
                        + dy * dy
                    )

                if (
                        not use_fov
                        or sd <= fov
                    )
                    and sd < best_sd
                then
                    best_sd = sd
                    best = p
                end
            end
        end
    end

    if best
        and S.sticky_aim == true
    then
        FAP.locked_target_addr =
            best.address
    end

    return best
end


function FALLEN_CUSTOM_AIMBOT_TICK()
    -- This is OUR custom Aimbot runtime.
    -- Never enable or depend on cheat.aimbot here.
    if S.aim_enabled ~= true then
        fap_clear_lock()
        return
    end

    -- Hold-bind behavior from the original custom Aimbot.
    if not fap_hold_down() then
        fap_clear_lock()
        return
    end

    if not aim
        or type(aim.world_to_screen) ~= "function"
        or type(aim.get_camera_position) ~= "function"
    then
        fap_clear_lock()
        return
    end

    -- Auto Prediction actually updates weapon-specific speed/gravity.
    -- When the toggle is OFF, fap_refresh_weapon() resets to the
    -- neutral/default prediction values and fap_predict() returns raw pos.
    fap_refresh_weapon()

    local cam = nil

    pcall(function()
        cam =
            aim.get_camera_position()
    end)

    if not cam then
        fap_clear_lock()
        return
    end

    -- Use the exact same center as the visible custom FOV renderer.
    local mx, my =
        FALLEN_CUSTOM_FOV_CENTER()

    mx =
        tonumber(mx)

    my =
        tonumber(my)

    if not mx
        or not my
    then
        fap_clear_lock()
        return
    end

    local cross = {
        X = mx,
        Y = my,
    }

    local target =
        fap_find_target(
            cross,
            cam
        )

    if not target then
        fap_clear_lock()
        return
    end

    local base_pos =
        fap_target_pos(
            target
        )

    if not base_pos then
        fap_clear_lock()
        return
    end

    local target_pos =
        fap_predict(
            target,
            base_pos,
            cam
        )
        or base_pos

    if not target_pos then
        fap_clear_lock()
        return
    end

    -- Make sure the final predicted point is on screen before snapping.
    local screen = nil

    pcall(function()
        screen =
            aim.world_to_screen(
                target_pos
            )
    end)

    if not screen
        or screen.visible == false
    then
        fap_clear_lock()
        return
    end

    -- Keep runtime target state alive for the existing hit/tracer/target effects.
    FAP.current_target_addr =
        target.address

    FAP.current_target_name =
        target.name
        or target.display_name
        or target.Name

    FAP.current_target_pos = {
        X = target_pos.X,
        Y = target_pos.Y,
        Z = target_pos.Z,
    }

    FAP.current_target_health =
        tonumber(
            target.health
        )

    FAP.current_auto_prediction =
        S.aim_auto_prediction == true

    FAP.current_prediction_time =
        tonumber(
            target_pos.time
        )
        or 0

    FAP.current_prediction_gravity =
        S.aim_auto_prediction == true
        and (
            tonumber(FAP.gravity)
            or 0
        )
        or 0

    FAP.current_prediction_speed =
        S.aim_auto_prediction == true
        and (
            tonumber(FAP.bullet_speed)
            or 0
        )
        or 0

    FAP.current_target_seen =
        tick()

    -- Original custom Aimbot behavior: rotate the camera directly
    -- toward the selected/predicted world point.
    if type(aim.look_at_matrix) == "function"
        and type(aim.set_camera_rotation) == "function"
    then
        local mat = nil

        pcall(function()
            mat =
                aim.look_at_matrix(
                    cam,
                    target_pos
                )
        end)

        if mat then
            pcall(function()
                aim.set_camera_rotation(
                    mat
                )
            end)

            return
        end
    end

    -- Compatibility fallback for API builds without look_at_matrix.
    -- This still moves toward the same predicted screen point.
    if type(aim.move_mouse) == "function" then
        pcall(function()
            aim.move_mouse({
                X = screen.X,
                Y = screen.Y,
            })
        end)
    end
end


hooks.on_render(function()
    if _G.FallenMenuReady ~= true then
        return
    end

    local ok =
        pcall(
            FALLEN_CUSTOM_AIMBOT_TICK
        )

    if not ok then
        -- Never spam the console from an aim render callback.
        fap_clear_lock()
    end
end)


function FALLEN_SILENT_NORMALIZE_KEY(
    value
)
    local out =
        string.lower(
            tostring(
                value
                or ""
            )
        )

    return string.gsub(
        out,
        "[^%w]",
        ""
    )
end


function FALLEN_SILENT_LIVE_SECTION()
    if not cheat then
        return nil
    end

    return cheat.silent_aim
end


function FALLEN_SILENT_SECTION_KEYS()
    local sa =
        FALLEN_SILENT_LIVE_SECTION()

    if not sa
        or type(sa._keys) ~= "function"
    then
        return nil
    end

    local ok, keys =
        pcall(function()
            return sa:_keys()
        end)

    if ok
        and type(keys) == "table"
    then
        return keys
    end

    return nil
end


function FALLEN_SILENT_KEY_TYPE(
    key
)
    local sa =
        FALLEN_SILENT_LIVE_SECTION()

    if not sa
        or not key
        or type(sa._type) ~= "function"
    then
        return nil
    end

    local ok, value =
        pcall(function()
            return sa:_type(key)
        end)

    if ok then
        return tostring(
            value
            or ""
        )
    end

    return nil
end


function FALLEN_SILENT_FIND_LIVE_KEY(
    purpose
)
    A.silent_live_keys =
        A.silent_live_keys
        or {}

    local cached =
        A.silent_live_keys[purpose]

    if cached then
        return cached
    end

    local keys =
        FALLEN_SILENT_SECTION_KEYS()

    local wanted = nil

    if purpose == "sticky" then
        wanted = {
            "sticky_aim",
            "stickyaim",
            "sticky",
            "sticky_target",
            "stickytarget",
            "target_lock",
            "targetlock",
            "lock_target",
            "locktarget",
        }
    elseif purpose == "max_distance" then
        wanted = {
            "max_distance",
            "maxdistance",
            "max_dist",
            "maxdist",
            "target_distance",
            "targetdistance",
            "distance",
            "max_range",
            "maxrange",
            "range",
        }
    elseif purpose == "team_check" then
        wanted = {
            "team_check",
            "teamcheck",
        }
    elseif purpose == "target_part" then
        wanted = {
            "target_part",
            "targetpart",
            "hit_part",
            "hitpart",
        }
    elseif purpose == "magic_bullet" then
        wanted = {
            "magic_bullet",
            "magicbullet",
        }
    elseif purpose == "enabled" then
        wanted = {
            "enabled",
        }
    elseif purpose == "key" then
        wanted = {
            "key",
            "aim_key",
            "aimkey",
            "silent_key",
            "silentkey",
            "hotkey",
            "bind",
            "keybind",
        }
    elseif purpose == "key_mode" then
        wanted = {
            "key_mode",
            "keymode",
            "bind_mode",
            "bindmode",
        }
    elseif purpose == "fov" then
        wanted = {
            "fov",
            "fov_size",
            "fovsize",
        }
    elseif purpose == "fov_only" then
        wanted = {
            "fov_enabled",
            "fovenabled",
            "enabled_fov",
            "enabledfov",
            "fov_only",
            "fovonly",
            "use_fov",
            "usefov",
            "fov_check",
            "fovcheck",
            "check_fov",
            "checkfov",
            "limit_fov",
            "limitfov",
            "fov_limit",
            "fovlimit",
        }
    end

    if type(wanted) ~= "table" then
        return nil
    end

    -- _keys() is the preferred source of truth. If this build does not
    -- expose it for some reason, fall back to the documented/common field
    -- names and let the protected assignment decide whether the field exists.
    if type(keys) ~= "table" then
        if purpose == "enabled" then
            return "enabled"
        elseif purpose == "team_check" then
            return "team_check"
        elseif purpose == "target_part" then
            return "target_part"
        elseif purpose == "magic_bullet" then
            return "magic_bullet"
        elseif purpose == "sticky" then
            return "sticky_aim"
        elseif purpose == "max_distance" then
            return "max_distance"
        elseif purpose == "key" then
            return "key"
        elseif purpose == "key_mode" then
            return "key_mode"
        elseif purpose == "fov" then
            return "fov"
        elseif purpose == "fov_only" then
            local sa =
                FALLEN_SILENT_LIVE_SECTION()

            if sa then
                local probes = {
                    "fov_enabled",
                    "fov_only",
                    "use_fov",
                    "fov_check",
                    "fov_limit",
                }

                for _, probe in ipairs(probes) do
                    local ok_probe, probe_value =
                        pcall(function()
                            return sa[probe]
                        end)

                    if ok_probe
                        and type(probe_value) == "boolean"
                    then
                        return probe
                    end
                end
            end

            return nil
        end

        return nil
    end

    -- Exact/alias pass first.
    for _, candidate in ipairs(wanted) do
        local cn =
            FALLEN_SILENT_NORMALIZE_KEY(
                candidate
            )

        for _, key in ipairs(keys) do
            local kn =
                FALLEN_SILENT_NORMALIZE_KEY(
                    key
                )

            if kn == cn then
                A.silent_live_keys[purpose] =
                    tostring(key)

                return tostring(key)
            end
        end
    end

    -- Semantic fallback, still constrained to real keys from _keys().
    for _, key in ipairs(keys) do
        local raw =
            tostring(key)

        local kn =
            FALLEN_SILENT_NORMALIZE_KEY(
                raw
            )

        local match = false

        if purpose == "sticky" then
            match =
                string.find(
                    kn,
                    "sticky",
                    1,
                    true
                ) ~= nil
                or (
                    string.find(
                        kn,
                        "target",
                        1,
                        true
                    )
                    and string.find(
                        kn,
                        "lock",
                        1,
                        true
                    )
                )
        elseif purpose == "max_distance" then
            match =
                (
                    string.find(
                        kn,
                        "max",
                        1,
                        true
                    )
                    and (
                        string.find(
                            kn,
                            "dist",
                            1,
                            true
                        )
                        or string.find(
                            kn,
                            "range",
                            1,
                            true
                        )
                    )
                )
                or kn == "distance"
                or kn == "range"
        elseif purpose == "fov_only" then
            local has_fov =
                string.find(
                    kn,
                    "fov",
                    1,
                    true
                ) ~= nil

            local has_toggle_word =
                string.find(
                    kn,
                    "enable",
                    1,
                    true
                ) ~= nil
                or string.find(
                    kn,
                    "only",
                    1,
                    true
                ) ~= nil
                or string.find(
                    kn,
                    "use",
                    1,
                    true
                ) ~= nil
                or string.find(
                    kn,
                    "check",
                    1,
                    true
                ) ~= nil
                or string.find(
                    kn,
                    "limit",
                    1,
                    true
                ) ~= nil

            match =
                has_fov
                and has_toggle_word
        end

        if match then
            local field_type =
                FALLEN_SILENT_KEY_TYPE(
                    raw
                )

            if purpose == "sticky" then
                if field_type == nil
                    or field_type == ""
                    or field_type == "bool"
                then
                    A.silent_live_keys[purpose] =
                        raw

                    return raw
                end
            elseif purpose == "max_distance" then
                if field_type == nil
                    or field_type == ""
                    or field_type == "int"
                    or field_type == "float"
                then
                    A.silent_live_keys[purpose] =
                        raw

                    return raw
                end
            elseif purpose == "fov_only" then
                if field_type == nil
                    or field_type == ""
                    or field_type == "bool"
                then
                    A.silent_live_keys[purpose] =
                        raw

                    return raw
                end
            end
        end
    end

    return nil
end


function FALLEN_SILENT_READ_FIELD(
    purpose
)
    local sa =
        FALLEN_SILENT_LIVE_SECTION()

    if not sa then
        return nil
    end

    local key =
        FALLEN_SILENT_FIND_LIVE_KEY(
            purpose
        )

    if not key then
        return nil
    end

    local ok, value =
        pcall(function()
            return sa[key]
        end)

    if ok then
        return value
    end

    return nil
end


function FALLEN_SILENT_WRITE_FIELD(
    purpose,
    value
)
