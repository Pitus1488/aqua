function FALLEN_ICON_SECRET(x, y, c)
    -- Small lock/keyhole icon. Pure line geometry keeps Gradient mode clean.
    local cx = x + 8
    local top = y + 2

    -- Shackle.
    line(cx - 4, top + 5, cx - 4, top + 3, c, 1.1)
    line(cx - 4, top + 3, cx - 2, top + 1, c, 1.1)
    line(cx - 2, top + 1, cx + 2, top + 1, c, 1.1)
    line(cx + 2, top + 1, cx + 4, top + 3, c, 1.1)
    line(cx + 4, top + 3, cx + 4, top + 5, c, 1.1)

    -- Lock body.
    line(cx - 5, top + 5, cx + 5, top + 5, c, 1.1)
    line(cx - 5, top + 5, cx - 5, top + 13, c, 1.1)
    line(cx + 5, top + 5, cx + 5, top + 13, c, 1.1)
    line(cx - 5, top + 13, cx + 5, top + 13, c, 1.1)

    circle_fill(cx, top + 9, 1.15, c)
end

