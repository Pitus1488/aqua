function FALLEN_DRAW_KEYBINDS_LIST()
    local panel_anim =
        FALLEN_KEYBINDS_STEP()

    if panel_anim <= 0.002
        and S.keybinds_list_enabled ~= true
    then
        return
    end

    local rows =
        FALLEN_HOTKEYS_ITEM_ROWS()

    local row_count =
        #rows

    local sw, sh =
        screen_size()

    -- Header NEVER gets taller when binds appear.
    local panel_w =
        120

    local panel_h =
        35

    local panel_rounding =
        clamp(
            8,
            0,
            panel_h * 0.5
        )

    local child_h =
        23

    local child_gap =
        6

    local child_start_gap =
        8

    -- Only used to keep the detached pills on screen while dragging.
    local total_visual_h =
        panel_h
        + (
            row_count > 0
            and (
                child_start_gap
                + row_count * child_h
                + math.max(
                    0,
                    row_count - 1
                ) * child_gap
            )
            or 0
        )

    local base_x =
        math.floor(
            sw
            * clamp(
                tonumber(S.hotkeys_pos_x) or 0.008,
                0,
                1
            )
            + 0.5
        )

    local base_y =
        math.floor(
            sh
            * clamp(
                tonumber(S.hotkeys_pos_y) or 0.042,
                0,
                1
            )
            + 0.5
        )

    base_x =
        clamp(
            base_x,
            0,
            math.max(
                0,
                sw - panel_w
            )
        )

    base_y =
        clamp(
            base_y,
            0,
            math.max(
                0,
                sh - total_visual_h
            )
        )

    local open_ease =
        ease_out_cubic(
            panel_anim
        )

    local x =
        base_x
        - (1 - open_ease) * 8

    local y =
        base_y

    local mx, my =
        mouse_pos()

    local lmb =
        key_down(
            VK_LBUTTON
        )

    local pressed =
        lmb
        and A.keybinds_panel_prev_lmb ~= true

    -- Drag ONLY by the Hotkeys header, not by the detached bind pills.
    if pressed
        and hover(
            mx,
            my,
            x,
            y,
            panel_w,
            panel_h
        )
    then
        A.keybinds_panel_dragging =
            true

        A.keybinds_panel_drag_off_x =
            mx - base_x

        A.keybinds_panel_drag_off_y =
            my - base_y

        A.active_slider =
            nil
    end

    if A.keybinds_panel_dragging
        and lmb
    then
        base_x =
            clamp(
                mx
                - (
                    tonumber(
                        A.keybinds_panel_drag_off_x
                    )
                    or 0
                ),
                0,
                math.max(
                    0,
                    sw - panel_w
                )
            )

        base_y =
            clamp(
                my
                - (
                    tonumber(
                        A.keybinds_panel_drag_off_y
                    )
                    or 0
                ),
                0,
                math.max(
                    0,
                    sh - total_visual_h
                )
            )

        S.hotkeys_pos_x =
            sw > 0
            and base_x / sw
            or 0

        S.hotkeys_pos_y =
            sh > 0
            and base_y / sh
            or 0

        x =
            base_x

        y =
            base_y
    elseif not lmb then
        A.keybinds_panel_dragging =
            false
    end

    A.keybinds_panel_prev_lmb =
        lmb == true

    local old_alpha =
        MENU_RENDER_ALPHA

    local old_transform =
        MENU_UI_TRANSFORM_ACTIVE

    MENU_RENDER_ALPHA =
        open_ease

    MENU_UI_TRANSFORM_ACTIVE =
        false

    -- Only the 120x35 header gets the main Hotkeys glow/background.
    FALLEN_DRAW_HOTKEYS_FOV_GLOW(
        x,
        y,
        panel_w,
        panel_h,
        panel_rounding
    )

    FALLEN_HOTKEYS_ROUNDED_FILL(
        x,
        y,
        panel_w,
        panel_h,
        panel_rounding,
        {
            0.008,
            0.008,
            0.010,
            0.62
        }
    )

    local header_icon =
        FALLEN_HOTKEYS_ICON_GET()

    if header_icon
        and type(DrawImage) == "function"
    then
        -- Bigger than before: 17px instead of 12px.
        local icon_size =
            17

        pcall(
            DrawImage,
            header_icon,
            FALLEN_UI_X(
                x + 8
            ),
            FALLEN_UI_Y(
                y + 9
            ),
            math.floor(
                FALLEN_UI_LEN(
                    icon_size
                )
                + 0.5
            ),
            math.floor(
                FALLEN_UI_LEN(
                    icon_size
                )
                + 0.5
            ),
            1,
            1,
            1,
            MENU_RENDER_ALPHA,
            0
        )

        text(
            x + 31,
            y + 9,
            "Hotkeys",
            {
                0.92,
                0.92,
                0.95,
                1
            }
        )
    else
        text(
            x + 13,
            y + 9,
            "Hotkeys",
            {
                0.92,
                0.92,
                0.95,
                1
            }
        )
    end

    -- Detached pills underneath. There is NO big parent background behind them.
    if row_count > 0 then
        local child_y =
            y
            + panel_h
            + child_start_gap

        for _, row in ipairs(rows) do
            FALLEN_DRAW_HOTKEYS_ITEM(
                x,
                child_y,
                row
            )

            child_y =
                child_y
                + child_h
                + child_gap
        end
    end

    MENU_RENDER_ALPHA =
        old_alpha

    MENU_UI_TRANSFORM_ACTIVE =
        old_transform
end


