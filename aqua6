function FALLEN_ANY_DROPDOWN_MODAL_ACTIVE(except_flag)
    for _, spec in ipairs(FALLEN_DROPDOWN_MODAL_SPECS) do
        local flag = spec[1]
        local anim_key = spec[2]

        if flag ~= except_flag then
            if A[flag] == true then
                return true
            end

            if anim_key
                and (tonumber(A[anim_key]) or 0) > 0.02
            then
                return true
            end
        end
    end

    return false
end

function FALLEN_DROPDOWN_TRIGGER_ALLOWED(clicked, self_flag)
    if not clicked then
        return false
    end

    return
        not FALLEN_ANY_DROPDOWN_MODAL_ACTIVE(
            self_flag
        )
end

local function toggle_row(mx, my, clicked, x, y, w, label, key, extra)
    clicked =
        clicked
        and not FALLEN_ANY_DROPDOWN_MODAL_ACTIVE()

    local h = 41
    local hot = row_hover(mx, my, x, y, w, h)

    text(
        x + 13,
        y + 14,
        label,
        FALLEN_HOVER_TEXT("toggle:" .. tostring(key), hot, C.text)
    )

    if extra then
        local dots_x = x + w - 79
        local dots_y = y + 8
        local dots_w = 27
        local dots_h = 25
        local dots_hot = hover(mx, my, dots_x, dots_y, dots_w, dots_h)

        if dots_hot then
            rounded_fill(
                dots_x,
                dots_y,
                dots_w,
                dots_h,
                6,
                { 0.105, 0.110, 0.130, 1 }
            )
        end

        centered_text(
            dots_x + dots_w * 0.5,
            y + 13,
            "...",
            dots_hot and C.text or C.text_faint
        )
    end

    local value = S[key] == true

    -- Change state first so the animation starts immediately on the click.
    if clicked and hot then
        value = not value
        S[key] = value

        if type(FALLEN_SILENT_UI_VALUE_CHANGED) == "function" then
            FALLEN_SILENT_UI_VALUE_CHANGED(
                key,
                value
            )
        end
    end

    local target = value and 1 or 0
    local anim = A.toggles[key]

    if anim == nil then
        anim = target
    end

    -- Smooth switch movement and color blend.
    anim = lerp(anim, target, 0.20)

    if math.abs(anim - target) < 0.002 then
        anim = target
    end

    A.toggles[key] = anim

    local tx = x + w - 45
    local ty = y + 12
    local tw, th = 34, 18

    local track_col = mix_color(C.toggle_off, C.accent_dim, anim)
    local knob_col = mix_color(C.toggle_knob, C.white, anim)

    rounded_fill(tx, ty, tw, th, 9, track_col)

    -- Knob center moves continuously instead of snapping left/right.
    local knob_x = tx + 9 + (tw - 18) * anim
    circle_fill(knob_x, ty + 9, 7, knob_col)
end

