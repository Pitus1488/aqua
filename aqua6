    A.misc_manipulation_spoofed = false
    A.misc_manipulation_press_pos = nil
    A.misc_manipulation_press_rot = nil
    A.misc_manipulation_press_upright_rot = nil
    A.misc_manipulation_press_vel = nil
    A.misc_manipulation_press_head_offset = nil
    A.misc_manipulation_camera_anchor = nil
    A.misc_manipulation_direction = nil
    A.misc_manipulation_cached_offset = nil
    A.misc_manipulation_target_pos = nil
    A.misc_manipulation_failed_directions = {}
    A.misc_manipulation_hold_until = nil
    A.misc_manipulation_hold_active = false
end

local function FALLEN_MANIPULATION_RESTORE_RELEASE(hrp)
    if not hrp then
        FALLEN_MANIPULATION_CLEAR_PRESS()
        return
    end

    -- A short anti-fall hold may have anchored the HRP. Always release it
    -- before restoring the saved click position/upright rotation.
    pcall(function()
        hrp:set_anchored(false)
    end)

    local base_pos = A.misc_manipulation_press_pos
    local base_rot = A.misc_manipulation_press_upright_rot
        or FALLEN_MANIPULATION_UPRIGHT_MATRIX(A.misc_manipulation_press_rot)
    local base_vel = A.misc_manipulation_press_vel

    if base_pos then
        pcall(function()
            hrp:set_position(base_pos)
        end)
    end

    if type(base_rot) == "table" then
        pcall(function()
            hrp:set_rotation(base_rot)
        end)
    end

    if base_vel then
        pcall(function()
            hrp:set_velocity(base_vel)
        end)
    end

    FALLEN_MANIPULATION_CLEAR_PRESS()
end

local function FALLEN_MANIPULATION_CURSOR_POS()
    local p = nil

    if type(crosshair_pos) == "function" then
        pcall(function()
            p = crosshair_pos()
        end)
    end

    if not p and type(mouse_pos) == "function" then
        pcall(function()
            p = mouse_pos()
        end)
    end

    if not p and type(ScreenSize) == "function" then
        local d = nil
        pcall(function()
            d = ScreenSize()
        end)
        if d then
            p = {
                X = (tonumber(d.Width or d.X) or 0) * 0.5,
                Y = (tonumber(d.Height or d.Y) or 0) * 0.5,
            }
        end
    end

    return p
end

local function FALLEN_MANIPULATION_HAS_WEAPON(force_scan)
    local now = tick()

    -- Auto Prediction already refreshes this exact detector every 0.25s.
    -- Reuse its fresh result instead of scanning the character twice.
    if S.aim_auto_prediction == true
        and FAP
        and (now - (tonumber(FAP.last_weapon_scan) or 0)) <= 0.35
    then
        local cached = FAP.weapon
        A.misc_manipulation_weapon_name = cached
        A.misc_manipulation_weapon_ready =
            cached ~= nil
            and tostring(cached) ~= ""
        A.misc_manipulation_weapon_last_scan = now
        return A.misc_manipulation_weapon_ready == true
    end

    if force_scan ~= true
        and (now - (A.misc_manipulation_weapon_last_scan or 0)) < 0.25
    then
        return A.misc_manipulation_weapon_ready == true
    end

    A.misc_manipulation_weapon_last_scan = now

    local weapon = nil
    if type(fap_detect_weapon) == "function" then
        pcall(function()
            weapon = fap_detect_weapon()
        end)
    end

    A.misc_manipulation_weapon_name = weapon
    A.misc_manipulation_weapon_ready =
        weapon ~= nil
        and tostring(weapon) ~= ""

    return A.misc_manipulation_weapon_ready == true
end

local FALLEN_MANIPULATION_PART_CLASSES = {
    Part = true,
    MeshPart = true,
    UnionOperation = true,
    TrussPart = true,
    WedgePart = true,
    CornerWedgePart = true,
    Seat = true,
    VehicleSeat = true,
