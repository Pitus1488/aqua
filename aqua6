function FALLEN_SILENT_SET_TARGET_PART(
    value
)
    local part =
        tostring(
            value
            or "Head"
        )

    local index = 0

    if part == "Torso" then
        index = 1
    elseif part == "Feet" then
        index = 2
    end

    FALLEN_SILENT_WRITE_FIELD(
        "target_part",
        index
    )
end


function FALLEN_SHARED_AIM_SECTION()
    -- Silent FOV mirrors ONLY the stock Aimbot FOV visual controls.
    -- This does not enable stock Aimbot and does not touch its targeting logic.
    if cheat
        and cheat.aimbot
    then
        return cheat.aimbot
    end

    return nil
end


function FALLEN_SHARED_AIM_KEYS()
    local section =
        FALLEN_SHARED_AIM_SECTION()

    if not section
        or type(section._keys) ~= "function"
    then
        return nil
    end

    local ok, keys =
        pcall(function()
            return section:_keys()
        end)

    if ok
        and type(keys) == "table"
    then
        return keys
    end

    return nil
end


function FALLEN_SHARED_AIM_FIND_KEY(
    purpose
)
    A.silent_shared_aim_keys =
        A.silent_shared_aim_keys
        or {}

    if A.silent_shared_aim_keys[purpose] then
        return A.silent_shared_aim_keys[purpose]
    end

    local aliases = nil

    if purpose == "team_check" then
        aliases = {
            "team_check",
            "teamcheck",
        }
    elseif purpose == "sticky" then
        aliases = {
            "sticky_aim",
            "stickyaim",
            "sticky",
            "target_lock",
            "targetlock",
            "lock_target",
            "locktarget",
        }
    elseif purpose == "max_distance" then
        aliases = {
            "max_distance",
            "maxdistance",
            "max_dist",
            "maxdist",
            "distance",
            "target_distance",
            "targetdistance",
            "max_range",
            "maxrange",
            "range",
        }
    elseif purpose == "target_part" then
        aliases = {
            "target_part",
            "targetpart",
            "hit_part",
            "hitpart",
        }
    elseif purpose == "show_fov" then
        aliases = {
            "show_fov",
            "showfov",
            "fov_enabled",
            "fovenabled",
            "draw_fov",
            "drawfov",
            "display_fov",
            "displayfov",
            "render_fov",
            "renderfov",
            "fov_visible",
            "fovvisible",
            "aimbot_fov",
            "aimbotfov",
        }
    elseif purpose == "fov" then
        aliases = {
            "fov",
            "fov_size",
            "fovsize",
            "aimbot_fov_size",
            "aimbotfovsize",
        }
    end

    if type(aliases) ~= "table" then
        return nil
    end

    local keys =
        FALLEN_SHARED_AIM_KEYS()

    -- Documented exact names first.
    if type(keys) ~= "table" then
        if purpose == "team_check" then
            return "team_check"
        elseif purpose == "target_part" then
            return "target_part"
        elseif purpose == "sticky" then
            return "sticky_aim"
        elseif purpose == "max_distance" then
            return "max_distance"
        elseif purpose == "show_fov" then
            return "show_fov"
        elseif purpose == "fov" then
            return "fov"
        end

        return nil
    end

    for _, alias in ipairs(aliases) do
        local an =
            FALLEN_SILENT_NORMALIZE_KEY(
                alias
            )

        for _, key in ipairs(keys) do
            local raw =
                tostring(key)

            if FALLEN_SILENT_NORMALIZE_KEY(raw) == an then
                A.silent_shared_aim_keys[purpose] =
                    raw

                return raw
            end
        end
    end

    -- Semantic fallback for builds whose field names differ.
    for _, key in ipairs(keys) do
        local raw =
            tostring(key)

        local kn =
            FALLEN_SILENT_NORMALIZE_KEY(
                raw
            )

        local matched = false

        if purpose == "sticky" then
            matched =
                string.find(
                    kn,
                    "sticky",
                    1,
                    true
                ) ~= nil
                or (
                    string.find(
                        kn,
                        "target",
                        1,
                        true
                    )
                    and string.find(
                        kn,
                        "lock",
                        1,
                        true
                    )
                )
        elseif purpose == "max_distance" then
            matched =
                (
                    string.find(
                        kn,
                        "dist",
                        1,
                        true
                    ) ~= nil
                )
                or (
                    string.find(
                        kn,
                        "range",
                        1,
                        true
                    ) ~= nil
                )
        elseif purpose == "show_fov" then
            matched =
                string.find(
                    kn,
                    "fov",
                    1,
                    true
                ) ~= nil
                and (
                    string.find(
                        kn,
                        "show",
                        1,
                        true
                    ) ~= nil
                    or string.find(
                        kn,
                        "enable",
                        1,
                        true
                    ) ~= nil
                    or string.find(kn, "draw", 1, true) ~= nil
                    or string.find(kn, "display", 1, true) ~= nil
                    or string.find(kn, "render", 1, true) ~= nil
                    or string.find(kn, "visible", 1, true) ~= nil
                )
        elseif purpose == "fov" then
            matched =
                kn == "fov"
                or kn == "fovsize"
                or (
                    string.find(
                        kn,
                        "fov",
                        1,
                        true
                    ) ~= nil
                    and string.find(
                        kn,
                        "show",
                        1,
                        true
                    ) == nil
                    and string.find(
                        kn,
                        "enable",
                        1,
                        true
                    ) == nil
                )
        end

        if matched then
            A.silent_shared_aim_keys[purpose] =
                raw

            return raw
        end
    end

    return nil
end


function FALLEN_SHARED_AIM_READ(
    purpose
)
    local section =
        FALLEN_SHARED_AIM_SECTION()

    if not section then
        return nil
    end

    local key =
        FALLEN_SHARED_AIM_FIND_KEY(
            purpose
        )

    if not key then
        return nil
    end

    local ok, value =
        pcall(function()
            return section[key]
        end)

    if ok then
        return value
    end

    return nil
end


function FALLEN_SHARED_AIM_WRITE(
    purpose,
    value
)
    local section =
        FALLEN_SHARED_AIM_SECTION()

    if not section then
        return false
    end

    local key =
        FALLEN_SHARED_AIM_FIND_KEY(
            purpose
        )

    if not key then
        return false
    end

    local ok =
        pcall(function()
            section[key] =
                value
        end)

    return ok == true
end


