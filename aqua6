    hooks.on_render(function()
        if L.hidden then return end

        local now = tick()
        local dt = now - L.last_time
        L.last_time = now
        if dt < 0 then dt = 0 end
        if dt > 0.05 then dt = 0.05 end
        if dt < 0.0001 then dt = 0.0001 end
        L.time_sec = L.time_sec + dt

        L.tick_boot(dt)
        L.tick_modal(now, dt)

        if L.exit_done then
            L.hidden = true
            if L.launch_success and _G.FallenSurvivalLoaded == true then
                _G.FallenLua_Menu = _G.FallenLua_Menu or {}
                _G.FallenLua_Menu.visible = true
                _G.FallenMenuReady = true
            end
            return
        end

        local screen = ScreenSize()
        if not screen then return end
        local sw = tonumber(screen.Width) or 1920
        local sh = tonumber(screen.Height) or 1080

        if L.cx == nil or L.cy == nil then
            L.cx = sw * 0.5
            L.cy = sh * 0.5
        end

        local mx, my = L.mouse_pos()
        local lmb = L.lmb_down()
        local click = lmb and not L.prev_lmb
        local release = (not lmb) and L.prev_lmb
        L.prev_lmb = lmb

        local draw_w = L.win_w
        local draw_h = L.win_h
        local x = L.cx - draw_w * 0.5
        local y = L.cy - draw_h * 0.5

        -- Source window dragging is disabled while the modal is open.
        if L.phase == "Ready" and not L.modal.open and not L.modal.closing then
            local close_zone = L.inside(mx, my, x + 500 - 70, y, 70, 55)
            local top_hot = L.inside(mx, my, x, y, 500, 70) and not close_zone
            if click and top_hot then
                L.drag = true
                L.drag_off_x = mx - L.cx
                L.drag_off_y = my - L.cy
            end
        end

        if L.drag and lmb then
            L.cx = L.clamp(mx - L.drag_off_x, 250, math.max(250, sw - 250))
            L.cy = L.clamp(my - L.drag_off_y, 200, math.max(200, sh - 200))
        end
        if release or not lmb then
            L.drag = false
        end

        x = L.cx - draw_w * 0.5
        y = L.cy - draw_h * 0.5

        local wa = L.window_alpha
        L.rounded_fill(x, y, draw_w, draw_h, 15, L.theme.bg, wa)

        if (L.phase == "Splash" or L.phase == "Expanding") and L.loader_alpha > 0.01 then
            L.draw_spinner(L.cx, L.cy, wa * L.loader_alpha)
            return
        end

        if L.phase == "Ready" or L.phase == "Exiting" then
            -- Ready always uses the final source size. During exit the same
            -- dashboard/modal remains visible while the whole window alpha fades.
            local full_x = L.cx - 250
            local full_y = L.cy - 200
            if draw_w ~= 500 or draw_h ~= 400 then
                full_x = x
                full_y = y
            end

            local content_a = L.content_alpha * wa
            if L.phase == "Exiting" then
                content_a = math.max(L.content_alpha, wa) * wa
            end

            L.draw_dashboard(full_x, full_y, content_a, mx, my, click, dt, now)
            L.draw_modal(full_x, full_y, wa, mx, my, click, dt, now)
        end
    end)
end -- loader local-state scope


