function FALLEN_SECRET_CROSSHAIR_COLOR()
    local r, g, b =
        hsv_to_rgb(
            tonumber(S.secret_crosshair_h) or 0,
            tonumber(S.secret_crosshair_s) or 0,
            tonumber(S.secret_crosshair_v) or 1
        )

    return {
        r,
        g,
        b,
        clamp(
            (tonumber(S.secret_crosshair_alpha) or 100) / 100,
            0,
            1
        ),
    }
end

function FALLEN_SECRET_CROSSHAIR_STYLE_STEP()
    local now = tick()

    if A.secret_crosshair_style_last_t == nil then
        A.secret_crosshair_style_last_t = now
    end

    local dt =
        clamp(
            now - A.secret_crosshair_style_last_t,
            0,
            0.05
        )

    A.secret_crosshair_style_last_t = now

    local target =
        A.secret_crosshair_style_open
        and 1
        or 0

    local speed =
        target > (A.secret_crosshair_style_anim or 0)
        and 16
        or 12

    A.secret_crosshair_style_anim =
        exp_chase(
            A.secret_crosshair_style_anim or 0,
            target,
            speed,
            dt
        )

    if math.abs(
        (A.secret_crosshair_style_anim or 0)
        - target
    ) < 0.0015
    then
        A.secret_crosshair_style_anim = target
    end

    return
        clamp(
            A.secret_crosshair_style_anim or 0,
            0,
            1
        )
end

function FALLEN_DRAW_SECRET_CROSSHAIR_STYLE_DROPDOWN(
    mx,
    my,
    clicked,
    x,
    y,
    w
)
    local anim =
        FALLEN_SECRET_CROSSHAIR_STYLE_STEP()

    if anim <= 0.004
        and not A.secret_crosshair_style_open
    then
        return false
    end

    local options = {
        "Sharp",
        "Rounded",
    }

    local item_h = 27
    local full_h = #options * item_h
    local visible_h = full_h * ease_out_cubic(anim)
    local panel_h = math.max(2, visible_h)

    FALLEN_POPUP_GLOW(
        x,
        y,
        w,
        panel_h,
        7,
        0.9
    )

    rounded_fill(
        x,
        y,
        w,
        panel_h,
        7,
        C.group_box_bg
    )

    local panel_hot =
        hover(
            mx,
            my,
            x,
            y,
            w,
            panel_h
        )

    for i, option in ipairs(options) do
        local iy = y + (i - 1) * item_h

        local reveal =
            clamp(
                (visible_h - (i - 1) * item_h) / item_h,
                0,
                1
            )

        if reveal > 0.12 then
            local item_hot =
                reveal > 0.92
                and hover(
                    mx,
                    my,
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4
                )

            if item_hot then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4,
                    5,
                    C.frame_active
                )
            end

            local selected =
                tostring(
                    S.secret_crosshair_style
                        or "Sharp"
                ) == option

            if selected then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    3,
                    item_h - 4,
                    1,
                    C.accent
                )
            end

            text(
                x + 12,
                iy + 8,
                option,
                FALLEN_HOVER_TEXT(
                    "secret_crosshair_style:" .. tostring(option),
                    item_hot,
                    selected
                        and C.text
                        or C.text_dim
                )
            )

            if clicked
                and item_hot
                and A.secret_crosshair_style_open
            then
                S.secret_crosshair_style = option
                A.secret_crosshair_style_open = false
                return true
            end
        end
    end

    return panel_hot
end

hooks.on_render(function()
    if S.secret_crosshair ~= true then
        return
    end

    local dims = nil
    pcall(function()
        dims = ScreenSize()
    end)

    local sw =
        dims
        and tonumber(dims.Width or dims.X)
        or 1920

    local sh =
        dims
        and tonumber(dims.Height or dims.Y)
        or 1080

    local cx = math.floor(sw * 0.5)
    local cy = math.floor(sh * 0.5)

    local size =
        clamp(
            math.floor(
                tonumber(S.secret_crosshair_size) or 16
            ),
            8,
            40
        )

    local style =
        tostring(
            S.secret_crosshair_style
                or "Sharp"
        )

    local col =
        FALLEN_SECRET_CROSSHAIR_COLOR()

    local now = tick()
    if A.secret_crosshair_render_last_t == nil then
        A.secret_crosshair_render_last_t = now
    end

    local dt =
        clamp(
            now - A.secret_crosshair_render_last_t,
            0,
            0.05
        )

    A.secret_crosshair_render_last_t = now

    local ang =
        tonumber(A.secret_crosshair_angle) or 0

    local rot_speed = math.rad(95)

    if S.secret_crosshair_rotate == true then
        ang = ang + rot_speed * dt
        if ang > math.pi * 2 then
            ang = ang - math.pi * 2
        end
    else
        while ang > math.pi do
            ang = ang - math.pi * 2
        end
        while ang < -math.pi do
            ang = ang + math.pi * 2
        end

        ang =
            exp_chase(
                ang,
                0,
                12,
                dt
            )

        if math.abs(ang) < 0.0008 then
            ang = 0
        end
    end

    A.secret_crosshair_angle = ang

    local extent = size
    local thick = 3
    local cap_r = 2

    local ca = math.cos(ang)
    local sa = math.sin(ang)

    local function rot(x, y)
        return
            cx + x * ca - y * sa,
            cy + x * sa + y * ca
    end

    local function draw_seg(x1, y1, x2, y2)
        local ax, ay = rot(x1, y1)
        local bx, by = rot(x2, y2)

        DrawLine(
            ax,
            ay,
            bx,
            by,
            col[1],
            col[2],
            col[3],
            col[4] or 1,
            thick
        )
    end

    local function draw_cap(x, y)
        local px, py = rot(x, y)

        if type(DrawCircleFilled) == "function" then
            DrawCircleFilled(
                px,
                py,
                cap_r,
                col[1],
                col[2],
                col[3],
                col[4] or 1
            )
        else
            DrawBoxFilled(
                px - cap_r,
                py - cap_r,
                px + cap_r,
                py + cap_r,
                col[1],
                col[2],
                col[3],
                col[4] or 1
            )
        end
    end

    -- Shared homunculus geometry.
    -- top horizontal:    (-extent,-extent) -> (0,-extent)
    -- center vertical:   (0,-extent)       -> (0, extent)
    -- middle horizontal: (-extent,0)       -> (extent,0)
    -- left vertical:     (-extent,0)       -> (-extent, extent)
    -- right vertical:    (extent,-extent)  -> (extent,0)
    -- bottom horizontal: (0, extent)       -> (extent, extent)
    draw_seg(-extent, -extent, 0, -extent)
    draw_seg(0, -extent, 0, extent)
    draw_seg(-extent, 0, extent, 0)
    draw_seg(-extent, 0, -extent, extent)
    draw_seg(extent, -extent, extent, 0)
    draw_seg(0, extent, extent, extent)

    if style == "Rounded" then
        -- Only exposed outer terminals get rounded caps.
        draw_cap(-extent, -extent) -- top-left
        draw_cap(0, -extent)       -- top-center
        draw_cap(extent, -extent)  -- top-right
        draw_cap(-extent, extent)  -- bottom-left
        draw_cap(0, extent)        -- bottom-center
        draw_cap(extent, extent)   -- bottom-right
    end
end)

-- =========================================================
-- 3D World Rain
-- =========================================================
-- World-space rain with real geometry collision + visibility occlusion.
-- The API has no Workspace:Raycast, so we build a lightweight cache of
-- collidable BaseParts and perform our own ray-vs-oriented-box tests.
-- This fixes both old issues:
--   * rain no longer renders through walls;
--   * impact splashes land on the actual surface below each drop instead of
--     on a flat plane derived from the local HumanoidRootPart.
-- Keep world weather visually behind the custom menu. The menu can be
-- translucent (Glass), so normal draw order alone is not enough: projected
-- weather strokes are clipped against the live menu rectangle.
function FALLEN_WORLD_RAIN_GRID_KEY(ix, iz)
    return tostring(ix) .. ":" .. tostring(iz)
end

-- Exact segment/ray hit against a rotated BasePart box. The rotation matrix
-- returned by :get_rotation() is row-major; transpose transforms world-space
-- ray data into the part's local box space.
function FALLEN_WORLD_RAIN_RAY_OBB(ox, oy, oz, dx, dy, dz, max_dist, p)
    if not p then return nil end

    local rx = ox - p.x
    local ry = oy - p.y
    local rz = oz - p.z

    local lox = p.m1 * rx + p.m4 * ry + p.m7 * rz
    local loy = p.m2 * rx + p.m5 * ry + p.m8 * rz
    local loz = p.m3 * rx + p.m6 * ry + p.m9 * rz

    local ldx = p.m1 * dx + p.m4 * dy + p.m7 * dz
    local ldy = p.m2 * dx + p.m5 * dy + p.m8 * dz
    local ldz = p.m3 * dx + p.m6 * dy + p.m9 * dz

    local tmin = 0
    local tmax = max_dist
    local eps = 0.000001

    if math.abs(ldx) < eps then
        if lox < -p.hx or lox > p.hx then return nil end
    else
        local t1 = (-p.hx - lox) / ldx
        local t2 = ( p.hx - lox) / ldx
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tmin then tmin = t1 end
        if t2 < tmax then tmax = t2 end
        if tmin > tmax then return nil end
    end

    if math.abs(ldy) < eps then
        if loy < -p.hy or loy > p.hy then return nil end
    else
        local t1 = (-p.hy - loy) / ldy
        local t2 = ( p.hy - loy) / ldy
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tmin then tmin = t1 end
        if t2 < tmax then tmax = t2 end
        if tmin > tmax then return nil end
    end

    if math.abs(ldz) < eps then
        if loz < -p.hz or loz > p.hz then return nil end
    else
        local t1 = (-p.hz - loz) / ldz
        local t2 = ( p.hz - loz) / ldz
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tmin then tmin = t1 end
        if t2 < tmax then tmax = t2 end
        if tmin > tmax then return nil end
    end

    if tmax < 0 or tmin > max_dist then
        return nil
    end

    if tmin < 0 then
        return 0
    end

    return tmin
end

-- Raycast through the cached part grid. Direction must be normalized.
function FALLEN_WORLD_RAIN_RAYCAST_GRID(ox, oy, oz, dx, dy, dz, max_dist)
    local geo = A.world_rain_geo
    if type(geo) ~= "table" or type(geo.grid) ~= "table" then
        return nil, nil
    end

    max_dist = tonumber(max_dist) or 0
    if max_dist <= 0 then return nil, nil end

    local cell = tonumber(geo.cell) or 36
    local cx = math.floor(ox / cell)
    local cz = math.floor(oz / cell)
    local ex = ox + dx * max_dist
    local ez = oz + dz * max_dist
    local end_cx = math.floor(ex / cell)
    local end_cz = math.floor(ez / cell)

    local step_x = dx > 0 and 1 or (dx < 0 and -1 or 0)
    local step_z = dz > 0 and 1 or (dz < 0 and -1 or 0)

    local inf = 1e30
    local t_delta_x = step_x ~= 0 and (cell / math.abs(dx)) or inf
    local t_delta_z = step_z ~= 0 and (cell / math.abs(dz)) or inf

    local next_x = step_x > 0 and ((cx + 1) * cell) or (cx * cell)
    local next_z = step_z > 0 and ((cz + 1) * cell) or (cz * cell)

    local t_max_x = step_x ~= 0 and ((next_x - ox) / dx) or inf
    local t_max_z = step_z ~= 0 and ((next_z - oz) / dz) or inf

    if t_max_x < 0 then t_max_x = 0 end
    if t_max_z < 0 then t_max_z = 0 end

    geo.ray_serial = (tonumber(geo.ray_serial) or 0) + 1
    if geo.ray_serial > 2000000000 then geo.ray_serial = 1 end
    local mark = geo.ray_serial

    local best_t = nil
    local best_part = nil
    local guard = 0

    while guard < 1024 do
        guard = guard + 1

        local bucket = geo.grid[FALLEN_WORLD_RAIN_GRID_KEY(cx, cz)]
        if type(bucket) == "table" then
            for _, index in ipairs(bucket) do
                local p = geo.parts[index]
                if p and p.mark ~= mark then
                    p.mark = mark
                    local hit = FALLEN_WORLD_RAIN_RAY_OBB(
                        ox, oy, oz,
                        dx, dy, dz,
                        best_t or max_dist,
                        p
                    )

                    if hit and hit >= 0
                        and hit <= max_dist
                        and (best_t == nil or hit < best_t)
                    then
                        best_t = hit
                        best_part = p
                    end
                end
            end
        end

        if best_t then
            local next_boundary = math.min(t_max_x, t_max_z)
            if best_t <= next_boundary + 0.001 then
                break
            end
        end

        if cx == end_cx and cz == end_cz then
            break
        end

        if t_max_x < t_max_z then
            if t_max_x > max_dist then break end
            cx = cx + step_x
            t_max_x = t_max_x + t_delta_x
        else
            if t_max_z > max_dist then break end
            cz = cz + step_z
            t_max_z = t_max_z + t_delta_z
        end
    end

    return best_t, best_part
end

