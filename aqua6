            style_box_w
        )

    if clicked
        and A.bullet_tracer_style_open
        and not style_box_hot
        and not dropdown_hot
        and not A.world_color_picker_open
    then
        A.bullet_tracer_style_open = false
    end

    local animation_dropdown_hot =
        FALLEN_DRAW_BT_ANIMATION_DROPDOWN(
            mx,
            my,
            clicked
                and not A.world_color_picker_open,
            animation_box_x,
            animation_box_y + 30,
            animation_box_w
        )

    if clicked
        and A.bullet_tracer_animation_open
        and not animation_box_hot
        and not animation_dropdown_hot
        and not A.world_color_picker_open
    then
        A.bullet_tracer_animation_open = false
    end

    local hit_dropdown_hot =
        FALLEN_DRAW_HITFX_STYLE_DROPDOWN(
            mx,
            my,
            clicked
                and not A.world_color_picker_open,
            hit_style_box_x,
            hit_style_box_y + 30,
            hit_style_box_w
        )

    if clicked
        and A.hit_effect_style_open
        and not hit_style_box_hot
        and not hit_dropdown_hot
        and not A.world_color_picker_open
    then
        A.hit_effect_style_open = false
    end



end

