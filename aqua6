        or not entry.cfg
        or S[entry.cfg.state] ~= true
        or not world_inst_valid(entry.inst)
    then
        return
    end

    if entry.cfg.folder == "Nodes"
        and S.world_node_esp_enabled ~= true
    then
        return
    end

    if entry.cfg.folder == "Plants"
        and S.world_plant_esp_enabled ~= true
    then
        return
    end

    local pos =
        world_part_pos(
            entry.inst,
            0
        )

    if not pos then
        return
    end

    local dist =
        world_distance_m(
            pos,
            my_pos
        )

    if not dist then
        return
    end

    local max_dist =
        clamp(
            tonumber(S.world_max_dist)
            or 500,
            25,
            2000
        )

    if dist > max_dist then
        return
    end

    local screen =
        world_screen(
            pos
        )

    if not screen then
        return
    end

    local fade = 1

    if S.world_fade_distance == true
        and max_dist > 0
    then
        fade =
