local function world_draw_entry(
    entry,
    my_pos
)
    if not entry
        or not entry.cfg
        or S[entry.cfg.state] ~= true
        or not world_inst_valid(entry.inst)
    then
        return
    end

    if entry.cfg.folder == "Nodes"
        and S.world_node_esp_enabled ~= true
    then
        return
    end

    if entry.cfg.folder == "Plants"
        and S.world_plant_esp_enabled ~= true
    then
        return
    end

    local pos =
        world_part_pos(
            entry.inst,
            0
        )

    if not pos then
        return
    end

    local dist =
        world_distance_m(
            pos,
            my_pos
        )

    if not dist then
        return
    end

    local max_dist =
        clamp(
            tonumber(S.world_max_dist)
            or 500,
            25,
            2000
        )

    if dist > max_dist then
        return
    end

    local screen =
        world_screen(
            pos
        )

    if not screen then
        return
    end

    local fade = 1

    if S.world_fade_distance == true
        and max_dist > 0
    then
        fade =
            1
            - (
                dist
                / max_dist
            )
            * 0.78

        fade =
            clamp(
                fade,
                0.18,
                1
            )
    end

    local cfg =
        entry.cfg

    local col =
        world_resource_color(
            cfg
        )

    fade =
        fade
        * (col[4] or 1)

    local text_y =
        screen.Y

    if S.world_show_icons == true
        and cfg.direct_urls
        and #cfg.direct_urls > 0
    then
        local icon_size =
            clamp(
                tonumber(S.world_icon_size)
                or 18,
                10,
                48
            )

        local icon_drawn =
            world_draw_icon(
                cfg,
                screen.X,
                screen.Y - 18,
                icon_size,
                fade
            )

        if icon_drawn then
            text_y =
                screen.Y + 2
        end
    end

    if S.world_show_names == true
        and type(DrawTextWithOutline) == "function"
    then
        DrawTextWithOutline(
            screen.X,
            text_y,
            cfg.label,
            col[1],
            col[2],
            col[3],
            fade,
            0,
            0,
            0,
            fade
        )
    end

    if S.world_show_distance == true
        and type(DrawTextWithOutline) == "function"
    then
        local dy =
            S.world_show_names == true
            and 14
            or 0

        DrawTextWithOutline(
            screen.X,
            text_y + dy,
            string.format(
                "%.0fm",
                dist
            ),
            col[1],
            col[2],
            col[3],
            fade,
            0,
            0,
            0,
            fade
        )
    end
end

function world_draw_base_entry(
    entry,
    my_pos
)
    if not entry
        or not entry.cfg
        or not world_inst_valid(entry.inst)
        or not world_base_enabled(entry.cfg)
        or S.world_base_esp_enabled ~= true
    then
        return
    end

    local pos =
        world_part_pos(
            entry.inst,
            0
        )

    if not pos then
        return
    end

    local dist =
        world_distance_m(
            pos,
            my_pos
        )

    if not dist then
        return
    end

    local max_dist =
        clamp(
            tonumber(S.world_max_dist)
            or 500,
            25,
            2000
        )

    if dist > max_dist then
        return
    end

    local cfg = entry.cfg
    world_base_ensure_state(cfg)

    local col =
        world_color_from_prefix(
            world_base_color_prefix(
                cfg.id
            )
        )

    local alpha = col[4] or 1

    if S.world_fade_distance == true
        and max_dist > 0
    then
        alpha =
            alpha
            * clamp(
                1
                - (dist / max_dist) * 0.78,
                0.18,
                1
            )
    end

    local screen =
        world_screen(
            pos
        )

    if not screen
        or type(DrawTextWithOutline) ~= "function"
    then
        return
    end

    if S.world_show_names == true then
        DrawTextWithOutline(
            screen.X,
            screen.Y,
            cfg.label,
            col[1] or 1,
            col[2] or 1,
            col[3] or 1,
            alpha,
            0,
            0,
            0,
            alpha
        )
    end

    if S.world_show_distance == true then
        local dy =
            S.world_show_names == true
            and 14
            or 0

        DrawTextWithOutline(
            screen.X,
            screen.Y + dy,
            string.format(
                "%.0fm",
                dist
            ),
            col[1] or 1,
            col[2] or 1,
            col[3] or 1,
            alpha,
            0,
            0,
            0,
            alpha
        )
    end
end

-- =========================================================
-- Visual Grenade
-- Workspace/VFX -> Military Grenade [Model] (DIRECT CHILD ONLY; VFX/VMS ignored)
-- Draws the supplied grenade icon, a 4-second disappearing timer outline,
-- and a screen-space trail following the grenade's real flight path.
-- =========================================================

FALLEN_GRENADE_ICON_URLS =
    FALLEN_GRENADE_ICON_URLS
    or {
        "https://static.wikia.nocookie.net/fallen-survival-new/images/e/e8/Military_Grenade.png/revision/latest/scale-to-width-down/55?cb=20250406121732",
        "https://static.wikia.nocookie.net/fallen-survival-new/images/e/e8/Military_Grenade.png/revision/latest?format=original",
        "https://static.wikia.nocookie.net/fallen-survival-new/images/e/e8/Military_Grenade.png",
    }

FALLEN_GRENADE_FUSE_TIME = 3.0
-- Timer origin is the exact first frame where the thrown grenade is seen as a direct child of Workspace/VFX.
-- Image loading is completely independent from this timestamp.
FALLEN_GRENADE_SPAWN_SYNC = 0.0

function FALLEN_GRENADE_INSTANCE_KEY(inst)
    if not inst then
        return nil
    end

    local key = nil

    pcall(function()
        key = tostring(inst.addr or inst)
    end)

    return key or tostring(inst)
end

function FALLEN_GRENADE_NAME_MATCH(name)
    local s =
        string.lower(
            tostring(name or "")
        )

    s = string.gsub(s, "%s*%(%s*clone%s*%)%s*$", "")
    s = string.gsub(s, "[%s_%-%[%]%(%)]+", "")

    return
        s == "militarygrenade"
        or s == "grenade"
        or string.find(
            s,
            "militarygrenade",
            1,
            true
        ) ~= nil
end

function FALLEN_GRENADE_COLOR()
    return
        world_color_from_prefix(
            "world_color_grenade"
        )
end

function FALLEN_GRENADE_ICON_GET()
    if type(LoadImage) ~= "function" then
        return nil
    end

    local st =
        WORLD_ESP.grenade_icon

    if not st then
        st = {
            index = 1,
            handle = nil,
            dead = false,
        }

        WORLD_ESP.grenade_icon = st
    end

    if st.dead then
        return nil
    end

    -- Reuse the startup-preloaded handle directly. This makes the grenade icon
    -- independent from when the first grenade appears in VFX.
    if not st.handle
        and type(_G.FALLEN_IMAGE_PRELOAD_HANDLES) == "table"
        and FALLEN_GRENADE_ICON_URLS[st.index]
    then
        local preloaded =
            _G.FALLEN_IMAGE_PRELOAD_HANDLES[
                FALLEN_GRENADE_ICON_URLS[st.index]
            ]

        if preloaded then
            st.handle = preloaded
        end
    end

    if not st.handle
        and FALLEN_GRENADE_ICON_URLS[st.index]
    then
        local ok, handle =
            pcall(
                LoadImage,
                FALLEN_GRENADE_ICON_URLS[st.index]
            )

        if ok and handle then
            st.handle = handle
        end
    end

    if st.handle
        and type(IsImageReady) == "function"
    then
        local ok, ready =
            pcall(
                IsImageReady,
                st.handle
            )

        if ok and ready == true then
            return st.handle
        end
    end

    if st.handle
        and type(IsImageFailed) == "function"
    then
        local ok, failed =
            pcall(
                IsImageFailed,
                st.handle
            )

        if ok and failed == true then
            st.index = st.index + 1
            st.handle = nil

            if not FALLEN_GRENADE_ICON_URLS[st.index] then
                st.dead = true
            end
        end
    end

    return nil
end

function FALLEN_GRENADE_SCAN_VFX_ROOT(
    vfx,
    entries,
    seen,
    now
)
    -- IMPORTANT: only direct children of Workspace/VFX count.
    -- Never walk VFX/VMS or any other nested folder/model, otherwise
    -- the held/viewmodel grenade gets picked up as a world grenade.
    if not vfx
        or not world_inst_valid(vfx)
        or #entries >= 96
    then
        return
    end

    for _, inst in ipairs(world_children(vfx)) do
        if #entries >= 96 then
            break
        end

        local class =
            world_inst_class(inst)

        local name =
            world_inst_name(inst)

        -- The real thrown grenade appears as a Model directly under VFX.
        -- Nested VMS contents are intentionally ignored completely.
        if class == "Model"
            and name
            and FALLEN_GRENADE_NAME_MATCH(name)
        then
            local key =
                FALLEN_GRENADE_INSTANCE_KEY(inst)

            if key
                and not seen[key]
            then
                seen[key] = true

                local track =
                    WORLD_ESP.grenade_tracks[key]

                if not track then
                    -- IMPORTANT: this timestamp is created immediately when the
                    -- grenade first exists DIRECTLY in Workspace/VFX. It does
                    -- not depend on icon loading, WorldToScreen or drawing.
                    track = {
                        spawned_at = now,
                        born = now, -- backward-compatible alias
                        last_seen = now,
                        points = {},
                        inst = inst,
                    }

                    WORLD_ESP.grenade_tracks[key] = track
                else
                    if track.spawned_at == nil then
                        track.spawned_at =
                            tonumber(track.born)
                            or now
                    end

                    track.born = track.spawned_at
                    track.last_seen = now
                    track.inst = inst
                end

                entries[#entries + 1] = {
                    inst = inst,
                    key = key,
                    name = name,
                    -- Copy the immutable VFX-spawn timestamp into the entry too.
                    -- Even if the PNG becomes ready a second later, countdown
                    -- progress is already one second into the fuse.
                    spawned_at = track.spawned_at,
                }
            end
        end
    end
end

function FALLEN_GRENADE_REFRESH(force)
    if _G.FALLEN_GRENADE_RESET_TRACKS == true then
        WORLD_ESP.grenade_entries = {}
        WORLD_ESP.grenade_tracks = {}
        WORLD_ESP.grenade_last_scan = -100
        _G.FALLEN_GRENADE_RESET_TRACKS = false
    end

    if _G.FALLEN_GRENADE_FORCE_RESCAN == true then
        force = true
        _G.FALLEN_GRENADE_FORCE_RESCAN = false
    end

    if S.world_grenade_esp_enabled ~= true then
        WORLD_ESP.grenade_entries = {}
        return
    end

    local now = tick()

    if not force
        and now - (WORLD_ESP.grenade_last_scan or -100) < 0.012
    then
        return
    end

    WORLD_ESP.grenade_last_scan = now

    local ws = nil

    pcall(function()
        if rbx
            and type(rbx.workspace) == "function"
        then
            ws = rbx.workspace()
        end
    end)

    if not ws then
        WORLD_ESP.grenade_entries = {}
        return
    end

    local vfx =
        world_find_child(
            ws,
            "VFX"
        )

    WORLD_ESP.folders.VFX = vfx

    if not vfx
        or not world_inst_valid(vfx)
    then
        WORLD_ESP.grenade_entries = {}
        return
    end

    local entries = {}
    local seen = {}

    FALLEN_GRENADE_SCAN_VFX_ROOT(
        vfx,
        entries,
        seen,
        now
    )

    WORLD_ESP.grenade_entries = entries

    for key, track in pairs(WORLD_ESP.grenade_tracks) do
        if not seen[key]
            and now - (track.last_seen or 0) > 0.70
        then
            WORLD_ESP.grenade_tracks[key] = nil
        end
    end
end

function FALLEN_GRENADE_PUSH_TRAIL_POINT(track, pos)
    if not track
        or not pos
    then
        return
    end

    track.points =
        type(track.points) == "table"
        and track.points
        or {}

    local now = tick()
    local points = track.points
    local last = points[#points]
    local push = false

    if not last then
        push = true
    else
        local dx = (pos.X or 0) - (last.x or 0)
        local dy = (pos.Y or 0) - (last.y or 0)
        local dz = (pos.Z or 0) - (last.z or 0)

        local dist =
            math.sqrt(
                dx * dx
                + dy * dy
                + dz * dz
            )

        if dist >= 0.16
            or now - (last.t or 0) >= 0.045
        then
            push = true
        end
    end

    if push then
        points[#points + 1] = {
            x = pos.X or 0,
            y = pos.Y or 0,
            z = pos.Z or 0,
            t = now,
        }
    end

    while #points > 72 do
        table.remove(points, 1)
    end

    -- Keep the recent flight trail, capped for performance.
    while #points > 2
        and now - (points[1].t or now) > 3.85
    do
        table.remove(points, 1)
    end
end

function FALLEN_GRENADE_DRAW_TRAIL(points, alpha_mul)
    if S.world_grenade_trail_enabled ~= true
        or type(DrawLine) ~= "function"
        or type(points) ~= "table"
        or #points < 2
    then
        return
    end

    local color =
        FALLEN_GRENADE_COLOR()

    local base_alpha =
        (color[4] or 1)
        * clamp(
            tonumber(alpha_mul) or 1,
            0,
            1
        )

    local thickness =
        clamp(
            tonumber(S.world_grenade_trail_thickness) or 2.4,
            0.5,
            6
        )

    if base_alpha <= 0.001 then
        return
    end

    local count = #points

    for i = 2, count do
        local a = points[i - 1]
        local b = points[i]

        local pa = nil
        local pb = nil

        pcall(function()
            pa = Vector3(a.x, a.y, a.z)
            pb = Vector3(b.x, b.y, b.z)
        end)

        local sa =
            pa
            and world_screen(pa)
            or nil

        local sb =
            pb
            and world_screen(pb)
            or nil

        if sa and sb then
            local t =
                (i - 1)
                / math.max(1, count - 1)

            -- Tail is almost transparent, head is bright and thicker.
            local fade = t * t

            DrawLine(
                sa.X,
                sa.Y,
                sb.X,
                sb.Y,
                color[1],
                color[2],
                color[3],
                base_alpha
                    * (0.08 + fade * 0.82),
                thickness
                    * (0.55 + t * 0.45)
            )
        end
    end
end

function FALLEN_GRENADE_DRAW_TIMER_RING(
    x,
    y,
    radius,
    remaining,
    alpha_mul
)
    if type(DrawLine) ~= "function" then
        return
    end

    remaining =
        clamp(
            tonumber(remaining) or 0,
            0,
            1
        )

    local color =
        FALLEN_GRENADE_COLOR()

    local alpha_value =
        (color[4] or 1)
        * clamp(
            tonumber(alpha_mul) or 1,
            0,
            1
        )

    if alpha_value <= 0.001 then
        return
    end

    -- Very faint full outline stays under the active countdown.
    if type(DrawCircle) == "function" then
        DrawCircle(
            x,
            y,
            radius,
            color[1],
            color[2],
            color[3],
            alpha_value * 0.13,
            1.15
        )
    end

    if remaining <= 0 then
        return
    end

    local segments = 64
    local active =
        math.floor(
            segments * remaining
        )

    if active <= 0 then
        return
    end

    local start_angle =
        -math.pi * 0.5

    local step =
        (math.pi * 2)
        / segments

    -- Clockwise CS-style fuse ring: circumference disappears as time runs out.
    for i = 1, active do
        local a0 =
            start_angle
            + (i - 1) * step

        local a1 =
            start_angle
            + i * step

        DrawLine(
            x + math.cos(a0) * radius,
            y + math.sin(a0) * radius,
            x + math.cos(a1) * radius,
            y + math.sin(a1) * radius,
            color[1],
            color[2],
            color[3],
            alpha_value,
            2.15
        )
    end
end

function FALLEN_GRENADE_DRAW_ICON(
    handle,
    x,
    y,
    size,
    alpha_mul,
    remaining
)
    if not handle
        or type(DrawImage) ~= "function"
    then
        return false
    end

    size =
        clamp(
            tonumber(size) or 24,
            14,
            58
        )

    alpha_mul =
        clamp(
            tonumber(alpha_mul) or 1,
            0,
            1
        )

    local radius =
        size * 0.5 + 4

    if type(DrawCircleFilled) == "function" then
        DrawCircleFilled(
            x,
            y,
            radius,
            0.018,
            0.020,
            0.026,
            0.92 * alpha_mul
        )
    end

    -- The outline itself is the fuse timer requested by the user.
    FALLEN_GRENADE_DRAW_TIMER_RING(
        x,
        y,
        radius,
        remaining,
        alpha_mul
    )

    DrawImage(
        handle,
        x - size * 0.5,
        y - size * 0.5,
        size,
        size,
        1,
        1,
        1,
        alpha_mul,
        math.max(2, size * 0.12)
    )

    return true
end

function FALLEN_GRENADE_DRAW(entry, my_pos)
    if S.world_grenade_esp_enabled ~= true
        or not entry
        or not world_inst_valid(entry.inst)
    then
        return
    end

    local pos =
        world_part_pos(
            entry.inst,
            0
        )

    if not pos then
        return
    end

    local dist =
        world_distance_m(
            pos,
            my_pos
        )

    if not dist then
        return
    end

    local max_dist =
        clamp(
            tonumber(S.world_max_dist) or 500,
            25,
            2000
        )

    if dist > max_dist then
        return
    end

    local key =
        entry.key
        or FALLEN_GRENADE_INSTANCE_KEY(entry.inst)

    if not key then
        return
    end

    local now = tick()
    local track =
        WORLD_ESP.grenade_tracks[key]

    if not track then
        -- Fallback only. Normally the track is created by the VFX scanner
        -- before this draw function is ever reached. Preserve entry.spawned_at
        -- so rendering can never restart the grenade timer.
        local spawned_at =
            tonumber(entry.spawned_at)
            or now

        track = {
            spawned_at = spawned_at,
            born = spawned_at,
            last_seen = now,
            points = {},
            inst = entry.inst,
        }

        WORLD_ESP.grenade_tracks[key] = track
    end

    if track.spawned_at == nil then
        track.spawned_at =
            tonumber(entry.spawned_at)
            or tonumber(track.born)
            or now
    end

    -- Never move this timestamp forward. The timer belongs to the thrown VFX
    -- instance, not to the moment the image handle becomes ready.
    entry.spawned_at = track.spawned_at
    track.born = track.spawned_at
    track.last_seen = now
    track.inst = entry.inst

    FALLEN_GRENADE_PUSH_TRAIL_POINT(
        track,
        pos
    )

    local color =
        FALLEN_GRENADE_COLOR()

    local fade =
        color[4] or 1

    if S.world_fade_distance == true
        and max_dist > 0
    then
        fade =
            fade
            * clamp(
                1 - (dist / max_dist) * 0.78,
                0.18,
                1
            )
    end

    -- Trail is intentionally drawn first so the icon always stays above it.
    FALLEN_GRENADE_DRAW_TRAIL(
        track.points,
        fade
    )

    local screen =
        world_screen(pos)

    if not screen then
        return
    end

    -- Fuse progress is calculated BEFORE touching the image handle.
    -- Therefore a slow PNG load can never restart or delay the 4-second timer.
    local spawned_at =
        tonumber(track.spawned_at)
        or tonumber(entry.spawned_at)
        or tonumber(track.born)
        or now

    local elapsed =
        math.max(
            0,
            now - spawned_at
        )

    local remaining =
        clamp(
            1
            - elapsed
                / FALLEN_GRENADE_FUSE_TIME,
            0,
            1
        )

    local handle =
        FALLEN_GRENADE_ICON_GET()

    if not handle then
        return
    end

    local icon_size =
        clamp(
            (tonumber(S.world_icon_size) or 18) + 6,
            18,
            58
        )

    FALLEN_GRENADE_DRAW_ICON(
        handle,
        screen.X,
        screen.Y - 24,
        icon_size,
        fade,
        remaining
    )
end

local function world_esp_tick()
    local world_active =
        S.world_esp_enabled == true

    local grenade_active =
        S.world_grenade_esp_enabled == true

    if _G.FallenMenuReady ~= true
        or (
            not world_active
            and not grenade_active
        )
    then
        return
    end

    if world_active then
        world_refresh_cache(false)
    end

    if grenade_active then
        FALLEN_GRENADE_REFRESH(false)
    end

    local my_pos =
        world_local_pos()

    if not my_pos then
        return
    end

    if world_active then
        for _, entry in ipairs(
            WORLD_ESP.entries
        ) do
            world_draw_entry(
                entry,
                my_pos
            )
        end

        for _, entry in ipairs(
            WORLD_ESP.base_entries
        ) do
            world_draw_base_entry(
                entry,
                my_pos
            )
        end

        for _, entry in ipairs(
            WORLD_ESP.drop_entries or {}
        ) do
            FALLEN_WORLD_DRAW_DROPPED_ITEM(
                entry,
                my_pos
            )
        end

        for _, entry in ipairs(
            WORLD_ESP.body_bag_entries or {}
        ) do
            FALLEN_WORLD_DRAW_BODY_BAG(
                entry,
                my_pos
            )
        end
    end

    if grenade_active then
        for _, entry in ipairs(
            WORLD_ESP.grenade_entries or {}
        ) do
            FALLEN_GRENADE_DRAW(
                entry,
                my_pos
            )
        end
    end
end

hooks.on_render(function()
    local ok, err =
        pcall(
            world_esp_tick
        )

    if not ok then
        WORLD_ESP.last_error_at =
            WORLD_ESP.last_error_at
            or 0

        if tick() - WORLD_ESP.last_error_at > 2 then
            WORLD_ESP.last_error_at = tick()

            warn(
                SYS
                .. "Resource ESP: "
                .. tostring(err)
            )
        end
    end
end)



-- =========================================================
-- Configs animated dropdown
-- =========================================================

function FALLEN_CONFIGS.anim_step()
    local now = tick()

    if A.config_last_t == nil then
        A.config_last_t = now
    end

    local dt =
        clamp(
            now - A.config_last_t,
            0,
            0.05
        )

    A.config_last_t = now

    local target =
        A.config_open
        and 1
        or 0

    local speed =
        target > (A.config_anim or 0)
        and 10
        or 8

    A.config_anim =
        exp_chase(
            A.config_anim or 0,
            target,
            speed,
            dt
        )

    if target == 0
        and (A.config_anim or 0) < 0.018
    then
        A.config_anim = 0
    elseif target == 1
        and (A.config_anim or 0) > 0.992
    then
        A.config_anim = 1
    end

    return
        clamp(
            A.config_anim or 0,
            0,
            1
        )
end

function FALLEN_CONFIGS.button(
    mx,
    my,
    clicked,
    x,
    y,
    w,
    h,
    label,
    danger
)
    local hot =
        hover(
            mx,
            my,
            x,
            y,
            w,
            h
        )

    local bg

    if danger then
        bg =
            hot
            and { 0.34, 0.105, 0.115, 1 }
            or { 0.245, 0.082, 0.092, 1 }
    else
        bg =
            hot
            and { 0.115, 0.120, 0.145, 1 }
            or { 0.092, 0.096, 0.112, 1 }
    end

    rounded_fill(
        x,
        y,
        w,
        h,
        7,
        bg
    )

    centered_text(
        x + w * 0.5,
        y + 9,
        label,
        danger
            and { 1.0, 0.72, 0.74, 1 }
            or C.text
    )

    return
        clicked
        and hot
end

function FALLEN_CONFIGS.draw_popup(
    mx,
    my,
    clicked,
    lmb,
    anchor_x,
    anchor_y,
    anchor_w
)
    local raw =
        FALLEN_CONFIGS.anim_step()

    if raw <= 0.001
        and not A.config_open
    then
        return false
    end

    local parent_alpha =
        MENU_RENDER_ALPHA

    local fade =
        ease_out_cubic(raw)

    MENU_RENDER_ALPHA =
        parent_alpha
        * fade

    local anim =
        A.config_open
        and ease_out_cubic(raw)
        or ease_in_out_cubic(raw)

    local visible_count =
        math.min(
            #FALLEN_CONFIGS.CONFIG.list,
            6
        )

    local empty_extra =
        #FALLEN_CONFIGS.CONFIG.list == 0
        and 29
        or 0

    local full_h =
        160
        + visible_count * 29
        + empty_extra

    local pw = 300

    local retract =
        1 - anim

    local px =
        snap(
            anchor_x
        )

    local py =
        snap(
            anchor_y
            + 42
            - retract * 20
        )

    local ph =
        math.max(
            42,
            full_h
            - retract * 62
        )

    local interactive =
        raw > 0.95
        and A.config_open

    local ui_clicked =
        clicked
        and interactive

    FALLEN_POPUP_GLOW(px, py, pw, ph, 11, 1)

    rounded_fill(
        px,
        py,
        pw,
        ph,
        11,
        { 0.062, 0.066, 0.077, 1 }
    )

    text(
        px + 13,
        py + 12,
        "Configs",
        C.text
    )

    if ph > 39 then
        line(
            px + 12,
            py + 34,
            px + pw - 12,
            py + 34,
            C.divider,
            1
        )
    end

    -- Name input.
    local input_x = px + 12
    local input_y = py + 44
    local input_w = pw - 24
    local input_h = 31

    if ph > 76 then
        local input_hot =
            hover(
                mx,
                my,
                input_x,
                input_y,
                input_w,
                input_h
            )

        rounded_fill(
            input_x,
            input_y,
            input_w,
            input_h,
            7,
            A.config_input_focus
                and { 0.112, 0.118, 0.145, 1 }
                or (
                    input_hot
                    and { 0.100, 0.104, 0.124, 1 }
                    or { 0.086, 0.090, 0.105, 1 }
                )
        )

        if A.config_input_focus then
            rounded_outline(
                input_x,
                input_y,
                input_w,
                input_h,
                7,
                alpha(C.accent, 0.65),
                1,
                { 0.112, 0.118, 0.145, 1 }
            )
        end

        local shown =
            tostring(
                A.config_input_buffer
                or ""
            )

        if shown == ""
            and not A.config_input_focus
        then
            text(
                input_x + 10,
                input_y + 9,
                "Config name",
                C.text_faint
            )
        else
            if A.config_input_focus
                and math.floor(tick() * 2) % 2 == 0
            then
                shown =
                    shown
                    .. "|"
            end

            text(
                input_x + 10,
                input_y + 9,
                shown,
                C.text
            )
        end

        if ui_clicked
            and input_hot
        then
            FALLEN_CONFIGS.input_focus(true)
        end
    end

    local list_y =
        py + 84

    if ph > 112 then
        text(
            px + 13,
            list_y,
            "Saved",
            C.text_dim
        )

        list_y =
            list_y + 18

        if #FALLEN_CONFIGS.CONFIG.list == 0 then
            text(
                px + 13,
                list_y + 5,
                "No saved configs",
                C.text_faint
            )
        else
            for i = 1, visible_count do
                local name =
                    FALLEN_CONFIGS.CONFIG.list[i]

                local iy =
                    list_y
                    + (i - 1) * 29

                local hot =
                    hover(
                        mx,
                        my,
                        px + 10,
                        iy,
                        pw - 20,
                        26
                    )

                local selected =
                    A.config_selected == name

                if hot
                    or selected
                then
                    rounded_fill(
                        px + 10,
                        iy,
                        pw - 20,
                        26,
                        6,
                        selected
                            and { 0.105, 0.119, 0.158, 1 }
                            or { 0.086, 0.091, 0.108, 1 }
                    )
                end

                if selected then
                    rounded_fill(
                        px + 10,
                        iy + 4,
                        3,
                        18,
                        1,
                        C.accent
                    )
                end

                text(
                    px + 19,
                    iy + 7,
                    name,
                    FALLEN_HOVER_TEXT(
                        "config_option:" .. tostring(name),
                        hot,
                        selected and C.text or C.text_dim
                    )
                )

                if ui_clicked
                    and hot
                then
                    A.config_selected = name
                    A.config_input_buffer = name
                    FALLEN_CONFIGS.input_focus(false)
                end
            end
        end
    end

    local buttons_y =
        py
        + full_h
        - 43

    if ph > full_h - 48 then
        local gap = 7
        local bw =
            math.floor(
                (pw - 24 - gap * 2)
                / 3
            )

        local bx = px + 12

        if FALLEN_CONFIGS.button(
            mx,
            my,
            ui_clicked,
            bx,
            buttons_y,
            bw,
            31,
            "Save",
            false
        ) then
            FALLEN_CONFIGS.input_focus(false)
            FALLEN_CONFIGS.save(
                A.config_input_buffer
            )
        end

        bx =
            bx + bw + gap

        if FALLEN_CONFIGS.button(
            mx,
            my,
            ui_clicked,
            bx,
            buttons_y,
            bw,
            31,
            "Load",
            false
        ) then
            FALLEN_CONFIGS.input_focus(false)

            FALLEN_CONFIGS.load(
                A.config_selected
                or A.config_input_buffer
            )
        end

        bx =
            bx + bw + gap

        if FALLEN_CONFIGS.button(
            mx,
            my,
            ui_clicked,
            bx,
            buttons_y,
            bw,
            31,
            "Delete",
            true
        ) then
            FALLEN_CONFIGS.input_focus(false)

            FALLEN_CONFIGS.delete(
                A.config_selected
                or A.config_input_buffer
            )
        end
    end

    local popup_hot =
        hover(
            mx,
            my,
            px,
            py,
            pw,
            ph
        )

    local anchor_hot =
        hover(
            mx,
            my,
            anchor_x,
            anchor_y,
            anchor_w,
            34
        )

    if interactive
        and clicked
        and not popup_hot
        and not anchor_hot
    then
        A.config_open = false
        FALLEN_CONFIGS.input_focus(false)
    end

    MENU_RENDER_ALPHA =
        parent_alpha

    return popup_hot
end


