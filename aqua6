            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            0.78,
            0.94,
            1.0,
            alpha * 0.98 * fade,
            s * 0.18
        )

    elseif kind == 7 then
        local handle = FALLEN_HITFX_IMAGE(
            "hitfx_crystal_sheet",
