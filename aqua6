        MENU_RENDER_ALPHA = parent_alpha
        return popup_hot or scale_dropdown_hot
    end

    local scale_dropdown_hot =
        FALLEN_DRAW_MENU_SCALE_DROPDOWN(
            mx, my, ui_clicked,
            box_x, box_y + box_h + 4, box_w
        )

    local popup_hot = hover(mx, my, px, py, pw, shell_h)
    local anchor_hot = hover(mx, my, anchor_x - 11, anchor_y - 11, 22, 22)

    if interactive
        and clicked
        and not popup_hot
        and not anchor_hot
        and not scale_dropdown_hot
    then
        A.menu_settings_open = false
        A.menu_scale_dropdown_open = false
    end

    MENU_RENDER_ALPHA = parent_alpha
    return
        popup_hot
        or scale_dropdown_hot
