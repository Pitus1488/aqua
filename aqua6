    end

    local ok =
        pcall(function()
            sa[key] =
                value
        end)

    return ok == true
end


function FALLEN_SILENT_KEYBIND_CACHE()
    if not cheat or not cheat.keybinds then
        return nil
    end

    local kb = cheat.keybinds
    local cache = A.silent_keybind_cache

    if type(cache) == "table" and cache.owner == kb then
        return cache
    end

    cache = {
        owner = kb,
        toggled = {},
        active = {},
    }

    local seen_toggled = {}
    local seen_active = {}

    local function add(list, seen, raw)
        raw = tostring(raw or "")
        if raw ~= "" and not seen[raw] then
            seen[raw] = true
            list[#list + 1] = raw
        end
    end

    if type(kb._keys) == "function" then
        local ok, keys = pcall(function() return kb:_keys() end)
        if ok and type(keys) == "table" then
            for i = 1, #keys do
                local raw = tostring(keys[i])
                local normalized = FALLEN_SILENT_NORMALIZE_KEY(raw)
                if string.find(normalized, "silent", 1, true) then
                    if string.find(normalized, "toggled", 1, true) then
                        add(cache.toggled, seen_toggled, raw)
                    elseif string.find(normalized, "active", 1, true) then
                        add(cache.active, seen_active, raw)
                    end
                end
            end
        end
    end

    -- Known fallbacks cost nothing and cover builds without _keys().
    add(cache.toggled, seen_toggled, "silent_aim_toggled")
    add(cache.toggled, seen_toggled, "silent_toggled")
    add(cache.active, seen_active, "silent_aim_active")
    add(cache.active, seen_active, "silent_active")

    A.silent_keybind_cache = cache
    return cache
end


function FALLEN_SILENT_CLEAR_TOGGLE_LATCH()
    if not cheat or not cheat.keybinds then
        return
    end

    local cache = FALLEN_SILENT_KEYBIND_CACHE()
    if not cache then return end

    local kb = cheat.keybinds

    for i = 1, #cache.toggled do
        local raw = cache.toggled[i]
        pcall(function() kb[raw] = false end)
    end

    for i = 1, #cache.active do
        local raw = cache.active[i]
        pcall(function() kb[raw] = false end)
    end
end


function FALLEN_SILENT_FORCE_HOLD()
    -- Keep HOLD mode pinned, but only clear toggle latches here.
    -- Active-state is written once below in FALLEN_SILENT_TICK().
    FALLEN_SILENT_WRITE_FIELD("key_mode", 0)

    if not cheat or not cheat.keybinds then
        return
    end

    local cache = FALLEN_SILENT_KEYBIND_CACHE()
    if not cache then return end

    local kb = cheat.keybinds
    for i = 1, #cache.toggled do
        local raw = cache.toggled[i]
        pcall(function() kb[raw] = false end)
    end
end

