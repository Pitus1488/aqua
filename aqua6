WORLD_BODY_BAG_ICON_URL =
    "https://fotovssylku.ru/i/54543543-%281%29.fRVHo"

WORLD_BODY_BAG_ICON_RESOLVED_URL =
    WORLD_BODY_BAG_ICON_RESOLVED_URL
    or nil

WORLD_BODY_BAG_ICON_HANDLE =
    WORLD_BODY_BAG_ICON_HANDLE
    or nil

WORLD_BODY_BAG_ICON_FAILED =
    false

function FALLEN_WORLD_BODY_BAG_ICON()
    if WORLD_BODY_BAG_ICON_HANDLE
        and type(IsImageReady) == "function"
    then
        local ok, ready =
            pcall(
                IsImageReady,
                WORLD_BODY_BAG_ICON_HANDLE
            )

        if ok and ready == true then
            return WORLD_BODY_BAG_ICON_HANDLE
        end
    end

    if WORLD_BODY_BAG_ICON_HANDLE
        and type(IsImageFailed) == "function"
    then
        local ok, failed =
            pcall(
                IsImageFailed,
                WORLD_BODY_BAG_ICON_HANDLE
            )

        if ok and failed == true then
            WORLD_BODY_BAG_ICON_FAILED = true
            WORLD_BODY_BAG_ICON_HANDLE = nil
            return nil
        end
    end

    if WORLD_BODY_BAG_ICON_FAILED == true then
        return nil
    end

    if not WORLD_BODY_BAG_ICON_RESOLVED_URL then
        -- Same exact page->image resolver already used by the loader.
        -- Wait until that global helper exists, then resolve this source once.
        if type(FALLEN_LOADER_RESOLVE_IMAGE_URL) ~= "function" then
            return nil
        end

        WORLD_BODY_BAG_ICON_RESOLVED_URL =
            FALLEN_LOADER_RESOLVE_IMAGE_URL(
                WORLD_BODY_BAG_ICON_URL
            )
            or WORLD_BODY_BAG_ICON_URL
    end

    if not WORLD_BODY_BAG_ICON_HANDLE
        and type(LoadImage) == "function"
    then
        local ok, handle =
            pcall(
                LoadImage,
                WORLD_BODY_BAG_ICON_RESOLVED_URL
            )

        if ok and handle then
            WORLD_BODY_BAG_ICON_HANDLE = handle
        else
            WORLD_BODY_BAG_ICON_FAILED = true
            return nil
        end
    end

    return nil
end

