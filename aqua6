function FALLEN_SILENT_TICK()
    local sa =
        FALLEN_SILENT_LIVE_SECTION()

    if not sa then
        return
    end

    -- Fixed Raycast method + real HOLD keybind mode.
    pcall(function()
        sa.method =
            2
    end)

    FALLEN_SILENT_FORCE_HOLD()

    -- HOLD means the stock keybind state must follow the physical key only.
    -- Never leave any stale toggle/active latch behind.
    local bind_vk =
        math.floor(
            tonumber(S.silent_key)
            or 0
        )

    local physically_down =
        false

    if bind_vk > 0 then
        physically_down =
            key_down(bind_vk)
            == true
    end

    if cheat and cheat.keybinds then
        local cache = FALLEN_SILENT_KEYBIND_CACHE()
        if cache then
            local kb = cheat.keybinds

            for i = 1, #cache.toggled do
                local raw = cache.toggled[i]
                pcall(function() kb[raw] = false end)
            end

            for i = 1, #cache.active do
                local raw = cache.active[i]
                pcall(function() kb[raw] = physically_down end)
            end
        end
    end

    -- While our custom menu is open, our switches are authoritative.
    -- This does NOT change HOLD active-state behavior.
    if S.visible then
        pcall(function()
            sa.enabled =
                S.silent_enabled == true
        end)

        pcall(function()
            sa.magic_bullet =
                S.silent_magic_bullet == true
        end)
    end

    -- Keep the explicit Silent FOV gate pinned.
    FALLEN_SILENT_SET_FOV_ENABLED(
        S.silent_fov_enabled == true
    )

    -- Silent target selection uses the radius from OUR Silent FOV.
    local silent_runtime_fov =
        math.floor(
            clamp(
                tonumber(S.silent_fov)
                or 180,
                10,
                600
            )
            + 0.5
        )

    pcall(function()
        sa.fov =
            silent_runtime_fov
    end)

    -- Make the built-in FOV visual match OUR Silent FOV exactly:
    -- same radius and same color picker value.
    if S.silent_fov_enabled == true then
        FALLEN_SYNC_STOCK_FOV_VISUAL(
            silent_runtime_fov,
            FALLEN_SILENT_FOV_COLOR()
        )
    end

    -- When the menu is closed, keep our UI cache following the stock cheat
    -- instead of overwriting the stock cheat with stale S.* values.
    if not S.visible then
        FALLEN_SILENT_SYNC_UI_FROM_LIVE()
    end
end

function FALLEN_CUSTOM_FOV_CENTER()
    -- Use the SAME mouse_pos() helper that the Fallen menu/weather already uses.
    -- It returns the mouse in the same client-space coordinates as Drawing.
    if type(mouse_pos) == "function" then
        local ok, mx, my =
            pcall(
                mouse_pos
            )

        if ok then
            mx =
                tonumber(mx)

            my =
                tonumber(my)

            if mx and my then
                return mx, my
            end
        end
    end

    -- Fallback: game crosshair position.
    if type(crosshair_pos) == "function" then
        local ok, c =
            pcall(
                crosshair_pos
            )

        if ok and c then
            local x =
                tonumber(
                    c.X
                    or c.x
                    or c[1]
                )

            local y =
                tonumber(
                    c.Y
                    or c.y
                    or c[2]
                )

            if x and y then
                return x, y
            end
        end
    end

    -- Last fallback: screen center.
    local dims = nil

    pcall(function()
        dims =
            ScreenSize()
    end)

    if dims then
        local sw =
            tonumber(
                dims.Width
                or dims.X
            )

        local sh =
            tonumber(
                dims.Height
                or dims.Y
            )

        if sw and sh then
            return
                sw * 0.5,
                sh * 0.5
        end
    end

    return nil, nil
end


function FALLEN_SYNC_STOCK_FOV_VISUAL(
    radius,
    color
)
    -- This ONLY synchronizes the stock FOV VISUAL.
    -- It does not enable cheat.aimbot and does not touch its aim logic.
    radius =
        math.floor(
            clamp(
                tonumber(radius)
                or 180,
                10,
                600
            )
            + 0.5
        )

    color =
        color
        or { 1, 1, 1, 1 }

    -- The stock FOV circle uses the Aimbot FOV size field for drawing.
    if cheat
        and cheat.aimbot
    then
        pcall(function()
            cheat.aimbot.fov =
                radius
        end)
    end

    -- FOV color lives in esp_colors according to the custom API.
    if cheat
        and cheat.esp_colors
    then
        local rgba = {
            clamp(
                tonumber(color[1]) or 1,
                0,
                1
            ),
            clamp(
                tonumber(color[2]) or 1,
                0,
                1
            ),
            clamp(
                tonumber(color[3]) or 1,
                0,
                1
            ),
            clamp(
                tonumber(color[4]) or 1,
                0,
                1
            ),
        }

        pcall(function()
            cheat.esp_colors.fov =
                rgba
        end)

        -- Some builds use the same color for the aim/FOV line.
        pcall(function()
            cheat.esp_colors.aim_line =
                rgba
        end)
    end
end


