    end

    if hover(
        mx,
        my,
        x,
        y,
        size,
        size
    ) then
        FALLEN_AVATAR_EDITOR_OPEN()
        return true
    end

    return false
end

function FALLEN_DRAW_AVATAR_EDITOR(
    mx,
    my,
    clicked,
    lmb,
    wx,
    wy,
    win_w,
    win_h
)
    if not A.avatar_editor_open then
        return
    end

    local pw = 468
    local ph = 396

    local px =
        wx
        + (win_w - pw) * 0.5

    local py =
        wy
        + (win_h - ph) * 0.5

    local panel_color =
        C.group_box_bg

    rounded_fill(
        wx + 4,
        wy + 4,
        win_w - 8,
        win_h - 8,
        14,
        { 0, 0, 0, 0.56 }
    )

    FALLEN_POPUP_GLOW(
        px,
        py,
        pw,
        ph,
        12,
        1
    )

    rounded_fill(
        px,
        py,
        pw,
        ph,
        12,
        panel_color
    )

    text(
        px + 16,
        py + 15,
        "Edit Avatar",
        C.text
    )

    line(
        px + 14,
        py + 39,
        px + pw - 14,
        py + 39,
        C.divider,
        1
    )

    local preview_size = 204
    local preview_x =
        px + (pw - preview_size) * 0.5

    local preview_y =
        py + 55

    rounded_fill(
        preview_x - 2,
        preview_y - 2,
        preview_size + 4,
        preview_size + 4,
        7,
        { 0.12, 0.13, 0.16, 1 }
    )

    fill(
        preview_x,
        preview_y,
        preview_size,
        preview_size,
        { 0.035, 0.038, 0.047, 1 }
    )

    circle_fill(
        preview_x + preview_size * 0.5,
        preview_y + preview_size * 0.5,
        preview_size * 0.385,
        { 0.035, 0.038, 0.047, 1 }
    )

    local preview_handle =
        A.avatar_editor_candidate_handle
        or PROFILE.avatar

    -- Use a dedicated circular destination. The source crop happens in UV
    -- space, so there is no moving square behind the circle.
    local crop_size =
        preview_size * 0.77

    local crop_x =
        preview_x
        + (preview_size - crop_size) * 0.5

    local crop_y =
        preview_y
        + (preview_size - crop_size) * 0.5

    local preview_ok =
        FALLEN_AVATAR_DRAW_CROP_VIEW(
            preview_handle,
            crop_x,
            crop_y,
            crop_size,
            S.avatar_crop_zoom,
            S.avatar_crop_pan_x,
            S.avatar_crop_pan_y,
            panel_color,
            true
        )

    if not preview_ok then
        centered_text(
            preview_x + preview_size * 0.5,
            preview_y + preview_size * 0.5 - 5,
            "No image",
            C.text_dim
        )
    end

    circle(
        preview_x + preview_size * 0.5,
        preview_y + preview_size * 0.5,
        crop_size * 0.5,
        { 0.94, 0.95, 0.98, 0.98 },
        2
    )

    local preview_hot =
        hover(
            mx,
            my,
            crop_x,
            crop_y,
            crop_size,
            crop_size
        )

    if clicked
        and preview_hot
        and preview_ok
    then
        A.avatar_editor_dragging = true

        A.avatar_editor_drag_start_mx = mx
        A.avatar_editor_drag_start_my = my

        A.avatar_editor_drag_start_pan_x =
            tonumber(S.avatar_crop_pan_x)
            or 0

        A.avatar_editor_drag_start_pan_y =
            tonumber(S.avatar_crop_pan_y)
            or 0

        A.active_slider = nil
    end

    if A.avatar_editor_dragging then
        if lmb then
            local logical_dx =
                (
                    mx
                    - (A.avatar_editor_drag_start_mx or mx)
                )
                / math.max(
                    MENU_UI_SCALE or 1,
                    0.001
                )

            local logical_dy =
                (
                    my
                    - (A.avatar_editor_drag_start_my or my)
                )
                / math.max(
                    MENU_UI_SCALE or 1,
                    0.001
                )

            local zoom =
                clamp(
                    tonumber(S.avatar_crop_zoom) or 1,
                    1,
                    5.0
                )

            local max_off =
                math.max(
                    1,
                    crop_size
                    * (zoom - 1)
                    * 0.5
                )

            S.avatar_crop_pan_x =
                clamp(
                    (A.avatar_editor_drag_start_pan_x or 0)
                    + logical_dx / max_off,
                    -1,
                    1
                )

            S.avatar_crop_pan_y =
                clamp(
                    (A.avatar_editor_drag_start_pan_y or 0)
                    + logical_dy / max_off,
                    -1,
                    1
                )
        else
            A.avatar_editor_dragging = false
        end
    end

    text(
        px + 18,
        py + 269,
        "Drag the image to reposition it",
        C.text_faint
    )

    slider_row(
        mx,
        my,
        clicked
            and not A.avatar_editor_dragging,
        lmb,
        px + 8,
        py + 283,
        pw - 16,
        "Zoom",
        "avatar_crop_zoom",
        1.00,
        5.00,
        "float"
    )

    local open_x = px + 16
    local open_y = py + 331
    local open_w = 128
    local button_h = 31

    local reload_x = open_x + open_w + 8
    local reload_w = 128

    local open_hot =
        hover(
            mx,
            my,
            open_x,
            open_y,
            open_w,
            button_h
        )

    rounded_fill(
        open_x,
        open_y,
        open_w,
        button_h,
        7,
        open_hot
            and C.card_hover
            or C.card
    )

    centered_text(
        open_x + open_w * 0.5,
        open_y + 9,
        "Open Folder",
        open_hot
            and C.text
            or C.text_dim
    )

    if clicked
        and open_hot
    then
        FALLEN_AVATAR_EDITOR_OPEN_FOLDER()
    end

    local reload_hot =
        hover(
            mx,
            my,
            reload_x,
            open_y,
            reload_w,
            button_h
        )

    rounded_fill(
        reload_x,
        open_y,
        reload_w,
        button_h,
        7,
        reload_hot
            and C.card_hover
            or C.card
    )

    centered_text(
        reload_x + reload_w * 0.5,
        open_y + 9,
        "Reload Image",
        reload_hot
            and C.text
            or C.text_dim
    )

    if clicked
        and reload_hot
    then
        FALLEN_AVATAR_EDITOR_RELOAD_PREVIEW()
    end

    local cancel_w = 76
    local save_w = 76
    local save_x =
        px + pw - 16 - save_w

    local cancel_x =
        save_x - 8 - cancel_w

    local cancel_hot =
        hover(
            mx,
            my,
            cancel_x,
            open_y,
            cancel_w,
            button_h
        )

    rounded_fill(
        cancel_x,
        open_y,
        cancel_w,
        button_h,
        7,
        cancel_hot
            and C.card_hover
            or C.card
    )

    centered_text(
        cancel_x + cancel_w * 0.5,
        open_y + 9,
        "Cancel",
        cancel_hot
            and C.text
            or C.text_dim
    )

    local save_hot =
        hover(
            mx,
            my,
            save_x,
            open_y,
            save_w,
            button_h
        )

    rounded_fill(
        save_x,
        open_y,
        save_w,
        button_h,
        7,
        save_hot
            and C.selected
            or {
                C.accent[1],
                C.accent[2],
                C.accent[3],
                0.72,
            }
    )

    centered_text(
        save_x + save_w * 0.5,
        open_y + 9,
        "Save",
        C.text
    )

    if clicked
        and cancel_hot
    then
        FALLEN_AVATAR_EDITOR_CANCEL()
        return
    end

    if clicked
        and save_hot
    then
        FALLEN_AVATAR_EDITOR_SAVE()
        return
    end

    local status =
        tostring(
            A.avatar_editor_status
            or ""
        )

    if #status > 58 then
        status =
            string.sub(
                status,
                1,
                55
            )
            .. "..."
    end

    text(
        px + 18,
        py + ph - 19,
        status,
        C.text_faint
    )
end

