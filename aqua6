function world_base_compact_row(mx, my, clicked, x, y, w, cfg)
    if not cfg then return end
    world_base_ensure_state(cfg)

    local h = 41
    local hot = row_hover(mx, my, x, y, w, h)
    if hot then
        rounded_fill(x + 5, y + 4, w - 10, h - 8, 5, C.button_hovered)
    end
    local key = "world_base_" .. tostring(cfg.id)
    local enabled = S[key] == true
    local prefix = world_base_color_prefix(cfg.id)
    local col = world_color_from_prefix(prefix)

    text(
        x + 29,
        y + 14,
        cfg.label,
        FALLEN_HOVER_TEXT(
            "house:" .. tostring(cfg.id),
            hot,
            C.text
        )
    )

    if A.toggles[key] == nil then
        A.toggles[key] = enabled and 1 or 0
    end

    local target = enabled and 1 or 0
    A.toggles[key] = lerp(A.toggles[key], target, 0.23)

    if math.abs(A.toggles[key] - target) < 0.002 then
        A.toggles[key] = target
    end

    -- Compact Neverlose-like checklist: check at left, color at far right.
    local swatch_s = 18
    local swatch_x = x + w - swatch_s - 12
    local swatch_y = y + 11
    local swatch_hot = hover(mx, my,
        swatch_x, swatch_y, swatch_s, swatch_s)
    world_square_swatch(swatch_x, swatch_y, swatch_s, col)

    if S[key] == true then
        local cx, cy = x + 16, y + 20.5
        line(cx - 5, cy, cx - 1, cy + 4, C.text, 1.4)
        line(cx - 1, cy + 4, cx + 6, cy - 4, C.text, 1.4)
    end

    if clicked and swatch_hot then
        FALLEN_COLOR_INPUT_STOP(true)

        if A.world_color_picker_open
            and A.world_color_picker_key == prefix
        then
            A.world_color_picker_open = false
            A.world_color_picker_drag = nil
        else
            A.world_color_picker_key = prefix
            A.world_color_picker_open = true
            A.world_color_picker_drag = nil
            A.fov_picker_open = false
            A.fov_picker_drag = nil
        end

        A.world_color_picker_anchor_x = FALLEN_UI_X(swatch_x)
        A.world_color_picker_anchor_y = FALLEN_UI_Y(swatch_y)
        A.world_color_picker_anchor_w = FALLEN_UI_LEN(swatch_s)
        A.world_color_picker_anchor_h = FALLEN_UI_LEN(swatch_s)

        if numeric_stop then
            numeric_stop(true)
        end

        return
    end

    if clicked and hot and not swatch_hot then
        S[key] = not enabled
        WORLD_ESP.last_scan = -100
    end

end

