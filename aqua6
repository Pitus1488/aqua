function FALLEN_HITFX_DRAW_IMAGE_UV(
    handle,
    x,
    y,
    w,
    h,
    r,
    g,
    b,
    a,
    u0,
    v0,
    u1,
    v1,
    rounding
)
    if not handle
        or type(DrawImage) ~= "function"
        or a <= 0.002
    then
        return false
    end

    local ok = pcall(
        DrawImage,
        handle,
        x,
        y,
        w,
        h,
        r,
        g,
        b,
        a,
        rounding or math.max(2, math.min(w, h) * 0.08),
        u0,
        v0,
        u1,
        v1
    )

    if ok then
        return true
    end

    return pcall(
        DrawImage,
        handle,
        x,
        y,
        w,
        h,
        r,
        g,
        b,
        a,
        rounding or math.max(2, math.min(w, h) * 0.08)
    ) == true
end

function FALLEN_HITFX_DRAW_SHEET_FRAME(
    handle,
    frame,
    cols,
    rows,
    x,
    y,
    w,
    h,
    r,
    g,
    b,
    a,
    rounding
)
    cols = math.max(1, math.floor(cols or 4))
    rows = math.max(1, math.floor(rows or 4))
    local total = cols * rows
    frame = math.floor(clamp(tonumber(frame) or 0, 0, total - 1))
    local cx = frame % cols
    local cy = math.floor(frame / cols)
    local u0 = cx / cols
    local v0 = cy / rows
    local u1 = (cx + 1) / cols
    local v1 = (cy + 1) / rows
    return FALLEN_HITFX_DRAW_IMAGE_UV(handle, x, y, w, h, r, g, b, a, u0, v0, u1, v1, rounding)
end

function FALLEN_HITFX_RAND(seed)
    local x =
        math.sin(
            (seed or 1) * 12.9898
            + 78.233
        ) * 43758.5453

    return x - math.floor(x)
end

function FALLEN_HITFX_DRAW_FALLEN(
    kind,
    sx,
    sy,
    size,
    t,
    alpha,
    col,
    seed
)
    local out =
        1 - (1 - t) * (1 - t)

    local fade =
        math.max(
            0,
            1 - t
        )

    if kind == 1 then
        local handle = FALLEN_HITFX_IMAGE(
            "hitfx_spark_sheet",
            FALLEN_BT_IMAGE.hitfx_spark_sheet_url
        )

        local frame = math.floor(clamp(out * 15, 0, 15))
        local s = size * (1.45 + 0.30 * out)
        FALLEN_HITFX_DRAW_SHEET_FRAME(
            handle,
            frame,
            4,
            4,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            1,
            1,
            1,
            alpha * (1 - t * 0.35),
            s * 0.18
        )

    elseif kind == 2 then
        local handle = FALLEN_HITFX_IMAGE(
            "hitfx_smokering_sheet",
            FALLEN_BT_IMAGE.hitfx_smokering_sheet_url
        )

        local frame = math.floor(clamp(out * 15, 0, 15))
        local s = size * (1.20 + 2.75 * out)
        FALLEN_HITFX_DRAW_SHEET_FRAME(
            handle,
            frame,
            4,
            4,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            col[1],
            col[2],
            col[3],
            alpha * 0.95 * fade,
            s * 0.22
        )

    elseif kind == 3 then
        local handle = FALLEN_HITFX_IMAGE(
            "hitfx_particles_sheet",
            FALLEN_BT_IMAGE.hitfx_particles_sheet_url
        )

        local frame = math.floor(clamp(out * 15, 0, 15))

        for k = 1, 6 do
            local sd = (seed or 1) + k * 19.73
            local ang = (k / 6) * math.pi * 2 + math.sin(sd) * 0.45
            local spread = size * (0.16 + 1.28 * out) * (0.75 + FALLEN_HITFX_RAND(sd + 2) * 0.55)
            local px = sx + math.cos(ang) * spread
            local py = sy + math.sin(ang) * spread
            local ps = size * (0.42 + FALLEN_HITFX_RAND(sd + 4) * 0.28)
            local rr, gg, bb = col[1], col[2], col[3]
            if k % 2 == 1 then
                rr, gg, bb = 1.0, 0.22, 0.86
            end
            FALLEN_HITFX_DRAW_SHEET_FRAME(
                handle,
                frame,
                4,
                4,
                px - ps * 0.5,
                py - ps * 0.5,
                ps,
                ps,
                rr,
                gg,
                bb,
                alpha * 0.92 * fade,
                ps * 0.20
            )
        end

    elseif kind == 4 then
        local handle = FALLEN_HITFX_IMAGE(
            "hitfx_test1_sheet",
            FALLEN_BT_IMAGE.hitfx_test1_sheet_url
        )

        local frame = math.floor(clamp(out * 15, 0, 15))
        local s = size * (1.45 + 0.30 * out)
        FALLEN_HITFX_DRAW_SHEET_FRAME(
            handle,
            frame,
            4,
            4,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            col[1],
            col[2],
            col[3],
            alpha * 0.98 * fade,
            s * 0.18
        )

    elseif kind == 5 then
        local handle = FALLEN_HITFX_IMAGE(
            "hitfx_test2_sheet",
            FALLEN_BT_IMAGE.hitfx_test2_sheet_url
        )

        local frame = math.floor(clamp(out * 15, 0, 15))
        local s = size * (1.45 + 0.30 * out)
        FALLEN_HITFX_DRAW_SHEET_FRAME(
            handle,
            frame,
            4,
            4,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            1,
            1,
            1,
            alpha * 0.96 * fade,
            s * 0.18
        )

    elseif kind == 6 then
        local handle = FALLEN_HITFX_IMAGE(
            "hitfx_ice_sheet",
            FALLEN_BT_IMAGE.hitfx_ice_sheet_url
        )

        local frame = math.floor(clamp(out * 15, 0, 15))
        local s = size * (1.45 + 0.30 * out)
        FALLEN_HITFX_DRAW_SHEET_FRAME(
            handle,
            frame,
            4,
            4,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            0.78,
            0.94,
            1.0,
            alpha * 0.98 * fade,
            s * 0.18
        )

    elseif kind == 7 then
        local handle = FALLEN_HITFX_IMAGE(
            "hitfx_crystal_sheet",
            FALLEN_BT_IMAGE.hitfx_crystal_sheet_url
        )

        local frame = math.floor(clamp(out * 15, 0, 15))
        local s = size * (1.45 + 0.30 * out)
        FALLEN_HITFX_DRAW_SHEET_FRAME(
            handle,
            frame,
            4,
            4,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            1.0,
            0.78,
            0.78,
            alpha * 0.98 * fade,
            s * 0.18
        )
    end
end

function FALLEN_HITFX_FIND_PLAYER(
    address,
    name
)
    if not players
        or type(players.get_all) ~= "function"
    then
        return nil
    end

    local list = nil

    pcall(function()
        list =
            players.get_all()
    end)

    if type(list) ~= "table" then
        return nil
    end

    for _, p in ipairs(list) do
        if address ~= nil
            and p.address ~= nil
            and p.address == address
        then
            return p
        end

        if name ~= nil then
            local pn =
                p.name
                or p.display_name
                or p.Name

            if pn ~= nil
                and tostring(pn)
                    == tostring(name)
            then
                return p
            end
        end
    end

    return nil
end


function FALLEN_HITFX_PLAYER_HEAD_POS(
    p,
    fallback
)
    if p
        and p.head_pos
        and p.head_pos.X ~= nil
        and p.head_pos.Y ~= nil
        and p.head_pos.Z ~= nil
    then
        return {
            X = p.head_pos.X,
            Y = p.head_pos.Y,
            Z = p.head_pos.Z,
        }
    end

    if p
        and type(p.bones) == "table"
        and type(fap_find_bone_pos) == "function"
    then
        local head =
            fap_find_bone_pos(
                p,
                { "Head" }
            )

        if head then
            return head
        end
    end

    if fallback
        and fallback.X ~= nil
        and fallback.Y ~= nil
        and fallback.Z ~= nil
    then
        return {
            X = fallback.X,
            Y = fallback.Y,
            Z = fallback.Z,
        }
    end

    return nil
end


function FALLEN_HITFX_SILENT_PART_POS(
    p
)
    if not p then
        return nil
    end

    local part =
        tostring(
            S.silent_target_part
            or "Head"
        )

    if part == "Head" then
        return
            FALLEN_HITFX_PLAYER_HEAD_POS(
                p,
                p.position
            )
    end

    if part == "Torso" then
        if type(fap_find_bone_pos) == "function" then
            local torso =
                fap_find_bone_pos(
                    p,
                    {
                        "UpperTorso",
                        "Torso",
                        "LowerTorso",
                    }
                )

            if torso then
                return torso
            end
        end

        if p.position
            and p.position.X ~= nil
            and p.position.Y ~= nil
            and p.position.Z ~= nil
        then
            return {
                X = p.position.X,
                Y = p.position.Y + 1.2,
                Z = p.position.Z,
            }
        end
    end

    -- The stock Silent target_part index used by this script maps the
    -- "Closest"/third option to Feet.
    if type(fap_find_bone_pos) == "function" then
        local foot =
            fap_find_bone_pos(
                p,
                {
                    "LeftFoot",
                    "RightFoot",
                    "Left Leg",
                    "Right Leg",
                }
            )

        if foot then
            return foot
        end
    end

    if p.position
        and p.position.X ~= nil
        and p.position.Y ~= nil
        and p.position.Z ~= nil
    then
        return {
            X = p.position.X,
            Y = p.position.Y - 2.0,
            Z = p.position.Z,
        }
    end

    return nil
end


function FALLEN_HITFX_SILENT_BIND_DOWN()
    if S.silent_enabled ~= true then
        return false
    end

    local vk =
        math.floor(
            tonumber(S.silent_key)
            or 0
        )

    return
        vk > 0
        and key_down(vk) == true
end


function FALLEN_HITFX_SILENT_VALID_PLAYER(
    p
)
    if not p
        or p.is_self == true
    then
        return false
    end

    local hp =
        tonumber(
            p.health
        )

    if hp == nil
        or hp <= 0
    then
        return false
    end

    if S.silent_team_check == true
        and p.is_teammate == true
    then
        return false
    end

    local max_dist =
        clamp(
            tonumber(S.silent_max_dist)
            or 1200,
            50,
            3000
        )

    local dist =
        tonumber(
            p.distance
        )

    if dist
        and dist > max_dist
    then
        return false
    end

    return
        FALLEN_HITFX_SILENT_PART_POS(p)
        ~= nil
end


function FALLEN_HITFX_SILENT_TARGET()
    if not FALLEN_HITFX_SILENT_BIND_DOWN() then
        A.hitfx_silent_locked_addr =
            nil

        return nil
    end

    if not players
        or type(players.get_all) ~= "function"
    then
        return nil
    end

    local list = nil

    pcall(function()
        list =
            players.get_all()
    end)

    if type(list) ~= "table" then
        return nil
    end

    -- Sticky Aim: keep the same Silent target while its physical bind is held.
    if S.silent_sticky_aim == true
        and A.hitfx_silent_locked_addr
    then
        for _, p in ipairs(list) do
            if p.address
                == A.hitfx_silent_locked_addr
                and FALLEN_HITFX_SILENT_VALID_PLAYER(p)
            then
                local pos =
                    FALLEN_HITFX_SILENT_PART_POS(p)

                if pos
                    and FALLEN_BT_PROJECT(pos)
                then
                    return p
                end
            end
        end

        A.hitfx_silent_locked_addr =
            nil
    end

    local mx, my = nil, nil

    if type(mouse_pos) == "function" then
        pcall(function()
            mx, my =
                mouse_pos()
        end)
    end

    mx =
        tonumber(mx)

    my =
        tonumber(my)

    if not mx
        or not my
    then
        return nil
    end

    local best =
        nil

    local best_sd =
        math.huge

    local use_fov =
        S.silent_fov_enabled == true

    local fov =
        clamp(
            tonumber(S.silent_fov)
            or 180,
            10,
            600
        )

    for _, p in ipairs(list) do
        if FALLEN_HITFX_SILENT_VALID_PLAYER(p) then
            local pos =
                FALLEN_HITFX_SILENT_PART_POS(p)

            local s =
                FALLEN_BT_PROJECT(pos)

            if s then
                local dx =
                    (tonumber(s.X) or 0)
                    - mx

                local dy =
                    (tonumber(s.Y) or 0)
                    - my

                local sd =
                    math.sqrt(
                        dx * dx
                        + dy * dy
                    )

                if (
                        not use_fov
                        or sd <= fov
                    )
                    and sd < best_sd
                then
                    best_sd =
                        sd

                    best =
                        p
                end
            end
        end
    end

    if best
        and S.silent_sticky_aim == true
    then
        A.hitfx_silent_locked_addr =
            best.address
    end

    return best
end


function FALLEN_HITFX_AIMBOT_TARGET()
    if S.aim_enabled ~= true
        or not FAP.current_target_pos
        or tick() - (FAP.current_target_seen or 0) > 0.18
    then
        return nil
    end

    local p =
        FALLEN_HITFX_FIND_PLAYER(
            FAP.current_target_addr,
            FAP.current_target_name
        )

    local hp =
        tonumber(
            FAP.current_target_health
        )

    if hp == nil
        and p
    then
        hp =
            tonumber(
                p.health
            )
    end

    if hp == nil then
        return nil
    end

    local pos = {
        X = FAP.current_target_pos.X,
        Y = FAP.current_target_pos.Y,
        Z = FAP.current_target_pos.Z,
    }

    local head =
        FALLEN_HITFX_PLAYER_HEAD_POS(
            p,
            pos
        )

    local raw_key =
        FAP.current_target_addr
        or FAP.current_target_name

    if raw_key == nil then
        return nil
    end

    return {
        source = "aimbot",
        key =
            "aimbot:"
            .. tostring(raw_key),
        hp = hp,
        pos = pos,
        head_pos = head,
    }
end


function FALLEN_HITFX_SILENT_RESOLVED_TARGET()
    local p =
        FALLEN_HITFX_SILENT_TARGET()

    if not p then
        return nil
    end

    local pos =
        FALLEN_HITFX_SILENT_PART_POS(p)

    local head =
        FALLEN_HITFX_PLAYER_HEAD_POS(
            p,
            pos
        )

    local hp =
        tonumber(
            p.health
        )

    local raw_key =
        p.address
        or p.name
        or p.display_name

    if not pos
        or hp == nil
        or raw_key == nil
    then
        return nil
    end

    return {
        source = "silent",
        key =
            "silent:"
            .. tostring(raw_key),
        hp = hp,
        player = p,
        pos = {
            X = pos.X,
            Y = pos.Y,
            Z = pos.Z,
        },
        head_pos = head,
    }
end


function FALLEN_HITFX_ACTIVE_TARGET()
    -- When Silent's physical HOLD bind is down, its target is authoritative
    -- for hit effects/damage numbers. If it has no valid target, fall back to
    -- the custom Aimbot target so both systems can coexist.
    if FALLEN_HITFX_SILENT_BIND_DOWN() then
        local silent =
            FALLEN_HITFX_SILENT_RESOLVED_TARGET()

        if silent then
            return silent
        end
    end

    return
        FALLEN_HITFX_AIMBOT_TARGET()
end


function FALLEN_HITFX_TARGET_KEY(
    target
)
    return
        target
        and target.key
        or nil
end


function FALLEN_HITFX_ADD(pos)
    if not pos then
        return
    end

    FALLEN_HITFX.items[#FALLEN_HITFX.items + 1] = {
        x = pos.X,
        y = pos.Y,
        z = pos.Z,
        created = tick(),
        seed =
            (#FALLEN_HITFX.items + 1) * 31
            + math.floor(tick() * 1000),
    }

    while #FALLEN_HITFX.items > 25 do
        table.remove(
            FALLEN_HITFX.items,
            1
        )
    end
end

function FALLEN_DMGNUM_SCAN_HP()
    -- Damage Numbers keep the existing HP-drop target logic.
    -- Hit Effect is intentionally NOT triggered here anymore.
    if S.damage_numbers_enabled ~= true then
        FALLEN_HITFX.target_key =
            nil

        FALLEN_HITFX.last_hp =
            nil

        A.hitfx_silent_locked_addr =
            nil

        return
    end

    local target =
        FALLEN_HITFX_ACTIVE_TARGET()

    if not target
        or not target.pos
    then
        FALLEN_HITFX.target_key =
            nil

        FALLEN_HITFX.last_hp =
            nil

        return
    end

    local key =
        FALLEN_HITFX_TARGET_KEY(
            target
        )

    if not key then
        return
    end

    local hp =
        tonumber(
            target.hp
        )

    if hp == nil then
        return
    end

    if FALLEN_HITFX.target_key ~= key then
        FALLEN_HITFX.target_key =
            key

        FALLEN_HITFX.last_hp =
            hp

        FALLEN_HITFX.last_seen =
            tick()

        return
    end

    local old =
        tonumber(
            FALLEN_HITFX.last_hp
        )

    local damage =
        old
        and (old - hp)
        or 0

    if damage >= 15
        and tick() - (FALLEN_HITFX.last_spawn or 0) > 0.008
    then
        FALLEN_HITFX.last_spawn =
            tick()

        FALLEN_DMGNUM_ADD(
            damage,
            target.head_pos,
            target.pos
        )
    end

    FALLEN_HITFX.last_hp =
        hp

    FALLEN_HITFX.last_seen =
        tick()
end


function FALLEN_HITFX_VFX_KIND(
    inst
)
    if not inst
        or not FALLEN_BT_VFX_INSTANCE_VALID(
            inst
        )
    then
        return nil
    end

    local name = nil

    pcall(function()
        name =
            inst:get_name()
    end)

    name =
        string.lower(
            tostring(
                name or ""
            )
        )

    -- Hit Effects are STRICTLY BloodPart-only.
    if name == "bloodpart" then
        return "bloodpart"
    end

    return nil
end


function FALLEN_HITFX_FOV_RADIUS()
    -- Hidden validation FOV.
    if key_down(0x02) == true then
        return 20
    end

    return 40
end


function FALLEN_HITFX_FOV_CENTER()
    local cx, cy =
        nil,
        nil

    if type(crosshair_pos) == "function" then
        pcall(function()
            local c =
                crosshair_pos()

            if c then
                cx =
                    tonumber(
                        c.X
                        or c.x
                        or c[1]
                    )

                cy =
                    tonumber(
                        c.Y
                        or c.y
                        or c[2]
                    )
            end
        end)
    end

    if (
            cx == nil
            or cy == nil
        )
        and type(FALLEN_CUSTOM_FOV_CENTER) == "function"
    then
        pcall(function()
            cx, cy =
                FALLEN_CUSTOM_FOV_CENTER()
        end)
    end

    return
        tonumber(cx),
        tonumber(cy)
end


function FALLEN_HITFX_FOV_CHECK(
    pos
)
    if not pos
        or not aim
        or type(aim.world_to_screen) ~= "function"
    then
        return false, nil
    end

    local screen = nil

    pcall(function()
        screen =
            aim.world_to_screen(
                pos
            )
    end)

    if not screen
        or screen.visible ~= true
        or screen.X == nil
        or screen.Y == nil
    then
        return false, nil
    end

    local cx, cy =
        FALLEN_HITFX_FOV_CENTER()

    if not cx
        or not cy
    then
        return false, nil
    end

    local dx =
        tonumber(screen.X)
        - cx

    local dy =
        tonumber(screen.Y)
        - cy

    local dist_sq =
        dx * dx
        + dy * dy

    local radius =
        FALLEN_HITFX_FOV_RADIUS()

    if dist_sq
        > radius
        * radius
    then
        return false, nil
    end

    return
        true,
        dist_sq
end


function FALLEN_HITFX_CAPTURE_SHOT_VIEW(force)
    local now = tick()

    if force ~= true
        and now - (tonumber(FALLEN_HITFX.vfx_shot_view_last) or 0) < 0.035
    then
        return
    end

    FALLEN_HITFX.vfx_shot_view_last = now

    if not rbx
        or type(rbx.camera) ~= "function"
    then
        return
    end

    local cam = nil
    local cam_pos = nil
    local rot = nil
    local fov = nil

    pcall(function()
        cam = rbx.camera()
        if cam then
            cam_pos = cam:camera_pos()
            rot = cam:camera_rotation()
            fov = cam:camera_fov()
        end
    end)

    if not cam_pos
        or type(rot) ~= "table"
        or #rot < 9
    then
        return
    end

    local dims = nil

    if type(ScreenSize) == "function" then
        pcall(function()
            dims = ScreenSize()
        end)
    end

    if type(dims) ~= "table" then
        return
    end

    local vw = tonumber(dims.Width or dims.width or dims.X or dims.x)
    local vh = tonumber(dims.Height or dims.height or dims.Y or dims.y)

    if not vw or not vh or vw <= 0 or vh <= 0 then
        return
    end

    local cx, cy = FALLEN_HITFX_FOV_CENTER()

    if not cx or not cy then
        cx = vw * 0.5
        cy = vh * 0.5
    end

    fov = tonumber(fov) or math.rad(70)

    if fov > math.pi * 1.25 then
        fov = math.rad(fov)
    end

    fov = clamp(fov, math.rad(20), math.rad(150))

    local snapshot = {
        time = now,
        px = tonumber(cam_pos.X),
        py = tonumber(cam_pos.Y),
        pz = tonumber(cam_pos.Z),
        rx = tonumber(rot[1]),
        ry = tonumber(rot[4]),
        rz = tonumber(rot[7]),
        ux = tonumber(rot[2]),
        uy = tonumber(rot[5]),
        uz = tonumber(rot[8]),
        fx = -tonumber(rot[3]),
        fy = -tonumber(rot[6]),
        fz = -tonumber(rot[9]),
        vw = vw,
        vh = vh,
        cx = tonumber(cx),
        cy = tonumber(cy),
        fov = fov,
        radius = FALLEN_HITFX_FOV_RADIUS(),
    }

    for _, key in ipairs({
        "px", "py", "pz",
        "rx", "ry", "rz",
        "ux", "uy", "uz",
        "fx", "fy", "fz",
        "vw", "vh", "cx", "cy", "fov", "radius",
    }) do
        if snapshot[key] == nil then
            return
        end
    end

    local list = FALLEN_HITFX.vfx_shot_views
    list[#list + 1] = snapshot

    for i = #list, 1, -1 do
        if now - (tonumber(list[i].time) or 0) > 1.05 then
            table.remove(list, i)
        end
    end

    while #list > 32 do
        table.remove(list, 1)
    end
end

function FALLEN_HITFX_FOV_CHECK_SNAPSHOT(pos, snapshot)
    if not pos or type(snapshot) ~= "table" then
        return false, nil
    end

    local dx = tonumber(pos.X) - tonumber(snapshot.px)
    local dy = tonumber(pos.Y) - tonumber(snapshot.py)
    local dz = tonumber(pos.Z) - tonumber(snapshot.pz)

    if not dx or not dy or not dz then
        return false, nil
    end

    local local_x = dx * snapshot.rx + dy * snapshot.ry + dz * snapshot.rz
    local local_y = dx * snapshot.ux + dy * snapshot.uy + dz * snapshot.uz
    local local_z = dx * snapshot.fx + dy * snapshot.fy + dz * snapshot.fz

    if local_z <= 0.001 then
        return false, nil
    end

    local focal = snapshot.vh / (2 * math.tan(snapshot.fov * 0.5))
    if focal <= 0 then
        return false, nil
    end

    local sx = snapshot.vw * 0.5 + (local_x / local_z) * focal
    local sy = snapshot.vh * 0.5 - (local_y / local_z) * focal
    local ddx = sx - snapshot.cx
    local ddy = sy - snapshot.cy
    local dist_sq = ddx * ddx + ddy * ddy
    local radius = tonumber(snapshot.radius) or 40

    return dist_sq <= radius * radius, dist_sq
end

function FALLEN_HITFX_FOV_CHECK_SHOT_VIEWS(pos, max_age)
    local list = FALLEN_HITFX.vfx_shot_views

    if type(list) ~= "table" or #list == 0 then
        return false, nil
    end

    local now = tick()
    local age_limit = tonumber(max_age) or 1.00
    local best_dist_sq = nil

    for i = #list, 1, -1 do
        local snapshot = list[i]
        local age = now - (tonumber(snapshot.time) or 0)

        if age <= age_limit then
            local ok, dist_sq = FALLEN_HITFX_FOV_CHECK_SNAPSHOT(pos, snapshot)

            if ok then
                return true, dist_sq
            end

            if dist_sq ~= nil and (best_dist_sq == nil or dist_sq < best_dist_sq) then
                best_dist_sq = dist_sq
            end
        end
    end

    return false, best_dist_sq
end

function FALLEN_HITFX_FIND_NEW_IMPACT(
    previous,
    current,
    shot_age
)
    if type(current) ~= "table" then
        return nil
    end

    previous =
        type(previous) == "table"
        and previous
        or {}

    shot_age =
        tonumber(shot_age)
        or 999

    local best_pos =
        nil

    local best_screen_dist_sq =
        nil

    for key, inst in pairs(current) do
        if previous[key] == nil then
            local kind =
                FALLEN_HITFX_VFX_KIND(
                    inst
                )

            local allowed =
                kind == "bloodpart"
                and shot_age <= 1.00

            if allowed then
                local pos =
                    FALLEN_BT_VFX_POSITION(
                        inst
                    )

                if pos then
                    local inside, screen_dist_sq =
                        FALLEN_HITFX_FOV_CHECK_SHOT_VIEWS(
                            pos,
                            1.00
                        )

                    if inside
                        and screen_dist_sq ~= nil
                        and (
                            best_screen_dist_sq == nil
                            or screen_dist_sq < best_screen_dist_sq
                        )
                    then
                        best_screen_dist_sq =
                            screen_dist_sq

                        best_pos = {
                            X = pos.X,
                            Y = pos.Y,
                            Z = pos.Z,
                        }
                    end
                end
            end
        end
    end

    return best_pos
end


function FALLEN_HITFX_VFX_TICK()
    if S.hit_effect_enabled ~= true then
        FALLEN_HITFX.vfx_seen =
            {}

        FALLEN_HITFX.vfx_prev_lmb =
            false

        FALLEN_HITFX.vfx_watch_until =
            0

        FALLEN_HITFX.vfx_shot_time =
            nil

        FALLEN_HITFX.vfx_shot_views = {}
        FALLEN_HITFX.vfx_shot_view_last = 0

        return
    end

    if not FALLEN_BT_WEAPON_READY() then
        FALLEN_HITFX.vfx_seen =
            {}

        FALLEN_HITFX.vfx_prev_lmb =
            false

        FALLEN_HITFX.vfx_watch_until =
            0

        FALLEN_HITFX.vfx_shot_time =
            nil

        FALLEN_HITFX.vfx_shot_views = {}
        FALLEN_HITFX.vfx_shot_view_last = 0

        return
    end

    local now =
        tick()

    local lmb =
        key_down(0x01)
        == true

    if not lmb
        and now
            >= (
                tonumber(
                    FALLEN_HITFX.vfx_watch_until
                )
                or 0
            )
    then
        FALLEN_HITFX.vfx_seen =
            FALLEN_BT_VFX_SCAN()

        FALLEN_HITFX.vfx_prev_lmb =
            false

        FALLEN_HITFX.vfx_shot_time =
            nil

        FALLEN_HITFX.vfx_shot_views = {}
        FALLEN_HITFX.vfx_shot_view_last = 0

        return
    end

    if lmb
        and FALLEN_HITFX.vfx_prev_lmb ~= true
    then
        FALLEN_HITFX.vfx_shot_time =
            now

        -- BloodPart-only hit window.
        FALLEN_HITFX.vfx_watch_until =
            now + 1.00

        -- Save the exact shot-time view like Bullet Tracer does.
        FALLEN_HITFX_CAPTURE_SHOT_VIEW(true)

    elseif lmb then
        -- Automatic fire: keep the BloodPart window fresh while firing.
        FALLEN_HITFX.vfx_shot_time =
            now

        FALLEN_HITFX.vfx_watch_until =
            now + 1.00

        FALLEN_HITFX_CAPTURE_SHOT_VIEW(false)
    end

    FALLEN_HITFX.vfx_prev_lmb =
        lmb

    if not lmb
        and now
            > (
                tonumber(
                    FALLEN_HITFX.vfx_watch_until
                )
                or 0
            )
    then
        return
    end

    local previous =
        FALLEN_HITFX.vfx_seen
        or {}

    local current =
        FALLEN_BT_VFX_SCAN()

    local shot_age =
        now
        - (
            tonumber(
                FALLEN_HITFX.vfx_shot_time
            )
            or now
        )

    local impact_pos =
        FALLEN_HITFX_FIND_NEW_IMPACT(
            previous,
            current,
            shot_age
        )

    FALLEN_HITFX.vfx_seen =
        current

    if not impact_pos then
        return
    end

    FALLEN_HITFX_ADD(
        impact_pos
    )
end


function FALLEN_HITFX_WORLD_PIXEL_SIZE(hit, kind)
    if not hit then
        return 48
    end

    local base = {
        X = hit.x,
        Y = hit.y,
        Z = hit.z,
    }

    local world_size = 4.0
    if kind == 1
        or kind == 4
        or kind == 5
        or kind == 6
        or kind == 7
    then
        -- Spark-sized world footprint.
        world_size = 8.0
    elseif kind == 2 then
        -- fallen_ultimate SmokeRing Size = 4
        world_size = 4.0
    elseif kind == 3 then
        -- fallen_ultimate particles.js Size = 3
        world_size = 3.0
    end

    local a = FALLEN_BT_PROJECT(base)
    local b = FALLEN_BT_PROJECT({
        X = hit.x,
        Y = hit.y + world_size,
        Z = hit.z,
    })

    if a and b then
        local dx = (b.X or 0) - (a.X or 0)
        local dy = (b.Y or 0) - (a.Y or 0)
        local px = math.sqrt(dx * dx + dy * dy)

        -- Preserve world-space perspective, but keep the effect practical
        -- on screen at extreme near/far distances.
        if kind == 1
            or kind == 4
            or kind == 5
            or kind == 6
            or kind == 7
        then
            return clamp(px, 34, 220)
        elseif kind == 2 then
            return clamp(px, 28, 170)
        else
            return clamp(px, 24, 145)
        end
    end

    -- Fallback only if the offset point cannot be projected.
    if kind == 1
        or kind == 4
        or kind == 5
        or kind == 6
        or kind == 7
    then
        return 86
    elseif kind == 2 then
        return 64
    end

    return 58
end

function FALLEN_HITFX_DRAW_ONE(hit, age, life)
    local s =
        FALLEN_BT_PROJECT({
            X = hit.x,
            Y = hit.y,
            Z = hit.z,
        })

    if not s then
        return
    end

    local t =
        clamp(
            age / life,
            0,
            1
        )

    local alpha =
        1 - t

    -- Match fallen_ultimate's WORLD-space particle sizing instead of fixed
    -- screen pixels. Near hits render larger; far hits render smaller.
    local kind = FALLEN_HITFX_STYLE_INDEX()
    local size = FALLEN_HITFX_WORLD_PIXEL_SIZE(hit, kind)

    -- User scale for every hit effect. Default is intentionally smaller
    -- than the previous build.
    size =
        size
        * clamp(
            tonumber(S.hit_effect_size) or 0.65,
            0.25,
            1.50
        )

    FALLEN_HITFX_DRAW_FALLEN(
        kind,
        s.X,
        s.Y,
        size,
        t,
        alpha,
        { 1, 1, 1, 1 },
        hit.seed
    )
end

function FALLEN_HITFX_DRAW()
    if type(FALLEN_HITFX.items) ~= "table" then
        FALLEN_HITFX.items = {}
    end

    local now = tick()

    FALLEN_HITFX_STYLE_INDEX()

    local kind = FALLEN_HITFX_STYLE_INDEX()
    local life = 1.0

    if kind == 1 then
        life = 0.55
    elseif kind == 2 then
        life = 1.0
    elseif kind == 3 then
        life = 1.0
    end

    for i = #FALLEN_HITFX.items, 1, -1 do
        local hit =
            FALLEN_HITFX.items[i]

        local age =
            now - (hit.created or now)

        if age > life
            or S.hit_effect_enabled ~= true
        then
            table.remove(
                FALLEN_HITFX.items,
                i
            )
        else
            FALLEN_HITFX_DRAW_ONE(
                hit,
                age,
                life
            )
        end
    end
end

function FALLEN_HITFX_TICK()
    if _G.FallenMenuReady ~= true then
        return
    end

    S.damage_numbers_enabled = false
    S.world_rain_enabled = false
    S.world_thunder_enabled = false

    FALLEN_HITFX_VFX_TICK()
    FALLEN_HITFX_DRAW()
end

hooks.on_render(function()
    local ok, err =
        pcall(
            FALLEN_BT_TICK
        )

    pcall(
        FALLEN_HITFX_TICK
    )

    if not ok then
        FALLEN_BT =
            FALLEN_BT
            or {}

        FALLEN_BT.last_error =
            tonumber(
                FALLEN_BT.last_error
            )
            or 0

        if tick() - FALLEN_BT.last_error > 2 then
            FALLEN_BT.last_error = tick()

            if type(warn) == "function" then
                warn(
                    SYS
                    .. "Bullet Tracer: "
                    .. tostring(err)
                )
            end
        end
    end
end)

