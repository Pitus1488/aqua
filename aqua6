function FALLEN_AVATAR_EDITOR_CLEAN_PATH(path)
    if type(path) ~= "string" then
        return nil
    end

    path =
        string.gsub(
            path,
            "[\r\n]+",
            ""
        )

    path =
        string.gsub(
            path,
            "^%s+",
            ""
        )

    path =
        string.gsub(
            path,
            "%s+$",
            ""
        )

    path =
        string.gsub(
            path,
            '^"',
            ""
        )

    path =
        string.gsub(
            path,
            '"$',
            ""
        )

    if path == "" then
        return nil
    end

    return path
end

function FALLEN_AVATAR_EDITOR_FILENAME(path)
    path =
        tostring(
            path
            or ""
        )

    local name =
        string.match(
            path,
            "([^\\/]+)$"
        )

    return
        name
        or path
        or ""
end

function FALLEN_AVATAR_EDITOR_PATH_SUPPORTED(path)
    local p =
        string.lower(
            tostring(
                path
                or ""
            )
        )

    return
        string.match(p, "%.png$")
        or string.match(p, "%.jpg$")
        or string.match(p, "%.jpeg$")
        or string.match(p, "%.bmp$")
        or string.match(p, "%.gif$")
        or string.match(p, "%.tga$")
end

function FALLEN_AVATAR_EDITOR_UNLOAD_CANDIDATE()
    local h =
        A.avatar_editor_candidate_handle

    if not h then
        return
    end

    if Drawing
        and type(Drawing.UnloadImage) == "function"
    then
        pcall(
            Drawing.UnloadImage,
            h
        )
    end

    A.avatar_editor_candidate_handle = nil
    A.avatar_editor_candidate_path = nil
end

function FALLEN_AVATAR_EDITOR_LOAD_PATH(path)
    path =
        FALLEN_AVATAR_EDITOR_CLEAN_PATH(
            path
        )

    if not path then
        A.avatar_editor_status =
            "No file selected"
        return false
    end

    if not FALLEN_AVATAR_EDITOR_PATH_SUPPORTED(
        path
    ) then
        A.avatar_editor_status =
            "Unsupported image format"
        return false
    end

    if type(exists_file) == "function" then
        local ok_exists, exists =
            pcall(
                exists_file,
                path
            )

        if not ok_exists
            or exists ~= true
        then
            A.avatar_editor_status =
                "File not found"
            return false
        end
    end

    local handle = nil

    pcall(function()
        if Drawing
            and type(Drawing.LoadImageFromFile) == "function"
        then
            handle =
                Drawing.LoadImageFromFile(
                    path
                )
        elseif type(LoadImage) == "function" then
            handle =
                LoadImage(
                    path
                )
        end
    end)

    if not handle then
        A.avatar_editor_status =
            "Could not load image"
        return false
    end

    FALLEN_AVATAR_EDITOR_UNLOAD_CANDIDATE()

    A.avatar_editor_candidate_handle =
        handle

    A.avatar_editor_candidate_path =
        path

    A.avatar_editor_status =
        FALLEN_AVATAR_EDITOR_FILENAME(
            path
        )

    return true
end

function FALLEN_AVATAR_EDITOR_FOLDER()
    FALLEN_CUSTOM_AVATAR_ENSURE_FOLDER()

    return
        "C:\\blueberry\\scripts\\avatar\\"
end

function FALLEN_AVATAR_EDITOR_IS_INTERNAL_IMAGE(path)
    local name =
        string.lower(
            FALLEN_AVATAR_EDITOR_FILENAME(
                path
            )
        )

    return
        name == "avatar_saved.bmp"
        or string.match(
            name,
            "^avatar_crop_preview_"
        ) ~= nil
end

function FALLEN_AVATAR_EDITOR_ACCEPT_IMAGE_PATH(path)
    path =
        FALLEN_AVATAR_EDITOR_CLEAN_PATH(
            path
        )

    if not path
        or not FALLEN_AVATAR_EDITOR_PATH_SUPPORTED(path)
        or FALLEN_AVATAR_EDITOR_IS_INTERNAL_IMAGE(path)
    then
        return nil
    end

    if type(exists_file) == "function" then
        local ok, exists =
            pcall(
                exists_file,
                path
            )

        if not ok
            or exists ~= true
        then
            return nil
        end
    end

    return path
end

function FALLEN_AVATAR_EDITOR_TABLE_FIND_IMAGE(list, base)
    if type(list) ~= "table" then
        return nil
    end

    for _, value in pairs(list) do
        local path = nil

        if type(value) == "string" then
            path = value
        elseif type(value) == "table" then
            path =
                value.path
                or value.Path
                or value.file
                or value.File
                or value.name
                or value.Name
                or value[1]
        end

        if type(path) == "string" then
            if not string.find(path, "[\\/]", 1) then
                path =
                    base
                    .. path
            end

            path =
                FALLEN_AVATAR_EDITOR_ACCEPT_IMAGE_PATH(
                    path
                )

            if path then
                return path
            end
        end
    end

    return nil
end

function FALLEN_AVATAR_EDITOR_FIND_FOLDER_IMAGE()
    local base =
        FALLEN_AVATAR_EDITOR_FOLDER()

    -- Prefer a real directory-listing API if this Blueberry build has one.
    local probes = {}

    if type(list_files) == "function" then
        probes[#probes + 1] = {
            fn = list_files,
            owner = nil,
        }
    end

    if type(get_files) == "function" then
        probes[#probes + 1] = {
            fn = get_files,
            owner = nil,
        }
    end

    if filesystem then
        if type(filesystem.list_files) == "function" then
            probes[#probes + 1] = {
                fn = filesystem.list_files,
                owner = filesystem,
            }
        end

        if type(filesystem.list) == "function" then
            probes[#probes + 1] = {
                fn = filesystem.list,
                owner = filesystem,
            }
        end
    end

    if fs then
        if type(fs.list_files) == "function" then
            probes[#probes + 1] = {
                fn = fs.list_files,
                owner = fs,
            }
        end

        if type(fs.list) == "function" then
            probes[#probes + 1] = {
                fn = fs.list,
                owner = fs,
            }
        end
    end

    for _, probe in ipairs(probes) do
        local ok, list = false, nil

        if probe.owner then
            ok, list =
                pcall(
                    probe.fn,
                    probe.owner,
                    base
                )

            if not ok then
                ok, list =
                    pcall(
                        probe.fn,
                        base
                    )
            end
        else
            ok, list =
                pcall(
                    probe.fn,
                    base
                )
        end

        if ok then
            local path =
                FALLEN_AVATAR_EDITOR_TABLE_FIND_IMAGE(
                    list,
                    base
                )

            if path then
                return path
            end
        end
    end

    -- Lightweight Windows fallback: enumerate names only when Reload Image
    -- is pressed. Nothing is launched when the editor itself opens.
    if type(write_file) == "function"
        and type(read_file) == "function"
        and os
        and type(os.execute) == "function"
    then
        local list_path =
            base
            .. "avatar_file_list.txt"

        local cmd_path =
            base
            .. "avatar_file_list.cmd"

        local command =
            "@echo off\r\n"
            .. "dir /b /a-d /o-d \""
            .. base
            .. "\" > \""
            .. list_path
            .. "\"\r\n"

        local ok_cmd =
            pcall(
                write_file,
                cmd_path,
                command
            )

        if ok_cmd then
            pcall(
                os.execute,
                'cmd.exe /c "'
                .. cmd_path
                .. '"'
            )

            local ok_list, raw =
                pcall(
                    read_file,
                    list_path
                )

            if ok_list
                and type(raw) == "string"
            then
                for name in string.gmatch(
                    raw,
                    "[^\r\n]+"
                ) do
                    local path =
                        FALLEN_AVATAR_EDITOR_ACCEPT_IMAGE_PATH(
                            base
                            .. name
                        )

                    if path then
                        return path
                    end
                end
            end
        end
    end

    -- Last fallback: previously selected arbitrary path.
    if type(read_file) == "function" then
        local ok_saved, saved =
            pcall(
                read_file,
                base
                .. "SELECTED_PATH.txt"
            )

        if ok_saved
            and type(saved) == "string"
        then
            local path =
                FALLEN_AVATAR_EDITOR_ACCEPT_IMAGE_PATH(
                    saved
                )

            if path then
                return path
            end
        end
    end

    -- Legacy common names are still supported.
    local names = {
        "avatar.png",
        "avatar.jpg",
        "avatar.jpeg",
        "avatar.bmp",
        "avatar.gif",
        "avatar.tga",
        "profile.png",
        "profile.jpg",
        "pfp.png",
        "pfp.jpg",
        "image.png",
        "image.jpg",
    }

    for _, name in ipairs(names) do
        local path =
            FALLEN_AVATAR_EDITOR_ACCEPT_IMAGE_PATH(
                base
                .. name
            )

        if path then
            return path
        end
    end

    return nil
end

function FALLEN_AVATAR_EDITOR_RELOAD_PREVIEW()
    local path =
        FALLEN_AVATAR_EDITOR_FIND_FOLDER_IMAGE()

    if not path then
        A.avatar_editor_status =
            "No image found in the avatar folder"

        return false
    end

    local ok =
        FALLEN_AVATAR_EDITOR_LOAD_PATH(
            path
        )

    if ok then
        -- Like Discord: a freshly selected image starts centered at 1x.
        S.avatar_crop_zoom = 1
        S.avatar_crop_pan_x = 0
        S.avatar_crop_pan_y = 0

        A.avatar_editor_status =
            "Loaded: "
            .. FALLEN_AVATAR_EDITOR_FILENAME(
                path
            )
    end

    return ok
end

function FALLEN_AVATAR_EDITOR_COPY_FOLDER_PATH()
    local path =
        FALLEN_AVATAR_EDITOR_FOLDER()

    if type(set_clipboard) == "function" then
        local ok =
            pcall(
                set_clipboard,
                path
            )

        if ok then
            A.avatar_editor_status =
                "Folder path copied to clipboard"

            return true
        end
    end

    A.avatar_editor_status =
        path

    return false
end

function FALLEN_AVATAR_EDITOR_OPEN_FOLDER()
    local path =
        FALLEN_AVATAR_EDITOR_FOLDER()

    local opened = false

    -- Probe common host APIs without depending on one specific Blueberry build.
    if Windows then
        if not opened
            and type(Windows.OpenFolder) == "function"
        then
            local ok =
                pcall(
                    Windows.OpenFolder,
                    Windows,
                    path
                )

            if not ok then
                ok =
                    pcall(
                        Windows.OpenFolder,
                        path
                    )
            end

            opened = ok == true
        end

        if not opened
            and type(Windows.OpenPath) == "function"
        then
            local ok =
                pcall(
                    Windows.OpenPath,
                    Windows,
                    path
                )

            if not ok then
                ok =
                    pcall(
                        Windows.OpenPath,
                        path
                    )
            end

            opened = ok == true
        end

        if not opened
            and type(Windows.ShellExecute) == "function"
        then
            local ok =
                pcall(
                    Windows.ShellExecute,
                    Windows,
                    "open",
                    path
                )

            if not ok then
                ok =
                    pcall(
                        Windows.ShellExecute,
                        Windows,
                        path
                    )
            end

            if not ok then
                ok =
                    pcall(
                        Windows.ShellExecute,
                        path
                    )
            end

            opened = ok == true
        end
    end

    if not opened
        and type(open_folder) == "function"
    then
        opened =
            pcall(
                open_folder,
                path
            )
    end

    if not opened
        and type(open_path) == "function"
    then
        opened =
            pcall(
                open_path,
                path
            )
    end

    if not opened
        and type(shell_execute) == "function"
    then
        local ok =
            pcall(
                shell_execute,
                "open",
                path
            )

        if not ok then
            ok =
                pcall(
                    shell_execute,
                    path
                )
        end

        opened = ok == true
    end

    if not opened
        and os
        and type(os.execute) == "function"
    then
        local command =
            'explorer.exe "'
            .. path
            .. '"'

        local ok =
            pcall(
                os.execute,
                command
            )

        opened = ok == true
    end

    if opened then
        A.avatar_editor_status =
            "Avatar folder opened"

        return true
    end

    -- Last fallback: make the exact folder path easy to use.
    FALLEN_AVATAR_EDITOR_COPY_FOLDER_PATH()

    return false
end

function FALLEN_AVATAR_DRAW_CROP_VIEW(
    handle,
    x,
    y,
    size,
    zoom,
    pan_x,
    pan_y,
    mask_color,
    circle_clip
)
    if not handle
        or type(DrawImage) ~= "function"
    then
        return false
    end

    local ready = true

    if type(IsImageReady) == "function" then
        local ok_ready, is_ready =
            pcall(
                IsImageReady,
                handle
            )

        ready =
            ok_ready
            and is_ready == true
    end

    if not ready then
        return false
    end

    zoom =
        clamp(
            tonumber(zoom) or 1,
            1,
            5.0
        )

    pan_x =
        clamp(
            tonumber(pan_x) or 0,
            -1,
            1
        )

    pan_y =
        clamp(
            tonumber(pan_y) or 0,
            -1,
            1
        )

    -- DrawImage supports an optional UV rectangle after the rounding value:
    -- handle,x,y,w,h,r,g,b,a,rounding,u0,v0,u1,v1
    --
    -- Crop the texture itself instead of drawing a giant moving image.
    -- Because destination x/y/w/h NEVER change, pixels physically cannot
    -- escape the preview/avatar rectangle.
    local span =
        1.0 / zoom

    local travel =
        1.0 - span

    -- Positive pan means the image itself was dragged right/down,
    -- so the source window moves left/up.
    local u0 =
        travel * 0.5
        - pan_x * travel * 0.5

    local v0 =
        travel * 0.5
        - pan_y * travel * 0.5

    u0 =
        clamp(
            u0,
            0,
            1 - span
        )

    v0 =
        clamp(
            v0,
            0,
            1 - span
        )

    local u1 =
        u0 + span

    local v1 =
        v0 + span

    local rounding =
        circle_clip
        and FALLEN_UI_LEN(size * 0.5)
        or 0

    local ok_draw =
        pcall(
            DrawImage,
            handle,
            FALLEN_UI_X(x),
            FALLEN_UI_Y(y),
            FALLEN_UI_LEN(size),
            FALLEN_UI_LEN(size),
            1,
            1,
            1,
            MENU_RENDER_ALPHA,
            rounding,
            u0,
            v0,
            u1,
            v1
        )

    if ok_draw then
        return true
    end

    -- Compatibility fallback for an older DrawImage build.
    -- It stays safely inside the viewport; zoom requires UV support.
    return
        pcall(
            DrawImage,
            handle,
            FALLEN_UI_X(x),
            FALLEN_UI_Y(y),
            FALLEN_UI_LEN(size),
            FALLEN_UI_LEN(size),
            1,
            1,
            1,
            MENU_RENDER_ALPHA,
            rounding
        ) == true
end

function FALLEN_AVATAR_MASK_OUTSIDE_CIRCLE_RADIUS(
    x,
    y,
    size,
    radius,
    color
)
    radius =
        clamp(
            tonumber(radius) or (size * 0.5),
            0,
            size * 0.5
        )

    color = color or { 0, 0, 0, 1 }

    local step = 1
    local yy = 0

    while yy < size do
        local row_h =
            math.min(
                step,
                size - yy
            )

        local sample_y =
            yy + row_h * 0.5

        local dy =
            sample_y - size * 0.5

        local inside =
            radius * radius - dy * dy

        if inside > 0 then
            local half = math.sqrt(inside)
            local side = math.ceil(
                math.max(
                    0,
                    size * 0.5 - half
                )
            )

            if side > 0 then
                fill(
                    x,
                    y + yy,
                    side,
                    row_h,
                    color
                )

                fill(
                    x + size - side,
                    y + yy,
                    side,
                    row_h,
                    color
                )
            end
        else
            fill(
                x,
                y + yy,
                size,
                row_h,
                color
            )
        end

        yy = yy + step
    end
end

function FALLEN_AVATAR_DIM_OUTSIDE_CIRCLE(
    x,
    y,
    size,
    radius
)
    FALLEN_AVATAR_MASK_OUTSIDE_CIRCLE_RADIUS(
        x,
        y,
        size,
        radius or (size * 0.5),
        { 0, 0, 0, 0.40 }
    )
end

function FALLEN_AVATAR_EDITOR_SOURCE_PATH()
    if A.avatar_editor_candidate_path
        and not string.find(
            string.lower(A.avatar_editor_candidate_path),
            "avatar_saved_circle.png",
            1,
            true
        )
    then
        return A.avatar_editor_candidate_path
    end

    local base =
        FALLEN_AVATAR_EDITOR_FOLDER()

    if type(read_file) == "function" then
        local ok, raw =
            pcall(
                read_file,
                base .. "SELECTED_SOURCE.txt"
            )

        if ok
            and type(raw) == "string"
        then
            local path =
                FALLEN_AVATAR_EDITOR_CLEAN_PATH(
                    raw
                )

            if path
                and FALLEN_AVATAR_EDITOR_PATH_SUPPORTED(path)
            then
                if type(exists_file) ~= "function" then
                    return path
                end

                local ok_exists, exists =
                    pcall(
                        exists_file,
                        path
                    )

                if ok_exists
                    and exists == true
                then
                    return path
                end
            end
        end
    end

    local path =
        FALLEN_AVATAR_EDITOR_FIND_FOLDER_IMAGE()

    return path
end

function FALLEN_AVATAR_EDITOR_LOAD_ORIGINAL_SOURCE()
    local path =
        FALLEN_AVATAR_EDITOR_SOURCE_PATH()

    if not path then
        return false
    end

    return
        FALLEN_AVATAR_EDITOR_LOAD_PATH(
            path
        )
end

function FALLEN_AVATAR_EDITOR_WRITE_CIRCLE_WORKER()
    if type(write_file) ~= "function" then
        return nil
    end

    local path =
        FALLEN_AVATAR_EDITOR_FOLDER()
        .. "avatar_circle_crop.ps1"

    local script = [=[
param(
    [Parameter(Mandatory=$true)][string]$Source,
    [Parameter(Mandatory=$true)][string]$Output,
    [double]$Zoom = 1.0,
    [double]$PanX = 0.0,
    [double]$PanY = 0.0
)

$ErrorActionPreference = "Stop"
Add-Type -AssemblyName System.Drawing

$loaded = [System.Drawing.Image]::FromFile($Source)
$image = New-Object System.Drawing.Bitmap($loaded)
$loaded.Dispose()

$w = [double]$image.Width
$h = [double]$image.Height

if ($w -le 0 -or $h -le 0) {
    throw "Invalid source image"
}

$Zoom = [Math]::Max(1.0, [Math]::Min(5.0, $Zoom))
$PanX = [Math]::Max(-1.0, [Math]::Min(1.0, $PanX))
$PanY = [Math]::Max(-1.0, [Math]::Min(1.0, $PanY))

# Discord-like square crop: preserve aspect ratio, then zoom into it.
$base = [Math]::Min($w, $h)
$crop = $base / $Zoom

$travelX = [Math]::Max(0.0, ($w - $crop) * 0.5)
$travelY = [Math]::Max(0.0, ($h - $crop) * 0.5)

$centerX = ($w * 0.5) + ($PanX * $travelX)
$centerY = ($h * 0.5) + ($PanY * $travelY)

$srcX = $centerX - ($crop * 0.5)
$srcY = $centerY - ($crop * 0.5)

$srcX = [Math]::Max(0.0, [Math]::Min($w - $crop, $srcX))
$srcY = [Math]::Max(0.0, [Math]::Min($h - $crop, $srcY))

$outSize = 320
$bitmap = New-Object System.Drawing.Bitmap(
    $outSize,
    $outSize,
    [System.Drawing.Imaging.PixelFormat]::Format32bppArgb
)

$graphics = [System.Drawing.Graphics]::FromImage($bitmap)
$graphics.Clear([System.Drawing.Color]::Transparent)

$graphics.CompositingMode =
    [System.Drawing.Drawing2D.CompositingMode]::SourceOver
$graphics.CompositingQuality =
    [System.Drawing.Drawing2D.CompositingQuality]::HighQuality
$graphics.InterpolationMode =
    [System.Drawing.Drawing2D.InterpolationMode]::HighQualityBicubic
$graphics.SmoothingMode =
    [System.Drawing.Drawing2D.SmoothingMode]::AntiAlias
$graphics.PixelOffsetMode =
    [System.Drawing.Drawing2D.PixelOffsetMode]::HighQuality

# Actual circular clip. Pixels outside this ellipse stay transparent.
$path = New-Object System.Drawing.Drawing2D.GraphicsPath
$path.AddEllipse(0, 0, $outSize - 1, $outSize - 1)
$graphics.SetClip($path)

$destRect = New-Object System.Drawing.RectangleF(
    0,
    0,
    $outSize,
    $outSize
)

$srcRect = New-Object System.Drawing.RectangleF(
    [single]$srcX,
    [single]$srcY,
    [single]$crop,
    [single]$crop
)

$graphics.DrawImage(
    $image,
    $destRect,
    $srcRect,
    [System.Drawing.GraphicsUnit]::Pixel
)

$graphics.ResetClip()
$path.Dispose()
$graphics.Dispose()
$image.Dispose()

$bitmap.Save(
    $Output,
    [System.Drawing.Imaging.ImageFormat]::Png
)
$bitmap.Dispose()
]=]

    local ok =
        pcall(
            write_file,
            path,
            script
        )

    if ok then
        return path
    end

    return nil
end

function FALLEN_AVATAR_EDITOR_RENDER_FINAL_CIRCLE()
    local source =
        FALLEN_AVATAR_EDITOR_SOURCE_PATH()

    if not source then
        A.avatar_editor_status =
            "No source image loaded"
        return nil
    end

    if not os
        or type(os.execute) ~= "function"
    then
        A.avatar_editor_status =
            "Crop renderer unavailable"
        return nil
    end

    local worker =
        FALLEN_AVATAR_EDITOR_WRITE_CIRCLE_WORKER()

    if not worker then
        A.avatar_editor_status =
            "Could not create crop renderer"
        return nil
    end

    local output =
        FALLEN_AVATAR_EDITOR_FOLDER()
        .. "avatar_saved_circle.png"

    local zoom =
        clamp(
            tonumber(S.avatar_crop_zoom) or 1,
            1,
            5.0
        )

    local pan_x =
        clamp(
            tonumber(S.avatar_crop_pan_x) or 0,
            -1,
            1
        )

    local pan_y =
        clamp(
            tonumber(S.avatar_crop_pan_y) or 0,
            -1,
            1
        )

    local command =
        'powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "'
        .. worker
        .. '" -Source "'
        .. source
        .. '" -Output "'
        .. output
        .. '" -Zoom '
        .. string.format("%.5f", zoom)
        .. ' -PanX '
        .. string.format("%.5f", pan_x)
        .. ' -PanY '
        .. string.format("%.5f", pan_y)

    local ok_exec =
        pcall(
            os.execute,
            command
        )

    if not ok_exec then
        A.avatar_editor_status =
            "Could not render avatar"
        return nil
    end

    if type(exists_file) == "function" then
        local ok_exists, exists =
            pcall(
                exists_file,
                output
            )

        if not ok_exists
            or exists ~= true
        then
            A.avatar_editor_status =
                "Avatar render failed"
            return nil
        end
    end

    if type(write_file) == "function" then
        pcall(
            write_file,
            FALLEN_AVATAR_EDITOR_FOLDER()
                .. "SELECTED_SOURCE.txt",
            source
        )

        pcall(
            write_file,
            FALLEN_AVATAR_EDITOR_FOLDER()
                .. "SELECTED_PATH.txt",
            output
        )
    end

    return output
end

function FALLEN_AVATAR_EDITOR_OPEN()
    A.avatar_editor_open = true

    A.avatar_editor_original_zoom =
        tonumber(S.avatar_crop_zoom)
        or 1

    A.avatar_editor_original_pan_x =
        tonumber(S.avatar_crop_pan_x)
        or 0

    A.avatar_editor_original_pan_y =
        tonumber(S.avatar_crop_pan_y)
        or 0

    A.avatar_editor_status =
        "Drag image to position it. Use Zoom below."

    FALLEN_AVATAR_EDITOR_UNLOAD_CANDIDATE()
    FALLEN_AVATAR_EDITOR_LOAD_ORIGINAL_SOURCE()

    A.avatar_editor_dragging = false
    A.active_slider = nil
    numeric_stop(true)
    FALLEN_COLOR_INPUT_STOP(true)

    A.config_open = false
    A.menu_settings_open = false
