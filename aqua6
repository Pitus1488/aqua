function FALLEN_DRAW_ROUNDED_GLOW_FRAME(
    x,
    y,
    w,
    h,
    radius,
    color,
    thickness
)
    -- Do not construct the glow from lines/arcs.
    -- A line-based perimeter can rasterize different joins on different
    -- sides and leave single-pixel holes.
    --
    -- Instead every glow level is one COMPLETE rounded surface.
    -- The caller expands every level equally:
    --   x - i, y - i, w + i*2, h + i*2, radius + i
    -- so spacing is exactly symmetric on left/right/top/bottom and corners.
    --
    -- The actual menu/panel is drawn afterwards, covering the interior.
    -- Therefore only the outside part of these complete surfaces is visible.
    rounded_fill(
        x,
        y,
        w,
        h,
        radius,
        color
