function FALLEN_BT_VFX_SCAN()
    local root =
        FALLEN_BT_VFX_ROOT()

    if not root then
        return {}
    end

    local out = {}
    local queue = {
        root,
    }

    local qi =
        1

    -- Pure instance-tree walk. No raw memory/pointers.
    while qi <= #queue do
        local inst =
            queue[qi]

        qi =
            qi + 1

        if FALLEN_BT_VFX_INSTANCE_VALID(
            inst
        )
        then
            local addr =
                inst.addr

            if addr
                and addr ~= 0
            then
                out[
                    tostring(addr)
                ] =
                    inst
            end

            local children = nil

            pcall(function()
                children =
                    inst:get_children()
            end)

            if type(children) == "table" then
                for _, child in ipairs(children) do
                    if FALLEN_BT_VFX_INSTANCE_VALID(
                        child
                    )
                    then
                        queue[#queue + 1] =
                            child
                    end
                end
            end
        end
    end

    return out
end


