-- =========================================================
-- Hit Effect sprite-sheet loaders.
-- IMPORTANT: exact same PAGE -> resolve -> LoadImage -> IsImageReady
-- path used by the Aimbot tab icon. fotovssylku /i/... links are page
-- URLs, so never feed these three raw page URLs to the generic preloader.
-- =========================================================

_G.FALLEN_HITFX_SHEET_STATE =
    _G.FALLEN_HITFX_SHEET_STATE
    or {}


function FALLEN_HITFX_SHEET_GET(key, page_url)
    if type(key) ~= "string" or type(page_url) ~= "string" or page_url == "" then
        return nil
    end

    local state = _G.FALLEN_HITFX_SHEET_STATE[key]

    if type(state) ~= "table" then
        state = {
            source = nil,
            resolved = nil,
            handle = nil,
            ready = false,
            failed = false,
        }
        _G.FALLEN_HITFX_SHEET_STATE[key] = state
    end

    if state.source ~= page_url then
        state.source = page_url
        state.resolved = nil
        state.handle = nil
        state.ready = false
        state.failed = false
    end

    if state.failed == true then
        return nil
    end

    if state.ready == true and state.handle then
        return state.handle
    end

    if not state.resolved then
        if type(FALLEN_LOADER_RESOLVE_IMAGE_URL) ~= "function" then
            return nil
        end
        state.resolved = FALLEN_LOADER_RESOLVE_IMAGE_URL(page_url) or page_url
    end

    if not state.handle and type(LoadImage) == "function" then
        local ok, handle = pcall(LoadImage, state.resolved)
        if ok and handle then
            state.handle = handle
        end
    end

    local handle = state.handle
    if not handle then
        return nil
    end

    if type(IsImageFailed) == "function" then
        local ok, failed = pcall(IsImageFailed, handle)
        if ok and failed == true then
            state.failed = true
            return nil
        end
    end

    if type(IsImageReady) == "function" then
        local ok, ready = pcall(IsImageReady, handle)
        if not ok or ready ~= true then
            return nil
        end
    end

    state.ready = true
    return handle
end

