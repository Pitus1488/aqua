        FALLEN_WORLD_WEATHER_POPUP_STEP("rain")

    if raw_anim <= 0.001
        and not A.world_rain_settings_open
    then
        return false
    end

    local parent_alpha = MENU_RENDER_ALPHA
    local popup_fade =
        ease_out_cubic(
            clamp(raw_anim, 0, 1)
        )

    MENU_RENDER_ALPHA =
        parent_alpha
        * popup_fade

    local anim =
        A.world_rain_settings_open
        and ease_out_cubic(raw_anim)
        or ease_in_out_cubic(raw_anim)

