function FALLEN_LOADER_RESOLVE_IMAGE_URL(url)
    if type(url) ~= "string"
        or url == ""
    then
        return nil
    end

    if not Http
        or type(Http.get) ~= "function"
    then
        return url
    end

    local resolved = url

    pcall(function()
        local http_ok, status, body =
            Http.get(
                url,
                { timeout_ms = 7000 }
            )

        if not http_ok
            or status ~= 200
            or type(body) ~= "string"
            or body == ""
        then
            return
        end

        local direct =
            body:match(
                '<meta[^>]-property%s*=%s*["\']og:image["\'][^>]-content%s*=%s*["\']([^"\']+)'
            )
            or body:match(
                '<meta[^>]-content%s*=%s*["\']([^"\']+)["\'][^>]-property%s*=%s*["\']og:image["\']'
            )
            or body:match(
                '<meta[^>]-name%s*=%s*["\']twitter:image["\'][^>]-content%s*=%s*["\']([^"\']+)'
            )
            or body:match(
                '<meta[^>]-content%s*=%s*["\']([^"\']+)["\'][^>]-name%s*=%s*["\']twitter:image["\']'
            )

        if type(direct) == "string"
            and direct ~= ""
        then
            direct =
                direct:gsub("&amp;", "&")

            if direct:sub(1, 2) == "//" then
                direct =
                    "https:"
                    .. direct
            elseif direct:sub(1, 1) == "/" then
                direct =
                    "https://fotovssylku.ru"
                    .. direct
            end

            resolved = direct
        end
    end)

    return resolved
end

-- =========================================================
-- Startup image preloader (sequential / low-stutter)
-- Every image is requested during Lua startup, but NOT all at once.
-- One logical image is started, we wait for ready/fail (or a timeout),
-- then move to the next one. This prevents a huge LoadImage burst.
-- =========================================================

_G.FALLEN_IMAGE_PRELOAD_HANDLES =
    _G.FALLEN_IMAGE_PRELOAD_HANDLES
    or {}

_G.FALLEN_IMAGE_PRELOAD_QUEUE = {}
_G.FALLEN_IMAGE_PRELOAD_QUEUED = {}
_G.FALLEN_IMAGE_PRELOAD_STARTED = false
_G.FALLEN_IMAGE_PRELOAD_DONE = false
_G.FALLEN_IMAGE_PRELOAD_INDEX = 0
_G.FALLEN_IMAGE_PRELOAD_TOTAL = 0

function FALLEN_PRELOAD_QUEUE_URL(url)
    if type(url) ~= "string"
        or url == ""
    then
        return
    end

    if _G.FALLEN_IMAGE_PRELOAD_QUEUED[url] then
        return
    end

    _G.FALLEN_IMAGE_PRELOAD_QUEUED[url] = true

    table.insert(
        _G.FALLEN_IMAGE_PRELOAD_QUEUE,
        url
    )
end

-- URL tables in this script usually store fallback URLs as an array.
-- Only queue the FIRST URL from each fallback array. If it later fails,
-- the normal runtime resolver can still advance to the next fallback.
function FALLEN_PRELOAD_QUEUE_PRIMARY(value, seen)
    if type(value) == "string" then
        FALLEN_PRELOAD_QUEUE_URL(value)
        return
    end

    if type(value) ~= "table" then
        return
    end

    seen = seen or {}

    if seen[value] then
        return
    end

    seen[value] = true

    local n =
        #value

    if n > 0 then
        for i = 1, n do
            if type(value[i]) == "string"
                and value[i] ~= ""
            then
                FALLEN_PRELOAD_QUEUE_URL(
                    value[i]
                )
                return
            end
        end
    end

    for _, child in pairs(value) do
        if type(child) == "string" then
            FALLEN_PRELOAD_QUEUE_URL(child)
        elseif type(child) == "table" then
            FALLEN_PRELOAD_QUEUE_PRIMARY(
                child,
                seen
            )
        end
    end
end

function FALLEN_PRELOAD_WAIT_HANDLE(handle, timeout_seconds)
    if not handle then
        return false
    end

    local timeout =
        tonumber(timeout_seconds)
        or 3.0

    local started =
        tick()

    while tick() - started < timeout do
        if type(IsImageReady) == "function" then
            local ok, ready =
                pcall(
                    IsImageReady,
                    handle
                )

            if ok and ready == true then
                return true
            end
        end

        if type(IsImageFailed) == "function" then
            local ok, failed =
                pcall(
                    IsImageFailed,
                    handle
                )

            if ok and failed == true then
                return false
            end
        end

        -- This runs only in the preload worker, never in on_render.
        if type(wait) == "function" then
            wait(0.035)
        else
            break
        end
    end

    return false
end

function FALLEN_PRELOAD_IMAGE_URL_SEQUENTIAL(url)
    if type(url) ~= "string"
        or url == ""
        or type(LoadImage) ~= "function"
    then
        return nil
    end

    local handle =
        _G.FALLEN_IMAGE_PRELOAD_HANDLES[url]

    if not handle then
        local ok, loaded =
            pcall(
                LoadImage,
                url
            )

        if ok and loaded then
            handle = loaded

            _G.FALLEN_IMAGE_PRELOAD_HANDLES[url] =
                loaded
        end
    end

    if handle then
        FALLEN_PRELOAD_WAIT_HANDLE(
            handle,
            3.0
        )
    end

    -- Tiny spacing between downloads keeps texture creation smooth.
    if type(wait) == "function" then
        wait(0.025)
    end

    return handle
end

function FALLEN_PRELOAD_WAIT_GETTER(getter, timeout_seconds)
    if type(getter) ~= "function" then
        return nil
    end

    local timeout =
        tonumber(timeout_seconds)
        or 4.0

    local started =
        tick()

    while tick() - started < timeout do
        local ok, handle =
            pcall(
                getter
            )

        if ok and handle then
            return handle
        end

        if type(wait) == "function" then
            wait(0.040)
        else
            break
        end
    end

    return nil
end

function FALLEN_BUILD_IMAGE_PRELOAD_QUEUE()
    _G.FALLEN_IMAGE_PRELOAD_QUEUE = {}
    _G.FALLEN_IMAGE_PRELOAD_QUEUED = {}

