function FALLEN_HITFX_STYLE_DROPDOWN_STEP()
    local now = tick()

    if A.hit_effect_style_last_t == nil then
        A.hit_effect_style_last_t = now
    end

    local dt =
        clamp(
            now - A.hit_effect_style_last_t,
            0,
            0.05
        )

    A.hit_effect_style_last_t = now

    local target =
        A.hit_effect_style_open
        and 1
        or 0

    local speed =
        target > (A.hit_effect_style_anim or 0)
        and 16
        or 12

    A.hit_effect_style_anim =
        exp_chase(
            A.hit_effect_style_anim or 0,
            target,
            speed,
            dt
        )

    if math.abs(
        (A.hit_effect_style_anim or 0)
        - target
    ) < 0.0015
    then
        A.hit_effect_style_anim = target
    end

    return
        clamp(
            A.hit_effect_style_anim or 0,
            0,
            1
        )
end

