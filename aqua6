function FALLEN_KEYBINDS_STEP()
    local now =
        tick()

    if A.keybinds_panel_last_t == nil then
        A.keybinds_panel_last_t =
            now
    end

    local dt =
        clamp(
            now - A.keybinds_panel_last_t,
            0,
            0.05
        )

    A.keybinds_panel_last_t =
        now

    local target =
        S.keybinds_list_enabled == true
        and 1
        or 0

    A.keybinds_panel_anim =
        exp_chase(
            A.keybinds_panel_anim or 0,
            target,
            target > (A.keybinds_panel_anim or 0)
                and 12
                or 9,
            dt
        )

    if target == 0
        and (A.keybinds_panel_anim or 0) < 0.015
    then
        A.keybinds_panel_anim =
            0
    elseif target == 1
        and (A.keybinds_panel_anim or 0) > 0.992
    then
        A.keybinds_panel_anim =
            1
    end

    return
        clamp(
            A.keybinds_panel_anim or 0,
            0,
            1
        )
end


function FALLEN_HOTKEYS_ROUNDED_FILL(
    x,
    y,
    w,
    h,
    radius,
    color
)
    -- Pixel-lock the whole shape first.
    x =
        math.floor(
            tonumber(x) or 0
            + 0.5
        )

    y =
        math.floor(
            tonumber(y) or 0
            + 0.5
        )

    w =
        math.max(
            1,
            math.floor(
                tonumber(w) or 1
                + 0.5
            )
        )

    h =
        math.max(
            1,
            math.floor(
                tonumber(h) or 1
                + 0.5
            )
        )

    radius =
        math.floor(
            clamp(
                tonumber(radius) or 0,
                0,
                math.min(w, h) * 0.5
            )
            + 0.5
        )

    if radius <= 0 then
        fill(
            x,
            y,
            w,
            h,
            color
        )

        return
    end

    local x2 =
        x + w

    local y2 =
        y + h

    local rr =
        radius * radius

    -- Top and bottom corner rows are each ONE continuous horizontal strip.
    -- That guarantees perfect left/right symmetry at this small 120x35 size.
    for yy = 0, radius - 1 do
        local dy =
            radius
            - yy
            - 0.5

        local dx =
            math.floor(
                math.sqrt(
                    math.max(
                        0,
                        rr - dy * dy
                    )
                )
                + 0.5
            )

        local left =
            x
            + radius
            - dx

        local right =
            x2
            - radius
            + dx

        local strip_w =
            math.max(
                0,
                right - left
            )

        if strip_w > 0 then
            fill(
                left,
                y + yy,
                strip_w,
                1,
                color
            )

            fill(
                left,
                y2 - yy - 1,
                strip_w,
                1,
                color
            )
        end
    end

    local middle_h =
        h
        - radius * 2

    if middle_h > 0 then
        fill(
            x,
            y + radius,
            w,
            middle_h,
            color
        )
    end
end


function FALLEN_DRAW_HOTKEYS_FOV_GLOW(
    x,
    y,
    w,
    h,
    radius
)
    -- Final tuned values:
    -- Strength 158, Spread 5, Alpha 100.
    local strength =
        1.58

    local spread =
        5

    local total_spread =
        spread * 3.0

    local layers =
        28

    local next_target =
        0

    for layer = layers - 1, 0, -1 do
        local t =
            layer / (layers - 1)

        local falloff =
            1 - t

        local offset =
            t * total_spread

        local target_alpha =
            clamp(
                1.0
                * strength
                * falloff
                * falloff
                * 0.20,
                0,
                0.95
            )

        local layer_alpha =
            0

        if target_alpha > next_target then
            layer_alpha =
                1
                - (
                    (1 - target_alpha)
                    / math.max(
                        0.0001,
                        1 - next_target
                    )
                )
        end

        layer_alpha =
            clamp(
                layer_alpha,
                0,
                0.95
            )

        if layer_alpha > 0.0001 then
            FALLEN_HOTKEYS_ROUNDED_FILL(
                x - offset,
                y - offset,
                w + offset * 2,
                h + offset * 2,
                radius + offset,
                {
                    0,
                    0,
                    0,
                    layer_alpha
                }
            )
        end

        next_target =
            target_alpha
    end
end



