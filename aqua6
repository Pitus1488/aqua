function FALLEN_POPUP_GLOW(
    x,
    y,
    w,
    h,
    radius,
    strength
)
    -- All slide-out settings panels and dropdown menus share the same
    -- thin, neutral gray outline as the toggle switches (no blue glow).
    -- Drawn before the popup surface: the caller fills the center, so
    -- only a 1px rim remains visible along the rounded perimeter.
    if (tonumber(w) or 0) <= 0 or (tonumber(h) or 0) <= 0 then return end
    local r = math.max(1, tonumber(radius) or 7)
    local opacity = clamp(tonumber(strength) or 1, 0, 1)
    rounded_fill(x - 1, y - 1, w + 2, h + 2, r + 1,
        { 0.16, 0.16, 0.17, opacity })
end


FALLEN_MENU_GRADIENT_TEXTURE =
    FALLEN_MENU_GRADIENT_TEXTURE
    or {
        -- Front texture is always kept alive while a new color texture loads.
        -- This prevents the Gradient menu from disappearing for a frame.
        handle = nil,
        key = nil,

        pending_handle = nil,
        pending_key = nil,
        pending_slot = nil,

        active_slot = 1,
        last_build = 0,

        path_a = "C:\\blueberry\\scripts\\fallen_menu_gradient_a.bmp",
        path_b = "C:\\blueberry\\scripts\\fallen_menu_gradient_b.bmp",
    }

function FALLEN_MENU_GRADIENT_COLOR(prefix)
    local r, g, b =
        hsv_to_rgb(
            tonumber(S[prefix .. "_h"]) or 0,
            tonumber(S[prefix .. "_s"]) or 0,
            tonumber(S[prefix .. "_v"]) or 1
        )

    return {
        clamp(r, 0, 1),
        clamp(g, 0, 1),
        clamp(b, 0, 1),
        1,
    }
end

function FALLEN_GRADIENT_BYTE(v)
    return
        math.floor(
            clamp(v or 0, 0, 1)
            * 255
            + 0.5
        )
end

function FALLEN_GRADIENT_U16_LE(v)
    v = math.floor(v or 0)

    return string.char(
        v % 256,
        math.floor(v / 256) % 256
    )
end

function FALLEN_GRADIENT_U32_LE(v)
    v = math.floor(v or 0)

    return string.char(
        v % 256,
        math.floor(v / 256) % 256,
        math.floor(v / 65536) % 256,
        math.floor(v / 16777216) % 256
    )
end

function FALLEN_GRADIENT_BUILD_BMP(a, b)
    -- Small texture is enough because DrawImage scales it smoothly.
    -- 96x96 also keeps regeneration cheap while dragging a color picker.
    local w = 96
    local h = 96
    local row_bytes = w * 3
    local row_pad = (4 - (row_bytes % 4)) % 4
    local image_size = (row_bytes + row_pad) * h
    local file_size = 54 + image_size

    local chunks = {}

    chunks[#chunks + 1] = "BM"
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(file_size)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U16_LE(0)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U16_LE(0)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(54)

    -- BITMAPINFOHEADER
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(40)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(w)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(h)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U16_LE(1)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U16_LE(24)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(0)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(image_size)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(0)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(0)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(0)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(0)

    local pad =
        row_pad > 0
        and string.rep("\0", row_pad)
        or ""

    -- BMP rows are stored bottom-up.
    for py = h - 1, 0, -1 do
        local v =
            py / (h - 1)

        local row = {}

        for px = 0, w - 1 do
            local u =
                px / (w - 1)

            -- Diagonal axis:
            -- top-right  => t = 1 => Color 1 (A)
            -- bottom-left => t = 0 => Color 2 (B)
            local t =
                clamp(
                    (u - v + 1) * 0.5,
                    0,
                    1
                )

            local r =
                lerp(
                    b[1],
                    a[1],
                    t
                )

            local g =
                lerp(
                    b[2],
                    a[2],
                    t
                )

            local bb =
                lerp(
                    b[3],
                    a[3],
                    t
                )

            -- BMP pixel order = B, G, R.
            row[#row + 1] =
                string.char(
                    FALLEN_GRADIENT_BYTE(bb),
                    FALLEN_GRADIENT_BYTE(g),
                    FALLEN_GRADIENT_BYTE(r)
                )
        end

        chunks[#chunks + 1] =
            table.concat(row)
            .. pad
    end

    return table.concat(chunks)
end

function FALLEN_GRADIENT_COLOR_KEY(a, b)
    return string.format(
        "%02X%02X%02X-%02X%02X%02X",
        FALLEN_GRADIENT_BYTE(a[1]),
        FALLEN_GRADIENT_BYTE(a[2]),
        FALLEN_GRADIENT_BYTE(a[3]),
        FALLEN_GRADIENT_BYTE(b[1]),
        FALLEN_GRADIENT_BYTE(b[2]),
        FALLEN_GRADIENT_BYTE(b[3])
    )
end

function FALLEN_GRADIENT_IMAGE_READY(handle)
    if not handle then
        return false
    end

    if type(IsImageReady) == "function" then
        local ok, ready =
            pcall(
                IsImageReady,
                handle
            )

        if ok then
            return ready == true
        end
    end

    -- File-backed Drawing images are often immediately usable.
    -- If this build has no readiness API, keep the old texture for one
    -- complete build interval before allowing a swap.
    return true
end

function FALLEN_GRADIENT_IMAGE_FAILED(handle)
    if not handle
        or type(IsImageFailed) ~= "function"
    then
        return false
    end

    local ok, failed =
        pcall(
            IsImageFailed,
            handle
        )

    return ok
        and failed == true
end

function FALLEN_GRADIENT_UNLOAD(handle)
    if not handle then
        return
    end

    if Drawing
        and type(Drawing.UnloadImage) == "function"
    then
        pcall(
            Drawing.UnloadImage,
            handle
        )
    end
end

function FALLEN_GRADIENT_TRY_SWAP(state, wanted_key)
    if not state.pending_handle then
        return false
    end

    if FALLEN_GRADIENT_IMAGE_FAILED(
        state.pending_handle
    ) then
        FALLEN_GRADIENT_UNLOAD(
            state.pending_handle
        )

        state.pending_handle = nil
        state.pending_key = nil
        state.pending_slot = nil

        return false
    end

    if not FALLEN_GRADIENT_IMAGE_READY(
        state.pending_handle
    ) then
        return false
    end

    -- If the user moved the picker again while this image was loading,
    -- discard the stale candidate and keep the current front texture.
    if state.pending_key ~= wanted_key then
        FALLEN_GRADIENT_UNLOAD(
            state.pending_handle
        )

        state.pending_handle = nil
        state.pending_key = nil
        state.pending_slot = nil

        return false
    end

    local old_front =
        state.handle

    state.handle =
        state.pending_handle

    state.key =
        state.pending_key

    state.active_slot =
        state.pending_slot
        or state.active_slot

    state.pending_handle = nil
    state.pending_key = nil
    state.pending_slot = nil

    -- Only now is it safe to release the previous image.
    if old_front
        and old_front ~= state.handle
    then
        FALLEN_GRADIENT_UNLOAD(
            old_front
        )
    end

    return true
end

function FALLEN_GRADIENT_ENSURE_TEXTURE(a, b)
    local state =
        FALLEN_MENU_GRADIENT_TEXTURE

    local key =
        FALLEN_GRADIENT_COLOR_KEY(
            a,
            b
        )

    -- Finish a pending load first. The existing front texture stays visible.
    FALLEN_GRADIENT_TRY_SWAP(
        state,
        key
    )

    if state.key == key
        and state.handle
    then
        return state.handle
    end

    if type(write_file) ~= "function" then
        return state.handle
    end

    local now = tick()

    -- While dragging, cap texture regeneration to ~20 Hz.
    -- The currently displayed image never gets unloaded during this wait.
    if now - (state.last_build or 0) < 0.05 then
        return state.handle
    end

    -- If a previous candidate is still loading, keep drawing the old front.
    if state.pending_handle then
        return state.handle
    end

    local next_slot =
        state.active_slot == 1
        and 2
        or 1

    local next_path =
        next_slot == 1
        and state.path_a
        or state.path_b

    local bmp =
        FALLEN_GRADIENT_BUILD_BMP(
            a,
            b
        )

    local ok_write =
        pcall(
            write_file,
            next_path,
            bmp
        )

    if not ok_write then
        return state.handle
    end

    local candidate = nil

    pcall(function()
        if Drawing
            and type(Drawing.LoadImageFromFile) == "function"
        then
            candidate =
                Drawing.LoadImageFromFile(
                    next_path
                )
        elseif type(LoadImage) == "function" then
            candidate =
                LoadImage(
                    next_path
                )
        end
    end)

    state.last_build = now

    if not candidate then
        return state.handle
    end

    state.pending_handle = candidate
    state.pending_key = key
    state.pending_slot = next_slot

    -- If the backend made it ready synchronously, swap immediately.
    -- Otherwise the old front remains visible until a later frame.
    FALLEN_GRADIENT_TRY_SWAP(
        state,
        key
    )

    return
        state.handle
        or state.pending_handle
end

function FALLEN_GRADIENT_MIGRATE_OLD_DEFAULTS()
    if _G.FALLEN_GRADIENT_DEFAULTS_MIGRATED then
        return
    end

    _G.FALLEN_GRADIENT_DEFAULTS_MIGRATED = true

    -- Existing configs may still contain the old purple/blue defaults.
    -- Migrate only that exact old default pair; custom user colors stay intact.
    local old_a =
        math.abs((tonumber(S.menu_gradient_a_h) or 0) - 0.62) < 0.0001
        and math.abs((tonumber(S.menu_gradient_a_s) or 0) - 0.68) < 0.0001
        and math.abs((tonumber(S.menu_gradient_a_v) or 0) - 0.92) < 0.0001

    local old_b =
        math.abs((tonumber(S.menu_gradient_b_h) or 0) - 0.82) < 0.0001
        and math.abs((tonumber(S.menu_gradient_b_s) or 0) - 0.62) < 0.0001
        and math.abs((tonumber(S.menu_gradient_b_v) or 0) - 0.80) < 0.0001

    if old_a and old_b then
        S.menu_gradient_a_h = 0.00
        S.menu_gradient_a_s = 0.00
        S.menu_gradient_a_v = 0.00

        S.menu_gradient_b_h = 0.625
        S.menu_gradient_b_s = 0.85
        S.menu_gradient_b_v = 0.85
    end
end

function FALLEN_DRAW_MENU_DIAGONAL_GRADIENT(
    x,
    y,
    w,
    h,
    alpha_mul
)
    if w <= 1
        or h <= 1
    then
        return
    end

    FALLEN_GRADIENT_MIGRATE_OLD_DEFAULTS()

    local a =
        FALLEN_MENU_GRADIENT_COLOR(
            "menu_gradient_a"
        )

    local b =
        FALLEN_MENU_GRADIENT_COLOR(
            "menu_gradient_b"
        )

    local shell_alpha =
        0.50
        * clamp(
            alpha_mul or 1,
            0,
            1
        )

    local handle =
        FALLEN_GRADIENT_ENSURE_TEXTURE(
            a,
            b
        )

    if handle
        and type(DrawImage) == "function"
    then
        -- Single rounded image: no diagonal-line endpoints can poke through
        -- the menu sides, and sidebar vector icons remain perfectly clean.
        pcall(
            DrawImage,
            handle,
            x,
            y,
            w,
            h,
            1,
            1,
            1,
            shell_alpha,
            OUTER_R
        )

        return
    end

    -- Safe fallback while the local texture is loading.
    local mid = {
        lerp(b[1], a[1], 0.5),
        lerp(b[2], a[2], 0.5),
        lerp(b[3], a[3], 0.5),
        shell_alpha,
    }

    rounded_fill(
        x,
        y,
        w,
        h,
        OUTER_R,
        mid
    )
end

