            false
    end

    MENU_RENDER_ALPHA =
        parent_menu_alpha
end


function FALLEN_SILENT_PART_DROPDOWN_STEP()
    local now = tick()

    if A.silent_part_dropdown_last_t == nil then
        A.silent_part_dropdown_last_t =
            now
    end

    local dt =
        clamp(
            now - A.silent_part_dropdown_last_t,
            0,
            0.05
        )

    A.silent_part_dropdown_last_t =
        now

    local target =
        A.silent_part_dropdown_open
        and 1
        or 0

    local speed =
        target > (A.silent_part_dropdown_anim or 0)
        and 16
        or 12

    A.silent_part_dropdown_anim =
        exp_chase(
            A.silent_part_dropdown_anim or 0,
            target,
            speed,
            dt
        )

    if math.abs(
        (A.silent_part_dropdown_anim or 0)
        - target
    ) < 0.0015 then
        A.silent_part_dropdown_anim =
            target
    end

    return
        clamp(
            A.silent_part_dropdown_anim or 0,
            0,
            1
        )
end


function FALLEN_DRAW_SILENT_PART_DROPDOWN(
    mx,
    my,
    clicked,
    x,
    y,
    w
)
    local raw =
        FALLEN_SILENT_PART_DROPDOWN_STEP()

    if raw <= 0.004
        and not A.silent_part_dropdown_open
    then
        return false
    end

    local options = {
        "Head",
        "Torso",
        "Closest",
    }

    local item_h = 27

    local full_h =
        #options
        * item_h

    -- Same real downward unfold used by Settings dropdowns.
    local visible_h =
        full_h
        * ease_out_cubic(raw)

    local panel_h =
        math.max(
            2,
            visible_h
        )

    FALLEN_POPUP_GLOW(
        x,
        y,
        w,
        panel_h,
        7,
        0.95
    )

    rounded_fill(
        x,
        y,
        w,
        panel_h,
        7,
        { 0.050, 0.053, 0.062, 0.98 }
    )

    local panel_hot =
        hover(
            mx,
            my,
            x,
            y,
            w,
            panel_h
        )

    for i, option in ipairs(options) do
        local iy =
            y
            + (i - 1)
            * item_h

        local reveal =
            clamp(
                (
                    visible_h
                    - (i - 1) * item_h
                )
                / item_h,
                0,
                1
            )

        if reveal > 0.12 then
            local item_hot =
                reveal > 0.92
                and hover(
                    mx,
                    my,
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4
                )

            if item_hot then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4,
                    5,
                    { 0.105, 0.111, 0.132, 1 }
                )
            end

            local selected =
                tostring(
                    S.silent_target_part
                    or "Head"
                )
                == option

            if selected then
                rounded_fill(
                    x + 4,
                    iy + 3,
                    3,
                    item_h - 6,
                    1,
                    C.accent
                )
            end

            text(
                x + 12,
                iy + 8,
                option,
                FALLEN_HOVER_TEXT(
                    "silent_part_option:"
                        .. tostring(option),
                    item_hot,
                    selected
                        and C.text
                        or C.text_dim
                )
            )

            if clicked
                and item_hot
                and A.silent_part_dropdown_open
            then
                S.silent_target_part =
                    option

                if type(FALLEN_SILENT_UI_VALUE_CHANGED) == "function" then
                    FALLEN_SILENT_UI_VALUE_CHANGED(
                        "silent_target_part",
                        option
                    )
                end

                A.silent_part_dropdown_open =
                    false

                return true
            end
        end
    end

    return panel_hot
end


