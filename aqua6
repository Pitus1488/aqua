function FALLEN_DRAW_ANTIAIM_MODE_DROPDOWN(
    mx,
    my,
    clicked,
    x,
    y,
    w
)
    local anim =
        FALLEN_ANTIAIM_MODE_DROPDOWN_STEP()

    if anim <= 0.004
        and not A.misc_antiaim_mode_dropdown_open
    then
        return false, false
    end

    local item_h = 27
    local full_h =
        #FALLEN_ANTIAIM_MODES
        * item_h

    local eased =
        ease_out_cubic(anim)

    local visible_h =
        full_h
        * eased

    local panel_h =
        math.max(
            2,
            visible_h
        )

    FALLEN_POPUP_GLOW(
        x,
        y,
        w,
        panel_h,
        7,
        0.9
    )

    rounded_fill(
        x,
        y,
        w,
        panel_h,
        7,
        { 0.070, 0.074, 0.087, 1 }
    )

    local panel_hot =
        hover(
            mx,
            my,
            x,
            y,
            w,
            panel_h
        )

    for i, option in ipairs(FALLEN_ANTIAIM_MODES) do
        local iy =
            y
            + (i - 1) * item_h

        local reveal =
            clamp(
                (visible_h - (i - 1) * item_h)
                / item_h,
                0,
                1
            )

        if reveal > 0.12 then
            local item_hot =
                reveal > 0.92
                and hover(
                    mx,
                    my,
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4
                )

            if item_hot then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4,
                    5,
                    { 0.105, 0.111, 0.132, 1 }
                )
            end

            if option == S.misc_antiaim_mode then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    3,
                    item_h - 4,
                    1,
                    C.accent
                )
            end

            text(
                x + 12,
                iy + 8,
                option,
                FALLEN_HOVER_TEXT(
                    "antiaim_mode_option:"
                    .. tostring(option),
                    item_hot,
                    option == S.misc_antiaim_mode
                        and C.text
                        or C.text_dim
                )
            )

            if clicked
                and item_hot
                and A.misc_antiaim_mode_dropdown_open
            then
                S.misc_antiaim_mode = option
                A.misc_antiaim_mode_dropdown_open = false

                if numeric_stop then
                    numeric_stop(true)
                end

                return true, true
            end
        end
    end

    return panel_hot, false
end

function FALLEN_DRAW_ANTIAIM_SETTINGS_POPUP(
    mx,
    my,
    clicked,
    lmb,
    dots_x,
    dots_y
)
    local raw =
        FALLEN_ANTIAIM_SETTINGS_STEP()

    if raw <= 0.001
        and not A.misc_antiaim_settings_open
    then
        A.misc_antiaim_mode_dropdown_open = false
        A.misc_antiaim_mode_dropdown_anim = 0
        return false
    end

    local parent_alpha =
        MENU_RENDER_ALPHA

    MENU_RENDER_ALPHA =
        parent_alpha
        * ease_out_cubic(raw)

    local anim =
        A.misc_antiaim_settings_open
        and ease_out_cubic(raw)
        or ease_in_out_cubic(raw)

    local mode =
        tostring(
            S.misc_antiaim_mode
            or "Spin"
        )

    local jitter =
        mode == "Jitter"

    local backwards =
        mode == "Backwards"

    local pw = 300
    local ph =
        jitter and 206
        or (backwards and 86 or 124)

    local base_px =
        dots_x - pw + 28

    local base_py =
        dots_y + 31

    local retract =
        1 - anim

    local px =
        snap(
            base_px
            + retract * 14
        )

    local py =
        snap(
            base_py
            - retract * 34
        )

    local shell_h =
