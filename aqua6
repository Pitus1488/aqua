-- Fresh on every script load on purpose. This prevents an old weapon handle
-- (for example P250) from surviving in a shared cache and being reused here.
FALLEN_KEYCARD_ICON_CACHE = {}

function FALLEN_KEYCARD_ICON(name)
    if type(LoadImage) ~= "function" then
        return nil, false
    end

    local raw = FALLEN_DROPPED_ITEM_CLEAN_NAME(name)
    local canonical = FALLEN_KEYCARD_ICON_ALIASES[raw]

    if not canonical then
        return nil, false
    end

    local url = FALLEN_KEYCARD_ICON_URLS[canonical]
    if not url then
        return nil, true
    end

    local st = FALLEN_KEYCARD_ICON_CACHE[canonical]

    if not st then
        st = {
            handle = nil,
            failed = false,
            tried_png = true,
        }
        FALLEN_KEYCARD_ICON_CACHE[canonical] = st

        local ok, handle = pcall(LoadImage, url)
        if ok and handle then
            st.handle = handle
        else
            st.failed = true
        end
    end

    if st.failed then
        return nil, true
    end

    if st.handle and type(IsImageReady) == "function" then
        local ok, ready = pcall(IsImageReady, st.handle)
        if ok and ready == true then
            return st.handle, true
        end
    end

    if st.handle and type(IsImageFailed) == "function" then
        local ok, failed = pcall(IsImageFailed, st.handle)
        if ok and failed == true then
            st.failed = true
            st.handle = nil
            return nil, true
        end
    end

    return nil, true
end

function FALLEN_DROPPED_ITEM_ICON(name)
    local raw = FALLEN_DROPPED_ITEM_CLEAN_NAME(name)

    if raw == "" then
        return nil
    end

    -- Keycards bypass the huge Armor/weapon resolver completely.
    -- This prevents fuzzy aliases or stale weapon handles from ever turning
    -- a card into P250/AK/etc.
    local keycard_handle, is_keycard = FALLEN_KEYCARD_ICON(raw)
    if is_keycard then
        return keycard_handle
    end

    -- Reuse the same massive item/weapon URL table for everything else.
    local handle = nil

    if type(FALLEN_WEAPON_ICON) == "function" then
        handle = FALLEN_WEAPON_ICON(raw)
        if handle then return handle end
    end

    if type(FALLEN_ARMOR_ICON) == "function" then
        handle = FALLEN_ARMOR_ICON(raw)
        if handle then return handle end
    end

    -- A few drop model names carry category prefixes. The weapon resolver
    -- already has aliases, but these extra candidates cover common model names.
    local variants = {
        string.gsub(raw, "^Dropped%s+", ""),
        string.gsub(raw, "^Item%s+", ""),
    }

    for i = 1, #variants do
        local candidate = variants[i]

        if candidate ~= ""
            and candidate ~= raw
        then
            if type(FALLEN_WEAPON_ICON) == "function" then
                handle = FALLEN_WEAPON_ICON(candidate)
                if handle then return handle end
            end

            if type(FALLEN_ARMOR_ICON) == "function" then
                handle = FALLEN_ARMOR_ICON(candidate)
                if handle then return handle end
            end
        end
    end

    return nil
end

