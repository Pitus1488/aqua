function FALLEN_CHEAT_SET_FEATURE(
    name,
    enabled
)
    if not cheat then
        return false
    end

    enabled =
        enabled == true

    if type(cheat.enable) == "function" then
        local ok, result =
            pcall(
                cheat.enable,
                tostring(name),
                enabled
            )

        if ok
            and result ~= false
        then
            return true
        end
    end

    local applied = false

    pcall(function()
        local module =
            cheat[name]

        if module ~= nil
            and type(module) == "table"
        then
            module.enabled = enabled
            applied = true
        end
    end)

    return applied
end

