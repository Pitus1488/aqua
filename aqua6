function FALLEN_BT_GALAXY_FETCH_LOCAL()
    if type(FALLEN_BT_IMAGE) ~= "table" then
        return nil
    end

    if FALLEN_BT_IMAGE.galaxy_fetch_attempted == true then
        return FALLEN_BT_IMAGE.galaxy
    end

    FALLEN_BT_IMAGE.galaxy_fetch_attempted = true
    FALLEN_BT_IMAGE.galaxy_fetch_status = "FETCHING PAGE"

    local page_url = FALLEN_BT_IMAGE.galaxy_url
    if type(page_url) ~= "string" or page_url == "" then
        FALLEN_BT_IMAGE.galaxy_fetch_status = "FAILED: NO URL"
        return nil
    end

    local ok, status, body, err =
        FALLEN_BT_GALAXY_HTTP_GET(page_url, nil)

    if not ok or status ~= 200 or type(body) ~= "string" or body == "" then
        FALLEN_BT_IMAGE.galaxy_fetch_status =
            "FAILED: HTTP " .. tostring(status or 0)
        return nil
    end

    -- Some /i/ links return raw image bytes directly.
    local kind = FALLEN_BT_GALAXY_IMAGE_KIND(body)
    if kind then
        local path = FALLEN_BT_GALAXY_SAVE_LOCAL(body, kind)
        if path then
            FALLEN_BT_IMAGE.galaxy_source_url = page_url
            FALLEN_BT_IMAGE.galaxy_fetch_status = "LOCAL " .. string.upper(kind)
            return FALLEN_BT_GALAXY_LOAD_LOCAL(path)
        end
    end

    FALLEN_BT_IMAGE.galaxy_fetch_status = "RESOLVING IMAGE"

    local candidates =
        FALLEN_BT_GALAXY_CANDIDATES(body, page_url)

    for index, candidate in ipairs(candidates) do
        if index > 16 then break end

        FALLEN_BT_IMAGE.galaxy_fetch_status =
            "TRY IMAGE " .. tostring(index)

        local iok, istatus, ibody =
            FALLEN_BT_GALAXY_HTTP_GET(candidate, page_url)

        if iok
            and istatus == 200
            and type(ibody) == "string"
            and ibody ~= ""
        then
            local ikind = FALLEN_BT_GALAXY_IMAGE_KIND(ibody)
            if ikind then
                local path = FALLEN_BT_GALAXY_SAVE_LOCAL(ibody, ikind)
                if path then
                    FALLEN_BT_IMAGE.galaxy_source_url = candidate
                    FALLEN_BT_IMAGE.galaxy_resolved_url = candidate
                    FALLEN_BT_IMAGE.galaxy_fetch_status =
                        "LOCAL " .. string.upper(ikind)
                    return FALLEN_BT_GALAXY_LOAD_LOCAL(path)
                end
            end
        end
    end

    FALLEN_BT_IMAGE.galaxy_fetch_status =
        "FAILED: NO IMAGE IN PAGE"

    return nil
end

