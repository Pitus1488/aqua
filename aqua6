-- Config system
-- Named configs stored as flat files in the existing scripts folder.
-- =========================================================

FALLEN_CONFIGS = (function()

local CONFIG_PREFIX =
    "C:\\blueberry\\scripts\\fallen_lua_cfg_"

local CONFIG_INDEX =
    "C:\\blueberry\\scripts\\fallen_lua_cfg_index.txt"

local CONFIG = {
    list = {},
    loaded_name = nil,
}

local CONFIG_KEYS = {}

-- These are UI/navigation/runtime-state fields, not actual user settings.
-- Everything else in defaults that is bool/number/string is config-safe.
local CONFIG_EXCLUDE = {
    visible = true,
    tab = true,
    visuals_subtab = true,
    anim = true,
}

for key, value in pairs(defaults) do
    local kind =
        type(value)

    if not CONFIG_EXCLUDE[key]
        and (
            kind == "boolean"
            or kind == "number"
            or kind == "string"
        )
    then
        CONFIG_KEYS[#CONFIG_KEYS + 1] = key
    end
end

table.sort(CONFIG_KEYS)

local function cfg_notify(message, level)
    fallen_toast(message, level or "normal")
    if type(notify) == "function" then
        pcall(
            notify,
            tostring(message),
            level or "normal"
        )
    else
        print(
            SYS
            .. tostring(message)
        )
    end
end

local function cfg_sanitize_name(name)
    name =
        tostring(
            name or ""
        )

    name =
        string.gsub(
            name,
            "^%s+",
            ""
        )

    name =
        string.gsub(
            name,
            "%s+$",
            ""
        )

    name =
        string.gsub(
            name,
            "%s+",
            "_"
        )

    name =
        string.gsub(
            name,
            "[^%w_%-]",
            ""
        )

    if name == "" then
        return nil
    end

    if #name > 32 then
        name =
            string.sub(
                name,
                1,
                32
            )
    end

    return name
end

local function cfg_path(name)
    return
        CONFIG_PREFIX
        .. tostring(name)
        .. ".cfg"
end

local function cfg_escape(value)
    local s =
        tostring(
            value or ""
        )

    s =
        string.gsub(
            s,
            "%%",
            "%%25"
        )

    s =
        string.gsub(
            s,
            "|",
            "%%7C"
        )

    s =
        string.gsub(
            s,
            "\r",
            ""
        )

    s =
        string.gsub(
            s,
            "\n",
            "%%0A"
        )

    return s
end

local function cfg_unescape(value)
    local s =
        tostring(
            value or ""
        )

    s =
        string.gsub(
            s,
            "%%0A",
            "\n"
        )

    s =
        string.gsub(
            s,
            "%%7C",
            "|"
        )

    s =
        string.gsub(
            s,
            "%%25",
            "%%"
        )

    return s
end

local function cfg_split(line_txt)
    local out = {}
    local start_at = 1

    line_txt =
        tostring(
            line_txt or ""
        )

    while true do
        local p =
            string.find(
                line_txt,
                "|",
                start_at,
                true
            )

        if not p then
            out[#out + 1] =
                string.sub(
                    line_txt,
                    start_at
                )

            break
        end

        out[#out + 1] =
            string.sub(
                line_txt,
                start_at,
                p - 1
            )

        start_at = p + 1
    end

    return out
end

local function cfg_write_index()
    if type(write_file) ~= "function" then
        return false
    end

    local ok, result =
        pcall(
            write_file,
            CONFIG_INDEX,
            table.concat(
                CONFIG.list,
                "\n"
            )
        )

    return
        ok
        and result ~= false
end

local function cfg_read_index()
    CONFIG.list = {}

    local data = nil

    if type(read_file) == "function" then
        local ok, result =
            pcall(
                read_file,
                CONFIG_INDEX
            )

        if ok then
            data = result
        end
    end

    local seen = {}

    if type(data) == "string"
        and data ~= ""
    then
        for line_txt in string.gmatch(
            data,
            "[^\r\n]+"
        ) do
            local name =
                cfg_sanitize_name(
                    line_txt
                )

            if name
                and not seen[name]
            then
                seen[name] = true
                CONFIG.list[#CONFIG.list + 1] = name
            end
        end
    end

    table.sort(CONFIG.list)
end

local function cfg_add_to_index(name)
    name =
        cfg_sanitize_name(
            name
        )

    if not name then
        return
    end

    for _, existing in ipairs(
        CONFIG.list
    ) do
        if existing == name then
            return
        end
    end

    CONFIG.list[#CONFIG.list + 1] = name
    table.sort(CONFIG.list)
    cfg_write_index()
end

local function cfg_serialize()
    local lines = {
        "FALLEN_LUA_CONFIG|2",
    }

    for _, key in ipairs(
        CONFIG_KEYS
    ) do
        local value =
            S[key]

        local kind =
            type(value)

        if kind == "boolean" then
            lines[#lines + 1] =
                "B|"
                .. cfg_escape(key)
                .. "|"
                .. (
                    value
                    and "1"
                    or "0"
                )

        elseif kind == "number" then
            lines[#lines + 1] =
                "N|"
                .. cfg_escape(key)
                .. "|"
                .. tostring(value)

        elseif kind == "string" then
            lines[#lines + 1] =
                "S|"
                .. cfg_escape(key)
                .. "|"
                .. cfg_escape(value)
        end
    end

    return
        table.concat(
            lines,
            "\n"
        )
end

local function cfg_save(name)
    name =
        cfg_sanitize_name(
            name
        )

    if not name then
        cfg_notify(
            "Enter config name",
            "warning"
        )
        return false
    end

    if type(write_file) ~= "function" then
        cfg_notify(
            "write_file unavailable",
            "error"
        )
        return false
    end

    local ok, result =
        pcall(
            write_file,
            cfg_path(name),
            cfg_serialize()
        )

    if not ok
        or result == false
    then
        cfg_notify(
            "Config save failed",
            "error"
        )
        return false
    end

    cfg_add_to_index(name)

    CONFIG.loaded_name = name
    A.config_selected = name
    A.config_input_buffer = name

    cfg_notify(
        "Config "
        .. name
        .. " saved",
        "success"
    )

    return true
end

local function cfg_apply_value(
    key,
    kind,
    raw
)
    local default_value =
        defaults[key]

    if default_value == nil
        or CONFIG_EXCLUDE[key]
    then
        return
    end

    local expected =
        type(default_value)

    if kind == "B"
        and expected == "boolean"
    then
        S[key] =
            raw == "1"
            or raw == "true"

    elseif kind == "N"
        and expected == "number"
    then
        local number =
            tonumber(raw)

        if number ~= nil then
            S[key] = number
        end

    elseif kind == "S"
        and expected == "string"
    then
        S[key] =
            cfg_unescape(
                raw
            )
    end
end

local function cfg_load(name)
    name =
        cfg_sanitize_name(
            name
        )

    if not name then
        cfg_notify(
            "Select config first",
            "warning"
        )
        return false
    end

    if type(read_file) ~= "function" then
        cfg_notify(
            "read_file unavailable",
            "error"
        )
        return false
    end

    local data = nil

    local ok, result =
        pcall(
            read_file,
            cfg_path(name)
        )

    if ok then
        data = result
    end

    if type(data) ~= "string"
        or data == ""
    then
        cfg_notify(
            "Config "
            .. name
            .. " not found",
            "warning"
        )
        return false
    end

    -- Start from defaults for every config-managed field. This keeps older
    -- configs predictable when new settings are introduced in later builds.
    for _, config_key in ipairs(
        CONFIG_KEYS
    ) do
        S[config_key] =
            defaults[config_key]
    end

    for line_txt in string.gmatch(
        data,
        "[^\r\n]+"
    ) do
        local p =
            cfg_split(
                line_txt
            )

        if p[1] == "B"
            or p[1] == "N"
            or p[1] == "S"
        then
            local key =
                cfg_unescape(
                    p[2] or ""
                )

            cfg_apply_value(
                key,
                p[1],
                p[3] or ""
            )
        end
    end

    cfg_add_to_index(name)

    CONFIG.loaded_name = name
    A.config_selected = name
    A.config_input_buffer = name

    -- Force visual controls to resync to loaded values.
    A.toggles = {}
    A.slider_target = {}
    A.slider_visual = {}
    A.slider_knob = {}
    A.active_slider = nil

    numeric_stop(true)

    cfg_notify(
        "Config "
        .. name
        .. " loaded",
        "success"
    )

    return true
end

local function cfg_delete(name)
    name =
        cfg_sanitize_name(
            name
        )

    if not name then
        cfg_notify(
            "Select config first",
            "warning"
        )
        return false
    end

    local new_list = {}

    for _, existing in ipairs(
        CONFIG.list
    ) do
        if existing ~= name then
            new_list[#new_list + 1] = existing
        end
    end

    CONFIG.list = new_list
    cfg_write_index()

    -- This API exposes write_file/read_file but no required delete-file call.
    -- Clearing the file makes it non-loadable while the index removes it
    -- from the UI.
    if type(write_file) == "function" then
        pcall(
            write_file,
            cfg_path(name),
            ""
        )
    end

    if CONFIG.loaded_name == name then
        CONFIG.loaded_name = nil
    end

    if A.config_selected == name then
        A.config_selected = nil
    end

    if cfg_sanitize_name(A.config_input_buffer) == name then
        A.config_input_buffer = ""
    end

    cfg_notify(
        "Config "
        .. name
        .. " deleted",
        "success"
    )

    return true
end

