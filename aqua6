local WORLD_UI_BY_ID = {}

for _, item in ipairs(WORLD_UI_ITEMS) do
    WORLD_UI_BY_ID[item.id] = item
end

local function world_color_prefix(id)
    return "world_color_" .. tostring(id)
end

local function world_color_from_prefix(prefix)
    local r, g, b =
        hsv_to_rgb(
            tonumber(S[prefix .. "_h"]) or 0,
            tonumber(S[prefix .. "_s"]) or 0,
            tonumber(S[prefix .. "_v"]) or 1
        )

    return {
        r,
        g,
        b,
        clamp(
            (tonumber(S[prefix .. "_alpha"]) or 100) / 100,
            0,
            1
        ),
    }
end

local function world_item_color(item)
    if not item or not item.id then
        return { 1, 1, 1, 1 }
    end

    return
        world_color_from_prefix(
            world_color_prefix(item.id)
        )
end

local function world_square_swatch(x, y, size, c)
    rounded_fill(
        x,
        y,
        size,
        size,
        4,
        c
    )
end


local function resource_toggle_row(
    mx,
    my,
    clicked,
    x,
    y,
    w,
    item
)
    local h = 41
    local hot = row_hover(mx, my, x, y, w, h)

    local c =
        world_item_color(
            item
        )

    text(
        x + 29,
        y + 14,
        item.label,
        FALLEN_HOVER_TEXT(
            "resource:" .. tostring(item.id),
            hot,
            C.text
        )
    )

    local key = item.key

    if A.toggles[key] == nil then
        A.toggles[key] = S[key] and 1 or 0
    end

    local target = S[key] and 1 or 0
    A.toggles[key] = lerp(A.toggles[key], target, 0.23)

    local tw, th = 35, 19
    local tx = x + w - tw - 12
    local ty = y + 11

    -- Square color swatch immediately before the switch.
    local swatch_s = 18
    local swatch_x = tx - swatch_s - 12
    local swatch_y = y + 11

    world_square_swatch(
        swatch_x,
        swatch_y,
        swatch_s,
        c
    )

    local swatch_hot =
        hover(
            mx,
            my,
            swatch_x,
            swatch_y,
            swatch_s,
            swatch_s
        )


    local bg =
        mix_color(
            C.toggle_off,
            C.accent_dim,
            A.toggles[key]
        )

    rounded_fill(
        tx,
        ty,
        tw,
        th,
        th * 0.5,
        bg
    )

    local knob_x =
        lerp(
            tx + 9.5,
            tx + tw - 9.5,
            A.toggles[key]
        )

    circle_fill(
        knob_x,
        ty + th * 0.5,
        7,
        mix_color(
            C.toggle_knob,
            C.white,
            A.toggles[key]
        )
    )

    if clicked and swatch_hot then
        local prefix =
            world_color_prefix(
                item.id
            )

        FALLEN_COLOR_INPUT_STOP(true)

        if A.world_color_picker_open
            and A.world_color_picker_key == prefix
        then
            A.world_color_picker_open = false
            A.world_color_picker_drag = nil
        else
            A.world_color_picker_key = prefix
            A.world_color_picker_open = true
            A.world_color_picker_drag = nil
            A.fov_picker_open = false
            A.fov_picker_drag = nil
        end

        A.world_color_picker_anchor_x =
            FALLEN_UI_X(swatch_x)

        A.world_color_picker_anchor_y =
            FALLEN_UI_Y(swatch_y)

        A.world_color_picker_anchor_w =
            FALLEN_UI_LEN(swatch_s)

        A.world_color_picker_anchor_h =
            FALLEN_UI_LEN(swatch_s)

        if numeric_stop then
            numeric_stop(true)
        end

        return
    end

    if clicked and hot then
        S[key] = not S[key]

        _G.FALLEN_WORLD_FORCE_RESCAN = true
    end

end


local function world_settings_step_anim()
    local now = tick()

    if A.world_settings_last_t == nil then
        A.world_settings_last_t = now
    end

    local dt =
        clamp(
            now - A.world_settings_last_t,
            0,
            0.05
        )

    A.world_settings_last_t = now

    local target =
        A.world_settings_open
        and 1
        or 0

    -- Slightly slower than Aimbot popup by request.
    local speed =
        target > (A.world_settings_anim or 0)
        and 9.0
        or 7.0

    A.world_settings_anim =
        exp_chase(
            A.world_settings_anim or 0,
            target,
            speed,
            dt
        )

    if target == 0
        and (A.world_settings_anim or 0) < 0.018
    then
        A.world_settings_anim = 0
    elseif target == 1
        and (A.world_settings_anim or 0) > 0.992
    then
        A.world_settings_anim = 1
    end

    return
        clamp(
            A.world_settings_anim or 0,
            0,
            1
        )
end

local function draw_world_color_picker(mx, my, clicked, lmb)

    local now = tick()

    if A.world_color_picker_last_t == nil then
        A.world_color_picker_last_t = now
    end

    local dt =
        clamp(
            now - A.world_color_picker_last_t,
            0,
            0.05
        )

    A.world_color_picker_last_t = now

    local target =
        A.world_color_picker_open
        and 1
        or 0

    local speed =
        target > (A.world_color_picker_anim or 0)
        and 13.0
        or 10.0

    A.world_color_picker_anim =
        exp_chase(
            A.world_color_picker_anim or 0,
            target,
            speed,
            dt
        )

    if target == 0
        and (A.world_color_picker_anim or 0) < 0.012
    then
        A.world_color_picker_anim = 0
        A.world_color_picker_drag = nil
        FALLEN_COLOR_INPUT_STOP(true)
        return
    end

    if not A.world_color_picker_key then
        return
    end

    local anim =
        clamp(
            A.world_color_picker_anim or 0,
            0,
            1
        )

    local ease = smooth01(anim)

    local prefix =
        A.world_color_picker_key

    local anchor_x =
        tonumber(A.world_color_picker_anchor_x)
        or mx
        or 0

    local anchor_y =
        tonumber(A.world_color_picker_anchor_y)
        or my
        or 0

    local anchor_w =
        tonumber(A.world_color_picker_anchor_w)
        or 18

    local anchor_h =
        tonumber(A.world_color_picker_anchor_h)
        or 18

    local pw = 264
    local ph = 342

    local dims = nil
    pcall(function()
        dims = ScreenSize()
    end)

    local screen_w =
        dims
        and tonumber(dims.Width or dims.X)
        or 1920

    local screen_h =
        dims
        and tonumber(dims.Height or dims.Y)
        or 1080

    local gap = 12

    local left_px =
        anchor_x
        - pw
        - gap

    local right_px =
        anchor_x
        + anchor_w
        + gap

    local px = nil

    if left_px >= 8 then
        px = left_px
    elseif right_px + pw <= screen_w - 8 then
        px = right_px
    else
        px =
            clamp(
                anchor_x - pw * 0.5,
                8,
                math.max(8, screen_w - pw - 8)
            )
    end

    local py =
        clamp(
            anchor_y - 14,
            8,
            math.max(8, screen_h - ph - 8)
        )

    local attach_x =
        px < anchor_x
        and (px + pw)
        or px

    px =
        px
        + (anchor_x - attach_x)
        * (1 - ease)
        * 0.10

    py =
        py
        + (anchor_y - py)
        * (1 - ease)
        * 0.06

    px = snap(px)
    py = snap(py)

    local parent_transform =
        MENU_UI_TRANSFORM_ACTIVE

    local parent_alpha =
        MENU_RENDER_ALPHA

    MENU_UI_TRANSFORM_ACTIVE = false

    MENU_RENDER_ALPHA =
        parent_alpha
        * ease

    FALLEN_POPUP_GLOW(
        px,
        py,
        pw,
        ph,
        12,
        ease
    )

    rounded_fill(
        px,
        py,
        pw,
        ph,
        12,
        { 0.070, 0.073, 0.085, 1 }
    )

    text(
        px + 14,
        py + 10,
        "Color",
        C.text_dim
    )

    local pad = 14
    local sv_x = px + pad
    local sv_y = py + pad + 20
    local sv_w = pw - pad * 2
    local sv_h = 188

    local hue =
        tonumber(
            S[prefix .. "_h"]
        )
        or 0

    local smooth_w =
        math.max(
            1,
            math.floor(sv_w + 0.5)
        )

    local smooth_h =
        math.max(
            1,
            math.floor(sv_h + 0.5)
        )

    for xx = 0, smooth_w - 1 do
        local sat =
            smooth_w > 1
            and (xx / (smooth_w - 1))
            or 0

        local r, g, b =
            hsv_to_rgb(
                hue,
                sat,
                1
            )

        fill(
            sv_x + xx,
            sv_y,
            1,
            smooth_h,
            { r, g, b, 1 }
        )
    end

    for yy = 0, smooth_h - 1 do
        local black_alpha =
            smooth_h > 1
            and (yy / (smooth_h - 1))
            or 0

        if black_alpha > 0 then
            fill(
                sv_x,
                sv_y + yy,
                smooth_w,
                1,
                { 0, 0, 0, black_alpha }
            )
        end
    end

    local sv_hot =
        hover(
            mx,
            my,
            sv_x,
            sv_y,
            sv_w,
            sv_h
        )

    if clicked and sv_hot then
        FALLEN_COLOR_INPUT_STOP(true)
        A.world_color_picker_drag = "sv"
    end

    if A.world_color_picker_drag == "sv"
        and lmb
    then
        S[prefix .. "_s"] =
            clamp(
                (mx - FALLEN_UI_X(sv_x)) / FALLEN_UI_LEN(sv_w),
                0,
                1
            )

        S[prefix .. "_v"] =
            1
            - clamp(
                (my - FALLEN_UI_Y(sv_y)) / FALLEN_UI_LEN(sv_h),
                0,
                1
            )
    end

    local cursor_x =
        sv_x
        + clamp(
            tonumber(S[prefix .. "_s"]) or 0,
            0,
            1
        )
        * sv_w

    local cursor_y =
        sv_y
        + (
            1
            - clamp(
                tonumber(S[prefix .. "_v"]) or 1,
                0,
                1
            )
        )
        * sv_h

    circle_fill(
        cursor_x,
        cursor_y,
        7,
        { 0.05, 0.05, 0.06, 1 }
    )

    circle(
        cursor_x,
        cursor_y,
        7,
        { 1, 1, 1, 1 },
        2
    )

    local hue_y =
        sv_y
        + sv_h
        + 13

    local hue_h = 14

    local hue_width =
        math.max(
            1,
            math.floor(sv_w + 0.5)
        )

    for xx = 0, hue_width - 1 do
        local h0 =
            hue_width > 1
            and (xx / (hue_width - 1))
            or 0

        local r, g, b =
            hsv_to_rgb(
                h0,
                1,
                1
            )

        fill(
            sv_x + xx,
            hue_y,
            1,
            hue_h,
            { r, g, b, 1 }
        )
    end

    local hue_hot =
        hover(
            mx,
            my,
            sv_x,
            hue_y,
            sv_w,
            hue_h
        )

    if clicked and hue_hot then
        FALLEN_COLOR_INPUT_STOP(true)
        A.world_color_picker_drag = "hue"
    end

    if A.world_color_picker_drag == "hue"
        and lmb
    then
        S[prefix .. "_h"] =
            clamp(
                (mx - FALLEN_UI_X(sv_x)) / FALLEN_UI_LEN(sv_w),
                0,
                1
            )
    end

    local hue_x =
        sv_x
        + clamp(
            tonumber(S[prefix .. "_h"]) or 0,
            0,
            1
        )
        * sv_w

    rounded_fill(
        hue_x - 3,
        hue_y - 3,
        6,
        hue_h + 6,
        3,
        { 1, 1, 1, 1 }
    )

    rounded_fill(
        hue_x - 1,
        hue_y - 1,
        2,
        hue_h + 2,
        1,
        { 0.12, 0.12, 0.14, 1 }
    )

    -- Transparency slider restored.
    -- Alpha is ALSO mirrored in the last two HEX8 chars.
    local alpha_y =
        hue_y + 29

    local alpha_h = 14

    checker_strip(
        sv_x,
        alpha_y,
        sv_w,
        alpha_h
    )

    local current =
        world_color_from_prefix(
            prefix
        )

    local alpha_width =
        math.max(
            1,
            math.floor(sv_w + 0.5)
        )

    for xx = 0, alpha_width - 1 do
        local a =
            alpha_width > 1
            and (xx / (alpha_width - 1))
            or 0

        fill(
            sv_x + xx,
            alpha_y,
            1,
            alpha_h,
            {
                current[1],
                current[2],
                current[3],
                a,
            }
        )
    end

    local alpha_hot =
        hover(
            mx,
            my,
            sv_x,
            alpha_y,
            sv_w,
            alpha_h
        )

    if clicked and alpha_hot then
        FALLEN_COLOR_INPUT_STOP(true)
        A.world_color_picker_drag = "alpha"
    end

    if A.world_color_picker_drag == "alpha"
        and lmb
    then
        S[prefix .. "_alpha"] =
            math.floor(
                clamp(
                    (mx - FALLEN_UI_X(sv_x)) / FALLEN_UI_LEN(sv_w),
                    0,
                    1
                )
                * 100
                + 0.5
            )
    end

    local alpha_x =
        sv_x
        + clamp(
            (tonumber(S[prefix .. "_alpha"]) or 100) / 100,
            0,
            1
        )
        * sv_w

    circle_fill(
        alpha_x,
        alpha_y + alpha_h * 0.5,
        8,
        { 0.06, 0.06, 0.075, 1 }
    )

    circle(
        alpha_x,
        alpha_y + alpha_h * 0.5,
        8,
        { 1, 1, 1, 1 },
        2
    )

    -- No percentage text field; only HEX8 below the slider.
    local field_y =
        alpha_y + 29

    current =
        world_color_from_prefix(
            prefix
        )

    local hex =
        FALLEN_RGBA_HEX(
            current[1],
            current[2],
            current[3],
            current[4]
        )

    local hex_x = sv_x
    local hex_w = sv_w

    local hex_hot =
        hover(
            mx,
            my,
            hex_x,
            field_y,
            hex_w,
            31
        )

    local hex_focus =
        FALLEN_COLOR_INPUT_IS(
            "hex",
            prefix
        )

    rounded_fill(
        hex_x,
        field_y,
        hex_w,
        31,
        7,
        hex_focus
            and { 0.112, 0.118, 0.145, 1 }
            or (
                hex_hot
                and { 0.104, 0.108, 0.128, 1 }
                or { 0.095, 0.098, 0.112, 1 }
            )
    )

    if hex_focus then
        rounded_outline(
            hex_x,
            field_y,
            hex_w,
            31,
            7,
            alpha(C.accent, 0.72),
            1,
            { 0.112, 0.118, 0.145, 1 }
        )
    end

    text(
        hex_x + 10,
        field_y + 9,
        "HEX8",
        C.text_dim
    )

    local shown_hex =
        hex_focus
        and (
            "#"
            .. tostring(
                A.color_input.buffer
                or ""
            )
            .. (
                math.floor(tick() * 2) % 2 == 0
                and "|"
                or ""
            )
        )
        or hex

    text(
        hex_x + 56,
        field_y + 9,
        shown_hex,
        C.text
    )

    if clicked and hex_hot then
        A.world_color_picker_drag = nil

        FALLEN_COLOR_INPUT_START(
            "hex",
            prefix
        )
    end

    if not lmb then
        A.world_color_picker_drag = nil
    end

    local popup_hot =
        hover(
            mx,
            my,
            px,
            py,
            pw,
            ph
        )

    local swatch_hot =
        hover(
            mx,
            my,
            anchor_x,
            anchor_y,
            anchor_w,
            anchor_h
        )

    local interactive =
        A.world_color_picker_open
        and anim > 0.80

    if interactive
        and clicked
        and swatch_hot
    then
        A.world_color_picker_open = false
        A.world_color_picker_drag = nil
        FALLEN_COLOR_INPUT_STOP(true)
    elseif interactive
        and clicked
        and not popup_hot
        and not swatch_hot
    then
        A.world_color_picker_open = false
        A.world_color_picker_drag = nil
        FALLEN_COLOR_INPUT_STOP(true)
    end

    MENU_UI_TRANSFORM_ACTIVE =
        parent_transform

    MENU_RENDER_ALPHA =
        parent_alpha
end

local function draw_world_settings_popup(
    mx,
    my,
    clicked,
    lmb,
    dots_x,
    dots_y
)
    local raw =
        world_settings_step_anim()

    if raw <= 0.001
        and not A.world_settings_open
    then
        return
    end

    local group =
        tostring(
            A.world_settings_group
            or "global"
        )

    local is_global =
        group == "global"

    local is_nodes =
        group == "nodes"

    local is_plants =
        group == "plants"

    local is_bases =
        group == "bases"

    local is_drops =
        group == "drops"

    local is_bodybag =
        group == "bodybag"

    local is_grenade =
        group == "grenade"

    local title = "World ESP settings"
    local pw = 328
    local ph = 174

    if is_global then
        title = "World ESP settings"
        pw = 306
        ph = 455
    elseif is_nodes then
        title = "Node ESP settings"
        ph = 43 + 3 * 41 + 8
    elseif is_plants then
        title = "Plant ESP settings"
        ph = 43 + 7 * 41 + 8
    elseif is_bases then
        title = "Base ESP settings"
        pw = 620
        ph = 43 + 11 * 41 + 8
    elseif is_drops then
        title = "Dropped Items settings"
        pw = 306
        ph = 92
    elseif is_bodybag then
        title = "Body Bag ESP settings"
        pw = 306
        ph = 92
    elseif is_grenade then
        title = "Visual Grenade settings"
        pw = 306
        ph = 92
    end

    local parent_alpha =
        MENU_RENDER_ALPHA

    local fade =
        ease_out_cubic(raw)

    MENU_RENDER_ALPHA =
        parent_alpha
        * fade

    local anim =
        A.world_settings_open
        and ease_out_cubic(raw)
        or ease_in_out_cubic(raw)

