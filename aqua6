    function L.draw_inject(mx0, my0, modal_w, modal_h, alpha)
        local logo_size = 44
        local text = "Loading"
        local text_w = #text * 6.5
        local bar_h = 3

        -- The source loader sized the bar from the old long caption
        -- ("The game will start automatically"). After changing the caption
        -- to "Loading", keeping that formula made the bar collapse to ~33 px.
        -- Keep the original visual scale instead of tying it to caption length.
        local bar_w = 150
        local gap_logo_bar = 14
        local gap_bar_text = 12
        local total_h = logo_size + gap_logo_bar + bar_h + gap_bar_text + 13
        local group_y = my0 + (modal_h - total_h) * 0.5
        local logo_x = mx0 + (modal_w - logo_size) * 0.5

        L.draw_product(logo_x, group_y, logo_size, alpha, 10)

        local bar_x = mx0 + (modal_w - bar_w) * 0.5
        local bar_y = group_y + logo_size + gap_logo_bar
        L.rounded_fill(bar_x, bar_y, bar_w, bar_h, bar_h * 0.5,
            L.theme.progress_track, 0.06 * alpha)

        local fill_w = bar_w * L.inject.progress
        if fill_w > 0.5 then
            L.rounded_fill(bar_x, bar_y, fill_w, bar_h, bar_h * 0.5,
                L.theme.progress_fill, alpha)
        end

        L.draw_loading_gradient(mx0 + modal_w * 0.5,
            bar_y + bar_h + gap_bar_text, alpha)
    end

    function L.draw_branch_popup(mx0, my0, modal_w, modal_h, alpha, mx, my, click, dt, now)
        local menu_t = L.ease_in_out_cubic(L.modal.branch_t)
        if menu_t <= 0.001 then
            L.modal.branch_hover = 0
            return false
        end

        local load_x = mx0 + modal_w - 20 - 100
        local load_y = my0 + modal_h - 20 - 30
        local pop_w = 108
        local pop_h = 42
        local pop_bottom = load_y + 30 + 2
        local pop_right = load_x + 100 + 2
        local slide = (1 - menu_t) * 10
        local px = pop_right - pop_w
        local py = pop_bottom - pop_h + slide
        local pa = alpha * menu_t

        L.rounded_fill(px, py, pop_w, pop_h, 5, L.theme.card, pa)
        L.rounded_outline(px, py, pop_w, pop_h, 5, L.theme.popup_border, pa, 1)

        local r0x, r0y = px + 3, py + 6
        local r1x, r1y = px + pop_w - 3, r0y + 30
        local interactive = L.modal.branch_menu and L.modal.branch_t > 0.55
        local hot = interactive and L.inside(mx, my, r0x, r0y, r1x - r0x, r1y - r0y)
        local target = (interactive and hot) and 1 or 0
        L.modal.branch_hover = L.modal.branch_hover
            + (target - L.modal.branch_hover) * math.min(1, 14 * dt)

        if L.modal.branch_hover > 0.01 then
            L.rounded_fill(r0x, r0y, r1x - r0x, r1y - r0y, 4,
                L.theme.text, 0.08 * L.modal.branch_hover * pa)
        end

        L.draw_git_branch_icon(r0x + 10 + 7 - 3, r0y + 15, 14,
            L.theme.branch_icon, pa)
        L.text(r0x + 10 + 14 + 2, r0y + 8, "Release", L.theme.branch_label, pa)

        if click and hot and not L.inject.active then
            L.modal.branch_menu = false
        elseif click and interactive and not L.inside(mx, my, px, py, pop_w, pop_h) then
            local bx = load_x - 8 - 30
            local by = load_y
            if not L.inside(mx, my, bx, by, 30, 30) then
                L.modal.branch_menu = false
            end
        end

        return L.inside(mx, my, px, py, pop_w, pop_h)
    end

    function L.draw_modal(x, y, global_alpha, mx, my, click, dt, now)
        if not L.modal.open and not L.modal.closing then return end

        local modal_w = L.inject.modal_w
        local modal_h = L.inject.modal_h
        local modal_x = x + (500 - modal_w) * 0.5
        local modal_y = y + (400 - modal_h) * 0.5
        local modal_alpha = L.modal.alpha * global_alpha
        local content_alpha = L.inject.content_alpha

        L.draw_dim(x, y, global_alpha)
        L.rounded_fill(modal_x, modal_y, modal_w, modal_h, 10,
            L.theme.card, modal_alpha)
        L.rounded_outline(modal_x, modal_y, modal_w, modal_h, 10,
            L.theme.outline, modal_alpha, 1.5)

        if L.inject.show_content then
            L.draw_inject(modal_x, modal_y, modal_w, modal_h,
                modal_alpha * L.inject.logo_alpha)
            return
        end

        local body_alpha = modal_alpha * content_alpha
        L.draw_product(modal_x + 20, modal_y + 20, 40, body_alpha, 10)
        L.text(modal_x + 70, modal_y + 27, "Fallen survival", L.theme.text, body_alpha)

        -- Source metadata columns.
        local base_y = modal_y + 100
        local line_sp = 25
        local left_x = modal_x + 20
        local value_x = modal_x + 102
        local labels = {"Branch:", "Updated:", "Valid Until:", "Last Launch:"}
        local values = {"Release", "Today", "Lifetime", L.last_launch}
        for i = 1, 4 do
            L.text(left_x, base_y + (i - 1) * line_sp, labels[i], L.theme.soft, body_alpha)
            L.text(value_x, base_y + (i - 1) * line_sp, values[i], L.theme.link, body_alpha)
        end

        local change_x = modal_x + 255
        L.text(change_x, base_y, "Today", L.theme.text, body_alpha)
        L.text(change_x, base_y + 23, "Fallen-lua loader", L.theme.dim, body_alpha)
        L.text(change_x, base_y + 42, "Ready to launch", L.theme.dim, body_alpha)

        local btn_h = 30
        local load_w = 100
        local branch_sz = 30
        local btn_gap = 8
        local load_x = modal_x + modal_w - 20 - load_w
        local load_y = modal_y + modal_h - 20 - btn_h
        local branch_x = load_x - btn_gap - branch_sz
        local branch_y = load_y
        local branch_hot = L.inside(mx, my, branch_x, branch_y, branch_sz, branch_sz)
        local load_hot = L.inside(mx, my, load_x, load_y, load_w, btn_h)

        if click and branch_hot and not L.inject.active and not L.modal.closing then
            L.modal.branch_menu = not L.modal.branch_menu
        end

        local menu_t = L.ease_in_out_cubic(L.modal.branch_t)
        local load_blocked = menu_t > 0.001
        local ba = (branch_hot or L.modal.branch_menu) and 1 or 0.92
        L.rounded_fill(branch_x, branch_y, branch_sz, branch_sz, 5,
            L.theme.button, body_alpha * ba)

        local ccx = branch_x + branch_sz * 0.5
        local ccy = branch_y + branch_sz * 0.5 + 0.5
        DrawLine(ccx - 4.2, ccy - 0.84, ccx, ccy + 2.4,
            L.theme.text[1], L.theme.text[2], L.theme.text[3], body_alpha, 1.4)
        DrawLine(ccx, ccy + 2.4, ccx + 4.2, ccy - 0.84,
            L.theme.text[1], L.theme.text[2], L.theme.text[3], body_alpha, 1.4)

        local load_alpha = body_alpha
        local load_mul = load_hot and 0.90 or 1.0
        L.rounded_fill(load_x, load_y, load_w, btn_h, 5,
            L.theme.button, load_alpha * load_mul)
        L.text_center(load_x + load_w * 0.5, load_y + 8, "Load", L.theme.text, load_alpha)

        if click and load_hot and not load_blocked and not L.inject.active and not L.modal.closing then
            L.modal.branch_menu = false
            L.modal.branch_t = 0
            _G.FALLEN_IMAGE_PRELOAD_STARTED = false
            _G.FALLEN_IMAGE_PRELOAD_DONE = false
            _G.FALLEN_IMAGE_PRELOAD_INDEX = 0
            _G.FALLEN_IMAGE_PRELOAD_TOTAL = 0
            _G.FALLEN_IMAGE_PRELOAD_SPECIAL_TOTAL = 0
            _G.FALLEN_IMAGE_PRELOAD_STATE = nil
            _G.FALLEN_IMAGE_PRELOAD_SPECIALS = nil
            L.inject.active = true
            L.inject.start_time = now
            L.inject.modal_w = 450
            L.inject.modal_h = 350
            L.inject.content_alpha = 1
            L.inject.logo_alpha = 0
            L.inject.progress = 0
            L.inject.show_content = false
            L.last_launch = "Just now"
        end

        L.draw_footer_links(modal_x, modal_y, load_y, body_alpha, mx, my, click, dt)
        local in_popup = L.draw_branch_popup(modal_x, modal_y, modal_w, modal_h,
            body_alpha, mx, my, click, dt, now)

        -- Modal close button from the source.
        local close_hit_x = modal_x + modal_w - 35
        local close_hit_y = modal_y + 27
        local close_hot = L.inside(mx, my, close_hit_x, close_hit_y, 20, 20)
        local close_col = close_hot and L.theme.text or L.theme.dim
        local cp_x = close_hit_x + 5
        local cp_y = close_hit_y + 5
        DrawLine(cp_x, cp_y, cp_x + 10, cp_y + 10,
            close_col[1], close_col[2], close_col[3], body_alpha, 2)
        DrawLine(cp_x, cp_y + 10, cp_x + 10, cp_y,
            close_col[1], close_col[2], close_col[3], body_alpha, 2)

        if click and close_hot and not L.inject.active and not L.modal.closing then
            L.modal_close(now)
            return
        end

        if click and not L.inject.active and not L.modal.closing then
            local in_card = L.inside(mx, my, modal_x, modal_y, modal_w, modal_h)
            if not in_card and not in_popup then
                L.modal_close(now)
            end
        end
    end

