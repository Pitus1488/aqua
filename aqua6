function FALLEN_PRELOAD_HANDLE_STATUS(handle, started, timeout_seconds)
    if not handle then
        return "failed"
    end

    if type(IsImageFailed) == "function" then
        local ok, failed = pcall(IsImageFailed, handle)
        if ok and failed == true then
            return "failed"
        end
    end

    if type(IsImageReady) == "function" then
        local ok, ready = pcall(IsImageReady, handle)
        if ok and ready == true then
            return "ready"
        end
    else
        return "ready"
    end

    if tick() - (tonumber(started) or tick()) >= (tonumber(timeout_seconds) or 6.0) then
        return "timeout"
    end

    return "pending"
end

function FALLEN_PRELOAD_TICK()
    if _G.FALLEN_IMAGE_PRELOAD_STARTED ~= true
        or _G.FALLEN_IMAGE_PRELOAD_DONE == true
    then
        return
    end

    local st = _G.FALLEN_IMAGE_PRELOAD_STATE
    if type(st) ~= "table" then
        return
    end

    local now = tick()
    local first_special_attempt = false

    -- Special/page-resolved images stay one-at-a-time because their resolver
    -- can be heavier. But while one is asynchronously waiting for readiness,
    -- direct armor/world/item images are allowed to load in parallel below.
    if st.special_done ~= true then
        local list = _G.FALLEN_IMAGE_PRELOAD_SPECIALS
        local getter = list and list[st.special_index]

        if not getter then
            st.special_done = true
        else
            if st.special_started == 0 then
                st.special_started = now
                st.special_next_try = now
                first_special_attempt = true
            end

            if now >= (st.special_next_try or 0) then
                st.special_next_try = now + 0.08

                local ok, handle = pcall(getter)
                if ok and handle then
                    FALLEN_PRELOAD_FINISH_ONE()
                    st.special_index = st.special_index + 1
                    st.special_started = 0

                    -- Only one special transition per frame.
                    return
                end
            end

            if st.special_started ~= 0
                and now - st.special_started >= (st.special_timeout or 2.2)
            then
                FALLEN_PRELOAD_FINISH_ONE()
                st.special_index = st.special_index + 1
                st.special_started = 0
                return
            end
        end
    end

    -- If this frame just kicked a new special image/resolver, don't also kick
    -- a direct image in the same frame. This is the main anti-stutter guard.
    if first_special_attempt then
        return
    end

    -- Poll only the bounded direct-image pool.
    local i = #st.inflight
    while i >= 1 do
        local item = st.inflight[i]
        local status =
            FALLEN_PRELOAD_HANDLE_STATUS(
                item.handle,
                item.started,
                st.image_timeout
            )

        if status ~= "pending" then
            table.remove(st.inflight, i)
            FALLEN_PRELOAD_FINISH_ONE()
        end

        i = i - 1
    end

    -- Adaptive frame budget:
    -- normally start up to TWO new direct images per render frame;
    -- if the previous frame was slow, fall back to ONE automatically.
    local frame_dt =
        now - (tonumber(st.last_tick) or now)

    st.last_tick = now

    local starts_this_frame = 2

    if frame_dt > 0.030 then
        starts_this_frame = 1
    end

    local started_now = 0

    while started_now < starts_this_frame
        and #st.inflight < (st.max_inflight or 12)
        and now >= (st.next_url_start or 0)
    do
        local url =
            _G.FALLEN_IMAGE_PRELOAD_QUEUE[st.url_index]

        if not url then
            break
        end

        st.url_index = st.url_index + 1
        st.next_url_start = now + (st.start_interval or 0)

        local handle =
            _G.FALLEN_IMAGE_PRELOAD_HANDLES[url]

        if not handle and type(LoadImage) == "function" then
            local ok, loaded =
                pcall(
                    LoadImage,
                    url
                )

            if ok and loaded then
                handle = loaded
                _G.FALLEN_IMAGE_PRELOAD_HANDLES[url] = loaded
            end
        end

        if handle then
            table.insert(
                st.inflight,
                {
                    handle = handle,
                    started = now,
                }
            )
        else
            FALLEN_PRELOAD_FINISH_ONE()
        end

        started_now = started_now + 1
    end

    if started_now > 0 then
        return
    end

    local direct_done =
        not _G.FALLEN_IMAGE_PRELOAD_QUEUE[st.url_index]
        and #st.inflight == 0

    local special_done =
        st.special_done == true
        or not (
            _G.FALLEN_IMAGE_PRELOAD_SPECIALS
            and _G.FALLEN_IMAGE_PRELOAD_SPECIALS[st.special_index]
        )

    if direct_done and special_done then
        _G.FALLEN_IMAGE_PRELOAD_INDEX =
            _G.FALLEN_IMAGE_PRELOAD_TOTAL
        _G.FALLEN_IMAGE_PRELOAD_DONE = true
    end
end

