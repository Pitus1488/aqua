    rounded_fill(
        px,
        py,
        pw,
        shell_h,
        11,
        { 0.062, 0.066, 0.077, 1 }
    )

    text(
        px + 13,
        py + 12,
        "Anti Aim settings",
        C.text
    )

    if shell_h > 39 then
        line(
            px + 12,
            py + 34,
            px + pw - 12,
            py + 34,
            C.divider,
            1
        )
    end

    local mode_field_x = nil
    local mode_field_y = nil
    local mode_field_w = nil
    local mode_field_h = 25
    local mode_field_hot = false

    if raw > 0.42 then
        local row_x = px + 8
        local row_y = py + 35
        local row_w = pw - 16

        row_hover(
            mx,
            my,
            row_x,
            row_y,
            row_w,
            41
        )

        text(
            row_x + 13,
            row_y + 14,
            "Mode",
            C.text
        )

        mode_field_w = 142
        mode_field_x =
            row_x
            + row_w
            - mode_field_w
            - 4

        mode_field_y =
            row_y + 8

        mode_field_hot =
            hover(
                mx,
                my,
                mode_field_x,
                mode_field_y,
                mode_field_w,
                mode_field_h
            )

        rounded_fill(
            mode_field_x,
            mode_field_y,
            mode_field_w,
            mode_field_h,
            6,
            mode_field_hot
                and { 0.110, 0.115, 0.135, 1 }
                or C.toggle_off
        )

        text(
            mode_field_x + 10,
            mode_field_y + 7,
            mode,
            C.text
        )

        text(
            mode_field_x + mode_field_w - 18,
            mode_field_y + 7,
            A.misc_antiaim_mode_dropdown_open
                and "^"
                or "v",
            C.text_dim
        )

        if FALLEN_DROPDOWN_TRIGGER_ALLOWED(
                ui_clicked,
                "misc_antiaim_mode_dropdown_open"
            )
            and mode_field_hot
        then
            A.misc_antiaim_mode_dropdown_open =
                not A.misc_antiaim_mode_dropdown_open

            if A.misc_antiaim_mode_dropdown_open
                and numeric_stop
            then
                numeric_stop(true)
            end
        end

        if shell_h > 82 then
            line(
                px + 12,
                py + 75,
                px + pw - 12,
                py + 75,
                C.divider,
                1
            )
        end

        if shell_h > 116 and not backwards then
            slider_row(
                mx,
                my,
                controls_clicked,
                lmb,
                px + 8,
                py + 76,
                pw - 16,
                "Yaw Speed",
                "misc_antiaim_speed",
                0,
                100,
                "int"
            )
        end

        if jitter then
            if shell_h > 123 then
                line(
                    px + 12,
                    py + 116,
                    px + pw - 12,
                    py + 116,
                    C.divider,
                    1
                )
            end

            if shell_h > 157 then
                slider_row(
                    mx,
                    my,
                    controls_clicked,
                    lmb,
                    px + 8,
                    py + 117,
                    pw - 16,
                    "Yaw Min",
                    "misc_antiaim_yaw_min",
                    -180,
                    180,
                    "int"
                )
            end

            if shell_h > 164 then
                line(
                    px + 12,
                    py + 157,
                    px + pw - 12,
                    py + 157,
                    C.divider,
                    1
                )
            end

            if shell_h > 198 then
                slider_row(
                    mx,
                    my,
                    controls_clicked,
                    lmb,
                    px + 8,
                    py + 158,
                    pw - 16,
                    "Yaw Max",
                    "misc_antiaim_yaw_max",
                    -180,
                    180,
                    "int"
                )
            end
        end
    end

    -- Draw the method list last so it cleanly unfolds above sliders beneath it.
    local dropdown_hot = false
    local option_selected = false

    if mode_field_x ~= nil then
        dropdown_hot,
        option_selected =
            FALLEN_DRAW_ANTIAIM_MODE_DROPDOWN(
                mx,
                my,
                ui_clicked,
                mode_field_x,
                mode_field_y + mode_field_h + 5,
                mode_field_w
            )
    end

    local popup_hot =
        hover(
            mx,
            my,
            px,
            py,
            pw,
            shell_h
        )

    local dots_hot =
        hover(
            mx,
            my,
            dots_x,
            dots_y,
            27,
            25
        )

    if interactive
        and clicked
        and A.misc_antiaim_mode_dropdown_open
        and not mode_field_hot
        and not dropdown_hot
        and not option_selected
    then
        A.misc_antiaim_mode_dropdown_open = false
        MENU_RENDER_ALPHA = parent_alpha
        return true
    end

    if interactive
        and clicked
        and not popup_hot
        and not dots_hot
        and not dropdown_hot
    then
        A.misc_antiaim_settings_open = false
        A.misc_antiaim_mode_dropdown_open = false

        if numeric_stop then
            numeric_stop(true)
        end
    end

    MENU_RENDER_ALPHA =
        parent_alpha

    return
        popup_hot
        or dropdown_hot
end

-- =========================================================
-- Render
-- =========================================================

hooks.on_render(function()
    -- Wait until the loader has fully faded away before showing the menu.
    if _G.FallenMenuReady ~= true then
        return
    end

    local rshift = key_down(VK_RSHIFT)

    if rshift
        and not prev_rshift
        and not A.aim_bind_listening
        and not A.silent_bind_listening
        and not A.config_input_focus
        and not A.color_input.focus
    then
        S.visible = not S.visible

        if not S.visible then
            numeric_stop(true)
            A.fov_picker_open = false
            A.fov_picker_drag = nil
            A.aim_settings_open = false
            A.aim_settings_anim = 0
            A.aim_part_dropdown_open = false
            A.aim_part_dropdown_anim = 0
            A.silent_part_dropdown_open = false
            A.silent_part_dropdown_anim = 0

            A.world_settings_open = false
            A.world_settings_anim = 0
            A.misc_antiaim_settings_open = false
            A.misc_antiaim_settings_anim = 0
            A.misc_antiaim_mode_dropdown_open = false
            A.misc_antiaim_mode_dropdown_anim = 0
            A.world_color_picker_open = false
            A.world_color_picker_drag = nil
            A.base_box_settings_open = false
            A.base_box_settings_anim = 0
            A.base_box_settings_id = nil
            A.base_scroll_dragging = false
            FALLEN_COLOR_INPUT_STOP(true)

            A.config_open = false
            A.config_anim = 0
            FALLEN_CONFIGS.input_focus(false)

            A.menu_settings_open = false
            A.menu_settings_anim = 0
            A.menu_scale_dropdown_open = false
            A.menu_scale_dropdown_anim = 0
            A.menu_type_dropdown_open = false
            A.menu_type_dropdown_anim = 0


            aim_bind_cancel()
        end
    end

    prev_rshift = rshift

    A.menu_open_target =
        S.visible and 1 or 0

    -- Smooth both opening and closing.
    A.menu_open =
        lerp(
            A.menu_open,
            A.menu_open_target,
            A.menu_open_target > A.menu_open and 0.18 or 0.22
        )

    if math.abs(A.menu_open - A.menu_open_target) < 0.002 then
        A.menu_open = A.menu_open_target
    end

    MENU_RENDER_ALPHA =
        clamp(A.menu_open, 0, 1)

    -- Once the closing animation is essentially invisible, stop drawing it.
    if A.menu_open <= 0.004
        and A.menu_open_target == 0
    then
        return
    end

    -- Poll focused UI input.
    numeric_poll()
    aim_bind_poll()
    FALLEN_SILENT_BIND_POLL()
    FALLEN_CONFIGS.input_poll()
    FALLEN_COLOR_INPUT_POLL()

    local lmb = key_down(VK_LBUTTON)
    local clicked =
        lmb
        and not prev_lmb
        and MENU_RENDER_ALPHA > 0.88

    A.avatar_editor_frame_clicked =
        clicked

    if A.avatar_editor_open then
        clicked = false
    end

    prev_lmb = lmb

    local rmb = key_down(VK_RBUTTON)

    local rmb_clicked =
        rmb
        and not prev_rmb
        and MENU_RENDER_ALPHA > 0.88

    if A.avatar_editor_open then
        rmb_clicked = false
    end

    prev_rmb = rmb

    if not lmb then
        A.active_slider = nil
        A.menu_dragging = false
    end

    local sw, sh = screen_size()
    local mx, my = mouse_pos()

    -- Menu Scale affects the entire UI, with gentler real growth.
    local label = S.menu_scale_percent
    local menu_scale = 1.00

    if tostring(label) == "Auto" then
        menu_scale =
            math.min(
                1.00,
                math.max(
                    0.82,
                    math.min((sw - 40) / 875, (sh - 40) / 630)
                )
            )
    else
        local p = tonumber(label) or 100

        if p == 125 then
            menu_scale = 1.06
        elseif p == 150 then
            menu_scale = 1.12
        elseif p == 175 then
            menu_scale = 1.18
        elseif p == 200 then
            menu_scale = 1.24
        else
            S.menu_scale_percent = 100
            menu_scale = 1.00
        end
    end

    WIN_W = 875
    WIN_H = 630

    if A.menu_cx == nil then
        A.menu_cx = sw * 0.5
        A.menu_cy = sh * 0.5
        A.menu_target_cx = A.menu_cx
        A.menu_target_cy = A.menu_cy
    end

    local wx = A.menu_cx - (WIN_W * menu_scale) * 0.5
    local wy = A.menu_cy - (WIN_H * menu_scale) * 0.5

    MENU_UI_SCALE = menu_scale
    MENU_UI_ORIGIN_X = wx
    MENU_UI_ORIGIN_Y = wy
    MENU_UI_TRANSFORM_ACTIVE = true

    -- Grab only the thin top edge so normal controls remain clickable.
    local drag_hot =
        hover(
            mx, my,
            wx + 10,
            wy + 2,
            WIN_W - 20,
            20
        )

    if clicked
        and drag_hot
        and not A.world_color_picker_open
        and (A.world_color_picker_anim or 0) <= 0.02
    then
        A.menu_dragging = true
        A.menu_drag_off_x = mx - A.menu_cx
        A.menu_drag_off_y = my - A.menu_cy
    end

    if A.menu_dragging and lmb then
        local half_w = WIN_W * menu_scale * 0.5
        local half_h = WIN_H * menu_scale * 0.5

        A.menu_target_cx =
            clamp(
                mx - A.menu_drag_off_x,
                half_w + 4,
                sw - half_w - 4
            )

        A.menu_target_cy =
            clamp(
                my - A.menu_drag_off_y,
                half_h + 4,
                sh - half_h - 4
            )
    end

    -- Smooth visual follow instead of teleporting to the mouse.
    A.menu_cx = lerp(A.menu_cx, A.menu_target_cx, A.menu_dragging and 0.32 or 0.20)
    A.menu_cy = lerp(A.menu_cy, A.menu_target_cy, A.menu_dragging and 0.32 or 0.20)

    wx = A.menu_cx - (WIN_W * menu_scale) * 0.5
    wy = A.menu_cy - (WIN_H * menu_scale) * 0.5

    MENU_UI_ORIGIN_X = wx
    MENU_UI_ORIGIN_Y = wy

    -- Whole window rises gently into place on open and drops on close.
    wy =
        wy
        + (1 - MENU_RENDER_ALPHA) * 16

    -- Snap the menu root to integer pixels so the Drawing text stays crisp.
    wx = snap(wx)
    wy = snap(wy)

    S.anim = clamp(lerp(S.anim or 0, 1, 0.16), 0, 1)

    FALLEN_APPLY_STYLE_COLOR()

    local menu_base_alpha = MENU_RENDER_ALPHA

    -- Full-screen animated weather lives BEHIND the entire menu.
    -- Convert the current menu rectangle to real screen coordinates first,
    -- then the weather renderer temporarily disables the menu transform.
    local weather_menu_x =
        FALLEN_UI_X(wx)

    local weather_menu_y =
        FALLEN_UI_Y(wy)

    local weather_menu_w =
        FALLEN_UI_LEN(WIN_W)

    local weather_menu_h =
        FALLEN_UI_LEN(WIN_H)

    FALLEN_WEATHER_MENU_RECT = {
        screen_w = sw,
        screen_h = sh,
        x = weather_menu_x,
        y = weather_menu_y,
        w = weather_menu_w,
        h = weather_menu_h,
        open_alpha = MENU_RENDER_ALPHA,
    }

    -- Optional dimmed backdrop behind the menu.
    -- It darkens the game only; the menu is drawn afterwards at normal opacity.
    if S.menu_dark_background == true
        and type(DrawBoxFilled) == "function"
    then
        DrawBoxFilled(
            0,
            0,
            sw,
            sh,
            0,
            0,
            0,
            0.45 * clamp(menu_base_alpha or 1, 0, 1)
        )
    end

    -- Same glow profile as the custom Aimbot FOV.
    local glow_rgb = {1, 1, 1, 1}

    pcall(function()
        glow_rgb =
            FALLEN_GLOW_COLOR()
    end)

    local glow_strength =
        clamp(
            (tonumber(S.menu_glow_strength) or 100) / 100,
            0,
            2
        )

    FALLEN_DRAW_FOV_STYLE_ROUNDED_GLOW(
        wx,
        wy,
        WIN_W,
        WIN_H,
        OUTER_R,
        glow_rgb,
        glow_strength,
        34 / 3
    )

    -- Base surfaces are genuinely transparent during the transition, but
    -- sidebar/content are now two DISJOINT rounded shapes. Nothing is drawn
    -- underneath them, so their corners cannot accumulate alpha.
    local menu_texture_type =
        tostring(S.menu_type or "glass"):lower()

    local is_gradient_menu =
        menu_texture_type == "gradient"
        or menu_texture_type == "blur"

    if is_gradient_menu then
        FALLEN_DRAW_MENU_DIAGONAL_GRADIENT(
            wx,
            wy,
            WIN_W,
            WIN_H,
            menu_base_alpha
        )

    else
        -- Default / Ass / Glass:
        -- REAL rounded transition between sidebar and content.
        --
        -- The content extends underneath the sidebar by OUTER_R pixels.
        -- Then the sidebar is drawn as a fully rounded panel on top.
        -- This makes the sidebar's top-right and bottom-right corners
        -- genuinely curved, with the content visible behind the curves.
        local split_overlap =
            OUTER_R

        if menu_texture_type == "glass"
            or menu_texture_type == "ass"
        then
            -- Glass / Ass use a clean FLAT inner split.
            -- No overlap at the center, so translucent sidebar pixels
            -- cannot stack over the opaque content and create a dark stripe.
            -- Only the OUTER window corners remain rounded.
            rounded_left_fill(
                wx,
                wy,
                SIDEBAR_W,
                WIN_H,
                OUTER_R,
                C.sidebar
            )

            rounded_right_fill(
                wx + SIDEBAR_W,
                wy,
                WIN_W - SIDEBAR_W,
                WIN_H,
                OUTER_R,
                C.content
            )
        else
            -- Opaque styles can keep the rounded inner transition.
            rounded_right_fill(
                wx + SIDEBAR_W - split_overlap,
                wy,
                WIN_W - SIDEBAR_W + split_overlap,
                WIN_H,
                OUTER_R,
                C.content
            )

            rounded_fill(
                wx,
                wy,
                SIDEBAR_W,
                WIN_H,
                OUTER_R,
                C.sidebar
            )
        end
    end

    -- Let the base become mostly visible before layered controls/cards fade in.
    -- This keeps the transparency animation, while preventing stacked
    -- translucent widgets from creating dark patches all over the menu.
    local detail_alpha =
        smooth01(
            (menu_base_alpha - 0.68) / 0.32
        )

    MENU_RENDER_ALPHA = detail_alpha

    if detail_alpha <= 0.002 then
        MENU_UI_TRANSFORM_ACTIVE = false
        return
    end

    -- Glass keeps its subtle original separator.
    -- Ass intentionally has NO center line: just a clean flat join.
    if menu_texture_type == "glass" then
        line(
            wx + SIDEBAR_W,
            wy + 12,
            wx + SIDEBAR_W,
            wy + WIN_H - 12,
            C.divider,
            1
        )
    end

    -- Brand image. Replaces the old visible "Fallen-lua" text.
    -- Large on purpose; easy to tune later without touching the sidebar layout.
    local brand_handle =
        FALLEN_BRAND_IMAGE_GET()

    if brand_handle
        and type(DrawImage) == "function"
    then
        pcall(
            DrawImage,
            brand_handle,
            FALLEN_UI_X(wx + 16),
            FALLEN_UI_Y(wy + 12),
            FALLEN_UI_LEN(140),
            FALLEN_UI_LEN(48),
            1,
            1,
            1,
            MENU_RENDER_ALPHA,
            0
        )
    end

    -- Hidden gesture: three quick clicks on the brand reveal the ??? setting.
    -- The hitbox has no hover color, cursor effect, glow, tooltip, or other hint.
    if clicked
        and hover(
            mx,
            my,
            wx + 14,
            wy + 10,
            144,
            52
        )
    then
        FALLEN_SECRET_BRAND_CLICK()
    end

    -- If the secret tab gets disabled while selected, fall back to Misc.
    if S.tab == 4
        and not (
            A.secret_unlocked
            and S.secret_enabled == true
        )
    then
        S.tab = 3
        S.anim = 0
    end

    -- Sidebar
    -- COMMON/Misc is physically pushed down by the Visuals child expansion.
    -- 0 => close under Visuals, 1 => below World + Armor.
    local common_layout_expand =
        smooth01(
            clamp(
                A.visuals_expand_anim or 0,
                0,
                1
            )
        )

    local common_layout_shift =
        74 * common_layout_expand

    local common_label_y =
        wy + 273 + common_layout_shift

    local misc_tab_y =
        wy + 293 + common_layout_shift

    local sidebar_target_y

    if S.tab == 4
        and A.secret_unlocked
        and S.secret_enabled == true
    then
        sidebar_target_y =
            wy + WIN_H - 118
    elseif S.tab == 3 then
        sidebar_target_y =
            misc_tab_y
    elseif S.tab == 2 then
        sidebar_target_y =
            wy + 219
    elseif S.tab == 5 then
        sidebar_target_y =
            wy + 145
    else
        sidebar_target_y =
            wy + 105
    end

    if A.sidebar_indicator_y == nil then
        A.sidebar_indicator_y =
            sidebar_target_y
    end

    local sidebar_now = tick()

    if A.sidebar_indicator_last_t == nil then
        A.sidebar_indicator_last_t =
            sidebar_now
    end

    local sidebar_dt =
        clamp(
            sidebar_now
            - A.sidebar_indicator_last_t,
            0,
            0.05
        )

    A.sidebar_indicator_last_t =
        sidebar_now

    A.sidebar_indicator_y =
        exp_chase(
            A.sidebar_indicator_y,
            sidebar_target_y,
            13,
            sidebar_dt
        )

    if math.abs(
        A.sidebar_indicator_y
        - sidebar_target_y
    ) < 0.08 then
        A.sidebar_indicator_y =
            sidebar_target_y
    end

    -- Sliding selected-tab pill.
    rounded_fill(
        wx + 10,
        A.sidebar_indicator_y,
        152,
        35,
        7,
        C.selected
    )

    text(wx + 22, wy + 85, "AIMBOT", C.text_faint)
    sidebar_tab(
        mx,
        my,
        clicked
            and not A.world_color_picker_open
            and (A.world_color_picker_anim or 0) <= 0.02,
        wx + 10,
        wy + 105,
        1
    )

    sidebar_tab(
        mx,
        my,
        clicked
            and not A.world_color_picker_open
            and (A.world_color_picker_anim or 0) <= 0.02,
        wx + 10,
        wy + 145,
        5
    )

    text(wx + 22, wy + 199, "VISUALS", C.text_faint)

    local visuals_parent_x =
        wx + 10

    local visuals_parent_y =
        wy + 219

    local visuals_parent_hot =
        hover(
            mx,
            my,
            visuals_parent_x,
            visuals_parent_y,
            152,
            35
        )

    sidebar_tab(
        mx,
        my,
        clicked
            and not A.world_color_picker_open
            and (A.world_color_picker_anim or 0) <= 0.02,
        visuals_parent_x,
        visuals_parent_y,
        2
    )

    -- Visuals is a standalone page.
    if clicked
        and visuals_parent_hot
        and not A.world_color_picker_open
        and (A.world_color_picker_anim or 0) <= 0.02
    then
        S.tab = 2
        S.visuals_subtab = 0
        S.anim = 0
    end

    -- RMB on Visuals expands/collapses World + Armor.
    if rmb_clicked
        and visuals_parent_hot
        and not A.world_color_picker_open
        and (A.world_color_picker_anim or 0) <= 0.02
    then
        -- RMB only expands/collapses the nested Visuals menu.
        -- It must NOT change the currently selected main page.
        A.visuals_expanded =
            not A.visuals_expanded
    end

    local visuals_now =
        tick()

    if A.visuals_expand_last_t == nil then
        A.visuals_expand_last_t =
            visuals_now
    end

    local visuals_dt =
        clamp(
            visuals_now
            - A.visuals_expand_last_t,
            0,
            0.05
        )

    A.visuals_expand_last_t =
        visuals_now

    local visuals_target =
        A.visuals_expanded
        and 1
        or 0

    A.visuals_expand_anim =
        exp_chase(
            A.visuals_expand_anim or 0,
            visuals_target,
            13,
            visuals_dt
        )

    local visuals_expand =
        clamp(
            A.visuals_expand_anim or 0,
            0,
            1
        )

    if visuals_expand > 0.008 then
        local old_sidebar_alpha =
            MENU_RENDER_ALPHA

        MENU_RENDER_ALPHA =
            old_sidebar_alpha
            * smooth01(visuals_expand)

        local child_x =
            wx + 26

        local child_w =
            136

        local child_h =
            31

        local collapse_shift =
            (1 - visuals_expand)
            * 15

        local world_y =
            wy + 259
            - collapse_shift

        local armor_y =
            wy + 292
            - collapse_shift

        -- Same smooth selected-background motion as the main Aimbot/Visuals tabs.
        local child_selected =
            S.tab == 2
            and (
                (tonumber(S.visuals_subtab) or 0) == 1
                or (tonumber(S.visuals_subtab) or 0) == 2
            )

        local child_target_y =
            (tonumber(S.visuals_subtab) or 0) == 2
            and armor_y
            or world_y

        if A.visuals_child_indicator_y == nil then
            A.visuals_child_indicator_y =
                child_target_y
        end

        A.visuals_child_indicator_y =
            exp_chase(
                A.visuals_child_indicator_y,
                child_target_y,
                14,
                visuals_dt
            )

        A.visuals_child_indicator_alpha =
            exp_chase(
                A.visuals_child_indicator_alpha or 0,
                child_selected and 1 or 0,
                13,
                visuals_dt
            )

        if (A.visuals_child_indicator_alpha or 0) > 0.01 then
            rounded_fill(
                child_x,
                A.visuals_child_indicator_y,
                child_w,
                child_h,
                7,
                alpha(
                    C.selected,
                    0.88
                    * A.visuals_child_indicator_alpha
                )
            )
        end

        local world_hot =
            hover(
                mx,
                my,
                child_x,
                world_y,
                child_w,
                child_h
            )

        local armor_hot =
            hover(
                mx,
                my,
                child_x,
                armor_y,
                child_w,
                child_h
            )

        local child_interactive =
            A.visuals_expanded
            and visuals_expand > 0.92
            and not A.world_color_picker_open
            and (A.world_color_picker_anim or 0) <= 0.02

        -- World child.
        if world_hot
            and not (
                S.tab == 2
                and (tonumber(S.visuals_subtab) or 0) == 1
            )
        then
            rounded_fill(
                child_x,
                world_y,
                child_w,
                child_h,
                7,
                alpha(C.card_hover, 0.55)
            )
        end

        local world_col =
            FALLEN_HOVER_TEXT(
                "sidebar_visual_world",
                world_hot,
                (
                    S.tab == 2
                    and (tonumber(S.visuals_subtab) or 0) == 1
                )
                    and C.text
                    or C.text_dim
            )

        local world_icon_handle =
            FALLEN_WORLD_TAB_ICON_GET()

        if world_icon_handle
            and type(DrawImage) == "function"
        then
            local world_icon_col =
                (
                    S.tab == 2
                    and (tonumber(S.visuals_subtab) or 0) == 1
                )
                    and C.accent
                    or C.text_dim

            -- Static tab icon: hover does not whiten or resize it.
            local world_icon_size = 18

            local world_icon_px =
                FALLEN_UI_LEN(
                    world_icon_size
                )

            local world_icon_cx =
                FALLEN_UI_X(
                    child_x + 19
                )

            local world_icon_cy =
                FALLEN_UI_Y(
                    world_y + 16
                )

