        C.border     = { 0.210, 0.220, 0.250, 0.18 }
        C.divider    = { 0.220, 0.230, 0.260, 0.15 }

        C.text       = { 0.700, 0.710, 0.740, 1.00 }
        C.text_dim   = { 0.485, 0.500, 0.555, 1.00 }
        C.text_faint = { 0.320, 0.340, 0.410, 1.00 }

    elseif t == "gradient"
        or t == "blur"
    then
        -- Real two-color diagonal gradient.
        -- Legacy "blur" configs migrate to Gradient.
        S.menu_type = "gradient"

        -- The shell itself is drawn separately at fixed 50% opacity.
        C.outer      = { 0.000, 0.000, 0.000, 0.00 }
        C.sidebar    = { 0.000, 0.000, 0.000, 0.00 }
        C.content    = { 0.000, 0.000, 0.000, 0.00 }

        C.card       = { 0.055, 0.058, 0.067, 0.72 }
