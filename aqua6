function FALLEN_ARMOR_SAFE_NAME(inst)
    if not inst then return nil end
    local ok, name =
        pcall(function()
            if inst.get_name then
                return inst:get_name()
            end
            return inst.Name
        end)
    if ok then
        return name
    end
    return nil
end

function FALLEN_ARMOR_CHAR(p)
    if not p then return nil end

    if p.character_addr
        and p.character_addr ~= 0
        and rbx
        and type(rbx.instance) == "function"
    then
        local ok, char =
            pcall(
                rbx.instance,
                p.character_addr
            )
        if ok and char then
            return char
        end
    end

    if p.hrp_addr
        and p.hrp_addr ~= 0
        and rbx
        and type(rbx.instance) == "function"
    then
        local ok, hrp =
            pcall(
                rbx.instance,
                p.hrp_addr
            )

        if ok and hrp then
            local ok_parent, par =
                pcall(function()
                    return hrp:parent()
                end)

            if ok_parent and par then
                return par
            end
        end
    end

    if rbx
        and type(rbx.players_service) == "function"
        and p.name
    then
        local ok, ps =
            pcall(
                rbx.players_service
            )

        if ok and ps then
            local ok_plr, plr =
                pcall(function()
                    return ps:find_first_child(p.name)
                end)

            if ok_plr and plr then
                local ok_char, char =
                    pcall(function()
                        return plr:get_character()
                    end)

                if ok_char then
                    return char
                end
            end
        end
    end

    return nil
end

function FALLEN_ARMOR_NORMALIZE_ID(name)
    if not name then return nil end

    local id =
        string.match(
            tostring(name),
            "Armor[_%s]%d+"
        )

    if not id then
        return nil
    end

    id =
        string.gsub(
            id,
            " ",
            "_"
        )

    if id == "Armor_308"
        or id == "Armor_309"
    then
        return nil
    end

    return id
end

function FALLEN_ARMOR_SCAN(root, out_items, seen, depth)
    if not root
        or depth > 12
    then
        return
    end

    local ok, children =
        pcall(function()
            return root:get_children()
        end)

    if not ok
        or type(children) ~= "table"
    then
        return
    end

    for _, child in ipairs(children) do
        local name =
            FALLEN_ARMOR_SAFE_NAME(child)

        local id =
            FALLEN_ARMOR_NORMALIZE_ID(name)

        local display =
            id
            and FALLEN_ARMOR_MAP[id]
            or nil

        if display
            and not seen[display]
        then
            seen[display] = true
            out_items[#out_items + 1] = display
        end

        FALLEN_ARMOR_SCAN(
            child,
            out_items,
            seen,
            depth + 1
        )
    end
end

function FALLEN_ARMOR_PLAYER_KEY(p)
    if not p then return "nil" end
    return tostring(
        p.address
        or p.player_addr
        or p.character_addr
        or p.name
        or p.Name
        or p
    )
end

function FALLEN_ARMOR_CLEAN_TOOL_NAME(name)
    if not name
        or name == ""
    then
        return nil
    end

    name = tostring(name)
    name = string.gsub(name, "^%s+", "")
    name = string.gsub(name, "%s+$", "")

    if name == "" then
        return nil
    end

    return name
end

