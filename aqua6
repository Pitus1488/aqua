    return {
        r,
        g,
        b,
        clamp((tonumber(S.aim_fov_alpha) or 100) / 100, 0, 1),
    }
end

function FALLEN_SILENT_FOV_COLOR()
    local r, g, b =
        hsv_to_rgb(
            S.silent_fov_h,
            S.silent_fov_s,
            S.silent_fov_v
        )

    return {
        r,
        g,
        b,
        clamp(
            (tonumber(S.silent_fov_alpha) or 100) / 100,
            0,
