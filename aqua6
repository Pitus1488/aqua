local function clamp(x,a,b) return math.max(a,math.min(b,x)) end
local function mix(a,b,t) return a+(b-a)*clamp(t,0,1) end
local function approach(v,goal,dt,speed) return mix(v,goal,clamp(dt*speed,0,1)) end
local function quad(t) t=clamp(t,0,1); return 1-(1-t)*(1-t) end
local function rgb(r,g,b,a) return {r/255,g/255,b/255,a or 1} end
local COLORS = {
    side = rgb(7,15,25), white=rgb(255,255,255), gray=rgb(180,180,180),
    dim=rgb(82,96,110), divider=rgb(23,50,83), field=rgb(3,5,13),
    nav=rgb(13,98,144), line=rgb(33,71,118), notify=rgb(15,25,39),
    red=rgb(235,65,65), green=rgb(50,240,120), dark=rgb(3,30,58)
}
local function tocolor(v)
    if type(v) ~= 'table' then return {1,1,1,1} end
    if v.r ~= nil then return {v.r or 1,v.g or 1,v.b or 1,v.a or 1} end
    if v.R ~= nil then return {v.R or 1,v.G or 1,v.B or 1,v.A or 1} end
    return {v[1] or 1,v[2] or 1,v[3] or 1,v[4] or 1}
end
local function hsv(h,s,v)
    local i=math.floor(h*6); local f=h*6-i
    local p=v*(1-s); local q=v*(1-f*s); local t=v*(1-(1-f)*s)
    i=i%6
    if i==0 then return {v,t,p,1} elseif i==1 then return {q,v,p,1}
    elseif i==2 then return {p,v,t,1} elseif i==3 then return {p,q,v,1}
    elseif i==4 then return {t,p,v,1} else return {v,p,q,1} end
end
local function tohsv(col)
    local c=tocolor(col); local r,g,b=c[1],c[2],c[3]
    local maxv=math.max(r,g,b); local minv=math.min(r,g,b); local d=maxv-minv
    local h,s=0,0
    if d>0 then
        if maxv==r then h=((g-b)/d)%6 elseif maxv==g then h=(b-r)/d+2
        else h=(r-g)/d+4 end
        h=h/6
    end
    if maxv>0 then s=d/maxv end
    return h,s,maxv
end
local function hex(col)
    local c=tocolor(col)
    return string.format('%02X%02X%02X', math.floor(c[1]*255+.5),math.floor(c[2]*255+.5),math.floor(c[3]*255+.5))
end
local function fromhex(s)
    s=tostring(s or ''):gsub('#','')
    if #s~=6 or not s:match('^%x+$') then return nil end
    return {tonumber(s:sub(1,2),16)/255,tonumber(s:sub(3,4),16)/255,tonumber(s:sub(5,6),16)/255,1}
end

local function box(x,y,w,h,c,a)
    if w<=0 or h<=0 then return end
    c=tocolor(c); Drawing.DrawBoxFilled(x,y,x+w,y+h,c[1],c[2],c[3],(c[4] or 1)*(a or 1))
end
local function line(x1,y1,x2,y2,c,a,th)
    c=tocolor(c); Drawing.DrawLine(x1,y1,x2,y2,c[1],c[2],c[3],(c[4] or 1)*(a or 1),th or 1)
end
local function circ(x,y,r,c,a)
    c=tocolor(c); Drawing.DrawCircleFilled(x,y,r,c[1],c[2],c[3],(c[4] or 1)*(a or 1))
end
local function rounded(x,y,w,h,r,c,a)
    if w<=0 or h<=0 then return end
    r=math.floor(math.max(0,math.min(r,w/2,h/2)))
    if r==0 then return box(x,y,w,h,c,a) end
    box(x+r,y,w-r*2,h,c,a)
    box(x,y+r,r,h-r*2,c,a)
    box(x+w-r,y+r,r,h-r*2,c,a)
    for t=0,r-1 do
        local dy=r-t-.5
        local dx=r-math.sqrt(math.max(0,r*r-dy*dy))
        box(x+dx,y+t,w-2*dx,1,c,a)
        box(x+dx,y+h-t-1,w-2*dx,1,c,a)
    end
end
local function outline(x,y,w,h,c,a,th)
    local t=th or 1
    box(x,y,w,t,c,a); box(x,y+h-t,w,t,c,a); box(x,y,t,h,c,a);box(x+w-t,y,t,h,c,a)
end
local function text(x,y,str,c,a)
    c=tocolor(c); Drawing.DrawText(x,y,tostring(str or ''),c[1],c[2],c[3],(c[4] or 1)*(a or 1))
end
local function label(x,y,str,c,a)
    text(x+1,y+1,str,COLORS.field,(a or 1)*.8)
    text(x,y,str,c,a)
end
local function triangle(x,y,dir,c,a)
    if dir=='down' then
        for n=0,5 do line(x-n,y+n*.6,x+n,y+n*.6,c,a,1) end
    elseif dir=='up' then
        for n=0,5 do line(x-n,y-n*.6,x+n,y-n*.6,c,a,1) end
    end
end
local function safeCallback(fn, ...)
    if type(fn)~='function' then return end
    local ok,err=pcall(fn,...)
    if not ok then notify('Neverlose callback: '..tostring(err),'error') end
end

local runtime = {
    s=1, x=0,y=0, w=846,h=682, mx=-100,my=-100,
    down=false, pressed=false, released=false, wasDown=false,
    regions={}, current=nil, drag=nil, focus=nil, popup=nil,
    alpha=0, frameTime=tick(), keysDown={},
    keyboardRepeat={}, cursorBlink=0, notices={}, win=nil
}
local function vx(x) return runtime.x+x*runtime.s end
local function vy(y) return runtime.y+y*runtime.s end
local function vbox(x,y,w,h,col,a) box(vx(x),vy(y),w*runtime.s,h*runtime.s,col,a) end
local function vrounded(x,y,w,h,r,c,a) rounded(vx(x),vy(y),w*runtime.s,h*runtime.s,r*runtime.s,c,a) end
local function vline(x,y,x2,y2,c,a,th) line(vx(x),vy(y),vx(x2),vy(y2),c,a,(th or 1)*runtime.s) end
local function vtext(x,y,str,c,a) text(vx(x),vy(y),str,c,a) end
local function vcircle(x,y,r,c,a) circ(vx(x),vy(y),r*runtime.s,c,a) end
local function vring(x,y,r,c,a,th)
    local cc=tocolor(c)
    Drawing.DrawCircle(vx(x),vy(y),r*runtime.s,cc[1],cc[2],cc[3],(cc[4] or 1)*(a or 1),(th or 1)*runtime.s)
end
local function inside(x,y,w,h) return runtime.mx>=x and runtime.mx<=x+w and runtime.my>=y and runtime.my<=y+h end
local function region(x,y,w,h,callback,kind,meta)
    runtime.regions[#runtime.regions+1]={x=x,y=y,w=w,h=h,callback=callback,kind=kind,meta=meta}
    return inside(x,y,w,h)
end
local function clickableText(x,y,w,h,name,action,c)
    local hot=region(x,y,w,h,action)
    vtext(x,y,name,hot and UI.Theme.Custom.Glow or (c or COLORS.gray),runtime.alpha)
    return hot
end
local function visibleItem(item)
    local search=runtime.win and runtime.win.searchValue or ''
    if item.visible==false then return false end
    if search~='' then return tostring(item.title or ''):lower():find(search:lower(),1,true)~=nil end
    return true
end

local function newItem(section,kind,title,cb)
    local it={kind=kind,title=tostring(title or kind),Value=false,callback=cb,visible=true,
        hover=0,knob=0,valueAnim=0,expand=0,hasPopup=false,section=section}
    section.items[#section.items+1]=it
    UI.Flags[it.title]=it
    function it:visibility(state) self.visible=not not state end
    function it:Set(value)
        self.Value=value
        safeCallback(self.callback,value)
    end
    return it
end

local function createSection(tab,name)
    local section={title=tostring(name or 'Section'),items={},tab=tab,col=1,h=51}
    tab.sections[#tab.sections+1]=section
    local group={}
    function group:Button(title,cb)
        local it=newItem(section,'button',title,cb); it.Value=false;return it
    end
    function group:Toggle(title,cb)
        local it=newItem(section,'toggle',title,cb);it.Value=false;return it
    end
    function group:Line()
        local it=newItem(section,'line','',nil);return it
    end
    function group:Dropdown(title,list,cb)
        local it=newItem(section,'dropdown',title,cb)
        it.list=type(list)=='table' and list or {};it.Value=''
        function it:Refresh(newList) self.list=type(newList)=='table' and newList or {} end
        return it
    end
    function group:Slider(title,min,max,start,cb)
        local it=newItem(section,'slider',title,cb)
        it.min=tonumber(min) or 0; it.max=tonumber(max) or 100
        if it.max<=it.min then it.max=it.min+1 end
        it.Value=clamp(tonumber(start) or it.min,it.min,it.max)
        it.valueAnim=(it.Value-it.min)/(it.max-it.min)
        function it:Set(value)
            self.Value=clamp(tonumber(value) or self.min,self.min,self.max)
            safeCallback(self.callback,self.Value)
        end
        return it
    end
    function group:TextBox(title,cb)
        local it=newItem(section,'textbox',title,cb); it.Value='';return it
    end
    function group:Colorpicker(title,preset,cb)
        local it=newItem(section,'color',title,cb)
        it.Value=tocolor(preset or UI.Theme.Custom.Element)
        it.h,it.s,it.v=tohsv(it.Value)
        function it:Set(value)
            self.Value=tocolor(value); self.h,self.s,self.v=tohsv(self.Value)
            safeCallback(self.callback,self.Value)
        end
        function it:GetRGBText(r,g,b)
            if type(r)=='table' then return hex(r) end
            return hex({r or 0,g or 0,b or 0,1})
        end
        function it:GetFromRGBText(s) return fromhex(s) end
        return it
    end
    function group:Bind(title,cb,external)
        local it=newItem(section,'bind',title,cb)
        it.key=0;it.mode='Toggle';it.Value=false;it.capture=false
        if type(external)=='table' and type(external[1])=='table' then
            local e=external[1]
            it.key=e.key or 0
            it.mode=e.Toggled and 'Toggle' or 'Hold'
        end
        function it:Set(val)
            if type(val)=='number' then self.key=val else self.Value=not not val end
            safeCallback(self.callback,self.Value)
        end
        return it
    end
    -- Same naming as the original UI library.
    group._section=section
    return group
end
local function createTab(parent,title)
    local tab={title=tostring(title or 'Tab'), sections={}, highlight=0,scroll=0,targetScroll=0}
    parent.tabs[#parent.tabs+1]=tab
    if parent.win.selected==nil then parent.win.selected=tab;tab.highlight=1 end
    local t={}
    function t:Section(name) return createSection(tab,name) end
    t._tab=tab
    return t
end
local function createTSection(win,title)
    local group={title=tostring(title or 'Other'),tabs={},win=win}
    win.groups[#win.groups+1]=group
    local holder={}
    function holder:Tab(name) return createTab(group,name) end
    holder._group=group
    return holder
end

function UI:SetCFG(name) self.Targeted_Config=tostring(name or '') end
function UI:VisMain(v) self.Visible=not not v end
function UI:Notify(cfg)
    cfg=cfg or {}
    if type(cfg)=='string' then cfg={Text=cfg} end
    local n={ title=tostring(cfg.Title or 'Neverlose'),
        desc=tostring(cfg.Text or ''), duration=tonumber(cfg.Time) or 2,
        birth=tick(), closed=false }
    runtime.notices[#runtime.notices+1]=n
    if #runtime.notices>6 then table.remove(runtime.notices,1) end
end

local function basePath()
    local win=runtime.win
    local folder=win and win.folder or 'Neverlose'
    folder=tostring(folder):gsub('[^%w_%-]','_')
    return 'C:\\blueberry\\scripts\\NeverloseReplica\\'..folder..'\\'
end
local function saveJson(path,obj)
    local data,err=Json.encode(obj,true)
    if not data then return false,err end
    return write_file(path,data)
end
local function loadJson(path)
    local raw=read_file(path)
    if not raw then return nil end
    local data=Json.decode(raw)
    if type(data)~='table' then return nil end
    return data
end
local function configIndex()
    local t=loadJson(basePath()..'index.json')
    return type(t)=='table' and t or {}
end
function UI:GetConfigNames() return configIndex() end
function UI:SaveCfg(name)
    name=tostring(name or self.Targeted_Config or '')
    if name=='' then self:Notify({Text='Please Select a config first!'}) return false end
    local data={}
    for key,item in pairs(self.Flags) do
        if item.kind and item.kind~='button' and item.kind~='line' then
            data[key]=item.Value
        end
    end
    local ok=saveJson(basePath()..name:gsub('[^%w_%-]','_')..'.json',data)
    if ok then
        local list=configIndex(); local found=false
        for _,v in ipairs(list) do if v==name then found=true break end end
        if not found then list[#list+1]=name;saveJson(basePath()..'index.json',list) end
        self.Targeted_Config=name
        self:Notify({Title='Neverlose',Text='Saved to: '..name})
    else self:Notify({Title='Neverlose',Text='Config save failed'}) end
    return ok
end
function UI:CreateCfg(name) return self:SaveCfg(name) end
function UI:LoadCfg(name)
    name=tostring(name or self.Targeted_Config or '')
    local data=loadJson(basePath()..name:gsub('[^%w_%-]','_')..'.json')
    if not data then self:Notify({Text='Config not found: '..name}) return false end
    for key,value in pairs(data) do
        local it=self.Flags[key]
        if it and it.Set then it:Set(value) end
    end
    self.Targeted_Config=name
    self:Notify({Title='Neverlose',Text='Loaded Config: '..name})
    return true
end

function UI:Window(cfg)
    cfg=cfg or {}
    local win={title=tostring(cfg.Title or 'Neverlose'),folder=tostring(cfg.CFG or 'Neverlose'),
        groups={},selected=nil,search=false,searchAnim=0,searchValue='',
        settings=false,settingsAnim=0,scriptPanel=false,chatPanel=false,
        saveHovered=0,navScroll=0,theme='Original',
        bindsView=true, opened=true,
        keyRequired=cfg.External and cfg.External.KeySystem==true or false,
        keyAllowed=cfg.External and cfg.External.Key or {},
        keyAuthorized=false,keyObject={kind='keyinput',Value=''},
        keyRemember=false,keyAllowData=true,keyStart=nil,keyDeniedAt=0}
    win.keyAuthorized=not win.keyRequired
    runtime.win=win
    UI._windows[1]=win
    if win.keyRequired then
        local remembered=read_file(basePath()..'key.txt')
        if remembered and remembered~='' then
            for _,key in ipairs(win.keyAllowed) do
                if remembered==key then
                    win.keyObject.Value=remembered
                    win.keyRemember=true
                    win.keyAuthorized=true
                    break
                end
            end
        end
    end
    UI.SettingsFlags['Key Holder']=win.keyObject
    function win.keyObject:Set(value) self.Value=tostring(value or '') end
    UI.SettingsFlags['Remember My Key']={Value=win.keyRemember,Set=function(self,v)
        self.Value=not not v;win.keyRemember=self.Value
    end}
    UI.SettingsFlags['Allow Player Data']={Value=true,Set=function(self,v)
        self.Value=not not v;win.keyAllowData=self.Value
    end}
    -- Original user profile picture: retrieve on the image loader's background
    -- thread; failure simply falls back to the drawn profile icon.
    local pl=rbx.local_player()
    if pl then
        local uid=pl:user_id()
        if uid then
            local address='https://www.roblox.com/headshot-thumbnail/image?userId='..tostring(uid)..'&width=150&height=150&format=png'
            UI._avatar=Drawing.LoadImage(address)
        end
    end
    local tabs={}
    function tabs:TSection(name) return createTSection(win,name) end
    tabs._window=win
    -- The original generates this group itself. We provide it on launch too.
    local lua=tabs:TSection('Lua')
    local configTab=lua:Tab('Configs')
    local load=configTab:Section('Load Config')
    local creation=configTab:Section('Create Config')
    local theme=configTab:Section('UI Color')
    local key=configTab:Section('Keys')
    local cfgName='NewConfig'
    creation:TextBox('Config Name',function(v) cfgName=v end):Set('NewConfig')
    creation:Button('Create Config',function() UI:CreateCfg(cfgName) end)
    local picker=load:Dropdown('Select Config',UI:GetConfigNames(),function(v) UI:SetCFG(v) end)
    load:Button('Refresh Configs',function() picker:Refresh(UI:GetConfigNames()) end)
    load:Line()
    load:Button('Load Selected Config',function() UI:LoadCfg(UI.Targeted_Config) end)
    for _,desc in ipairs({'Background','Section','Element','Text','Glow'}) do
        theme:Colorpicker(desc,UI.Theme.Custom[desc],function(v) UI.Theme.Custom[desc]=tocolor(v) end)
    end
    local menuBind=key:Bind('Toggle Menu',function(state) UI.Visible=state end,{{key=cfg.Key or VK.CTRL,Toggled=true}})
    menuBind:Set(true)
    key:Toggle('Open Menu On Launch',function(v) win.opened=v end):Set(true)
    self:Notify({Title='Welcome',Text='Menu Key | LeftControl',Time=2})
    return tabs
end

local function mousePosition()
    local mp=Windows.GetMousePos()
    if not mp then return -10000,-10000 end
    local px,py=mp.X,mp.Y
    local hwnd=Windows.GetRobloxWindow()
    if hwnd then
        local wr=Windows.GetWindowRect(hwnd)
        local sz=Windows.GetRobloxClientSize()
        if wr and sz then
            local left=(wr.Width-(sz.Width or wr.Width))/2
            local top=(wr.Height-(sz.Height or wr.Height))-left
            px=px-wr.Left-math.max(0,left)
            py=py-wr.Top-math.max(0,top)
        end
    end
    return px-UI.MouseOffsetX,py-UI.MouseOffsetY
end
local function keyString(k)
    if not k or k==0 then return 'None' end
    for _,nm in ipairs({'CTRL','SHIFT','ALT','SPACE','TAB','ENTER','ESC'}) do
        if VK[nm]==k then return nm end
    end
    for n=1,12 do if VK['F'..n]==k then return 'F'..n end end
    for n=0,9 do if VK['NUM'..n]==k then return tostring(n) end end
    for ch=65,90 do if VK[string.char(ch)]==k then return string.char(ch) end end
    return tostring(k)
end
local KEY_INPUT={}
for j=65,90 do KEY_INPUT[#KEY_INPUT+1]={vk=j,char=string.char(j)} end
for j=48,57 do KEY_INPUT[#KEY_INPUT+1]={vk=j,char=string.char(j)} end
KEY_INPUT[#KEY_INPUT+1]={vk=VK.SPACE,char=' '}
KEY_INPUT[#KEY_INPUT+1]={vk=0xBD,char='-'}
KEY_INPUT[#KEY_INPUT+1]={vk=0xBE,char='.'}
KEY_INPUT[#KEY_INPUT+1]={vk=0xBF,char='/'}
KEY_INPUT[#KEY_INPUT+1]={vk=0xBB,char='='}
KEY_INPUT[#KEY_INPUT+1]={vk=0xBC,char=','}
KEY_INPUT[#KEY_INPUT+1]={vk=VK.BACKSPACE,char='\b'}
KEY_INPUT[#KEY_INPUT+1]={vk=VK.ENTER,char='\n'}
local captureVK={VK.CTRL,VK.SHIFT,VK.ALT,VK.SPACE,VK.TAB,VK.ENTER,VK.ESC}
for j=65,90 do captureVK[#captureVK+1]=j end
for j=48,57 do captureVK[#captureVK+1]=j end
for j=112,123 do captureVK[#captureVK+1]=j end
local function isDown(vk) return vk and vk~=0 and Windows.IsKeyPressed(vk) end
local function edge(vk)
    local d=isDown(vk)
    local prev=runtime.keysDown[vk]
    runtime.keysDown[vk]=d
    return d and not prev
end
local function inputUpdate(dt)
    local win=runtime.win
    if not win then return end
    if runtime.focus then
        local target=runtime.focus
        for _,k in ipairs(KEY_INPUT) do
            local down=isDown(k.vk)
            local rec=runtime.keyboardRepeat[k.vk]
            if down and (not rec or tick()-rec>.32) then
                runtime.keyboardRepeat[k.vk]=tick()-(rec and .26 or 0)
                if k.char=='\n' then
                    runtime.focus=nil
                    if target.kind=='textbox' then
                        safeCallback(target.callback,target.Value)
                    elseif target.kind=='slidertext' then
                        target.item:Set(tonumber(target.Value) or target.item.Value)
                    elseif target.kind=='hex' then
                        local col=fromhex(target.Value)
                        if col then target.item:Set(col) end
                    end
                elseif k.char=='\b' then
                    target.Value=tostring(target.Value):sub(1,-2)
                else
                    local char=k.char
                    if k.vk>=65 and k.vk<=90 and not isDown(VK.SHIFT) then char=char:lower() end
                    target.Value=tostring(target.Value)..char
                end
            elseif not down then runtime.keyboardRepeat[k.vk]=nil end
        end
        if edge(VK.ESC) then runtime.focus=nil end
    else
        -- The configured Toggle Menu binding is handled by the Bind engine below.
        -- Avoid also toggling it here; that would fire twice on the same press.
    end
    -- Bind modes and capture keys; all keys are documented Win32 virtual keys.
    local popup=runtime.popup
    if popup and popup.kind=='bindcapture' then
        for _,v in ipairs(captureVK) do
            if edge(v) then
                if v~=VK.ESC then popup.item.key=v else popup.item.key=0 end
                runtime.popup=nil
                break
            end
        end
    end
    for _,group in ipairs(win.groups) do
        for _,tab in ipairs(group.tabs) do
            for _,sec in ipairs(tab.sections) do
                for _,it in ipairs(sec.items) do
                    if it.kind=='bind' and it.key and it.key~=0 and runtime.focus==nil and not (runtime.popup and runtime.popup.kind=='bindcapture') then
                        local current=isDown(it.key)
                        if it.mode=='Hold' then
                            if current~=it.Value then it:Set(current) end
                        elseif it.mode=='Always' then
                            if not it.Value then it:Set(true) end
                        elseif it.mode=='None' then
                            if it.Value then it:Set(false) end
                        elseif current and not it.wasKey then
                            it:Set(not it.Value)
                        end
                        it.wasKey=current
                    end
                end
            end
        end
    end
end

local function placeSections(tab)
    local heights={0,0}
    for _,sec in ipairs(tab.sections) do
        local count=0
        for _,it in ipairs(sec.items) do
            if visibleItem(it) then
                if it.kind=='line' then count=count+10 else count=count+34 end
            end
        end
