-- It is intentionally drawn next to the menu so we can tell immediately
-- whether the URL resolved/decoded independently from tracer logic.
function FALLEN_BT_DRAW_GALAXY_PREVIEW()
    if S.visible ~= true
        or type(DrawBoxFilled) ~= "function"
        or type(DrawText) ~= "function"
    then
        return
    end

    local rect =
        FALLEN_WEATHER_MENU_RECT

    if type(rect) ~= "table" then
        return
    end

    local box_w = 132
    local box_h = 136
    local px =
        (tonumber(rect.x) or 0)
        + (tonumber(rect.w) or 0)
        + 10

    if px + box_w
        > (tonumber(rect.screen_w) or 0) - 6
    then
        px =
            (tonumber(rect.x) or 0)
            - box_w
            - 10
    end

    px = math.max(6, px)

    local py =
        math.max(
            6,
            (tonumber(rect.y) or 0) + 52
        )

    -- SAME getter as Aimbot icon: resolve page once, LoadImage once,
    -- then wait for IsImageReady. No custom HTTP/local-file path here.
    local handle =
        FALLEN_BT_GALAXY_HANDLE()

    local raw_handle =
        _G.FALLEN_GALAXY_IMAGE_HANDLE

    local ready =
        handle ~= nil

    local failed = false

    if raw_handle
        and type(IsImageFailed) == "function"
    then
        pcall(function()
            failed =
                IsImageFailed(raw_handle)
                == true
        end)
    end

    DrawBoxFilled(
        px,
        py,
        box_w,
        box_h,
        0.035,
        0.038,
        0.047,
        0.94 * MENU_RENDER_ALPHA
    )

    DrawBox(
        px,
        py,
        box_w,
        box_h,
        0.23,
        0.25,
        0.31,
        0.95 * MENU_RENDER_ALPHA,
        1
    )

    if ready
        and not failed
        and type(DrawImage) == "function"
    then
        -- Same DrawImage signature used by the Aimbot tab icon.
        pcall(
            DrawImage,
            handle,
            px + 16,
            py + 12,
            100,
            100,
            1,
            1,
            1,
            MENU_RENDER_ALPHA,
            0
        )
    else
        DrawBoxFilled(
            px + 16,
            py + 12,
            100,
            100,
            failed and 0.22 or 0.09,
            failed and 0.04 or 0.10,
            failed and 0.05 or 0.15,
            0.92 * MENU_RENDER_ALPHA
        )
    end

    local status =
        ready and not failed
        and "GALAXY READY"
        or (
            failed
            and "GALAXY FAILED"
            or "GALAXY LOADING"
        )

    local sr, sg, sb =
        ready and not failed and 0.45 or 1.0,
        ready and not failed and 1.0 or (failed and 0.32 or 0.82),
        ready and not failed and 0.62 or (failed and 0.35 or 0.30)

    DrawText(
        px + 12,
        py + 117,
        status,
        sr,
        sg,
        sb,
        MENU_RENDER_ALPHA
    )
end

