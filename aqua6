    C.accent = {
        accent_r,
        accent_g,
        accent_b,
        accent_a,
    }

    -- Derived accent variants keep sliders/toggles/soft highlights in the
    -- same chosen hue instead of leaving old hard-coded blue pieces behind.
    C.accent_dim = {
        accent_r * 0.76,
        accent_g * 0.76,
        accent_b * 0.79,
        accent_a,
