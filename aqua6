function FALLEN_BT_VFX_POSITION(
    inst
)
    if not FALLEN_BT_VFX_IS_IMPACT_NAME(
        inst
    )
    then
        return nil
    end

    local impact_name = nil

    pcall(function()
        impact_name =
            string.lower(
                tostring(
                    inst:get_name()
                    or ""
                )
            )
    end)

    -- CasingLarge / CasingSmall are only container Models.
    -- Their actual positional MeshPart is:
    -- CasingLarge -> Main
    -- CasingSmall -> Main
    if impact_name == "casinglarge"
        or impact_name == "casingsmall"
    then
        local main = nil

        pcall(function()
            main =
                inst:find_first_child(
                    "Main"
                )
        end)

        if main
            and FALLEN_BT_VFX_INSTANCE_VALID(
                main
            )
        then
            local class_name = nil

            pcall(function()
                class_name =
                    main:get_class()
            end)

            if class_name == "MeshPart"
                or class_name == "Part"
                or class_name == "UnionOperation"
                or class_name == "BasePart"
            then
                local main_pos = nil

                pcall(function()
                    main_pos =
                        main:get_position()
                end)

                if main_pos
                    and main_pos.X ~= nil
                    and main_pos.Y ~= nil
                    and main_pos.Z ~= nil
                then
                    return {
                        X = main_pos.X,
                        Y = main_pos.Y,
                        Z = main_pos.Z,
                    }
                end
            end
        end

        -- Do not fall back to the Model or some unrelated child.
        return nil
    end

    -- Hole / MetalHole / BloodPart:
    -- first use the object itself if it has a world position.
    local pos = nil

    pcall(function()
        pos =
            inst:get_position()
    end)

    if pos
        and pos.X ~= nil
        and pos.Y ~= nil
        and pos.Z ~= nil
    then
        return {
            X = pos.X,
            Y = pos.Y,
            Z = pos.Z,
        }
    end

    -- If one of those is a Model/Folder, keep the old direct-child fallback.
    local children = nil

    pcall(function()
        children =
            inst:get_children()
    end)

    if type(children) == "table" then
        for _, child in ipairs(children) do
            if FALLEN_BT_VFX_INSTANCE_VALID(
                child
            )
            then
                local class_name = nil

                pcall(function()
                    class_name =
                        child:get_class()
                end)

                if class_name == "MeshPart"
                    or class_name == "Part"
                    or class_name == "UnionOperation"
                    or class_name == "BasePart"
                then
                    local child_pos = nil

                    pcall(function()
                        child_pos =
                            child:get_position()
                    end)

                    if child_pos
                        and child_pos.X ~= nil
                        and child_pos.Y ~= nil
                        and child_pos.Z ~= nil
                    then
                        return {
                            X = child_pos.X,
                            Y = child_pos.Y,
                            Z = child_pos.Z,
                        }
                    end
                end
            end
        end
    end

    return nil
end


