local function toggle_row(mx, my, clicked, x, y, w, label, key, extra)
    clicked =
        clicked
        and not FALLEN_ANY_DROPDOWN_MODAL_ACTIVE()

    local h = 41
    local hot = row_hover(mx, my, x, y, w, h)
    local value = S[key] == true

    if clicked and hot then
        value = not value
        S[key] = value

        -- A new Menu Glow toggle needs a visible first-use preset.
        if key == "menu_glow_enabled" and value == true then
            if (tonumber(S.menu_glow_strength) or 0) <= 0 then
                S.menu_glow_strength = 70
            end
            if (tonumber(S.menu_glow_v) or 0) <= 0.001 then
                S.menu_glow_v = 1
            end
        end

        if type(FALLEN_SILENT_UI_VALUE_CHANGED) == "function" then
            FALLEN_SILENT_UI_VALUE_CHANGED(
                key,
                value
            )
        end
    end

    local target = value and 1 or 0
    local anim = A.toggles[key]

    if anim == nil then
        anim = target
    end

    -- Source Checkbox(): ImLerp(..., 0.08f)
    anim = lerp(anim, target, 0.08)

    if math.abs(anim - target) < 0.0015 then
        anim = target
    end

    A.toggles[key] = anim

    if FALLEN_POPUP_CHECK_KEYS[key] then
        -- Unchecked: flush-left text, no reserved checkbox space.
        -- Checked: animate the text to the right while a tick fades in.
        if hot then
            rounded_fill(x + 5, y + 4, w - 10, h - 8, 5, C.button_hovered)
        end
        local shift = 18 * anim
        local cx, cy = x + 17, y + h * 0.5
        if anim > 0.015 then
            local tick_color = alpha(C.text, anim)
            line(cx - 5, cy, cx - 1, cy + 4, tick_color, 1.4)
            line(cx - 1, cy + 4, cx + 6, cy - 4, tick_color, 1.4)
        end
        text(x + 13 + shift, y + 14, label,
            mix_color(C.text_dim, C.text, anim))
        return
    end

    text(
        x + 13,
        y + 14,
        label,
        value and C.text or C.text_dim
    )

    if extra then
        local dots_x = x + w - 76
        local dots_y = y + 8
        local dots_w = 27
        local dots_h = 25
        local dots_hot = hover(mx, my, dots_x, dots_y, dots_w, dots_h)

        if dots_hot then
            rounded_fill(
                dots_x,
                dots_y,
                dots_w,
                dots_h,
                4,
                C.button_hovered
            )
        end

        centered_text(
            dots_x + dots_w * 0.5,
            y + 13,
            "...",
            dots_hot and C.text or C.text_dim
        )
    end

    -- Exact source switch geometry: 30x17, radius 10, knob radius 7.
    local tx = x + w - 42
    local ty = y + 12
    local tw, th = 30, 17

    draw_switch_track(tx, ty, tw, th, C.frame_inactive, C.frame_active, anim)

    local knob_x = tx + 8 + 14 * anim

    circle_fill(
        knob_x,
        ty + th * 0.5,
        7,
        value and C.accent or C.text_dim
    )
end

local function slider_row(mx, my, clicked, lmb, x, y, w, label, key, minv, maxv, fmt)
    local dropdown_modal =
        FALLEN_ANY_DROPDOWN_MODAL_ACTIVE()

    clicked =
        clicked
        and not dropdown_modal

    lmb =
        lmb
        and not dropdown_modal

    local h = 41
    row_hover(mx, my, x, y, w, h)

    local number_w = 38
    local number_h = 18
    local number_x = x + w - number_w - 10
    local number_y = y + 11

    -- Source slider: 92px bar immediately left of the value box.
    local track_w = 92
    local track_x = number_x - 8 - track_w
    local track_y = y + 19

    local current = tonumber(S[key]) or minv
    current = clamp(current, minv, maxv)

    if A.slider_target[key] == nil then
        A.slider_target[key] = current
    end

    if A.slider_visual[key] == nil then
        A.slider_visual[key] = current
    end

    local value_hot =
        hover(
            mx,
            my,
            number_x,
            number_y,
            number_w,
            number_h
        )

    if clicked and value_hot then
        A.active_slider = nil

        if A.numeric.active_key ~= key then
            numeric_start(key, minv, maxv, fmt)
        end
    end

    local editing = A.numeric.active_key == key

    local track_hot =
        hover(
            mx,
            my,
            track_x - 6,
            y + 7,
            track_w + 12,
            27
        )

    if clicked and track_hot and not value_hot then
        numeric_stop(true)
        A.active_slider = key
    end

    local active = A.active_slider == key

    if active and lmb then
        local nt =
            clamp(
                (mx - FALLEN_UI_X(track_x))
                / FALLEN_UI_LEN(track_w),
                0,
                1
            )

        A.slider_target[key] =
            minv
            + (maxv - minv) * nt
    end

    local target =
        clamp(
            A.slider_target[key] or current,
            minv,
            maxv
        )

    if editing then
        current =
            clamp(
                tonumber(S[key]) or current,
                minv,
                maxv
            )
    else
        current =
            lerp(
                current,
                target,
                active and 0.34 or 0.22
            )

        if math.abs(current - target) < (maxv - minv) * 0.0002 then
            current = target
        end

        S[key] = current

        if type(FALLEN_SILENT_UI_VALUE_CHANGED) == "function"
            and (
                key == "silent_max_dist"
                or key == "silent_fov"
            )
        then
            FALLEN_SILENT_UI_VALUE_CHANGED(
                key,
                current
            )
        end
    end

    -- Source SliderScalar visual lerp = 0.125f.
    local visual = A.slider_visual[key]
    visual = lerp(visual, current, 0.125)

    if math.abs(visual - current) < (maxv - minv) * 0.00015 then
        visual = current
    end

    A.slider_visual[key] = visual

    local t =
        clamp(
            (visual - minv) / (maxv - minv),
            0,
            1
        )

    text(
        x + 13,
        y + 14,
        label,
        C.text_dim
    )

    rounded_fill(
        track_x,
        track_y,
        track_w,
        4,
        4,
        C.frame_active
    )

    rounded_fill(
        track_x,
        track_y,
        track_w * t,
        4,
        4,
        C.accent
    )

    circle_fill(
        track_x + track_w * t - 2,
        track_y + 2,
        6,
        C.accent
    )

    rounded_fill(
        number_x,
        number_y,
        number_w,
        number_h,
        4,
        C.frame_inactive
    )

    if editing then
        rounded_fill(
            number_x,
            number_y,
            number_w,
            number_h,
            4,
            alpha(C.frame_active, 0.65)
        )
    end

    rounded_outline(
        number_x,
        number_y,
        number_w,
        number_h,
        4,
        C.border,
        1,
        editing
            and alpha(C.frame_active, 0.65)
            or C.frame_inactive
    )

    local shown

    if editing then
        shown = A.numeric.buffer

        if math.floor(tick() * 2) % 2 == 0 then
            shown = shown .. "|"
        end
    elseif fmt == "int" then
        shown =
            tostring(
                math.floor(
                    (tonumber(S[key]) or minv)
                    + 0.5
                )
            )
    else
        shown =
            string.format(
                "%.2f",
                tonumber(S[key]) or minv
            )
    end

    centered_text(
        number_x + number_w * 0.5,
        number_y + 4,
        shown,
        C.text
    )
end

