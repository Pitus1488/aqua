-- Neverlose-source vertical navigation: original 30px animated tabs,
-- section labels and top Save control. Individual Fallen features keep their
-- existing Lua runtimes and state; only their navigation was remapped.
local function FALLEN_NL_NAV_ITEM(mx, my, clicked, x, y, key, label, selected, action)
    local hot = hover(mx, my, x, y, 150, 30)
    A.sidebar_tab_anim[key] = lerp(
        A.sidebar_tab_anim[key] or (selected and 1 or 0),
        selected and 1 or 0, 0.05)
    local a = clamp(A.sidebar_tab_anim[key], 0, 1)
    if a > 0.002 then
        rounded_fill(x, y, 150, 30, 5,
            alpha(C.frame_active, 0.5 * a))
    end
    -- Use Fallen's existing accent-tinted icon PNGs where possible.
    -- Font Awesome glyphs from the C++ source are not exposed by Drawing.
    local icon_handle = nil
    if key == "rage" then
        icon_handle = FALLEN_AIMBOT_TAB_ICON_GET()
    elseif key == "silent" then
        icon_handle = FALLEN_SILENT_TAB_ICON_GET()
    elseif key == "players" then
        icon_handle = FALLEN_VISUALS_TAB_ICON_GET()
    elseif key == "world" then
        icon_handle = FALLEN_WORLD_TAB_ICON_GET()
    elseif key == "armor" then
        icon_handle = FALLEN_ARMOR_TAB_ICON_GET()
    elseif key == "main" then
        icon_handle = FALLEN_MISC_TAB_ICON_GET()
    end
    if icon_handle and type(DrawImage) == "function" then
        local sz = FALLEN_UI_LEN(17)
        local cx = FALLEN_UI_X(x + 19)
        local cy = FALLEN_UI_Y(y + 15)
        pcall(DrawImage, icon_handle,
            cx - sz * 0.5, cy - sz * 0.5, sz, sz,
            C.accent[1], C.accent[2], C.accent[3],
            MENU_RENDER_ALPHA, 0)
    else
        circle(x + 19, y + 15, 5, C.accent, 1.1)
    end
    text(x + 35, y + 8, label, C.text)
    if clicked and hot and type(action) == "function" then
        action()
    end
end

