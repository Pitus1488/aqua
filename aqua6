    pcall(FALLEN_HITFX_SMOKERING_SHEET_GET)
    pcall(FALLEN_HITFX_PARTICLES_SHEET_GET)
    pcall(FALLEN_HITFX_TEST1_SHEET_GET)
    pcall(FALLEN_HITFX_TEST2_SHEET_GET)
    pcall(FALLEN_HITFX_ICE_SHEET_GET)
    pcall(FALLEN_HITFX_CRYSTAL_SHEET_GET)
    pcall(FALLEN_BT_WATER_IMAGE_GET)

    pcall(
        FALLEN_GALAXY_IMAGE_GET
    )

    pcall(
        FALLEN_VISUALS_TAB_ICON_GET
    )

    pcall(
        FALLEN_MISC_TAB_ICON_GET
    )

    pcall(
        FALLEN_SILENT_TAB_ICON_GET
