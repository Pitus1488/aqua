            button = {72 / 255, 118 / 255, 214 / 255},
            branch_icon = {0.780, 0.800, 0.860},
            branch_label = {0.920, 0.920, 0.940},
            popup_border = {0.040, 0.050, 0.070},
        },
    }

    function L.clamp01(t)
        if t < 0 then return 0 end
        if t > 1 then return 1 end
        return t
    end

    function L.clamp(v, a, b)
        if v < a then return a end
        if v > b then return b end
        return v
    end

    function L.ease_in_out_cubic(t)
        t = L.clamp01(t)
        if t < 0.5 then
            return 4 * t * t * t
        end
        return 1 - ((-2 * t + 2) ^ 3) / 2
    end

    function L.bezier_1d(t, a, b)
        local u = 1 - t
        return 3 * u * u * t * a + 3 * u * t * t * b + t * t * t
    end

    function L.bezier_1d_deriv(t, a, b)
        local u = 1 - t
        return 3 * u * u * a + 6 * u * t * (b - a) + 3 * t * t * (1 - b)
    end

    function L.cubic_bezier_ease(x, x1, y1, x2, y2)
        x = L.clamp01(x)
        if x <= 0 then return 0 end
        if x >= 1 then return 1 end

        local t = x
        for _ = 1, 8 do
            local x_est = L.bezier_1d(t, x1, x2) - x
            local dx = L.bezier_1d_deriv(t, x1, x2)
            if math.abs(dx) < 0.000001 then
                break
            end
            t = L.clamp01(t - x_est / dx)
        end

        return L.bezier_1d(t, y1, y2)
    end

    function L.ease_out_expand(t)
        t = L.clamp01(t)
        local e = L.cubic_bezier_ease(t, 0.22, 1.0, 0.36, 1.0)
        if t <= 0.55 then
            return e
        end

        local mid_t = 0.55
        local mid = L.cubic_bezier_ease(mid_t, 0.22, 1.0, 0.36, 1.0)
        local u = (t - mid_t) / (1 - mid_t)
        u = u * u * (3 - 2 * u)
        return mid + (1 - mid) * u
    end

    function L.lerp(a, b, t)
        return a + (b - a) * L.clamp01(t)
    end

    function L.hover_step(v, hovered, dt, speed)
        speed = speed or 10
        if hovered then
            return L.clamp01(v + speed * dt)
        end
        return L.clamp01(v - speed * dt)
    end

    function L.mix_color(a, b, t)
        return {
            L.lerp(a[1], b[1], t),
            L.lerp(a[2], b[2], t),
            L.lerp(a[3], b[3], t),
        }
    end

    function L.inside(mx, my, x, y, w, h)
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    end

    function L.mouse_pos()
        -- Use the same mouse-coordinate helper as the working Fallen menu.
        if type(mouse_pos) == "function" then
            local ok, mx, my = pcall(mouse_pos)
            if ok then
                mx = tonumber(mx)
                my = tonumber(my)
                if mx and my then
                    return mx, my
                end
            end
        end

        return -10000, -10000
    end

    function L.lmb_down()
        if type(key_down) == "function" then
            local ok, down = pcall(key_down, 0x01)
            if ok then
                return down == true
            end
        end
        return false
    end

    -- Non-overlapping rounded fill so window/modal fades do not create the
    -- dark alpha seams that overlapping circles + boxes would produce.
    function L.rounded_fill(x, y, w, h, r, c, a)
        if w <= 0 or h <= 0 or a <= 0 then return end
        r = math.floor(L.clamp(r or 0, 0, math.min(w, h) * 0.5))
        if r <= 0 then
            DrawBoxFilled(x, y, x + w, y + h, c[1], c[2], c[3], a)
            return
        end

        DrawBoxFilled(x + r, y, x + w - r, y + h, c[1], c[2], c[3], a)
        if h - r * 2 > 0 then
            DrawBoxFilled(x, y + r, x + r, y + h - r, c[1], c[2], c[3], a)
            DrawBoxFilled(x + w - r, y + r, x + w, y + h - r, c[1], c[2], c[3], a)
        end

        local rr = r * r
        for i = 0, r - 1 do
            local top_dy = (i + 0.5) - r
            local top_dx = math.sqrt(math.max(0, rr - top_dy * top_dy))
            local bot_dy = i + 0.5
            local bot_dx = math.sqrt(math.max(0, rr - bot_dy * bot_dy))

            if top_dx > 0 then
                DrawBoxFilled(x + r - top_dx, y + i, x + r, y + i + 1, c[1], c[2], c[3], a)
                DrawBoxFilled(x + w - r, y + i, x + w - r + top_dx, y + i + 1, c[1], c[2], c[3], a)
            end

            if bot_dx > 0 then
                local by = y + h - r + i
                DrawBoxFilled(x + r - bot_dx, by, x + r, by + 1, c[1], c[2], c[3], a)
                DrawBoxFilled(x + w - r, by, x + w - r + bot_dx, by + 1, c[1], c[2], c[3], a)
            end
        end
    end

    function L.arc(cx, cy, r, a0, a1, c, alpha, thickness)
        if type(DrawLine) ~= "function" then return end
        local segs = 8
        local px = cx + math.cos(a0) * r
        local py = cy + math.sin(a0) * r
        for i = 1, segs do
            local t = i / segs
            local ang = a0 + (a1 - a0) * t
            local nx = cx + math.cos(ang) * r
            local ny = cy + math.sin(ang) * r
            DrawLine(px, py, nx, ny, c[1], c[2], c[3], alpha, thickness)
            px, py = nx, ny
        end
    end

    function L.rounded_outline(x, y, w, h, r, c, a, thickness)
        if type(DrawLine) ~= "function" or a <= 0 then return end
        r = L.clamp(r or 0, 0, math.min(w, h) * 0.5)
        thickness = thickness or 1

        DrawLine(x + r, y, x + w - r, y, c[1], c[2], c[3], a, thickness)
        DrawLine(x + r, y + h, x + w - r, y + h, c[1], c[2], c[3], a, thickness)
        DrawLine(x, y + r, x, y + h - r, c[1], c[2], c[3], a, thickness)
        DrawLine(x + w, y + r, x + w, y + h - r, c[1], c[2], c[3], a, thickness)

        L.arc(x + r, y + r, r, math.pi, math.pi * 1.5, c, a, thickness)
        L.arc(x + w - r, y + r, r, math.pi * 1.5, math.pi * 2, c, a, thickness)
        L.arc(x + w - r, y + h - r, r, 0, math.pi * 0.5, c, a, thickness)
        L.arc(x + r, y + h - r, r, math.pi * 0.5, math.pi, c, a, thickness)
    end

    function L.text(x, y, value, c, a)
        if a <= 0 then return end
        DrawText(x, y, tostring(value or ""), c[1], c[2], c[3], a)
    end

    function L.text_center(cx, y, value, c, a)
        -- Drawing API has no text measurement/font metrics. This estimate only
        -- positions source labels; animation/timing/layout dimensions stay exact.
        local s = tostring(value or "")
        L.text(cx - (#s * 3.25), y, s, c, a)
    end

    function L.image_ready(handle)
        if not handle or type(IsImageReady) ~= "function" then return false end
        local ok, ready = pcall(IsImageReady, handle)
        return ok and ready == true
    end

    function L.draw_product(x, y, size, alpha, rounding)
        local h = _G.FALLEN_LOADER_PRODUCT_IMAGE
        if h and L.image_ready(h) and type(DrawImage) == "function" then
            pcall(DrawImage, h, x, y, size, size, 1, 1, 1, alpha, rounding or 5)
            return true
        end

        L.rounded_fill(x, y, size, size, rounding or 5, L.theme.accent, alpha * 0.85)
        L.text_center(x + size * 0.5, y + size * 0.25, "F", L.theme.text, alpha)
        return false
    end

    function L.draw_avatar(x, y, size, alpha)
        if type(update_profile) == "function" then
            pcall(update_profile)
        end

        local h = PROFILE and PROFILE.avatar or nil
        if h and L.image_ready(h) and type(DrawImage) == "function" then
            pcall(DrawImage, h, x, y, size, size, 1, 1, 1, alpha, size * 0.5)
            return
        end

        DrawCircleFilled(x + size * 0.5, y + size * 0.5, size * 0.5,
            L.theme.card[1], L.theme.card[2], L.theme.card[3], alpha)
        DrawCircleFilled(x + size * 0.5, y + size * 0.5, size * 0.46,
            L.theme.accent[1], L.theme.accent[2], L.theme.accent[3], alpha * 0.55)

        local name = PROFILE and PROFILE.name or "F"
        local first = string.sub(tostring(name), 1, 1)
        if first == "" then first = "F" end
        L.text_center(x + size * 0.5, y + size * 0.33, string.upper(first), L.theme.text, alpha)
    end

    function L.draw_spinner(cx, cy, alpha)
        if type(DrawLine) ~= "function" or alpha <= 0 then return end
        -- A smooth contiguous arc; the old implementation joined the head
        -- to the first tail point across a big gap and looked segmented.
        local radius = 19
        local segment_count = 112
        local tail_angle = math.pi * 1.55
        local rotation = L.time_sec * 5.8
        local thickness = 3
        for i = 0, segment_count - 1 do
            local t0 = i / segment_count
            local t1 = (i + 1) / segment_count
            local angle0 = rotation - t0 * tail_angle
            local angle1 = rotation - t1 * tail_angle
            local x0 = cx + math.cos(angle0) * radius
            local y0 = cy + math.sin(angle0) * radius
            local x1 = cx + math.cos(angle1) * radius
            local y1 = cy + math.sin(angle1) * radius
            local opacity = alpha * (1 - (t0 + t1) * 0.5) ^ 1.4
            DrawLine(x0, y0, x1, y1,
                L.theme.accent[1], L.theme.accent[2], L.theme.accent[3],
                opacity, thickness)
        end
    end

    function L.begin_exit(success)
        if L.phase == "Exiting" or L.exit_done then return end
        L.launch_success = success == true
        L.phase = "Exiting"
        L.hide_t = 0
        L.exit_done = false
        L.exit_from_alpha = L.window_alpha
    end

    function L.tick_boot(dt)
        if L.phase == "Exiting" then
            L.hide_t = L.clamp01(L.hide_t + dt / 0.28)
            L.window_alpha = L.exit_from_alpha * (1 - L.ease_in_out_cubic(L.hide_t))
            if L.hide_t >= 1 then
                L.window_alpha = 0
                L.exit_done = true
            end
            return
        end

        if L.phase == "Splash" or L.phase == "Expanding" then
            L.boot_fade_t = L.clamp01(L.boot_fade_t + dt / 0.20)
            L.window_alpha = L.ease_in_out_cubic(L.boot_fade_t)
        elseif L.phase == "Ready" then
            L.window_alpha = 1
        end

        if L.phase == "Splash" then
            L.splash_t = L.clamp01(L.splash_t + dt / 2.00)
            L.loader_alpha = 1
            L.content_alpha = 0
            L.content_t = 0
            L.win_w = 200
            L.win_h = 200

            if L.splash_t >= 1 then
                L.phase = "Expanding"
                L.expand_t = 0
            end
        elseif L.phase == "Expanding" then
            L.expand_t = L.clamp01(L.expand_t + dt / 0.32)
            local t = L.ease_out_expand(L.expand_t)
            L.win_w = math.floor(200 + (L.target_w - 200) * t + 0.5)
            L.win_h = math.floor(200 + (L.target_h - 200) * t + 0.5)
            L.loader_alpha = 1 - t

            if t > 0.88 then
                L.content_t = L.clamp01((t - 0.88) / 0.12) * 0.08
                L.content_alpha = L.ease_in_out_cubic(L.content_t)
            else
                L.content_t = 0
                L.content_alpha = 0
            end

            if L.expand_t >= 1 then
                L.win_w = L.target_w
                L.win_h = L.target_h
                L.loader_alpha = 0
                L.phase = "Ready"
                if L.content_t < 0.08 then L.content_t = 0.08 end
                L.content_alpha = L.ease_in_out_cubic(L.content_t)
            end
        elseif L.phase == "Ready" then
            L.content_t = L.clamp01(L.content_t + dt / 0.40)
            L.content_alpha = L.ease_in_out_cubic(L.content_t)
            L.loader_alpha = 0
        end
    end

    function L.tick_inject(now)
        if not L.inject.active then return end

        local elapsed = now - L.inject.start_time
        local fade_out = 0.280
        local shrink = 0.320
        local fade_in = 0.360
        local fade_out_end = fade_out
        local shrink_end = fade_out + shrink

        if elapsed < fade_out_end then
            L.inject.show_content = false
            L.inject.modal_w = 450
            L.inject.modal_h = 350
            L.inject.logo_alpha = 0
            L.inject.progress = 0
            L.inject.content_alpha = 1 - L.ease_in_out_cubic(elapsed / fade_out)
            return
        end

        if elapsed < shrink_end then
            L.inject.show_content = false
            L.inject.content_alpha = 0
            L.inject.logo_alpha = 0
            local t = L.ease_out_expand((elapsed - fade_out_end) / shrink)
            L.inject.modal_w = 450 + (350 - 450) * t
            L.inject.modal_h = 350 + (200 - 350) * t
            return
        end

        L.inject.show_content = true
        L.inject.modal_w = 350
        L.inject.modal_h = 200
        L.inject.content_alpha = 0

        local local_t = elapsed - shrink_end
        L.inject.logo_alpha =
            L.ease_in_out_cubic(
                math.min(
                    1,
                    local_t / fade_in
                )
            )

        -- Real loading starts here: after pressing Load, sequentially preload
        -- every image used by the main menu without freezing the game.
        if _G.FALLEN_IMAGE_PRELOAD_STARTED ~= true then
            pcall(
                FALLEN_START_IMAGE_PRELOAD
            )
        end

        -- Hard frame budget: this returns immediately every render frame.
        pcall(
            FALLEN_PRELOAD_TICK
        )

        local total =
            tonumber(_G.FALLEN_IMAGE_PRELOAD_TOTAL)
            or 0

        local done =
            tonumber(_G.FALLEN_IMAGE_PRELOAD_INDEX)
            or 0

        if total > 0 then
            L.inject.progress =
                L.clamp01(
                    done / total
                )
        else
            -- Small visual seed while the preload worker builds the queue.
            L.inject.progress =
                math.min(
                    0.08,
                    L.inject.logo_alpha * 0.08
                )
        end

        if _G.FALLEN_IMAGE_PRELOAD_DONE == true then
            L.inject.progress = 1
            L.inject.active = false
            L.inject.show_content = true
            L.inject.logo_alpha = 1
            _G.FallenSurvivalLoaded = true
            L.begin_exit(true)
        end
    end

    function L.modal_open(now)
        if now < (L.modal.reopen_block_until or 0) then return end
        L.modal.open = true
        L.modal.closing = false
        L.modal.open_time = now
        L.modal.alpha = 0
        L.modal.branch_menu = false
        L.modal.branch_t = 0
        L.modal.branch_hover = 0
        L.inject.active = false
        L.inject.show_content = false
        L.inject.content_alpha = 1
        L.inject.modal_w = 450
        L.inject.modal_h = 350
        L.inject.logo_alpha = 0
        L.inject.progress = 0
    end

    function L.modal_close(now)
        if L.inject.active or L.modal.closing then return end
        L.modal.branch_menu = false
        L.modal.closing = true
        L.modal.close_time = now
    end

    function L.tick_modal(now, dt)
        if not L.modal.open and not L.modal.closing then
            return
        end

        L.tick_inject(now)

        local modal_t
        if L.modal.closing then
            modal_t = 1 - math.min((now - L.modal.close_time) / 0.300, 1)
        else
            modal_t = math.min((now - L.modal.open_time) / 0.300, 1)
        end
        L.modal.alpha = L.ease_in_out_cubic(modal_t)

        if modal_t <= 0 and L.modal.closing then
            L.modal.open = false
            L.modal.closing = false
            L.modal.alpha = 0
            L.modal.branch_menu = false
            L.modal.branch_t = 0
            L.modal.branch_hover = 0
            L.modal.reopen_block_until = now + 0.280
            L.inject.active = false
            L.inject.show_content = false
            return
        end

        local step = dt / 0.20
        if L.modal.branch_menu then
            L.modal.branch_t = math.min(1, L.modal.branch_t + step)
        else
            L.modal.branch_t = math.max(0, L.modal.branch_t - step)
        end
    end

    function L.draw_logo_and_header(x, y, alpha)
        local drew_logo = false
        local h = _G.FALLEN_LOADER_HEADER_LOGO_IMAGE

        if h and L.image_ready(h) and type(DrawImage) == "function" then
            -- Keep the square source canvas, but match the original loader:
            -- small logo tucked into the top-left corner.
            pcall(DrawImage, h, x + 7, y + 1, 56, 56, 1, 1, 1, alpha, 0)
            drew_logo = true
        end

        if not drew_logo then
            -- Fallback while the image is still loading.
            L.text(x + 18, y + 15, "FL", L.theme.accent, alpha)
            L.text(x + 20, y + 15, "FL", L.theme.text, alpha)
        end

        L.text(x + 165, y + 20, "Subscription", L.theme.text, alpha * 0.90)
        L.text(x + 165, y + 45, "Available subscriptions", L.theme.muted, alpha)
    end

    function L.draw_side_links(x, y, alpha, mx, my, click, dt, modal_open)
        local rows = {
            {"Site", 50, "site_hover"},
            {"Discord", 70, "discord_hover"},
            {"Telegram", 80, "telegram_hover"},
        }

        local yy = 100
        for i = 1, #rows do
            local row = rows[i]
            local hot = L.inside(mx, my, x + 20, y + yy, row[2], 20)
            L[row[3]] = L.hover_step(L[row[3]] or 0, hot, dt, 10)
            local col = L.mix_color(L.theme.dim, L.theme.text, L[row[3]] or 0)
            L.text(x + 20, y + yy, row[1], col, alpha)
            -- Source opens URLs here. The custom Lua API has no shell/browser
            -- primitive, so the visual/hover behavior is preserved and no
            -- substitute action is invented.
            if click and hot and not modal_open then
                -- intentionally no-op
            end
            yy = yy + 35
        end
    end

    function L.draw_product_card(x, y, alpha, mx, my, click, now)
        local start_x = 165
        local card_x = x + start_x
        local card_y = y + 100
        local card_w = 500 - start_x - 20
        local card_h = 80

        L.rounded_fill(card_x, card_y, card_w, card_h, 10, L.theme.card, alpha)
        L.rounded_outline(card_x, card_y, card_w, card_h, 10, L.theme.outline, alpha, 1.5)

        L.text(card_x + 15, card_y + 10, "Fallen survival", L.theme.text, alpha)
        L.text(card_x + 15, card_y + 35, "Lifetime", L.theme.muted, alpha)
        L.draw_product(card_x + card_w - 30, card_y + 10, 20, alpha, 5)

        if click
            and not L.modal.open
            and not L.modal.closing
            and now >= (L.modal.reopen_block_until or 0)
            and L.inside(mx, my, card_x, card_y, card_w, card_h)
        then
            L.modal_open(now)
        end
    end

    function L.draw_avatar_footer(x, y, alpha)
        local image_size = 40
        local ax = x + 20
        local ay = y + 400 - image_size - 25
        L.draw_avatar(ax, ay, image_size, alpha)

        local name = PROFILE and PROFILE.name or "Player"
        if name == "Loading..." then name = "Player" end
        L.text(ax + image_size + 10, ay + 12, name, L.theme.text, alpha * 0.90)
    end

    function L.draw_window_chrome(x, y, alpha, mx, my, click, dt, modal_open)
        local close_hot = L.inside(mx, my, x + 500 - 35, y + 20, 20, 20)
        local min_hot = L.inside(mx, my, x + 500 - 60, y + 25, 20, 20)
        L.close_hover = L.hover_step(L.close_hover, close_hot, dt, 10)
        L.minimize_hover = L.hover_step(L.minimize_hover, min_hot, dt, 10)

        local close_col = L.mix_color(L.theme.dim, L.theme.text, L.close_hover)
        local min_col = L.mix_color(L.theme.dim, L.theme.text, L.minimize_hover)

        DrawLine(x + 470, y + 25, x + 480, y + 35,
            close_col[1], close_col[2], close_col[3], alpha, 2)
        DrawLine(x + 470, y + 35, x + 480, y + 25,
            close_col[1], close_col[2], close_col[3], alpha, 2)
        DrawLine(x + 445, y + 30, x + 457, y + 30,
            min_col[1], min_col[2], min_col[3], alpha, 2)

        if click and close_hot and not modal_open then
            L.begin_exit(false)
        end

        -- Source minimizes the OS window here. There is no minimize primitive
        -- in the supplied Lua API; keep the source button/hover, no fake action.
        if click and min_hot and not modal_open then
            -- intentionally no-op
        end
    end

    function L.draw_dashboard(x, y, alpha, mx, my, click, dt, now)
        L.draw_logo_and_header(x, y, alpha)
        L.draw_side_links(x, y, alpha, mx, my, click, dt, L.modal.open or L.modal.closing)
        L.draw_product_card(x, y, alpha, mx, my, click, now)
        L.draw_avatar_footer(x, y, alpha)
        L.draw_window_chrome(x, y, alpha, mx, my, click, dt, L.modal.open or L.modal.closing)
    end

    function L.draw_dim(x, y, alpha)
        if not L.modal.open and not L.modal.closing then return end
        local dim = L.modal.alpha * 0.55 * alpha

        -- Keep the modal dim layer inside the same rounded 500x400 loader
        -- silhouette instead of drawing a square overlay over rounded corners.
        L.rounded_fill(x, y, 500, 400, 15, {0, 0, 0}, dim)
    end

    function L.draw_git_branch_icon(cx, cy, size, c, alpha)
