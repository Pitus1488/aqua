function FALLEN_BT_IMAGE_GET(key, url)
    if type(LoadImage) ~= "function"
        or not key
        or not url
    then
        return nil
    end

    local handle =
        FALLEN_BT_IMAGE[key]

    -- Reuse the sequential startup preload exactly like the other URL images.
    -- This avoids a second LoadImage request the first time Galaxy is drawn.
    if not handle
        and type(_G.FALLEN_IMAGE_PRELOAD_HANDLES) == "table"
    then
        local preloaded =
            _G.FALLEN_IMAGE_PRELOAD_HANDLES[url]

        if preloaded then
            FALLEN_BT_IMAGE[key] = preloaded
            handle = preloaded
        end
    end

    if not handle then
        local ok, loaded =
            pcall(
                LoadImage,
                url
            )

        if ok and loaded then
            FALLEN_BT_IMAGE[key] = loaded
            handle = loaded
        end
    end

    if not handle then
        return nil
    end

    if type(IsImageFailed) == "function" then
        local ok, failed =
            pcall(
                IsImageFailed,
                handle
            )

        if ok and failed == true then
            FALLEN_BT_IMAGE[key] = nil
            return nil
        end
    end

    if type(IsImageReady) == "function" then
        local ok, ready =
            pcall(
                IsImageReady,
                handle
            )

        if ok and ready == true then
            return handle
        end

        return nil
    end

    return handle
end

