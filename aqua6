local FALLEN_ANTIAIM_MODES = {
    "Spin",
    "Jitter",
    "Backwards",
}

function FALLEN_ANTIAIM_SETTINGS_STEP()
    local now = tick()

    if A.misc_antiaim_settings_last_t == nil then
        A.misc_antiaim_settings_last_t = now
    end

    local dt =
        clamp(
            now - A.misc_antiaim_settings_last_t,
            0,
            0.05
        )

    A.misc_antiaim_settings_last_t = now

    local target =
        A.misc_antiaim_settings_open
        and 1
        or 0

    local speed =
        target > (A.misc_antiaim_settings_anim or 0)
        and 15
        or 11

    A.misc_antiaim_settings_anim =
        exp_chase(
            A.misc_antiaim_settings_anim or 0,
            target,
            speed,
            dt
        )

    if math.abs(
        (A.misc_antiaim_settings_anim or 0)
        - target
    ) < 0.0015
    then
        A.misc_antiaim_settings_anim = target
    end

    return
        clamp(
            A.misc_antiaim_settings_anim or 0,
            0,
            1
        )
end

