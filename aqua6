function FALLEN_AVATAR_EDITOR_CLEAN_PATH(path)
    if type(path) ~= "string" then
        return nil
    end

    path =
        string.gsub(
            path,
            "[\r\n]+",
            ""
        )

    path =
        string.gsub(
            path,
            "^%s+",
            ""
        )

    path =
        string.gsub(
            path,
            "%s+$",
            ""
        )

    path =
        string.gsub(
            path,
            '^"',
            ""
        )

    path =
        string.gsub(
            path,
            '"$',
            ""
        )

    if path == "" then
        return nil
    end

    return path
end

function FALLEN_AVATAR_EDITOR_FILENAME(path)
    path =
        tostring(
            path
            or ""
        )

    local name =
        string.match(
            path,
            "([^\\/]+)$"
        )

    return
        name
        or path
        or ""
end

function FALLEN_AVATAR_EDITOR_PATH_SUPPORTED(path)
    local p =
        string.lower(
            tostring(
                path
                or ""
            )
        )

    return
        string.match(p, "%.png$")
        or string.match(p, "%.jpg$")
        or string.match(p, "%.jpeg$")
        or string.match(p, "%.bmp$")
        or string.match(p, "%.gif$")
        or string.match(p, "%.tga$")
end

function FALLEN_AVATAR_EDITOR_UNLOAD_CANDIDATE()
    local h =
        A.avatar_editor_candidate_handle

    if not h then
        return
    end

    if Drawing
        and type(Drawing.UnloadImage) == "function"
    then
        pcall(
            Drawing.UnloadImage,
            h
        )
    end

    A.avatar_editor_candidate_handle = nil
    A.avatar_editor_candidate_path = nil
end

function FALLEN_AVATAR_EDITOR_LOAD_PATH(path)
    path =
        FALLEN_AVATAR_EDITOR_CLEAN_PATH(
            path
        )

    if not path then
        A.avatar_editor_status =
            "No file selected"
        return false
    end

    if not FALLEN_AVATAR_EDITOR_PATH_SUPPORTED(
        path
    ) then
        A.avatar_editor_status =
            "Unsupported image format"
        return false
    end

    if type(exists_file) == "function" then
        local ok_exists, exists =
            pcall(
                exists_file,
                path
            )

        if not ok_exists
            or exists ~= true
        then
            A.avatar_editor_status =
                "File not found"
            return false
        end
    end

    local handle = nil

    pcall(function()
        if Drawing
            and type(Drawing.LoadImageFromFile) == "function"
        then
            handle =
                Drawing.LoadImageFromFile(
                    path
                )
        elseif type(LoadImage) == "function" then
            handle =
                LoadImage(
                    path
                )
        end
    end)

    if not handle then
        A.avatar_editor_status =
            "Could not load image"
        return false
    end

    FALLEN_AVATAR_EDITOR_UNLOAD_CANDIDATE()

    A.avatar_editor_candidate_handle =
        handle

    A.avatar_editor_candidate_path =
        path

    A.avatar_editor_status =
        FALLEN_AVATAR_EDITOR_FILENAME(
            path
        )

    return true
end

function FALLEN_AVATAR_EDITOR_FOLDER()
    FALLEN_CUSTOM_AVATAR_ENSURE_FOLDER()

    return
        "C:\\blueberry\\scripts\\avatar\\"
end

function FALLEN_AVATAR_EDITOR_IS_INTERNAL_IMAGE(path)
    local name =
        string.lower(
            FALLEN_AVATAR_EDITOR_FILENAME(
                path
            )
        )

    return
        name == "avatar_saved.bmp"
        or string.match(
            name,
            "^avatar_crop_preview_"
        ) ~= nil
end

function FALLEN_AVATAR_EDITOR_ACCEPT_IMAGE_PATH(path)
    path =
        FALLEN_AVATAR_EDITOR_CLEAN_PATH(
            path
        )

    if not path
        or not FALLEN_AVATAR_EDITOR_PATH_SUPPORTED(path)
        or FALLEN_AVATAR_EDITOR_IS_INTERNAL_IMAGE(path)
    then
        return nil
    end

    if type(exists_file) == "function" then
        local ok, exists =
            pcall(
                exists_file,
                path
            )

        if not ok
            or exists ~= true
        then
            return nil
        end
    end

    return path
end

function FALLEN_AVATAR_EDITOR_TABLE_FIND_IMAGE(list, base)
    if type(list) ~= "table" then
        return nil
    end

    for _, value in pairs(list) do
        local path = nil

        if type(value) == "string" then
            path = value
        elseif type(value) == "table" then
            path =
                value.path
                or value.Path
                or value.file
                or value.File
                or value.name
                or value.Name
                or value[1]
        end

        if type(path) == "string" then
            if not string.find(path, "[\\/]", 1) then
                path =
                    base
                    .. path
            end

            path =
                FALLEN_AVATAR_EDITOR_ACCEPT_IMAGE_PATH(
                    path
                )

            if path then
                return path
            end
        end
    end

    return nil
end

function FALLEN_AVATAR_EDITOR_FIND_FOLDER_IMAGE()
    local base =
        FALLEN_AVATAR_EDITOR_FOLDER()

    -- Prefer a real directory-listing API if this Blueberry build has one.
    local probes = {}

    if type(list_files) == "function" then
        probes[#probes + 1] = {
            fn = list_files,
            owner = nil,
        }
    end

    if type(get_files) == "function" then
        probes[#probes + 1] = {
            fn = get_files,
            owner = nil,
        }
    end

    if filesystem then
        if type(filesystem.list_files) == "function" then
            probes[#probes + 1] = {
                fn = filesystem.list_files,
                owner = filesystem,
            }
        end

        if type(filesystem.list) == "function" then
            probes[#probes + 1] = {
                fn = filesystem.list,
                owner = filesystem,
            }
        end
    end

    if fs then
        if type(fs.list_files) == "function" then
            probes[#probes + 1] = {
                fn = fs.list_files,
                owner = fs,
            }
        end

        if type(fs.list) == "function" then
            probes[#probes + 1] = {
                fn = fs.list,
                owner = fs,
            }
        end
    end

    for _, probe in ipairs(probes) do
        local ok, list = false, nil

        if probe.owner then
            ok, list =
                pcall(
                    probe.fn,
                    probe.owner,
                    base
                )

            if not ok then
                ok, list =
                    pcall(
                        probe.fn,
                        base
                    )
            end
        else
            ok, list =
                pcall(
                    probe.fn,
                    base
                )
        end

        if ok then
            local path =
                FALLEN_AVATAR_EDITOR_TABLE_FIND_IMAGE(
                    list,
                    base
                )

            if path then
                return path
            end
        end
    end

    -- Lightweight Windows fallback: enumerate names only when Reload Image
    -- is pressed. Nothing is launched when the editor itself opens.
    if type(write_file) == "function"
        and type(read_file) == "function"
        and os
        and type(os.execute) == "function"
    then
        local list_path =
            base
            .. "avatar_file_list.txt"

        local cmd_path =
            base
            .. "avatar_file_list.cmd"

        local command =
            "@echo off\r\n"
            .. "dir /b /a-d /o-d \""
            .. base
            .. "\" > \""
            .. list_path
            .. "\"\r\n"

        local ok_cmd =
            pcall(
                write_file,
                cmd_path,
                command
            )

        if ok_cmd then
            pcall(
                os.execute,
                'cmd.exe /c "'
                .. cmd_path
                .. '"'
            )

            local ok_list, raw =
                pcall(
                    read_file,
                    list_path
                )

            if ok_list
                and type(raw) == "string"
            then
                for name in string.gmatch(
                    raw,
                    "[^\r\n]+"
                ) do
                    local path =
                        FALLEN_AVATAR_EDITOR_ACCEPT_IMAGE_PATH(
                            base
                            .. name
                        )

                    if path then
                        return path
                    end
                end
            end
        end
    end

    -- Last fallback: previously selected arbitrary path.
    if type(read_file) == "function" then
        local ok_saved, saved =
            pcall(
                read_file,
                base
                .. "SELECTED_PATH.txt"
            )

        if ok_saved
            and type(saved) == "string"
        then
            local path =
                FALLEN_AVATAR_EDITOR_ACCEPT_IMAGE_PATH(
                    saved
                )

            if path then
                return path
            end
        end
    end

    -- Legacy common names are still supported.
    local names = {
        "avatar.png",
        "avatar.jpg",
        "avatar.jpeg",
        "avatar.bmp",
        "avatar.gif",
        "avatar.tga",
        "profile.png",
        "profile.jpg",
        "pfp.png",
        "pfp.jpg",
        "image.png",
        "image.jpg",
    }

    for _, name in ipairs(names) do
        local path =
            FALLEN_AVATAR_EDITOR_ACCEPT_IMAGE_PATH(
                base
                .. name
            )

        if path then
            return path
        end
    end

    return nil
end

function FALLEN_AVATAR_EDITOR_RELOAD_PREVIEW()
    local path =
        FALLEN_AVATAR_EDITOR_FIND_FOLDER_IMAGE()

    if not path then
        A.avatar_editor_status =
            "No image found in the avatar folder"

        return false
    end

    local ok =
        FALLEN_AVATAR_EDITOR_LOAD_PATH(
            path
        )

    if ok then
        -- Like Discord: a freshly selected image starts centered at 1x.
        S.avatar_crop_zoom = 1
        S.avatar_crop_pan_x = 0
        S.avatar_crop_pan_y = 0

        A.avatar_editor_status =
            "Loaded: "
            .. FALLEN_AVATAR_EDITOR_FILENAME(
                path
            )
    end

    return ok
end

