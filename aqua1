function FALLEN_CONFIGS.anim_step()
    local now = tick()

    if A.config_last_t == nil then
        A.config_last_t = now
    end

    local dt =
        clamp(
            now - A.config_last_t,
            0,
            0.05
        )

    A.config_last_t = now

    local target =
        A.config_open
        and 1
        or 0

    local speed =
        target > (A.config_anim or 0)
        and 10
        or 8

    A.config_anim =
        exp_chase(
            A.config_anim or 0,
            target,
            speed,
            dt
        )

    if target == 0
        and (A.config_anim or 0) < 0.018
    then
        A.config_anim = 0
    elseif target == 1
        and (A.config_anim or 0) > 0.992
    then
        A.config_anim = 1
    end

    return
        clamp(
            A.config_anim or 0,
            0,
            1
        )
end

function FALLEN_CONFIGS.button(
    mx,
    my,
    clicked,
    x,
    y,
    w,
    h,
    label,
    danger
)
    local hot =
        hover(
            mx,
            my,
            x,
            y,
            w,
            h
        )

    local bg

    if danger then
        bg =
            hot
            and { 0.34, 0.105, 0.115, 1 }
            or { 0.245, 0.082, 0.092, 1 }
    else
        bg =
            hot
            and { 0.115, 0.120, 0.145, 1 }
            or { 0.092, 0.096, 0.112, 1 }
    end

    rounded_fill(
        x,
        y,
        w,
        h,
        7,
        bg
    )

    centered_text(
        x + w * 0.5,
        y + 9,
        label,
        danger
            and { 1.0, 0.72, 0.74, 1 }
            or C.text
    )

    return
        clicked
        and hot
end

function FALLEN_CONFIGS.draw_popup(
    mx,
    my,
    clicked,
    lmb,
    anchor_x,
    anchor_y,
    anchor_w
)
    local raw =
        FALLEN_CONFIGS.anim_step()

    if raw <= 0.001
        and not A.config_open
    then
        return false
    end

    local parent_alpha =
        MENU_RENDER_ALPHA

    local fade =
        ease_out_cubic(raw)

    MENU_RENDER_ALPHA =
        parent_alpha
        * fade

    local anim =
        A.config_open
        and ease_out_cubic(raw)
        or ease_in_out_cubic(raw)

    local visible_count =
        math.min(
            #FALLEN_CONFIGS.CONFIG.list,
            6
        )

    local empty_extra =
        #FALLEN_CONFIGS.CONFIG.list == 0
        and 29
        or 0

    local full_h =
        160
        + visible_count * 29
        + empty_extra

    local pw = 300

    local retract =
        1 - anim

    local px =
        snap(
            anchor_x
        )

    local py =
        snap(
            anchor_y
            + 42
            - retract * 20
        )

    local ph =
        math.max(
            42,
            full_h
            - retract * 62
        )

    local interactive =
        raw > 0.95
        and A.config_open

    local ui_clicked =
        clicked
        and interactive

    FALLEN_POPUP_GLOW(px, py, pw, ph, 11, 1)

    rounded_fill(
        px,
        py,
        pw,
        ph,
        11,
        { 0.062, 0.066, 0.077, 1 }
    )

    text(
        px + 13,
        py + 12,
        "Configs",
        C.text
    )

    if ph > 39 then
        line(
            px + 12,
            py + 34,
            px + pw - 12,
            py + 34,
            C.divider,
            1
        )
    end

    -- Name input.
    local input_x = px + 12
    local input_y = py + 44
    local input_w = pw - 24
    local input_h = 31

    if ph > 76 then
        local input_hot =
            hover(
                mx,
                my,
                input_x,
                input_y,
                input_w,
                input_h
            )

        rounded_fill(
            input_x,
            input_y,
            input_w,
            input_h,
            7,
            A.config_input_focus
                and { 0.112, 0.118, 0.145, 1 }
                or (
                    input_hot
                    and { 0.100, 0.104, 0.124, 1 }
                    or { 0.086, 0.090, 0.105, 1 }
                )
        )

        if A.config_input_focus then
            rounded_outline(
                input_x,
                input_y,
                input_w,
                input_h,
                7,
                alpha(C.accent, 0.65),
                1,
                { 0.112, 0.118, 0.145, 1 }
            )
        end

        local shown =
            tostring(
                A.config_input_buffer
                or ""
            )

        if shown == ""
            and not A.config_input_focus
        then
            text(
                input_x + 10,
                input_y + 9,
                "Config name",
                C.text_faint
            )
        else
            if A.config_input_focus
                and math.floor(tick() * 2) % 2 == 0
            then
                shown =
                    shown
                    .. "|"
            end

            text(
                input_x + 10,
                input_y + 9,
                shown,
                C.text
            )
        end

        if ui_clicked
            and input_hot
        then
            FALLEN_CONFIGS.input_focus(true)
        end
    end

    local list_y =
        py + 84

    if ph > 112 then
        text(
            px + 13,
            list_y,
            "Saved",
            C.text_dim
        )

        list_y =
            list_y + 18

        if #FALLEN_CONFIGS.CONFIG.list == 0 then
            text(
                px + 13,
                list_y + 5,
                "No saved configs",
                C.text_faint
            )
        else
            for i = 1, visible_count do
                local name =
                    FALLEN_CONFIGS.CONFIG.list[i]

                local iy =
                    list_y
                    + (i - 1) * 29

                local hot =
                    hover(
                        mx,
                        my,
                        px + 10,
                        iy,
                        pw - 20,
                        26
                    )

                local selected =
                    A.config_selected == name

                if hot
                    or selected
                then
                    rounded_fill(
                        px + 10,
                        iy,
                        pw - 20,
                        26,
                        6,
                        selected
                            and { 0.105, 0.119, 0.158, 1 }
                            or { 0.086, 0.091, 0.108, 1 }
                    )
                end

                if selected then
                    rounded_fill(
                        px + 10,
                        iy + 4,
                        3,
                        18,
                        1,
                        C.accent
                    )
                end

                text(
                    px + 19,
                    iy + 7,
                    name,
                    FALLEN_HOVER_TEXT(
                        "config_option:" .. tostring(name),
                        hot,
                        selected and C.text or C.text_dim
                    )
                )

                if ui_clicked
                    and hot
                then
                    A.config_selected = name
                    A.config_input_buffer = name
                    FALLEN_CONFIGS.input_focus(false)
                end
            end
        end
    end

    local buttons_y =
        py
        + full_h
        - 43

    if ph > full_h - 48 then
        local gap = 7
        local bw =
            math.floor(
                (pw - 24 - gap * 2)
                / 3
            )

        local bx = px + 12

        if FALLEN_CONFIGS.button(
            mx,
            my,
            ui_clicked,
            bx,
            buttons_y,
            bw,
            31,
            "Save",
            false
        ) then
            FALLEN_CONFIGS.input_focus(false)
            FALLEN_CONFIGS.save(
                A.config_input_buffer
            )
        end

        bx =
            bx + bw + gap

        if FALLEN_CONFIGS.button(
            mx,
            my,
            ui_clicked,
            bx,
            buttons_y,
            bw,
            31,
            "Load",
            false
        ) then
            FALLEN_CONFIGS.input_focus(false)

            FALLEN_CONFIGS.load(
                A.config_selected
                or A.config_input_buffer
            )
        end

        bx =
            bx + bw + gap

        if FALLEN_CONFIGS.button(
            mx,
            my,
            ui_clicked,
            bx,
            buttons_y,
            bw,
            31,
            "Delete",
            true
        ) then
            FALLEN_CONFIGS.input_focus(false)

            FALLEN_CONFIGS.delete(
                A.config_selected
                or A.config_input_buffer
            )
        end
    end

    local popup_hot =
        hover(
            mx,
            my,
            px,
            py,
            pw,
            ph
        )

    local anchor_hot =
        hover(
            mx,
            my,
            anchor_x,
            anchor_y,
            anchor_w,
            34
        )

    if interactive
        and clicked
        and not popup_hot
        and not anchor_hot
    then
        A.config_open = false
        FALLEN_CONFIGS.input_focus(false)
    end

    MENU_RENDER_ALPHA =
        parent_alpha

    return popup_hot
end


