local function fap_vec3_valid(v)
    return
        v
        and v.X ~= nil
        and v.Y ~= nil
        and v.Z ~= nil
end

local function fap_read_velocity_addr(addr)
    local out = nil

    -- Same raw AssemblyLinearVelocity path as the pasted Aimbot.
    pcall(function()
        if addr
            and addr ~= 0
            and memory
            and memory.read_ptr
            and memory.read_vec3
            and memory.offsets
        then
            local inst =
                rbx
                and rbx.instance
                and rbx.instance(addr)
                or nil

            local iaddr =
                (inst and inst.addr)
                or addr

            local prim =
                memory.read_ptr(
                    iaddr
                    + memory.offsets.Primitive
                )

            if prim
                and prim ~= 0
            then
                out =
                    memory.read_vec3(
                        prim
                        + memory.offsets.AssemblyLinearVelocity
                    )
            end
        end
    end)

    if fap_vec3_valid(out) then
        return {
            X = out.X,
            Y = out.Y,
            Z = out.Z,
        }
    end

    return nil
end

local function fap_target_velocity(p)
    local vel = nil

    if p
        and p.hrp_addr
        and p.hrp_addr ~= 0
    then
        vel =
            fap_read_velocity_addr(
                p.hrp_addr
            )

        if fap_vec3_valid(vel) then
            return vel
        end

        pcall(function()
            local hrp =
                rbx.instance(
                    p.hrp_addr
                )

            if hrp
                and hrp.get_velocity
            then
                vel =
                    hrp:get_velocity()
            end
        end)

        if fap_vec3_valid(vel) then
            return {
                X = vel.X,
                Y = vel.Y,
                Z = vel.Z,
            }
        end
    end

    if p
        and p.head_addr
        and p.head_addr ~= 0
    then
        vel =
            fap_read_velocity_addr(
                p.head_addr
            )

        if fap_vec3_valid(vel) then
            return vel
        end

        pcall(function()
            local head =
                rbx.instance(
                    p.head_addr
                )

            if head
                and head.get_velocity
            then
                vel =
                    head:get_velocity()
            end
        end)

        if fap_vec3_valid(vel) then
            return {
                X = vel.X,
                Y = vel.Y,
                Z = vel.Z,
            }
        end
    end

    return {
        X = 0,
        Y = 0,
        Z = 0,
    }
end

local function fap_predict(p, pos, cam)
    if not pos then
        return nil
    end

    if S.aim_auto_prediction ~= true then
        return {
            X = pos.X,
            Y = pos.Y,
            Z = pos.Z,
        }
    end

    local px = pos.X
    local py = pos.Y
    local pz = pos.Z

    local bullet_speed =
        tonumber(FAP.bullet_speed)
        or 1000

    local gravity =
        tonumber(FAP.gravity)
        or 35

    if bullet_speed < 1 then
        bullet_speed = 1000
    end

    local dist = 0

    if cam
        and cam.X
    then
        local dx = px - cam.X
        local dy = py - cam.Y
        local dz = pz - cam.Z

        dist =
            math.sqrt(
                dx * dx
                + dy * dy
                + dz * dz
            )
    elseif p then
        dist =
            tonumber(p.distance)
            or 0
    end

    local time_to_hit =
        dist / bullet_speed

    time_to_hit =
        clamp(
            time_to_hit,
            0,
            3
        )

    local vel =
        fap_target_velocity(p)

    local vx = vel.X or 0
    local vy = vel.Y or 0
    local vz = vel.Z or 0

    local hspeed =
        math.sqrt(
            vx * vx
            + vz * vz
        )

    local pred_scale = 1.0
    local weapon_name =
        string.lower(
            tostring(
                FAP.weapon
                or ""
            )
        )

    local is_bow =
        string.find(
            weapon_name,
            "bow",
            1,
            true
        ) ~= nil
        or string.find(
            weapon_name,
            "crossbow",
            1,
            true
        ) ~= nil

    -- Same prediction scaling idea as the pasted Aimbot.
    if is_bow then
        if hspeed > 95 then
            pred_scale = 0.85
        elseif hspeed > 34 then
            pred_scale = 0.95
        else
            pred_scale = 1.00
        end
    else
        if hspeed > 34 then
            pred_scale = 0.14
        elseif hspeed > 24 then
            pred_scale = 0.20
        elseif hspeed > 16 then
            pred_scale = 0.32
        elseif hspeed > 8 then
            pred_scale = 0.48
        else
            pred_scale = 0.62
        end
    end

    local max_hspeed =
        is_bow
        and 130
        or 95

    if hspeed > max_hspeed
        and hspeed > 0
    then
        local mul =
            max_hspeed
            / hspeed

        vx = vx * mul
        vz = vz * mul
    end

    local y_scale =
        is_bow
        and 0.20
        or 0.04

    if math.abs(vy) < 3 then
        y_scale = 0
    end

    local aim_x =
        px
        + vx
        * time_to_hit
        * pred_scale

    local aim_y =
        py
        + vy
        * time_to_hit
        * y_scale

    local aim_z =
        pz
        + vz
        * time_to_hit
        * pred_scale

    local drop =
        0.5
        * gravity
        * (
            time_to_hit
            * time_to_hit
        )

    aim_y =
        aim_y
        + drop

    return {
        X = aim_x,
        Y = aim_y,
        Z = aim_z,
        time = time_to_hit,
    }
end

local function fap_find_bone_pos(p, names)
    if not p
        or type(p.bones) ~= "table"
    then
        return nil
    end

    local wanted = {}

    for _, name in ipairs(names) do
        wanted[string.lower(name)] = true
    end

    for _, bone in ipairs(p.bones) do
        local name =
            bone
            and (
                bone.name
                or bone.Name
            )

        local pos =
            bone
            and (
                bone.position
                or bone.Position
                or bone.pos
            )

        if name
            and pos
            and pos.X ~= nil
            and pos.Y ~= nil
            and pos.Z ~= nil
            and wanted[string.lower(tostring(name))]
        then
            return {
                X = pos.X,
                Y = pos.Y,
                Z = pos.Z,
            }
        end
    end

    return nil
end

local function fap_target_pos(p)
    if not p then
        return nil
    end

    local part =
        tostring(
            S.aim_target_part
            or "Head"
        )

    if part == "Head" then
        if p.head_pos
            and p.head_pos.X
            and p.head_pos.Y
            and p.head_pos.Z
        then
            return p.head_pos
        end

        local head =
            fap_find_bone_pos(
                p,
                { "Head" }
            )

        if head then
            return head
        end
    end

    if part == "UpperTorso" then
        local upper =
            fap_find_bone_pos(
                p,
                {
                    "UpperTorso",
                    "Torso",
                }
            )

        if upper then
            return upper
        end
    end

    if part == "LowerTorso" then
        local lower =
            fap_find_bone_pos(
                p,
                {
                    "LowerTorso",
                    "Torso",
                }
            )

        if lower then
            return lower
        end
    end

    if part == "Torso" then
        local torso =
            fap_find_bone_pos(
                p,
                {
                    "UpperTorso",
                    "Torso",
                    "LowerTorso",
                }
            )

        if torso then
            return torso
        end
    end

    if part == "HumanoidRootPart" then
        local root =
            fap_find_bone_pos(
                p,
                {
                    "HumanoidRootPart",
                    "RootPart",
                }
            )

        if root then
            return root
        end

        if p.position
            and p.position.X
            and p.position.Y
            and p.position.Z
        then
            return {
                X = p.position.X,
                Y = p.position.Y,
                Z = p.position.Z,
            }
        end
    end

    -- Cache-position fallbacks for rigs where bone data is unavailable.
    if p.position
        and p.position.X
        and p.position.Y
        and p.position.Z
    then
        local add_y = 2.0

        if part == "Torso"
            or part == "UpperTorso"
        then
            add_y = 1.45
        elseif part == "LowerTorso" then
            add_y = 0.75
        elseif part == "HumanoidRootPart" then
            add_y = 0
        end

        return {
            X = p.position.X,
            Y = p.position.Y + add_y,
            Z = p.position.Z,
        }
    end

    return nil
end

local function fap_valid_target(p)
    if not p
        or p.is_self
        or p.is_knocked
        or p.is_dead
    then
        return false
    end

    if p.health ~= nil
        and (
            tonumber(p.health)
            or 0
        ) <= 1
    then
        return false
    end

    if p.address ~= nil
        and p.address == 0
    then
        return false
    end

    local pos =
        fap_target_pos(p)

    if not pos then
        return false
    end

    if pos.X == 0
        and pos.Y == 0
        and pos.Z == 0
    then
        return false
    end

    local max_dist =
        tonumber(S.aim_max_dist)
        or 1200

    if p.distance
        and (
            p.distance <= 1
            or p.distance > max_dist
        )
    then
        return false
    end

    return true
end

