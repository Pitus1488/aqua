        base_card_y,
        col_w,
        base_card_h,
        11
    )

    card(
        right_x,
        base_card_y,
        col_w,
        base_card_h,
        11
    )

    local left_scroll =
        world_base_column_scroll_step(
            "left",
            mx,
            my,
            base_clicked,
            lmb,
            left_x,
            base_card_y,
            col_w,
            base_card_h,
            base_visible_rows,
            left_total
        )

    local right_scroll =
        world_base_column_scroll_step(
            "right",
            mx,
            my,
            base_clicked,
            lmb,
            right_x,
            base_card_y,
            col_w,
            base_card_h,
            base_visible_rows,
            right_total
        )

    local left_row_clicked =
        base_clicked
        and hover(
            mx,
            my,
            left_x,
            base_card_y,
            col_w,
            base_card_h
        )

    local right_row_clicked =
        base_clicked
        and hover(
            mx,
            my,
            right_x,
            base_card_y,
            col_w,
            base_card_h
        )

    for i = 1, left_total do
        local by =
            base_card_y
            + 4
            + ((i - 1) - left_scroll) * base_row_h

        local row_alpha =
            world_base_row_clip_alpha(
                by,
                base_card_y,
                base_card_h
            )

        if row_alpha > 0.008 then
            local cfg =
                WORLD_BASE_ITEMS[i]

            if cfg then
                local old_alpha =
                    MENU_RENDER_ALPHA

                MENU_RENDER_ALPHA =
                    old_alpha
                    * row_alpha

                world_base_compact_row(
                    mx,
                    my,
                    left_row_clicked
                        and row_alpha > 0.72,
                    left_x,
                    by,
                    col_w,
                    cfg
                )

                MENU_RENDER_ALPHA =
                    old_alpha
            end
        end
    end

    for i = 1, right_total do
        local by =
            base_card_y
            + 4
            + ((i - 1) - right_scroll) * base_row_h

        local row_alpha =
            world_base_row_clip_alpha(
                by,
                base_card_y,
                base_card_h
            )

        if row_alpha > 0.008 then
            local cfg =
                WORLD_BASE_ITEMS[
                    left_total + i
                ]

            if cfg then
                local old_alpha =
                    MENU_RENDER_ALPHA

                MENU_RENDER_ALPHA =
                    old_alpha
                    * row_alpha

                world_base_compact_row(
                    mx,
                    my,
                    right_row_clicked
                        and row_alpha > 0.72,
                    right_x,
                    by,
                    col_w,
                    cfg
                )

                MENU_RENDER_ALPHA =
                    old_alpha
            end
        end
    end

    -- Rows are virtually clipped by alpha fading before they reach
    -- the card edges. No opaque/translucent masks are drawn here, which
    -- keeps both Default and Glass styles clean.

    -- Render settings first, then the reusable color picker on top.
    draw_world_settings_popup(
        mx,
        my,
        clicked,
        lmb,
        dots_x,
        dots_y
    )

end


