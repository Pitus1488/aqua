function FALLEN_BT_STYLE_INDEX()
    local style =
        tostring(
            S.bullet_tracer_style
            or "Neon"
        )

    -- Backwards compatibility with older configs.
    if style == "Real Neon" then
        S.bullet_tracer_style = "Neon"
        style = "Neon"
    elseif style == "Wave Lightning" then
        S.bullet_tracer_style = "Lightning"
        style = "Lightning"
    elseif style == "Gradient Laser" then
        S.bullet_tracer_style = "Rainbow"
        style = "Rainbow"
    end

    if style == "Lightning" then
        return 1
    elseif style == "Rainbow" then
        return 2
    end

    if style ~= "Neon" then
        S.bullet_tracer_style = "Neon"
    end

    return 0
end

function FALLEN_BT_IMAGE_GET(key, url)
    if type(LoadImage) ~= "function"
        or not key
        or not url
    then
        return nil
    end

    local handle =
        FALLEN_BT_IMAGE[key]

    if not handle then
        local ok, loaded =
            pcall(
                LoadImage,
                url
            )

        if ok and loaded then
            FALLEN_BT_IMAGE[key] = loaded
            handle = loaded
        end
    end

    if not handle then
        return nil
    end

    if type(IsImageFailed) == "function" then
        local ok, failed =
            pcall(
                IsImageFailed,
                handle
            )

        if ok and failed == true then
            FALLEN_BT_IMAGE[key] = nil
            return nil
        end
    end

    if type(IsImageReady) == "function" then
        local ok, ready =
            pcall(
                IsImageReady,
                handle
            )

        if ok and ready == true then
            return handle
        end

        return nil
    end

    return handle
end

function FALLEN_BT_DRAW_IMAGE_NODE(
    kind,
    x,
    y,
    size,
    alpha,
    col,
    seed
)
    if type(DrawImage) ~= "function" then
        return
    end

    local spark =
        FALLEN_BT_IMAGE_GET(
            "spark",
            FALLEN_BT_IMAGE.spark_url
        )

    if not spark then
        return
    end

    local flick =
        0.65
        + 0.35
        * math.sin(
            tick() * 36
            + (seed or 1)
        )

    local s =
        size
        * (
            0.70
            + 0.35 * flick
        )

    if kind == 6 then
        DrawImage(
            spark,
            x - s * 0.5,
            y - s * 0.5,
            s,
            s,
            col[1],
            col[2],
            col[3],
            alpha * 0.78,
            0
        )

        local star =
            FALLEN_BT_IMAGE_GET(
                "star",
                FALLEN_BT_IMAGE.star_url
            )

        if star then
            local s2 = size * 0.42

            DrawImage(
                star,
                x - s2 * 0.5,
                y - s2 * 0.5,
                s2,
                s2,
                1,
                1,
                1,
                alpha * 0.28,
                0
            )
        end
    else
        DrawImage(
            spark,
            x - s * 0.5,
            y - s * 0.5,
            s,
            s,
            0.72,
            0.94,
            1.0,
            alpha * 0.90,
            0
        )

        local flash =
            FALLEN_BT_IMAGE_GET(
                "flash",
                FALLEN_BT_IMAGE.flash_url
            )

        if flash then
            local s2 = size * 0.42

            DrawImage(
                flash,
                x - s2 * 0.5,
                y - s2 * 0.5,
                s2,
                s2,
                1,
                1,
                1,
                alpha * 0.22,
                0
            )
        end
    end
