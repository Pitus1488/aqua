local function sidebar_tab(mx, my, clicked, x, y, index)
    local w, h = 152, 35
    local active = S.tab == index
    local hot = hover(mx, my, x, y, w, h)

    A.sidebar_tab_anim[index] =
        A.sidebar_tab_anim[index]
        or (
            active
            and 1
            or 0
        )

    local target =
        active
        and 1
        or 0

    A.sidebar_tab_anim[index] =
        lerp(
            A.sidebar_tab_anim[index],
            target,
            0.18
        )

    local a =
        clamp(
            A.sidebar_tab_anim[index],
            0,
            1
        )

    -- Active background is rendered separately as one moving pill.
    -- Only hover tint remains local to the row.
    if hot and not active then
        rounded_fill(
            x,
            y,
            w,
            h,
            7,
            alpha(
                C.card_hover,
                0.55
                    * (1 - a)
            )
        )
    end

    local col =
        mix_color(
            C.text_dim,
            C.text,
            a
        )

    col =
        FALLEN_HOVER_TEXT(
            "sidebar:" .. tostring(index),
            hot,
            col
        )

    local ic =
        mix_color(
            C.text_dim,
            C.accent,
            a
        )

    -- Sidebar icons should stay crisp even when the Gradient shell itself is
    -- 50% transparent. Their own alpha remains 1; only menu open/close alpha
    -- is applied by the primitive wrappers.
    ic[4] = 1

    local icon = ICONS[index]

    if icon then
        icon(
            x + 12,
            y + 10,
            ic
        )
    end

    text(
        x + 37,
        y + 10,
        TABS[index].label,
        col
    )

    if clicked
        and hot
        and S.tab ~= index
    then
        S.tab = index
        S.anim = 0

        A.aim_settings_open = false
        A.aim_part_dropdown_open = false
        A.fov_picker_open = false
        A.world_settings_open = false
        A.world_color_picker_open = false
        A.world_color_picker_drag = nil
        FALLEN_COLOR_INPUT_STOP(true)

        if aim_bind_cancel then
            aim_bind_cancel()
        end

        if numeric_stop then
            numeric_stop(true)
        end
    end
end

