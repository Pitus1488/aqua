function FALLEN_DRAW_ROUNDED_GLOW_FRAME(
    x,
    y,
    w,
    h,
    radius,
    color,
    thickness
)
    radius =
        math.max(
            1,
            math.min(
                tonumber(radius) or 1,
                math.min(w, h) * 0.5
            )
        )

    thickness =
        thickness
        or 1

    -- Straight sides stop before the rounded corners.
    line(
        x + radius,
        y,
        x + w - radius,
        y,
        color,
        thickness
    )

    line(
        x + radius,
        y + h,
        x + w - radius,
        y + h,
        color,
        thickness
    )

    line(
        x,
        y + radius,
        x,
        y + h - radius,
        color,
        thickness
    )

    line(
        x + w,
        y + radius,
        x + w,
        y + h - radius,
        color,
        thickness
    )

    -- Rounded corners made from short line segments.
    -- Six segments per quarter is enough for a soft glow edge.
    local segments = 6

    local function arc(cx, cy, a0, a1)
        local px =
            cx
            + math.cos(a0)
            * radius

        local py =
            cy
            + math.sin(a0)
            * radius

        for n = 1, segments do
            local a =
                a0
                + (a1 - a0)
                * (n / segments)

            local nx =
                cx
                + math.cos(a)
                * radius

            local ny =
                cy
                + math.sin(a)
                * radius

            line(
                px,
                py,
                nx,
                ny,
                color,
                thickness
            )

            px = nx
            py = ny
        end
    end

    arc(
        x + radius,
        y + radius,
        math.pi,
        math.pi * 1.5
    )

    arc(
        x + w - radius,
        y + radius,
        math.pi * 1.5,
        math.pi * 2
    )

    arc(
        x + w - radius,
        y + h - radius,
        0,
        math.pi * 0.5
    )

    arc(
        x + radius,
        y + h - radius,
        math.pi * 0.5,
        math.pi
    )
end

function FALLEN_GEAR_HOVER_STEP(hot)
    local now = tick()

    if A.gear_hover_last_t == nil then
        A.gear_hover_last_t = now
    end

    local dt =
        clamp(
            now - A.gear_hover_last_t,
            0,
            0.05
        )

    A.gear_hover_last_t = now

    local p =
        clamp(
            tonumber(A.gear_hover_anim) or 0,
            0,
            1
        )

    if hot then
        -- Full white / full scale after roughly one second.
        p =
            math.min(
                1,
                p + dt / 1.0
            )
    else
        -- Return a little faster so the control stays responsive.
        p =
            math.max(
                0,
                p - dt / 0.35
            )
    end

    A.gear_hover_anim = p
    return smooth01(p)
end

function FALLEN_DRAW_GEAR(cx, cy, hot, hover_anim)
    local p =
        clamp(
            tonumber(hover_anim) or 0,
            0,
            1
        )

    local scale =
        1
        + 0.14 * p

    local base =
        C.text_dim

    local col = {
        lerp(base[1] or 0.5, 1.0, p),
        lerp(base[2] or 0.5, 1.0, p),
        lerp(base[3] or 0.5, 1.0, p),
        1.0,
    }

    local hole_base =
        C.sidebar

    local hole_col = {
        lerp(hole_base[1] or 0.08, 0.10, p),
        lerp(hole_base[2] or 0.08, 0.105, p),
        lerp(hole_base[3] or 0.09, 0.125, p),
        1.0,
    }

    -- Outer gear body.
    circle_fill(
        cx,
        cy,
        4.9 * scale,
        col
    )

    -- Eight smooth teeth around the body.
    for i = 0, 7 do
        local a =
            (i / 8)
            * math.pi
            * 2

        circle_fill(
            cx
                + math.cos(a)
                * 6.1
                * scale,
            cy
                + math.sin(a)
                * 6.1
                * scale,
            2.15 * scale,
            col
        )
    end

    -- Clean center hole.
    circle_fill(
        cx,
        cy,
        2.35 * scale,
        hole_col
    )

    circle(
        cx,
        cy,
        2.85 * scale,
        alpha(col, 0.22),
        1
    )
end

