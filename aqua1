local function aim_part_dropdown_step_anim()
    local now = tick()

    if A.aim_part_dropdown_last_t == nil then
        A.aim_part_dropdown_last_t = now
    end

    local dt = clamp(now - A.aim_part_dropdown_last_t, 0, 0.05)
    A.aim_part_dropdown_last_t = now

    local target =
        A.aim_part_dropdown_open
        and 1
        or 0

    local speed =
        target > (A.aim_part_dropdown_anim or 0)
        and 16
        or 12

    A.aim_part_dropdown_anim =
        exp_chase(
            A.aim_part_dropdown_anim or 0,
            target,
            speed,
            dt
        )

    if math.abs((A.aim_part_dropdown_anim or 0) - target) < 0.0015 then
        A.aim_part_dropdown_anim = target
    end

    return clamp(A.aim_part_dropdown_anim or 0, 0, 1)
end

local function draw_aim_part_dropdown(
    mx,
    my,
    clicked,
    x,
    y,
    w
)
    local anim =
        aim_part_dropdown_step_anim()

    if anim <= 0.004
        and not A.aim_part_dropdown_open
    then
        return false
    end

    local item_h = 27
    local full_h = #AIM_PARTS * item_h

    -- Real downward expansion: top stays fixed, bottom grows down.
    local eased =
        ease_out_cubic(anim)

    local visible_h =
        full_h * eased

    local panel_y = y
    local panel_h = math.max(2, visible_h)

    FALLEN_POPUP_GLOW(x, panel_y, w, panel_h, 7, 0.9)

    rounded_fill(
        x,
        panel_y,
        w,
        panel_h,
        7,
        { 0.070, 0.074, 0.087, 1 }
    )

    local panel_hot =
        hover(
            mx,
            my,
            x,
            panel_y,
            w,
            panel_h
        )

    for i, option in ipairs(AIM_PARTS) do
        local iy =
            panel_y
            + (i - 1) * item_h

        -- Only show an option after that section of the dropdown has unfolded.
        local item_reveal =
            clamp(
                (visible_h - (i - 1) * item_h)
                / item_h,
                0,
                1
            )

        if item_reveal > 0.12 then
            local item_hot =
                item_reveal > 0.92
                and hover(
                    mx,
                    my,
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4
                )

            if item_hot then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4,
                    5,
                    { 0.105, 0.111, 0.132, 1 }
                )
            end

            if option == S.aim_target_part then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    3,
                    item_h - 4,
                    1,
                    C.accent
                )
            end

            text(
                x + 12,
                iy + 8,
                option,
                FALLEN_HOVER_TEXT(
                    "aim_part_option:" .. tostring(option),
                    item_hot,
                    option == S.aim_target_part and C.text or C.text_dim
                )
            )

            if clicked
                and item_hot
                and A.aim_part_dropdown_open
            then
                S.aim_target_part = option
                A.aim_part_dropdown_open = false
                return true
            end
        end
    end

    return panel_hot
end

local function draw_aim_settings_popup(
    mx,
    my,
    clicked,
    lmb,
    rmb_clicked,
    dots_x,
    dots_y
)
    local raw_anim =
        aim_settings_step_anim()

    if raw_anim <= 0.001
        and not A.aim_settings_open
    then
        A.aim_part_dropdown_open = false
        A.aim_part_dropdown_anim = 0
        return
    end

    -- Fade the WHOLE popup together with the retract animation.
    -- This fixes the "it has already moved away but stays visible" look.
    local parent_menu_alpha = MENU_RENDER_ALPHA

    local popup_fade =
        ease_out_cubic(
            clamp(raw_anim, 0, 1)
        )

    MENU_RENDER_ALPHA =
        parent_menu_alpha
        * popup_fade

    -- Different visual easing for opening/closing.
    -- Opening pushes outward; closing retracts cleanly back into the Aimbot row.
    local anim

    if A.aim_settings_open then
        anim =
            ease_out_cubic(raw_anim)
    else
        anim =
            ease_in_out_cubic(raw_anim)
    end

    local pw = 300
    local ph = 171

    local base_px =
        dots_x
        - pw
        + 28

    local base_py =
        dots_y
        + 31

    -- Rebuilt motion:
    -- at 0 the popup sits close to the Aimbot row,
    -- at 1 it is fully extended below it.
    local retract =
        1 - anim

    local px =
        base_px
        + retract * 14

    local py =
        base_py
        - retract * 34

    px = snap(px)
    py = snap(py)

    -- Main shell retracts upward while fading, so the closing direction
    -- visually returns into the Aimbot row rather than drifting sideways.
    local shell_h =
        math.max(
            28,
            ph
            - retract * 58
        )

    local interactive =
        raw_anim > 0.96
        and A.aim_settings_open

    local ui_clicked =
        clicked
        and interactive

    FALLEN_POPUP_GLOW(px, py, pw, shell_h, 11, 1)

    rounded_fill(
        px,
        py,
        pw,
        shell_h,
        11,
        { 0.062, 0.066, 0.077, 1 }
    )

    -- Hide deeper controls progressively while retracting so they don't
    -- visually "hang" outside the shrinking shell.
    local details_visible =
        raw_anim > 0.42

    text(
        px + 13,
        py + 12,
        "Aimbot settings",
        C.text
    )

    if shell_h > 39 then
        line(
            px + 12,
            py + 34,
            px + pw - 12,
            py + 34,
            C.divider,
            1
        )
    end

    if details_visible then
        -- Keybind row
        text(
            px + 13,
            py + 52,
            "Keybind",
            C.text
        )

        local chip_w = 105
        local chip_h = 29
        local chip_x = px + pw - chip_w - 12
        local chip_y = py + 42

        local chip_hot =
            hover(
                mx,
                my,
                chip_x,
                chip_y,
                chip_w,
                chip_h
            )

        rounded_fill(
            chip_x,
            chip_y,
            chip_w,
            chip_h,
            7,
            chip_hot
                and { 0.115, 0.120, 0.145, 1 }
                or { 0.092, 0.096, 0.112, 1 }
        )

        if A.aim_bind_listening then
            rounded_outline(
                chip_x,
                chip_y,
                chip_w,
                chip_h,
                7,
                alpha(C.accent, 0.72),
                1,
                { 0.092, 0.096, 0.112, 1 }
            )
        end

        local key_label =
            A.aim_bind_listening
            and "Press key..."
            or aim_vk_name(S.aim_hold_key)

        centered_text(
            chip_x + chip_w * 0.5,
            chip_y + 9,
            key_label,
            A.aim_bind_listening
                and C.accent
                or C.text
        )

        if ui_clicked
            and chip_hot
        then
            aim_bind_start()
            A.fov_picker_open = false
            A.fov_picker_drag = nil
            A.aim_part_dropdown_open = false
        end

        if shell_h > 84 then
            line(
                px + 12,
                py + 79,
                px + pw - 12,
                py + 79,
                C.divider,
                1
            )
        end

        -- Max Distance
        if shell_h > 119 then
            slider_row(
                mx,
                my,
                ui_clicked,
                lmb,
                px + 8,
                py + 80,
                pw - 16,
                "Max Distance",
                "aim_max_dist",
                50,
                3000,
                "int"
            )

            line(
                px + 12,
                py + 120,
                px + pw - 12,
                py + 120,
                C.divider,
                1
            )
        end

        -- Body Part row with a REAL dropdown.
        if shell_h > 153 then
            local row_x = px + 8
            local row_y = py + 121
            local row_w = pw - 16

            row_hover(
                mx,
                my,
                row_x,
                row_y,
                row_w,
                41
            )

            text(
                row_x + 13,
                row_y + 14,
                "Body Part",
                C.text
            )

            local field_w = 142
            local field_h = 25
            local field_x = row_x + row_w - field_w - 4
            local field_y = row_y + 8

            local field_hot =
                hover(
                    mx,
                    my,
                    field_x,
                    field_y,
                    field_w,
                    field_h
                )

            rounded_fill(
                field_x,
                field_y,
                field_w,
                field_h,
                6,
                field_hot
                    and { 0.110, 0.115, 0.135, 1 }
                    or C.toggle_off
            )

            text(
                field_x + 10,
                field_y + 7,
                tostring(S.aim_target_part or "Head"),
                C.text
            )

            text(
                field_x + field_w - 18,
                field_y + 7,
                A.aim_part_dropdown_open and "^" or "v",
                C.text_dim
            )

            if ui_clicked
                and field_hot
            then
                A.aim_part_dropdown_open =
                    not A.aim_part_dropdown_open

                if A.aim_part_dropdown_open then
                    numeric_stop(true)
                end
            end

            local dropdown_y =
                field_y
                + field_h
                + 5

            local dropdown_hot =
                draw_aim_part_dropdown(
                    mx,
                    my,
                    ui_clicked,
                    field_x,
                    dropdown_y,
                    field_w
                )

            local popup_hot =
                hover(
                    mx,
                    my,
                    px,
                    py,
                    pw,
                    shell_h
                )

            local dots_hot =
                hover(
                    mx,
                    my,
                    dots_x,
                    dots_y,
                    27,
                    25
                )

            if interactive
                and not A.aim_bind_listening
                and clicked
                and not popup_hot
                and not dots_hot
                and not dropdown_hot
            then
                A.aim_settings_open = false
                A.aim_part_dropdown_open = false
            end

            MENU_RENDER_ALPHA = parent_menu_alpha
            return
        end
    end

    local popup_hot =
        hover(
            mx,
            my,
            px,
            py,
            pw,
            shell_h
        )

    local dots_hot =
        hover(
            mx,
            my,
            dots_x,
            dots_y,
            27,
            25
        )

    if interactive
        and not A.aim_bind_listening
        and clicked
        and not popup_hot
        and not dots_hot
    then
        A.aim_settings_open = false
        A.aim_part_dropdown_open = false
    end

    MENU_RENDER_ALPHA = parent_menu_alpha
end

