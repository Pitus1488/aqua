function FALLEN_HITFX_STYLE_INDEX()
    local style =
        tostring(
            S.hit_effect_style
            or "Hit 1"
        )

    -- Backwards compatibility with old names.
    if style == "Fallen Spark" then
        S.hit_effect_style = "Hit 1"
        style = "Hit 1"
    elseif style == "Boom" then
        S.hit_effect_style = "Hit 2"
        style = "Hit 2"
    elseif style == "Smoke Sparks" then
        S.hit_effect_style = "Hit 3"
        style = "Hit 3"
    end

    if style == "Hit 2" then
        return 1
    elseif style == "Hit 3" then
        return 2
    end

    if style ~= "Hit 1" then
        S.hit_effect_style = "Hit 1"
    end

    return 0
end

