local function fap_find_target(cross, cam)
    if not players
        or type(players.get_all) ~= "function"
    then
        return nil
    end

    local ok, all =
        pcall(
            players.get_all
        )

    if not ok
        or type(all) ~= "table"
    then
        return nil
    end

    local fov =
        clamp(
            tonumber(S.aim_fov_size)
            or 50,
            10,
            600
        )

    local best = nil
    local best_sd = math.huge

    -- Sticky Aim: keep the same valid target while the aim key is held.
    if S.sticky_aim == true
        and FAP.locked_target_addr
    then
        for _, p in ipairs(all) do
            if p.address
                == FAP.locked_target_addr
            then
                if fap_valid_target(p) then
                    return p
                end

                FAP.locked_target_addr = nil
                break
            end
        end
    end

    for _, p in ipairs(all) do
        if fap_valid_target(p) then
            local pos =
                fap_target_pos(p)

            local predicted =
                fap_predict(
                    p,
                    pos,
                    cam
                )
                or pos

            local s = nil

            pcall(function()
                s =
                    aim.world_to_screen(
                        predicted
                    )
            end)

            if s
                and s.visible
            then
                local dx =
                    (s.X or 0)
                    - (cross.X or 0)

                local dy =
                    (s.Y or 0)
                    - (cross.Y or 0)

                local sd =
                    math.sqrt(
                        dx * dx
                        + dy * dy
                    )

                if sd <= fov
                    and sd < best_sd
                then
                    best_sd = sd
                    best = p
                end
            end
        end
    end

    if best
        and S.sticky_aim == true
    then
        FAP.locked_target_addr =
            best.address
    end

    return best
end


function FALLEN_SILENT_TARGET_PART_INDEX()
    local part =
        tostring(
            S.aim_target_part
            or "Head"
        )

    if part == "Head" then
        return 0
    end

    -- Built-in silent aim exposes Head / Torso / Feet.
    -- Our torso/root variants map to Torso.
    return 1
end

function FALLEN_SILENT_PRED_CALLBACK(target, pos, cam)
    if not pos then
        return nil
    end

    if S.aim_auto_prediction ~= true then
        return pos
    end

    local use_cam = cam

    if not use_cam
        and aim
        and type(aim.get_camera_position) == "function"
    then
        pcall(function()
            use_cam =
                aim.get_camera_position()
        end)
    end

    local predicted = nil

    pcall(function()
        predicted =
            fap_predict(
                target,
                pos,
                use_cam
            )
    end)

    return predicted or pos
end



function FALLEN_SILENT_TICK()
    if not cheat
        or not cheat.silent_aim
    then
        return
    end

    local sa =
        cheat.silent_aim

    local enabled =
        S.silent_enabled == true

    local fov =
        clamp(
            tonumber(S.aim_fov_size)
            or 50,
            10,
            600
        )

    -- Silent Aim toggle from our menu.
    pcall(function()
        sa.enabled = enabled
    end)

    -- Always force the cheat's built-in Raycast method.
    -- No method selector is exposed in our menu.
    pcall(function()
        sa.method = 2
    end)

    -- Use the exact same FOV setting as our Aimbot/FOV panel.
    pcall(function()
        sa.fov_only = true
    end)

    pcall(function()
        sa.fov = fov
    end)

    pcall(function()
        sa.sticky_aim =
            S.sticky_aim == true
    end)

    pcall(function()
        sa.target_part =
            FALLEN_SILENT_TARGET_PART_INDEX()
    end)

    pcall(function()
        sa.prediction =
            S.aim_auto_prediction == true
    end)

    -- Keep our Auto Prediction bridge.
    pcall(function()
        sa.prediction_callback =
            FALLEN_SILENT_PRED_CALLBACK
    end)

    pcall(function()
        sa.predict_callback =
            FALLEN_SILENT_PRED_CALLBACK
    end)

    pcall(function()
        sa.target_position_callback =
            FALLEN_SILENT_PRED_CALLBACK
    end)

    pcall(function()
        sa.position_callback =
            FALLEN_SILENT_PRED_CALLBACK
    end)

end

local function fap_draw_fov()
    if (
            S.aim_enabled ~= true
            and S.silent_enabled ~= true
        )
        or S.aim_fov_enabled ~= true
        or type(DrawCircle) ~= "function"
    then
        return
    end

    local c =
        crosshair_pos()

    if not c then
        return
    end

    local col =
        fov_color()

    local fov_radius =
        clamp(
            tonumber(S.aim_fov_size)
            or 50,
            10,
            600
        )

    local fov_segments =
        math.floor(
            clamp(
                fov_radius * 3.6,
                180,
                512
            )
        )

    -- Optional Filled FOV: same color as the outline,
    -- fixed at 50% opacity.
    if S.aim_fov_filled == true
        and type(DrawCircleFilled) == "function"
    then
        DrawCircleFilled(
            c.X,
            c.Y,
            fov_radius,
            col[1],
            col[2],
            col[3],
            col[4] * 0.50
        )
    end

    if S.aim_fov_glow_enabled == true then
        local gc =
            FALLEN_FOV_GLOW_COLOR()

        local glow_strength =
            clamp(
                (tonumber(S.aim_fov_glow_strength) or 60) / 100,
                0,
                1
            )

        local glow_spread =
            clamp(
                tonumber(S.aim_fov_glow_spread) or 6,
                1,
                12
            )

        if glow_strength > 0.001
            and gc[4] > 0.001
        then
            -- Same idea as the menu glow: many thin lines, strongest right at
            -- the edge of the FOV circle, then fading outward.
            local glow_layers = 35

            for layer = 1, glow_layers do
                local t =
                    (layer - 1)
                    / (glow_layers - 1)

                local edge_fade =
                    1 - t

                local ring_radius =
                    fov_radius
                    + t * glow_spread

                local ring_alpha =
                    gc[4]
                    * glow_strength
                    * (
                        edge_fade
                        * edge_fade
                    )
                    * 0.80

                local ring_thickness =
                    1.15
                    + edge_fade * 0.35

                local ring_prev_x =
                    c.X + ring_radius

                local ring_prev_y =
                    c.Y

                for i = 1, fov_segments do
                    local ang =
                        (i / fov_segments)
                        * math.pi
                        * 2

                    local nx =
                        c.X
                        + math.cos(ang)
                        * ring_radius

                    local ny =
                        c.Y
                        + math.sin(ang)
                        * ring_radius

                    DrawLine(
                        ring_prev_x,
                        ring_prev_y,
                        nx,
                        ny,
                        gc[1],
                        gc[2],
                        gc[3],
                        ring_alpha,
                        ring_thickness
                    )

                    ring_prev_x = nx
                    ring_prev_y = ny
                end
            end
        end
    end

    local prev_x =
        c.X + fov_radius

    local prev_y =
        c.Y

    for i = 1, fov_segments do
        local ang =
            (i / fov_segments)
            * math.pi
            * 2

        local nx =
            c.X
            + math.cos(ang)
            * fov_radius

        local ny =
            c.Y
            + math.sin(ang)
            * fov_radius

        DrawLine(
            prev_x,
            prev_y,
            nx,
            ny,
            col[1],
            col[2],
            col[3],
            col[4],
            1.2
        )

        prev_x = nx
        prev_y = ny
    end
end

local function fap_tick()
    if _G.FallenMenuReady ~= true then
        return
    end

    -- Aim FOV is visual and stays visible while the feature is enabled.
    fap_draw_fov()

    if S.aim_enabled ~= true then
        fap_clear_lock()
        return
    end

    fap_refresh_weapon()

    if not fap_hold_down() then
        fap_clear_lock()
        return
    end

    if not aim
        or type(aim.get_camera_position) ~= "function"
        or type(aim.world_to_screen) ~= "function"
        or type(aim.look_at_matrix) ~= "function"
        or type(aim.set_camera_rotation) ~= "function"
    then
        return
    end

    local cross =
        crosshair_pos()

    if not cross then
        return
    end

    local cam = nil

    pcall(function()
        cam =
            aim.get_camera_position()
    end)

    if not cam then
        return
    end

    local target =
        fap_find_target(
            cross,
            cam
        )

    if not target then
        if S.sticky_aim ~= true then
            fap_clear_lock()
        end
        return
    end

    local pos =
        fap_target_pos(
            target
        )

    if not pos then
        return
    end

    local predicted =
        fap_predict(
            target,
            pos,
            cam
        )

    if not predicted then
        return
    end

    FAP.current_target_addr =
        target.address
        or target.player_addr
        or target.character_addr

    FAP.current_target_name =
        tostring(
            target.name
            or target.display_name
            or ""
        )

    FAP.current_target_pos = {
        X = predicted.X,
        Y = predicted.Y,
        Z = predicted.Z,
    }

    FAP.current_target_health =
        tonumber(
            target.health
            or target.hp
            or target.Health
        )

    FAP.current_prediction_time =
        tonumber(predicted.time)
        or 0

    FAP.current_prediction_gravity =
        tonumber(FAP.gravity)
        or 0

    FAP.current_prediction_speed =
        tonumber(FAP.bullet_speed)
        or 0

    FAP.current_auto_prediction =
        S.aim_auto_prediction == true

    FAP.current_target_seen = tick()

    local mat = nil

    pcall(function()
        mat =
            aim.look_at_matrix(
                cam,
                predicted
            )
    end)

    if not mat then
        return
    end

    pcall(function()
        aim.set_camera_rotation(
            mat
        )
    end)
end

hooks.on_render(function()
    local ok, err =
        pcall(
            fap_tick
        )

    if not ok then
        -- Do not spam console every frame with the same transient target error.
        FAP.last_error_at =
            FAP.last_error_at
            or 0

        if tick() - FAP.last_error_at > 2 then
            FAP.last_error_at = tick()
            warn(
                SYS
                .. "Aimbot: "
                .. tostring(err)
            )
        end
    end
end)

