-- Fallen Survival loader
-- Adapted for the user's custom Lua API.

-- Product artwork (URL loader image)
-- Same image object is reused by both loader pages.
--
-- fotovssylku /i/... is usually an image PAGE, not raw PNG bytes.
-- Resolve its og:image/twitter:image first, then feed the direct URL
-- to Drawing.LoadImage.

_G.FALLEN_LOADER_PRODUCT_PAGE_URL =
    "https://fotovssylku.ru/i/noFilter-%281%29.cla3G"

_G.FALLEN_LOADER_PRODUCT_IMAGE_URL =
    _G.FALLEN_LOADER_PRODUCT_PAGE_URL

function FALLEN_LOADER_RESOLVE_IMAGE_URL(url)
    if type(url) ~= "string"
        or url == ""
    then
        return nil
    end

    if not Http
        or type(Http.get) ~= "function"
    then
        return url
    end

    local resolved = url

    pcall(function()
        local http_ok, status, body =
            Http.get(
                url,
                { timeout_ms = 7000 }
            )

        if not http_ok
            or status ~= 200
            or type(body) ~= "string"
            or body == ""
        then
            return
        end

        local direct =
            body:match(
                '<meta[^>]-property%s*=%s*["\']og:image["\'][^>]-content%s*=%s*["\']([^"\']+)'
            )
            or body:match(
                '<meta[^>]-content%s*=%s*["\']([^"\']+)["\'][^>]-property%s*=%s*["\']og:image["\']'
            )
            or body:match(
                '<meta[^>]-name%s*=%s*["\']twitter:image["\'][^>]-content%s*=%s*["\']([^"\']+)'
            )
            or body:match(
                '<meta[^>]-content%s*=%s*["\']([^"\']+)["\'][^>]-name%s*=%s*["\']twitter:image["\']'
            )

        if type(direct) == "string"
            and direct ~= ""
        then
            direct =
                direct:gsub("&amp;", "&")

            if direct:sub(1, 2) == "//" then
                direct =
                    "https:"
                    .. direct
            elseif direct:sub(1, 1) == "/" then
                direct =
                    "https://fotovssylku.ru"
                    .. direct
            end

            resolved = direct
        end
    end)

    return resolved
end

local loader_source_url =
    _G.FALLEN_LOADER_PRODUCT_PAGE_URL

-- If the loader artwork URL changed between script reloads, discard the
-- previous cached image handle so the new picture is actually requested.
if _G.FALLEN_LOADER_PRODUCT_IMAGE_SOURCE
    ~= loader_source_url
then
    _G.FALLEN_LOADER_PRODUCT_IMAGE = nil
    _G.FALLEN_LOADER_PRODUCT_IMAGE_SOURCE =
        loader_source_url
end

_G.FALLEN_LOADER_PRODUCT_IMAGE_URL =
    FALLEN_LOADER_RESOLVE_IMAGE_URL(
        loader_source_url
    )
    or loader_source_url

if not _G.FALLEN_LOADER_PRODUCT_IMAGE
    and type(LoadImage) == "function"
