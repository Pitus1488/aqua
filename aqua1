            local item_hot =
                reveal > 0.92
                and hover(
                    mx,
                    my,
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4
                )

            if item_hot then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4,
                    5,
                    { 0.105, 0.111, 0.132, 1 }
                )
            end

            local selected =
                tostring(S.menu_type or "glass")
                :lower()
                == tostring(value):lower()

            if selected then
                rounded_fill(
                    x + 4,
                    iy + 3,
                    3,
                    item_h - 6,
                    1,
                    C.accent
                )
            end

            text(
                x + 12,
                iy + 8,
                value,
                FALLEN_HOVER_TEXT(
                    "menu_type_option:" .. tostring(value),
                    item_hot,
                    selected and C.text or C.text_dim
                )
            )

            if clicked
                and item_hot
                and A.menu_type_dropdown_open
            then
                S.menu_type =
                    tostring(value):lower()

                A.menu_type_dropdown_open = false
                return true
            end
        end
    end

    return panel_hot
end


