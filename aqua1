    local fov_dots_x = rx + right_w - 79
    local fov_dots_y = cy + 40
    local fov_dots_hot =
        hover(
            mx,
            my,
            fov_dots_x,
            fov_dots_y,
            27,
            25
        )

    toggle_row(
        mx,
        my,
        base_clicked and not fov_dots_hot,
        rx,
        cy + 32,
        right_w,
        "Aim FOV",
        "aim_fov_enabled",
        true
    )

    local fov_row_hot =
        hover(
            mx,
            my,
            rx,
            cy + 32,
            right_w,
            41
        )

    if (base_clicked and fov_dots_hot)
        or (rmb_clicked and fov_row_hot)
    then
        A.fov_settings_open =
            not A.fov_settings_open

        A.aim_settings_open = false

        if not A.fov_settings_open then
            numeric_stop(true)
        end
    end

    line(
        rx + 12,
        cy + 72,
        rx + right_w - 12,
        cy + 72,
        C.divider,
        1
    )

    slider_row(
        mx,
        my,
        base_clicked,
        lmb,
        rx,
        cy + 73,
        right_w,
        "FOV Size",
        "aim_fov_size",
        10,
        600,
        "int"
    )

    line(
        rx + 12,
        cy + 113,
        rx + right_w - 12,
        cy + 113,
        C.divider,
        1
    )

    local swatch_x =
        rx + right_w - 36

