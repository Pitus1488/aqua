-- =========================================================
-- Animated menu-background weather
-- =========================================================

function FALLEN_WEATHER_RAND(a, b)
    a = tonumber(a) or 0
    b = tonumber(b) or 1

    if b < a then
        a, b = b, a
    end

    return
        a
        + (b - a)
        * math.random()
end

function FALLEN_WEATHER_SPAWN_SNOW(screen_w)
    local p = {
        x = FALLEN_WEATHER_RAND(10, math.max(11, screen_w - 10)),
        y = FALLEN_WEATHER_RAND(-18, -4),
        vx = FALLEN_WEATHER_RAND(-8, 8),
        vy = FALLEN_WEATHER_RAND(22, 46),
        r = FALLEN_WEATHER_RAND(0.75, 1.75),
        phase = FALLEN_WEATHER_RAND(0, math.pi * 2),
        a = FALLEN_WEATHER_RAND(0.28, 0.62),
    }

    A.weather_snow[#A.weather_snow + 1] = p
end

function FALLEN_WEATHER_SPAWN_RAIN(screen_w)
    local p = {
        x = FALLEN_WEATHER_RAND(12, math.max(13, screen_w - 12)),
        y = FALLEN_WEATHER_RAND(-36, -8),
        speed = FALLEN_WEATHER_RAND(300, 470),
        drift = FALLEN_WEATHER_RAND(-52, -28),
        len = FALLEN_WEATHER_RAND(10, 20),
        a = FALLEN_WEATHER_RAND(0.20, 0.42),
    }

    A.weather_rain[#A.weather_rain + 1] = p
end

function FALLEN_WEATHER_SPLASH(x, y, normal_x, normal_y)
    local amount =
        math.random(3, 5)

    normal_x = tonumber(normal_x) or 0
    normal_y = tonumber(normal_y) or -1

    for i = 1, amount do
        if #A.weather_splashes >= 48 then
            break
        end

        local life =
            FALLEN_WEATHER_RAND(0.16, 0.34)

        local side =
            FALLEN_WEATHER_RAND(-1, 1)

        local speed =
            FALLEN_WEATHER_RAND(34, 78)

        A.weather_splashes[#A.weather_splashes + 1] = {
            x = x + FALLEN_WEATHER_RAND(-2.2, 2.2),
            y = y + FALLEN_WEATHER_RAND(-1.2, 1.2),

            vx =
                normal_x * speed
                + side * FALLEN_WEATHER_RAND(18, 44),

            vy =
                normal_y * speed
                - FALLEN_WEATHER_RAND(4, 20),

            life = life,
            max_life = life,
            a = FALLEN_WEATHER_RAND(0.32, 0.62),
        }
    end
end

function FALLEN_WEATHER_ADD_SNOW_BANK(
    hit_x,
    menu_y,
    radius,
    incoming_vx,
    incoming_vy
)
    if type(A.weather_snow_bank) ~= "table" then
        A.weather_snow_bank = {}
    end

    if #A.weather_snow_bank >= 64 then
        table.remove(
            A.weather_snow_bank,
            1
        )
    end

    radius =
        clamp(
            tonumber(radius) or 1.2,
            0.85,
            2.25
        )

    A.weather_snow_bank[#A.weather_snow_bank + 1] = {
        -- ABSOLUTE SCREEN coordinates.
        x = tonumber(hit_x) or 0,
        y =
            (tonumber(menu_y) or 0)
            - radius
            - FALLEN_WEATHER_RAND(0.15, 0.9),

        vx =
            (tonumber(incoming_vx) or 0) * 0.22
            + FALLEN_WEATHER_RAND(-5, 5),

        vy =
            math.min(
                0,
                (tonumber(incoming_vy) or 0) * 0.08
            )
            - FALLEN_WEATHER_RAND(0, 5),

        r = radius,
        a = FALLEN_WEATHER_RAND(0.62, 0.94),
        shade = FALLEN_WEATHER_RAND(0.92, 1.0),
    }
end

function FALLEN_WEATHER_UPDATE_SNOW_BANK(
    dt,
    menu_x,
    menu_y,
    menu_w,
    menu_h,
    screen_w,
    screen_h
)
    if type(A.weather_snow_bank) ~= "table" then
        A.weather_snow_bank = {}
    end

    local bank =
        A.weather_snow_bank

    -- ---------------------------------
    -- MENU VELOCITY
    -- ---------------------------------
    local last_menu_x =
        tonumber(A.weather_menu_last_x)
        or menu_x

    local last_menu_y =
        tonumber(A.weather_menu_last_y)
        or menu_y

    local safe_dt =
        math.max(
            0.001,
            dt
        )

    local menu_vx =
        clamp(
            (menu_x - last_menu_x) / safe_dt,
            -1400,
            1400
        )

    local menu_vy =
        clamp(
            (menu_y - last_menu_y) / safe_dt,
            -1400,
            1400
        )

    A.weather_menu_last_x = menu_x
    A.weather_menu_last_y = menu_y

    -- ---------------------------------
    -- MOUSE BRUSH
    -- ---------------------------------
    local mx, my =
        mouse_pos()

    local last_mx =
        tonumber(A.weather_mouse_x)
        or mx

    local last_my =
        tonumber(A.weather_mouse_y)
        or my

    local mdx =
        clamp(
            mx - last_mx,
            -70,
            70
        )

    local mdy =
        clamp(
            my - last_my,
            -70,
            70
        )

    A.weather_mouse_x = mx
    A.weather_mouse_y = my

    for i = 1, #bank do
        local p =
            bank[i]

        local dx =
            p.x - mx

        local dy =
            p.y - my

        local d2 =
            dx * dx
            + dy * dy

        local influence =
            42

        if d2 < influence * influence then
            local dist =
                math.sqrt(
                    math.max(
                        d2,
                        0.001
                    )
                )

            local strength =
                1
                - clamp(
                    dist / influence,
                    0,
                    1
                )

            -- Much stronger cursor momentum.
            p.vx =
                p.vx
                + mdx
                * (5.5 + strength * 7.5)
                * strength

            p.vy =
                p.vy
                + mdy
                * (2.8 + strength * 4.5)
                * strength

            -- Strong local repulsion, so even a slow mouse sweep pushes snow.
            p.vx =
                p.vx
                + (dx / dist)
                * 150
                * strength
                * dt

            p.vy =
                p.vy
                + (dy / dist)
                * 95
                * strength
                * dt
        end
    end

    -- ---------------------------------
    -- FREE PHYSICS
    -- ---------------------------------
    for i = 1, #bank do
        local p =
            bank[i]

        p.old_x = p.x
        p.old_y = p.y

        p.vy =
            (tonumber(p.vy) or 0)
            + 170 * dt

        -- Air drag only. Do NOT attach particles to the menu.
        p.vx =
            (tonumber(p.vx) or 0)
            * math.max(
                0,
                1 - 0.70 * dt
            )

        p.x =
            (tonumber(p.x) or 0)
            + p.vx * dt

        p.y =
            (tonumber(p.y) or 0)
            + p.vy * dt
    end

    -- ---------------------------------
    -- PARTICLE-PARTICLE COLLISION
    -- ---------------------------------
    for i = 1, #bank - 1 do
        local a =
            bank[i]

        for j = i + 1, #bank do
            local b =
                bank[j]

            local dx =
                b.x - a.x

            local dy =
                b.y - a.y

            local min_d =
                (a.r or 1)
                + (b.r or 1)

            local d2 =
                dx * dx
                + dy * dy

            if d2 > 0.0001
                and d2 < min_d * min_d
            then
                local d =
                    math.sqrt(d2)

                local nx =
                    dx / d

                local ny =
                    dy / d

                local push =
                    (min_d - d)
                    * 0.54

                a.x =
                    a.x
                    - nx * push

                a.y =
                    a.y
                    - ny * push

                b.x =
                    b.x
                    + nx * push

                b.y =
                    b.y
                    + ny * push

                local rel =
                    (b.vx - a.vx) * nx
                    + (b.vy - a.vy) * ny

                if rel < 0 then
                    local impulse =
                        -rel * 0.20

                    a.vx =
                        a.vx
                        - nx * impulse

                    a.vy =
                        a.vy
                        - ny * impulse

                    b.vx =
                        b.vx
                        + nx * impulse

                    b.vy =
                        b.vy
                        + ny * impulse
                end
            end
        end
    end

    -- ---------------------------------
    -- MENU ROOF COLLISION
    -- ---------------------------------
    for i = #bank, 1, -1 do
        local p =
            bank[i]

        local r =
            tonumber(p.r) or 1

        local inside_roof_x =
            p.x >= menu_x + r
            and p.x <= menu_x + menu_w - r

        local old_bottom =
            (p.old_y or p.y) + r

        local new_bottom =
            p.y + r

        local roof_contact =
            inside_roof_x
            and (
                -- Normal falling collision.
                (
                    old_bottom <= menu_y + 1
                    and new_bottom >= menu_y
                )
                -- Menu moved UP into the particle.
                or (
                    menu_vy < -15
                    and new_bottom > menu_y
                    and p.y < menu_y + r * 2.5
                )
            )

        if roof_contact then
            p.y =
                menu_y - r

            if menu_vy < -15 then
                -- Fast upward menu motion actually throws snow upward.
                p.vy =
                    math.min(
                        p.vy,
                        menu_vy * 0.82
                    )
                    - math.min(
                        55,
                        math.abs(menu_vy) * 0.06
                    )
            elseif p.vy > 0 then
                p.vy =
                    -p.vy * 0.10
            end

            -- Horizontal menu motion gives a little shove, but snow is not glued.
            p.vx =
                p.vx
                + menu_vx * 0.035

            -- Ground friction only while actually touching the roof.
            p.vx =
                p.vx
                * 0.84
        end

        -- When menu moves DOWN, the snow keeps its old world/screen position.
        -- Gravity then makes it fall back onto the roof naturally.

        if p.x < -45
            or p.x > screen_w + 45
            or p.y > screen_h + 45
        then
            table.remove(
                bank,
                i
            )
        end
    end

    -- ---------------------------------
    -- DRAW
    -- ---------------------------------
    if (A.weather_snow_alpha or 0) > 0.01 then
        for i = 1, #bank do
            local p =
                bank[i]

            local r =
                p.r or 1

            if p.x + r >= 0
                and p.x - r <= screen_w
                and p.y + r >= 0
                and p.y - r <= screen_h
            then
                local shade =
                    p.shade or 1

                circle_fill(
                    p.x,
                    p.y,
                    r,
                    {
                        0.88 * shade,
                        0.93 * shade,
                        1.00 * shade,
                        (p.a or 0.8)
                        * A.weather_snow_alpha
                    }
                )

                if r > 1.25 then
                    circle_fill(
                        p.x - r * 0.22,
                        p.y - r * 0.25,
                        r * 0.35,
                        {
                            1,
                            1,
                            1,
                            (p.a or 0.8)
                            * A.weather_snow_alpha
                            * 0.48
                        }
                    )
                end
            end
        end
    end

    if (
        S.visible ~= true
        or S.menu_snow ~= true
    )
        and (A.weather_snow_alpha or 0) < 0.015
    then
        A.weather_snow_bank = {}
        A.weather_mouse_x = nil
        A.weather_mouse_y = nil
        A.weather_menu_last_x = nil
        A.weather_menu_last_y = nil
    end
end

function FALLEN_DRAW_MENU_WEATHER(
    screen_w,
    screen_h,
    menu_x,
    menu_y,
    menu_w,
    menu_h
)
    if type(A.weather_snow) ~= "table" then A.weather_snow = {} end
    if type(A.weather_rain) ~= "table" then A.weather_rain = {} end
    if type(A.weather_splashes) ~= "table" then A.weather_splashes = {} end

    screen_w = math.max(1, tonumber(screen_w) or 1)
    screen_h = math.max(1, tonumber(screen_h) or 1)

    menu_x = tonumber(menu_x) or 0
    menu_y = tonumber(menu_y) or 0
    menu_w = tonumber(menu_w) or 0
    menu_h = tonumber(menu_h) or 0

    local old_transform =
        MENU_UI_TRANSFORM_ACTIVE

    MENU_UI_TRANSFORM_ACTIVE = false

    local now = tick()

    if A.weather_last_t == nil then
        A.weather_last_t = now
    end

    local dt =
        clamp(
            now - A.weather_last_t,
            0,
            0.05
        )

    A.weather_last_t = now

    A.weather_snow_alpha =
        exp_chase(
            A.weather_snow_alpha or 0,
            (
                S.visible == true
                and S.menu_snow == true
            ) and 1 or 0,
            4.0,
            dt
        )

    A.weather_rain_alpha =
        exp_chase(
            A.weather_rain_alpha or 0,
            (
                S.visible == true
                and S.menu_rain == true
            ) and 1 or 0,
            4.8,
            dt
        )

    A.weather_lightning_alpha =
        exp_chase(
            A.weather_lightning_alpha or 0,
            (
                S.visible == true
                and S.menu_lightning == true
            ) and 1 or 0,
            5.6,
            dt
        )

    A.weather_lightning_flash =
        math.max(
            0,
            (A.weather_lightning_flash or 0)
            - dt * 3.2
        )

    A.weather_lightning_life =
        math.max(
            0,
            (A.weather_lightning_life or 0)
            - dt
        )

    -- ---------------------------------
    -- SNOW
    -- ---------------------------------
    if S.visible == true
        and S.menu_snow == true
    then
        A.weather_snow_spawn =
            (A.weather_snow_spawn or 0)
            + dt * 14

        while A.weather_snow_spawn >= 1
            and #A.weather_snow < 44
        do
            A.weather_snow_spawn =
                A.weather_snow_spawn - 1

            FALLEN_WEATHER_SPAWN_SNOW(screen_w)
        end
    end

    for i = #A.weather_snow, 1, -1 do
        local p =
            A.weather_snow[i]

        local old_x =
            p.x

        local old_y =
            p.y

        p.y =
            p.y
            + p.vy * dt

        p.x =
            p.x
            + (
                p.vx
                + math.sin(now * 1.45 + p.phase) * 7
            ) * dt

        local landed =
            false

        -- Snow actually settles on the TOP edge of the menu.
        if menu_w > 0
            and menu_h > 0
            and old_y + p.r < menu_y
            and p.y + p.r >= menu_y
        then
            local denom =
                (p.y + p.r)
                - (old_y + p.r)

            local t =
                denom ~= 0
                and clamp(
                    (menu_y - (old_y + p.r))
                    / denom,
                    0,
                    1
                )
                or 1

            local hit_x =
                old_x
                + (p.x - old_x) * t

            if hit_x >= menu_x + 5
                and hit_x <= menu_x + menu_w - 5
            then
                FALLEN_WEATHER_ADD_SNOW_BANK(
                    hit_x,
                    menu_y,
                    p.r,
                    p.vx,
                    p.vy
                )

                table.remove(
                    A.weather_snow,
                    i
                )

                landed = true
            end
        end

        if not landed then
            if p.y > screen_h + 8
                or p.x < -12
                or p.x > screen_w + 12
            then
                table.remove(
                    A.weather_snow,
                    i
                )
            elseif A.weather_snow_alpha > 0.01
                and p.y - p.r >= 2
                and p.y + p.r <= screen_h - 2
                and p.x - p.r >= 2
                and p.x + p.r <= screen_w - 2
                and not (
                    menu_w > 0
                    and menu_h > 0
                    and p.x + p.r >= menu_x
                    and p.x - p.r <= menu_x + menu_w
                    and p.y + p.r >= menu_y
                    and p.y - p.r <= menu_y + menu_h
                )
            then
                circle_fill(
                    p.x,
                    p.y,
                    p.r,
                    {
                        0.90,
                        0.94,
                        1.00,
                        p.a
                        * A.weather_snow_alpha
                        * 0.82
                    }
                )

                if p.r > 1.30 then
                    circle_fill(
                        p.x - 0.45,
                        p.y - 0.45,
                        p.r * 0.38,
                        {
                            1,
                            1,
                            1,
                            p.a
                            * A.weather_snow_alpha
                            * 0.52
                        }
                    )
                end
            end
        end
    end

    -- Update/draw accumulated snow after new flakes have landed.
    FALLEN_WEATHER_UPDATE_SNOW_BANK(
        dt,
        menu_x,
        menu_y,
        menu_w,
        menu_h,
        screen_w,
        screen_h
    )

    -- Once disabled, old flakes are allowed to fade out naturally,
    -- then the table is cleared.
    if (
        S.visible ~= true
        or S.menu_snow ~= true
    )
        and A.weather_snow_alpha < 0.015
    then
        A.weather_snow = {}
        A.weather_snow_spawn = 0
    end

    -- ---------------------------------
    -- RAIN
    -- ---------------------------------
    if S.visible == true
        and S.menu_rain == true
    then
        A.weather_rain_spawn =
            (A.weather_rain_spawn or 0)
            + dt * 34

        while A.weather_rain_spawn >= 1
            and #A.weather_rain < 64
        do
            A.weather_rain_spawn =
                A.weather_rain_spawn - 1

            FALLEN_WEATHER_SPAWN_RAIN(screen_w)
        end
    end

    for i = #A.weather_rain, 1, -1 do
        local p =
            A.weather_rain[i]

        local old_x =
            p.x

        local old_y =
            p.y

        local old_tip_y =
            old_y + p.len

        p.y =
            p.y
            + p.speed * dt

        p.x =
            p.x
            + p.drift * dt

        local new_tip_y =
            p.y + p.len

        local menu_right =
            menu_x + menu_w

        local menu_bottom =
            menu_y + menu_h

        local collided = false

        -- TOP EDGE COLLISION:
        -- rain falls behind the UI and splashes when it reaches the menu roof.
        if menu_w > 0
            and menu_h > 0
            and old_tip_y < menu_y
            and new_tip_y >= menu_y
        then
            local denom =
                new_tip_y - old_tip_y

            local t =
                denom ~= 0
                and clamp(
                    (menu_y - old_tip_y)
                    / denom,
                    0,
                    1
                )
                or 1

            local hit_x =
                old_x
                + (p.x - old_x) * t

            if hit_x >= menu_x + 8
                and hit_x <= menu_right - 8
            then
                if A.weather_rain_alpha > 0.08 then
                    FALLEN_WEATHER_SPLASH(
                        hit_x,
                        menu_y - 1,
                        0,
                        -1
                    )
                end

                collided = true
            end
        end

        -- RIGHT EDGE COLLISION:
        -- drops drift to the left, so some can strike the menu's right wall.
        if not collided
            and menu_w > 0
            and menu_h > 0
            and old_x > menu_right
            and p.x <= menu_right
        then
            local denom =
                old_x - p.x

            local t =
                denom ~= 0
                and clamp(
                    (old_x - menu_right)
                    / denom,
                    0,
                    1
                )
                or 1

            local hit_y =
                old_tip_y
                + (new_tip_y - old_tip_y) * t

            if hit_y >= menu_y + 8
                and hit_y <= menu_bottom - 8
            then
                if A.weather_rain_alpha > 0.08 then
                    FALLEN_WEATHER_SPLASH(
                        menu_right + 1,
                        hit_y,
                        1,
                        0
                    )
                end

                collided = true
            end
        end

        if collided then
            table.remove(
                A.weather_rain,
                i
            )
        elseif p.y > screen_h + 30
            or p.x < -35
            or p.x > screen_w + 35
        then
            table.remove(
                A.weather_rain,
                i
            )
        elseif A.weather_rain_alpha > 0.01
            and p.y >= -4
            and p.y <= screen_h + 4
        then
            local tail_dx =
                (p.drift / p.speed)
                * p.len

            line(
                p.x - tail_dx,
                p.y - p.len,
                p.x,
                p.y,
                {
                    0.56,
                    0.72,
                    0.94,
                    p.a
                    * A.weather_rain_alpha
                },
                0.85
            )
        end
    end

    if (
        S.visible ~= true
        or S.menu_rain ~= true
    )
        and A.weather_rain_alpha < 0.015
    then
        A.weather_rain = {}
        A.weather_rain_spawn = 0
    end

    -- ---------------------------------
    -- LIGHTNING
    -- ---------------------------------
    if S.visible == true
        and S.menu_lightning == true
        and (A.weather_lightning_alpha or 0) > 0.02
    then
        if A.weather_lightning_timer == nil then
            A.weather_lightning_timer =
                FALLEN_WEATHER_RAND(
                    2.0,
                    4.4
                )
        end

        A.weather_lightning_timer =
            A.weather_lightning_timer
            - dt

        if A.weather_lightning_timer <= 0 then
            A.weather_lightning_timer =
                FALLEN_WEATHER_RAND(
                    2.0,
                    4.6
                )

            A.weather_lightning_flash =
                FALLEN_WEATHER_RAND(
                    0.80,
                    1.00
                )

            local life =
                FALLEN_WEATHER_RAND(
                    0.50,
                    3.00
                )

            A.weather_lightning_life =
                life

            A.weather_lightning_max_life =
                life

            -- Prefer free space to the left/right of the menu.
            local margin = 14

            local left_space =
                menu_x - margin

            local right_start =
                menu_x + menu_w + margin

            local left_ok =
                left_space > 70

            local right_ok =
                right_start < screen_w - 70

            local target_x

            local function pick_target_x()
                if left_ok
                    and right_ok
                then
                    if math.random() < 0.5 then
                        return
                            FALLEN_WEATHER_RAND(
                                margin,
                                left_space
                            )
                    end

                    return
                        FALLEN_WEATHER_RAND(
                            right_start,
                            screen_w - margin
                        )
                elseif left_ok then
                    return
                        FALLEN_WEATHER_RAND(
                            margin,
                            left_space
                        )
                elseif right_ok then
                    return
                        FALLEN_WEATHER_RAND(
                            right_start,
                            screen_w - margin
                        )
                end

                return
                    FALLEN_WEATHER_RAND(
                        margin,
                        screen_w - margin
                    )
            end

            target_x = pick_target_x()

            local last_x =
                tonumber(A.weather_lightning_last_x)

            if last_x ~= nil then
                local min_gap =
                    math.max(
                        90,
                        screen_w * 0.16
                    )

                for attempt = 1, 8 do
                    if math.abs(target_x - last_x) >= min_gap then
                        break
                    end

                    target_x =
                        pick_target_x()
                end

                -- If space is tight, still nudge away from the previous strike.
                if math.abs(target_x - last_x) < min_gap then
                    if target_x <= last_x then
                        target_x =
                            clamp(
                                last_x - min_gap,
                                margin,
                                screen_w - margin
                            )
                    else
                        target_x =
                            clamp(
                                last_x + min_gap,
                                margin,
                                screen_w - margin
                            )
                    end
                end
            end

            A.weather_lightning_last_x =
                target_x

            local x =
                clamp(
                    target_x
                    + FALLEN_WEATHER_RAND(
                        -45,
                        45
                    ),
                    8,
                    screen_w - 8
                )

            local y = -12

            local pts = {
                x,
                y
            }

            -- More segments because the bolt now crosses the WHOLE screen.
            local segments =
                math.random(
                    12,
                    18
                )

            for s = 1, segments do
                local t =
                    s / segments

                local target_y =
                    screen_h * t

                y =
                    target_y
                    + FALLEN_WEATHER_RAND(
                        -10,
                        10
                    )

                x =
                    x
                    + FALLEN_WEATHER_RAND(
                        -22,
                        22
                    )

                -- Slowly pull the random walk back toward the strike column.
                x =
                    x
                    + (target_x - x)
                    * 0.18

                if s == segments then
                    x = target_x
                    y = screen_h + 10
                end

                pts[#pts + 1] = x
                pts[#pts + 1] = y
            end

            A.weather_lightning_points =
                pts
        end
    elseif (A.weather_lightning_alpha or 0) < 0.02 then
        A.weather_lightning_timer = nil
        A.weather_lightning_points = nil
        A.weather_lightning_life = 0
        A.weather_lightning_max_life = 0
        A.weather_lightning_last_x = nil
        A.weather_lightning_flash = 0
    end

    if (A.weather_lightning_flash or 0) > 0.01 then
        local flash_a =
            (A.weather_lightning_flash or 0)
            * (A.weather_lightning_alpha or 0)

        local c = {
            0.72,
            0.82,
            1.00,
            0.12 * flash_a
        }

        -- Flash the whole SCREEN around the menu, but keep the menu itself clean.
        if menu_y > 0 then
            fill(0, 0, screen_w, menu_y, c)
        end

        local bottom_y = menu_y + menu_h
        if bottom_y < screen_h then
            fill(0, bottom_y, screen_w, screen_h - bottom_y, c)
        end

        if menu_x > 0 and menu_h > 0 then
            fill(0, menu_y, menu_x, menu_h, c)
        end

        local right_x = menu_x + menu_w
        if right_x < screen_w and menu_h > 0 then
            fill(right_x, menu_y, screen_w - right_x, menu_h, c)
        end
    end

    if (A.weather_lightning_life or 0) > 0
        and type(A.weather_lightning_points) == "table"
    then
        local pts = A.weather_lightning_points
        local life_max =
            math.max(
                0.001,
                tonumber(A.weather_lightning_max_life) or 1
            )

        local life_t =
            clamp(
                (A.weather_lightning_life or 0)
                / life_max,
                0,
                1
            )

        -- Long strikes remain visible, but smoothly fade instead of staying
        -- at full brightness for the whole 0.5–3 second lifetime.
        local a =
            smooth01(life_t)
            * (A.weather_lightning_alpha or 0)

        for i = 1, #pts - 3, 2 do
            local x1 = pts[i]
            local y1 = pts[i + 1]
            local x2 = pts[i + 2]
            local y2 = pts[i + 3]

            line(
                x1,
                y1,
                x2,
                y2,
                { 0.55, 0.76, 1.00, 0.30 * a },
                4
            )

            line(
                x1,
                y1,
                x2,
                y2,
                { 0.88, 0.95, 1.00, 0.85 * a },
                1.6
            )
        end
    end

    -- ---------------------------------
    -- IMPACT SPLASHES
    -- ---------------------------------
    for i = #A.weather_splashes, 1, -1 do
        local p =
            A.weather_splashes[i]

        p.life =
            p.life - dt

        if p.life <= 0 then
            table.remove(
                A.weather_splashes,
                i
            )
        else
            p.x =
                p.x
                + p.vx * dt

            p.y =
                p.y
                + p.vy * dt

            p.vy =
                p.vy
                + 210 * dt

            local life_a =
                clamp(
                    p.life
                    / math.max(
                        0.001,
                        p.max_life
                    ),
                    0,
                    1
                )

            if p.x >= 1
                and p.x <= screen_w - 1
                and p.y >= 1
                and p.y <= screen_h - 1
            then
                line(
                    p.x,
                    p.y,
                    p.x - p.vx * 0.020,
                    p.y - p.vy * 0.020,
                    {
                        0.66,
                        0.80,
                        1.00,
                        p.a
                        * life_a
                        * A.weather_rain_alpha
                    },
                    0.75
                )
            end
        end
    end

    MENU_UI_TRANSFORM_ACTIVE =
        old_transform
end

function FALLEN_BT_STYLE_DROPDOWN_STEP()
    local now = tick()

    if A.bullet_tracer_style_last_t == nil then
        A.bullet_tracer_style_last_t = now
    end

    local dt =
        clamp(
            now - A.bullet_tracer_style_last_t,
            0,
            0.05
        )

    A.bullet_tracer_style_last_t = now

    local target =
        A.bullet_tracer_style_open
        and 1
        or 0

    local speed =
        target > (A.bullet_tracer_style_anim or 0)
        and 16
        or 12

    A.bullet_tracer_style_anim =
        exp_chase(
            A.bullet_tracer_style_anim or 0,
            target,
            speed,
            dt
        )

    if math.abs(
        (A.bullet_tracer_style_anim or 0)
        - target
    ) < 0.0015
    then
        A.bullet_tracer_style_anim = target
    end

    return
        clamp(
            A.bullet_tracer_style_anim or 0,
            0,
            1
        )
end

function FALLEN_DRAW_BT_STYLE_DROPDOWN(
    mx,
    my,
    clicked,
    x,
    y,
    w
)
    local anim =
        FALLEN_BT_STYLE_DROPDOWN_STEP()

    if anim <= 0.004
        and not A.bullet_tracer_style_open
    then
        return false
    end

    local options = {
        "Neon",
        "Lightning",
        "Rainbow",
    }

    local item_h = 27
    local full_h =
        #options * item_h

    local visible_h =
        full_h
        * ease_out_cubic(anim)

    local panel_h =
        math.max(
            2,
            visible_h
        )

    FALLEN_POPUP_GLOW(
        x,
        y,
        w,
        panel_h,
        7,
        0.9
    )

    rounded_fill(
        x,
        y,
        w,
        panel_h,
        7,
        { 0.070, 0.074, 0.087, 1 }
    )

    local panel_hot =
        hover(
            mx,
            my,
            x,
            y,
            w,
            panel_h
        )

    for i, option in ipairs(options) do
        local iy =
            y + (i - 1) * item_h

        local reveal =
            clamp(
                (
                    visible_h
                    - (i - 1) * item_h
                )
                / item_h,
                0,
                1
            )

        if reveal > 0.12 then
            local item_hot =
                reveal > 0.92
                and hover(
                    mx,
                    my,
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4
                )

            if item_hot then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4,
                    5,
                    { 0.105, 0.111, 0.132, 1 }
                )
            end

            local selected =
                tostring(
                    S.bullet_tracer_style
                    or "Neon"
                ) == option

            if selected then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    3,
                    item_h - 4,
                    1,
                    C.accent
                )
            end

            text(
                x + 12,
                iy + 8,
                option,
                FALLEN_HOVER_TEXT(
                    "tracer_style:"
                    .. tostring(option),
                    item_hot,
                    selected
                        and C.text
                        or C.text_dim
                )
            )

            if clicked
                and item_hot
                and A.bullet_tracer_style_open
            then
                S.bullet_tracer_style = option
                A.bullet_tracer_style_open = false
                return true
            end
        end
    end

    return panel_hot
end

function FALLEN_HITFX_STYLE_DROPDOWN_STEP()
    local now = tick()

    if A.hit_effect_style_last_t == nil then
        A.hit_effect_style_last_t = now
    end

    local dt =
        clamp(
            now - A.hit_effect_style_last_t,
            0,
            0.05
        )

    A.hit_effect_style_last_t = now

    local target =
        A.hit_effect_style_open
        and 1
        or 0

    local speed =
        target > (A.hit_effect_style_anim or 0)
        and 16
        or 12

    A.hit_effect_style_anim =
        exp_chase(
            A.hit_effect_style_anim or 0,
            target,
            speed,
            dt
        )

    if math.abs(
        (A.hit_effect_style_anim or 0)
        - target
    ) < 0.0015
    then
        A.hit_effect_style_anim = target
    end

    return
        clamp(
            A.hit_effect_style_anim or 0,
            0,
            1
        )
end

function FALLEN_DRAW_HITFX_STYLE_DROPDOWN(
    mx,
    my,
    clicked,
    x,
    y,
    w
)
    local anim =
        FALLEN_HITFX_STYLE_DROPDOWN_STEP()

    if anim <= 0.004
        and not A.hit_effect_style_open
    then
        return false
    end

    local options = {
        "Hit 1",
        "Hit 2",
        "Hit 3",
    }

    local item_h = 27
    local full_h =
        #options * item_h

    local visible_h =
        full_h
        * ease_out_cubic(anim)

    local panel_h =
        math.max(
            2,
            visible_h
        )

    FALLEN_POPUP_GLOW(
        x,
        y,
        w,
        panel_h,
        7,
        0.9
    )

    rounded_fill(
        x,
        y,
        w,
        panel_h,
        7,
        { 0.070, 0.074, 0.087, 1 }
    )

    local panel_hot =
        hover(
            mx,
            my,
            x,
            y,
            w,
            panel_h
        )

    for i, option in ipairs(options) do
        local iy =
            y + (i - 1) * item_h

        local reveal =
            clamp(
                (
                    visible_h
                    - (i - 1) * item_h
                )
                / item_h,
                0,
                1
            )

        if reveal > 0.12 then
            local item_hot =
                reveal > 0.92
                and hover(
                    mx,
                    my,
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4
                )

            if item_hot then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4,
                    5,
                    { 0.105, 0.111, 0.132, 1 }
                )
            end

            local selected =
                tostring(
                    S.hit_effect_style
                    or "Fallen Combo"
                ) == option

            if selected then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    3,
                    item_h - 4,
                    1,
                    C.accent
                )
            end

            text(
                x + 12,
                iy + 8,
                option,
                FALLEN_HOVER_TEXT(
                    "hitfx_style:"
                    .. tostring(option),
                    item_hot,
                    selected
                        and C.text
                        or C.text_dim
                )
            )

            if clicked
                and item_hot
                and A.hit_effect_style_open
            then
                S.hit_effect_style = option
                A.hit_effect_style_open = false
                return true
            end
        end
    end

    return panel_hot
end

