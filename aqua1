                C.divider,
                1
            )
        end

        if shell_h > 118 then
            slider_row(
                mx,
                my,
                ui_clicked,
                lmb,
                px + 8,
                py + 75,
                pw - 16,
                "Strength",
                "armor_glow_strength",
                0,
                200,
                "int"
            )
