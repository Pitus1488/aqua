function FALLEN_ARMOR_DRAW_ON_PLAYERS()
    if not players
        or type(players.get_all) ~= "function"
        or not aim
        or type(aim.world_to_screen) ~= "function"
    then
        return
    end

    local ok, list =
        pcall(
            players.get_all
        )

    if not ok
        or type(list) ~= "table"
    then
        return
    end

    local icon =
        math.floor(
            clamp(
                tonumber(S.armor_esp_size) or 18,
                10,
                32
            )
        )

    local gap = 2
    local y_offset =
        icon + 10

    for _, p in ipairs(list) do
        if FALLEN_ARMOR_VALID_PLAYER(p) then
            local pos =
                FALLEN_ARMOR_HEAD_POS(p)

            if pos then
                local scr = nil

                pcall(function()
                    scr =
                        aim.world_to_screen(pos)
                end)

                if scr
                    and scr.visible
                then
                    local sx, sy =
                        FALLEN_ARMOR_SMOOTH_SCREEN(
                            p,
                            scr.X,
                            scr.Y
                        )

                    local items =
                        FALLEN_ARMOR_ITEMS(p)

                    if type(items) == "table"
                        and #items > 0
                    then
                        local total_w =
                            #items * icon
                            + math.max(0, #items - 1) * gap

                        local start_x =
                            sx - total_w * 0.5

                        local y =
                            sy - y_offset

                        if S.armor_onplayer_background == true
                            or S.armor_onplayer_glass == true
                        then
                            local pad = 5

                            FALLEN_ARMOR_DRAW_ONPLAYER_BACKPLATE(
                                start_x - pad,
                                y - pad,
                                total_w + pad * 2,
                                icon + pad * 2,
                                S.armor_onplayer_glass == true
                            )
                        end

                        for i, item in ipairs(items) do
                            FALLEN_ARMOR_DRAW_ICON(
                                item,
                                start_x + (i - 1) * (icon + gap),
                                y,
                                icon,
                                1,
                                false
                            )
                        end
                    end
                end
            end
        end
    end
end

