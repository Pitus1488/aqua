function FALLEN_BT_LOCAL_NAME()
    local now = tick()

    if FALLEN_BT.local_name
        and now - (FALLEN_BT.local_name_scan or 0) < 2
    then
        return FALLEN_BT.local_name
    end

    FALLEN_BT.local_name_scan = now

    local name = nil

    if players
        and type(players.get_local) == "function"
    then
        local ok, me = pcall(players.get_local)

        if ok and me then
            name =
                me.name
                or me.display_name
                or me.username
        end
    end

    if not name
        and rbx
        and type(rbx.local_player) == "function"
    then
        local ok, lp = pcall(rbx.local_player)

        if ok and lp then
            pcall(function()
                if lp.get_name then
                    name = lp:get_name()
                else
                    name = lp.Name or lp.name
                end
            end)
        end
    end

    if name then
        FALLEN_BT.local_name = tostring(name)
    end

    return FALLEN_BT.local_name
end

