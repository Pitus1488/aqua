-- Fallen toast notifications (config/status)
-- =========================================================
local FALLEN_TOASTS = {}

local function fallen_toast(message, level)
    FALLEN_TOASTS[#FALLEN_TOASTS + 1] = {
        text = tostring(message),
        level = level or "normal",
        born = tick(),
        alpha = 0,
        yoff = 25,
    }
end

local function draw_fallen_toasts()
    if #FALLEN_TOASTS == 0 then return end

    local now = tick()
    local sw, sh = screen_size()

    for i = #FALLEN_TOASTS, 1, -1 do
        local t = FALLEN_TOASTS[i]
        local age = now - t.born

        if age > 3.2 then
            table.remove(FALLEN_TOASTS, i)
        else
            local appear = math.min(age / 0.25, 1)
            local fade = age > 2.6 and (1 - (age - 2.6) / 0.6) or 1
            local a = clamp(appear * fade, 0, 1)

            t.alpha = a

            local w = 220
            local h = 42
            local x = sw - w - 25
            local y = 35 + (i - 1) * 52 + (1 - appear) * 20

            local toast_glass = tostring(S.menu_type or "default"):lower() == "glass"
            local toast_bg = toast_glass
                and {0.055, 0.058, 0.067, 0.22 * a}
                or {0.055, 0.058, 0.067, 0.96 * a}
            local toast_border = toast_glass
                and {0.340, 0.450, 0.760, 0.12 * a}
                or {0.340, 0.450, 0.760, 0.35 * a}

            rounded_fill(
                x,
                y,
                w,
                h,
                10,
                toast_bg
            )

            rounded_outline(
                x,
                y,
                w,
                h,
                10,
                toast_border,
                1,
                toast_bg
            )

            local title = t.text
            text(
                x + 18,
                y + 14,
                title,
                {0.90, 0.92, 1.00, a}
            )
        end
    end
end

