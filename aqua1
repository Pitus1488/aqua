local function icon_world(x, y, c)
    -- IMPORTANT: sidebar icons must be pure line geometry.
    -- rounded_outline() intentionally turns into a filled surface while the
    -- menu is translucent, which made this icon become a gray square in
    -- Gradient mode (50% shell opacity).
    local x1 = x + 1
    local y1 = y + 2
    local x2 = x + 15
    local y2 = y + 13
