        FALLEN_BT_IMAGE_GET(
            key,
            url
        )
end

function FALLEN_HITFX_RAND(seed)
    local x =
        math.sin(
            (seed or 1) * 12.9898
            + 78.233
        ) * 43758.5453

    return x - math.floor(x)
end

function FALLEN_HITFX_DRAW_FALLEN(
    kind,
    sx,
    sy,
    size,
    t,
    alpha,
    col,
    seed
)
    local out =
        1
        - (1 - t) * (1 - t)

    local fade =
        math.max(
            0,
            1 - t * t
        )

    local flash =
        FALLEN_HITFX_IMAGE(
            "flash",
            FALLEN_BT_IMAGE.flash_url
        )

    local ring =
        FALLEN_HITFX_IMAGE(
            "ring",
            FALLEN_BT_IMAGE.ring_url
        )

    local spark =
        FALLEN_HITFX_IMAGE(
            "spark",
            FALLEN_BT_IMAGE.spark_url
        )

    local smoke =
        FALLEN_HITFX_IMAGE(
            "smoke",
            FALLEN_BT_IMAGE.smoke_url
        )

    local star =
        FALLEN_HITFX_IMAGE(
            "star",
            FALLEN_BT_IMAGE.star_url
        )

    if kind == 1 then
        -- Fallen Spark, compact version. Base is fixed at 32.
        local s =
            size
            * (
                0.72
                + 0.48 * out
            )

        local a =
            alpha
            * math.max(
                0,
                1 - t * 2.6
            )

        FALLEN_HITFX_DRAW_IMAGE(
            flash,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            1,
            1,
            1,
            a
        )

        local s2 =
            size
            * (
                0.62
                + 0.40 * out
            )

        FALLEN_HITFX_DRAW_IMAGE(
            spark,
            sx - s2 * 0.5,
            sy - s2 * 0.5,
            s2,
            s2,
            1,
            1,
            1,
            alpha * 0.78 * fade
        )

    elseif kind == 2 then
        -- Fallen SmokeRing.
        local s =
            size
            * (
                0.95
                + 3.55 * out
            )

        FALLEN_HITFX_DRAW_IMAGE(
            ring,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            col[1],
            col[2],
            col[3],
            alpha * 0.88 * fade
        )

        local s2 =
            size
            * (
                1.15
                + 4.10 * out
            )

        FALLEN_HITFX_DRAW_IMAGE(
            smoke or ring,
            sx - s2 * 0.5,
            sy - s2 * 0.5,
            s2,
            s2,
            0.86,
            0.92,
            1.0,
            alpha * 0.28 * fade
        )

    elseif kind == 3 then
        -- Fallen particles.js.
        for k = 1, 6 do
            local sd =
                (seed or 1)
                + k * 19.73

            local ang =
                (k / 6)
                * math.pi
                * 2
                + math.sin(sd) * 0.45

            local spread =
                size
                * (
                    0.40
                    + 2.25 * out
                )
                * (
                    0.70
                    + FALLEN_HITFX_RAND(sd + 2) * 0.75
                )

            local px =
                sx + math.cos(ang) * spread

            local py =
                sy + math.sin(ang) * spread

            local ps =
                size
                * (
                    0.65
                    + FALLEN_HITFX_RAND(sd + 4) * 0.65
                )

            local rr = col[1]
            local gg = col[2]
            local bb = col[3]

            if k % 2 == 1 then
                rr, gg, bb =
                    1.0, 0.22, 0.86
            end

            FALLEN_HITFX_DRAW_IMAGE(
                spark,
                px - ps * 0.5,
                py - ps * 0.5,
                ps,
                ps,
                rr,
                gg,
                bb,
                alpha * 0.92 * fade
            )
        end

        local s =
            size
            * (
                0.45
                + 1.30 * out
            )

        FALLEN_HITFX_DRAW_IMAGE(
            star or spark,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            1,
            1,
            1,
            alpha * 0.62 * fade
        )

    else
        -- Fallen Combo = Spark + SmokeRing + particles.
        local s =
            size
            * (
                0.75
                + 2.35 * out
            )

        FALLEN_HITFX_DRAW_IMAGE(
            flash,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            1,
            1,
            1,
            alpha
                * math.max(
                    0,
                    1 - t * 4.5
                )
        )

        s =
            size
            * (
                0.62
                + 3.25 * out
            )

        FALLEN_HITFX_DRAW_IMAGE(
            ring,
            sx - s * 0.5,
            sy - s * 0.5,
            s,
            s,
            col[1],
            col[2],
            col[3],
            alpha * 0.82 * fade
        )

        local smoke_s =
            size
            * (
                1.05
                + 3.95 * out
            )

        FALLEN_HITFX_DRAW_IMAGE(
            smoke or ring,
            sx - smoke_s * 0.5,
            sy - smoke_s * 0.5,
            smoke_s,
            smoke_s,
            0.74,
            0.90,
            1.0,
            alpha * 0.16 * fade
        )

        for k = 1, 10 do
            local sd =
                (seed or 1)
                + k * 13.37

            local ang =
                (k / 10)
                * math.pi
                * 2
                + math.sin(sd) * 0.30

            local spread =
                size
                * (
                    0.35
                    + 2.20 * out
                )
                * (
                    0.55
                    + FALLEN_HITFX_RAND(sd + 2) * 0.95
                )

            local px =
                sx + math.cos(ang) * spread

            local py =
                sy + math.sin(ang) * spread

            local ps =
                size
                * (
                    0.28
                    + FALLEN_HITFX_RAND(sd + 4) * 0.62
                )

            local rr = col[1]
            local gg = col[2]
            local bb = col[3]

            if k % 2 == 1 then
                rr, gg, bb =
                    1.0, 0.22, 0.86
            end

            FALLEN_HITFX_DRAW_IMAGE(
                spark,
                px - ps * 0.5,
                py - ps * 0.5,
                ps,
                ps,
                rr,
                gg,
                bb,
                alpha
                    * (
                        0.42
                        + 0.38
                        * FALLEN_HITFX_RAND(sd + 6)
                    )
                    * fade
            )
        end
    end
end

function FALLEN_HITFX_TARGET_KEY()
    return
        FAP.current_target_addr
        or FAP.current_target_name
end

function FALLEN_HITFX_ADD(pos)
    if not pos then
        return
    end

    FALLEN_HITFX.items[#FALLEN_HITFX.items + 1] = {
        x = pos.X,
        y = pos.Y,
        z = pos.Z,
        created = tick(),
        seed =
            (#FALLEN_HITFX.items + 1) * 31
            + math.floor(tick() * 1000),
    }

    while #FALLEN_HITFX.items > 25 do
        table.remove(
            FALLEN_HITFX.items,
            1
        )
    end
end

function FALLEN_HITFX_SCAN_HP()
    if S.hit_effect_enabled ~= true
        or S.aim_enabled ~= true
    then
        FALLEN_HITFX.target_key = nil
        FALLEN_HITFX.last_hp = nil
        FALLEN_HITFX.test_lmb_was_down = false
        return
    end

    -- The target must still be actively held by our Aimbot.
    if not FAP.current_target_pos
        or tick() - (FAP.current_target_seen or 0) > 0.18
    then
        FALLEN_HITFX.target_key = nil
        FALLEN_HITFX.last_hp = nil
        FALLEN_HITFX.test_lmb_was_down = false
        return
    end

    local key =
        FALLEN_HITFX_TARGET_KEY()

    if not key then
        return
    end

    -- FINAL LOGIC:
    -- effect only fires while this exact target is still locked
    -- and the same locked target loses at least 15 HP.
    local hp =
        tonumber(
            FAP.current_target_health
        )

    if hp == nil then
        return
    end

    if FALLEN_HITFX.target_key ~= key then
        FALLEN_HITFX.target_key = key
        FALLEN_HITFX.last_hp = hp
        FALLEN_HITFX.last_seen = tick()
        return
    end

    local old =
        tonumber(
            FALLEN_HITFX.last_hp
        )

    local damage =
        old
        and (old - hp)
        or 0

    if damage >= 15
        and tick() - (FALLEN_HITFX.last_spawn or 0) > 0.008
    then
        FALLEN_HITFX.last_spawn = tick()

        FALLEN_HITFX_ADD({
            X = FAP.current_target_pos.X,
            Y = FAP.current_target_pos.Y,
            Z = FAP.current_target_pos.Z,
        })
    end

    FALLEN_HITFX.last_hp = hp
    FALLEN_HITFX.last_seen = tick()
end

function FALLEN_HITFX_DRAW_ONE(hit, age, life)
    local s =
        FALLEN_BT_PROJECT({
            X = hit.x,
            Y = hit.y,
            Z = hit.z,
        })

    if not s then
        return
    end

    local t =
        clamp(
            age / life,
            0,
            1
        )

    local alpha =
        1 - t

    -- HitFX now always uses original image colors.
    local size = 0
    local cam = nil

    pcall(function()
        if aim and aim.get_camera_position then
            cam = aim.get_camera_position()
        end
    end)

    if cam
        and cam.X
        and cam.Y
        and cam.Z
    then
        local dx =
            (hit.x or 0) - cam.X

        local dy =
            (hit.y or 0) - cam.Y

        local dz =
            (hit.z or 0) - cam.Z

        local dist =
            math.sqrt(
                dx * dx
                + dy * dy
                + dz * dz
            )

        -- Distance curve:
        --   0m   -> 70 px
        --   50m  -> 45 px
        --   150m -> 30 px
        --   300m -> 22 px
        --   600m+ -> 18 px minimum
        if dist <= 50 then
            local tt =
                smooth01(
                    clamp(
                        dist / 50,
                        0,
                        1
                    )
                )

            size =
                70
                + (45 - 70)
                * tt

        elseif dist <= 150 then
            local tt =
                smooth01(
                    clamp(
                        (dist - 50) / 100,
                        0,
                        1
                    )
                )

            size =
                45
                + (30 - 45)
                * tt

        elseif dist <= 300 then
            local tt =
                smooth01(
                    clamp(
                        (dist - 150) / 150,
                        0,
                        1
                    )
                )

            size =
                30
                + (22 - 30)
                * tt

        else
            local tt =
                smooth01(
                    clamp(
                        (dist - 300) / 300,
                        0,
                        1
                    )
                )

            size =
                22
                + (18 - 22)
                * tt
        end
    else
        size = 32
    end

    local style =
        FALLEN_HITFX_STYLE_INDEX()

    if style == 1 then
        -- Boom: use the supplied PNG in its original colors.
        local boom =
            FALLEN_HITFX_IMAGE(
                "boom",
                FALLEN_BT_IMAGE.boom_url
            )

        if boom then
            local out =
                1
                - (1 - t)
                * (1 - t)

            local fade =
                math.max(
                    0,
                    1 - t * t
                )

            local draw_size =
                size
                * (
                    0.88
                    + 0.42 * out
                )

            FALLEN_HITFX_DRAW_IMAGE(
                boom,
                s.X - draw_size * 0.5,
                s.Y - draw_size * 0.5,
                draw_size,
                draw_size,
                1,
                1,
                1,
                alpha * fade
            )
        end

    elseif style == 2 then
        -- Hit 3:
        -- sparks only, no smoke.
        local sparks_img =
            FALLEN_HITFX_IMAGE(
                "user_sparks",
                FALLEN_BT_IMAGE.user_sparks_url
            )

        local fade =
            math.max(
                0,
                1 - t
            )

        local grow =
            smooth01(t)

        if sparks_img then
            for k = 1, 8 do
                local seed =
                    (hit.seed or 1)
                    + k * 17.19

                local ang =
                    (k / 8)
                    * math.pi
                    * 2
                    + math.sin(seed) * 0.33

                local spread =
                    size
                    * (
                        0.16
                        + 1.20 * grow
                    )
                    * (
                        0.90
                        + math.abs(
                            math.sin(seed * 1.31)
                        ) * 0.55
                    )

                local px =
                    s.X + math.cos(ang) * spread

                local py =
                    s.Y + math.sin(ang) * spread

                local spark_size =
                    size
                    * (
                        0.34
                        + math.abs(
                            math.sin(seed * 0.77)
                        ) * 0.24
                    )
                    * (
                        1.10
                        - 0.22 * t
                    )

                FALLEN_HITFX_DRAW_IMAGE(
                    sparks_img,
                    px - spark_size * 0.5,
                    py - spark_size * 0.5,
                    spark_size,
                    spark_size,
                    1,
                    1,
                    1,
                    alpha
                        * (
                            0.82
                            - 0.32 * t
                        )
                        * fade
                )
            end
        end

    else
        -- Fallen Spark.
        FALLEN_HITFX_DRAW_FALLEN(
            1,
            s.X,
            s.Y,
            size,
            t,
            alpha,
            { 1, 1, 1, 1 },
            hit.seed
        )
    end
end

function FALLEN_HITFX_DRAW()
    if type(FALLEN_HITFX.items) ~= "table" then
        FALLEN_HITFX.items = {}
    end

    local now = tick()

    local style =
        FALLEN_HITFX_STYLE_INDEX()

    local life =
        style == 2
        and 1.50
        or 0.74

    for i = #FALLEN_HITFX.items, 1, -1 do
        local hit =
            FALLEN_HITFX.items[i]

        local age =
            now - (hit.created or now)

        if age > life
            or S.hit_effect_enabled ~= true
        then
            table.remove(
                FALLEN_HITFX.items,
                i
            )
        else
            FALLEN_HITFX_DRAW_ONE(
                hit,
                age,
                life
            )
        end
    end
end

function FALLEN_HITFX_TICK()
    if _G.FallenMenuReady ~= true then
        return
    end

    FALLEN_HITFX_SCAN_HP()
    FALLEN_HITFX_DRAW()
end

