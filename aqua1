    line(x1, y1 + r, x1, y2 - r, c, 1.1)
    line(x2, y1 + r, x2, y2 - r, c, 1.1)

    -- Small diagonal corner segments approximate the rounding cleanly.
    line(x1, y1 + r, x1 + r, y1, c, 1.1)
    line(x2 - r, y1, x2, y1 + r, c, 1.1)
    line(x2, y2 - r, x2 - r, y2, c, 1.1)
    line(x1 + r, y2, x1, y2 - r, c, 1.1)

    circle_fill(x + 5, y + 5, 1.2, c)
    line(x + 3, y + 10.5, x + 6.5, y + 7.5, c, 1.1)
    line(x + 6.5, y + 7.5, x + 9.5, y + 10, c, 1.1)
    line(x + 9.5, y + 10, x + 13, y + 6.8, c, 1.1)
end

