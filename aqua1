function FALLEN_POPUP_GLOW(x, y, w, h, radius, strength)
    local amount = tonumber(strength) or 1

    for i = 1, 14 do
        local t = (i - 1) / 13
        local falloff = 1 - t
        local a = 0.12 * amount * falloff * falloff

        FALLEN_DRAW_ROUNDED_GLOW_FRAME(
            x - i, y - i,
            w + i * 2, h + i * 2,
            radius + i,
            { 0, 0, 0, a },
            1
        )
    end
end

FALLEN_MENU_GRADIENT_TEXTURE =
    FALLEN_MENU_GRADIENT_TEXTURE
    or {
        handle = nil,
        key = nil,
        pending_key = nil,
        last_build = 0,
        path = "C:\\blueberry\\scripts\\fallen_menu_gradient.bmp",
    }

function FALLEN_MENU_GRADIENT_COLOR(prefix)
    local r, g, b =
        hsv_to_rgb(
            tonumber(S[prefix .. "_h"]) or 0,
            tonumber(S[prefix .. "_s"]) or 0,
            tonumber(S[prefix .. "_v"]) or 1
        )

    return {
        clamp(r, 0, 1),
        clamp(g, 0, 1),
        clamp(b, 0, 1),
        1,
    }
end

function FALLEN_GRADIENT_BYTE(v)
    return
        math.floor(
            clamp(v or 0, 0, 1)
            * 255
            + 0.5
        )
end

function FALLEN_GRADIENT_U16_LE(v)
    v = math.floor(v or 0)

    return string.char(
        v % 256,
        math.floor(v / 256) % 256
    )
end

function FALLEN_GRADIENT_U32_LE(v)
    v = math.floor(v or 0)

    return string.char(
        v % 256,
        math.floor(v / 256) % 256,
        math.floor(v / 65536) % 256,
        math.floor(v / 16777216) % 256
    )
end

function FALLEN_GRADIENT_BUILD_BMP(a, b)
    -- Small texture is enough because DrawImage scales it smoothly.
    -- 96x96 also keeps regeneration cheap while dragging a color picker.
    local w = 96
    local h = 96
    local row_bytes = w * 3
    local row_pad = (4 - (row_bytes % 4)) % 4
    local image_size = (row_bytes + row_pad) * h
    local file_size = 54 + image_size

    local chunks = {}

    chunks[#chunks + 1] = "BM"
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(file_size)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U16_LE(0)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U16_LE(0)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(54)

    -- BITMAPINFOHEADER
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(40)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(w)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(h)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U16_LE(1)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U16_LE(24)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(0)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(image_size)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(0)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(0)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(0)
    chunks[#chunks + 1] = FALLEN_GRADIENT_U32_LE(0)

    local pad =
        row_pad > 0
        and string.rep("\0", row_pad)
        or ""

    -- BMP rows are stored bottom-up.
    for py = h - 1, 0, -1 do
        local v =
            py / (h - 1)

        local row = {}

        for px = 0, w - 1 do
            local u =
                px / (w - 1)

            -- Diagonal axis:
            -- top-right  => t = 1 => Color 1 (A)
            -- bottom-left => t = 0 => Color 2 (B)
            local t =
                clamp(
                    (u - v + 1) * 0.5,
                    0,
                    1
                )

            local r =
                lerp(
                    b[1],
                    a[1],
                    t
                )

            local g =
                lerp(
                    b[2],
                    a[2],
                    t
                )

            local bb =
                lerp(
                    b[3],
                    a[3],
                    t
                )

            -- BMP pixel order = B, G, R.
            row[#row + 1] =
                string.char(
                    FALLEN_GRADIENT_BYTE(bb),
                    FALLEN_GRADIENT_BYTE(g),
                    FALLEN_GRADIENT_BYTE(r)
                )
        end

        chunks[#chunks + 1] =
            table.concat(row)
            .. pad
    end

    return table.concat(chunks)
end

function FALLEN_GRADIENT_COLOR_KEY(a, b)
    return string.format(
        "%02X%02X%02X-%02X%02X%02X",
        FALLEN_GRADIENT_BYTE(a[1]),
        FALLEN_GRADIENT_BYTE(a[2]),
        FALLEN_GRADIENT_BYTE(a[3]),
        FALLEN_GRADIENT_BYTE(b[1]),
        FALLEN_GRADIENT_BYTE(b[2]),
        FALLEN_GRADIENT_BYTE(b[3])
    )
end

function FALLEN_GRADIENT_ENSURE_TEXTURE(a, b)
    if type(write_file) ~= "function" then
        return FALLEN_MENU_GRADIENT_TEXTURE.handle
    end

    local state =
        FALLEN_MENU_GRADIENT_TEXTURE

    local key =
        FALLEN_GRADIENT_COLOR_KEY(
            a,
            b
        )

    if state.key == key
        and state.handle
    then
        return state.handle
    end

    -- Avoid rebuilding a texture every single frame while the user is
    -- actively dragging a color picker. About 12 updates/sec stays smooth.
    local now = tick()

    if state.handle
        and now - (state.last_build or 0) < 0.08
    then
        state.pending_key = key
        return state.handle
    end

    local bmp =
        FALLEN_GRADIENT_BUILD_BMP(
            a,
            b
        )

    local ok_write =
        pcall(
            write_file,
            state.path,
            bmp
        )

    if not ok_write then
        return state.handle
    end

    if state.handle
        and Drawing
        and type(Drawing.UnloadImage) == "function"
    then
        pcall(
            Drawing.UnloadImage,
            state.handle
        )
    end

    state.handle = nil

    pcall(function()
        if Drawing
            and type(Drawing.LoadImageFromFile) == "function"
        then
            state.handle =
                Drawing.LoadImageFromFile(
                    state.path
                )
        elseif type(LoadImage) == "function" then
            state.handle =
                LoadImage(
                    state.path
                )
        end
    end)

    state.key = key
    state.pending_key = nil
    state.last_build = now

    return state.handle
end

function FALLEN_GRADIENT_MIGRATE_OLD_DEFAULTS()
    if _G.FALLEN_GRADIENT_DEFAULTS_MIGRATED then
        return
    end

    _G.FALLEN_GRADIENT_DEFAULTS_MIGRATED = true

    -- Existing configs may still contain the old purple/blue defaults.
    -- Migrate only that exact old default pair; custom user colors stay intact.
    local old_a =
        math.abs((tonumber(S.menu_gradient_a_h) or 0) - 0.62) < 0.0001
        and math.abs((tonumber(S.menu_gradient_a_s) or 0) - 0.68) < 0.0001
        and math.abs((tonumber(S.menu_gradient_a_v) or 0) - 0.92) < 0.0001

    local old_b =
        math.abs((tonumber(S.menu_gradient_b_h) or 0) - 0.82) < 0.0001
        and math.abs((tonumber(S.menu_gradient_b_s) or 0) - 0.62) < 0.0001
        and math.abs((tonumber(S.menu_gradient_b_v) or 0) - 0.80) < 0.0001

    if old_a and old_b then
        S.menu_gradient_a_h = 0.00
        S.menu_gradient_a_s = 0.00
        S.menu_gradient_a_v = 0.00

        S.menu_gradient_b_h = 0.625
        S.menu_gradient_b_s = 0.85
        S.menu_gradient_b_v = 0.85
    end
end

function FALLEN_DRAW_MENU_DIAGONAL_GRADIENT(
    x,
    y,
    w,
    h,
    alpha_mul
)
    if w <= 1
        or h <= 1
    then
        return
    end

    FALLEN_GRADIENT_MIGRATE_OLD_DEFAULTS()

    local a =
        FALLEN_MENU_GRADIENT_COLOR(
            "menu_gradient_a"
        )

    local b =
        FALLEN_MENU_GRADIENT_COLOR(
            "menu_gradient_b"
        )

    local shell_alpha =
        0.50
        * clamp(
            alpha_mul or 1,
            0,
            1
        )

    local handle =
        FALLEN_GRADIENT_ENSURE_TEXTURE(
            a,
            b
        )

    if handle
        and type(DrawImage) == "function"
    then
        -- Single rounded image: no diagonal-line endpoints can poke through
        -- the menu sides, and sidebar vector icons remain perfectly clean.
        pcall(
            DrawImage,
            handle,
            x,
            y,
            w,
            h,
            1,
            1,
            1,
            shell_alpha,
            OUTER_R
        )

        return
    end

    -- Safe fallback while the local texture is loading.
    local mid = {
        lerp(b[1], a[1], 0.5),
        lerp(b[2], a[2], 0.5),
        lerp(b[3], a[3], 0.5),
        shell_alpha,
    }

    rounded_fill(
        x,
        y,
        w,
        h,
        OUTER_R,
        mid
    )
end

