-- =========================================================
-- Base / House 3D tuning helpers
-- Deliberately global: the host Lua has a 200-local main-chunk limit.
-- =========================================================

function world_base_color_prefix(id)
    return "world_base_color_" .. tostring(id)
end

function world_base_rgb_to_hsv(r, g, b)
    r = clamp(tonumber(r) or 1, 0, 1)
    g = clamp(tonumber(g) or 1, 0, 1)
    b = clamp(tonumber(b) or 1, 0, 1)

    local mx = math.max(r, g, b)
    local mn = math.min(r, g, b)
    local d = mx - mn

    local h = 0
    if d > 0.000001 then
        if mx == r then
            h = ((g - b) / d) % 6
        elseif mx == g then
            h = ((b - r) / d) + 2
        else
            h = ((r - g) / d) + 4
        end
        h = h / 6
    end

    local s = mx <= 0 and 0 or (d / mx)
    return h, s, mx
end

function world_base_state_key(cfg, suffix)
    if not cfg or not cfg.id then
        return nil
    end
    return "world_base_" .. tostring(cfg.id) .. (suffix or "")
end

function world_base_ensure_state(cfg)
    if not cfg or not cfg.id then
        return
    end

    local p = "world_base_" .. tostring(cfg.id)

    if S[p] == nil then S[p] = false end
    if S[p .. "_sx"] == nil then S[p .. "_sx"] = cfg.sx or 4 end
    if S[p .. "_sy"] == nil then S[p .. "_sy"] = cfg.sy or 4 end
    if S[p .. "_sz"] == nil then S[p .. "_sz"] = cfg.sz or 4 end

    if S[p .. "_ox"] == nil then S[p .. "_ox"] = 0 end
    if S[p .. "_oy"] == nil then S[p .. "_oy"] = 0 end
    if S[p .. "_oz"] == nil then S[p .. "_oz"] = 0 end

    if S[p .. "_thick"] == nil then S[p .. "_thick"] = 1.4 end

    local cp = world_base_color_prefix(cfg.id)

    if S[cp .. "_h"] == nil
        or S[cp .. "_s"] == nil
        or S[cp .. "_v"] == nil
        or S[cp .. "_alpha"] == nil
    then
        local c = cfg.color or {1, 1, 1, 1}
        local h, s, v =
            world_base_rgb_to_hsv(
                c[1] or 1,
                c[2] or 1,
                c[3] or 1
            )

        if S[cp .. "_h"] == nil then S[cp .. "_h"] = h end
        if S[cp .. "_s"] == nil then S[cp .. "_s"] = s end
        if S[cp .. "_v"] == nil then S[cp .. "_v"] = v end
        if S[cp .. "_alpha"] == nil then
            S[cp .. "_alpha"] =
                math.floor(
                    clamp(c[4] or 1, 0, 1) * 100 + 0.5
                )
        end
    end
end

function world_base_enabled(cfg)
    if not cfg then
        return false
    end
    world_base_ensure_state(cfg)
    return S["world_base_" .. tostring(cfg.id)] == true
end

function world_any_base_enabled()
    for i = 1, #WORLD_BASE_ITEMS do
        if world_base_enabled(WORLD_BASE_ITEMS[i]) then
            return true
        end
    end
    return false
end

function world_base_cfg_by_id(id)
    for i = 1, #WORLD_BASE_ITEMS do
        local cfg = WORLD_BASE_ITEMS[i]
        if cfg and cfg.id == id then
            return cfg
        end
    end
    return nil
end

-- Fallback edge list: a cuboid has exactly 12 edges.
WORLD_BASE_BOX_EDGES = {
    {1,2}, {2,3}, {3,4}, {4,1},
    {5,6}, {6,7}, {7,8}, {8,5},
    {1,5}, {2,6}, {3,7}, {4,8},
}

function world_draw_tunable_box3d(pos, cfg, col, alpha)
    if not pos or not cfg then
        return false
    end

    world_base_ensure_state(cfg)

    local p = "world_base_" .. tostring(cfg.id)
    local sx = clamp(tonumber(S[p .. "_sx"]) or cfg.sx or 4, 0.25, 30)
    local sy = clamp(tonumber(S[p .. "_sy"]) or cfg.sy or 4, 0.25, 30)
    local sz = clamp(tonumber(S[p .. "_sz"]) or cfg.sz or 4, 0.25, 30)

    local ox = clamp(tonumber(S[p .. "_ox"]) or 0, -15, 15)
    local oy = clamp(tonumber(S[p .. "_oy"]) or 0, -15, 15)
    local oz = clamp(tonumber(S[p .. "_oz"]) or 0, -15, 15)

    local thick = clamp(tonumber(S[p .. "_thick"]) or 1.4, 0.5, 5.0)

    local center = nil
    local ok_center, vcenter = pcall(function()
        return Vector3(
            (pos.X or 0) + ox,
            (pos.Y or 0) + oy,
            (pos.Z or 0) + oz
        )
    end)

    if ok_center then
        center = vcenter
    end

    if not center then
        return false
    end

    local r = col[1] or 1
    local g = col[2] or 1
    local b = col[3] or 1

    -- Preferred path: native 12-edge world-space box.
    if Drawing and type(Drawing.DrawBox3D) == "function" then
        local ok = pcall(
            Drawing.DrawBox3D,
            center,
            sx,
            sy,
            sz,
            r,
            g,
            b,
            alpha,
            thick
        )
        if ok then
            return true
        end
    end

    -- Fallback: explicitly draw the same 12 edges.
    local hx = sx * 0.5
    local hy = sy * 0.5
    local hz = sz * 0.5

    local corners = {
        Vector3(center.X - hx, center.Y - hy, center.Z - hz),
        Vector3(center.X + hx, center.Y - hy, center.Z - hz),
        Vector3(center.X + hx, center.Y + hy, center.Z - hz),
        Vector3(center.X - hx, center.Y + hy, center.Z - hz),

        Vector3(center.X - hx, center.Y - hy, center.Z + hz),
        Vector3(center.X + hx, center.Y - hy, center.Z + hz),
        Vector3(center.X + hx, center.Y + hy, center.Z + hz),
        Vector3(center.X - hx, center.Y + hy, center.Z + hz),
    }

    if Drawing and type(Drawing.DrawLine3D) == "function" then
        for i = 1, #WORLD_BASE_BOX_EDGES do
            local e = WORLD_BASE_BOX_EDGES[i]
            pcall(
                Drawing.DrawLine3D,
                corners[e[1]],
                corners[e[2]],
                r, g, b, alpha, thick
            )
        end
        return true
    end

    if Drawing
        and type(Drawing.WorldToScreen) == "function"
        and type(Drawing.DrawLine) == "function"
    then
        local screens = {}
        for i = 1, 8 do
            local ok, s = pcall(Drawing.WorldToScreen, corners[i])
            if ok and s and s.X and s.Y and s.X ~= -1 and s.Y ~= -1 then
                screens[i] = s
            end
        end

        for i = 1, #WORLD_BASE_BOX_EDGES do
            local e = WORLD_BASE_BOX_EDGES[i]
            local a = screens[e[1]]
            local z = screens[e[2]]
            if a and z then
                pcall(
                    Drawing.DrawLine,
                    a.X, a.Y,
                    z.X, z.Y,
                    r, g, b, alpha, thick
                )
            end
        end
        return true
    end

    return false
end

function world_base_row_clip_alpha(
    row_y,
    card_y,
    card_h
)
    local center =
        row_y + 20.5

    local top_full =
        card_y + 25

    local top_zero =
        card_y + 7

    local bottom_full =
        card_y + card_h - 25

    local bottom_zero =
        card_y + card_h - 7

    local top_a =
        clamp(
            (center - top_zero)
            / math.max(
                1,
                top_full - top_zero
            ),
            0,
            1
        )

    local bottom_a =
        clamp(
            (bottom_zero - center)
            / math.max(
                1,
                bottom_zero - bottom_full
            ),
            0,
            1
        )

    return
        smooth01(
            math.min(
                top_a,
                bottom_a
            )
        )
end

