    if anim <= 0.01 then
        return
    end

    local cfg = world_base_cfg_by_id(A.base_box_settings_id)
    if not cfg then
        A.base_box_settings_open = false
        return
    end

    world_base_ensure_state(cfg)

    local parent_alpha = MENU_RENDER_ALPHA
    MENU_RENDER_ALPHA = parent_alpha * anim

    local pw = 365
    local ph = 337
    local px = cx + cw - pw
    local py = cy + 70 + (1 - anim) * 14

    FALLEN_POPUP_GLOW(px, py, pw, ph, 11, anim)

    rounded_fill(
        px,
        py,
        pw,
        ph,
        11,
        { 0.062, 0.066, 0.077, 1 }
