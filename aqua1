function FALLEN_ARMOR_WEAPON_NAME(target)
    if not target then
        return nil
    end

    -- Exact direct fields from the supplied working Armor ESP.
    local direct_fields = {
        target.tool,
        target.weapon,
        target.item,
        target.equipped_tool,
        target.held_item,
        target.current_tool,
        target.current_weapon,
    }

    for _, value in ipairs(direct_fields) do
        if type(value) == "string"
            and value ~= ""
        then
            local name =
                FALLEN_ARMOR_CLEAN_TOOL_NAME(
                    value
                )

            if FALLEN_ARMOR_IS_WEAPON_NAME(name) then
                return name
            end
        end
    end

    local addr_fields = {
        target.tool_addr,
        target.weapon_addr,
        target.item_addr,
    }

    if rbx
        and type(rbx.instance) == "function"
    then
        for _, addr in ipairs(addr_fields) do
            if addr
                and addr ~= 0
            then
                local ok, inst =
                    pcall(
                        rbx.instance,
                        addr
                    )

                if ok
                    and inst
                then
                    local name =
                        FALLEN_ARMOR_CLEAN_TOOL_NAME(
                            FALLEN_ARMOR_SAFE_NAME(inst)
                        )

                    if FALLEN_ARMOR_IS_WEAPON_NAME(name) then
                        return name
                    end
                end
            end
        end
    end

    local char =
        FALLEN_ARMOR_CHAR(target)

    if char then
        local methods = {
            "get_tool",
            "get_equipped_tool",
            "get_held_tool",
            "get_current_tool",
        }

        for _, method in ipairs(methods) do
            local ok, tool =
                pcall(function()
                    if char[method] then
                        return
                            char[method](char)
                    end
                end)

            if ok
                and tool
            then
                local name =
                    FALLEN_ARMOR_CLEAN_TOOL_NAME(
                        FALLEN_ARMOR_SAFE_NAME(tool)
                    )

                if FALLEN_ARMOR_IS_WEAPON_NAME(name) then
                    return name
                end
            end
        end

        local ok_tool, tool =
            pcall(function()
                return
                    char:find_first_child_of_class(
                        "Tool"
                    )
            end)

        if ok_tool
            and tool
        then
            local name =
                FALLEN_ARMOR_CLEAN_TOOL_NAME(
                    FALLEN_ARMOR_SAFE_NAME(tool)
                )

            if FALLEN_ARMOR_IS_WEAPON_NAME(name) then
                return name
            end
        end

        local ok_children, children =
            pcall(function()
                return char:get_children()
            end)

        if ok_children
            and type(children) == "table"
        then
            for _, child in ipairs(children) do
                local name =
                    FALLEN_ARMOR_CLEAN_TOOL_NAME(
                        FALLEN_ARMOR_SAFE_NAME(child)
                    )

                if FALLEN_ARMOR_IS_WEAPON_NAME(name) then
                    local ok_class, class =
                        pcall(function()
                            return child:get_class()
                        end)

                    if (
                        ok_class
                        and class == "Tool"
                    )
                        or FALLEN_WEAPON_ITEMS[name]
                    then
                        return name
                    end
                end
            end
        end
    end

    return nil
end

function FALLEN_WEAPON_NORMALIZE(name)
    local s =
        tostring(name or "")

    s =
        string.lower(s)

    s =
        string.gsub(
            s,
            "[^%w]",
            ""
        )

    return s
end

function FALLEN_WEAPON_MAKE_FANDOM_FALLBACKS(url)
    local out = {}
    local seen = {}

    local function add(u)
        if u
            and u ~= ""
            and not seen[u]
        then
            out[#out + 1] = u
            seen[u] = true
        end
    end

    if not url then
        return out
    end

    local base =
        string.match(
            url,
            "^(.-)/revision/latest"
        )

    if base then
        add(
            base
            .. "/revision/latest?format=original"
        )

        add(
            base
            .. "/revision/latest/scale-to-width-down/180?format=original"
        )

        add(
            base
            .. "/revision/latest/scale-to-width-down/100?format=original"
        )
    end

    add(url)

    if string.find(
        url,
        "?",
        1,
        true
    )
    then
        add(
            url
            .. "&format=original"
        )
    else
        add(
            url
            .. "?format=original"
        )
    end

    return out
end

function FALLEN_WEAPON_DIRECT_URL(name)
    if not name then
        return nil
    end

    local raw =
        tostring(name)

    if FALLEN_WEAPON_DIRECT_ICON_URLS[raw] then
        return
            FALLEN_WEAPON_DIRECT_ICON_URLS[raw]
    end

    local alias =
        FALLEN_WEAPON_DIRECT_ALIASES[raw]

    if alias
        and FALLEN_WEAPON_DIRECT_ICON_URLS[alias]
    then
        return
            FALLEN_WEAPON_DIRECT_ICON_URLS[alias]
    end

    local normalized =
        FALLEN_WEAPON_NORMALIZE(raw)

    if alias then
        normalized =
            FALLEN_WEAPON_NORMALIZE(alias)
    end

    for key, url in pairs(
        FALLEN_WEAPON_DIRECT_ICON_URLS
    ) do
        local nk =
            FALLEN_WEAPON_NORMALIZE(key)

        if nk == normalized then
            return url
        end
    end

    for key, url in pairs(
        FALLEN_WEAPON_DIRECT_ICON_URLS
    ) do
        local nk =
            FALLEN_WEAPON_NORMALIZE(key)

        if normalized ~= ""
            and nk ~= ""
            and (
                string.find(
                    nk,
                    normalized,
                    1,
                    true
                )
                or string.find(
                    normalized,
                    nk,
                    1,
                    true
                )
            )
        then
            return url
        end
    end

    return nil
end

function FALLEN_WEAPON_ICON(name)
    if not name
        or type(LoadImage) ~= "function"
    then
        return nil
    end

    local key =
        tostring(name)

    local url =
        FALLEN_WEAPON_DIRECT_URL(key)

    if not url then
        return nil
    end

    local st =
        FALLEN_WEAPON_ICON_CACHE[key]

    if not st then
        local urls =
            FALLEN_WEAPON_MAKE_FANDOM_FALLBACKS(
                url
            )

        st = {
            urls = urls,
            index = 1,
            handle = nil,
            dead = false,
        }

        FALLEN_WEAPON_ICON_CACHE[key] = st

        if urls[1] then
            local ok, handle =
                pcall(
                    LoadImage,
                    urls[1]
                )

            if ok and handle then
                st.handle = handle
            end
        end
    end

    if st.dead then
        return nil
    end

    if st.handle
        and type(IsImageReady) == "function"
    then
        local ok, ready =
            pcall(
                IsImageReady,
                st.handle
            )

        if ok
            and ready == true
        then
            return st.handle
        end
    end

    if st.handle
        and type(IsImageFailed) == "function"
    then
        local ok, failed =
            pcall(
                IsImageFailed,
                st.handle
            )

        if ok
            and failed == true
        then
            st.index =
                (st.index or 1)
                + 1

            st.handle = nil

            local next_url =
                st.urls
                and st.urls[st.index]

            if next_url then
                local load_ok, handle =
                    pcall(
                        LoadImage,
                        next_url
                    )

                if load_ok
                    and handle
                then
                    st.handle = handle
                end
            else
                st.dead = true
            end

            return nil
        end
    end

    -- Not ready yet: do not DrawImage until IsImageReady says true.
    return nil
end

function FALLEN_ARMOR_ITEMS(p)
    if not p then return {} end

    if type(A.armor_item_cache) ~= "table" then
        A.armor_item_cache = {}
    end

    local key =
        FALLEN_ARMOR_PLAYER_KEY(p)
        .. "|weapon="
        .. (
            S.armor_show_weapon == true
            and "1"
            or "0"
        )

    local now = tick()
    local cached =
        A.armor_item_cache[key]

    local ttl =
        S.armor_show_weapon == true
        and 0.18
        or 0.65

    if cached
        and now - (cached.t or 0) < ttl
    then
        return cached.items or {}
    end

    local items = {}
    local seen = {}

    if S.armor_show_weapon == true then
        local weapon =
            FALLEN_ARMOR_WEAPON_NAME(p)

        if weapon
            and weapon ~= ""
        then
            items[#items + 1] =
                "__weapon__"
                .. tostring(weapon)
        end
    end

    local char =
        FALLEN_ARMOR_CHAR(p)

    if char then
        FALLEN_ARMOR_SCAN(
            char,
            items,
            seen,
            0
        )
    end

    -- Also scan the Player instance because some armor folders live there.
    if rbx
        and type(rbx.players_service) == "function"
        and p.name
    then
        local ok, ps =
            pcall(
                rbx.players_service
            )

        if ok and ps then
            local ok_plr, plr =
                pcall(function()
                    return ps:find_first_child(p.name)
                end)

            if ok_plr and plr then
                FALLEN_ARMOR_SCAN(
                    plr,
                    items,
                    seen,
                    0
                )
            end
        end
    end

    A.armor_item_cache[key] = {
        t = now,
        items = items,
    }

    return items
end

function FALLEN_ARMOR_VALID_PLAYER(p)
    if not p
        or p.is_self == true
        or p.is_knocked == true
        or p.is_dead == true
    then
        return false
    end

    if p.health ~= nil
        and (tonumber(p.health) or 0) <= 1
    then
        return false
    end

    if p.address ~= nil
        and p.address == 0
    then
        return false
    end

    local pos =
        p.head_pos
        or p.position

    if not pos
        or pos.X == nil
        or pos.Y == nil
        or pos.Z == nil
    then
        return false
    end

    if pos.X == 0
        and pos.Y == 0
        and pos.Z == 0
    then
        return false
    end

    local max_dist =
        tonumber(S.armor_esp_range)
        or 1200

    if p.distance
        and tonumber(p.distance)
        and tonumber(p.distance) > max_dist
    then
        return false
    end

    return true
end

function FALLEN_ARMOR_HEAD_POS(p)
    if not p then return nil end

    if p.head_pos
        and p.head_pos.X
        and p.head_pos.Y
        and p.head_pos.Z
    then
        return p.head_pos
    end

    if p.position
        and p.position.X
        and p.position.Y
        and p.position.Z
    then
        return {
            X = p.position.X,
            Y = p.position.Y + 2.0,
            Z = p.position.Z,
        }
    end

    return nil
end

function FALLEN_ARMOR_ICON(name)
    if not name
        or type(LoadImage) ~= "function"
    then
        return nil
    end

    local urls =
        FALLEN_ARMOR_ICON_URLS[name]

    if type(urls) ~= "table"
        or #urls == 0
    then
        return nil
    end

    local st =
        FALLEN_ARMOR_ICON_CACHE[name]

    if not st then
        st = {
            index = 1,
            handle = nil,
            dead = false,
        }

        FALLEN_ARMOR_ICON_CACHE[name] = st
    end

    if st.dead then
        return nil
    end

    if not st.handle then
        local url =
            urls[st.index]

        if not url then
            st.dead = true
            return nil
        end

        local ok, handle =
            pcall(
                LoadImage,
                url
            )

        if ok and handle then
            st.handle = handle
        else
            st.index = st.index + 1
            return nil
        end
    end

    if type(IsImageReady) == "function" then
        local ok, ready =
            pcall(
                IsImageReady,
                st.handle
            )

        if ok and ready == true then
            return st.handle
        end
    end

    if type(IsImageFailed) == "function" then
        local ok, failed =
            pcall(
                IsImageFailed,
                st.handle
            )

        if ok and failed == true then
            st.index = st.index + 1
            st.handle = nil

            if not urls[st.index] then
                st.dead = true
            end
        end
    end

    return nil
end

function FALLEN_ARMOR_SHORT(name)
    local s =
        tostring(name or "?")

    local a, b =
        string.match(
            s,
            "^(%S+)%s+(%S+)"
        )

    if a and b then
        return
            string.sub(a, 1, 1)
            .. string.sub(b, 1, 1)
    end

    return string.sub(s, 1, 2)
end

function FALLEN_ARMOR_DRAW_ICON(name, x, y, size, alpha, boxed)
    alpha =
        clamp(
            tonumber(alpha) or 1,
            0,
            1
        )

    local is_weapon =
        type(name) == "string"
        and string.sub(name, 1, 10)
            == "__weapon__"

    local display_name =
        is_weapon
        and string.sub(name, 11)
        or name

    if boxed == true then
        if type(DrawBoxFilled) == "function" then
            DrawBoxFilled(
                x - 2,
                y - 2,
                x + size + 2,
                y + size + 2,
                0.025,
                0.026,
                0.032,
                0.80 * alpha
            )
        end

        if type(DrawBox) == "function" then
            DrawBox(
                x - 2,
                y - 2,
                x + size + 2,
                y + size + 2,
                is_weapon and 1.00 or 0.58,
                is_weapon and 0.82 or 0.68,
                is_weapon and 0.25 or 0.92,
                0.34 * alpha,
                1
            )
        end
    end

    local handle =
        is_weapon
        and FALLEN_WEAPON_ICON(display_name)
        or FALLEN_ARMOR_ICON(display_name)

    if handle
        and type(DrawImage) == "function"
    then
        DrawImage(
            handle,
            x,
            y,
            size,
            size,
            1,
            1,
            1,
            alpha,
            math.max(
                2,
                size * 0.12
            )
        )
    elseif type(DrawTextWithOutline) == "function" then
        DrawTextWithOutline(
            x + size * 0.5,
            y + size * 0.5 - 6,
            is_weapon
                and "W"
                or FALLEN_ARMOR_SHORT(display_name),
            is_weapon and 1.00 or 1,
            is_weapon and 0.82 or 1,
            is_weapon and 0.25 or 1,
            alpha,
            0,
            0,
            0,
            alpha
        )
    end
end

function FALLEN_ARMOR_SMOOTH_SCREEN(p, target_x, target_y)
    if type(A.armor_screen_smooth) ~= "table" then
        A.armor_screen_smooth = {}
    end

    local key =
        FALLEN_ARMOR_PLAYER_KEY(p)

    local now = tick()
    local rec =
        A.armor_screen_smooth[key]

    local smooth =
        clamp(
            tonumber(S.armor_esp_smooth) or 18,
            0,
            50
        )

    if smooth <= 0
        or not rec
    then
        A.armor_screen_smooth[key] = {
            x = target_x,
            y = target_y,
            t = now,
            seen = now,
        }

        return target_x, target_y
    end

    local dt =
        clamp(
            now - (rec.t or now),
            0,
            0.08
        )

    local a =
        1 / (1 + smooth * 0.16)

    a =
        clamp(
            a * math.max(1, dt * 60),
            0.035,
            1
        )

    rec.x =
        (rec.x or target_x)
        + (target_x - (rec.x or target_x)) * a

    rec.y =
        (rec.y or target_y)
        + (target_y - (rec.y or target_y)) * a

    rec.t = now
    rec.seen = now

    return rec.x, rec.y
end

function FALLEN_ARMOR_CLOSEST()
    if not players
        or type(players.get_all) ~= "function"
        or not aim
        or type(aim.world_to_screen) ~= "function"
    then
        return nil
    end

    local ok, list =
        pcall(
            players.get_all
        )

    if not ok
        or type(list) ~= "table"
    then
        return nil
    end

    local cross =
        crosshair_pos()

    if not cross then
        return nil
    end

    local best = nil
    local best_sd = 280

    for _, p in ipairs(list) do
        if FALLEN_ARMOR_VALID_PLAYER(p) then
            local pos =
                FALLEN_ARMOR_HEAD_POS(p)

            if pos then
                local scr = nil

                pcall(function()
                    scr =
                        aim.world_to_screen(pos)
                end)

                if scr
                    and scr.visible
                then
                    local dx =
                        (scr.X or 0)
                        - (cross.X or 0)

                    local dy =
                        (scr.Y or 0)
                        - (cross.Y or 0)

                    local sd =
                        math.sqrt(
                            dx * dx
                            + dy * dy
                        )

                    if sd < best_sd then
                        best_sd = sd
                        best = p
                    end
                end
            end
        end
    end

    return best
end

function FALLEN_ARMOR_DRAW_ANIMATED_FRAME(
    x,
    y,
    w,
    h,
    alpha
)
    if alpha < 0.04
        or type(DrawLine) ~= "function"
    then
        return
    end

    local perimeter =
        (w + h) * 2

    if perimeter <= 0 then
        return
    end

    local head =
        (tick() * 145)
        % perimeter

    local trail = 95
    local pieces = 8
    local step =
        trail / pieces

    if type(DrawBox) == "function" then
        DrawBox(
            x,
            y,
            x + w,
            y + h,
            0.42,
            0.54,
            0.88,
            0.16 * alpha,
            1
        )
    end

    for piece = 0, pieces - 1 do
        local p1 =
            (
                head
                - piece * step
            )
            % perimeter

        local p2 =
            (
                head
                - (piece + 1) * step
            )
            % perimeter

        local fade =
            1
            - piece / pieces

        local function point_at(p)
            if p < w then
                return x + p, y
            elseif p < w + h then
                return x + w, y + (p - w)
            elseif p < w + h + w then
                return x + w - (p - w - h), y + h
            end

            return
                x,
                y + h - (p - w - h - w)
        end

        local x1, y1 =
            point_at(p1)

        local x2, y2 =
            point_at(p2)

        -- Only draw a segment if it did not wrap around a corner.
        if math.abs(x1 - x2) <= 18
            or math.abs(y1 - y2) <= 18
        then
            DrawLine(
                x1,
                y1,
                x2,
                y2,
                0.58 + 0.34 * fade,
                0.68 + 0.25 * fade,
                1.00,
                alpha
                    * (
                        0.10
                        + fade * 0.82
                    ),
                2.6
            )
        end
    end
end

function FALLEN_ARMOR_DRAW_NORMAL()
    local target =
        FALLEN_ARMOR_CLOSEST()

    if not target then
        A.armor_target_alpha =
            lerp(
                A.armor_target_alpha or 0,
                0,
                0.18
            )
        return
    end

    local items =
        FALLEN_ARMOR_ITEMS(target)

    if type(items) ~= "table"
        or #items == 0
    then
        A.armor_target_alpha =
            lerp(
                A.armor_target_alpha or 0,
                0,
                0.12
            )
        return
    end

    A.armor_target_alpha =
        lerp(
            A.armor_target_alpha or 0,
            1,
            0.12
        )

    local alpha =
        A.armor_target_alpha

    local target_key =
        FALLEN_ARMOR_PLAYER_KEY(target)

    if target_key ~= A.armor_last_target_key then
        A.armor_last_target_key =
            target_key

        A.armor_panel_pulse_until =
            tick() + 0.45
    end

    local sw, sh =
        screen_size()

    -- Normal panel intentionally uses larger slots than On Player mode,
    -- matching the supplied target hotbar behavior.
    local size =
        clamp(
            (tonumber(S.armor_esp_size) or 18) * 2.25,
            24,
            72
        )

    local gap = 6
    local panel_pad = 10
    local name_h = 36

    local horiz_w =
        #items * size
        + math.max(0, #items - 1) * gap

    local horiz_h =
        size

    local vert_w =
        size

    local vert_h =
        #items * size
        + math.max(0, #items - 1) * gap

    local horiz_panel_w =
        horiz_w
        + panel_pad * 2

    local horiz_panel_h =
        horiz_h
        + name_h
        + 12

    local vert_panel_w =
        vert_w
        + panel_pad * 2

    local vert_panel_h =
        vert_h
        + name_h
        + 12

    -- Initial position only. After that, the user owns the position.
    if A.armor_hotbar_x == nil then
        A.armor_hotbar_x =
            sw * 0.5
    end

    if A.armor_hotbar_y == nil then
        A.armor_hotbar_y =
            sh * 0.72
    end

    if A.armor_draw_x == nil then
        A.armor_draw_x =
            A.armor_hotbar_x
    end

    if A.armor_draw_y == nil then
        A.armor_draw_y =
            A.armor_hotbar_y
    end

    local current_panel_w =
        A.armor_hotbar_vertical
        and vert_panel_w
        or horiz_panel_w

    local current_panel_h =
        A.armor_hotbar_vertical
        and vert_panel_h
        or horiz_panel_h

    local current_start_x =
        A.armor_hotbar_x
        - current_panel_w * 0.5

    local current_start_y =
        A.armor_hotbar_y
        - name_h

    local mx, my =
        mouse_pos()

    local lmb_down =
        key_down(0x01)

    local mouse_inside =
        mx >= current_start_x
        and my >= current_start_y
        and mx <= current_start_x + current_panel_w
        and my <= current_start_y + current_panel_h

    if lmb_down
        and not A.armor_dragging
        and mouse_inside
    then
        A.armor_dragging = true
        A.armor_drag_dx =
            mx - A.armor_hotbar_x
        A.armor_drag_dy =
            my - A.armor_hotbar_y

    elseif not lmb_down then
        A.armor_dragging = false
    end

    if A.armor_dragging then
        A.armor_hotbar_x =
            mx
            - (A.armor_drag_dx or 0)

        A.armor_hotbar_y =
            my
            - (A.armor_drag_dy or 0)
    end

    -- Same side behavior as the supplied working Armor ESP:
    -- horizontal in normal space, vertical when pushed to either edge.
    local horiz_left =
        A.armor_hotbar_x
        - horiz_panel_w * 0.5

    local horiz_right =
        A.armor_hotbar_x
        + horiz_panel_w * 0.5

    local edge_trigger = 12

    if not A.armor_hotbar_vertical then
        if horiz_panel_w > sw - 16
            or horiz_left < edge_trigger
            or horiz_right > sw - edge_trigger
        then
            A.armor_hotbar_vertical = true
        end
    else
        if horiz_panel_w <= sw - 16
            and A.armor_hotbar_x - horiz_panel_w * 0.5 > 80
            and A.armor_hotbar_x + horiz_panel_w * 0.5 < sw - 80
        then
            A.armor_hotbar_vertical = false
        end
    end

    local is_vertical =
        A.armor_hotbar_vertical == true

    local total_w =
        is_vertical
        and vert_w
        or horiz_w

    local total_h =
        is_vertical
        and vert_h
        or horiz_h

    local panel_w =
        is_vertical
        and vert_panel_w
        or horiz_panel_w

    local panel_h =
        is_vertical
        and vert_panel_h
        or horiz_panel_h

    -- Clamp the draggable panel so it cannot disappear off-screen.
    local min_x =
        8 + panel_w * 0.5

    local max_x =
        sw - 8 - panel_w * 0.5

    if min_x > max_x then
        min_x = sw * 0.5
        max_x = sw * 0.5
    end

    local center_y =
        A.armor_hotbar_y
        + (
            panel_h * 0.5
            - name_h
        )

    local min_center_y =
        8 + panel_h * 0.5

    local max_center_y =
        sh - 8 - panel_h * 0.5

    if min_center_y > max_center_y then
        min_center_y = sh * 0.5
        max_center_y = sh * 0.5
    end

    A.armor_hotbar_x =
        clamp(
            A.armor_hotbar_x,
            min_x,
            max_x
        )

    center_y =
        clamp(
            center_y,
            min_center_y,
            max_center_y
        )

    A.armor_hotbar_y =
        center_y
        - (
            panel_h * 0.5
            - name_h
        )

    -- Smooth movement, but faster while actively dragging.
    A.armor_draw_x =
        lerp(
            A.armor_draw_x,
            A.armor_hotbar_x,
            A.armor_dragging
                and 0.35
                or 0.16
        )

    A.armor_draw_y =
        lerp(
            A.armor_draw_y,
            A.armor_hotbar_y,
            A.armor_dragging
                and 0.35
                or 0.16
        )

    local start_x =
        A.armor_draw_x
        - total_w * 0.5

    local start_y =
        A.armor_draw_y

    if is_vertical then
        start_x =
            A.armor_draw_x
            - size * 0.5
    end

    local panel_x =
        A.armor_draw_x
        - panel_w * 0.5

    local panel_y =
        A.armor_draw_y
        - name_h

    local pulse = 0

    if tick() < (A.armor_panel_pulse_until or 0) then
        pulse =
            (
                A.armor_panel_pulse_until
                - tick()
            )
            / 0.45
    end

    if type(DrawBoxFilled) == "function" then
        DrawBoxFilled(
            panel_x,
            panel_y,
            panel_x + panel_w,
            panel_y + panel_h,
            0.010,
            0.010,
            0.014,
            0.58 * alpha
        )
    end

    if type(DrawBox) == "function" then
        DrawBox(
            panel_x,
            panel_y,
            panel_x + panel_w,
            panel_y + panel_h,
            0.58,
            0.68,
            0.96,
            0.12 * alpha,
            1
        )
    end

    FALLEN_ARMOR_DRAW_PANEL_GLOW(
        panel_x,
        panel_y,
        panel_w,
        panel_h,
        8,
        alpha
    )

    local display_name =
        tostring(
            target.name
            or target.display_name
            or "Player"
        )

    if type(DrawTextWithOutline) == "function" then
        DrawTextWithOutline(
            A.armor_draw_x,
            A.armor_draw_y - 31,
            display_name,
            1,
            1,
            1,
            alpha,
            0,
            0,
            0,
            alpha
        )
    end

    local hp =
        tonumber(target.health)
        or 0

    local max_hp =
        tonumber(target.max_health)
        or 100

    if max_hp <= 0 then
        max_hp = 100
    end

    local hp_frac =
        clamp(
            hp / max_hp,
            0,
            1
        )

    local hp_x =
        panel_x + panel_pad

    local hp_y =
        A.armor_draw_y - 13

    local hp_w =
        panel_w - panel_pad * 2

    if type(DrawBoxFilled) == "function" then
        DrawBoxFilled(
            hp_x,
            hp_y,
            hp_x + hp_w * hp_frac,
            hp_y + 5,
            1 - hp_frac,
            hp_frac,
            0.12,
            0.95 * alpha
        )
    end

    if type(DrawBox) == "function" then
        DrawBox(
            hp_x,
            hp_y,
            hp_x + hp_w,
            hp_y + 5,
            1,
            1,
            1,
            0.10 * alpha,
            1
        )
    end

    for i, item in ipairs(items) do
        local ix
        local iy

        if is_vertical then
            ix =
                A.armor_draw_x
                - size * 0.5

            iy =
                start_y
                + (i - 1) * (size + gap)
        else
            ix =
                start_x
                + (i - 1) * (size + gap)

            iy =
                start_y
        end

        FALLEN_ARMOR_DRAW_ICON(
            item,
            ix,
            iy,
            size,
            alpha,
            true
        )
    end
end

