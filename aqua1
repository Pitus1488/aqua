function FALLEN_BT_SHOT_TICK()
    if S.bullet_tracer_enabled ~= true then
        return
    end

    -- Mouse1 belongs to the local client.
    if key_down(0x01) ~= true then
        return
    end

    local target = FALLEN_BT_ACTIVE_TARGET()

    if not target then
        return
    end

    if FALLEN_BT_HAS_GUN() ~= true then
        return
    end

    local now = tick()

    local delay =
        clamp(
            tonumber(S.bullet_tracer_delay) or 0.13,
            0.04,
            0.50
        )

    if now - (FALLEN_BT.last_shot or 0) < delay then
        return
    end

    local cam = nil

    pcall(function()
        if aim
            and type(aim.get_camera_position) == "function"
        then
            cam = aim.get_camera_position()
        end
    end)

    if not cam then
        return
    end

    FALLEN_BT.last_shot = now

    FALLEN_BT_ADD(
        cam,
        target
    )
end

function FALLEN_BT_DRAW_PATH(
    tr,
    points,
    reveal,
    alpha,
    thick
)
    if type(points) ~= "table"
        or #points < 2
        or type(DrawLine) ~= "function"
    then
        return
    end

    local style =
        FALLEN_BT_STYLE_INDEX()

    local max_u =
        clamp(
            reveal,
            0,
            1
        )

    local previous = nil

    for i = 1, #points do
        local point =
            points[i]

        if point
            and point.x
            and point.y
            and point.u
            and point.u <= max_u + 0.0001
        then
            local px = point.x
            local py = point.y

            if style == 1 then
                -- Lightning keeps the ballistic curve and only waves around it.
                local prev_for_normal =
                    previous
                    or point

                local dx =
                    px - (prev_for_normal.x or px)

                local dy =
                    py - (prev_for_normal.y or py)

                local len =
                    math.sqrt(
                        dx * dx
                        + dy * dy
                    )

                if len > 0.01 then
                    local nx = -dy / len
                    local ny = dx / len

                    local offset =
                        math.sin(
                            point.u * 54
                            + (tr.seed or 1) * 0.017
                            + tick() * 4
                        ) * 2.25

                    px = px + nx * offset
                    py = py + ny * offset
                end
            end

            local current = {
                x = px,
                y = py,
                u = point.u,
            }

            if previous then
                if style == 2 then
                    -- Rainbow.
                    local hue =
                        (
                            tick() * 0.20
                            + point.u * 0.92
                            + ((tr.seed or 1) % 97) / 97
                        ) % 1

                    local rr, gg, bb =
                        hsv_to_rgb(
                            hue,
                            0.88,
                            1
                        )

                    DrawLine(previous.x, previous.y, current.x, current.y,
                        rr, gg, bb, alpha * 0.12, thick + 14)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        rr, gg, bb, alpha * 0.32, thick + 7)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        rr, gg, bb, alpha * 0.96, thick + 1.5)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        1, 1, 1, alpha * 0.24, 1)

                elseif style == 1 then
                    local col = FALLEN_BT_COLOR()

                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.15, thick + 5)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.36, thick + 2)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.92, thick)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        1, 1, 1, alpha * 0.44, 1)

                else
                    -- Neon.
                    local col = FALLEN_BT_COLOR()

                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.10, thick + 12)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.20, thick + 8)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.38, thick + 5)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        col[1], col[2], col[3], alpha * 0.78, thick + 2)
                    DrawLine(previous.x, previous.y, current.x, current.y,
                        1, 1, 1, alpha * 0.62, math.max(1, thick - 0.35))
                end
            end

            previous = current
        end
    end
end

function FALLEN_BT_PREDICTION_PATH(tr)
    local points = {}

    local total_time =
        clamp(
            tonumber(tr.prediction_time) or 0,
            0,
            3
        )

    local gravity =
        tonumber(tr.gravity)
        or 0

    if tr.auto_prediction ~= true
        or total_time <= 0.0001
    then
        return points
    end

    -- fap_predict() adds +0.5*g*T^2 to the aim point.
    -- Subtract it to recover the future impact position, then rebuild the
    -- actual projectile parabola with the SAME T and gravity.
    local drop =
        0.5
        * gravity
        * total_time
        * total_time

    local impact_x = tr.tx
    local impact_y = tr.ty - drop
    local impact_z = tr.tz

    local vx =
        (impact_x - tr.ox)
        / total_time

    local vy =
        (impact_y - tr.oy)
        / total_time
        + 0.5
        * gravity
        * total_time

    local vz =
        (impact_z - tr.oz)
        / total_time

    local steps = 34

    for i = 0, steps do
        local u = i / steps
        local t = total_time * u

        local world = {
            X = tr.ox + vx * t,
            Y = tr.oy + vy * t - 0.5 * gravity * t * t,
            Z = tr.oz + vz * t,
        }

        local s = FALLEN_BT_PROJECT(world)

        if s then
            points[#points + 1] = {
                x = s.X,
                y = s.Y,
                u = u,
            }
        end
    end

    return points
end

function FALLEN_BT_STRAIGHT_PATH(tr)
    local points = {}
    local steps = 18

    for i = 1, steps do
        local u = i / steps

        local world = {
            X = tr.ox + (tr.tx - tr.ox) * u,
            Y = tr.oy + (tr.ty - tr.oy) * u,
            Z = tr.oz + (tr.tz - tr.oz) * u,
        }

        local s = FALLEN_BT_PROJECT(world)

        if s then
            points[#points + 1] = {
                x = s.X,
                y = s.Y,
                u = u,
            }
        end
    end

    return points
end

function FALLEN_BT_DRAW_ONE(tr, age, life)
    local reveal_time =
        clamp(
            tonumber(S.bullet_tracer_reveal) or 0.22,
            0.03,
            1.50
        )

    local reveal =
        clamp(
            age / reveal_time,
            0,
            1
        )

    local fade =
        clamp(
            1 - age / life,
            0,
            1
        )

    local col = FALLEN_BT_COLOR()
    local alpha = fade * (col[4] or 1)

    local thick =
        clamp(
            tonumber(S.bullet_tracer_thickness) or 2,
            1,
            6
        )

    if alpha <= 0.002 then
        return
    end

    local points

    if tr.auto_prediction == true
        and (tonumber(tr.prediction_time) or 0) > 0
    then
        points = FALLEN_BT_PREDICTION_PATH(tr)
    else
        points = FALLEN_BT_STRAIGHT_PATH(tr)
    end

    FALLEN_BT_DRAW_PATH(
        tr,
        points,
        reveal,
        alpha,
        thick
    )
end
function FALLEN_BT_DRAW()
    if type(FALLEN_BT.items) ~= "table" then
        FALLEN_BT.items = {}
    end

    local now = tick()

    local life =
        clamp(
            tonumber(S.bullet_tracer_life) or 1.2,
            0.10,
            8.0
        )

    for i = #FALLEN_BT.items, 1, -1 do
        local tr = FALLEN_BT.items[i]
        local age = now - (tr.created or now)

        if age > life
            or S.bullet_tracer_enabled ~= true
        then
            table.remove(FALLEN_BT.items, i)
        else
            FALLEN_BT_DRAW_ONE(
                tr,
                age,
                life
            )
        end
    end
end

