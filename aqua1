    end

    MENU_RENDER_ALPHA = parent_menu_alpha
end


local function draw_aimbot_page(
    mx, my, clicked, lmb, rmb_clicked, cx, cy, cw
)
    local gap = 16
    local left_w = math.floor(cw * 0.48)
    local right_w = cw - left_w - gap

    local lx = cx
    local rx = cx + left_w + gap

    local overlay_open =
        A.aim_settings_open
        or (A.aim_settings_anim or 0) > 0.02
        or A.fov_settings_open
        or (A.fov_settings_anim or 0) > 0.02
        or A.aim_bind_listening

    local base_clicked =
        clicked and not overlay_open

    -- LEFT: normal Aimbot block.
    section_title(lx, cy, "Aimbot")
    card(lx, cy + 25, left_w, 155, 11)

    local dots_x = lx + left_w - 79
    local dots_y = cy + 40
    local dots_left_hot =
        hover(
            mx,
            my,
            dots_x,
            dots_y,
            27,
            25
        )

    toggle_row(
        mx,
        my,
        base_clicked and not dots_left_hot,
        lx,
        cy + 32,
        left_w,
        "Aimbot",
        "aim_enabled",
        true
    )

    local aimbot_row_hot =
        hover(
            mx,
            my,
            lx,
            cy + 32,
            left_w,
            41
        )

    if rmb_clicked and aimbot_row_hot then
        A.aim_settings_open =
            not A.aim_settings_open

        A.fov_settings_open = false

        if A.aim_settings_open then
            numeric_stop(true)
            A.fov_picker_open = false
            A.fov_picker_drag = nil
        else
            A.aim_part_dropdown_open = false
            aim_bind_cancel()
        end
    end

    line(
        lx + 12,
        cy + 72,
        lx + left_w - 12,
        cy + 72,
        C.divider,
        1
    )

    toggle_row(
        mx,
        my,
        base_clicked,
        lx,
        cy + 73,
        left_w,
        "Auto Prediction",
        "aim_auto_prediction",
        false
    )

    line(
        lx + 12,
        cy + 113,
        lx + left_w - 12,
        cy + 113,
        C.divider,
        1
    )

    toggle_row(
        mx,
        my,
        base_clicked,
        lx,
        cy + 114,
        left_w,
        "Sticky Aim",
        "sticky_aim",
        false
    )

    -- LEFT: separate Silent Aim block.
