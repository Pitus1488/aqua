-- Weather is deliberately rendered in a SECOND pass after the full menu.
-- If the Drawing backend has a per-frame primitive budget, the interface
-- always gets priority. Particles are excluded from the menu rectangle, so
-- visually they still remain behind the UI.
hooks.on_render(function()
    if _G.FallenMenuReady ~= true then
        return
    end

    local weather_active =
        (
            S.visible == true
            and (
                S.menu_snow == true
                or S.menu_rain == true
                or S.menu_lightning == true
            )
        )
        or (A.weather_snow_alpha or 0) > 0.01
        or (A.weather_rain_alpha or 0) > 0.01
        or (A.weather_lightning_alpha or 0) > 0.01
        or (A.weather_lightning_flash or 0) > 0.01
        or (
            type(A.weather_snow_bank) == "table"
            and #A.weather_snow_bank > 0
            and (A.weather_snow_alpha or 0) > 0.005
        )

    if not weather_active then
        return
    end

    local r =
        FALLEN_WEATHER_MENU_RECT

    if not r then
        return
    end

    -- Main menu callback restores these to neutral at its end; force them
    -- neutral anyway so this pass cannot affect the next frame's menu.
    local old_transform = MENU_UI_TRANSFORM_ACTIVE
    local old_alpha = MENU_RENDER_ALPHA

    MENU_UI_TRANSFORM_ACTIVE = false
    MENU_RENDER_ALPHA = 1

    local ok, err =
        pcall(
            FALLEN_DRAW_MENU_WEATHER,
            r.screen_w,
            r.screen_h,
            r.x,
            r.y,
            r.w,
            r.h
        )

    MENU_UI_TRANSFORM_ACTIVE = old_transform
    MENU_RENDER_ALPHA = old_alpha

    if not ok
        and type(warn) == "function"
    then
        -- Do not spam every frame if an API-specific primitive fails.
        if not FALLEN_WEATHER_DRAW_WARNED then
            FALLEN_WEATHER_DRAW_WARNED = true
            pcall(
                warn,
                "[Fallen-lua weather] " .. tostring(err)
            )
        end
    end
end)

