            col[1] or 1,
            col[2] or 1,
            col[3] or 1,
            alpha,
            0,
            0,
            0,
            alpha
        )
    end

    if S.world_show_distance == true then
        local dy =
            S.world_show_names == true
            and 14
            or 0

        DrawTextWithOutline(
            screen.X,
            screen.Y + dy,
            string.format(
                "%.0fm",
                dist
            ),
            col[1] or 1,
            col[2] or 1,
            col[3] or 1,
            alpha,
            0,
            0,
            0,
            alpha
        )
    end
end

local function world_esp_tick()
    if _G.FallenMenuReady ~= true
        or S.world_esp_enabled ~= true
    then
        return
    end

    world_refresh_cache(false)

    local my_pos =
        world_local_pos()

    if not my_pos then
        return
    end

    for _, entry in ipairs(
        WORLD_ESP.entries
    ) do
        world_draw_entry(
            entry,
            my_pos
        )
    end

    for _, entry in ipairs(
        WORLD_ESP.base_entries
    ) do
        world_draw_base_entry(
            entry,
            my_pos
        )
    end
end

hooks.on_render(function()
    local ok, err =
        pcall(
            world_esp_tick
        )

    if not ok then
        WORLD_ESP.last_error_at =
            WORLD_ESP.last_error_at
            or 0

        if tick() - WORLD_ESP.last_error_at > 2 then
            WORLD_ESP.last_error_at = tick()

            warn(
                SYS
                .. "Resource ESP: "
                .. tostring(err)
            )
        end
    end
end)



