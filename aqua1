function FALLEN_BT_HAS_GUN()
    local weapon = FAP.weapon

    if not weapon or weapon == "" then
        pcall(function()
            weapon = fap_detect_weapon()
        end)
    end

    if not weapon or weapon == "" then
        return false
    end

    local lower = string.lower(tostring(weapon))

    local bad = {
        "rock",
        "stone hatchet",
        "pickaxe",
        "hammer",
        "building",
        "torch",
        "bandage",
        "medkit",
        "syringe",
    }

    for _, word in ipairs(bad) do
        if string.find(lower, word, 1, true) then
            return false
        end
    end

    return true
end

function FALLEN_BT_ACTIVE_TARGET()
    if S.aim_enabled ~= true then
        return nil
    end

    if not FAP.current_target_pos
        or tick() - (FAP.current_target_seen or 0) > 0.18
    then
        return nil
    end

    local my_name = FALLEN_BT_LOCAL_NAME()

    if my_name
        and FAP.current_target_name
        and FAP.current_target_name ~= ""
        and string.lower(FAP.current_target_name)
            == string.lower(my_name)
    then
        return nil
    end

    return {
        X = FAP.current_target_pos.X,
        Y = FAP.current_target_pos.Y,
        Z = FAP.current_target_pos.Z,

        auto_prediction =
            FAP.current_auto_prediction == true,

        prediction_time =
            tonumber(FAP.current_prediction_time)
            or 0,

        gravity =
            tonumber(FAP.current_prediction_gravity)
            or 0,

        bullet_speed =
            tonumber(FAP.current_prediction_speed)
            or 0,
    }
end

function FALLEN_BT_ADD(origin, target)
    if not origin or not target then
        return
    end

    FALLEN_BT.items[#FALLEN_BT.items + 1] = {
        ox = origin.X,
        oy = origin.Y,
        oz = origin.Z,

        tx = target.X,
        ty = target.Y,
        tz = target.Z,

        auto_prediction =
            target.auto_prediction == true,

        prediction_time =
            tonumber(target.prediction_time)
            or 0,

        gravity =
            tonumber(target.gravity)
            or 0,

        bullet_speed =
            tonumber(target.bullet_speed)
            or 0,

        created = tick(),
        owner = FALLEN_BT_LOCAL_NAME(),

        seed =
            (#FALLEN_BT.items + 1) * 19
            + math.floor(tick() * 1000),

        hue =
            (
                (tonumber(S.bullet_tracer_h) or 0.58)
                + (#FALLEN_BT.items + 1) * 0.173
            ) % 1,
    }

    while #FALLEN_BT.items > 40 do
        table.remove(FALLEN_BT.items, 1)
    end
end

function FALLEN_BT_PROJECT(pos)
    if not aim
        or type(aim.world_to_screen) ~= "function"
        or not pos
    then
        return nil
    end

    local s = nil

    pcall(function()
        s = aim.world_to_screen(pos)
