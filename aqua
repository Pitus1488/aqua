        hue_x - 3,
        hue_y - 3,
        6,
        hue_h + 6,
        3,
        { 1, 1, 1, 1 }
    )

    rounded_fill(
        hue_x - 1,
        hue_y - 1,
        2,
        hue_h + 2,
        1,
        { 0.12, 0.12, 0.14, 1 }
    )

    -- Alpha strip.
    local alpha_y =
        hue_y + 29

    local alpha_h = 14

