        centered_text(
            dots_x + dots_w * 0.5,
            y + 13,
            "...",
            dots_hot and C.text or C.text_faint
        )
    end

    local value = S[key] == true

    -- Change state first so the animation starts immediately on the click.
    if clicked and hot then
        value = not value
        S[key] = value
    end

    local target = value and 1 or 0
    local anim = A.toggles[key]

    if anim == nil then
        anim = target
    end

    -- Smooth switch movement and color blend.
    anim = lerp(anim, target, 0.20)

    if math.abs(anim - target) < 0.002 then
        anim = target
    end

    A.toggles[key] = anim

    local tx = x + w - 45
    local ty = y + 12
    local tw, th = 34, 18

    local track_col = mix_color(C.toggle_off, C.accent_dim, anim)
    local knob_col = mix_color(C.toggle_knob, C.white, anim)

    rounded_fill(tx, ty, tw, th, 9, track_col)

    -- Knob center moves continuously instead of snapping left/right.
    local knob_x = tx + 9 + (tw - 18) * anim
    circle_fill(knob_x, ty + 9, 7, knob_col)
end

