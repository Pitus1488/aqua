            (i + 0.5)
            / alpha_segments

        fill(
            sv_x + (i / alpha_segments) * sv_w,
            alpha_y,
            sv_w / alpha_segments + 1,
            alpha_h,
            {
                current[1],
                current[2],
                current[3],
                a,
            }
        )
    end

    local alpha_hot =
        hover(
            mx,
            my,
            sv_x,
            alpha_y,
            sv_w,
            alpha_h
        )

    if clicked and alpha_hot then
        A.world_color_picker_drag = "alpha"
    end

    if A.world_color_picker_drag == "alpha"
        and lmb
    then
        S[prefix .. "_alpha"] =
            math.floor(
                clamp(
                    (mx - sv_x) / sv_w,
                    0,
                    1
                )
                * 100
                + 0.5
            )
    end

    local alpha_x =
        sv_x
        + clamp(
            (tonumber(S[prefix .. "_alpha"]) or 100) / 100,
            0,
            1
        )
        * sv_w

    circle_fill(
        alpha_x,
        alpha_y + alpha_h * 0.5,
        9,
        { 0.08, 0.08, 0.10, 1 }
    )

    circle(
        alpha_x,
        alpha_y + alpha_h * 0.5,
        9,
        { 1, 1, 1, 1 },
        2
    )

    -- Bottom values.
