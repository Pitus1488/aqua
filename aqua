local function world_part_pos(inst, depth)
    if not inst then
        return nil
    end

    depth =
        tonumber(depth)
        or 0

    local pos = nil

    pcall(function()
        local class =
            world_inst_class(inst)

        if class == "Part"
            or class == "MeshPart"
            or class == "UnionOperation"
            or class == "BasePart"
        then
            pos = inst:get_position()
        end
    end)

    if pos
        and pos.X ~= nil
        and pos.Y ~= nil
        and pos.Z ~= nil
    then
        return pos
    end

    local main =
        world_find_child(
            inst,
            "Main"
        )

    if main
        and main ~= inst
    then
        pcall(function()
            pos = main:get_position()
        end)

        if pos
            and pos.X ~= nil
            and pos.Y ~= nil
            and pos.Z ~= nil
        then
            return pos
        end
    end

    if depth >= 2 then
        return nil
    end

    local children =
        world_children(inst)

    -- Prefer BaseParts on this level.
    for _, child in ipairs(children) do
        local class =
            world_inst_class(child)

        if class == "Part"
            or class == "MeshPart"
            or class == "UnionOperation"
            or class == "BasePart"
        then
            pcall(function()
                pos =
                    child:get_position()
            end)

            if pos
                and pos.X ~= nil
                and pos.Y ~= nil
                and pos.Z ~= nil
            then
                return pos
            end
        end
    end

    -- Then search nested Models one more level.
    for _, child in ipairs(children) do
        if world_inst_class(child) == "Model" then
            pos =
                world_part_pos(
                    child,
                    depth + 1
                )

            if pos then
                return pos
            end
        end
    end

    return nil
end

local function world_name_match(cfg, name)
    if not cfg
        or not name
    then
        return false
    end

    if cfg.names[name] then
        return true
    end

    local function norm(v)
        v =
            string.lower(
                tostring(v or "")
            )

        v =
            string.gsub(
                v,
                "%s+",
                ""
            )

        v =
            string.gsub(
                v,
                "_",
                ""
            )

        v =
            string.gsub(
                v,
                "%-",
                ""
            )

        v =
            string.gsub(
                v,
                "%(%s*clone%s*%)",
                ""
            )

        return v
    end

    local target = norm(name)

    for candidate, _ in pairs(cfg.names) do
        if target == norm(candidate) then
            return true
        end
    end

    return false
end

local function world_local_pos()
    local pos = nil

    pcall(function()
        if rbx
            and type(rbx.local_hrp) == "function"
        then
            local hrp =
                rbx.local_hrp()

            if hrp then
                pos =
                    hrp:get_position()
            end
        end
    end)

    if not pos
        and type(GetMyPosition) == "function"
    then
        pcall(function()
            pos =
                GetMyPosition()
        end)
    end

    return pos
end

local function world_distance_m(a, b)
    if not a or not b then
        return nil
    end

    local dx =
        a.X - b.X

    local dy =
        a.Y - b.Y

    local dz =
        a.Z - b.Z

    return
        math.sqrt(
            dx * dx
            + dy * dy
            + dz * dz
        )
        * 0.28
end

local function world_screen(pos)
    if not pos then
        return nil
    end

    local screen = nil

    pcall(function()
        if rbx
            and type(rbx.world_to_screen) == "function"
        then
            screen =
                rbx.world_to_screen(
                    pos
                )
        elseif aim
            and type(aim.world_to_screen) == "function"
        then
            screen =
                aim.world_to_screen(
                    pos
                )
        end
    end)

    if not screen
        or screen.X == nil
        or screen.Y == nil
        or screen.X == -1
    then
        return nil
    end

    if screen.visible == false then
        return nil
    end

    return screen
end

local function world_refresh_cache(force)
    if S.world_esp_enabled ~= true then
        return
    end

    local now = tick()

    if not force
        and now - WORLD_ESP.last_scan < 1.75
    then
        return
    end

    WORLD_ESP.last_scan = now

    local ws = nil

    pcall(function()
        if rbx
            and type(rbx.workspace) == "function"
        then
            ws =
                rbx.workspace()
        end
    end)

    if not ws then
        return
    end

    for _, folder_name in ipairs({
        "Nodes",
        "Plants",
    }) do
        local folder =
            world_find_child(
                ws,
                folder_name
            )

        WORLD_ESP.folders[folder_name] =
            folder
    end

    local entries = {}

    for _, cfg in ipairs(WORLD_RESOURCES) do
        local folder =
            WORLD_ESP.folders[
                cfg.folder
            ]

        if folder
            and world_inst_valid(folder)
        then
            for _, model in ipairs(
                world_children(folder)
            ) do
                local name =
                    world_inst_name(
                        model
                    )

                if name
                    and world_name_match(
                        cfg,
                        name
                    )
                then
                    entries[#entries + 1] = {
                        cfg = cfg,
                        inst = model,
                    }
                end
            end
        end
    end

    WORLD_ESP.entries = entries
end

local function world_url_encode(s)
    s =
        tostring(
            s or ""
        )

    return (
        string.gsub(
            s,
            "([^%w%-%_%.%~])",
            function(c)
                return
                    string.format(
                        "%%%02X",
                        string.byte(c)
                    )
            end
        )
    )
end

local function world_icon_ready(handle)
    if not handle
        or type(IsImageReady) ~= "function"
    then
        return false
    end

    local ok, ready =
        pcall(
            IsImageReady,
            handle
        )

    return
        ok
        and ready == true
end

local function world_load_direct_icon(cfg)
    if not cfg then
        return nil
    end

    local rec =
        WORLD_ESP.icons[
            cfg.id
        ]

    if not rec then
        rec = {
            index = 1,
            handle = nil,
            dead = false,
            retry = 0,
            source = nil,
            reported_ready = false,
            reported_failed = false,
        }

        WORLD_ESP.icons[cfg.id] =
            rec
    end

    if rec.dead then
        return nil
    end

    local now = tick()

    if rec.retry
        and now < rec.retry
        and not rec.handle
    then
        return nil
    end

    if not rec.handle then
        -- Preferred path for locally supplied icons.
        -- This is identical to the method that worked for noFilter (1).png.
        if cfg.local_icon_path
            and type(Drawing.LoadImageFromFile) == "function"
        then
            local ok, handle =
                pcall(
                    Drawing.LoadImageFromFile,
                    cfg.local_icon_path
                )

            if ok and handle then
                rec.handle = handle
                rec.source = "local"
                rec.reported_ready = false
                rec.reported_failed = false
                return nil
            end

            rec.retry = now + 1.0
            return nil
        end

        -- Other resources still use their direct URL list for now.
        local urls =
            cfg.direct_urls
            or {}

        local url =
            urls[
                rec.index or 1
            ]

        if not url then
            rec.dead = true
            return nil
        end

        if type(LoadImage) ~= "function" then
            rec.dead = true
            return nil
        end

        local ok, handle =
            pcall(
                LoadImage,
                url
            )

        if ok and handle then
            rec.handle = handle
            rec.source = "url"
            rec.retry = 0
            rec.reported_ready = false
            rec.reported_failed = false
        else
            rec.index =
                (rec.index or 1)
                + 1

            rec.retry =
                now + 1.0
        end

        return nil
    end

    if world_icon_ready(
        rec.handle
    ) then
        if rec.reported_ready ~= true then
            rec.reported_ready = true

            print(
                SYS
                .. "icon READY: "
                .. tostring(cfg.id)
                .. " ["
                .. tostring(rec.source or "?")
                .. "]"
            )
        end

        return rec.handle
    end

    if type(IsImageFailed) == "function" then
        local ok, failed =
            pcall(
                IsImageFailed,
                rec.handle
            )

        if ok and failed then
            if rec.reported_failed ~= true then
                rec.reported_failed = true

                warn(
                    SYS
                    .. "icon FAILED: "
                    .. tostring(cfg.id)
                    .. " ["
                    .. tostring(rec.source or "?")
                    .. "]"
                )
            end

            rec.handle = nil

            if cfg.local_icon_path then
                -- Keep retrying the exact local file path rather than
                -- silently switching Stone back to a web URL.
                rec.retry =
                    now + 2.0
            else
                rec.index =
                    (rec.index or 1)
                    + 1

                local urls =
                    cfg.direct_urls
                    or {}

                if not urls[rec.index] then
                    rec.dead = true
                else
                    rec.retry =
                        now + 0.35
                end
            end
        end
    end

    return nil
end

local function world_resolve_icon(cfg)
    -- The original user script's get_icon() was a LOCAL helper, therefore
    -- it cannot be called from this standalone menu script. Use the same
    -- direct URL approach here instead.
    return
        world_load_direct_icon(
            cfg
        )
end


local function world_draw_icon(
    cfg,
    x,
    y,
    size,
    a
)
    if type(DrawCircleFilled) ~= "function"
        or type(DrawCircle) ~= "function"
    then
        return
    end

    size =
        clamp(
            tonumber(size) or 18,
            10,
            48
        )

    local radius =
        size * 0.5
        + 3

    DrawCircleFilled(
        x,
        y,
        radius,
        0.02,
        0.02,
        0.03,
        0.90 * a
    )

    local border =
        world_color_from_prefix(
            "world_icon_border"
        )

    DrawCircle(
        x,
        y,
        radius,
        border[1],
        border[2],
        border[3],
        0.95
            * a
            * (border[4] or 1),
        1.4
    )

    local handle =
        world_resolve_icon(
            cfg
        )

    if handle
        and type(DrawImage) == "function"
    then
        DrawImage(
            handle,
            x - size * 0.5,
            y - size * 0.5,
            size,
            size,
            1,
            1,
            1,
            a,
            math.max(
                2,
                size * 0.16
            )
        )
    elseif type(DrawTextWithOutline) == "function" then
        DrawTextWithOutline(
            x,
            y - 6,
            cfg.short or "?",
            1,
            1,
            1,
            0.98 * a,
            0,
            0,
            0,
            0.98 * a
        )
    end
end

local function world_resource_color(cfg)
    if not cfg or not cfg.id then
        return { 1, 1, 1, 1 }
    end

    local prefix =
        world_color_prefix(
            cfg.id
        )

    return
        world_color_from_prefix(
            prefix
        )
end

local function world_draw_entry(
    entry,
    my_pos
)
    if not entry
        or not entry.cfg
        or S[entry.cfg.state] ~= true
        or not world_inst_valid(entry.inst)
    then
        return
    end

    local pos =
        world_part_pos(
            entry.inst,
            0
        )

    if not pos then
        return
    end

    local dist =
        world_distance_m(
            pos,
            my_pos
        )

    if not dist then
        return
    end

    local max_dist =
        clamp(
            tonumber(S.world_max_dist)
            or 500,
            25,
            2000
        )

    if dist > max_dist then
        return
    end

    local screen =
        world_screen(
            pos
        )

    if not screen then
        return
    end

    local fade = 1

    if S.world_fade_distance == true
        and max_dist > 0
    then
        fade =
            1
            - (
                dist
                / max_dist
            )
            * 0.78

        fade =
            clamp(
                fade,
                0.18,
                1
            )
    end

    local cfg =
        entry.cfg

    local col =
        world_resource_color(
            cfg
        )

    fade =
        fade
        * (col[4] or 1)

    local text_y =
        screen.Y

    if S.world_show_icons == true then
        local icon_size =
            clamp(
                tonumber(S.world_icon_size)
                or 18,
                10,
                48
            )

        world_draw_icon(
            cfg,
            screen.X,
            screen.Y - 18,
            icon_size,
            fade
        )

        text_y =
            screen.Y + 2
    end

    if S.world_show_names == true
        and type(DrawTextWithOutline) == "function"
    then
        DrawTextWithOutline(
            screen.X,
            text_y,
            cfg.label,
            col[1],
            col[2],
            col[3],
            fade,
            0,
            0,
            0,
            fade
        )
    end

    if S.world_show_distance == true
        and type(DrawTextWithOutline) == "function"
    then
        local dy =
            S.world_show_names == true
            and 14
            or 0

        DrawTextWithOutline(
            screen.X,
            text_y + dy,
            string.format(
                "%.0fm",
                dist
            ),
            col[1],
            col[2],
            col[3],
            fade,
            0,
            0,
            0,
            fade
        )
    end
end

local function world_esp_tick()
    if _G.FallenMenuReady ~= true
        or S.world_esp_enabled ~= true
    then
        return
    end

    world_refresh_cache(false)

    local my_pos =
        world_local_pos()

    if not my_pos then
        return
    end

    for _, entry in ipairs(
        WORLD_ESP.entries
    ) do
        world_draw_entry(
            entry,
            my_pos
        )
    end
end

hooks.on_render(function()
    local ok, err =
        pcall(
            world_esp_tick
        )

    if not ok then
        WORLD_ESP.last_error_at =
            WORLD_ESP.last_error_at
            or 0

        if tick() - WORLD_ESP.last_error_at > 2 then
            WORLD_ESP.last_error_at = tick()

            warn(
                SYS
                .. "Resource ESP: "
                .. tostring(err)
            )
        end
    end
end)



