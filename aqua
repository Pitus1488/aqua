local function mouse_pos()
    local a, b = nil, nil

    if utility then
        local fn = utility.get_mouse_pos or utility.GetMousePos
        if type(fn) == "function" then
            local ok
            ok, a, b = pcall(fn)
            if not ok then a, b = nil, nil end
        end
    end

    if a == nil and input then
        local fn = input.get_mouse_pos or input.get_mouse_position or input.GetMousePosition
        if type(fn) == "function" then
            local ok
            ok, a, b = pcall(fn)
            if not ok then a, b = nil, nil end
        end
    end

    if type(a) == "table" then
        return tonumber(a.X or a.x or a[1]) or 0,
               tonumber(a.Y or a.y or a[2]) or 0
    end

    if type(a) == "number" and type(b) == "number" then
        return a, b
    end

    if Windows and type(Windows.GetMousePos) == "function" then
        local ok, m = pcall(Windows.GetMousePos)
        if ok and m then
            return tonumber(m.X or m.x) or 0,
                   tonumber(m.Y or m.y) or 0
        end
    end

    return 0, 0
end

