local function slider_row(mx, my, clicked, lmb, x, y, w, label, key, minv, maxv, fmt)
    local h = 41
    local hot = row_hover(mx, my, x, y, w, h)

    text(
        x + 13,
        y + 14,
        label,
        FALLEN_HOVER_TEXT("slider:" .. tostring(key), hot, C.text)
    )

    local box_w = 52
    local box_x = x + w - box_w - 10
    local box_y = y + 8

    local track_x = x + 150
    local track_w = math.max(36, box_x - track_x - 12)
    local track_y = y + 20

    local current = tonumber(S[key]) or minv
    current = clamp(current, minv, maxv)

    if A.slider_target[key] == nil then
        A.slider_target[key] = current
    end

    if A.slider_visual[key] == nil then
        A.slider_visual[key] = current
    end

    if A.slider_knob[key] == nil then
        A.slider_knob[key] = 1
    end

    local value_hot = hover(mx, my, box_x, box_y, box_w, 25)

    -- Click the numeric box to type an exact value.
    if clicked and value_hot then
        A.active_slider = nil

        if A.numeric.active_key ~= key then
            numeric_start(key, minv, maxv, fmt)
        end
    end

    local editing = A.numeric.active_key == key

    local hit_x = track_x - 9
    local hit_y = y + 5
    local hit_w = track_w + 18
    local hit_h = 31

    local hot = hover(mx, my, hit_x, hit_y, hit_w, hit_h)

    if clicked and hot and not value_hot then
        numeric_stop(true)
        A.active_slider = key
    end

    local active = A.active_slider == key

    if active and lmb then
        local nt = clamp((mx - track_x) / track_w, 0, 1)
        A.slider_target[key] = minv + (maxv - minv) * nt
    end

    local target = clamp(A.slider_target[key] or current, minv, maxv)

    -- While typing, use the typed value directly; while dragging, smooth it.
    if editing then
        current = clamp(tonumber(S[key]) or current, minv, maxv)
    else
        local follow = active and 0.34 or 0.22
        current = lerp(current, target, follow)

        if math.abs(current - target) < (maxv - minv) * 0.0002 then
            current = target
        end

        S[key] = current
    end

    local visual = A.slider_visual[key]
    visual = lerp(visual, current, active and 0.52 or 0.30)

    if math.abs(visual - current) < (maxv - minv) * 0.00015 then
        visual = current
    end

    A.slider_visual[key] = visual

    local t = clamp((visual - minv) / (maxv - minv), 0, 1)

    rounded_fill(track_x, track_y, track_w, 4, 2, C.toggle_off)
    rounded_fill(track_x, track_y, track_w * t, 4, 2, C.accent)

    local wanted_scale = active and 1.34 or (hot and 1.12 or 1.00)
    local knob_scale = A.slider_knob[key]
    knob_scale = lerp(knob_scale, wanted_scale, 0.23)

    if math.abs(knob_scale - wanted_scale) < 0.002 then
        knob_scale = wanted_scale
    end

    A.slider_knob[key] = knob_scale

    local knob_x = track_x + track_w * t
    local knob_y = track_y + 2
    local knob_r = 6 * knob_scale

    if active then
        circle_fill(
            knob_x,
            knob_y,
            knob_r + 2.5,
            alpha(C.accent, 0.16)
        )
    end

    circle_fill(knob_x, knob_y, knob_r, C.white)

    rounded_fill(
        box_x,
        box_y,
        box_w,
        25,
        6,
        editing and { 0.115, 0.125, 0.165, 1 } or C.toggle_off
    )

    if editing then
        rounded_outline(
            box_x,
            box_y,
            box_w,
            25,
            6,
            alpha(C.accent, 0.55),
            1,
            { 0.115, 0.125, 0.165, 1 }
        )
    end

    local shown

    if editing then
        shown = A.numeric.buffer

        -- Tiny caret to make it obvious that this is an input field.
        if math.floor(tick() * 2) % 2 == 0 then
            shown = shown .. "|"
        end
    elseif fmt == "int" then
        shown = tostring(math.floor((tonumber(S[key]) or minv) + 0.5))
    else
        shown = string.format("%.2f", tonumber(S[key]) or minv)
    end

    centered_text(
        box_x + box_w * 0.5,
        y + 14,
        shown,
        FALLEN_HOVER_TEXT(
            "slider_value:" .. tostring(key),
            value_hot or active or editing,
            C.text
        )
    )
end

