local function world_color_prefix(id)
    return "world_color_" .. tostring(id)
end

local function world_color_from_prefix(prefix)
    local r, g, b =
        hsv_to_rgb(
            tonumber(S[prefix .. "_h"]) or 0,
            tonumber(S[prefix .. "_s"]) or 0,
            tonumber(S[prefix .. "_v"]) or 1
        )

    return {
        r,
        g,
        b,
        clamp(
            (tonumber(S[prefix .. "_alpha"]) or 100) / 100,
            0,
            1
        ),
    }
end

local function world_item_color(item)
    if not item or not item.id then
        return { 1, 1, 1, 1 }
    end

    return
        world_color_from_prefix(
            world_color_prefix(item.id)
        )
end

local function world_square_swatch(x, y, size, c)
    local cell = 4

    for yy = 0, math.ceil(size / cell) - 1 do
        for xx = 0, math.ceil(size / cell) - 1 do
            local light =
                ((xx + yy) % 2 == 0)

            local v =
                light and 0.52 or 0.30

            fill(
                x + xx * cell,
                y + yy * cell,
                math.min(cell, size - xx * cell),
                math.min(cell, size - yy * cell),
                { v, v, v, 1 }
            )
        end
    end

    fill(
        x,
        y,
        size,
        size,
        {
            c[1],
            c[2],
            c[3],
            c[4] or 1,
        }
    )

    line(x, y, x + size, y, C.border, 1)
    line(x, y + size, x + size, y + size, C.border, 1)
    line(x, y, x, y + size, C.border, 1)
    line(x + size, y, x + size, y + size, C.border, 1)
end


