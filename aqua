local function fap_name(obj)
    if not obj then return nil end

    local n = nil

    pcall(function()
        n = obj:get_name()
    end)

    if n and n ~= "" then
        return n
    end

    pcall(function()
        n = obj.Name
    end)

    if n and n ~= "" then
        return n
    end

    return nil
end

local function fap_class(obj)
    if not obj then return nil end

    local c = nil

    pcall(function()
        c = obj:get_class()
    end)

    if c and c ~= "" then
        return c
    end

    pcall(function()
        c = obj.ClassName
    end)

    return c
end

local function fap_find_stats(name)
    if not name then
        return nil, nil
    end

    if FAP_WEAPON_STATS[name] then
        return FAP_WEAPON_STATS[name], name
    end

    local lname = string.lower(tostring(name))

    for k, v in pairs(FAP_WEAPON_STATS) do
        local lk = string.lower(k)

        if string.find(lname, lk, 1, true)
            or string.find(lk, lname, 1, true)
        then
            return v, k
        end
    end

    return nil, nil
end

local function fap_possible_weapon(name, class)
    if not name or name == "" then
        return false
    end

    if FAP_BODY_NAMES[name] then
        return false
    end

    if class ~= "Model" and class ~= "Tool" then
        return false
    end

    if fap_find_stats(name) then
        return true
    end

    local lname = string.lower(tostring(name))

    local keys = {
        "ak", "m4", "m39", "aa12", "mp7", "pkm", "usp",
        "barret", "barrett", "shotgun", "smg", "p250",
        "python", "rpg", "sniper", "bow", "spear", "nail",
        "crossbow", "skorpion", "rifle", "launcher",
    }

    for _, key in ipairs(keys) do
        if string.find(lname, key, 1, true) then
            return true
        end
    end

    return false
end

local function fap_detect_weapon()
    local tool = nil

    pcall(function()
        if rbx and rbx.local_tool then
            tool = rbx.local_tool()
        end
    end)

    if tool then
        local n = fap_name(tool)
        local c = fap_class(tool)

        if fap_find_stats(n)
            or fap_possible_weapon(n, c)
        then
            return n
        end
    end

    local char = nil

    pcall(function()
        if rbx and rbx.local_character then
            char = rbx.local_character()
        end
    end)

    if not char then
        return nil
    end

    local children = nil

    pcall(function()
        children = char:get_children()
    end)

    if type(children) ~= "table" then
        return nil
    end

    for _, child in ipairs(children) do
        local n = fap_name(child)
        local c = fap_class(child)

        if fap_possible_weapon(n, c) then
            return n
        end
    end

    return nil
end

local function fap_refresh_weapon()
    if S.aim_auto_prediction ~= true then
        FAP.bullet_speed = 1000.0
        FAP.gravity = 35.0
        FAP.weapon = nil
        return
    end

    local now = tick()

    -- Avoid rescanning the local character every frame.
    if now - (FAP.last_weapon_scan or 0) < 0.25 then
        return
    end

    FAP.last_weapon_scan = now

    local weapon = fap_detect_weapon()
    FAP.weapon = weapon

    local stats = fap_find_stats(weapon)

    if stats then
        FAP.bullet_speed =
            tonumber(stats.speed)
            or 1000.0

        FAP.gravity =
            tonumber(stats.gravity)
            or 35.0
    else
        FAP.bullet_speed = 1000.0
        FAP.gravity = 35.0
    end

    -- Same explicit aliases/special cases used by the pasted script.
    if weapon == "Wooden Bow"
        or weapon == "Bow"
    then
        FAP.bullet_speed = 300
        FAP.gravity = 30

    elseif weapon == "Crossbow" then
        FAP.bullet_speed = 400
        FAP.gravity = 35

    elseif weapon == "Nail Gun"
        or weapon == "Nailgun"
    then
        FAP.bullet_speed = 350
        FAP.gravity = 20

    elseif weapon == "Military Barret"
        or weapon == "Military Barrett"
        or weapon == "Barret"
        or weapon == "Barrett"
    then
        FAP.bullet_speed = 1500
        FAP.gravity = 25

    elseif weapon == "Military M4A1"
        or weapon == "M4"
        or weapon == "M4A1"
    then
        FAP.bullet_speed = 950
        FAP.gravity = 18

    elseif weapon == "Bruno's M4A1"
        or weapon == "Brunos M4A1"
        or weapon == "Bruno M4A1"
    then
        FAP.bullet_speed = 1000
        FAP.gravity = 18

    elseif weapon == "Salvaged AK47"
        or weapon == "AK47"
        or weapon == "Salvaged AK4"
