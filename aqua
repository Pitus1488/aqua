    if active then
        rounded_fill(x, y, w, h, 7, C.selected)
    elseif hot then
        rounded_fill(x, y, w, h, 7, C.card_hover)
    end

    local col = active and C.text or (hot and C.text or C.text_dim)
    local ic = active and C.accent or C.text_dim

    local icon = ICONS[index]
    if icon then icon(x + 12, y + 10, ic) end
    text(x + 37, y + 10, TABS[index].label, col)

    if clicked and hot and S.tab ~= index then
        S.tab = index
        S.anim = 0

        A.aim_settings_open = false
        A.aim_part_dropdown_open = false
        A.fov_picker_open = false
        A.world_settings_open = false
        A.world_color_picker_open = false
        A.world_color_picker_drag = nil

        if aim_bind_cancel then
            aim_bind_cancel()
        end

        if numeric_stop then
            numeric_stop(true)
        end
    end
end

