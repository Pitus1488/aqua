local function cfg_sanitize_name(name)
    name =
        tostring(
            name or ""
        )

    name =
        string.gsub(
            name,
            "^%s+",
            ""
        )

    name =
        string.gsub(
            name,
            "%s+$",
            ""
        )

    name =
        string.gsub(
            name,
            "%s+",
            "_"
        )

    name =
        string.gsub(
            name,
            "[^%w_%-]",
            ""
        )

    if name == "" then
        return nil
    end

    if #name > 32 then
        name =
            string.sub(
                name,
                1,
                32
            )
    end

    return name
end

local function cfg_path(name)
    return
        CONFIG_PREFIX
        .. tostring(name)
        .. ".cfg"
end

local function cfg_escape(value)
    local s =
        tostring(
            value or ""
        )

    s =
        string.gsub(
            s,
            "%%",
            "%%25"
        )

    s =
        string.gsub(
            s,
            "|",
            "%%7C"
        )

    s =
        string.gsub(
            s,
            "\r",
            ""
        )

    s =
        string.gsub(
            s,
            "\n",
            "%%0A"
        )

    return s
end

local function cfg_unescape(value)
    local s =
        tostring(
            value or ""
        )

    s =
        string.gsub(
            s,
            "%%0A",
            "\n"
        )

    s =
        string.gsub(
            s,
            "%%7C",
            "|"
        )

    s =
        string.gsub(
            s,
            "%%25",
            "%%"
        )

    return s
end

local function cfg_split(line_txt)
    local out = {}
    local start_at = 1

    line_txt =
        tostring(
            line_txt or ""
        )

    while true do
        local p =
            string.find(
                line_txt,
                "|",
                start_at,
                true
            )

        if not p then
            out[#out + 1] =
                string.sub(
                    line_txt,
                    start_at
                )

            break
        end

        out[#out + 1] =
            string.sub(
                line_txt,
                start_at,
                p - 1
            )

        start_at = p + 1
    end

    return out
end

local function cfg_write_index()
    if type(write_file) ~= "function" then
