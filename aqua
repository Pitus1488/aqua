    if clicked and hot then
        S[key] = not S[key]
    end

    if A.world_color_picker_open
        and A.world_color_picker_key == world_color_prefix(item.id)
    then
        A.world_color_picker_anchor_x = swatch_x
        A.world_color_picker_anchor_y = swatch_y
    end
end


local function world_settings_step_anim()
    local now = tick()

    if A.world_settings_last_t == nil then
        A.world_settings_last_t = now
    end

    local dt =
        clamp(
            now - A.world_settings_last_t,
            0,
            0.05
        )

    A.world_settings_last_t = now

    local target =
        A.world_settings_open
        and 1
        or 0

    -- Slightly slower than Aimbot popup by request.
    local speed =
        target > (A.world_settings_anim or 0)
        and 9.0
        or 7.0

    A.world_settings_anim =
        exp_chase(
            A.world_settings_anim or 0,
            target,
            speed,
            dt
        )

    if target == 0
        and (A.world_settings_anim or 0) < 0.018
    then
        A.world_settings_anim = 0
    elseif target == 1
        and (A.world_settings_anim or 0) > 0.992
    then
        A.world_settings_anim = 1
    end

    return
        clamp(
            A.world_settings_anim or 0,
            0,
            1
        )
end

local function draw_world_color_picker(
    mx,
    my,
    clicked,
    lmb
)
    if not A.world_color_picker_open
        or not A.world_color_picker_key
    then
        A.world_color_picker_drag = nil
        return
    end

    local prefix =
        A.world_color_picker_key

    local anchor_x =
        A.world_color_picker_anchor_x or 0

    local anchor_y =
        A.world_color_picker_anchor_y or 0

    local pw = 264
    local ph = 324

    local px =
        snap(
            anchor_x
            - pw
            + 20
        )

    local py =
        snap(
            anchor_y
            + 25
        )

    rounded_fill(
        px - 5,
        py - 5,
        pw + 10,
        ph + 10,
        13,
        { 0, 0, 0, 0.20 }
    )

    rounded_fill(
        px,
        py,
        pw,
        ph,
        12,
        { 0.070, 0.073, 0.085, 1 }
    )

    rounded_outline(
        px,
        py,
        pw,
        ph,
        12,
        { 0.22, 0.23, 0.27, 0.95 },
        1,
        { 0.070, 0.073, 0.085, 1 }
    )

    local pad = 14
    local sv_x = px + pad
    local sv_y = py + pad
    local sv_w = pw - pad * 2
    local sv_h = 188

    local hue =
        tonumber(
            S[prefix .. "_h"]
        )
        or 0

    local cols = 24
    local rows = 20
    local cell_w = sv_w / cols
    local cell_h = sv_h / rows

    for yy = 0, rows - 1 do
        local v =
            1
            - (yy + 0.5) / rows

        for xx = 0, cols - 1 do
            local sat =
                (xx + 0.5) / cols

            local r, g, b =
                hsv_to_rgb(
                    hue,
                    sat,
                    v
                )

            fill(
                sv_x + xx * cell_w,
                sv_y + yy * cell_h,
                cell_w + 0.6,
