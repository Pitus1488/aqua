    if type(read_file) == "function" then
        local ok, result =
            pcall(
                read_file,
                CONFIG_INDEX
            )

        if ok then
            data = result
        end
    end

    local seen = {}

    if type(data) == "string"
        and data ~= ""
    then
        for line_txt in string.gmatch(
            data,
            "[^\r\n]+"
        ) do
            local name =
                cfg_sanitize_name(
                    line_txt
                )

            if name
                and not seen[name]
            then
