            end
        end
    end

    if Windows and Windows.IsKeyPressed then
        local ok, value =
            pcall(Windows.IsKeyPressed, 0x01)

        if ok then
            return value == true
        end
    end

    return false
end

local function rect(
    x,
    y,
    w,
    h,
    r,
    cr,
    cg,
    cb,
    ca
)
    if w <= 0 or h <= 0 then
        return
    end

    r =
        math.min(
            tonumber(r) or 0,
            w / 2,
            h / 2
        )

    if r <= 0 then
        Drawing.DrawBoxFilled(
            x,
            y,
            x + w,
            y + h,
            cr, cg, cb, ca
        )
        return
    end

    -- Fully opaque shapes can use the cheap overlap method because
    -- alpha does not accumulate into dark seams.
    if (ca or 1) >= 0.999 then
        Drawing.DrawBoxFilled(
            x + r,
            y,
            x + w - r,
            y + h,
            cr, cg, cb, ca
        )

        Drawing.DrawBoxFilled(
            x,
            y + r,
            x + w,
            y + h - r,
            cr, cg, cb, ca
        )

        Drawing.DrawCircleFilled(
            x + r,
            y + r,
            r,
            cr, cg, cb, ca
        )

        Drawing.DrawCircleFilled(
            x + w - r,
            y + r,
            r,
            cr, cg, cb, ca
        )

        Drawing.DrawCircleFilled(
            x + r,
            y + h - r,
            r,
            cr, cg, cb, ca
        )

        Drawing.DrawCircleFilled(
            x + w - r,
            y + h - r,
            r,
            cr, cg, cb, ca
        )

        return
    end

    -- Alpha-safe path.
    --
    -- The original loader made a rounded rectangle from two overlapping
    -- rectangles plus four overlapping circles. On translucent hover/glow
    -- elements those overlaps blended twice and became visible as dark/black
    -- patches where a straight edge turned into a rounded corner.
    --
    -- Here each pixel region is covered only once:
    --   center strip + side strips + four non-overlapping quarter-circle strips.
    local ri =
        math.max(
            1,
            math.floor(r + 0.5)
        )

    ri =
        math.min(
            ri,
            math.floor(w / 2),
            math.floor(h / 2)
        )

    if ri <= 0 then
        Drawing.DrawBoxFilled(
            x,
            y,
            x + w,
            y + h,
            cr, cg, cb, ca
        )
        return
    end

    Drawing.DrawBoxFilled(
        x + ri,
        y,
        x + w - ri,
        y + h,
        cr, cg, cb, ca
    )

    if h - ri * 2 > 0 then
        Drawing.DrawBoxFilled(
            x,
            y + ri,
            x + ri,
            y + h - ri,
            cr, cg, cb, ca
        )

        Drawing.DrawBoxFilled(
            x + w - ri,
            y + ri,
            x + w,
            y + h - ri,
            cr, cg, cb, ca
        )
    end

    local rr = ri * ri

    for row = 0, ri - 1 do
        local top_dy =
            (row + 0.5) - ri

        local top_dx =
            math.sqrt(
                math.max(
                    0,
                    rr - top_dy * top_dy
                )
            )

        local bottom_dy =
            row + 0.5

        local bottom_dx =
            math.sqrt(
                math.max(
                    0,
                    rr - bottom_dy * bottom_dy
                )
            )

        if top_dx > 0 then
            Drawing.DrawBoxFilled(
                x + ri - top_dx,
                y + row,
                x + ri,
                y + row + 1,
                cr, cg, cb, ca
            )

            Drawing.DrawBoxFilled(
                x + w - ri,
                y + row,
                x + w - ri + top_dx,
                y + row + 1,
                cr, cg, cb, ca
            )
        end

        if bottom_dx > 0 then
            local by =
                y + h - ri + row

            Drawing.DrawBoxFilled(
                x + ri - bottom_dx,
                by,
                x + ri,
                by + 1,
                cr, cg, cb, ca
            )

            Drawing.DrawBoxFilled(
                x + w - ri,
                by,
                x + w - ri + bottom_dx,
                by + 1,
                cr, cg, cb, ca
            )
        end
    end
end

