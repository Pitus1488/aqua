            3 * scale,
            0.40,
            0.82,
            0.45,
            pa
        )

        Drawing.DrawLine(
            popup_x + 13 * scale,
            popup_y + 55 * scale,
            popup_x + popup_w - 13 * scale,
            popup_y + 55 * scale,
            0.10,
            0.10,
            0.12,
