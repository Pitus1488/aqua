local function draw_image(
    image,
    x,
    y,
    w,
    h,
    alpha,
    rounding
)
    local target = image

    if target
        and Drawing.IsImageFailed
        and Drawing.IsImageFailed(target)
    then
        target = nil
    end

    if target
        and Drawing.IsImageReady(target) then

        Drawing.DrawImage(
            target,
            x,
            y,
            w,
            h,
            1,
            1,
