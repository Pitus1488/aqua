    local swatch_hot =
        hover(
            mx,
            my,
            swatch_x,
            swatch_y,
            swatch_s,
            swatch_s
        )


    local bg =
        mix_color(
            C.toggle_off,
            C.accent_dim,
            A.toggles[key]
        )

    rounded_fill(
        tx,
        ty,
        tw,
        th,
        th * 0.5,
        bg
    )

    local knob_x =
        lerp(
            tx + 9.5,
            tx + tw - 9.5,
            A.toggles[key]
        )

    circle_fill(
        knob_x,
        ty + th * 0.5,
        7,
        mix_color(
            C.toggle_knob,
            C.white,
            A.toggles[key]
        )
    )

    if clicked and swatch_hot then
        local prefix =
            world_color_prefix(
                item.id
            )

        FALLEN_COLOR_INPUT_STOP(true)

        if A.world_color_picker_open
            and A.world_color_picker_key == prefix
        then
            A.world_color_picker_open = false
            A.world_color_picker_drag = nil
        else
            A.world_color_picker_key = prefix
            A.world_color_picker_open = true
            A.world_color_picker_drag = nil
            A.fov_picker_open = false
            A.fov_picker_drag = nil
        end

        A.world_color_picker_anchor_x =
            FALLEN_UI_X(swatch_x)

        A.world_color_picker_anchor_y =
            FALLEN_UI_Y(swatch_y)

        A.world_color_picker_anchor_w =
            FALLEN_UI_LEN(swatch_s)

        A.world_color_picker_anchor_h =
            FALLEN_UI_LEN(swatch_s)

        if numeric_stop then
            numeric_stop(true)
        end

        return
    end

    if clicked and hot then
        S[key] = not S[key]
    end

end


local function world_settings_step_anim()
    local now = tick()

    if A.world_settings_last_t == nil then
        A.world_settings_last_t = now
    end

    local dt =
        clamp(
            now - A.world_settings_last_t,
            0,
            0.05
        )

    A.world_settings_last_t = now

    local target =
        A.world_settings_open
        and 1
        or 0

    -- Slightly slower than Aimbot popup by request.
    local speed =
        target > (A.world_settings_anim or 0)
        and 9.0
        or 7.0

    A.world_settings_anim =
        exp_chase(
            A.world_settings_anim or 0,
            target,
            speed,
            dt
        )

    if target == 0
        and (A.world_settings_anim or 0) < 0.018
    then
        A.world_settings_anim = 0
    elseif target == 1
        and (A.world_settings_anim or 0) > 0.992
    then
        A.world_settings_anim = 1
    end

    return
        clamp(
            A.world_settings_anim or 0,
            0,
            1
        )
end

local function draw_world_color_picker(mx, my, clicked, lmb)

    local now = tick()

    if A.world_color_picker_last_t == nil then
        A.world_color_picker_last_t = now
    end

    local dt =
        clamp(
            now - A.world_color_picker_last_t,
            0,
            0.05
        )

    A.world_color_picker_last_t = now

    local target =
        A.world_color_picker_open
        and 1
        or 0

    local speed =
        target > (A.world_color_picker_anim or 0)
        and 13.0
        or 10.0

    A.world_color_picker_anim =
        exp_chase(
            A.world_color_picker_anim or 0,
            target,
            speed,
            dt
        )

    if target == 0
        and (A.world_color_picker_anim or 0) < 0.012
    then
        A.world_color_picker_anim = 0
        A.world_color_picker_drag = nil
        FALLEN_COLOR_INPUT_STOP(true)
        return
    end

    if not A.world_color_picker_key then
        return
    end

    local anim =
        clamp(
            A.world_color_picker_anim or 0,
            0,
            1
        )

    local ease = smooth01(anim)

    local prefix =
        A.world_color_picker_key

    local anchor_x =
        tonumber(A.world_color_picker_anchor_x)
        or mx
        or 0

    local anchor_y =
        tonumber(A.world_color_picker_anchor_y)
        or my
        or 0

    local anchor_w =
        tonumber(A.world_color_picker_anchor_w)
        or 18

    local anchor_h =
        tonumber(A.world_color_picker_anchor_h)
        or 18

    local pw = 264
    local ph = 342

    local dims = nil
    pcall(function()
        dims = ScreenSize()
    end)

    local screen_w =
        dims
        and tonumber(dims.Width or dims.X)
        or 1920

    local screen_h =
        dims
        and tonumber(dims.Height or dims.Y)
        or 1080

    local gap = 12

    local left_px =
        anchor_x
        - pw
        - gap

    local right_px =
        anchor_x
        + anchor_w
        + gap

    local px = nil

    if left_px >= 8 then
        px = left_px
    elseif right_px + pw <= screen_w - 8 then
        px = right_px
    else
        px =
            clamp(
                anchor_x - pw * 0.5,
                8,
                math.max(8, screen_w - pw - 8)
            )
    end

    local py =
        clamp(
            anchor_y - 14,
            8,
            math.max(8, screen_h - ph - 8)
        )

    local attach_x =
        px < anchor_x
        and (px + pw)
        or px

    px =
        px
        + (anchor_x - attach_x)
        * (1 - ease)
        * 0.10

    py =
        py
        + (anchor_y - py)
        * (1 - ease)
        * 0.06

    px = snap(px)
    py = snap(py)

    local parent_transform =
        MENU_UI_TRANSFORM_ACTIVE

    local parent_alpha =
        MENU_RENDER_ALPHA

    MENU_UI_TRANSFORM_ACTIVE = false

    MENU_RENDER_ALPHA =
        parent_alpha
        * ease

    FALLEN_POPUP_GLOW(
        px,
        py,
        pw,
        ph,
        12,
        ease
    )

    rounded_fill(
        px,
        py,
        pw,
        ph,
        12,
        { 0.070, 0.073, 0.085, 1 }
    )

    text(
        px + 14,
        py + 10,
        "Color",
        C.text_dim
    )

    local pad = 14
    local sv_x = px + pad
    local sv_y = py + pad + 20
    local sv_w = pw - pad * 2
    local sv_h = 188

    local hue =
        tonumber(
            S[prefix .. "_h"]
        )
        or 0

    local smooth_w =
        math.max(
            1,
            math.floor(sv_w + 0.5)
        )

    local smooth_h =
        math.max(
            1,
            math.floor(sv_h + 0.5)
        )

    for xx = 0, smooth_w - 1 do
        local sat =
            smooth_w > 1
            and (xx / (smooth_w - 1))
            or 0

        local r, g, b =
            hsv_to_rgb(
                hue,
                sat,
                1
            )

        fill(
            sv_x + xx,
            sv_y,
            1,
            smooth_h,
            { r, g, b, 1 }
        )
    end

    for yy = 0, smooth_h - 1 do
        local black_alpha =
            smooth_h > 1
            and (yy / (smooth_h - 1))
            or 0

        if black_alpha > 0 then
            fill(
                sv_x,
                sv_y + yy,
                smooth_w,
                1,
                { 0, 0, 0, black_alpha }
            )
        end
    end

    local sv_hot =
        hover(
            mx,
            my,
            sv_x,
            sv_y,
            sv_w,
            sv_h
        )

    if clicked and sv_hot then
        FALLEN_COLOR_INPUT_STOP(true)
        A.world_color_picker_drag = "sv"
    end

    if A.world_color_picker_drag == "sv"
        and lmb
    then
        S[prefix .. "_s"] =
            clamp(
                (mx - FALLEN_UI_X(sv_x)) / FALLEN_UI_LEN(sv_w),
                0,
                1
            )

        S[prefix .. "_v"] =
            1
            - clamp(
                (my - FALLEN_UI_Y(sv_y)) / FALLEN_UI_LEN(sv_h),
                0,
                1
            )
    end

    local cursor_x =
        sv_x
        + clamp(
            tonumber(S[prefix .. "_s"]) or 0,
            0,
            1
        )
        * sv_w

    local cursor_y =
        sv_y
        + (
            1
            - clamp(
                tonumber(S[prefix .. "_v"]) or 1,
                0,
                1
            )
        )
        * sv_h

    circle_fill(
        cursor_x,
        cursor_y,
        7,
        { 0.05, 0.05, 0.06, 1 }
    )

    circle(
        cursor_x,
        cursor_y,
        7,
        { 1, 1, 1, 1 },
        2
    )

    local hue_y =
        sv_y
        + sv_h
        + 13

    local hue_h = 14

    local hue_width =
        math.max(
            1,
            math.floor(sv_w + 0.5)
        )

    for xx = 0, hue_width - 1 do
        local h0 =
            hue_width > 1
            and (xx / (hue_width - 1))
            or 0

        local r, g, b =
            hsv_to_rgb(
                h0,
                1,
                1
            )

        fill(
            sv_x + xx,
            hue_y,
            1,
            hue_h,
            { r, g, b, 1 }
        )
    end

    local hue_hot =
        hover(
            mx,
            my,
            sv_x,
            hue_y,
            sv_w,
            hue_h
        )

    if clicked and hue_hot then
        FALLEN_COLOR_INPUT_STOP(true)
        A.world_color_picker_drag = "hue"
    end

    if A.world_color_picker_drag == "hue"
        and lmb
    then
        S[prefix .. "_h"] =
            clamp(
                (mx - FALLEN_UI_X(sv_x)) / FALLEN_UI_LEN(sv_w),
                0,
                1
            )
    end

    local hue_x =
        sv_x
        + clamp(
            tonumber(S[prefix .. "_h"]) or 0,
            0,
            1
        )
        * sv_w

    rounded_fill(
        hue_x - 3,
        hue_y - 3,
        6,
        hue_h + 6,
        3,
        { 1, 1, 1, 1 }
    )

    rounded_fill(
        hue_x - 1,
        hue_y - 1,
        2,
        hue_h + 2,
        1,
        { 0.12, 0.12, 0.14, 1 }
    )

    -- Transparency slider restored.
    -- Alpha is ALSO mirrored in the last two HEX8 chars.
    local alpha_y =
        hue_y + 29

    local alpha_h = 14

    checker_strip(
        sv_x,
        alpha_y,
        sv_w,
        alpha_h
    )

    local current =
        world_color_from_prefix(
            prefix
        )

    local alpha_width =
        math.max(
            1,
            math.floor(sv_w + 0.5)
        )

    for xx = 0, alpha_width - 1 do
        local a =
            alpha_width > 1
            and (xx / (alpha_width - 1))
            or 0

        fill(
            sv_x + xx,
            alpha_y,
            1,
            alpha_h,
            {
                current[1],
                current[2],
                current[3],
                a,
            }
        )
    end

    local alpha_hot =
        hover(
            mx,
            my,
            sv_x,
            alpha_y,
            sv_w,
            alpha_h
        )

    if clicked and alpha_hot then
        FALLEN_COLOR_INPUT_STOP(true)
        A.world_color_picker_drag = "alpha"
    end

    if A.world_color_picker_drag == "alpha"
        and lmb
    then
        S[prefix .. "_alpha"] =
            math.floor(
                clamp(
                    (mx - FALLEN_UI_X(sv_x)) / FALLEN_UI_LEN(sv_w),
                    0,
                    1
                )
                * 100
                + 0.5
            )
    end

    local alpha_x =
        sv_x
        + clamp(
            (tonumber(S[prefix .. "_alpha"]) or 100) / 100,
            0,
            1
        )
        * sv_w

    circle_fill(
        alpha_x,
        alpha_y + alpha_h * 0.5,
        8,
        { 0.06, 0.06, 0.075, 1 }
    )

    circle(
        alpha_x,
        alpha_y + alpha_h * 0.5,
        8,
        { 1, 1, 1, 1 },
        2
    )

    -- No percentage text field; only HEX8 below the slider.
    local field_y =
        alpha_y + 29

    current =
        world_color_from_prefix(
            prefix
        )

    local hex =
        FALLEN_RGBA_HEX(
            current[1],
            current[2],
            current[3],
            current[4]
        )

    local hex_x = sv_x
    local hex_w = sv_w

    local hex_hot =
        hover(
            mx,
            my,
            hex_x,
            field_y,
            hex_w,
            31
        )

    local hex_focus =
        FALLEN_COLOR_INPUT_IS(
            "hex",
            prefix
        )

    rounded_fill(
        hex_x,
        field_y,
        hex_w,
        31,
        7,
        hex_focus
            and { 0.112, 0.118, 0.145, 1 }
            or (
                hex_hot
                and { 0.104, 0.108, 0.128, 1 }
                or { 0.095, 0.098, 0.112, 1 }
            )
    )

    if hex_focus then
        rounded_outline(
            hex_x,
            field_y,
            hex_w,
            31,
            7,
            alpha(C.accent, 0.72),
            1,
            { 0.112, 0.118, 0.145, 1 }
        )
    end

    text(
        hex_x + 10,
        field_y + 9,
        "HEX8",
        C.text_dim
    )

    local shown_hex =
        hex_focus
        and (
            "#"
            .. tostring(
                A.color_input.buffer
                or ""
            )
            .. (
                math.floor(tick() * 2) % 2 == 0
                and "|"
                or ""
            )
        )
        or hex

    text(
        hex_x + 56,
        field_y + 9,
        shown_hex,
        C.text
    )

    if clicked and hex_hot then
        A.world_color_picker_drag = nil

        FALLEN_COLOR_INPUT_START(
            "hex",
            prefix
        )
    end

    if not lmb then
        A.world_color_picker_drag = nil
    end

    local popup_hot =
        hover(
            mx,
            my,
            px,
            py,
            pw,
            ph
        )

    local swatch_hot =
        hover(
            mx,
            my,
            anchor_x,
            anchor_y,
            anchor_w,
            anchor_h
        )

    local interactive =
        A.world_color_picker_open
        and anim > 0.80

    if interactive
        and clicked
        and swatch_hot
    then
        A.world_color_picker_open = false
        A.world_color_picker_drag = nil
        FALLEN_COLOR_INPUT_STOP(true)
    elseif interactive
        and clicked
        and not popup_hot
        and not swatch_hot
    then
        A.world_color_picker_open = false
        A.world_color_picker_drag = nil
        FALLEN_COLOR_INPUT_STOP(true)
    end

    MENU_UI_TRANSFORM_ACTIVE =
        parent_transform

    MENU_RENDER_ALPHA =
        parent_alpha
end

local function draw_world_settings_popup(
    mx,
    my,
    clicked,
    lmb,
    dots_x,
    dots_y
)
    local raw =
        world_settings_step_anim()

    if raw <= 0.001
        and not A.world_settings_open
    then
        return
    end

    local parent_alpha =
        MENU_RENDER_ALPHA

    local fade =
        ease_out_cubic(raw)

    MENU_RENDER_ALPHA =
        parent_alpha
        * fade

    local anim =
        A.world_settings_open
        and ease_out_cubic(raw)
        or ease_in_out_cubic(raw)

    local pw = 306
    local ph = 291

    local base_px =
        dots_x
        - pw
        + 28

    local base_py =
        dots_y
        + 31

    local retract = 1 - anim

    local px =
        snap(
            base_px
            + retract * 14
        )

    local py =
        snap(
            base_py
            - retract * 34
        )

    local shell_h =
        math.max(
            31,
            ph
            - retract * 72
        )

    local interactive =
        raw > 0.96
        and A.world_settings_open

    local ui_clicked =
        clicked
        and interactive

    FALLEN_POPUP_GLOW(px, py, pw, shell_h, 11, 1)

    rounded_fill(
        px,
        py,
        pw,
        shell_h,
        11,
        { 0.062, 0.066, 0.077, 1 }
    )

    text(
        px + 13,
        py + 12,
        "Resource ESP settings",
        C.text
    )

    if shell_h > 39 then
        line(
            px + 12,
            py + 34,
            px + pw - 12,
            py + 34,
            C.divider,
            1
        )
    end

    if shell_h > 78 then
        slider_row(
            mx,
            my,
            ui_clicked,
            lmb,
            px + 8,
            py + 39,
            pw - 16,
            "Max Distance",
            "world_max_dist",
            25,
            2000,
            "int"
        )
    end

    if shell_h > 119 then
        line(
            px + 12,
            py + 79,
            px + pw - 12,
            py + 79,
            C.divider,
            1
        )

        toggle_row(
            mx,
            my,
            ui_clicked,
            px + 8,
            py + 80,
            pw - 16,
            "Show Names",
            "world_show_names",
            false
        )
    end

    if shell_h > 160 then
        line(
            px + 12,
            py + 120,
            px + pw - 12,
            py + 120,
            C.divider,
            1
        )

        toggle_row(
            mx,
            my,
            ui_clicked,
            px + 8,
            py + 121,
            pw - 16,
            "Show Distance",
            "world_show_distance",
            false
        )
    end

    if shell_h > 201 then
        line(
            px + 12,
            py + 161,
            px + pw - 12,
            py + 161,
            C.divider,
            1
        )

        local icons_row_x = px + 8
        local icons_row_y = py + 162
        local icons_row_w = pw - 16

        toggle_row(
            mx,
            my,
            ui_clicked,
            icons_row_x,
            icons_row_y,
            icons_row_w,
            "Show Icons",
            "world_show_icons",
            false
        )

        -- Editable icon-ring color.
        local border_prefix = "world_icon_border"

        local border_swatch_x =
            icons_row_x
            + icons_row_w
            - 82

        local border_swatch_y =
            icons_row_y + 11

        local border_color =
            world_color_from_prefix(
                border_prefix
            )

        world_square_swatch(
            border_swatch_x,
            border_swatch_y,
            18,
            border_color
        )

        local border_hot =
            hover(
                mx,
                my,
                border_swatch_x,
                border_swatch_y,
                18,
                18
            )

        if ui_clicked and border_hot then
            FALLEN_COLOR_INPUT_STOP(true)

            if A.world_color_picker_open
                and A.world_color_picker_key == border_prefix
            then
                A.world_color_picker_open = false
                A.world_color_picker_drag = nil
            else
                A.world_color_picker_key = border_prefix
                A.world_color_picker_open = true
                A.world_color_picker_drag = nil
                A.fov_picker_open = false
                A.fov_picker_drag = nil
            end

            A.world_color_picker_anchor_x =
                FALLEN_UI_X(border_swatch_x)

            A.world_color_picker_anchor_y =
                FALLEN_UI_Y(border_swatch_y)

            A.world_color_picker_anchor_w =
                FALLEN_UI_LEN(18)

            A.world_color_picker_anchor_h =
                FALLEN_UI_LEN(18)
        end
    end

    if shell_h > 242 then
        line(
            px + 12,
            py + 202,
            px + pw - 12,
            py + 202,
            C.divider,
            1
        )

        toggle_row(
            mx,
            my,
            ui_clicked,
            px + 8,
            py + 203,
            pw - 16,
            "Fade by Distance",
            "world_fade_distance",
            false
        )
    end

    if shell_h > 283 then
        line(
            px + 12,
            py + 243,
            px + pw - 12,
            py + 243,
            C.divider,
            1
        )

        slider_row(
            mx,
            my,
            ui_clicked,
            lmb,
            px + 8,
            py + 244,
            pw - 16,
            "Icon Size",
            "world_icon_size",
            10,
            48,
            "int"
        )
    end

    local popup_hot =
        hover(
            mx,
            my,
            px,
            py,
            pw,
            shell_h
        )

    local dots_hot =
        hover(
            mx,
            my,
            dots_x,
            dots_y,
            27,
            25
        )

    if interactive
        and clicked
        and not popup_hot
        and not dots_hot
        and not A.world_color_picker_open
    then
        A.world_settings_open = false
    end

    MENU_RENDER_ALPHA =
        parent_alpha
end

local function draw_visuals_page(
    mx,
    my,
    clicked,
    lmb,
    rmb_clicked,
    cx,
    cy,
    cw
)
    A.base_box_settings_open = false
    A.base_box_settings_anim = 0
    A.base_box_settings_id = nil

    section_title(
        cx,
        cy,
        "World ESP"
    )

    -- Master row
    card(
        cx,
        cy + 25,
        cw,
        49,
        11
    )

    local row_y = cy + 29

    local overlay_open =
        A.world_settings_open
        or (A.world_settings_anim or 0) > 0.02
        or A.world_color_picker_open == true
        or (A.world_color_picker_anim or 0) > 0.02
 

    local base_clicked =
        clicked
        and not overlay_open

    local dots_x =
        cx
        + cw
        - 79

    local dots_y =
        row_y
        + 8

    local dots_left_hot =
        hover(
            mx,
            my,
            dots_x,
            dots_y,
            27,
            25
        )

    toggle_row(
        mx,
        my,
        base_clicked
            and not dots_left_hot,
        cx,
        row_y,
        cw,
        "Resource ESP",
        "world_esp_enabled",
        true
    )

    local master_hot =
        hover(
            mx,
            my,
            cx,
            row_y,
            cw,
            41
        )

    if rmb_clicked
        and master_hot
    then
        A.world_settings_open =
            not A.world_settings_open

        if A.world_settings_open then
            A.aim_settings_open = false
            A.fov_picker_open = false
            A.world_color_picker_open = false
            A.world_color_picker_drag = nil
            A.base_box_settings_open = false

            if numeric_stop then
                numeric_stop(true)
            end
        end
    end

    local gap = 16
    local col_w =
        math.floor(
            (cw - gap) * 0.5
        )

    local left_x = cx
    local right_x = cx + col_w + gap
    local cards_y = cy + 94

    -- Ores / material harvestables
    section_title(
        left_x,
        cards_y,
        "Ores & Materials"
    )

    card(
        left_x,
        cards_y + 25,
        col_w,
        5 * 41 + 8,
        11
    )

    local left_items = {
        WORLD_UI_ITEMS[1],
        WORLD_UI_ITEMS[2],
        WORLD_UI_ITEMS[3],
        WORLD_UI_ITEMS[4],
        WORLD_UI_ITEMS[7],
    }

    for i, item in ipairs(left_items) do
        local iy =
            cards_y
            + 29
            + (i - 1) * 41

        resource_toggle_row(
            mx,
            my,
            base_clicked,
            left_x,
            iy,
            col_w,
            item
        )

        if i < #left_items then
            line(
                left_x + 12,
                iy + 40,
                left_x + col_w - 12,
                iy + 40,
                C.divider,
                1
            )
        end
    end

    -- Plants / berries
    section_title(
        right_x,
        cards_y,
        "Plants & Berries"
    )

    card(
        right_x,
        cards_y + 25,
        col_w,
        5 * 41 + 8,
        11
    )

    local right_items = {
        WORLD_UI_ITEMS[5],
        WORLD_UI_ITEMS[6],
        WORLD_UI_ITEMS[8],
        WORLD_UI_ITEMS[9],
        WORLD_UI_ITEMS[10],
    }

    for i, item in ipairs(right_items) do
        local iy =
            cards_y
            + 29
            + (i - 1) * 41

        resource_toggle_row(
            mx,
            my,
            base_clicked,
            right_x,
            iy,
            col_w,
            item
        )

        if i < #right_items then
            line(
                right_x + 12,
                iy + 40,
                right_x + col_w - 12,
                iy + 40,
                C.divider,
                1
            )
        end
    end

    -- Base / House: independent smooth scrolling on left and right.
    local base_section_y =
        cards_y
        + 25
        + 5 * 41
        + 25

    section_title(
        cx,
        base_section_y,
        "Base / House ESP"
    )

    local base_card_y =
        base_section_y + 25

    local base_visible_rows = 5
    local base_row_h = 41
    local base_card_h =
        base_visible_rows * base_row_h + 8

    local left_total = 11
    local right_total =
        math.max(
            0,
            #WORLD_BASE_ITEMS - left_total
        )

    card(
        left_x,
        base_card_y,
        col_w,
        base_card_h,
        11
    )

    card(
        right_x,
        base_card_y,
        col_w,
        base_card_h,
        11
    )

    local left_scroll =
        world_base_column_scroll_step(
            "left",
            mx,
            my,
            base_clicked,
            lmb,
            left_x,
            base_card_y,
            col_w,
            base_card_h,
            base_visible_rows,
            left_total
        )

    local right_scroll =
        world_base_column_scroll_step(
            "right",
            mx,
            my,
            base_clicked,
            lmb,
            right_x,
            base_card_y,
            col_w,
            base_card_h,
            base_visible_rows,
            right_total
        )

    local left_row_clicked =
        base_clicked
        and hover(
            mx,
            my,
            left_x,
            base_card_y,
            col_w,
            base_card_h
        )

    local right_row_clicked =
        base_clicked
        and hover(
            mx,
            my,
            right_x,
            base_card_y,
            col_w,
            base_card_h
        )

    for i = 1, left_total do
        local by =
            base_card_y
            + 4
            + ((i - 1) - left_scroll) * base_row_h

        local row_alpha =
            world_base_row_clip_alpha(
                by,
                base_card_y,
                base_card_h
            )

        if row_alpha > 0.008 then
            local cfg =
                WORLD_BASE_ITEMS[i]

            if cfg then
                local old_alpha =
                    MENU_RENDER_ALPHA

                MENU_RENDER_ALPHA =
                    old_alpha
                    * row_alpha

                world_base_compact_row(
                    mx,
                    my,
                    left_row_clicked
                        and row_alpha > 0.72,
                    left_x,
                    by,
                    col_w,
                    cfg
                )

                MENU_RENDER_ALPHA =
                    old_alpha
            end
        end
    end

    for i = 1, right_total do
        local by =
            base_card_y
            + 4
            + ((i - 1) - right_scroll) * base_row_h

        local row_alpha =
            world_base_row_clip_alpha(
                by,
                base_card_y,
                base_card_h
            )

        if row_alpha > 0.008 then
            local cfg =
                WORLD_BASE_ITEMS[
                    left_total + i
                ]

            if cfg then
                local old_alpha =
                    MENU_RENDER_ALPHA

                MENU_RENDER_ALPHA =
                    old_alpha
                    * row_alpha

                world_base_compact_row(
                    mx,
                    my,
                    right_row_clicked
                        and row_alpha > 0.72,
                    right_x,
                    by,
                    col_w,
                    cfg
                )

                MENU_RENDER_ALPHA =
                    old_alpha
            end
        end
    end

    -- Rows are virtually clipped by alpha fading before they reach
    -- the card edges. No opaque/translucent masks are drawn here, which
    -- keeps both Default and Glass styles clean.

    -- Render settings first, then the reusable color picker on top.
    draw_world_settings_popup(
        mx,
        my,
        clicked,
        lmb,
        dots_x,
        dots_y
    )

end


