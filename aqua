-- =========================================================
-- Live Roblox profile (bottom-left user card)
-- =========================================================
--
-- Username is read directly from the local Roblox player.
-- Avatar uses the official Roblox thumbnail endpoint:
--   local UserId -> thumbnails API JSON -> CDN image -> Drawing.LoadImage.
--
-- HTTP is started in the runtime thread API when available so the menu
-- itself does not freeze while the thumbnail request is running.
local PROFILE = {
    name = "Loading...",
    user_id = nil,
    avatar = nil,
    avatar_started = false,
    avatar_done = false,
    avatar_failed = false,
    worker_id = nil,
    last_scan = -100,
}

local function local_profile()
    local username = nil
    local user_id = nil

    -- Fast cached player API first.
    if players and type(players.get_local) == "function" then
        local ok, me = pcall(players.get_local)
        if ok and type(me) == "table" then
            username = me.name or me.display_name
            user_id = tonumber(me.user_id or me.userid or me.UserId)
        end
    end

    -- Full Instance API fallback / authoritative UserId.
    if rbx and type(rbx.local_player) == "function" then
        local ok, lp = pcall(rbx.local_player)
        if ok and lp then
            if not username then
                pcall(function()
                    username = lp:get_name()
                end)
            end

            if not user_id then
                pcall(function()
                    user_id = tonumber(lp:user_id())
                end)
            end
        end
    end

    if username ~= nil then
        username = tostring(username)
    end

    return username, user_id
end

local function fetch_avatar_once()
    if PROFILE.avatar_done or PROFILE.avatar_failed then
        return
    end

    local uid = tonumber(PROFILE.user_id)
    if not uid or uid <= 0 then
        return
    end

    if type(LoadImage) ~= "function"
        or type(DrawImage) ~= "function"
        or type(IsImageReady) ~= "function"
    then
        PROFILE.avatar_failed = true
        return
    end

    if not Http
        or type(Http.roblox_avatar_headshot_url) ~= "function"
        or type(Http.get) ~= "function"
        or not Json
        or type(Json.decode) ~= "function"
    then
        PROFILE.avatar_failed = true
        return
    end

    local ok, err = pcall(function()
        local api_url = Http.roblox_avatar_headshot_url(
            uid,
            "150x150",
            "Png",
            false
        )

        local http_ok, status, body = Http.get(
            api_url,
            { timeout_ms = 7000 }
        )

        if not http_ok or status ~= 200 then
            error("thumbnail HTTP " .. tostring(status))
        end

        local data, json_err = Json.decode(body)
        if not data then
            error(json_err or "thumbnail JSON decode failed")
        end

        local row = data.data and data.data[1]
        local image_url = row and row.imageUrl

        if type(image_url) ~= "string" or image_url == "" then
            error("thumbnail imageUrl missing")
        end

        PROFILE.avatar = LoadImage(image_url)

        if not PROFILE.avatar then
            error("Drawing.LoadImage failed")
        end

        PROFILE.avatar_done = true
    end)

    if not ok then
        PROFILE.avatar_failed = true
        warn(SYS .. "avatar: " .. tostring(err))
    end
end

local function start_avatar_worker()
    if PROFILE.avatar_started
        or PROFILE.avatar_done
        or PROFILE.avatar_failed
        or not PROFILE.user_id
    then
        return
    end

    PROFILE.avatar_started = true

    local create = thread and (thread.create or thread.Create)
    local stop = thread and (thread.stop or thread.Stop)

    if type(create) == "function" then
        local worker_id = nil

        local function worker()
            if not PROFILE.avatar_done and not PROFILE.avatar_failed then
                fetch_avatar_once()
            end

            if (PROFILE.avatar_done or PROFILE.avatar_failed)
                and worker_id
                and type(stop) == "function"
            then
                pcall(stop, worker_id)
            end
        end

        local ok, id = pcall(create, worker, 250)
        if ok and id then
            worker_id = id
            PROFILE.worker_id = id
            return
        end
    end

    -- Fallback for API builds without thread.*.
    -- This happens only once.
    fetch_avatar_once()
end

local function update_profile()
    local now = tick()

    if PROFILE.user_id and PROFILE.name ~= "Loading..." then
        start_avatar_worker()
        return
    end

    if now - PROFILE.last_scan < 0.75 then
        return
    end
    PROFILE.last_scan = now

    local username, uid = local_profile()

    if username and username ~= "" then
        PROFILE.name = username
    end

    if uid and uid > 0 then
        PROFILE.user_id = uid
    end

    start_avatar_worker()
end

-- =========================================================
-- Helpers
-- =========================================================

-- Multiplies every menu primitive while opening/closing.
local MENU_RENDER_ALPHA = 1

MENU_UI_TRANSFORM_ACTIVE = false
MENU_UI_SCALE = 1
MENU_UI_ORIGIN_X = 0
MENU_UI_ORIGIN_Y = 0

function FALLEN_UI_X(x)
    if not MENU_UI_TRANSFORM_ACTIVE then return x end
    return MENU_UI_ORIGIN_X + (x - MENU_UI_ORIGIN_X) * MENU_UI_SCALE
end

function FALLEN_UI_Y(y)
    if not MENU_UI_TRANSFORM_ACTIVE then return y end
    return MENU_UI_ORIGIN_Y + (y - MENU_UI_ORIGIN_Y) * MENU_UI_SCALE
end

function FALLEN_UI_LEN(v)
    if not MENU_UI_TRANSFORM_ACTIVE then return v end
    return v * MENU_UI_SCALE
end

local function clamp(v, lo, hi)
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

-- Shared pixel snap helper.
-- Must be declared BEFORE both menu and loader render callbacks.
local function snap(v)
    return math.floor((tonumber(v) or 0) + 0.5)
end

local function lerp(a, b, t)
    return a + (b - a) * t
end

local function ease_out_cubic(t)
    t = clamp(t, 0, 1)
    local u = 1 - t
    return 1 - u * u * u
end

local function ease_in_out_cubic(t)
    t = clamp(t, 0, 1)

    if t < 0.5 then
        return 4 * t * t * t
    end

    local u = -2 * t + 2
    return 1 - (u * u * u) / 2
end

local function exp_chase(current, target, speed, dt)
    dt = clamp(tonumber(dt) or 0, 0, 0.05)
    local a = 1 - math.exp(-(tonumber(speed) or 12) * dt)
    return current + (target - current) * a
end

local function alpha(c, a)
    return { c[1], c[2], c[3], (c[4] or 1) * (a or 1) }
end

local function mix_color(a, b, t)
    t = clamp(t or 0, 0, 1)
    return {
        lerp(a[1], b[1], t),
        lerp(a[2], b[2], t),
        lerp(a[3], b[3], t),
        lerp(a[4] or 1, b[4] or 1, t),
    }
end

local function fill(x, y, w, h, c)
    if w <= 0 or h <= 0 then return end

    local tx = FALLEN_UI_X(x)
    local ty = FALLEN_UI_Y(y)
    local tw = FALLEN_UI_LEN(w)
    local th = FALLEN_UI_LEN(h)

    DrawBoxFilled(
        tx, ty, tx + tw, ty + th,
        c[1], c[2], c[3],
        (c[4] or 1) * MENU_RENDER_ALPHA
    )
end

local function line(x1, y1, x2, y2, c, thickness)
    DrawLine(
        FALLEN_UI_X(x1),
        FALLEN_UI_Y(y1),
        FALLEN_UI_X(x2),
        FALLEN_UI_Y(y2),
        c[1], c[2], c[3],
        (c[4] or 1) * MENU_RENDER_ALPHA,
        FALLEN_UI_LEN(thickness or 1)
    )
end

local function circle_fill(cx, cy, r, c)
    DrawCircleFilled(
        FALLEN_UI_X(cx),
        FALLEN_UI_Y(cy),
        FALLEN_UI_LEN(r),
        c[1], c[2], c[3],
        (c[4] or 1) * MENU_RENDER_ALPHA
    )
end

local function circle(cx, cy, r, c, thickness)
    if type(DrawCircle) == "function" then
        DrawCircle(
            FALLEN_UI_X(cx),
            FALLEN_UI_Y(cy),
            FALLEN_UI_LEN(r),
            c[1], c[2], c[3],
            (c[4] or 1) * MENU_RENDER_ALPHA,
            FALLEN_UI_LEN(thickness or 1)
        )
    end
end

-- Fast rounded rectangle for fully opaque colors.
-- Overlap is harmless here because alpha=1.
local function rounded_fill_opaque(x, y, w, h, r, c)
    fill(x + r, y, w - r * 2, h, c)
    fill(x, y + r, w, h - r * 2, c)

    circle_fill(x + r,     y + r,     r, c)
    circle_fill(x + w - r, y + r,     r, c)
    circle_fill(x + r,     y + h - r, r, c)
    circle_fill(x + w - r, y + h - r, r, c)
end

-- Alpha-safe rounded rectangle.
--
-- The old version built transparent rounded rectangles from overlapping
-- rectangles + circles. Alpha blending made those overlaps visibly darker,
-- which caused the black "spots" around the curved transitions.
--
-- This version decomposes the shape into NON-OVERLAPPING pieces:
--   1) one center rectangle
--   2) two side rectangles
--   3) thin quarter-circle strips only in the four corner regions
--
-- That removes the dark seams while keeping genuine rounded corners.
local function rounded_fill_alpha_safe(x, y, w, h, r, c)
    fill(x + r, y, w - r * 2, h, c)

    local middle_h = h - r * 2
    if middle_h > 0 then
        fill(x,         y + r, r, middle_h, c)
        fill(x + w - r, y + r, r, middle_h, c)
    end

    local rr = r * r

    for i = 0, r - 1 do
        -- Sample at the center of the pixel strip for a smoother curve.
        local top_dy = (i + 0.5) - r
        local top_dx = math.sqrt(math.max(0, rr - top_dy * top_dy))

        local bot_dy = i + 0.5
        local bot_dx = math.sqrt(math.max(0, rr - bot_dy * bot_dy))

        if top_dx > 0 then
            -- Top-left / top-right quarter strips.
            fill(x + r - top_dx, y + i, top_dx, 1, c)
            fill(x + w - r,      y + i, top_dx, 1, c)
        end

        if bot_dx > 0 then
            local by = y + h - r + i

            -- Bottom-left / bottom-right quarter strips.
            fill(x + r - bot_dx, by, bot_dx, 1, c)
            fill(x + w - r,      by, bot_dx, 1, c)
        end
    end
end


-- Left-rounded / right-square panel with NO overlapping primitives.
local function rounded_left_fill(x, y, w, h, r, c)
    r = math.floor(clamp(r or 0, 0, math.min(w, h) * 0.5))

    if r <= 0 then
        fill(x, y, w, h, c)
        return
    end

    -- Everything from the tangent point to the right edge is one rectangle.
    fill(x + r, y, w - r, h, c)

    local middle_h = h - r * 2
    if middle_h > 0 then
        fill(x, y + r, r, middle_h, c)
    end

    local rr = r * r

    for i = 0, r - 1 do
        local top_dy = (i + 0.5) - r
        local top_dx = math.sqrt(math.max(0, rr - top_dy * top_dy))

        local bot_dy = i + 0.5
        local bot_dx = math.sqrt(math.max(0, rr - bot_dy * bot_dy))

        if top_dx > 0 then
            fill(x + r - top_dx, y + i, top_dx, 1, c)
        end

        if bot_dx > 0 then
            fill(x + r - bot_dx, y + h - r + i, bot_dx, 1, c)
        end
    end
end

-- Left-square / right-rounded panel with NO overlapping primitives.
local function rounded_right_fill(x, y, w, h, r, c)
    r = math.floor(clamp(r or 0, 0, math.min(w, h) * 0.5))

    if r <= 0 then
        fill(x, y, w, h, c)
        return
    end

    fill(x, y, w - r, h, c)

    local middle_h = h - r * 2
    if middle_h > 0 then
        fill(x + w - r, y + r, r, middle_h, c)
    end

    local rr = r * r

    for i = 0, r - 1 do
        local top_dy = (i + 0.5) - r
        local top_dx = math.sqrt(math.max(0, rr - top_dy * top_dy))

        local bot_dy = i + 0.5
        local bot_dx = math.sqrt(math.max(0, rr - bot_dy * bot_dy))

        if top_dx > 0 then
            fill(x + w - r, y + i, top_dx, 1, c)
        end

        if bot_dx > 0 then
            fill(x + w - r, y + h - r + i, bot_dx, 1, c)
        end
    end
end

local function smooth01(v)
    v = clamp(v, 0, 1)
    return v * v * (3 - 2 * v)
end

local function rounded_fill(x, y, w, h, r, c)
    r = math.floor(clamp(r or 0, 0, math.min(w, h) * 0.5))

    if r <= 0 then
        fill(x, y, w, h, c)
        return
    end

    -- CRITICAL:
    -- During menu open/close even a normally opaque color becomes
    -- translucent because fill()/circle_fill() multiply its alpha by
    -- MENU_RENDER_ALPHA. The previous code ignored that and chose the
    -- overlapping "opaque" path, which recreated black/dark patches.
    local effective_alpha =
        (c[4] or 1) * MENU_RENDER_ALPHA

    if effective_alpha < 0.999 then
        rounded_fill_alpha_safe(x, y, w, h, r, c)
    else
        rounded_fill_opaque(x, y, w, h, r, c)
    end
end

local function rounded_outline(x, y, w, h, r, c, thickness, inner_color)
    thickness = math.max(1, math.floor(thickness or 1))

    -- While the whole menu is translucent, draw a single alpha-safe
    -- surface only. Drawing "border fill -> inner fill" creates two
    -- transparent layers over the same pixels.
    if MENU_RENDER_ALPHA < 0.995 then
        rounded_fill(
            x,
            y,
            w,
            h,
            r,
            inner_color or C.content
        )
        return
    end

    rounded_fill(x, y, w, h, r, c)

    local iw = w - thickness * 2
    local ih = h - thickness * 2

    if iw > 0 and ih > 0 then
        rounded_fill(
            x + thickness,
            y + thickness,
            iw,
            ih,
            math.max(0, r - thickness),
            inner_color or C.content
        )
    end
end

local function text(x, y, s, c)
    DrawText(
        FALLEN_UI_X(x),
        FALLEN_UI_Y(y),
        tostring(s),
        c[1], c[2], c[3],
        (c[4] or 1) * MENU_RENDER_ALPHA
    )
end

local function centered_text(cx, y, s, c)
    if type(DrawTextWithOutline) == "function" then
        DrawTextWithOutline(
            FALLEN_UI_X(cx),
            FALLEN_UI_Y(y),
            tostring(s),
            c[1], c[2], c[3],
            (c[4] or 1) * MENU_RENDER_ALPHA,
            0, 0, 0, 0
        )
    else
        text(cx - #tostring(s) * 3.4, y, s, c)
    end
end

local function screen_size()
    if type(ScreenSize) == "function" then
        local ok, d = pcall(ScreenSize)
        if ok and d then
            local w = d.Width or d.X or d.x
            local h = d.Height or d.Y or d.y
            if type(w) == "number" and type(h) == "number" then
                return w, h
            end
        end
    end

    if rbx and type(rbx.screen_dim) == "function" then
        local ok, d = pcall(rbx.screen_dim)
        if ok and d then
            local w = d.Width or d.X or d.x
            local h = d.Height or d.Y or d.y
            if type(w) == "number" and type(h) == "number" then
                return w, h
            end
        end
    end

    return 1920, 1080
end

local function key_down(vk)
    if input then
        local fn = input.is_key_down or input.IsKeyDown
        if type(fn) == "function" then
            local ok, v = pcall(fn, vk)
            if ok then return v == true end
        end
    end

    if Windows and type(Windows.IsKeyPressed) == "function" then
        local ok, v = pcall(Windows.IsKeyPressed, vk)
        if ok then return v == true end
    end

    return false
end


local numeric_stop

local function aim_vk_name(vk)
    vk = tonumber(vk) or 0

    local names = {
        [0x00] = "None",
        [0x01] = "Mouse1",
        [0x02] = "Mouse2",
        [0x04] = "Mouse3",
        [0x05] = "Mouse4",
        [0x06] = "Mouse5",
        [0x08] = "Backspace",
        [0x09] = "Tab",
        [0x0D] = "Enter",
        [0x10] = "Shift",
        [0x11] = "Ctrl",
        [0x12] = "Alt",
        [0x1B] = "Esc",
        [0x20] = "Space",
        [0x25] = "Left",
        [0x26] = "Up",
        [0x27] = "Right",
        [0x28] = "Down",
        [0x2D] = "Insert",
        [0x2E] = "Delete",
        [0xA0] = "LShift",
        [0xA1] = "RShift",
        [0xA2] = "LCtrl",
        [0xA3] = "RCtrl",
        [0xA4] = "LAlt",
        [0xA5] = "RAlt",
    }

    if names[vk] then return names[vk] end
    if vk >= 0x30 and vk <= 0x39 then return string.char(vk) end
    if vk >= 0x41 and vk <= 0x5A then return string.char(vk) end
    if vk >= 0x70 and vk <= 0x7B then return "F" .. tostring(vk - 0x6F) end
    if vk <= 0 then return "None" end
    return "VK " .. tostring(vk)
end

local function aim_bind_cancel()
    A.aim_bind_listening = false
    A.aim_bind_wait_release = false
    A.aim_bind_prev = {}
end

local function aim_bind_start()
    if numeric_stop then numeric_stop(true) end
    A.aim_bind_listening = true
    A.aim_bind_wait_release = true
    A.aim_bind_prev = {}
end

local function aim_bind_poll()
    if not A.aim_bind_listening then return end

    -- Do not bind the click that opened the capture.
    if A.aim_bind_wait_release then
        if not key_down(VK_LBUTTON) and not key_down(VK_RBUTTON) then
            A.aim_bind_wait_release = false
            A.aim_bind_prev = {}
            for vk = 1, 255 do
                A.aim_bind_prev[vk] = key_down(vk)
            end
        end
        return
    end

    for vk = 1, 255 do
        local down = key_down(vk)
        local was = A.aim_bind_prev[vk] == true

        if down and not was then
            if vk == 0x1B then
                aim_bind_cancel()
                return
            end

            if vk == 0x08 or vk == 0x2E then
                S.aim_hold_key = 0
                aim_bind_cancel()
                return
            end

            S.aim_hold_key = vk
            aim_bind_cancel()
            return
        end

        A.aim_bind_prev[vk] = down
    end
end

numeric_stop = function(commit)
    local n = A.numeric

    if not n or not n.active_key then
        return
    end

    if commit then
        local value = tonumber(n.buffer)

        if value ~= nil then
            value = clamp(value, n.minv, n.maxv)

            if n.fmt == "int" then
                value = math.floor(value + 0.5)
            end

            S[n.active_key] = value
            A.slider_target[n.active_key] = value
            A.slider_visual[n.active_key] = value
        end
    elseif n.original ~= nil then
        S[n.active_key] = n.original
        A.slider_target[n.active_key] = n.original
        A.slider_visual[n.active_key] = n.original
    end

    n.active_key = nil
    n.buffer = ""
    n.replace_on_type = false
    n.original = nil
end

local function numeric_start(key, minv, maxv, fmt)
    local current = tonumber(S[key]) or minv

    A.numeric.active_key = key
    A.numeric.minv = minv
    A.numeric.maxv = maxv
    A.numeric.fmt = fmt or "int"
    A.numeric.original = current

    if A.numeric.fmt == "int" then
        A.numeric.buffer = tostring(math.floor(current + 0.5))
    else
        A.numeric.buffer = string.format("%.2f", current)
    end

    -- First typed character replaces the old value, like a selected input box.
    A.numeric.replace_on_type = true
    A.numeric.prev = {}
end

local function numeric_edge(vk)
    local down = key_down(vk)
    local prev = A.numeric.prev[vk] == true
    A.numeric.prev[vk] = down
    return down and not prev
end

local function numeric_apply_buffer()
    local n = A.numeric

    if not n.active_key then
        return
    end

    local value = tonumber(n.buffer)

    if value ~= nil then
        local clamped = clamp(value, n.minv, n.maxv)

        if n.fmt == "int" then
            clamped = math.floor(clamped + 0.5)
        end

        S[n.active_key] = clamped
        A.slider_target[n.active_key] = clamped
    end
end

local function numeric_poll()
    local n = A.numeric

    if not n.active_key then
        return
    end

    -- Enter = accept, Escape = restore previous value.
    if numeric_edge(0x0D) then
        numeric_stop(true)
        return
    end

    if numeric_edge(0x1B) then
        numeric_stop(false)
        return
    end

    -- Backspace.
    if numeric_edge(0x08) then
        n.replace_on_type = false
        n.buffer = string.sub(n.buffer, 1, math.max(0, #n.buffer - 1))
        numeric_apply_buffer()
        return
    end

    -- Digits: top row + numpad.
    for digit = 0, 9 do
        local vk_top = 0x30 + digit
        local vk_num = 0x60 + digit

        if numeric_edge(vk_top) or numeric_edge(vk_num) then
            if n.replace_on_type then
                n.buffer = ""
                n.replace_on_type = false
            end

            n.buffer = n.buffer .. tostring(digit)
            numeric_apply_buffer()
            return
        end
    end

    -- Decimal separator for float sliders.
    if n.fmt ~= "int" then
        if numeric_edge(0xBE) or numeric_edge(0x6E) then
            if n.replace_on_type then
                n.buffer = "0"
                n.replace_on_type = false
            end

            if not string.find(n.buffer, ".", 1, true) then
                n.buffer = n.buffer .. "."
            end

            return
        end
    end
end



