local function fetch_profile_avatar()
    if profile_avatar
        or profile_avatar_failed
        or not profile_user_id then

        return
    end

    if not Http
        or type(Http.roblox_avatar_headshot_url) ~= "function"
        or type(Http.get) ~= "function"
        or not Json
        or type(Json.decode) ~= "function"
        or type(Drawing.LoadImage) ~= "function" then

        profile_avatar_failed = true
        return
    end

    local ok, err =
        pcall(function()
            local meta_url =
                Http.roblox_avatar_headshot_url(
                    profile_user_id,
                    "150x150",
                    "Png",
                    false
                )

            local http_ok, status, body =
                Http.get(
                    meta_url,
                    { timeout_ms = 7000 }
                )

            if not http_ok
                or status ~= 200 then

                error(
                    "avatar HTTP "
                    .. tostring(status)
                )
            end

            local decoded, json_err =
                Json.decode(body)

            if not decoded then
                error(
                    json_err
                    or "avatar JSON decode failed"
                )
            end

            local row =
                decoded.data
                and decoded.data[1]

            local image_url =
                row
                and row.imageUrl

            if type(image_url) ~= "string"
                or image_url == "" then

                error(
                    "avatar imageUrl missing"
                )
            end

            profile_avatar =
                Drawing.LoadImage(
                    image_url
                )

            if not profile_avatar then
                error(
                    "avatar LoadImage failed"
                )
            end
        end)

    if not ok then
        profile_avatar_failed = true
        warn(
            "[Fallen loader] "
            .. tostring(err)
        )
    end
end

