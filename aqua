-- =========================================================
-- Fallen-lua Menu v4.5
-- Custom Lua API / Drawing.* implementation
--
-- Toggle: RIGHT SHIFT (VK_RSHIFT / 0xA1)
--
-- This version is rebuilt to match the supplied reference:
--   * genuinely rounded outer window
--   * rounded sidebar/content corners
--   * rounded cards, toggles, sliders, dropdowns
--   * alpha-safe rounded corners (no dark overlap spots)
--   * animated toggles + smooth draggable sliders
--   * Matcha-like layout, but branded "Fallen-lua"
-- =========================================================

local SYS = "[Fallen-lua] "

local D = nil
pcall(function() D = Drawing end)

local function draw_fn(name)
    local fn = nil
    if type(D) == "table" then fn = D[name] end
    if type(fn) ~= "function" then
        pcall(function() fn = _G[name] end)
    end
    return type(fn) == "function" and fn or nil
end

local DrawBoxFilled = draw_fn("DrawBoxFilled")
local DrawBox = draw_fn("DrawBox")
local DrawLine = draw_fn("DrawLine")
local DrawCircle = draw_fn("DrawCircle")
local DrawCircleFilled = draw_fn("DrawCircleFilled")
local DrawText = draw_fn("DrawText")
local DrawTextWithOutline = draw_fn("DrawTextWithOutline")
local LoadImage = draw_fn("LoadImage")
local IsImageReady = draw_fn("IsImageReady")
local IsImageFailed = draw_fn("IsImageFailed")
local DrawImage = draw_fn("DrawImage")

if type(DrawBoxFilled) ~= "function"
    or type(DrawBox) ~= "function"
    or type(DrawLine) ~= "function"
    or type(DrawCircleFilled) ~= "function"
    or type(DrawText) ~= "function"
then
    warn(SYS .. "Drawing API incomplete")
    warn(SYS .. "need DrawBoxFilled/DrawBox/DrawLine/DrawCircleFilled/DrawText")
    return
end

if type(hooks) ~= "table" or type(hooks.on_render) ~= "function" then
    warn(SYS .. "hooks.on_render is required")
    return
end

