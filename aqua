function FALLEN_HOVER_TEXT(key, hot, base_color)
    key = tostring(key or "text")

    if type(A.text_hover_anim) ~= "table" then
        A.text_hover_anim = {}
    end

    if type(A.text_hover_time) ~= "table" then
        A.text_hover_time = {}
    end

    local now = tick()
    local last = A.text_hover_time[key] or now
    local dt = clamp(now - last, 0, 0.10)
    A.text_hover_time[key] = now

    local v = tonumber(A.text_hover_anim[key]) or 0
    local step = dt / 2.0

    if hot then
        v = math.min(1, v + step)
    else
        v = math.max(0, v - step)
    end

    A.text_hover_anim[key] = v

    return mix_color(
        base_color or C.text,
        C.white,
        smooth01(v)
    )
end

local function toggle_row(mx, my, clicked, x, y, w, label, key, extra)
    local h = 41
    local hot = row_hover(mx, my, x, y, w, h)

    text(
        x + 13,
        y + 14,
        label,
        FALLEN_HOVER_TEXT("toggle:" .. tostring(key), hot, C.text)
    )

    if extra then
        local dots_x = x + w - 79
        local dots_y = y + 8
        local dots_w = 27
        local dots_h = 25
        local dots_hot = hover(mx, my, dots_x, dots_y, dots_w, dots_h)

        if dots_hot then
            rounded_fill(
                dots_x,
                dots_y,
                dots_w,
