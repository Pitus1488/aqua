-- Render
-- =========================================================

hooks.on_render(function()
    -- Wait until the loader has fully faded away before showing the menu.
    if _G.FallenMenuReady ~= true then
        return
    end

    local rshift = key_down(VK_RSHIFT)

    if rshift
        and not prev_rshift
        and not A.aim_bind_listening
        and not A.config_input_focus
        and not A.color_input.focus
    then
        S.visible = not S.visible

        if S.visible then
            -- Focus the Blueberry host window BEFORE the user starts
            -- interacting with the Drawing menu. Roblox therefore loses
            -- foreground focus and does not receive subsequent menu clicks.
            FALLEN_FOCUS_BLUEBERRY()
        else
            -- Give control back to the game as soon as the menu is closed.
            FALLEN_FOCUS_ROBLOX()
        end

        if not S.visible then
            numeric_stop(true)
            A.fov_picker_open = false
            A.fov_picker_drag = nil
            A.aim_settings_open = false
            A.aim_settings_anim = 0
            A.aim_part_dropdown_open = false
            A.aim_part_dropdown_anim = 0

            A.world_settings_open = false
            A.world_settings_anim = 0
            A.world_color_picker_open = false
            A.world_color_picker_drag = nil
            A.base_box_settings_open = false
            A.base_box_settings_anim = 0
            A.base_box_settings_id = nil
            A.base_scroll_dragging = false
            FALLEN_COLOR_INPUT_STOP(true)

            A.config_open = false
            A.config_anim = 0
            FALLEN_CONFIGS.input_focus(false)

            A.menu_settings_open = false
            A.menu_settings_anim = 0
            A.menu_scale_dropdown_open = false
            A.menu_scale_dropdown_anim = 0
            A.menu_type_dropdown_open = false
            A.menu_type_dropdown_anim = 0


            aim_bind_cancel()
        end
    end

    prev_rshift = rshift

    A.menu_open_target =
        S.visible and 1 or 0

    -- Smooth both opening and closing.
    A.menu_open =
        lerp(
            A.menu_open,
            A.menu_open_target,
            A.menu_open_target > A.menu_open and 0.18 or 0.22
        )

    if math.abs(A.menu_open - A.menu_open_target) < 0.002 then
        A.menu_open = A.menu_open_target
    end

    MENU_RENDER_ALPHA =
        clamp(A.menu_open, 0, 1)

    -- Once the closing animation is essentially invisible, stop drawing it.
    if A.menu_open <= 0.004
        and A.menu_open_target == 0
    then
        return
    end

    -- Poll focused UI input.
    numeric_poll()
    aim_bind_poll()
    FALLEN_CONFIGS.input_poll()
    FALLEN_COLOR_INPUT_POLL()

    local lmb = key_down(VK_LBUTTON)
    local clicked =
        lmb
        and not prev_lmb
        and MENU_RENDER_ALPHA > 0.88

    prev_lmb = lmb

    local rmb = key_down(VK_RBUTTON)

    local rmb_clicked =
        rmb
        and not prev_rmb
        and MENU_RENDER_ALPHA > 0.88

    prev_rmb = rmb

    if not lmb then
        A.active_slider = nil
        A.menu_dragging = false
    end

    local sw, sh = screen_size()
    local mx, my = mouse_pos()

    -- Menu Scale affects the entire UI, with gentler real growth.
    local label = S.menu_scale_percent
    local menu_scale = 1.00

    if tostring(label) == "Auto" then
        menu_scale =
            math.min(
                1.00,
                math.max(
                    0.82,
                    math.min((sw - 40) / 875, (sh - 40) / 700)
                )
            )
    else
        local p = tonumber(label) or 100

        if p == 125 then
            menu_scale = 1.06
        elseif p == 150 then
            menu_scale = 1.12
        elseif p == 175 then
            menu_scale = 1.18
        elseif p == 200 then
            menu_scale = 1.24
        else
            S.menu_scale_percent = 100
            menu_scale = 1.00
        end
    end

    WIN_W = 875
    WIN_H = 700

    if A.menu_cx == nil then
        A.menu_cx = sw * 0.5
        A.menu_cy = sh * 0.5
        A.menu_target_cx = A.menu_cx
        A.menu_target_cy = A.menu_cy
    end

    local wx = A.menu_cx - (WIN_W * menu_scale) * 0.5
    local wy = A.menu_cy - (WIN_H * menu_scale) * 0.5

    MENU_UI_SCALE = menu_scale
    MENU_UI_ORIGIN_X = wx
    MENU_UI_ORIGIN_Y = wy
    MENU_UI_TRANSFORM_ACTIVE = true

    -- Grab only the thin top edge so normal controls remain clickable.
    local drag_hot =
        hover(
            mx, my,
            wx + 10,
            wy + 2,
            WIN_W - 20,
            20
        )

    if clicked
        and drag_hot
        and not A.world_color_picker_open
        and (A.world_color_picker_anim or 0) <= 0.02
    then
        A.menu_dragging = true
        A.menu_drag_off_x = mx - A.menu_cx
        A.menu_drag_off_y = my - A.menu_cy
    end

    if A.menu_dragging and lmb then
        local half_w = WIN_W * menu_scale * 0.5
        local half_h = WIN_H * menu_scale * 0.5

        A.menu_target_cx =
            clamp(
                mx - A.menu_drag_off_x,
                half_w + 4,
                sw - half_w - 4
            )

        A.menu_target_cy =
            clamp(
                my - A.menu_drag_off_y,
                half_h + 4,
                sh - half_h - 4
            )
    end

    -- Smooth visual follow instead of teleporting to the mouse.
    A.menu_cx = lerp(A.menu_cx, A.menu_target_cx, A.menu_dragging and 0.32 or 0.20)
    A.menu_cy = lerp(A.menu_cy, A.menu_target_cy, A.menu_dragging and 0.32 or 0.20)

    wx = A.menu_cx - (WIN_W * menu_scale) * 0.5
    wy = A.menu_cy - (WIN_H * menu_scale) * 0.5

    MENU_UI_ORIGIN_X = wx
    MENU_UI_ORIGIN_Y = wy

    -- Whole window rises gently into place on open and drops on close.
    wy =
        wy
        + (1 - MENU_RENDER_ALPHA) * 16

    -- Snap the menu root to integer pixels so the Drawing text stays crisp.
    wx = snap(wx)
    wy = snap(wy)

    S.anim = clamp(lerp(S.anim or 0, 1, 0.16), 0, 1)

    FALLEN_APPLY_STYLE_COLOR()

    local menu_base_alpha = MENU_RENDER_ALPHA

    -- 35 line based glow frames around the entire menu.
    -- Every line uses the selected Glow Color directly.
    -- The alpha fades from the edge outward, like a real soft glow.
    local glow_rgb = {1, 1, 1, 1}
    pcall(function()
        glow_rgb = FALLEN_GLOW_COLOR()
    end)

    local glow_strength =
        clamp((tonumber(S.menu_glow_strength) or 100) / 100, 0, 2)

    for i = 0, 34 do
        local t =
            i / 34

        local falloff =
            1 - t

        local glow_alpha =
