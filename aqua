        thread
        and (
            thread.create
            or thread.Create
        )

    local stop =
        thread
        and (
            thread.stop
            or thread.Stop
        )

    if type(create) ~= "function" then
        -- Old API build fallback. This is a single request only.
        fetch_profile_avatar()
        return
    end

    local worker_id = nil

    local function worker()
        if not profile_avatar
            and not profile_avatar_failed then

            fetch_profile_avatar()
        end

        if (
            profile_avatar
            or profile_avatar_failed
        )
            and worker_id
            and type(stop) == "function"
        then
            pcall(
                stop,
                worker_id
            )
        end
    end

    local ok, id =
        pcall(
            create,
            worker,
            250
        )

    if ok and id then
        worker_id = id
        profile_worker_id = id
    else
        -- Thread startup failed: do the one request directly.
        fetch_profile_avatar()
    end
end

local function update_profile()
    refresh_local_profile()
    ensure_profile_avatar()
end

local function draw_avatar(
    x,
    y,
    size,
    alpha,
    fallback_scale
)
    if profile_avatar
        and Drawing.IsImageReady(
            profile_avatar
        )
    then
        Drawing.DrawImage(
            profile_avatar,
            x,
            y,
            size,
            size,
            1, 1, 1,
            alpha,
            size / 2
        )

        return
    end

    if profile_avatar
        and Drawing.IsImageFailed
        and Drawing.IsImageFailed(
            profile_avatar
        )
    then
        profile_avatar_failed = true
    end

    Drawing.DrawCircleFilled(
        x + size / 2,
        y + size / 2,
        size / 2,
        0.10,
        0.10,
        0.12,
        alpha
    )

    local first =
        string.sub(
            profile_name or "F",
            1,
            1
        )

    if first == "" then
        first = "F"
    end

    Drawing.DrawTextWithOutline(
        x + size / 2,
        y + size * (fallback_scale or 0.28),
        string.upper(first),
        0.84,
        0.84,
        0.87,
        alpha,
        0, 0, 0,
        alpha
    )
end

