    local full_h =
        #options
        * item_h

    local visible_h =
        full_h
        * ease_out_cubic(raw)

    local panel_h =
        math.max(
            2,
            visible_h
        )

    FALLEN_POPUP_GLOW(x, y, w, panel_h, 7, 0.95)

    rounded_fill(
        x,
        y,
        w,
        panel_h,
        7,
        { 0.050, 0.053, 0.062, 1 }
    )

    local panel_hot =
        hover(
            mx,
            my,
            x,
            y,
            w,
            panel_h
        )

    for i, value in ipairs(options) do
        local iy =
            y
            + (i - 1)
            * item_h

        local reveal =
            clamp(
                (
                    visible_h
                    - (i - 1) * item_h
                )
                / item_h,
                0,
                1
            )

        if reveal > 0.12 then
            local item_hot =
                reveal > 0.92
                and hover(
                    mx,
                    my,
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4
                )

            if item_hot then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4,
                    5,
                    { 0.105, 0.111, 0.132, 1 }
                )
            end

            local selected =
                (
                    value == "Auto"
                    and tostring(S.menu_scale_percent) == "Auto"
                )
                or (
                    type(value) == "number"
                    and tonumber(S.menu_scale_percent) == value
                )

            if selected then
                rounded_fill(
                    x + 4,
                    iy + 3,
                    3,
                    item_h - 6,
                    1,
                    C.accent
                )
            end

            text(
                x + 12,
                iy + 8,
                value == "Auto"
                    and "Auto"
                    or (tostring(value) .. "%"),
                FALLEN_HOVER_TEXT(
                    "menu_scale_option:" .. tostring(value),
                    item_hot,
                    selected and C.text or C.text_dim
                )
            )

            if clicked
                and item_hot
                and A.menu_scale_dropdown_open
            then
                S.menu_scale_percent = value
                A.menu_scale_dropdown_open = false
                return true
            end
        end
    end

    return panel_hot
end

function FALLEN_MENU_TYPE_DROPDOWN_STEP()
    local now = tick()

    if A.menu_type_dropdown_last_t == nil then
        A.menu_type_dropdown_last_t = now
    end

    local dt =
        clamp(
            now - A.menu_type_dropdown_last_t,
            0,
            0.05
        )

    A.menu_type_dropdown_last_t = now

    local target =
        A.menu_type_dropdown_open
        and 1
        or 0

    local speed =
        target > (A.menu_type_dropdown_anim or 0)
        and 14
        or 10

    A.menu_type_dropdown_anim =
        exp_chase(
            A.menu_type_dropdown_anim or 0,
            target,
            speed,
            dt
        )

    if target == 0
        and (A.menu_type_dropdown_anim or 0) < 0.015
    then
        A.menu_type_dropdown_anim = 0
    elseif target == 1
        and (A.menu_type_dropdown_anim or 0) > 0.992
    then
        A.menu_type_dropdown_anim = 1
    end

    return
        clamp(
            A.menu_type_dropdown_anim or 0,
            0,
            1
        )
end

function FALLEN_DRAW_MENU_TYPE_DROPDOWN(
    mx,
    my,
    clicked,
    x,
    y,
    w
)
    local raw =
        FALLEN_MENU_TYPE_DROPDOWN_STEP()

    if raw <= 0.002
        and not A.menu_type_dropdown_open
    then
        return false
    end

    local options = {
        "Default",
        "Glass",
        "Ass",
    }

    local item_h = 27
    local full_h =
        #options
        * item_h

    local visible_h =
        full_h
        * ease_out_cubic(raw)

    local panel_h =
        math.max(
            2,
            visible_h
        )

    FALLEN_POPUP_GLOW(
        x,
        y,
        w,
        panel_h,
        7,
        0.95
    )

    rounded_fill(
        x,
        y,
        w,
        panel_h,
        7,
        { 0.050, 0.053, 0.062, 0.96 }
    )

    local panel_hot =
        hover(
            mx,
            my,
            x,
            y,
            w,
            panel_h
        )

    for i, value in ipairs(options) do
        local iy =
            y
            + (i - 1)
            * item_h

        local reveal =
            clamp(
                (
                    visible_h
                    - (i - 1) * item_h
                )
                / item_h,
                0,
                1
            )

        if reveal > 0.12 then
            local item_hot =
                reveal > 0.92
                and hover(
                    mx,
                    my,
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4
                )

            if item_hot then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4,
                    5,
                    { 0.105, 0.111, 0.132, 1 }
                )
            end

            local selected =
                tostring(S.menu_type or "glass")
                :lower()
                == tostring(value):lower()

            if selected then
                rounded_fill(
                    x + 4,
                    iy + 3,
                    3,
                    item_h - 6,
                    1,
                    C.accent
                )
            end

            text(
                x + 12,
                iy + 8,
                value,
                FALLEN_HOVER_TEXT(
                    "menu_type_option:" .. tostring(value),
                    item_hot,
                    selected and C.text or C.text_dim
                )
            )

            if clicked
                and item_hot
                and A.menu_type_dropdown_open
            then
                S.menu_type =
                    tostring(value):lower()

                A.menu_type_dropdown_open = false
                return true
            end
        end
    end

    return panel_hot
end

