        return
    end

    if config_input_edge(0x08) then
        A.config_input_buffer =
            string.sub(
                A.config_input_buffer or "",
                1,
                math.max(
                    0,
                    #(A.config_input_buffer or "") - 1
                )
            )

        return
    end

    if #(A.config_input_buffer or "") >= 32 then
        return
    end

    local shift =
        key_down(0x10)
        or key_down(0xA0)
        or key_down(0xA1)

    -- A-Z
    for vk = 0x41, 0x5A do
        if config_input_edge(vk) then
            local ch =
                string.char(vk)

            if not shift then
                ch =
                    string.lower(
                        ch
                    )
            end

            A.config_input_buffer =
                (A.config_input_buffer or "")
                .. ch

            return
        end
    end

    -- 0-9
    for digit = 0, 9 do
        if config_input_edge(0x30 + digit)
            or config_input_edge(0x60 + digit)
        then
            A.config_input_buffer =
                (A.config_input_buffer or "")
                .. tostring(digit)

            return
        end
    end

    -- Space.
    if config_input_edge(0x20) then
        A.config_input_buffer =
            (A.config_input_buffer or "")
            .. " "

        return
    end

    -- Minus / underscore.
    if config_input_edge(0xBD)
        or config_input_edge(0x6D)
    then
        A.config_input_buffer =
            (A.config_input_buffer or "")
            .. (
                shift
                and "_"
                or "-"
            )

        return
    end
end

return {
    CONFIG = CONFIG,
    save = cfg_save,
    load = cfg_load,
    delete = cfg_delete,
    input_focus = config_input_focus,
    input_poll = config_input_poll,
    sanitize = cfg_sanitize_name,
}

end)()

local function mouse_pos()
    local a, b = nil, nil

    if utility then
        local fn = utility.get_mouse_pos or utility.GetMousePos
        if type(fn) == "function" then
            local ok
            ok, a, b = pcall(fn)
            if not ok then a, b = nil, nil end
        end
    end

    if a == nil and input then
        local fn = input.get_mouse_pos or input.get_mouse_position or input.GetMousePosition
        if type(fn) == "function" then
            local ok
            ok, a, b = pcall(fn)
            if not ok then a, b = nil, nil end
        end
    end

    if type(a) == "table" then
        a = tonumber(a.X or a.x or a[1]) or 0
        b = tonumber(a.Y or a.y or a[2]) or 0
    elseif type(a) == "number" and type(b) == "number" then
        -- already valid
    elseif Windows and type(Windows.GetMousePos) == "function" then
        local ok, m = pcall(Windows.GetMousePos)
        if ok and m then
            a = tonumber(m.X or m.x) or 0
            b = tonumber(m.Y or m.y) or 0
        end
    end

    a = tonumber(a) or 0
    b = tonumber(b) or 0

    return a, b
end

local function picker_scaled_pos(x, y, w, h)
    return
        FALLEN_UI_X(x),
        FALLEN_UI_Y(y),
        FALLEN_UI_LEN(w),
        FALLEN_UI_LEN(h)
end

local function hover(mx, my, x, y, w, h)
    -- Hitboxes use the same scaled screen rectangle as the renderer.
    local hx = FALLEN_UI_X(x)
    local hy = FALLEN_UI_Y(y)
    local hw = FALLEN_UI_LEN(w)
    local hh = FALLEN_UI_LEN(h)

    return mx >= hx
        and my >= hy
        and mx <= hx + hw
        and my <= hy + hh
end

