local function fetch_profile_avatar()
    if profile_avatar
        or profile_avatar_failed
        or not profile_user_id then

        return
    end

    if not Http
        or type(Http.roblox_avatar_headshot_url) ~= "function"
        or type(Http.get) ~= "function"
        or not Json
        or type(Json.decode) ~= "function"
        or type(Drawing.LoadImage) ~= "function" then

        profile_avatar_failed = true
        return
    end

    local ok, err =
        pcall(function()
            local meta_url =
                Http.roblox_avatar_headshot_url(
                    profile_user_id,
                    "150x150",
                    "Png",
                    false
                )

            local http_ok, status, body =
                Http.get(
                    meta_url,
                    { timeout_ms = 7000 }
                )

            if not http_ok
                or status ~= 200 then

                error(
                    "avatar HTTP "
                    .. tostring(status)
                )
            end

            local decoded, json_err =
                Json.decode(body)

            if not decoded then
                error(
                    json_err
                    or "avatar JSON decode failed"
                )
            end

            local row =
                decoded.data
                and decoded.data[1]

            local image_url =
                row
                and row.imageUrl

            if type(image_url) ~= "string"
                or image_url == "" then

                error(
                    "avatar imageUrl missing"
                )
            end

            profile_avatar =
                Drawing.LoadImage(
                    image_url
                )

            if not profile_avatar then
                error(
                    "avatar LoadImage failed"
                )
            end
        end)

    if not ok then
        profile_avatar_failed = true
        warn(
            "[Fallen loader] "
            .. tostring(err)
        )
    end
end

local function ensure_profile_avatar()
    if profile_avatar
        or profile_avatar_failed
        or profile_avatar_started
        or not profile_user_id then

        return
    end

    profile_avatar_started = true

    local create =
        thread
        and (
            thread.create
            or thread.Create
        )

    local stop =
        thread
        and (
            thread.stop
            or thread.Stop
        )

    if type(create) ~= "function" then
        -- Old API build fallback. This is a single request only.
        fetch_profile_avatar()
        return
    end

    local worker_id = nil

    local function worker()
        if not profile_avatar
            and not profile_avatar_failed then

            fetch_profile_avatar()
        end

        if (
            profile_avatar
            or profile_avatar_failed
        )
            and worker_id
            and type(stop) == "function"
        then
            pcall(
                stop,
                worker_id
            )
        end
    end

    local ok, id =
        pcall(
            create,
            worker,
            250
        )

    if ok and id then
        worker_id = id
        profile_worker_id = id
    else
        -- Thread startup failed: do the one request directly.
        fetch_profile_avatar()
    end
end

local function update_profile()
    refresh_local_profile()
    ensure_profile_avatar()
end

local function draw_avatar(
    x,
    y,
    size,
    alpha,
    fallback_scale
)
    if profile_avatar
        and Drawing.IsImageReady(
            profile_avatar
        )
    then
        Drawing.DrawImage(
            profile_avatar,
            x,
            y,
            size,
            size,
            1, 1, 1,
            alpha,
            size / 2
        )

        return
    end

    if profile_avatar
        and Drawing.IsImageFailed
        and Drawing.IsImageFailed(
            profile_avatar
        )
    then
        profile_avatar_failed = true
    end

    Drawing.DrawCircleFilled(
        x + size / 2,
        y + size / 2,
        size / 2,
        0.10,
        0.10,
        0.12,
        alpha
    )

    local first =
        string.sub(
            profile_name or "F",
            1,
            1
        )

    if first == "" then
        first = "F"
    end

    Drawing.DrawTextWithOutline(
        x + size / 2,
        y + size * (fallback_scale or 0.28),
        string.upper(first),
        0.84,
        0.84,
        0.87,
        alpha,
        0, 0, 0,
        alpha
    )
end

