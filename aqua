function FALLEN_DRAW_MENU_SCALE_DROPDOWN(
    mx,
    my,
    clicked,
    x,
    y,
    w
)
    local raw =
        FALLEN_MENU_SCALE_DROPDOWN_STEP()

    if raw <= 0.002
        and not A.menu_scale_dropdown_open
    then
