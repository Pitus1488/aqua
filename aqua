                1
            )
    end

    local cursor_x =
        sv_x
        + clamp(
            tonumber(S[prefix .. "_s"]) or 0,
            0,
            1
        )
        * sv_w

    local cursor_y =
        sv_y
        + (
            1
            - clamp(
                tonumber(S[prefix .. "_v"]) or 1,
                0,
                1
            )
        )
        * sv_h

    circle_fill(
        cursor_x,
        cursor_y,
        7,
        { 0.05, 0.05, 0.06, 1 }
    )

