local function hsv_to_rgb(h, s, v)
    h = (tonumber(h) or 0) % 1
    s = clamp(tonumber(s) or 0, 0, 1)
    v = clamp(tonumber(v) or 0, 0, 1)

    if s <= 0 then
        return v, v, v
    end

    local hh = h * 6
    local i = math.floor(hh)
    local f = hh - i

    local p = v * (1 - s)
    local q = v * (1 - s * f)
    local t = v * (1 - s * (1 - f))

    i = i % 6

    if i == 0 then return v, t, p end
    if i == 1 then return q, v, p end
    if i == 2 then return p, v, t end
    if i == 3 then return p, q, v end
    if i == 4 then return t, p, v end
    return v, p, q
end

local function fov_color()
    local r, g, b =
        hsv_to_rgb(
            S.aim_fov_h,
            S.aim_fov_s,
            S.aim_fov_v
        )

    return {
        r,
        g,
        b,
        clamp((tonumber(S.aim_fov_alpha) or 100) / 100, 0, 1),
    }
end

local function rgb_hex(r, g, b)
    local rr = math.floor(clamp(r, 0, 1) * 255 + 0.5)
    local gg = math.floor(clamp(g, 0, 1) * 255 + 0.5)
    local bb = math.floor(clamp(b, 0, 1) * 255 + 0.5)

    return string.format("#%02X%02X%02X", rr, gg, bb)
end

function FALLEN_RGBA_HEX(r, g, b, a)
    local rr = math.floor(clamp(r, 0, 1) * 255 + 0.5)
    local gg = math.floor(clamp(g, 0, 1) * 255 + 0.5)
    local bb = math.floor(clamp(b, 0, 1) * 255 + 0.5)
    local aa = math.floor(clamp(a or 1, 0, 1) * 255 + 0.5)

    return string.format("#%02X%02X%02X%02X", rr, gg, bb, aa)
end


function FALLEN_RGB_TO_HSV(r, g, b)
    r = clamp(tonumber(r) or 0, 0, 1)
    g = clamp(tonumber(g) or 0, 0, 1)
    b = clamp(tonumber(b) or 0, 0, 1)

    local maxv = math.max(r, g, b)
    local minv = math.min(r, g, b)
    local d = maxv - minv

    local h = 0
    local s =
        maxv <= 0
        and 0
        or (d / maxv)

    if d > 0 then
        if maxv == r then
            h = ((g - b) / d) % 6
        elseif maxv == g then
            h = ((b - r) / d) + 2
        else
            h = ((r - g) / d) + 4
        end

        h = h / 6
    end

    return h % 1, s, maxv
end

function FALLEN_COLOR_INPUT_IS(kind, prefix)
    local ci = A.color_input

    return
        ci.focus == true
        and ci.kind == kind
        and ci.prefix == prefix
end

function FALLEN_COLOR_INPUT_EDGE(vk)
    local ci = A.color_input
    local down = key_down(vk)
    local old = ci.prev[vk] == true
    ci.prev[vk] = down
    return down and not old
end

function FALLEN_COLOR_INPUT_APPLY()
    local ci = A.color_input

    if not ci.focus
        or not ci.prefix
        or not ci.kind
    then
        return
    end

    if ci.kind == "hex" then
        local raw =
            string.upper(
                tostring(ci.buffer or "")
            )

        raw =
            string.gsub(
                raw,
                "[^0-9A-F]",
                ""
            )

        -- New format: RRGGBBAA.
        -- The final AA byte controls transparency.
        if #raw ~= 8 then
            return
        end

        local rr =
            tonumber(
                string.sub(raw, 1, 2),
                16
            )

        local gg =
            tonumber(
                string.sub(raw, 3, 4),
                16
            )

        local bb =
            tonumber(
                string.sub(raw, 5, 6),
                16
            )

        local aa =
            tonumber(
                string.sub(raw, 7, 8),
                16
            )

        if rr == nil
            or gg == nil
            or bb == nil
            or aa == nil
        then
            return
        end

        local h, s, v =
            FALLEN_RGB_TO_HSV(
                rr / 255,
                gg / 255,
                bb / 255
            )

        S[ci.prefix .. "_h"] = h
        S[ci.prefix .. "_s"] = s
        S[ci.prefix .. "_v"] = v

        S[ci.prefix .. "_alpha"] =
            math.floor(
                clamp(
                    (aa / 255) * 100,
                    0,
                    100
                )
                + 0.5
            )
    end
end

function FALLEN_COLOR_INPUT_STOP(accept)
    local ci = A.color_input

    if ci.focus
        and accept == false
        and ci.prefix
    then
        S[ci.prefix .. "_h"] =
            ci.original_h

        S[ci.prefix .. "_s"] =
            ci.original_s

        S[ci.prefix .. "_v"] =
            ci.original_v

        S[ci.prefix .. "_alpha"] =
            ci.original_alpha
    elseif ci.focus
        and accept ~= false
    then
        FALLEN_COLOR_INPUT_APPLY()
    end

    ci.focus = false
    ci.kind = nil
    ci.prefix = nil
    ci.buffer = ""
    ci.replace_on_type = false
    ci.prev = {}
end

function FALLEN_COLOR_INPUT_START(kind, prefix)
    local ci = A.color_input

    FALLEN_COLOR_INPUT_STOP(true)

    ci.focus = true
    ci.kind = kind
    ci.prefix = prefix
    ci.replace_on_type = true
    ci.prev = {}

    ci.original_h =
        tonumber(
            S[prefix .. "_h"]
        )
        or 0

    ci.original_s =
        tonumber(
            S[prefix .. "_s"]
        )
        or 0

    ci.original_v =
        tonumber(
            S[prefix .. "_v"]
        )
        or 1

    ci.original_alpha =
        tonumber(
            S[prefix .. "_alpha"]
        )
        or 100

    local r, g, b =
        hsv_to_rgb(
            ci.original_h,
            ci.original_s,
            ci.original_v
        )

    ci.buffer =
        string.sub(
            FALLEN_RGBA_HEX(
                r,
                g,
                b,
                clamp(
                    ci.original_alpha / 100,
                    0,
                    1
                )
            ),
            2
        )

    numeric_stop(true)

    if A.config_input_focus
        and FALLEN_CONFIGS
        and FALLEN_CONFIGS.input_focus
    then
        FALLEN_CONFIGS.input_focus(false)
    end
end

function FALLEN_COLOR_INPUT_POLL()
    local ci = A.color_input

    if not ci.focus then
        return
    end

    if FALLEN_COLOR_INPUT_EDGE(0x0D) then
        FALLEN_COLOR_INPUT_STOP(true)
        return
    end

    if FALLEN_COLOR_INPUT_EDGE(0x1B) then
        FALLEN_COLOR_INPUT_STOP(false)
        return
    end

    -- Ctrl+V paste for the custom HEX8 field.
    -- This is a Drawing-based input, not a native Windows textbox,
    -- so clipboard paste has to be handled explicitly.
    local ctrl_down =
        key_down(0x11)
        or key_down(0xA2)
        or key_down(0xA3)

    if ci.kind == "hex"
        and ctrl_down
        and FALLEN_COLOR_INPUT_EDGE(0x56)
    then
        local clip = ""

        if type(get_clipboard) == "function" then
            local ok, value =
                pcall(
                    get_clipboard
                )

            if ok and value ~= nil then
                clip =
                    tostring(value)
            end
        end

        local raw =
            string.upper(
                clip
            )

        raw =
            string.gsub(
                raw,
                "[^0-9A-F]",
                ""
            )

        -- Accept both ordinary RGB HEX and the new RGBA HEX8 format.
        -- RGB input gets FF alpha automatically.
        if #raw == 6 then
            raw =
                raw
                .. "FF"
        elseif #raw > 8 then
            raw =
                string.sub(
                    raw,
                    1,
                    8
                )
        end

        if #raw == 8 then
            ci.buffer = raw
            ci.replace_on_type = false
            FALLEN_COLOR_INPUT_APPLY()
        end

        return
    end

    if FALLEN_COLOR_INPUT_EDGE(0x08) then
        ci.replace_on_type = false

        ci.buffer =
            string.sub(
                ci.buffer or "",
                1,
                math.max(
                    0,
                    #(ci.buffer or "") - 1
                )
            )

        FALLEN_COLOR_INPUT_APPLY()
        return
    end

    if ci.kind ~= "hex" then
        return
    end

    for digit = 0, 9 do
        if FALLEN_COLOR_INPUT_EDGE(0x30 + digit)
            or FALLEN_COLOR_INPUT_EDGE(0x60 + digit)
        then
            if ci.replace_on_type then
                ci.buffer = ""
                ci.replace_on_type = false
            end

            if #ci.buffer < 8 then
                ci.buffer =
                    ci.buffer
                    .. tostring(digit)
            end

            FALLEN_COLOR_INPUT_APPLY()
            return
        end
    end

    for vk = 0x41, 0x46 do
        if FALLEN_COLOR_INPUT_EDGE(vk) then
            if ci.replace_on_type then
                ci.buffer = ""
                ci.replace_on_type = false
            end

            if #ci.buffer < 8 then
                ci.buffer =
                    ci.buffer
                    .. string.char(vk)
            end

            FALLEN_COLOR_INPUT_APPLY()
            return
        end
    end
end

local function color_preview(x, y, w, h)
    local c = fov_color()
    local radius = math.floor(math.min(w, h) * 0.28)

    -- Dark rounded base so alpha still has a visible background,
    -- but without the hard checker-square look on the tiny swatch.
    rounded_fill(
        x,
