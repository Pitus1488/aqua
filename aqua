        cursor_x,
        cursor_y,
        7,
        { 1, 1, 1, 1 },
        2
    )

    -- Hue strip.
    local hue_y =
        sv_y
        + sv_h
        + 13

    local hue_h = 14
    local hue_segments = 48

    for i = 0, hue_segments - 1 do
        local h0 =
            i / hue_segments

        local r, g, b =
            hsv_to_rgb(
                h0,
                1,
                1
            )

        fill(
            sv_x + (i / hue_segments) * sv_w,
            hue_y,
            sv_w / hue_segments + 1,
            hue_h,
            { r, g, b, 1 }
