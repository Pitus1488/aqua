    if loading then
        local elapsed =
            now -
            loading_started

        local progress =
            clamp(
                elapsed / 3,
                0,
                1
            )

        local oa =
            clamp(
                elapsed * 6,
                0,
                1
            )

        -- Fully opaque launch screen: nothing from the old page bleeds through.
        rect(
            x,
            y,
            w,
            h,
            10 * scale,
            0.010,
            0.011,
            0.015,
            1.0
        )

        local cx =
            x +
            w / 2

        local cy =
            y +
            h / 2 -
            20 * scale

        local spin =
            now * 5

        for i = 1, 14 do
            local p =
                i / 14

            local angle =
                spin +
                p *
                math.pi *
                2

            local radius =
                20 * scale

            local px =
                cx +
                math.cos(angle) *
                radius

            local py =
                cy +
                math.sin(angle) *
                radius

            local glow =
                (
                    math.sin(
                        angle -
                        spin +
                        now * 4
                    ) +
                    1
                ) * 0.5

            Drawing.DrawCircleFilled(
                px,
                py,
                (
                    1.4 +
                    glow * 1.6
                ) * scale,
                0.92,
                0.57,
                0.15,
                oa *
                (
                    0.15 +
                    glow * 0.85
                )
            )
        end

        local dots =
            math.floor(
                elapsed * 3
            ) % 4

        local text =
            "Launching Fallen survival"

        for i = 1, dots do
            text =
                text .. "."
        end

        Drawing.DrawText(
            snap(cx - (#text * 3.2)),
            snap(cy + 38 * scale),
            text,
            0.79,
            0.79,
            0.82,
            oa
        )

        local bar_w =
            210 * scale

        local bar_h =
            5 * scale

        local bx =
            cx -
            bar_w / 2

        local by =
            cy +
            63 * scale

        rect(
            bx,
            by,
            bar_w,
            bar_h,
            2.5 * scale,
            0.075,
            0.075,
            0.085,
            oa
        )

        local fw =
            bar_w *
            progress

        if fw > 1 then
            rect(
                bx,
                by,
                fw,
                bar_h,
                2.5 * scale,
                0.90,
                0.55,
                0.14,
                oa
            )

            local shine =
                (
                    now * 95
                ) %
                bar_w

            if shine <= fw then
                Drawing.DrawCircleFilled(
                    bx + shine,
                    by + bar_h / 2,
                    3 * scale,
                    1.0,
                    0.75,
                    0.28,
                    oa * 0.75
                )
            end
        end

        Drawing.DrawTextWithOutline(
            cx,
            by + 14 * scale,
            tostring(
                math.floor(
                    progress * 100
                )
            ) .. "%",
            0.40,
            0.40,
            0.44,
            oa,
            0,
            0,
            0,
            oa
        )

        if progress >= 1 then
            loading = false
            profile_open = false
            _G.FallenSurvivalLoaded = true

            -- Close the loader first. The menu is enabled only after the
            -- loader's close animation reaches zero.
            open_target = 0
        end
    end
