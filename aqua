function FALLEN_DRAW_ROUNDED_GLOW_FRAME(
    x,
    y,
    w,
    h,
    radius,
    color,
    thickness
)
    radius =
        math.max(
            1,
            math.min(
                tonumber(radius) or 1,
                math.min(w, h) * 0.5
            )
        )

    thickness =
        thickness
        or 1

    -- Straight sides stop before the rounded corners.
    line(
        x + radius,
        y,
        x + w - radius,
        y,
        color,
        thickness
    )

    line(
        x + radius,
        y + h,
        x + w - radius,
        y + h,
        color,
        thickness
    )

    line(
        x,
        y + radius,
        x,
        y + h - radius,
        color,
        thickness
    )

    line(
        x + w,
        y + radius,
        x + w,
        y + h - radius,
        color,
        thickness
    )

    -- Rounded corners made from short line segments.
    -- Six segments per quarter is enough for a soft glow edge.
    local segments = 6

    local function arc(cx, cy, a0, a1)
        local px =
            cx
            + math.cos(a0)
            * radius

        local py =
            cy
            + math.sin(a0)
            * radius

        for n = 1, segments do
            local a =
                a0
                + (a1 - a0)
                * (n / segments)

            local nx =
                cx
                + math.cos(a)
                * radius

            local ny =
                cy
                + math.sin(a)
                * radius

            line(
                px,
                py,
                nx,
                ny,
                color,
                thickness
            )

            px = nx
            py = ny
        end
    end

    arc(
        x + radius,
        y + radius,
        math.pi,
        math.pi * 1.5
    )

    arc(
        x + w - radius,
        y + radius,
        math.pi * 1.5,
        math.pi * 2
    )

    arc(
        x + w - radius,
        y + h - radius,
        0,
        math.pi * 0.5
    )

    arc(
        x + radius,
        y + h - radius,
        math.pi * 0.5,
        math.pi
    )
end

function FALLEN_DRAW_GEAR(cx, cy, hot)
    -- Cleaner compact gear icon for the menu settings button.
    -- Built from overlapping circles so the silhouette stays smooth
    -- even at the tiny size used by the sidebar profile card.
    local col =
        hot
        and C.text
        or C.text_dim

    local hole_col =
        hot
        and { 0.10, 0.105, 0.125, 1.00 }
        or C.sidebar

    -- Outer gear body.
    circle_fill(
        cx,
        cy,
        4.9,
        col
    )

    -- Eight smooth teeth around the body.
    for i = 0, 7 do
        local a =
            (i / 8)
            * math.pi
            * 2

        circle_fill(
            cx
                + math.cos(a)
                * 6.1,
            cy
                + math.sin(a)
                * 6.1,
            2.15,
            col
        )
    end

    -- Clean center hole.
    circle_fill(
        cx,
        cy,
        2.35,
        hole_col
    )

    -- Light inner edge so the hole reads sharper.
    circle(
        cx,
        cy,
        2.85,
        alpha(col, 0.22),
        1
    )
end

