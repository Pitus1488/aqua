        h,
        radius,
        { 0.22, 0.23, 0.27, 1 }
    )

    rounded_fill(
        x,
        y,
        w,
        h,
        radius,
        { c[1], c[2], c[3], c[4] }
    )

    rounded_outline(
        x,
