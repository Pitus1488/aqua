local function cfg_serialize()
    local lines = {
        "FALLEN_LUA_CONFIG|1",
    }

    for _, key in ipairs(
        CONFIG_KEYS
    ) do
        local value =
            S[key]

        local kind =
            type(value)

        if kind == "boolean" then
            lines[#lines + 1] =
                "B|"
                .. cfg_escape(key)
                .. "|"
                .. (
                    value
                    and "1"
                    or "0"
                )

        elseif kind == "number" then
            lines[#lines + 1] =
                "N|"
                .. cfg_escape(key)
                .. "|"
                .. tostring(value)

        elseif kind == "string" then
            lines[#lines + 1] =
                "S|"
                .. cfg_escape(key)
                .. "|"
                .. cfg_escape(value)
        end
    end

    return
        table.concat(
            lines,
            "\n"
        )
end

