local function hsv_to_rgb(h, s, v)
    h = (tonumber(h) or 0) % 1
    s = clamp(tonumber(s) or 0, 0, 1)
    v = clamp(tonumber(v) or 0, 0, 1)

    if s <= 0 then
        return v, v, v
    end

    local hh = h * 6
    local i = math.floor(hh)
    local f = hh - i

    local p = v * (1 - s)
    local q = v * (1 - s * f)
    local t = v * (1 - s * (1 - f))

    i = i % 6

    if i == 0 then return v, t, p end
    if i == 1 then return q, v, p end
    if i == 2 then return p, v, t end
    if i == 3 then return p, q, v end
    if i == 4 then return t, p, v end
    return v, p, q
end

local function fov_color()
    local r, g, b =
        hsv_to_rgb(
            S.aim_fov_h,
            S.aim_fov_s,
            S.aim_fov_v
        )

    return {
        r,
        g,
        b,
        clamp((tonumber(S.aim_fov_alpha) or 100) / 100, 0, 1),
    }
end

local function rgb_hex(r, g, b)
    local rr = math.floor(clamp(r, 0, 1) * 255 + 0.5)
    local gg = math.floor(clamp(g, 0, 1) * 255 + 0.5)
    local bb = math.floor(clamp(b, 0, 1) * 255 + 0.5)

    return string.format("#%02X%02X%02X", rr, gg, bb)
end

local function color_preview(x, y, w, h)
    local c = fov_color()

    local cell = 4
    for yy = 0, math.ceil(h / cell) - 1 do
        for xx = 0, math.ceil(w / cell) - 1 do
            local light = ((xx + yy) % 2 == 0)
            local v = light and 0.52 or 0.30
            fill(
                x + xx * cell,
                y + yy * cell,
                math.min(cell, w - xx * cell),
                math.min(cell, h - yy * cell),
                { v, v, v, 1 }
            )
        end
    end

    -- Deliberately square: no rounded_fill here.
    fill(x, y, w, h, { c[1], c[2], c[3], c[4] })
    line(x, y, x + w, y, C.border, 1)
    line(x, y + h, x + w, y + h, C.border, 1)
    line(x, y, x, y + h, C.border, 1)
    line(x + w, y, x + w, y + h, C.border, 1)
end

local function checker_strip(x, y, w, h)
    local cell = 7
    local cols = math.ceil(w / cell)
    local rows = math.ceil(h / cell)

    for yy = 0, rows - 1 do
        for xx = 0, cols - 1 do
            local light = ((xx + yy) % 2 == 0)
            local v = light and 0.64 or 0.38

            fill(
                x + xx * cell,
                y + yy * cell,
                math.min(cell, w - xx * cell),
                math.min(cell, h - yy * cell),
                { v, v, v, 1 }
            )
        end
    end
end

local function draw_fov_color_picker(mx, my, clicked, lmb, anchor_x, anchor_y)
    if not A.fov_picker_open then
        A.fov_picker_drag = nil
        return
    end

    local pw = 264
    local ph = 324
    local px = anchor_x - pw + 34
    local py = anchor_y + 27

    -- Popup
    rounded_fill(px - 5, py - 5, pw + 10, ph + 10, 13, { 0, 0, 0, 0.20 })
    rounded_fill(px, py, pw, ph, 12, { 0.070, 0.073, 0.085, 1 })
    rounded_outline(
        px, py, pw, ph, 12,
        { 0.22, 0.23, 0.27, 0.95 },
        1,
        { 0.070, 0.073, 0.085, 1 }
    )

    local pad = 14
    local sv_x = px + pad
    local sv_y = py + pad
    local sv_w = pw - pad * 2
    local sv_h = 188

    -- Saturation/value square. 24x20 cells keeps it smooth without making
    -- the custom queued renderer unnecessarily heavy.
    local cols = 24
    local rows = 20
    local cw = sv_w / cols
    local ch = sv_h / rows
    local hue = tonumber(S.aim_fov_h) or 0

    for yy = 0, rows - 1 do
        local v = 1 - (yy + 0.5) / rows

        for xx = 0, cols - 1 do
            local s = (xx + 0.5) / cols
            local r, g, b = hsv_to_rgb(hue, s, v)

            fill(
                sv_x + xx * cw,
                sv_y + yy * ch,
                cw + 0.6,
                ch + 0.6,
                { r, g, b, 1 }
            )
        end
    end

    local sv_hot = hover(mx, my, sv_x, sv_y, sv_w, sv_h)

    if clicked and sv_hot then
        A.fov_picker_drag = "sv"
    end

    if A.fov_picker_drag == "sv" and lmb then
        S.aim_fov_s = clamp((mx - sv_x) / sv_w, 0, 1)
        S.aim_fov_v = 1 - clamp((my - sv_y) / sv_h, 0, 1)
    end

    local cursor_x = sv_x + clamp(tonumber(S.aim_fov_s) or 0, 0, 1) * sv_w
    local cursor_y = sv_y + (1 - clamp(tonumber(S.aim_fov_v) or 1, 0, 1)) * sv_h

    circle_fill(cursor_x, cursor_y, 7, { 0.05, 0.05, 0.06, 1 })
    circle(cursor_x, cursor_y, 7, { 1, 1, 1, 1 }, 2)

    -- Hue strip.
    local hue_y = sv_y + sv_h + 13
    local hue_h = 14
    local hue_segments = 48

    for i = 0, hue_segments - 1 do
        local h0 = i / hue_segments
        local r, g, b = hsv_to_rgb(h0, 1, 1)

        fill(
            sv_x + (i / hue_segments) * sv_w,
            hue_y,
            sv_w / hue_segments + 1,
            hue_h,
            { r, g, b, 1 }
        )
    end

    local hue_hot = hover(mx, my, sv_x, hue_y, sv_w, hue_h)

    if clicked and hue_hot then
        A.fov_picker_drag = "hue"
    end

    if A.fov_picker_drag == "hue" and lmb then
        S.aim_fov_h = clamp((mx - sv_x) / sv_w, 0, 1)
    end

    local hue_x = sv_x + clamp(tonumber(S.aim_fov_h) or 0, 0, 1) * sv_w

    rounded_fill(hue_x - 3, hue_y - 3, 6, hue_h + 6, 3, { 1, 1, 1, 1 })
    rounded_fill(hue_x - 1, hue_y - 1, 2, hue_h + 2, 1, { 0.12, 0.12, 0.14, 1 })

    -- Alpha strip under hue.
    local alpha_y = hue_y + 29
    local alpha_h = 14
    checker_strip(sv_x, alpha_y, sv_w, alpha_h)

    local col = fov_color()
    local alpha_segments = 40

    for i = 0, alpha_segments - 1 do
        local a = (i + 0.5) / alpha_segments

        fill(
            sv_x + (i / alpha_segments) * sv_w,
            alpha_y,
            sv_w / alpha_segments + 1,
            alpha_h,
            { col[1], col[2], col[3], a }
        )
    end

    local alpha_hot = hover(mx, my, sv_x, alpha_y, sv_w, alpha_h)

    if clicked and alpha_hot then
        A.fov_picker_drag = "alpha"
    end

    if A.fov_picker_drag == "alpha" and lmb then
        S.aim_fov_alpha =
            math.floor(
                clamp((mx - sv_x) / sv_w, 0, 1) * 100
                + 0.5
            )
    end

    local alpha_x =
        sv_x
        + clamp((tonumber(S.aim_fov_alpha) or 100) / 100, 0, 1)
        * sv_w

    circle_fill(alpha_x, alpha_y + alpha_h * 0.5, 9, { 0.08, 0.08, 0.10, 1 })
    circle(alpha_x, alpha_y + alpha_h * 0.5, 9, { 1, 1, 1, 1 }, 2)

    -- Bottom fields: HEX + alpha percentage.
    local field_y = alpha_y + 29
    local c = fov_color()
    local hex = rgb_hex(c[1], c[2], c[3])

    rounded_fill(sv_x, field_y, 154, 31, 7, { 0.095, 0.098, 0.112, 1 })
    text(sv_x + 10, field_y + 9, "HEX", C.text_dim)
    text(sv_x + 47, field_y + 9, hex, C.text)

    rounded_fill(sv_x + 164, field_y, sv_w - 164, 31, 7, { 0.095, 0.098, 0.112, 1 })
    centered_text(
        sv_x + 164 + (sv_w - 164) * 0.5,
        field_y + 9,
        tostring(math.floor(tonumber(S.aim_fov_alpha) or 100)) .. "%",
        C.text
    )

    if not lmb then
        A.fov_picker_drag = nil
    end

    -- Click outside popup and outside the swatch closes it.
    local popup_hot = hover(mx, my, px, py, pw, ph)
    local swatch_hot = hover(mx, my, anchor_x, anchor_y, 36, 18)

    if clicked and not popup_hot and not swatch_hot then
        A.fov_picker_open = false
        A.fov_picker_drag = nil
    end
end

local AIM_PARTS = {
    "Head",
    "Torso",
    "UpperTorso",
    "LowerTorso",
    "HumanoidRootPart",
}

local function aim_settings_step_anim()
    local now = tick()

    if A.aim_settings_last_t == nil then
        A.aim_settings_last_t = now
    end

    local dt = clamp(now - A.aim_settings_last_t, 0, 0.05)
    A.aim_settings_last_t = now

    local target =
        A.aim_settings_open
        and 1
        or 0

    -- Quick open, smooth retract.
    local speed =
        target > (A.aim_settings_anim or 0)
        and 15
        or 11

    A.aim_settings_anim =
        exp_chase(
            A.aim_settings_anim or 0,
            target,
            speed,
            dt
        )

    -- Do not keep an asymptotic invisible tail alive for another second.
    if target == 0
        and (A.aim_settings_anim or 0) < 0.028
    then
        A.aim_settings_anim = 0
    elseif target == 1
        and (A.aim_settings_anim or 0) > 0.992
    then
        A.aim_settings_anim = 1
    end

    return clamp(A.aim_settings_anim or 0, 0, 1)
end

local function aim_part_dropdown_step_anim()
    local now = tick()

    if A.aim_part_dropdown_last_t == nil then
        A.aim_part_dropdown_last_t = now
    end

    local dt = clamp(now - A.aim_part_dropdown_last_t, 0, 0.05)
    A.aim_part_dropdown_last_t = now

    local target =
        A.aim_part_dropdown_open
        and 1
        or 0

    local speed =
        target > (A.aim_part_dropdown_anim or 0)
        and 16
        or 12

    A.aim_part_dropdown_anim =
        exp_chase(
            A.aim_part_dropdown_anim or 0,
            target,
            speed,
            dt
        )

    if math.abs((A.aim_part_dropdown_anim or 0) - target) < 0.0015 then
        A.aim_part_dropdown_anim = target
    end

    return clamp(A.aim_part_dropdown_anim or 0, 0, 1)
end

local function draw_aim_part_dropdown(
    mx,
    my,
    clicked,
    x,
    y,
    w
)
    local anim =
        aim_part_dropdown_step_anim()

    if anim <= 0.004
        and not A.aim_part_dropdown_open
    then
        return false
    end

    local item_h = 27
    local full_h = #AIM_PARTS * item_h

    -- Real downward expansion: top stays fixed, bottom grows down.
    local eased =
        ease_out_cubic(anim)

    local visible_h =
        full_h * eased

    local panel_y = y
    local panel_h = math.max(2, visible_h)

    rounded_fill(
        x,
        panel_y,
        w,
        panel_h,
        7,
        { 0.070, 0.074, 0.087, 1 }
    )

    rounded_outline(
        x,
        panel_y,
        w,
        panel_h,
        7,
        { 0.20, 0.21, 0.25, 0.90 },
        1,
        { 0.070, 0.074, 0.087, 1 }
    )

    local panel_hot =
        hover(
            mx,
            my,
            x,
            panel_y,
            w,
            panel_h
        )

    for i, option in ipairs(AIM_PARTS) do
        local iy =
            panel_y
            + (i - 1) * item_h

        -- Only show an option after that section of the dropdown has unfolded.
        local item_reveal =
            clamp(
                (visible_h - (i - 1) * item_h)
                / item_h,
                0,
                1
            )

        if item_reveal > 0.12 then
            local item_hot =
                item_reveal > 0.92
                and hover(
                    mx,
                    my,
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4
                )

            if item_hot then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    w - 8,
                    item_h - 4,
                    5,
                    { 0.105, 0.111, 0.132, 1 }
                )
            end

            if option == S.aim_target_part then
                rounded_fill(
                    x + 4,
                    iy + 2,
                    3,
                    item_h - 4,
                    1,
                    C.accent
                )
            end

            text(
                x + 12,
                iy + 8,
                option,
                option == S.aim_target_part
                    and C.text
                    or C.text_dim
            )

            if clicked
                and item_hot
                and A.aim_part_dropdown_open
            then
                S.aim_target_part = option
                A.aim_part_dropdown_open = false
                return true
            end
        end
    end

    return panel_hot
end

local function draw_aim_settings_popup(
    mx,
    my,
    clicked,
    lmb,
    rmb_clicked,
    dots_x,
    dots_y
)
    local raw_anim =
        aim_settings_step_anim()

    if raw_anim <= 0.001
        and not A.aim_settings_open
    then
        A.aim_part_dropdown_open = false
        A.aim_part_dropdown_anim = 0
        return
    end

    -- Fade the WHOLE popup together with the retract animation.
    -- This fixes the "it has already moved away but stays visible" look.
    local parent_menu_alpha = MENU_RENDER_ALPHA

    local popup_fade =
        ease_out_cubic(
            clamp(raw_anim, 0, 1)
        )

    MENU_RENDER_ALPHA =
        parent_menu_alpha
        * popup_fade

    -- Different visual easing for opening/closing.
    -- Opening pushes outward; closing retracts cleanly back into the Aimbot row.
    local anim

    if A.aim_settings_open then
        anim =
            ease_out_cubic(raw_anim)
    else
        anim =
            ease_in_out_cubic(raw_anim)
    end

    local pw = 300
    local ph = 171

    local base_px =
        dots_x
        - pw
        + 28

    local base_py =
        dots_y
        + 31

    -- Rebuilt motion:
    -- at 0 the popup sits close to the Aimbot row,
    -- at 1 it is fully extended below it.
    local retract =
        1 - anim

    local px =
        base_px
        + retract * 14

    local py =
        base_py
        - retract * 34

    px = snap(px)
    py = snap(py)

    -- Main shell retracts upward while fading, so the closing direction
    -- visually returns into the Aimbot row rather than drifting sideways.
    local shell_h =
        math.max(
            28,
            ph
            - retract * 58
        )

    local interactive =
        raw_anim > 0.96
        and A.aim_settings_open

    local ui_clicked =
        clicked
        and interactive

    rounded_fill(
        px - 5,
        py - 5,
        pw + 10,
        shell_h + 10,
        12,
        { 0, 0, 0, 0.20 }
    )

    rounded_fill(
        px,
        py,
        pw,
        shell_h,
        11,
        { 0.062, 0.066, 0.077, 1 }
    )

    rounded_outline(
        px,
        py,
        pw,
        shell_h,
        11,
        { 0.23, 0.24, 0.28, 0.75 },
        1,
        { 0.062, 0.066, 0.077, 1 }
    )

    -- Hide deeper controls progressively while retracting so they don't
    -- visually "hang" outside the shrinking shell.
    local details_visible =
        raw_anim > 0.42

    text(
        px + 13,
        py + 12,
        "Aimbot settings",
        C.text
    )

    if shell_h > 39 then
        line(
            px + 12,
            py + 34,
            px + pw - 12,
            py + 34,
            C.divider,
            1
        )
    end

    if details_visible then
        -- Keybind row
        text(
            px + 13,
            py + 52,
            "Keybind",
            C.text
        )

        local chip_w = 105
        local chip_h = 29
        local chip_x = px + pw - chip_w - 12
        local chip_y = py + 42

        local chip_hot =
            hover(
                mx,
                my,
                chip_x,
                chip_y,
                chip_w,
                chip_h
            )

        rounded_fill(
            chip_x,
            chip_y,
            chip_w,
            chip_h,
            7,
            chip_hot
                and { 0.115, 0.120, 0.145, 1 }
                or { 0.092, 0.096, 0.112, 1 }
        )

        if A.aim_bind_listening then
            rounded_outline(
                chip_x,
                chip_y,
                chip_w,
                chip_h,
                7,
                alpha(C.accent, 0.72),
                1,
                { 0.092, 0.096, 0.112, 1 }
            )
        end

        local key_label =
            A.aim_bind_listening
            and "Press key..."
            or aim_vk_name(S.aim_hold_key)

        centered_text(
            chip_x + chip_w * 0.5,
            chip_y + 9,
            key_label,
            A.aim_bind_listening
                and C.accent
                or C.text
        )

        if ui_clicked
            and chip_hot
        then
            aim_bind_start()
            A.fov_picker_open = false
            A.fov_picker_drag = nil
            A.aim_part_dropdown_open = false
        end

        if shell_h > 84 then
            line(
                px + 12,
                py + 79,
                px + pw - 12,
                py + 79,
                C.divider,
                1
            )
        end

        -- Max Distance
        if shell_h > 119 then
            slider_row(
                mx,
                my,
                ui_clicked,
                lmb,
                px + 8,
                py + 80,
                pw - 16,
                "Max Distance",
                "aim_max_dist",
                50,
                3000,
                "int"
            )

            line(
                px + 12,
                py + 120,
                px + pw - 12,
                py + 120,
                C.divider,
                1
            )
        end

        -- Body Part row with a REAL dropdown.
        if shell_h > 153 then
            local row_x = px + 8
            local row_y = py + 121
            local row_w = pw - 16

            row_hover(
                mx,
                my,
                row_x,
                row_y,
                row_w,
                41
            )

            text(
                row_x + 13,
                row_y + 14,
                "Body Part",
                C.text
            )

            local field_w = 142
            local field_h = 25
            local field_x = row_x + row_w - field_w - 4
            local field_y = row_y + 8

            local field_hot =
                hover(
                    mx,
                    my,
                    field_x,
                    field_y,
                    field_w,
                    field_h
                )

            rounded_fill(
                field_x,
                field_y,
                field_w,
                field_h,
                6,
                field_hot
                    and { 0.110, 0.115, 0.135, 1 }
                    or C.toggle_off
            )

            text(
                field_x + 10,
                field_y + 7,
                tostring(S.aim_target_part or "Head"),
                C.text
            )

            text(
                field_x + field_w - 18,
                field_y + 7,
                A.aim_part_dropdown_open and "^" or "v",
                C.text_dim
            )

            if ui_clicked
                and field_hot
            then
                A.aim_part_dropdown_open =
                    not A.aim_part_dropdown_open

                if A.aim_part_dropdown_open then
                    numeric_stop(true)
                end
            end

            local dropdown_y =
                field_y
                + field_h
                + 5

            local dropdown_hot =
                draw_aim_part_dropdown(
                    mx,
                    my,
                    ui_clicked,
                    field_x,
                    dropdown_y,
                    field_w
                )

            local popup_hot =
                hover(
                    mx,
                    my,
                    px,
                    py,
                    pw,
                    shell_h
                )

            local dots_hot =
                hover(
                    mx,
                    my,
                    dots_x,
                    dots_y,
                    27,
                    25
                )

            if interactive
                and not A.aim_bind_listening
                and clicked
                and not popup_hot
                and not dots_hot
                and not dropdown_hot
            then
                A.aim_settings_open = false
                A.aim_part_dropdown_open = false
            end

            MENU_RENDER_ALPHA = parent_menu_alpha
            return
        end
    end

    local popup_hot =
        hover(
            mx,
            my,
            px,
            py,
            pw,
            shell_h
        )

    local dots_hot =
        hover(
            mx,
            my,
            dots_x,
            dots_y,
