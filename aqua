        local popup_w =
            235 * scale

        local popup_h =
            133 * scale

        local popup_x =
            x + 12 * scale

        local popup_y =
            user_y -
            popup_h -
            8 * scale +
            (1 - profile_anim) *
            12 *
            scale

        for i = 1, 4 do
            local grow =
                i * 3 * scale

            rect(
                popup_x - grow,
                popup_y - grow,
                popup_w + grow * 2,
                popup_h + grow * 2,
                9 * scale,
                0,
                0,
                0,
                pa * (0.10 / i)
            )
        end

        bordered_rect(
            popup_x,
            popup_y,
            popup_w,
            popup_h,
            8 * scale,

            0.15,
            0.15,
            0.18,
            pa,

            0.028,
            0.029,
            0.034,
            pa
        )

        draw_avatar(
            popup_x + 11 * scale,
            popup_y + 13 * scale,
            28 * scale,
            pa,
            0.27
        )

        Drawing.DrawText(
            popup_x + 50 * scale,
            popup_y + 14 * scale,
            profile_name,
            0.88,
            0.88,
            0.91,
            pa
        )

        Drawing.DrawText(
            popup_x + 50 * scale,
            popup_y + 33 * scale,
            "User Account",
            0.40,
            0.40,
            0.44,
            pa
        )

        Drawing.DrawCircleFilled(
            popup_x + popup_w - 25 * scale,
            popup_y + 27 * scale,
            3 * scale,
            0.40,
            0.82,
            0.45,
            pa
        )

        Drawing.DrawLine(
            popup_x + 13 * scale,
            popup_y + 55 * scale,
            popup_x + popup_w - 13 * scale,
            popup_y + 55 * scale,
            0.10,
            0.10,
            0.12,
            pa,
            1
        )

        Drawing.DrawText(
            popup_x + 15 * scale,
            popup_y + 68 * scale,
            "Username",
            0.38,
            0.38,
            0.42,
            pa
        )

        Drawing.DrawText(
            popup_x + 126 * scale,
            popup_y + 68 * scale,
            profile_name,
            0.73,
            0.73,
            0.77,
            pa
        )

        Drawing.DrawText(
            popup_x + 15 * scale,
            popup_y + 89 * scale,
            "Product",
            0.38,
            0.38,
            0.42,
            pa
        )

        Drawing.DrawText(
            popup_x + 126 * scale,
            popup_y + 89 * scale,
            "Fallen survival",
            0.73,
            0.73,
            0.77,
            pa
        )

        Drawing.DrawText(
            popup_x + 15 * scale,
            popup_y + 110 * scale,
            "Status",
            0.38,
            0.38,
            0.42,
            pa
        )

        Drawing.DrawText(
            popup_x + 126 * scale,
            popup_y + 110 * scale,
            "Active",
            0.48,
            0.82,
            0.51,
            pa
        )
    end

    if loading then
        local elapsed =
            now -
            loading_started

        local progress =
            clamp(
                elapsed / 3,
                0,
                1
            )

        local oa =
            clamp(
                elapsed * 6,
                0,
                1
            )

        -- Fully opaque launch screen: nothing from the old page bleeds through.
        rect(
            x,
            y,
            w,
            h,
            10 * scale,
            0.010,
            0.011,
            0.015,
            1.0
        )

        local cx =
            x +
            w / 2

        local cy =
            y +
            h / 2 -
            20 * scale

        local spin =
            now * 5

        for i = 1, 14 do
            local p =
                i / 14

            local angle =
                spin +
                p *
                math.pi *
                2

            local radius =
                20 * scale

            local px =
                cx +
                math.cos(angle) *
                radius

            local py =
                cy +
                math.sin(angle) *
                radius

            local glow =
                (
                    math.sin(
                        angle -
                        spin +
                        now * 4
                    ) +
                    1
                ) * 0.5

            Drawing.DrawCircleFilled(
                px,
                py,
                (
                    1.4 +
                    glow * 1.6
                ) * scale,
                0.92,
                0.57,
                0.15,
                oa *
                (
                    0.15 +
                    glow * 0.85
                )
            )
        end

        local dots =
            math.floor(
                elapsed * 3
            ) % 4

        local text =
            "Launching Fallen survival"

        for i = 1, dots do
            text =
                text .. "."
        end

        Drawing.DrawText(
            snap(cx - (#text * 3.2)),
            snap(cy + 38 * scale),
            text,
            0.79,
            0.79,
            0.82,
            oa
        )

        local bar_w =
            210 * scale

        local bar_h =
            5 * scale

        local bx =
            cx -
            bar_w / 2

        local by =
            cy +
            63 * scale

        rect(
            bx,
            by,
            bar_w,
            bar_h,
            2.5 * scale,
            0.075,
            0.075,
            0.085,
            oa
        )

        local fw =
            bar_w *
            progress

        if fw > 1 then
            rect(
                bx,
                by,
                fw,
                bar_h,
                2.5 * scale,
                0.90,
                0.55,
                0.14,
                oa
            )

            local shine =
                (
                    now * 95
                ) %
                bar_w

            if shine <= fw then
                Drawing.DrawCircleFilled(
                    bx + shine,
                    by + bar_h / 2,
                    3 * scale,
                    1.0,
                    0.75,
                    0.28,
                    oa * 0.75
                )
            end
        end

        Drawing.DrawTextWithOutline(
            cx,
            by + 14 * scale,
            tostring(
                math.floor(
                    progress * 100
                )
            ) .. "%",
            0.40,
            0.40,
            0.44,
            oa,
            0,
            0,
            0,
            oa
        )

        if progress >= 1 then
            loading = false
            profile_open = false
            _G.FallenSurvivalLoaded = true

            -- Close the loader first. The menu is enabled only after the
            -- loader's close animation reaches zero.
            open_target = 0
        end
    end
end)


